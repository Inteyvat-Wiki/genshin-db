			"dialogs": [
				{
					"id": 762260101,
					"content": "Maalaus, regarde ! On a retrouvé tous tes tableaux et on te les a rapportés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260102,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260103,
					"content": "Héhé, pas besoin de nous remercier. Après tout, on a aussi contribué à ces peintures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260104,
					"content": "Depuis quand tu comprends ce que dit Maalaus, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "#Allez, on est allé{F#e}s au Hall d'argenlune ensemble tellement de fois déjà. C'est pas si surprenant que je commence à comprendre ce que dit Maalaus, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260106,
					"content": "Dans ce cas, qu'est-ce que Maalaus a dit au sujet des peintures ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Euh... Eh bien... Laisse-moi essayer d'interpréter... Maalaus dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260108,
					"content": "Peut-être que d'autres kuuhenkis les ont volées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260109,
					"content": "Hmm... Ou peut-être que ces trucs de transport bizarres sur la lune les ont emportées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260110,
					"content": "Ou... Peut-être que Columbina les a volées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260111,
					"content": "Hé ! C'est impossible !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "Hein ? Oh... Je me suis trompée en fin de compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260113,
					"content": "C'était donc juste une supposition au hasard...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Hmph. Apprendre une langue étrangère, ce n'est pas si facile, tu sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260115,
					"content": "Il suffit d'avoir un bon prof ! Le moment venu, je demanderai à Columbina de m'apprendre comme il faut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
