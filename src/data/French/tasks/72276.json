			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yabe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#Hé, c'est vous {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760102,
					"content": "Je ne sais pas si vous vous souvenez de mon nom, mais c'est Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760103,
					"content": "Bonjour Yabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "Bonjour ! Héhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760105,
					"content": "Vous devez être plutôt balèze pour avoir affronté la Shogun Raiden, puis les ténèbres d'Enkanomiya, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760106,
					"content": "C'est vrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "Génial ! J'ai une piste concernant un trésor. C'est peut-être dangereux, mais est-ce que ça vous intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760108,
					"content": "J'aime beaucoup les mystères, mais me mettre en danger ? Non, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760109,
					"content": "Oui, dites-m'en plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "Voici ce que j'ai trouvé en patrouillant près du Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760111,
					"content": "On dirait une stèle en pierre au premier abord, mais je pense qu'il s'agit d'un indice qui mène au trésor secret de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760112,
					"content": "Le trésor secret de Bunkoku ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "Peu de traces écrites de l'histoire de Byakuyakoku sont parvenues sur l'Île de Watatsumi. Je n'en sais donc pas beaucoup sur ce trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760114,
					"content": "On raconte que Bunkoku était le deuxième premier ministre de l'histoire de Byakuyakoku. Lui et l'enfant du soleil ont dépouillé le peuple avec des impôts élevés. Il a ensuite mis tout cet argent dans une salle secrète à l'intérieur du Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760115,
					"content": "Enfin, il a caché le tout avec des illusions solaires et a invoqué des créatures impures ainsi que des esprits vengeurs des lignes énergétiques pour monter la garde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760116,
					"content": "#Bunkoku avait, lui aussi, sans doute un nom ancien, du style «{NON_BREAK_SPACE}Truc-machinus{NON_BREAK_SPACE}». Mais personne n'allait s'embêter à garder une trace de ce traître dans l'histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760117,
					"content": "Revenons-en à cette stèle en pierre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "C'est probablement la clé qui permet d'accéder à la salle du trésor de Bunkoku. Je suis un expert en kaidan et affaires mystérieuses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760119,
					"content": "Il est écrit... Je l'ai sur le bout de la langue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760120,
					"content": "Pas besoin de jouer la comédie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "À vrai dire, j'ai trouvé la stèle dans la salle de réserve du Dainichi Mikoshi. Une note avec l'inscription ainsi que sa traduction se trouvait à côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760122,
					"content": "Les documents rédigés pendant la période de transition sont toujours accompagnés d'une traduction, semble-t-il. Selon cette note, la stèle est directement liée à l'énigme de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760123,
					"content": "Elle précise aussi qu'il y a huit stèles en tout. Nous n'en avons qu'une pour l'instant. Toujours selon la note, la salle secrète n'est pas bien loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760124,
					"content": "Est-ce que ça vous dérangerait d'aller y jeter un coup d'œil ? Honnêtement, je me fiche du trésor. J'aimerais seulement voir ce qui se passe après la résolution de l'énigme de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
		{
			"id": 7227602,
