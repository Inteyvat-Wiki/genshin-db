			"dialogs": [
				{
					"id": 722760301,
					"content": "Hé, t'as entendu ? On dirait qu'il y a un bruit étrange venant d'en haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760302,
					"content": "On dirait aussi qu'il y a un étrange motif sur le plafond !",
					"roleType": "TALK_ROLE_NPC",
