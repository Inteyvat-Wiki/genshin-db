						722761204
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761204,
					"content": "*soupir* Ça vous tuerait de vous souvenir de mon nom ? J'espère que vous n'avez pas oublié la mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME} vous faisait une blaguounette. On a réussi à découvrir ce qui se cache derrière le trésor de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761206,
					"content": "Vous racontez ce qui s'est passé à Yabe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "Alors il y a bien une salle secrète cachée par des illusions solaires... Mais il est arrivé autre chose, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761208,
					"content": "La salle est gardée par des esprits vengeurs et des êtres maléfiques qui peuvent posséder les gens. C'est horrible... Heureusement que je ne suis pas allé avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761209,
					"content": "Vous avez peur de nous blesser ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "Je suis plutôt effrayé que vous me bottiez les fesses, oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761211,
					"content": "Eh bien, je suis à la fois content et quelque peu frustré. Merci. L'énigme de Bunkoku paraissait impossible à résoudre, mais tout prend son sens quand on prend en compte l'existence de pouvoirs élémentaires. Ça rend les choses moins intéressantes, ceci dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761212,
					"content": "En tout cas, elle est enfin résolue. Je pourrai enfin l'annoncer à mon retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
