					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761002,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761003,
					"content": "Comment ai-je pu attaquer mon ami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761004,
					"content": "Un esprit vengeur invoqué par Bunkoku a dû me posséder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761005,
					"content": "Le trésor ne vaut rien à côté de notre amitié. Je ne l'aurais jamais attaqué pour cette raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761006,
					"content": "Il me faisait confiance et m'avait même invité à être témoin de la trouvaille du trésor secret de Bunkoku... Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761007,
					"content": "Je n'aurais jamais pu faire ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761008,
					"content": "C'était donc ça que cachait le dernier fragment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761009,
					"content": "Il a besoin d'être seul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "Tu as raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761011,
					"content": "Retournons informer Yabe de ce qui s'est passé.",
