				"points": []
			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "Oh... Je ne pensais pas que vous trouveriez cette entrée. Il y a bien longtemps que personne n'est venu ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Esprit de noctâme"
				},
				{
					"id": 750490402,
					"content": "C'est... Oui, c'est ici que les noctâmes errent. Bien que je craigne qu'aucune personne vivant sur la terre ensoleillée ne se souvienne de leurs noms ou de leurs actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Esprit de noctâme"
				},
				{
					"id": 750490403,
					"content": "Ah, les noctâmes... Pendant que notre maîtresse dort, nous sommes ses rêves. Quand notre déesse s'éveille, nous ne sommes que des fils de son esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Esprit de noctâme"
				},
				{
					"id": 750490404,
					"content": "#Dire qu'une personne vivante est arrivée à mettre les pieds ici... Haha, ceux qui ont soif de combat ne peuvent plus se retenir... {M#Guerrier étranger}{F#Guerrière étrangère} qui êtes {M#apprécié}{F#appréciée} de tous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Esprit de noctâme"
				},
				{
					"id": 750490405,
					"content": "#Apaisez ces âmes agitées avec le feu de la bataille et du triomphe, et soyez {F#récompensée}{M#récompensé}... Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esprit de noctâme"
				}
			]
		},
