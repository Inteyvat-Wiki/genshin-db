					},
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5184",
							"5184022",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fréjus",
					"Chênée"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "Les données de l'expérience révèlent que cette invention est une réussite totale. Merci à vous deux pour votre soutien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120102,
					"content": "Oui, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120103,
					"content": "Vous voyez, je vous avais dit que ça se passerait bien. Après tout, vous êtes doué pour ces choses-là. Construire un canon télécommandé n'avait rien de compliqué pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120104,
					"content": "T—Tu dois avoir raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120105,
					"content": "Alors ne perdez pas de temps et concentrez-vous sur la prochaine invention ! Il y a quelque chose qui m'intéresse beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120106,
					"content": "Qu'est-ce donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120107,
					"content": "Que diriez-vous d'un dirigeable capable d'explorer le ciel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120108,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120109,
					"content": "Ou d'une super perceuse capable de creuser profondément dans la terre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120110,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120111,
					"content": "Elle semble vouloir compliquer la vie de Fréjus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Ça a l'air compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Fréjus, vous avez refusé à trois reprises une invitation de l'Institut de recherche de Fontaine. Vous devez être capable de faire des choses impossibles pour l'Institut, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120114,
					"content": "Bien sûr. Ce sera un peu compliqué, mais pas impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120115,
					"content": "*soupir* En fait, je ne veux plus de ces bêtises. Voler dans le ciel ou forer sous terre est super ennuyeux. Il fait froid dans le ciel, étouffant sous terre, ce ne sont pas de bonnes idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120116,
					"content": "Oui, je suis d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120117,
					"content": "Dans ce cas, peut-être pourriez-vous inventer quelque chose qui serait utile au quotidien ? Oh, je sais ! J'aime dormir plus longtemps le matin. Ne pourriez-vous pas fabriquer une machine à faire le petit déjeuner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120118,
					"content": "Ça doit être faisable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Les propositions précédentes étaient volontairement impossibles à réaliser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "D'accord, laisse-moi réfléchir sur comment je pourrais procéder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120121,
					"content": "Super, je prends ça comme un oui. Si vous n'y arrivez pas, vous devrez me préparer le petit déjeuner à l'avenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120122,
					"content": "Qu'est-ce que c'est que cette exigence ? Mais ne t'inquiète pas, je suis sûr qu'une chose aussi futile est à ma portée. Je suis un « génie », après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréjus"
				}
			]
		},
