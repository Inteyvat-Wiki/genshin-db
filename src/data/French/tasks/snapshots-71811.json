			"dialogs": [
				{
					"id": 718110412,
					"content": "À propos du Daguerréotype...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "Avez-vous remis les clichés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Oui, c'est fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "#Merci, vraiment ! Je suis encore confus de vous avoir {M#embêté}{F#embêtée} avec ça, mais je suis vraiment débordé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Oh, j'allais oublier, je vous offre ce Daguerréotype, pour vous remercier. Tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "C'est vraiment trop...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "Mais non, ce n'est rien du tout. Et puis, vous m'avez bien aidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Oh, ce n'est pas si précieux que ça. C'est juste une version d'essai que nos fournisseurs à Fontaine nous ont offerte lors de notre dernière commande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "Elle est un peu différente de la version officielle, mais toutes les fonctions de base sont là. Ça devrait suffire pour ce que vous avez à en faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "Et puis... Si vous aimez ça, vous pouvez nous aider à passer le mot par-ci par-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "Hum... De toute façon, je vous remercie pour votre aide ! Ce Daguerréotype est à vous, alors gardez-le bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Ça doit valoir une sacrée somme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
