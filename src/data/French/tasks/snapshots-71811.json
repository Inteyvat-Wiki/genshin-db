					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "Le Daguerréotype... Oh, oui ! Je suis allée à la Guilde des marchands de Feiyun l'autre jour et je leur ai demandé une photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Shan"
				},
				{
					"id": 718110504,
					"content": "#Êtes-vous {M#venu}{F#venue} exprès pour me remettre mon cliché ? C'est gentil, ça. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shan"
				}
			]
