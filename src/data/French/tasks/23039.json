					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "Héhé, je t'ai dit que je courrais vite. Alors, on sous-estime son adversaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "Mais même en courant vite comme ça, Habachi arrive toujours à nous attraper. Je me demande pourquoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "Peut-être qu'il prend un raccourci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "Ah bon ? Euh... Mais je n'ai pas vu de raccourcis par ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "#Sinon, on n'a qu'à demander {M#au grand}{F#à la grande} de jouer avec nous la prochaine fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "Viens t'entraîner avec nous ! On va s'exercer à... se camoufler en nature !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "Oui, puisqu'on ne peut pas aller plus vite que Habachi, alors on peut l'éviter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "On n'a pas déjà essayé ça avant ? Quoi qu'on fasse, il arrive toujours à nous trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "Peut-être qu'il a une astuce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "Tu... Tu es vraiment rapide...",
					"roleType": "TALK_ROLE_PLAYER",
