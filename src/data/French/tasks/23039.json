				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#Hé, {M#le grand}{F#la grande} ! Attends un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390102,
					"content": "#Excuse-moi, mais... tu es {M#un aventurier}{F#une aventurière} ? Le genre d'{M#aventurier}{F#aventurière} qui a vécu plein d'aventures et sait bien se battre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390103,
					"content": "Plus ou moins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#Regarde, Hilmi ! Je t'avais dit que {M#ce grand}{F#cette grande} était {M#un aventurier}{F#une aventurière} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390106,
					"content": "Mais je croyais que tous les aventuriers portaient des vêtements verts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390107,
					"content": "#Je suis assez {M#fort}{F#forte}, donc je n'ai pas besoin de m'habiller comme ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390110,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390111,
					"content": "#Alors tu peux certainement nous aider, {M#le grand}{F#la grande} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390112,
					"content": "Tu vois le grand entrepôt dans le village ? Habachi a dit qu'il y avait des choses très importantes dedans et qu'il devait être bien gardé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390113,
					"content": "Il nous a également dit que si des méchants attaquaient le village, il arrêterait d'abord l'élévateur puis couperait le pont-levis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390114,
					"content": "Mais l'entrepôt est à une bonne distance de l'élévateur, donc si Habachi veut arrêter l'élévateur, il doit courir aussi vite que le vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390115,
					"content": "On lui a proposé de l'aider à s'entraîner, mais il nous a complètement ignorés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390116,
					"content": "Si seulement il nous ignorait aussi quand on veut aller faire des ricochets, tss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390117,
					"content": "Ahem, bref ! Si des méchants viennent attaquer le village, et que Habachi n'arrive pas à courir, alors c'est à nous d'arrêter l'élévateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390118,
					"content": "#Vu que t'es {M#un aventurier}{F#une aventurière}, tu dois courir vite. Alors tu veux bien t'entraîner avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390119,
					"content": "Je veux bien courir pendant un tour avec vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "Super ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390126,
					"content": "On a déjà choisi le point de départ. Alors c'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390127,
					"content": "Héhé, c'est moi qui vais t'affronter cette fois. Je te préviens, je cours aussi vite qu'un lapin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390121,
					"content": "Vous pouvez faire confiance à Habachi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "Allez... Joue avec nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390123,
					"content": "S'il te plaît ! V—Viens t'entraîner avec nous ! Allez, quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390124,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "Super ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390108,
					"content": "#Je suis assez {M#spécial}{F#spéciale}, je n'ai pas besoin de m'habiller comme ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "On pourrait le dire ainsi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
		},
