					}
				]
			},
			"dialogs": [
				{
					"id": 100070701,
					"content": "#Voilà qui est fait. C'était une performance remarquable, {NICKNAME}. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Cette puissance que tu viens de libérer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ah, ne t'inquiète pas. C'était la mienne et uniquement la mienne. Je n'ai reçu aucune aide extérieure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "C'est comme... accorder un instrument de musique pour qu'il puisse jouer des mélodies encore plus belles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Tu as vraiment plus d'un tour dans ton sac ! Qu'est-ce que tu nous caches d'autre, hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Allons, Paimon. Combien de tours pourrais-je bien avoir ? Je n'ai que deux manches, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Tu sais très bien que ce n'est pas ce que je voulais dire, barde de pacotille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Hahaha, j'ai l'impression que le vent va être particulièrement fort aujourd'hui. On devrait retourner à Mondstadt et prévenir les gens de bien s'accrocher à leurs chapeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
