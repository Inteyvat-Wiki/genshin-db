			"dialogs": [
				{
					"id": 100070501,
					"content": "Ah, on dirait que notre musique a incité certains spectateurs à monter sur scène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "Mais c'est contraire aux règles d'un concert, il faut les raccompagner vers la sortie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
