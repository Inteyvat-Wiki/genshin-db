			"dialogs": [
				{
					"id": 100070301,
					"content": "Je pensais qu'on aurait eu à aller plus loin, mais en fait, c'est juste à côté de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "Cette île...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "A-t-elle quelque chose de spécial ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Cette île n'a rien de particulier en soi, comme la plupart des îles. Ce n'est qu'une accumulation de sable et de pierres ordinaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Jusqu'à ce que le vent apporte les graines d'une histoire, et que le temps les cultive sur cette île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "Ensuite, le vent a apporté de nouvelles histoires, que le temps a transformées en légendes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#Du coup... Permettez-moi de t'accueillir officiellement et véritablement sur cette île bénie par le Temps, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Dans un passé lointain, le Temps et le Vent se sont rencontrés en ces lieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Attends, barde de pacotille... Tu es devenu si sérieux soudainement, je ne comprends pas vraiment ce que tu nous racontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Héhé, ne t'inquiète pas, chère Paimon ! Les meilleures histoires commencent toujours avec un peu de suspense et de mystère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
