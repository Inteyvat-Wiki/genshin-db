					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071001,
					"content": "Il fut un temps où j'invoquai les premiers vents de la liberté au nom du peuple de Mondstadt. Grâce à ces vents, la liberté fut rendue à tous ceux à qui elle était due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1504501",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Je t'en ai déjà parlé, tu te souviens ? De ma rencontre avec le « Temps » au Temple des Mille Vents et de l'aide que j'ai reçue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "Eh bien, c'est grâce à l'aide du Temps que ces premiers vents de liberté ont pu souffler si fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Mais ces vents violents sont plus propices à tout balayer qu'à aider quoi que ce soit à grandir et prospérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Alors, après avoir résolu plusieurs crises à Mondstadt, j'ai adouci les vents pour qu'ils soient juste assez forts pour éveiller le courage des Mondstadtois, sans pour autant les emporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "Nous y sommes donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "#Les ombres s'amassent au loin. Je suis sûr que tu l'as ressenti toi aussi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "J'ai entendu parler de l'affrontement entre l'Archon Pyro et Ronova, la Maîtresse de la mort, ainsi que de ce qui est arrivé à Capitano, l'Exécuteur des Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Sans parler du fait que les activités de l'Abîme se rapprochent de plus en plus de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Je crains que la crise imminente ne dépasse ce que les humains peuvent affronter tout seuls... C'est pourquoi je dois me tenir prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "C'est le devoir de l'Archon Anémo d'intervenir en cas de besoin. Moi, Barbatos, je ferai souffler un vent assez puissant pour dissiper toute tempête qui se profile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Mais si je déchaînais un vent d'une telle puissance sur Mondstadt, cela mettrait la ville sens dessus dessous : les vêtements, les chapeaux, les fleurs sur les balcons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "C'est pour ça que j'ai choisi cet endroit — là où j'ai jadis fait une ode au Temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "Qui sait ? Peut-être que le Temps accorde une faveur particulière à cette île, justement en raison de ma délicieuse et sublime musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Attends... Cet endroit est vraiment si spécial que ça On ne dirait pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "Il y a la marée qui monte et qui descend, des oiseaux qui vont et viennent... Ça a juste l'air... normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "L'impact du Temps sur les choses ne se limite pas à ce qu'on peut voir. C'est un peu comme... une pomme crépusculaire mûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Si la peau reste intacte, c'est presque impossible pour une personne ordinaire de savoir si le fruit est mûr ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Mais la moindre petite imperfection sur cette peau entraînera la décomposition du fruit, en commençant par cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "Entre dans les mains du Temps, pas une seule « imperfection » ne marque la « peau » de cette île. Ainsi, l'influence du Temps sur son essence même demeure invisible aux yeux de tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Fondamentalement, tout ce qui ne bénéficie pas de la faveur du Temps finira bien sûr par être effacé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Mais avec le pouvoir qui subsiste ici, je peux me servir du Temps pour tracer une frontière autour du Vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "Ainsi, le monde extérieur ne remarquera rien, peu importe la puissance de la tempête que je déchaînerai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Bien entendu, puisque je sollicite ton aide, je me dois de t'offrir quelque chose en retour. C'est pour cela que je t'ai invité ici, {NICKNAME}... Pour qu'on interprète ensemble une ode au Temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#Dis-moi quand tu es {M#prêt}{F#prête}, {NICKNAME}. Je peux te prêter un instrument si besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "Mais pour faire quoi au juste...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
