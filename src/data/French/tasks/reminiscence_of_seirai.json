			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "#Tu es {M#revenu}{F#revenue}. Comment ça s'est passé ? Tu as réussi à prendre les photos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Formidable. Laisse-moi voir s'il te plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Hahaha ! Je n'ai aucune idée d'où se trouvent ces endroits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "On dirait qu'ils ont bien changé depuis que mes ancêtres ont quitté l'île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "Peut-être que Fujiwara Toshiko reconnaîtra ces lieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Mais je pense que ce sera aussi difficile pour elle, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
