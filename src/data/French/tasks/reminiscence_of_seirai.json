			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "*soupir* Quand est-ce que je vais trouver quelqu'un qui voudra bien y aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630302,
					"content": "Savez-vous quelque chose sur cette carte ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "#Tu es {M#un aventurier de la Guilde}{F#une aventurière de la Guilde} ? Ils ont enfin trouvé quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630304,
					"content": "#Je ne suis qu'{M#un voyageur}{F#une voyageuse} de passage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "Hmm, d'accord, alors... C'est quoi cette carte dont tu parles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630306,
					"content": "Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630307,
					"content": "M—Mais ! C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630308,
					"content": "Qu'est-ce que vous avez vu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "C'est sur l'Île de Seirai, non ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630311,
					"content": "C'est exact.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "Vraiment ? Je n'ai fait que deviner pourtant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630314,
					"content": "Mes ancêtres en sont originaires, mais c'était il y a bien longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630315,
					"content": "Quelqu'un de ma génération ne connaît pas cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630316,
					"content": "Il ne reste que trois peintures de paysages qui nous rappellent l'île dans notre maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630317,
					"content": "Dans ce cas, pourquoi souhaitez-vous y aller ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "Je me considère quand même originaire de l'Île de Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630319,
					"content": "J'ai envie de voir à quoi elle ressemble... Peu importe ce qu'il en coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630320,
					"content": "Malheureusement, je suis plutôt occupé en ce moment. Je n'ai pas encore eu l'occasion de m'y rendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630321,
					"content": "De plus, je ne trouve aucun aventurier qui accepte de m'accompagner là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630322,
					"content": "C'est pour cette raison que j'ai déposé un ordre de mission à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630323,
					"content": "J'aimerais bien qu'un aventurier aille sur l'Île de Seirai pour prendre des photos des trois endroits qui sont représentés sur les peintures de ma famille et qu'il me les ramène...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630324,
					"content": "Mais personne n'a encore accepté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630325,
					"content": "Laissez-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "T—Tu veux bien ? Ce serait génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630328,
					"content": "Quant au paiement, ne t'inquiète pas. Je te prépare quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630329,
					"content": "#Alors, je compte sur toi, {M#voyageur}{F#voyageuse}. Avec la carte que tu as apportée, ça fait quatre endroits où prendre des photos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630330,
					"content": "S'il te plaît, va à ces quatre endroits et prends une photo pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630326,
					"content": "Je peux y aller pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "Bravo, bonne réponse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "C'est chez vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
			"completionStepIds": [
				7216307,
				7216310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
