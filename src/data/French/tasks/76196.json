			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota ? Qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Tu tombes à pic, Linnea ! J'étais justement en train de parler à tout le monde des merveilles de l'argent de lune déchue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Oh, argent de lune déchue, argent de lune déchue... Existe-t-il une gemme plus parfaite sur la sphère sublunaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Regarde ! Sa forme parfaite, sa texture lisse et arrondie ! Et ce blanc irisé associé à une affinité élémentaire unique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "À mes yeux, seule la lune dans le ciel peut se comparer à toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Euh... Oui. L'argent de lune déchue est un minerai magnifique. J'en ai moi-même collecté quelques échantillons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Voilà, je savais que tu comprendrais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Mais tout de même, personne ne comprend l'argent de lune déchue mieux que moi ! Même si tu es conseillère auprès de la Guilde des aventuriers, je ne céderai pas si facilement la première place. Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "#D'ailleurs, puisque c'est toi qui te charges habituellement de former les aventuriers... Que dirais-tu de me laisser te tester à mon tour, pour une fois{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "J'ai ici trois morceaux d'argent de lune déchue. Malheureusement, deux d'entre eux présentent des défauts mineurs. Le dernier, cependant, constitue mon trésor le plus précieux. Le minerai d'argent de lune déchue par excellence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Peux-tu dire lequel est le plus parfait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Laisse-moi jeter un coup d'œil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "Celui de gauche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Hmm ? Qu'est-ce que Lumi est en train de faire ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Je vais choisir celui-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Haha, on dirait que même toi, tu te trompes parfois, Linnea. Celui-ci présente en fait un petit défaut caché dans un endroit très discret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "D'accord, tu as gagné. Mais la prochaine fois, tu ne t'en tireras pas aussi facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Ça me va. Je suis toujours prête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Linnea finit par participer à l'événement d'appréciation de l'argent de lune déchue organisé par Dorota, et passe un très bon moment...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Ouah, je ne m'attendais pas à ce que tout le monde soit aussi enthousiaste. C'est dommage que ces moments-là ne durent jamais longtemps... Bon, il est temps de plier bagage et de rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Laisse-moi t'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Oh, c'est gentil ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Je vais réfléchir encore un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "Celui du milieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Lumi semble bien aimer celui-ci.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Je vais choisir celui-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960223,
					"content": "Ah, tu le ressens aussi, n'est-ce pas ? Cette attraction irrésistible que seul quelque chose de vraiment parfait peut exercer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960225,
					"content": "Celui de droite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960226,
					"content": "(Hmm ? Qu'est-ce que Lumi est en train de faire ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960227,
					"content": "Je vais choisir celui-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960228,
					"content": "Haha, on dirait que même toi, tu te trompes parfois, Linnea. Celui-ci présente en fait un petit défaut caché dans un endroit très discret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960229
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960229,
					"content": "D'accord, tu as gagné. Mais la prochaine fois, tu ne t'en tireras pas aussi facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960230
