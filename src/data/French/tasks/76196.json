			"dialogs": [
				{
					"id": 761960301,
					"content": "Pfiou... On n'en a oublié aucun, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Hmm... Non, tout est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Je t'ai vu réaliser ces motifs amusants sur le sol avec de l'argent de lune déchue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Oui ! Ça m'a demandé pas mal de travail, mais je pense que j'ai réussi à susciter l'engouement général pour l'argent de lune déchue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "À ce propos, j'ai entendu parler d'un conte populaire originaire de Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "C'est l'histoire d'une fille qui vivait autrefois parmi les étoiles. Elle chuta de la voûte céleste, et dans l'espoir de regagner le ciel, elle laissa derrière elle d'immenses dessins sur le sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "À la fin, son père, le soleil qui brillait dans le ciel, exauça ses prières et la fit remonter là-haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Peut-être qu'il verra les motifs que tu as dessinés et qu'il deviendra lui aussi un amateur d'argent de lune déchue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Haha, dans ce cas, je serai la meilleure ambassadrice de l'argent de lune déchue qui existe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Mais bon, je suis quand même plus inquiète à l'idée de me faire repérer par les oiseaux. Tu sais, les corbeaux par exemple, ils raffolent aussi de tout ce qui brille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "C'est vrai. Et en plus des corbeaux, il faut également faire attention aux taupes renifleuses et aux belettes voleuses qui rôdent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "Et à Lumi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, c'est vrai ! Et à Lumi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Quoi qu'il en soit, merci encore pour ton aide tout à l'heure. Même si ce n'est qu'une petite partie de ma collection... Tiens, je te les offre ! Considère ça comme un cadeau pour Lumi.",
