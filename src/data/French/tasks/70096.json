					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "En plus, ça ne s'est pas si mal terminé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Votre première tentative de quoi, au fait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Ah... Mon premier devoir de sorcière. Je vous expliquerai tout ça plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
