						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "... Chercheur de pouvoir, disciple du destin, te voilà enfin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "C'est Durin... Ça ne m'étonne même pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Il y a quelque chose d'étrange dans sa façon de parler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Un souverain tout-puissant, la création d'un mage et un descendant des anges... Tous possèdent des pouvoirs différents, et pourtant tous sont désignés par le nom de dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "... C'est parce que le dragon est le symbole de la puissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Et donc combattre de grands dragons serait une preuve de force ? Je commence à mieux comprendre la Grande Maîtresse fondatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Je vois que tu as encore beaucoup à dire, mais je suggère que nous croisions plutôt le fer. Après tout, un seul coup d'épée vaut mille mots !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "A—Attends ! J—Jeune humain, l'épreuve que tu cherches est loin d'ici. Tu dois te rendre dans l'Antre de Stormterror et affronter la prophétie finale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Pourquoi il parle si vite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Ça va, Durin ? Tu as l'air bizarre aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Ouf... Je pense avoir dit l'essentiel... même si j'ai sauté pas mal de passages !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Euh, je crois qu'Albedo a dit qu'il avait besoin d'aide pour une expérience, je vais devoir y aller. Désolé tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Eh bien, il est parti en vitesse... Quel dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Tiens ? Serait-ce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Euh... Pourquoi Durin était-il là exactement ? À part cette dernière phrase sur « se rendre dans l'Antre de Stormterror », il n'a fait que raconter n'importe quoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "J'ai l'impression...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Intéressant. Je suis curieux de savoir comment cette prophétie va se réaliser exactement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "... Qu'il n'était là que pour que le prochain dragon compte comme le troisième.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "On dirait un acteur qui veut quitter la scène au plus vite !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
		{
