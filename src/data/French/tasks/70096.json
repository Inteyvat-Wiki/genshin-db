				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Slazhnev",
					"Leifhelm"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Notre capitaine n'est pas seulement fort ! Il a même développé un composé qui neutralise l'Abîme ! Vous ne le saviez pas, hein ? Et vous osez encore dire que je suis un « faux expert » qui ne connaît rien ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Et vous, vous connaissez la vitesse phénoménale de notre Grand Maître ? Il a utilisé les lignes énergétiques pour aller de Nod-Krai jusqu'à Mondstadt en moins de temps qu'il n'en faut pour lacer ses chaussures. Si tant est que vous sachiez le faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
