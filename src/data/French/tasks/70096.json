				]
			},
			"dialogs": [
				{
					"id": 700960601,
					"content": "Parfait... Maintenant, selon la prophétie de Barbeloth, l'humain ayant besoin de conseils devrait arriver d'un instant à l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Répliques d'entrée... mémorisées. Effets d'entrée... confirmés. Hahaha, cette fois, tout sera parfait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "Hé... Dites-moi, pourquoi la dernière prophétie demande-t-elle à Lohen de venir ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Oh non, ils sont déjà là ? Durin n'a pas fini sa réplique ? Mince... Je dois parler moins fort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "Est-ce que la puissance des dragons dont il parle ne ferait pas référence à Dvalin ? Mais il n'a pas l'air d'être là aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Techniquement, j'ai déjà rencontré Dvalin, le Vent de l'Est, quand je suis rentré de Nod-Krai pour la première fois. Il était juste à côté de toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "Ah oui ! Au Territoire des loups, quand tu livrais les lettres pour Varka ! Attends... Ça veut dire que la prophétie s'est déjà réalisée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Si on interprète grossièrement, j'ai déjà « affronté à trois reprises la puissance des dragons ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "Mais as-tu « compris le véritable sens de la force » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Je suppose que c'est pour cela que la prophétie m'a guidé jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Avant que cet endroit ne soit connu sous le nom d'Antre de Stormterror, c'était le domaine de Décabarian, le Dieu des tempêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Ce puissant dieu capable de soulever des tempêtes pour tout protéger n'a pourtant pas pu contenir le désir de liberté qui naissait derrière ses propres murs de vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "Quant à la divinité du Vent du Nord, qui avait jadis rivalisé pour le trône, il a trouvé la réponse qu'il cherchait après avoir renoncé à sa puissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "Hein ? Ce gamin semble avoir plus de ressources que ce que Varka m'avait laissé croire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "Le Miroir de l'aube naissante, et Durin, le dragon maléfique... Eux aussi ont été perdus dans la confusion et le doute pendant un temps. Ce qui les a menés vers la force, c'était bien plus que la simple puissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Eh bien, eh bien... On dirait que vous commencez vraiment à comprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "Et il y a aussi Ursa, autrefois un ange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Ce que tu dis est très sensé, mais... c'est vraiment ton genre de répliques, Lohen ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "D'abord Durin... et maintenant Lohen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "« L'ange qui a choisi la puissance aspirait encore à se rapprocher des humains, jusqu'à sombrer et devenir une créature pitoyable... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "« Ô humains qui avez été témoins de tout cela, aspirez-vous toujours à la puissance ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "Hé ! Ce sont mes répliques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "Q—Quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "Ah... j'ai dû faire une erreur quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "Enchanté de vous rencontrer, Nicole. J'ai lu votre scénario, et je dois dire que j'ai été très impressionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "Ah... Pourquoi j'ai l'impression que Durin a égaré sa copie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "Oh ? Cela faisait donc aussi partie de la prophétie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Pas du tout. Si j'avais su à l'avance, je n'aurais pas juste... *tousse*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "Quoi qu'il en soit, c'était un scénario bien écrit. Très divertissant. Comme un petit conte de fées réconfortant, bien entendu. Je dois dire cependant que je n'apprécie guère qu'on me fasse la morale... même si cela vient d'un ange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "... Je vais considérer que cela s'adressait à mon ancien collègue. Celui qui a choisi la puissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Puisque vous avez lu mon scénario, vous devez déjà savoir tout ce que je suis censée dire, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "En effet, et je m'assurerai de le prendre comme un conseil précieux. Maintenant, y avait-il autre chose ou puis-je retourner à la compilation de mon Guide des ennemis redoutables ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(Il n'a pas dit qu'il comptait suivre ce conseil...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Mais il faut reconnaître que la journée a été plutôt productive... Oui, j'ai sans doute progressé un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "Merci tout le monde... et transmettez mes amitiés à l'équipe de production !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "Hmm... Pourquoi les humains sont-ils toujours si difficiles à gérer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Euh... Quelqu'un peut m'expliquer ce qui se passe ? Je suis... vraiment, vraiment perdue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "Vous vous souvenez de l'affaire avec Dottore et le poison laissé par Ursa à Mondstadt ? Il paraît que Lohen a lui aussi beaucoup souffert à cette époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Puisqu'il s'agissait d'une calamité causée par un ancien ange, il était naturel qu'un ange actuel se charge de rétablir les choses... même si cela ne s'est pas exactement déroulé comme je l'avais prévu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Il semblerait que le destin de l'humanité soit voué à devenir de plus en plus imprévisible... Les conseils des anges ne semblent plus être la seule chose qui les guide vers l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Mais toutes ces possibilités infinies... C'est peut-être justement là que réside la véritable force de l'humanité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "(Il va clairement continuer à compiler son guide, quoi qu'elle dise...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "Pourquoi est-ce que tout le monde parle comme s'ils récitaient un script ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
