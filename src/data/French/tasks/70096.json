			"dialogs": [
				{
					"id": 700960401,
					"content": "Des mouvements si fluides... On ne dirait pas que tu es une machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Vos attaques sont également très précises, monsieur Lohen. On dirait presque celles d'une machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Génial, de nouvelles pièces ! Je vais pouvoir créer d'excellents nouveaux modules avec ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "Hein ? Alors, ça veut dire que maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa, cherches-en d'autres ! J'en veux le plus possible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Compris... Toutes mes excuses, monsieur Lohen. Nous pourrons en reparler plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Après pas mal d'exploration...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Aino s'est endormie... Elle s'est épuisée en jouant au Port de Dornman ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "C'est souvent comme ça avec elle... ses batteries se vident rapidement. Je suis désolée, monsieur Lohen, mais j'ai bien peur de ne pas pouvoir me lever pour le moment. Je dois rester ici jusqu'à ce qu'Aino entre dans un sommeil plus profond...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "... Ce n'est pas grave. J'en ai déjà vu assez pour savoir de quoi tu es capable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "... J'espère que mes données de combat vous seront utiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Au fait, la personne qui nous a parlé de ces mécanismes spéciaux a également mentionné Dosdragon. Vous pourriez peut-être aller y jeter un œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
		{
			"id": 7009605,
