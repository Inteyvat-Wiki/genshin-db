					{
						"sceneId": 3,
						"position": [
							3518.57,
							214.513,
							-283.78
						],
						"pointId": 16827
					}
				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa ! Ineffa ! T'as vu ce moulin à vent ?! Je veux que tu notes comment il fonctionne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "C'est compris ! Je me prépare à photographier le moulin à vent. Tu veux apparaître sur la photo cette fois, Aino ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Hein ? {NICKNAME} ? Paimon et Lohen aussi ! Waouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Oh... Des informations venant de Nod-Krai sur un puissant dragon ancien... J'aurais dû deviner de qui il s'agissait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Évaluation de la situation... Il semblerait que monsieur Lohen souhaite se battre contre moi. Est-ce exact ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "En résumé, oui. C'est exactement ce que j'espérais faire. Lorsque l'expédition était à Nod-Krai, je n'avais aucune raison de soupçonner que tu avais un passé aussi extraordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Mais passons. Ça fait un moment que j'ai envie de mesurer mes compétences aux tiennes, alors... Qu'en dis-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Héhé ! Ineffa ! Montre-lui de quoi tu es capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Désolée. Selon le programme d'aujourd'hui, nous devons encore aller récupérer des composants spéciaux à Mondstadt. D'après mes calculs, vous affronter maintenant risquerait de compromettre la suite de nos opérations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Oh, c'est vrai... j'avais presque oublié ! On a entendu dire qu'il y avait une sorte de robot géant à Mondstadt... C'est pour ça qu'on est là ! Mais après, je me suis un peu laissée distraire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Ce n'est pas grave... Je comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... Tu ne vas quand même pas abandonner si vite ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Si je vous aide à vous débarrasser de ces Gardiens des ruines, ça devrait libérer votre emploi du temps, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
		{
