			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Ahhh... C'est bien l'authentique bride divine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440602,
					"content": "#Je n'aurais jamais cru que j'aurais la chance de la revoir un jour. Dites-moi, {M#voyageur}{F#voyageuse}, comment avez-vous fait pour l'obtenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440603,
					"content": "C'est Aberaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "C'est lui qui vous l'a donnée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "C'est étrange... Je me souviens qu'il était un personnage important dans la fondation de notre pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "On nous a raconté qu'il avait été condamné pour haute trahison, parce qu'il prévoyait d'usurper le trône de l'enfant du soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "Pourtant, c'est lui qui vous a remis cette bride... Peut-être qu'il y a des choses que j'ignore après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "Le destin a donc décidé que la bride referait apparition ici... Je commence à me souvenir du visage de ces enfants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "Je pourrai enfin me repentir pour mes erreurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "#{M#Voyageur}{F#Voyageuse}, jetez la bride dans le lac du Locus. Nous pourrons sans doute restaurer leurs âmes grâce à elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "Qu'elles puissent être complètes pour leur permettre d'accéder à leur prochaine vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
