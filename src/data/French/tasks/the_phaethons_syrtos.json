			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Clymene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Hmm ? Que c'est étrange, ça fait des lustres que je n'avais pas vu quelqu'un habillé comme vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "Je vois que vous n'êtes pas de Byakuyakoku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "#Seriez-vous {M#un voyageur}{F#une voyageuse} d'un autre pays ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "Plus ou moins...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "Je ne pensais pas qu'il existait un moyen d'accéder à Byakuyakoku depuis le monde extérieur... Vous m'en voyez surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "Je suis née ici et c'est la première fois que je vois quelqu'un d'un autre pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Un jour, quelqu'un m'a dit qu'il souhaitait voir à quoi le monde ressemblait hors d'ici. J'ai cru qu'il plaisantait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "#{M#Voyageur}{F#Voyageuse}, j'aurais une humble requête à vous adresser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "Il y a sept tombes impériales sur les terres de Byakuyakoku où nos enfan{RUBY#[S]Phaétons}ts du soleil reposent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "Les enfants du soleil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Oui, nous vénérons le Dainichi Mikoshi ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "Un nourrisson est désigné comme l'enfant du soleil par période de plusieurs années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "Nous avons eu sept enfants du soleil au total...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "#Je vous en prie, {M#voyageur venu}{F#voyageuse venue} d'ailleurs, visitez leurs tombes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Et pourquoi voulez-vous qu'on le fasse ? On n'est pas d'ici, nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "#D'ailleurs, ce ne serait pas plutôt le devoir de leur famille et de leurs proches{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "En effet, c'est généralement de cette manière que les choses se font.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "*soupir* Malheureusement, j'ai bien peur que personne ici ne veuille leur rendre le moindre hommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "Ces tombes impériales n'ont pas été visitées depuis très longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "Les gens de Byakuyakoku détestent les enfants du soleil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "Je dirais plutôt qu'ils les haïssent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "Comme je vous l'ai dit, les enfants du soleil sont choisis dès leur naissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "Mais comment pouvaient-ils gouverner toute une nation ? Les véritables détenteurs du pouvoir étaient les adultes qui les contrôlaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "Les enfants du soleil n'étaient que des dirigeants fantoches, manipulés par ces gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "Ces hauts fonctionnaires étaient d'une avidité sans fond. Ils s'étaient enrichis sur le dos du peuple, tout en faisant réaliser des actes abominables aux enfants du soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "La colère de la foule gronda et nombreux furent les crimes attribués à ces pauvres petits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "C'est révoltant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "Les enfants du soleil étaient innocents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "Innocents ? Non, pas vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "Pour le peuple de Byakuyakoku, leur plus grand crime était leur ignorance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "Un crime, même commis dans l'ignorance, peut blesser autrui. La personne qui le commet peut-elle réellement être considérée comme innocente ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "Ce serait trop facile, n'est-ce pas ? Les dégâts ont déjà été causés et c'est irréparable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "Si c'est ce que vous pensez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Disons que c'est quelque chose qui me tient à cœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "Je m'appelle Clymene. J'avais la responsabilité de m'occuper des enfants du soleil au quotidien dans le Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Je savais qu'ils n'avaient rien fait de mal et qu'on les manipulait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "C'étaient des enfants que j'ai vu grandir, vous savez. J'avais de la peine pour eux, j'ai dû faire leur deuil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "Au bout du compte, je n'ai jamais pu les haïr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "Bien que mon travail était d'être en leur compagnie jour après jour, j'étais sans arrêt sous surveillance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "Je ne pouvais pas parler à ces enfants lorsque j'étais avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "Quand personne n'était là pour le voir, les petits étaient si apeurés et impuissants. Ils me disaient tellement de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "... Et je n'ai même pas pu leur offrir un seul mot de consolation en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "Si seulement j'avais eu le courage de leur parler, ne serait-ce qu'un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Peut-être que les choses se seraient passées autrement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "Je vous en supplie, faites ce que je vous demande. Il m'est impossible de leur faire face après tout ça, c'est la seule manière dont je puisse les honorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "#S'il vous plaît, {M#voyageur}{F#voyageuse}. Aidez-moi juste cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "Je vous demanderai seulement de déposer une perle de corail sur chacune des tombes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "En faisant cela, il sera possible d'embraser les âmes sur les autels de pierre, leur ouvrir la voie vers le Locus de Psychopompos et prier pour qu'elles reposent en paix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "C'est entendu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Merci infiniment. Je m'en remets donc à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Pourquoi nous demander d'aller visiter leurs tombes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
		{
			"id": 7224402,
