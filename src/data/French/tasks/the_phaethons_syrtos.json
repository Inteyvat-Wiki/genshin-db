				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "#Vous êtes {M#arrivé}{F#arrivée}, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "Vous voici dans le Locus de Psychopompos. C'est en ce lieu que se trouvent mes dernières pensées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "Lorsque les enfants du soleil atteignaient un certain âge, ils assistaient à une cérémonie et entraient dans le Dainichi Mikoshi le jour de leur anniversaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "Ils entraient là-dedans ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Oui, cette cérémonie était désignée sous le nom de « rituel de retour solaire ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "Les enfants du soleil sont nés dans le Dainichi Mikoshi et doivent y retourner avant de se faire souiller par le monde des mortels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "... La température du Dainichi Mikoshi était si élevée. La lumière qu'il produisait pouvait illuminer tout Byakuyakoku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Il ne reste que des fragments d'âmes des enfants du soleil qui sont retournés au Locus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "Je pensais que peut-être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Peut-être que...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Peut-être que je pourrais utiliser mes souvenirs pour compenser la partie manquante de leurs âmes si j'ouvrais le Locus de Psychopompos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Laissez-moi essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Piramumon, Orupeusu... Je suis ici. Pourquoi ne revenez-vous pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "Alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "*soupir* C'est moi qui ai élevé deux des sept enfants du soleil, Piramumon et Orupeusu... Et même eux ne daignent pas me répondre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440413,
					"content": "Il semblerait que mes propres souvenirs ne soient pas suffisants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440414,
					"content": "Si seulement j'avais un objet qui puisse me servir d'intermédiaire... Comme la bride divine, l'insigne des enfants du soleil qu'ils portaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440415,
					"content": "Hélas, cette bride a été perdue il y a bien longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440416,
					"content": "*soupir* Byakuyakoku hait ces enfants encore aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440417,
					"content": "Mon désir de libérer leurs âmes n'est peut-être qu'une chimère, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440418,
					"content": "#... {M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à trouver la bride divine ? Ceci est la dernière chose que je vous demanderai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440419,
					"content": "Je sais bien qu'il y a peu de chances que vous la trouviez et que j'abuse de votre gentillesse en vous demandant ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440420,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440421,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Je... Je vous remercie du fond du cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440424,
					"content": "La bride est un objet qui a disparu depuis si longtemps... Alors, vous avez tout votre temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440425,
					"content": "Dites-le-moi si vous entendez quelque chose à son sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440422,
					"content": "Je ferai de mon mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Ça voudrait dire que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
