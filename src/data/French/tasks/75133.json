							-137.177,
							452.96,
							10019.38
						],
						"pointId": 8646
					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "Je ne pensais pas que Coco nous mènerait ici. Cette étrange forteresse ressemble à l'endroit où on vous a rencontrée, Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330102,
					"content": "Regardez, il y a la même fresque ! Enfin, sans les traces dessus. Peut-être que c'est parce qu'elle est plus haute ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}, tu crois que c'est le roi-python dont Bona nous a parlé ? Il a air bien méchant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330104,
					"content": "Oui, c'est le roi-python Och-Kan. La légende raconte qu'il a opprimé son peuple pour la construction du Tonatiuh, ce qui a attiré l'Abîme et a mené à son trépas ainsi qu'à la chute de son royaume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330105,
					"content": "Enfin, ce n'est qu'une légende. Après tout, les conteurs de la tribu ont des versions différentes de ce qu'il lui est arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330106,
					"content": "Peut-être qu'il est encore à bord du Tonatiuh en train de se délecter de ses trésors ? Si ça se trouve, le dragon maléfique qui nous barre le chemin est son fantôme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330107,
					"content": "Kucoui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330108,
					"content": "Arrêtez avec ces histoires. Vous faites peur à Coco !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330109,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} a vraiment envie de faire quelque chose depuis qu'on a battu le dragon. Est-ce qu'il fait un concours secret avec Coco ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330111,
					"content": "Bref, où se trouve l'autel que nous cherchons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330112,
					"content": "Si Coco nous indique la bonne direction, il devrait être en dessous de nous... Attendez, non. Je pense que c'est plutôt en haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330113,
					"content": "On s'est trompés ? L'autel du feu primaire ne peut pas être à l'intérieur de la montagne, non ? Je veux dire, comment est-on censés se faire transporter dans le ciel, à moins que la montagne elle-même ne s'effondre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330114,
					"content": "Il doit y avoir un mode de transport spécial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "Qu'est-ce qu'on fait maintenant ? Vous étiez si sûre de vous quand on était en bas. De plus, on ne comprend pas ce que Coco essaye de dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330116,
					"content": "Kuru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330117,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#Des idées, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330119,
					"content": "Je crois que je comprends. Il essaye de nous dire que suivre une logique rigide ne nous mènera nulle part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330120,
					"content": "Vous venez d'inventer ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330121,
					"content": "Peu importe ce qu'il y a là-dessous, je pense qu'on doit y jeter un coup d'œil. Après tout, ça fait partie de l'aventure, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330122,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#Ouah, tu débordes d'enthousiasme, {REALNAME[ID(2)|SHOWHOST(true)]}. Eh bien, trouvons un moyen de descendre, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
