			"dialogs": [
				{
					"id": 751330301,
					"content": "#C'est ouvert ! Tu es génial, {REALNAME[ID(2)|SHOWHOST(true)]} ! On n'aurait pas trouvé le mécanisme sans toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#Bien joué, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Mais ne crie pas victoire trop vite ! De nombreux défis nous attendent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Maintenant que l'entrée n'est plus bloquée, il n'y a pas de raison d'abandonner à mi-chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Je suis d'accord, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Coui... Coui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330308,
					"content": "Qu'est-ce qui ne va pas ? Pourquoi tu ne veux pas entrer ? Tu as peur ? Nous sommes déjà arrivés si loin, ce n'est pas possible de faire marche arrière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330310,
					"content": "Vous ne devriez pas le forcer, Bona. Il a vraiment l'air effrayé. Peut-être qu'il y a quelque chose d'extrêmement dangereux là-dessous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Moi aussi, j'ai peur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Vraiment ? Allez, ressaisis-toi comme {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "J'ai hâte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "Je ne pensais pas que tu serais aussi enthousiaste, mais rien de ce qu'on trouvera là-bas ne peut rivaliser avec toi au combat, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Ne vous inquiétez pas, notre petit saurien est courageux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Yaa... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Si Coco a vraiment peur, il vaudrait peut-être mieux qu'il reste ici... Mais on ne peut pas le laisser tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Je suppose qu'il n'y a pas d'autre solution. Je vais rester ici avec Coco. Prenez la pyrophosphorite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Mais revenez me chercher quoi que vous trouviez là-bas, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330320,
					"content": "On n'abandonnera personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
					"id": 751330321,
					"content": "Je crois en vous. Nous vous attendrons ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330322
					],
					"speakerTitle": "Bona"
