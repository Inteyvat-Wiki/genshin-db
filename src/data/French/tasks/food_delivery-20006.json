			},
			"dialogs": [
				{
					"id": 200060101,
					"content": "Livraison de repas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "#Bienvenue au Bon Chasseur ! Tiens, {M#voyageur}{F#voyageuse}, vous arrivez au bon moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Je m'excuse... Vous devez sûrement avoir faim, mais pourriez-vous m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Orlane, une femme de Deauclaire, m'a passé une commande de <color=#00E1FFFF>délice de viande et carottes au miel</color>, mais on a paraît-il observé pas mal de Blobs dans le coin ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "Je ne me sens pas capable d'affronter la route jusqu'à Deauclaire. Pourriez-vous livrer ça à <color=#00E1FFFF>Orlane</color> de ma part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Je pourrais, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Ne vous inquiétez pas, un délicieux repas bien chaud vous attendra à votre retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "je suis ici pour manger, moi. Je meurs de faim !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Une fois que vous aurez terminé la livraison, je vous récompenserai avec un de nos plats spéciaux ! Promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
		{
			"id": 2000602,
