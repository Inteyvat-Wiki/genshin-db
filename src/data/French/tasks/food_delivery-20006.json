				{
					"id": 200060401,
					"content": "Payer l'addition",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060402
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060402,
					"content": "Ah. Ça s'est bien passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060403,
					"content": "Voilà l'argent du repas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "Voyons voir, je compte... La somme y est ! Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060405,
					"content": "En récompense : un délicieux <color=#00E1FFFF>gratin au crabe, jambon et légumes</color> tout droit sorti du four ! Mangez-le tant qu'il est encore chaud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		}
