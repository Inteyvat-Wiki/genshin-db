				"objectNames": [
					"Orlane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "Ah, bien le merci ! Quelle plaie, ces Blobs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Orlane"
				},
				{
					"id": 200060202,
					"content": "Si je n'avais pas l'estomac dans les talons, je leur aurais montré qu'on ne s'en prend pas aux gens comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Orlane"
				},
				{
					"id": 200060203,
					"content": "Tenez, votre commande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Mmm... Quelle bonne odeur de carottes et de viande ! Si seulement j'avais mangé plus tôt, j'aurais pu montrer à ces Blobs de quel bois je me chauffe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Orlane"
				},
				{
					"id": 200060205,
					"content": "Tant pis, c'est la vie. Tiens, c'est l'argent que je dois à Sara pour le repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orlane"
				}
			]
		},
