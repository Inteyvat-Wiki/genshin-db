			"dialogs": [
				{
					"id": 708020101,
					"content": "Est-ce que je vais enfin réussir à retrouver papa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020102,
					"content": "Tu as des nouvelles de ton père ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "Oh, c'est toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020104,
					"content": "Pallad m'a dit qu'oncle Cyrus avait peut-être trouvé des informations à propos de mon père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020105,
					"content": "Il n'en est pas encore sûr, mais selon Pallad, leur dernière piste a l'air plutôt prometteuse, donc peut-être qu'ils vont le retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020106,
					"content": "J'adorerais aller dans les Monts Dosdragon avec eux, mais oncle Cyrus dit que je dois rester au camp, et qu'ils me diront quand ils auront plus d'informations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020107,
					"content": "Est-ce que tu peux m'aider à trouver oncle Cyrus et lui demander ce qu'il en est, s'il te plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020108,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "J'ai... J'ai peur que les nouvelles soient mauvaises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020111,
					"content": "Dans tous les cas... Je compte sur toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020109,
					"content": "Pourquoi tu n'y vas pas toi-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
			"completionStepIds": [
				7080203
			],
