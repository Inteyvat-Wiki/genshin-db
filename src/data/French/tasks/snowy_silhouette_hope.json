			"dialogs": [
				{
					"id": 708020401,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous voilà de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020402,
					"content": "Pallad a commencé les recherches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Ah, vraiment ? Je savais qu'il pouvait être responsable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Quand j'aurai fini ce que j'ai à faire, j'irai voir le petit Joël à Dosdragon pour lui donner des nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "Donc si vous voulez bien, allez lui dire que je viendrai bientôt le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "Ça va me prendre du temps de finir mon travail, alors ne le faites pas attendre. Allez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020404,
					"content": "Est-ce qu'on va vraiment trouver cette personne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "... Eh bien, il n'y a pas de garantie, bien sûr. Je peux simplement dire qu'on fera tout notre possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7080205,
			"completionStepIds": [
