				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020501,
					"content": "Hé, salut ! Quelles sont les nouvelles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020502
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020502,
					"content": "Oh... Alors oncle Cyrus n'a pas encore trouvé mon père, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020503,
					"content": "Aie confiance en lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				},
				{
					"id": 708020505,
					"content": "Je sais... Je demanderai plus de détails à oncle Cyrus quand il sera là, alors. Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020506
					],
					"speakerTitle": "Joël"
				},
				{
					"id": 708020506,
					"content": "Où es-tu, papa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joël"
				},
