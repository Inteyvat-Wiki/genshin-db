			"trigger": {
				"objectNames": [
					"Cyrus",
					"Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "Dans cette région, hein... Tu en es sûr, Pallad ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Tout à fait, monsieur Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020203,
					"content": "Vous parlez du père de Joël ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#Ah, ne voilà-t-il pas {M#le voyageur}{F#la voyageuse} ! C'est Joël qui vous envoie, je parie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Cet enfant nous a envoyé quelqu'un prendre des nouvelles quasiment tous les jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Cette fois, cependant... On a de bonnes nouvelles pour lui, haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "On a organisé un entraînement spécial à Dosdragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Ce sera peut-être mieux si j'explique le reste, monsieur Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020209,
					"content": "Donc, pendant qu'on participait à cet entraînement, je me suis retrouvé à dévier de la trajectoire convenue en raison d'un gros blizzard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020210,
					"content": "Pendant que je revenais à tâtons sur le chemin, j'ai vu une silhouette floue sur une falaise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020211,
					"content": "J'ai pensé que c'était un aventurier perdu, comme moi, donc j'ai crié pour attirer son attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020212,
					"content": "Malheureusement, avant que j'aie eu le temps d'attirer son attention... mes cris ont attiré des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020213,
					"content": "Maintenant, je ne sais pas pour vous mais je n'étais pas confiant d'affronter des monstres dans de telles conditions, donc j'ai battu en retraite à la hâte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020214,
					"content": "Une fois que je suis revenu, j'ai raconté ce qu'il s'était passé à monsieur Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020215,
					"content": "Alors la personne que vous avez vue était le père de Joël ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Nous n'en sommes pas encore sûrs nous-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "Quoi qu'il en soit, maintenant on sait que « quelqu'un » est perdu dans les Monts Dosdragon. C'est pourquoi nous devons organiser un sauvetage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Si cette personne est le père de Joël ou non... Seule la chance nous le dira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Dans tous les cas, j'ai déjà envoyé tous ceux qui avaient les compétences nécessaires pour explorer les Monts Dosdragon en mission de reconnaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Je vais me préparer aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020222,
					"content": "Je t'accompagne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Vraiment ? C'est génial ! Allons-y ensemble alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020223,
					"content": "Je vais m'occuper de ces monstres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Ça aurait pu être n'importe quel aventurier perdu, vous savez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
