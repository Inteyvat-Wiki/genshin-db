					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "Malheureusement, je n'ai pas trouvé d'autres indices l'autre fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020304,
					"content": "Cependant, puisqu'on a le champ libre, je vais continuer mes recherches maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 708020305,
					"content": "Est-ce que tu pourrais revenir informer monsieur Cyrus que j'ai commencé les recherches ? Je te remercie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad"
				}
			]
		},
