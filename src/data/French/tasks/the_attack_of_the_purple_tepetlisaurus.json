			},
			"dialogs": [
				{
					"id": 751791101,
					"content": "Qu'est-ce que je vais faire... Qu'est-ce que je vais faire ? La patronne va sans doute me donner une bonne correction quand je reviendrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*soupir* C'est une longue histoire... Notre caravane avançait sans problème quand le volcan est entré en éruption. Après, ces énormes tepetlisaures violets ont jailli du sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Je n'ai pas fait assez attention, alors mon partenaire saurien a été effrayé et m'a éloigné du groupe. Le temps que je fasse demi-tour, la route était complètement bloquée, ce qui m'empêche de rejoindre les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "Je ne sais même pas comment ils vont... Et je les ai abandonnés sans autorisation... La patronne va me tuer. Je suis complètement fichu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "#Si j'étais vous, je me serais juste {M#enfui}{F#enfuie}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "M'enfuir ? C'est impossible. La patronne est comme le Fief nocturne : elle est partout, tout le temps. Elle me retrouvera où que j'aille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Je dois retourner auprès des autres et m'excuser. Mais comment ? La route est bloquée... Ah, je vais vraiment me faire tuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
		},
