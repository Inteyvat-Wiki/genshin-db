			"dialogs": [
				{
					"id": 751790201,
					"content": "*halète* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790202,
					"content": "Tout va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "Oui, je me suis pressé un peu en courant tout à l'heure. J'ai besoin d'un moment pour reprendre mon souffle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Reposez-vous bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Euh, merci de vous en inquiéter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				}
			]
		},
