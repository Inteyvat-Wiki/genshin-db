						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "Hé, vous là ! Arrêtez ! C'est à nous, alors pas touche ! Je vous préviens, j'ai les capacités pour participer à la Guerre des veilleurs de nuit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "Essayez seulement de nous voler nos affaires, et je... Je vous montrerai de quel bois je me chauffe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*soupir* Que se passe-t-il aujourd'hui ? Tout d'abord, une éruption volcanique, puis le tepetlisaure violet et maintenant des bandits ? La poisse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "#Masose, {M#il}{F#elle} a l'air plutôt balèze. Je ne crois pas qu'on puisse {M#le}{F#la} battre. De plus, on est là pour regarder la compétition, pas y participer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "Comment peux-tu dire ça, Itsaho ? Ces choses nous appartiennent ! Puis on est deux contre un, alors on a peut-être une chance de gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "Deux contre un ? Tu es le seul qui se prendra une raclée. Ne me mêle pas à ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "Hum, dites. On n'en veut plus de ces trucs. Prenez-les si vous le souhaitez, mais ne nous faites rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Je crois qu'il y a un malentendu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "#Vous vous trompez ! On est des {M#aventuriers}{F#aventurières} qui aident leur prochain, pas des bandits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "Et pourquoi je devrais vous croire... Aïe ! Pourquoi tu m'as frappé, Itsaho ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "#{M#S'ils}{F#Si elles} avaient de mauvaises intentions, tu serais déjà à terre. Pourquoi perdraient-{M#ils}{F#elles} leur temps à nous parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "Pour tout vous dire, notre caravane s'est dispersée il y a peu de temps. Si cela ne vous dérange pas, pourriez-vous transmettre un message à notre patronne ? Dites-lui que nous l'attendons ici, nous vous en serions très reconnaissants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Vous pouvez prendre les objets dans le coffre en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "C'est comme si c'était fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Vous comprenez vite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "#Hé ! Ne nous fais pas passer pour les {M#méchants}{F#méchantes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
