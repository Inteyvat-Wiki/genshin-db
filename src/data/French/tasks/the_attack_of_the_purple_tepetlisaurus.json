			"dialogs": [
				{
					"id": 751790901,
					"content": "Oh non, Itsaho, il y a beaucoup de choses de la liste qui manque... Aide-moi à les chercher, veux-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*soupir* ... Ne perds pas ton temps. J'ai déjà regardé. La plupart de ces objets étaient fragiles. Tu crois vraiment qu'il y en a qui sont encore intacts après l'éruption et la collision ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Économise ton énergie et prends une pause. Nous aurons une longue route à parcourir une fois que la patronne et les autres seront de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "P—Pas question !... Bon, si tu n'y vas pas, j'irai tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
			]
		},
