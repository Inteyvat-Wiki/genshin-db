						],
						"pointId": 10984
					}
				]
			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Évidemment, un cadeau aussi modeste donne une impression d'être un peu radin, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "En effet, ce n'est pas assez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Haha ! J'aime les gens comme vous qui dites les choses telles qu'elles sont !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "Bref, c'est quand même un cadeau personnel que je vous offre. Acceptez-le ! Considérez cela comme un petit truc à grignoter en plus pour votre tepetlisaure. Pas besoin de me remercier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Bon, on doit encore chercher les affaires que nous avons perdues en chemin, alors on va se mettre en route ! À la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "Non, c'est plus que suffisant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "Tsk, vous n'êtes pas très honnête. Ce n'est pas drôle... Allez, prenez donc ! Les gens vont vraiment me traiter de radine si ça se sait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
		{
			"id": 7517904,
