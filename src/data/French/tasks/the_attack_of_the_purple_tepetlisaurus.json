					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7517915",
							"3"
						],
						"stepId": 7517915,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "Hé ! Oui, c'est à vous que je parle ! C'est dangereux dehors, venez à l'intérieur et vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "Vous n'avez pas vu ce qui s'est passé ? Il y a eu une éruption volcanique et des monstres bloquent la route. Vous ne devriez pas continuer plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Écoutez-moi. Restez un peu ici et attendez. Dans un moment, vous pourrez repartir avec le reste de notre caravane. Comme ça, nous pourrons nous assurer que tout le monde va bien. C'est trop dangereux d'y aller seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Des monstres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Oui, une horde de tepetlisaures violets ! Ils ont été corrompus par l'Abîme et sont incroyablement destructeurs. Honnêtement, je n'ai jamais vu des aussi terrifiants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Ils ont détruit nos charrettes rien qu'avec quelques coups de queue. Franchement, ils sont plus forts que des tatankasaures. Ce ne sont pas des adversaires à la portée de n'importe qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Je suis sérieux. Ne foncez pas tête baissée pour les combattre. Éloignez-vous si vous les voyez d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Pas d'inquiétude, je m'en sortirai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Vous... *soupir* ... Très bien, faites attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
