			"dialogs": [
				{
					"id": 751790701,
					"content": "C'est grâce à ces trois-là que vous vous en êtes sortie, patronne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, oui ! Vous auriez dû les voir à l'œuvre. Ils ont terrassé ces monstres en deux temps trois mouvements !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Vous avez sauvé notre cheffe d'escadron. Je n'ai pas grand-chose qui serait à la hauteur de ce service à vous offrir, mais prenez ce petit cadeau comme un gage de ma gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Sérieusement, Tizlo ? As-tu toujours été aussi radin ? C'est tout ce que tu donnes aux gens qui t'ont sauvé la vie ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
		},
