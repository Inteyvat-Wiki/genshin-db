				]
			},
			"dialogs": [
				{
					"id": 751790601,
					"content": "Pfiou... Quelle pagaille. Quand je pense que j'ai failli me faire assommer par des tepetlisaures... J'enrage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Vous vous trompez ! Ce sont des monstres de l'Abîme ! Ils sont bien plus dangereux que des tepetlisaures. Vous croyiez que c'étaient des monstres ordinaires... Pas étonnant que vous ayez eu du mal avec !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Ah bon ? Tout est clair maintenant. Je vous dois vraiment une fière chandelle. Sans vous, j'aurais été fichue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Attendez, je dois d'abord aller chercher ces bons à rien. Je vous remercierai comme il se doit une fois que je me serai assurée qu'ils sont tous sains et saufs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Avec votre aide, les gens de la caravane se retrouvent progressivement.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
