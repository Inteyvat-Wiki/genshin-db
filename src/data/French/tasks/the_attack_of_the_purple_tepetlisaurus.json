						751791302
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791302,
					"content": "Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791303
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791303,
					"content": "#Arrête de bégayer ! Si tu n'avais pas paniqué ou baissé ta garde, ces monstres de rien du tout n'auraient pas été un problème pour moi ! Cette fois, une partie de ton salaire sera déduite pour remercier notre {M#sauveur}{F#sauveuse}. Compris{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791304
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791304,
					"content": "À vos ordres, patronne...",
