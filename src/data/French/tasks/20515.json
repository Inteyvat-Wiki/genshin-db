			"dialogs": [
				{
					"id": 205150101,
					"content": "Où est donc passée Anna cette fois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "Elle a encore disparu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "*soupir* Oui... J'ai cherché dans toute la ville, pour rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "Aidez-moi à la retrouver, s'il vous plaît... Je ne tiens plus debout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "À vous de jouer alors... Cette petite... C'est moi qui vais devenir malade avec toutes ses fugues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "Ah oui... Anna a mentionné qu'elle voulait aller à la cathédrale remercier les sœurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Allez voir là-bas d'abord. Ah, et vous pourriez peut-être aussi demander à Albert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "Il euh... traîne souvent du côté de la cathédrale. Qui sait, il aura peut-être remarqué quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Elle est peut-être partie devenir aventurière ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "Impossible, enfin, impossible... Non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "... Pourquoi vous ne dites plus rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
