				{
					"id": 205150404,
					"content": "Je croyais qu'elle était malade ? Elle vient de temps en temps à la cathédrale pour y recevoir des soins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150405
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150405,
					"content": "Mais elle avait l'air sacrément en forme tout à l'heure... Plus leste qu'un petit chat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
