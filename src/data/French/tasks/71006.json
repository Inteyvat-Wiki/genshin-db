			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Alors, tu as trouvé mon matériel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Oui, je l'ai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Comme j'imaginais, c'était bien là où je m'étais arrêté pour peindre. Je pose souvent mes affaires par terre quand je peins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Mais ça m'est arrivé plus d'une fois d'en oublier en partant trop vite. Merci, sans toi il aurait encore fallu que j'aille courir en ville acheter du matériel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Tu vas continuer à peindre ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Ah, ne m'en parle pas. J'ai entendu quelqu'un dire que les yeux de ces deux statues pouvait s'illuminer, et qu'on pouvait les voir de très loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Des statues géantes aux yeux qui brillent, montant la garde près d'une montagne... Ça aurait fait une belle œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Mais une fois arrivé ici, j'ai bien trouvé les statues. Mais zéro œil qui brille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Je me suis dit que j'étais peut-être venu au mauvais moment, ou que j'avais un mauvais angle... C'est pour ça que j'étais par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Mais... *soupir* Mais où que je me tienne, le paysage ne change pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "La seule chose que j'ai tirée de tout ça, c'est cette pierre. Je l'ai trouvée dans l'eau, là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Euh... J'en ai trouvé une, moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Ah ? Fais-moi voir... Elles sont identiques on dirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Étrange... Il y a une inscription au dos. Qu'est-ce que ça dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "« Par les statues la porte est protégée. Pour entrer, la vue tu dois redonner. » Qu'est-ce que ça peut bien vouloir dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Tiens, cette pierre ne me sert pas à grand-chose. Accepte-la en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "J'ai bien une idée... Tu ne trouves pas que ces deux pierres ressemblent à deux yeux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Si c'est vraiment des yeux, alors « la vue tu dois redonner » pourrais avoir un lien avec les pierres, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Hahaha, c'est juste une supposition, pas la peine d'y attacher trop d'importance. Je vais retourner chercher une bonne vue, merci pour ton aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
