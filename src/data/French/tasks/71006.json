			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Mince, comment vais-je faire pour peindre maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "#Ah tiens, {M#voyageur}{F#voyageuse}. Eh bien... Je cherchais l'inspiration au bord du Lac Luhua, avec dans l'idée de revenir avec quelques bonnes peintures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Mais je n'ai pas trouvé l'angle que je cherchais, et je n'ai rien peint qui vaille le détour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Plus ennuyeux, j'étais tellement absorbé sur le problème de la lumière que je n'ai réalisé qu'en arrivant que la moitié de mes pinceaux et couleurs avaient disparus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "J'ai dû les laisser à l'un de mes précédents emplacements. Tu irais les chercher pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "À quel endroit chercher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Eh bien... Je ne m'en rappelle pas avec précision, j'étais concentré sur ma toile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Mais je n'ai peint que deux toiles, donc ça ne peut être qu'à ces deux endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Tiens, je te donne les deux peintures. Le matériel que j'ai perdu devrait être <color=#00E1FFFF>près du lieu ayant inspiré les toiles</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Une fois retrouvé, ramène-le-moi, d'accord ? Je dois rester ici, il doit sûrement y avoir l'angle que je cherche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Mais où chercher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "J'étais trop concentré sur ma toile, je ne m'en rappelle pas vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Mais je n'ai peint que deux toiles, donc ça ne peut être qu'à ces deux endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
