					"content": "Non, ça ne peut pas être ça... Les yeux ne s'allument pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060802
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060802,
					"content": "Ça ne serait quand même pas ma façon de me positionner qui pose problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060803
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060803,
					"content": "Et puis je ne vois même pas d'yeux de toute façon.",
