					"nextDialogs": [
						710060703
					]
				},
				{
					"id": 710060703,
					"content": "La pierre ? Elle t'intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "Je l'ai trouvée alors que je cherchais une bonne vue au <color=#00E1FFFF>Lac Luhua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "Toi aussi, tu veux aller au <color=#00E1FFFF>Lac Luhua</color> jeter un œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Il faudra que tu cherches bien, alors. On trouve plein de choses dans ce lac, je ne sais pas à qui la faute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
