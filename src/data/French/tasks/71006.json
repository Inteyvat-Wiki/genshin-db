			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "Alors, tu as trouvé mon matériel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Oui, je l'ai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Comme j'imaginais, c'était bien là où je m'étais arrêté pour peindre. Je pose souvent mes affaires par terre quand je peins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Mais ça m'est arrivé plus d'une fois d'en oublier en partant trop vite. Merci, sans toi il aurait encore fallu que j'aille courir en ville acheter du matériel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "Tu vas continuer à peindre ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Ah, ne m'en parle pas. J'ai entendu quelqu'un dire que les yeux de ces deux statues pouvait s'illuminer, et qu'on pouvait les voir de très loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Des statues géantes aux yeux qui brillent, montant la garde près d'une montagne... Ça aurait fait une belle œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "Mais une fois arrivé ici, j'ai bien trouvé les statues. Mais zéro œil qui brille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Je me suis dit que j'étais peut-être venu au mauvais moment, ou que j'avais un mauvais angle... C'est pour ça que j'étais par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Mais... *soupir* Mais où que je me tienne, le paysage ne change pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "La seule chose que j'ai tirée de tout ça, c'est cette pierre. Je l'ai trouvée dans l'eau, là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "Je n'ai aucune idée de ce que c'est, mais plus je la regarde, et plus ça ressemble à un œil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Enfin, si c'est un œil, il y en a peut-être un deuxième dans les environs. Après tout, les yeux vont par deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "*soupir* Ce n'est que mon idée, pas la peine d'y attacher trop d'importance. Tiens, cette pierre ne me sert pas à grand-chose. Accepte-la en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Des statues aux yeux brillants... Je me demande quel secret se cache au Lac Luhua ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
