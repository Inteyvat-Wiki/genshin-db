			"dialogs": [
				{
					"id": 200120201,
					"content": "#Merci, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120202,
					"content": "*soupir* Je n'ai pas une minute à moi à la maison, alors je pensais qu'un peu d'air frais me ferait du bien. Résultat des courses ? Des monstres, puis une route bloquée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120203,
					"content": "Excuse-moi, pourrais-tu m'aider à débloquer le chemin, s'il te plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120204,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Merci ! J'espère que mes enfants seront aussi gentils que toi quand ils grandiront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120205,
					"content": "#Je suis {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "S'il te plaît ? Ça ne sera pas long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milana"
				}
			]
		},
