			"dialogs": [
				{
					"id": 200120301,
					"content": "#Merci, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120302,
					"content": "#Pourrais-tu rester... {M#discret}{F#discrète} sur ce qui s'est passé ici ? Sinon mon mari n'arrêtera pas de m'en reparler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120303,
					"content": "Ne me regarde pas comme ça. C'est un luxe d'avoir du temps pour soi lorsqu'on doit s'occuper de sa famille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "Milana"
				},
				{
					"id": 200120304,
					"content": "Prends ça en cadeau. Je les ai cueillis tout à l'heure. C'est bien moins cher de les cuisiner toi-même que d'aller les manger au restau. Parfois, il faut se serrer la ceinture pour survivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milana"
				}
			]
