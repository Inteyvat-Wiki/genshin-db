			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Mince, je n'ai pas encore eu le temps de faire à manger, donc je n'ai rien à vous servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "Pas besoin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Cette petite, c'est ton amie ? Elle est plutôt mignonne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "Voulez-vous venir voir les fleurs quand elles écloront ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Elles fleuriront très probablement dans quelques jours. Revenez plus tard pour voir les fleurs que vous avez aidé à planter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Très bien, très bien, j'ai compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "On n'a pas faim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Venez voir. Regardez ces graines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "Rien ne semble avoir changé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Je travaille la terre depuis des années, mais planter des fleurs est quelque peu différent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Sinon, pourquoi n'ont-elles pas poussé depuis tout ce temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Voyons voir, hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Monsieur Affan, je pense que votre pépinière est trop sèche et que la terre autour du Village d'Aaru n'est pas assez riche en nutriments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "On a déjà aidé des gens à cultiver des fleurs dans le village, on a de l'expérience en la matière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Oh, c'est donc ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Vous avez raison, ces fleurs rares doivent être un peu plus délicates que des plantes ordinaires. Je ne les ai pas suffisamment arrosées et fertilisées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Cette pépinière est un peu loin des sources d'eau. Ce n'est pas facile d'apporter de l'eau jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Je n'ai pas beaucoup d'eau en réserve pour mon usage quotidien. Ce n'est donc pas pratique pour arroser les graines dans la pépinière régulièrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Je vais aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Bon, commencez par arroser ces trois graines, si vous le voulez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320503",
							"2"
						],
						"stepId": 7320503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "#Bien, très bien, vous êtes vraiment {M#débrouillards}{F#débrouillardes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050302,
					"content": "#J'ai le sentiment qu'elles vont pousser maintenant que je suis conseillé par des {M#experts}{F#expertes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050303,
					"content": "Les shawarmas et le tahtchine étaient bons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050304,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Alors je vais vous en faire d'autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050307,
					"content": "Ma cuisine n'est pas aussi bonne que celle de ma défunte femme, j'espère que vous me pardonnerez. Prenez ça, il y en a un peu moins cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050308,
					"content": "C'est très bon ! Vous êtes très gentil, monsieur Affan. On viendra souvent vous rendre visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050309,
					"content": "Haha, vous vouliez me demander de quel genre de fleur il s'agit, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050310,
					"content": "Ça ne me dérange pas de vous le dire. En fait, je n'ai planté que des roses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050311,
					"content": "Les mêmes roses que les roses sumériennes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "On appelle cette variété de fleur « rose dorée ». Elles sont beaucoup plus précieuses que les roses sumériennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050313,
					"content": "J'ai dit plus tôt que ces graines m'avaient été laissées par un ami, vous vous en souvenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050314,
					"content": "En fait, ces graines et cette vieille maison dans laquelle je vis m'ont été laissées par le vieux fantôme d'un défunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050315,
					"content": "Ah, j'ai oublié, vous n'êtes pas du Village d'Aaru, donc vous ne connaissez certainement pas ce nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050316,
					"content": "Ce n'est pas grave si vous ne le connaissez pas, rappelez-vous simplement qu'il s'agit d'un vieil homme qui savait cultiver les fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050318,
					"content": "Monsieur Affan, pourquoi vous êtes-vous arrêté de parler ? Monsieur Affan, ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050319,
					"content": "Oups, ai-je eu un moment d'absence ? Je suis très âgé et j'ai du mal à me concentrer, je suis vraiment désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050320,
					"content": "Merci à vous deux. Si vous voulez voir autre chose, n'hésitez pas à faire un tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050321,
					"content": "Je n'enverrai plus les gens dehors. Par contre, faites attention à ne pas marcher sur la pépinière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050306,
					"content": "Je n'y ai pas encore goûté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
			"id": 7320504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
