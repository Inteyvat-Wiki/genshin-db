				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050401,
					"content": "Arrosons d'abord les trois graines, et je m'occuperai de leur fertilisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Ça fait plusieurs décennies que je fais pousser des plantes, donc je sais fabriquer des engrais simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
	]
