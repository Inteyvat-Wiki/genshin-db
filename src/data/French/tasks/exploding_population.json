			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Cet endroit fera l'affaire ! Tu vois ces petits poissons dans l'eau ? Ils sont magnifiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Voici quelques outils que j'ai préparés pour toi : une canne à pêche, des appâts et une recette pour fabriquer des appâts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Accroche l'appât à l'hameçon, puis vise l'endroit où les poissons se rassemblent... et lance ta ligne ! Reste plus qu'à attendre patiemment que ça morde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Apparemment, les débutants ont de la chance. Moi, j'avais attrapé un gros bar d'un demi-mètre ! Allez, essaye, toi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "J'espère que je pourrais attraper une autre Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Je ne te suffis pas ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon ? Quel nom étrange ? C'est une espèce de poisson ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "C'est un produit de la mer merveilleux que j'ai attrapé la dernière fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Hé ! Depuis quand je suis un produit de la mer merveilleux ? Je croyais que j'étais un casse-croûte d'urgence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "#Je vois ! Je ne pensais pas que tu étais {M#un pêcheur expérimenté}{F#une pêcheuse expérimentée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Du coup, j'ai encore plus hâte de voir ce que tu vas attraper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
