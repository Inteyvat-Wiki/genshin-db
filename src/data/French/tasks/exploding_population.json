			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "Vers les étoiles et au-delà ! Bienvenue à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706610102,
					"content": "J'ai reçu une mission de la part de l'Association des pêcheurs récemment. Ses membres affirment qu'il y a une activité anormale de la part des poissons dans les eaux à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706610103,
					"content": "Cependant, nous n'avons pas eu d'explication concrète concernant la situation. Pourrais-tu aller voir ce qu'il se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706610104,
					"content": "Je me sentirais rassurée si c'est toi qui y allais, peu importe la mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706610105,
					"content": "L'Association des pêcheurs ? Il s'agit bien de pêche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Hein ? Oui. Désolée, mais je crains de ne pas bien comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706610107,
					"content": "Ooh, l'Association des pêcheurs... On dirait une association de gens qui pêchent des poissons délicieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Ne perdons pas de temps. Dépêchons-nous d'aller voir ! Héhéhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
