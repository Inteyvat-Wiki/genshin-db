				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Alors ? Vu ton expression, j'imagine que tu as fait une belle prise ! Laisse-moi voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Oh ? C'est une nouvelle espèce de poisson ! Pas mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "Tu rivalises presque avec mes jours les plus glorieux, hahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Vous pouvez aussi attraper des poissons à mains nues ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Hum... On dirait que ce petit poisson ne t'a pas donné assez de fil à retordre... J'aurais dû te demander d'attraper quelque chose de plus compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610606,
					"content": "Tu ne le sais peut-être pas, mais au sein d'une même espèce de poisson, chacun peut être très différent des autres en fonction de son milieu de vie et de son alimentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610607,
					"content": "Ils se ressemblent en apparence, mais certains sont plus actifs. Parfois, ils sautent hors de l'eau et attirent le regard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610608,
					"content": "Ce sont des poissons qui sont bien supérieurs aux autres en termes de valeurs commerciale et esthétique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610609,
					"content": "De nombreux amateurs de poissons les achètent à des prix élevés et les gardent dans leur aquarium pour le plaisir de les regarder. C'est pourquoi ils sont aussi appelés « poissons ornementaux ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610610
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610610,
					"content": "En gros, ça veut dire qu'en plus de la « Paimon casse-croûte d'urgence »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610611
					]
				},
				{
					"id": 706610611,
					"content": "Il existe aussi la « Paimon ornementale » !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610612
					]
				},
				{
					"id": 706610612,
					"content": "N'importe quoi ! Il n'en existe pas deux comme moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610613,
					"content": "Je vois que tu as compris le principe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610614
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610614,
					"content": "Récemment, beaucoup de poissons ornementaux sont apparus dans les eaux à proximité des Montagnes du guet. Je les ai marquées sur ta carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610615
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610615,
					"content": "Allons voir ce qu'il y a de plus près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
