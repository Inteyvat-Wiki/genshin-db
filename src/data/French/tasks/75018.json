			"dialogs": [
				{
					"id": 750180101,
					"content": "... Grr grr grr grr grr grr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "Kururuk"
				},
				{
					"id": 750180102,
					"content": "Allez, arrête de faire n'importe quoi. Tu ne vas pas récupérer si tu ne prends pas tes médicaments !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180103,
					"content": "#Oh non, elle est en danger ! Nous devons l'aider, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
