			"dialogs": [
				{
					"id": 761190101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190102,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "... Hah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190104,
					"content": "On dirait qu'elles s'amusent bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Je te salue également, Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190108,
					"content": "Vous jouez à un nouveau jeu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Oui. J'ai vu des gens jouer avec leurs amis en utilisant des gobelets au Navire amiral, alors j'ai emprunté l'idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190110,
					"content": "Ils plaçaient une pierre précieuse sous un gobelet, puis mélangeaient rapidement les gobelets sur la table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190111,
					"content": "Une fois qu'ils arrêtaient de mélanger, ils demandaient à l'autre joueur de deviner sous quel gobelet se trouvait la pierre précieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190112,
					"content": "Les kuuhenkis adorent la sensation de tournoyer enveloppées dans du tissu, alors je me suis inspirée du chapeau de mademoiselle la sorcière et j'y ai apporté quelques améliorations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190113,
					"content": "C'est adorable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Attendez, vous êtes allée au Navire amiral... est-ce que quelqu'un vous a reconnue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Certains m'ont posé la question, et j'ai répondu : « Je me suis déguisée en Déesse de la lune aujourd'hui. Je lui ressemble beaucoup, n'est-ce pas ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190117,
					"content": "Vous vous êtes inspirée de ce qu'on avait fait pendant la Nuit de la prière lunaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "Et ils vous ont crue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Hm... Pas entièrement, mais ils ne m'ont plus adressé la parole après ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190120,
					"content": "Mon jeu d'actrice n'était pas naturel, peut-être ? Je m'entraînerai ailleurs la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190121,
					"content": "J'ai l'impression que quelqu'un n'a retenu que les mauvaises leçons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "Luonnotar aimerait que vous deviniez où elle se cache. Voulez-vous faire une partie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190124,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "Dans ce cas, veuillez miser 100 000 moras pour commencer. Ce sont les règles du Navire amiral, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190126,
					"content": "Vous n'aviez vraiment pas besoin de retenir cette partie de la leçon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
