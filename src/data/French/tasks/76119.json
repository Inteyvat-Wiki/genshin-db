					"nextDialogs": [
						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "C'était trop facile pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190203,
					"content": "Si vous revenez jouer, j'essaierai de faire tourner les chapeaux plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190204,
					"content": "Je suis curieuse... Comment avez-vous joué avec elles tout à l'heure exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Sans kuuvahki, vous ne pouvez rien voir, mais si vous l'utilisez, vous voyez les choses beaucoup trop clairement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Je peux ouvrir les yeux, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190207,
					"content": "Ah oui. Je n'y avais pas pensé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
