				},
				{
					"id": 207420702,
					"content": "Euh... Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420703
					]
				},
				{
					"id": 207420703,
					"content": "#Toi ! Donna m'a prévenue, elle t'a {M#vu}{F#vue} souffler sur les pissenlits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420704
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420704,
					"content": "Mes excuses, je...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420705
					]
				},
				{
					"id": 207420705,
					"content": "Donna m'a dit que c'était toi qui avait soufflé sur les pissenlits, c'est vrai ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420706
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420706,
					"content": "Tu ne peux pas aller faire ça dans la campagne ? J'ai mis longtemps à faire pousser les miens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420707
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420707,
					"content": "En plus c'est grâce aux graines que tu m'avais ramenées que j'avais fait pousser tout ça... Et c'est tout ce que tu trouves à faire ?",
