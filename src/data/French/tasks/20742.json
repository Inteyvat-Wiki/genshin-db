					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "Oh non, mes pissenlits ! Ils se sont tous envolés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420103,
					"content": "Qu'est-ce que tu fais ! Ces pissenlits n'ont pas été faciles à faire pousser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420104,
					"content": "Euh, j'aide les pissenlits à se répandre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "On est en ville ! Où veux-tu qu'ils aillent se répandre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420106,
					"content": "Comme ça plus de pissenlits pousseront...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "Dans ce cas achète des graines, et va les faire voler dans la campagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420108,
					"content": "*snif* Mes beaux pissenlits, ça m'a pris si longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420109,
					"content": "Tu n'aurais pas pu aller cueillir des pissenlits ailleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420110,
					"content": "En plus, c'est grâce aux graines que tu m'avais ramenées que j'avais fait pousser ça... Et c'est tout ce que tu trouves à faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
