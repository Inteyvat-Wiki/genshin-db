				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Miaou... Cette boîte est vraiment utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640102,
					"content": "Ah, c'est vous. La boîte que vous avez réparée est bien utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640103,
					"content": "Deux humains en vert sont venus au sanctuaire peu après votre départ, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640104,
					"content": "Ils ont fait une offrande de quelques moras, mais le grand humain était fasciné de m'entendre parler. Un rien vous étonne, vous les humains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640105,
					"content": "Quoi qu'il en soit, la boîte à offrandes est un artéfact des plus merveilleux. Peut-être que si on en réparait une autre, on attirerait encore plus de monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640106,
					"content": "Ce n'est pas comme ça que ça marche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "Ah bon ? Les humains sont si compliqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640108,
					"content": "Je pense que c'est l'état du sanctuaire qui fait que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "Qu'est-ce qu'il a ce sanctuaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640110,
					"content": "Disons que c'est un peu sale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Vous trouvez ? Mes petites canailles aiment bien jouer avec les feuilles mortes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640113,
					"content": "Je crois que Hibiki rassemblait les feuilles grâce à un bâton à piques. Si elle le faisait, c'est que c'est la bonne solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640114,
					"content": "Où voulez-vous que je balaie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "Je ne sais pas vraiment ce que font les humains, moi. Hmm, que faisait Hibiki déjà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640117,
					"content": "Elle prenait ce bâton à piques et le déplaçait d'avant en arrière avant le lever du soleil. J'aimais bien suivre le mouvement de ce bâton aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640118,
					"content": "Mais maintenant que je suis la grande prêtresse suppléante, je ne peux me permettre de me comporter de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640119,
					"content": "Je me souviens que Hibiki utilisait de l'eau sur le sol. L'eau... Quelle chose odieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640120,
					"content": "Domeki venait aussi de temps en temps avec son objet en métal qui faisait « snip-snip » et les branches tombaient par terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640121,
					"content": "Domeki ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "C'est un humain très grand et très buyant. Il venait souvent jouer avec Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640125,
					"content": "Hmpf, il s'en prenait toujours à celles que j'aimais le plus. C'était détestable de sa part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640126,
					"content": "J'ai l'impression qu'ils faisaient le ménage, un grand ménage, même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "Balayer le sol, le laver avec de l'eau et couper des branches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "Rien qu'on ne sache pas faire, pas vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "C'est donc ça que vous appelez « ménage » ? Je vois. Dans ce cas, je vous prie de vous mettre au travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640130,
					"content": "Ah, et pas de « snip-snip ». Les branches sont très bien comme elles sont.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640131,
					"content": "Le bâton, les feuilles et l'eau feront l'affaire. Compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640132,
					"content": "On s'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Miaou, c'est la mission que Hibiki m'a spécialement donnée. Personne d'autre ne peut accomplir ce travail important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640133,
					"content": "D'ailleurs, qui est Hibiki ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki est la grande prêtresse du Sanctuaire d'Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640135,
					"content": "Comment vous vous appelez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Neko. C'est Hibiki qui m'a nommée ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640137,
					"content": "C'est elle qui recevait les invités et s'occupait de ces lieux, du coup je n'avais pas à le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640138,
					"content": "Je n'avais pas de nom ou de titre, puis je dormais où bon me semblait et jouais avec qui je voulais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640139,
					"content": "Un jour, Hibiki m'a nommée « Neko » puisque je suis un chat et que je fais souvent la sieste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
