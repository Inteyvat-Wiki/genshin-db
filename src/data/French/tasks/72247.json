					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "#Vous semblez suffisamment {M#fort}{F#forte} pour transporter les offrandes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470202,
					"content": "Ainsi, je pourrai enfin reposer en paix... Ces objets doivent être acheminés pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470203,
					"content": "Pour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470204,
					"content": "Pour... pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470205,
					"content": "Ah, ça y est. Il est cassé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470206,
					"content": "Je suppose qu'il parlait de ces trucs... Même s'ils sont un peu abîmés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224703,
			"completionStepIds": [
				7224705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
