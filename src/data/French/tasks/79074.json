						],
						"pointId": 910002012
					}
				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "#Ah, deux {M#nouveaux guerriers}{F#nouvelles guerrières} se présentent pour relever le défi ! Êtes-vous ici pour jouer à Bourrasque boréale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Venez par ici ! J'ai hâte d'admirer vos prouesses de vol inégalées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "Calmez-vous, voyons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "#Il n'est pas nécessaire de rester calme pour voler, {M#cher invité}{F#chère invitée}, absolument pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Garder votre sang-froid ne fera qu'émousser votre sens du vent. Affronter le vent déchaîné sans aucune préparation permet de dévoiler votre véritable potentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Les écureuils volants sont très timides de nos jours ! Ils ont complètement oublié les enseignements de Brave vent du nord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Ils restent dans des endroits sûrs et déclament le courage des feuilles qui dansent au vent, mais ils sont bien trop effrayés pour sauter eux-mêmes dans ses bras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Comment pouvons-nous protéger le royaume aux côtés de Son Altesse si les choses continuent ainsi ? C'est ridicule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Bon sang, cet écureuil volant a de l'énergie à revendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "On dirait qu'il aime vraiment voler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "C'est pourquoi je me suis trouvé un passage avec un courant de vent particulièrement intense et j'y ai installé toutes sortes d'appareils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Seuls les plus courageux, les plus audacieux et les plus belliqueux en vol seront les meilleurs sur ce parcours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "#Avez-vous le courage nécessaire, {M#chers invités}{F#chères invitées} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Je vais essayer !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Super ! Alors, suivez-moi ! Le passage n'est pas loin d'ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Eh bien... J'ai autre chose à faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Oh ? Vous avez besoin d'un peu de temps pour vous préparer ? Ce n'est rien, j'attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Revenez quand vous voulez pour relever le défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Je n'ai encore rien dit !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}