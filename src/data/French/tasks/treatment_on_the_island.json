			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "Pfiou... Mon cœur battait la chamade. Merci de m'avoir sauvé la vie. Je ne l'oublierai pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "C'est un phénomène normal. Les êtres contaminés par le Tatarigami sont inconsciemment attirés par des sources qui dégagent une énergie sinistre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Comme ce médicament contient une grande quantité d'énergie corrompue, il était prévisible que cela les attire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "En tout cas, je pense savoir maintenant comment modifier la formule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "Mais ce dernier échec a gaspillé des herbes fraîches. J'ai besoin de plus d'herbes pour continuer mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Lors de vos futurs voyages, {NICKNAME}, faites attention aux herbes sur l'île. Et si vous en ramassez, laissez-les simplement dans le panier en bambou devant la maison au petit matin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Je vous donnerai la récompense comme je l'ai promis. Mais je crains que vous ne deviez attendre un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#{NICKNAME}, ce n'est pas grave si vous êtes trop {M#occupé}{F#occupée}. Peut-être que je peux trouver quelqu'un d'autre pour m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "J'ai compris !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Au revoir, {NICKNAME}. J'espère que vous ferez un bon voyage sur l'Île de Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Bien sûr, je vais m'en occuper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
		},
