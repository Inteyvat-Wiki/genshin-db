	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Ahhh ! Je... Je ne suis pas quelqu'un de suspect, je jure. Je suis juste un médecin local !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Si vous ne me croyez pas, je peux vous emmener chez moi. Si vous voulez quelque chose, prenez-le. S'il vous plaît, laissez-moi partir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Ou amenez-moi à votre général, le seigneur Kujou ! Il me connaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Je pense qu'il y a un malentendu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "Ah...? Oh, vous n'avez pas l'air de quelqu'un du Shogunat... ni de Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "#Vous êtes... des {M#étrangers}{F#étrangères} ? Pourquoi êtes-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Eh bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Hmm... De toute façon, il vaut mieux que vous partiez vite. L'Île de Yashiori est très dangereuse maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Jusqu'à présent, il n'y a aucun signe que le Tatarigami va disparaître. La Commission administrative n'a pas non plus l'intention de se retirer de l'île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "L'île n'est plus habitable, et encore moins propice au tourisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "Si vous êtes en fuite pour échapper au Commissaire, dirigez-vous vers l'ouest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "La Commission administrative n'accueille pas les fugitifs inconnus. Mais les pirates pourraient vous offrir l'hospitalité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "Que s'est-il passé sur l'île ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "Hmm... Regardez par vous-même. Voyez ce que les gens de la ville et ceux de Sangonomiya nous ont fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "D'abord, il y a eu l'explosion à Tatarasuna. Le ciel était teinté de couleurs étranges cette nuit-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Beaucoup de mes proches et amis ont perdu leur emploi et vivent maintenant dans la pauvreté... Beaucoup d'autres ont été grièvement blessés, et ils étaient terribles à voir lorsqu'ils sont finalement revenus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Beaucoup de mes amis... n'ont pas réussi à revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Puis, ceux de Sangonomiya ont détruit les protections qui contrôlaient les restes de la divinité serpent. Le Tatarigami s'est étendu et tout le monde sur l'île s'est enfui dans la panique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "Les étranges maladies apportées par le Tatarigami se propagent également. De nombreux habitants d'ici sont tombés très malades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Je crains que ce ne soit qu'une question de temps avant que cela ne se répande dans les camps des deux armées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "C'est quoi, cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "C'était ici que le cristal utilisé pour fabriquer le tamahagane d'Inazuma était initialement produit. Tant que le cristal ne s'épuisait pas, nous pouvions vivre confortablement sans être contraints par les seigneurs de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "Et maintenant ? On peut à peine trouver quelqu'un de vivant sur l'île... Je veux dire, des « gens » qui peuvent parler normalement comme moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Pourquoi ne pas partir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Vous pensez que je ne veux pas partir ? Le fils du Commissaire administratif m'y a déjà invité auparavant... Il devrait encore être dans l'armée à commander les batailles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "« Vous maîtrisez la médecine, vous êtes différent des gens ordinaires. C'est dangereux pour vous de rester sur l'île. Pourquoi ne viendriez-vous pas pour devenir mon médecin militaire ? Je peux vous recommander auprès de mon père. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "C'est ce qu'il a dit, du moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Avant la guerre, le fait de pouvoir soigner un Commissaire était un honneur dont je n'aurais même pas rêvé en tant que médecin de campagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Mais bon... Pensez-y. Un Commissaire ne manque pas de bons médecins dans son entourage. Mais qu'en est-il de l'Île de Yashiori ? La seule personne sur laquelle les malades ici peuvent compter, c'est moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Donc je ne vais pas partir. Je ne traiterai aucune armée. Mon seul ennemi est le Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Y a-t-il quelque chose que je puisse faire pour vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Non, rien... À vrai dire, oui. Pour être tout à fait honnête, j'ai vraiment besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "J'ai besoin d'herbes spéciales pour fabriquer des médicaments contre les étranges maladies causées par le Tatarigami. Je ne sais pas si cela fonctionnera... Mais qui ne tente rien n'a rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Le problème, c'est que... Les plantes dont j'ai besoin ont été contaminées par le Tatarigami. Et puis, on les trouve surtout dans des zones dangereuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Des endroits soit coupés par l'eau, soit grouillant de monstres en tout genre... Sans compter la corruption du Tatarigami qui est particulièrement intense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Pour quelqu'un avec mon courage et mes capacités, ce serait difficile à gérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "De plus, en tant que médecin, je n'ose pas prendre autant de risques pour aller chercher des herbes. Je ne peux donc utiliser que des traitements traditionnels qui prennent beaucoup de temps... Cela fait longtemps que je n'ai pas eu l'occasion de concocter de nouveaux remèdes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "#{M#Étranger}{F#Étrangère}, je vois que vous avez apporté un planeur avec vous. Vous devez être {M#un voyageur expérimenté}{F#une voyageuse expérimentée}. Je suis sûr que vous serez capable de faire face à de tels dangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "J'espère donc que vous pourrez m'aider à cueillir les herbes appropriées dans ces endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Venez me retrouver ici une fois que vous aurez cueilli des plantes. Ne vous inquiétez pas pour la récompense, j'ai encore quelques économies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Bien que ce soit une mission confiée par un inconnu, j'espère que vous pourrez la prendre en considération. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "#Soit dit en passant, soyez {M#prudent}{F#prudente} sur le chemin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Vous avez l'air abattu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "C'est une longue histoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Comme c'est bizarre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
