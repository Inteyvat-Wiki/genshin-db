			},
			"dialogs": [
				{
					"id": 721380401,
					"content": "#Merci, {NICKNAME}. Je suis désolé si je vous dérange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380402,
					"content": "Non, pas du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "J'ai utilisé les herbes que vous avez ramassées pour mélanger un nouveau médicament, mais je n'ai encore personne sur qui tester son efficacité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380405,
					"content": "#{NICKNAME}, pourriez-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380406,
					"content": "N'hésitez pas à me demander...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#{NICKNAME}, je vais prendre ce médicament. Puis-je vous demander de vérifier son efficacité sur ma personne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380408,
					"content": "La nouvelle prescription est encore instable et il n'y a aucun moyen de prévoir les effets secondaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380409,
					"content": "Donc j'espère qu'au moins quelqu'un pourra être témoin de mon succès... Ou m'aider à faire face aux conséquences, si le pire devait arriver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380410,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "Ce n'est pas grave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
		},
		{
			"id": 7213805,
