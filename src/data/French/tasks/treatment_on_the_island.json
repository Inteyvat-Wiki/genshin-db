						721380703
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380702,
					"content": "Est-ce que vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380704
					]
				},
				{
					"id": 721380704,
					"content": "Eh bien... *tousse* C'est très amer, et je ne sens plus ma langue. Cette paralysie partielle pourrait être causée par le Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380705
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380705,
					"content": "Le goût est horrible, mais cela semble inoffensif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380706
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380706,
					"content": "Les effets secondaires peuvent prendre un certain temps avant de se manifester, et je ne sais pas si... Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380707
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380707,
					"content": "#Ils... Ils s'approchent de nous ! {NICKNAME} ! Débarrassez-vous d'eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
