			"dialogs": [
				{
					"id": 150200601,
					"content": "C'était incroyable ! Je ne pouvais pas te quitter des yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "Alors, tu as trouvé d'autres problèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Hmm... Non, rien de grave. Encore quelques jours et les épreuves pourront se dérouler normalement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "Au secours... À l'aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "... Vous êtes du Clan des fleurplumes, n'est-ce pas ? Venez vite, s'il vous plaît, vous devez nous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Reprenez d'abord votre souffle. Que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "N—Nous étions... Nous avons été attaqués par un qucusaure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "Mes amis sont toujours bloqués au milieu de la route avec les marchandises que nous transportons... Je vous en supplie, sauvez-les, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Hein ? Les qucusaures sont-ils vraiment si agressifs ? Attaquent-ils souvent des groupes de personnes sans avoir été provoqués ?",
