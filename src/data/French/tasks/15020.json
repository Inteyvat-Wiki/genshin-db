			},
			"dialogs": [
				{
					"id": 150200101,
					"content": "Oh, salut Chasca. C'est l'aînée Allpa qui t'envoie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Oui, elle est très occupée en ce moment. Comment ça se passe ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hmm, eh bien, l'inspection a révélé de nombreux blocages partout dans l'arène de l'épreuve. On dirait qu'ils sont le résultat de perturbations des lignes énergétiques provoquées par les invasions répétées de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Théoriquement, il suffit de retirer ces obstacles pour que l'arène se remplisse à nouveau de phlogistique gazeux. Mais pour diverses raisons, ce n'est pas aussi simple que ça dans la pratique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Pourquoi n'irais-tu pas vérifier par toi-même ? N'hésite pas à demander plus d'informations aux membres du personnel sur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
			"id": 1502002,
