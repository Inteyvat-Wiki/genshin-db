			"dialogs": [
				{
					"id": 150200501,
					"content": "Tout le monde est prêt ? Ça devrait être un jeu d'enfant pour Chasca, mais faites quand même attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "#Je suis {M#sûr}{F#sûre} que tout va bien se passer{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Très bien, alors déployez vos ailes et volez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200504,
					"content": "Pas encore, j'ai encore besoin d'un peu de temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
