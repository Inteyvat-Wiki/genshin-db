					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Enquêteur dubitatif"
				},
				{
					"id": 150200702,
					"content": "Pourrait-il provenir des Enfants des échos...? Peut-être qu'il est arrivé ici à cause de perturbations des lignes énergétiques. <color=#00E1FFFF>J'ai aussi vu ces étranges marques sur la falaise...</color>",
					"roleType": "TALK_ROLE_NPC",
