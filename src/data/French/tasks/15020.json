			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hein ? Chasca, {NICKNAME} ? Quelle surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Aînée Allpa ? Alors, euh... Où est ce qucusaure agressif dont nous avons entendu parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Il est déjà parti. On dirait qu'il a renoncé quand il a réalisé que des renforts arrivaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "À votre avis, pourquoi les a-t-il attaqués ? Cherchait-il de la nourriture ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "Non, cette caravane marchande ne transporte même pas de nourriture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Oh ! Loués soient les Archons ! Les ailes phlogistiques sont intactes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Jeune marchand"
				},
				{
					"id": 150200807,
					"content": "... Les ailes phlogistiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "Merci beaucoup de nous avoir sauvés. Ces ailes phlogistiques sont ce que nous avons de plus précieux. S'il leur arrivait quelque chose, nous serions ruinés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "#... Attendez une minute, êtes-vous la caravane marchande qui cherchait à collaborer avec nous{NON_BREAK_SPACE}? Warmi m'a parlé de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Oui, c'est bien ça ! Alors... Je suppose que vous êtes l'aînée Allpa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "En personne. Vous devez être épuisés par votre voyage, sans parler des émotions provoquées par l'attaque. Laissez-moi vous ramener dans notre tribu pour que vous puissiez vous reposer. Nous pourrons parler affaires une fois que vous aurez récupéré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Mais aînée Allpa... Qu'en est-il de l'attaque du qucusaure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Eh bien, nos invités ici n'ont pas été grièvement blessés et leurs marchandises sont intactes... Peut-être que ce qucusaure passait simplement une mauvaise journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Il y en a tellement dans le coin qu'il n'est pas surprenant que quelque chose comme ça arrive de temps en temps. Je ne pense pas qu'il soit nécessaire d'aller plus loin... Et surtout, comment se déroulent les préparatifs de l'épreuve de vol ? Est-ce que tout est en ordre à l'arène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "C'est en bonne voie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Hein ? Vous avez dit... l'épreuve de vol ? Quelle coïncidence ! C'est l'occasion parfaite pour essayer nos ailes phlogistiques ! Vous serez agréablement surprise de voir ce dont elles sont capables !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Ah bon ? ... Vous m'intriguez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Héhé, alors oublions cette attaque de qucusaure pour l'instant... Il y a des choses sérieuses dont nous devons discuter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "C'est tout ? Ça s'est plutôt bien passé... On devrait y aller, alors... Hein ? Chasca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "Qu'est-ce que tu regardes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Une plume tachée de sang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "L'incident est oublié et la paix revient dans le Clan des fleurplumes.\\nLes jours suivants se déroulent calmement, à l'exception des préparatifs pour l'épreuve de vol qui se poursuivent à un rythme effréné...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "L'épreuve va pouvoir démarrer très prochainement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
