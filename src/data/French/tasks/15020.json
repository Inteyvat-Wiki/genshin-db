			"dialogs": [
				{
					"id": 150200401,
					"content": "Waouh, vous avez réussi en un rien de temps... Bravo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Il ne reste plus qu'à attendre qu'il y ait suffisamment de phlogistique gazeux et nous pourrons lancer la nouvelle épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Hmm... En fait, Inkanak, j'aimerais d'abord faire un vol d'essai, juste pour être sûre que nous n'avons rien raté. Pourrais-tu organiser ça pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Hein ? Mais... Tu viens à peine de finir de préparer l'arène, il pourrait encore y avoir d'autres dangers dont nous ignorons l'existence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "Raison de plus pour que ce soit moi qui fasse le tour d'essai. Vois ça comme une autre inspection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Hmm... Je suppose que tu as raison. Avec tes compétences en vol, tu ne risques rien de très sérieux, même s'il reste certains dangers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "Les conditions dans cette zone semblent un peu instables, mais un vol d'essai est le seul moyen de détecter les éventuels problèmes restants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Très bien, je vais préparer ça pour toi. Fais-moi signe quand tu seras prête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
