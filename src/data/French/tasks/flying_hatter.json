			"dialogs": [
				{
					"id": 790720101,
					"content": "#Oh, quel honneur ! Vous devez être {NICKNAME} ! Et à vos côtés, ce doit être votre compagnon, mademoiselle Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Héhé, exactement ! C'est nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "Sommes-nous si célèbres que ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Les nouvelles circulent vite dans la Métropole constellaire, plus vite que nulle part ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "Vous arrivez au bon moment ! J'étais justement en train de mettre la touche finale à mon jeu, Chapeaux volants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Même si je ne peux pas faire comme le chapelier dans Le chapelier volant et offrir un joli chapeau à tout le monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Je pense que « Chapeaux volants » apportera aussi beaucoup de joie à ceux qui y joueront !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "J'ai également développé trois modes de jeu complètement différents... Mais ne vous en faites pas, les règles ne sont pas compliquées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Après une seule partie, vous aurez déjà tout compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "J'ai envie d'essayer !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "D'accord, par ici, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "Je n'ai pas le temps pour ça en ce moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Aucun problème. Revenez me voir quand vous aurez le temps. Je compte rester ici pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				}
			]
		}
	]
