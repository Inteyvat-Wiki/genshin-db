			"dialogs": [
				{
					"id": 220170201,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'apporter quelques romans pour que j'explique mon point de vue à Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170202,
					"content": "Hmph ! Si je le laisse faire comme bon lui semble, son roman sera fichu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		},
		{
			"id": 2201703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
