	"talks": [
		{
			"id": 2201701,
			"completionStepIds": [
				2201701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201701",
							"2"
						],
						"stepId": 2201701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Assez ! J'arrête l'écriture ! Tu peux me mettre la pression autant que tu veux, mais je ne changerai pas d'avis ! J'arrête le métier d'auteur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Eh bien... Tu m'as menacé de grève sept fois déjà, mais es-tu passé à l'action ne serait-ce qu'une seule fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Vous vous disputez encore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "#Vous voilà enfin, {M#voyageur}{F#voyageuse} ! Aidez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Depuis que vous avez pris son parti la dernière fois, Shigeru m'a imposé des dizaines de règles à respecter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "Que ça soit pour les noms ou les rebondissements de l'intrigue, il veut instaurer... des normes d'écriture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Comment puis-je écrire dans de telles conditions ? Il n'a qu'à écrire les chapitres lui-même en fonction de son processus, non ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Ce sont des principes d'écriture que j'ai tirés d'autres romans à succès. C'est l'expérience de nos prédécesseurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "C'est imposer des principes d'autres romans au mien. Je suis l'auteur, oui ou non ? Je ne veux pas copier qui que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Je n'écrirai jamais avec une telle... rigidité ! Tu n'as qu'à le faire toi-même si c'est ce que tu veux vraiment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "D'ailleurs, il y en a déjà plein des romans de ce genre qui ne se vendent pas chez la Chambre Yae, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "C'est à cause d'un mauvais marketing, il n'y a aucun rapport avec...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Mais oui, bien sûr ! Le marketing n'a rien à voir là-dedans. Ces romans sont tout simplement mal écrits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Tu ne connais peut-être pas tous les livres qui sortent, mais en tant qu'auteur, je peux t'assurer que j'ai lu chacun des romans publiés par la Chambre Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'apporter quelques romans pour que j'explique mon point de vue à Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Bien sûr, je vous les apporte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Lesquels voulez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Vous n'aurez qu'à me ramener ceux que j'ai souvent avec moi. Je les regarde souvent pour... me souvenir de ce que je ne dois pas faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
