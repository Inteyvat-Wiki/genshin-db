				}
			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Dans mes souvenirs, ce roman de suspense est resté populaire très longtemps, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170402,
					"content": "La structure de son intrigue et ses énigmes intelligentes ont fait sa réussite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170403,
					"content": "Bien que de nombreux lecteurs se soient plaints de certains passages, l'auteur est resté fidèle à son style d'écriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170404,
					"content": "On peut dire que ce roman s'est démarqué des autres grâce à ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170405,
					"content": "Néanmoins, cette œuvre repose sur des bases solides. Ce n'est qu'avec un cadre posé qui ne se laisse pas facilement modifier que l'intrigue d'un roman à suspense peut se développer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170406,
					"content": "#Hum, pourriez-vous me passer un autre roman, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Celui-ci ? Je me souviens que l'écriture était excellente et l'intrigue, très bien pensée. Les éditeurs étaient unanimes là-dessus, puis il s'était bien vendu aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170502,
					"content": "... Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170503,
					"content": "Pourtant, l'intrigue était si rigide qu'elle ne permettait pas le développement de l'histoire. Si bien qu'à la fin, les lecteurs se retrouvaient à lire des choses qu'ils savaient déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170504,
					"content": "À cause du manque d'idées nouvelles, le nombre de lecteurs a progressivement diminué, jusqu'à l'annulation de l'œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170505,
					"content": "Que ça soit la trame ou l'intrigue, si on se laisse enfermer par des règles, nos histoires finissent par toutes se ressembler et nous, par stagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170506,
					"content": "C'est la dernière chose que je souhaite à mon roman ! Une bonne histoire doit être pleine de vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170507,
					"content": "Et si l'histoire n'intéresse pas celui qui l'a écrite, n'espérons même pas qu'elle plaise aux lecteurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170508,
					"content": "Shigeru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170509,
					"content": "... J'ai compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170510,
					"content": "Je ne pensais pas que tu prenais tous ces éléments en compte. Eh bien, je suppose que tu n'es pas l'auteur d'« Onibudo » pour rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170511,
					"content": "Honnêtement, mon but n'était pas de te priver de ta liberté de création. C'est juste que j'ai vu trop d'auteurs ruiner leurs œuvres à cause de leurs excès d'imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170512,
					"content": "Junkichi, comment définirais-tu la créativité en tant qu'auteur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170513,
					"content": "Je pense qu'on peut parler de soif de création. Un écrivain qui n'a pas cette envie aura du mal à toucher ses lecteurs avec son œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170514,
					"content": "Mais j'estime qu'il est quand même plus important pour un écrivain d'arriver à exprimer sa créativité avec retenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170515,
					"content": "Vous n'êtes toujours pas d'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Shigeru, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170518,
					"content": "Malgré tout, ce roman n'est pas le mien. Tu en es l'auteur et je ne suis que l'éditeur qui doit t'aider à le terminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170519,
					"content": "Si tu es convaincu que ton approche est la bonne, écris comme tu le sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170520,
					"content": "Je ne te garantis pas de pouvoir être d'accord avec toi, mais du moins, je peux essayer de comprendre ton point de vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170521,
					"content": "Merci, Shigeru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170522,
					"content": "Je t'en prie, c'est normal. Mais je veux aussi que tu fasses des efforts pour écouter ce que j'ai à te dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170523,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170524,
					"content": "Eh bien, une belle journée est passée, mais... Où est ton manuscrit ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170516,
