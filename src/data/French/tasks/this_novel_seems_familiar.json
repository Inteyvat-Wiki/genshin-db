			},
			"dialogs": [
				{
					"id": 220170301,
					"content": "#{M#Voyageur}{F#Voyageuse}, apportez-moi vite ces romans, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
