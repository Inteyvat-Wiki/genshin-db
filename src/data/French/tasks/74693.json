			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbeloth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Vous ne pouvez pas me faire une copie de ce dos de carte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930102,
					"content": "Absolument certaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930103,
					"content": "C'est très impressionnant. Peut-être que nous pourrions nous arranger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930104,
					"content": "Absolument pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930105,
					"content": "Je vois. Obtenir de beaux dos de carte et jouer des cartes puissantes a un certain prix. Je crois que j'ai compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930106,
					"content": "Je ne pense pas que vous compreniez vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "Hé ! Tu ne sais pas pourquoi Cyno est ici ! Peut-être qu'il est venu pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930110,
					"content": "#Eh oui ! Comme je m'attendais d'{M#un ami}{F#une amie} aussi proche, on est sur la même longueur d'onde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930111,
					"content": "Sérieusement ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930112,
					"content": "Il y a un petit rassemblement de joueurs de JCC qui a lieu ici à Fontaine. J'ai entendu dire que les participants recevaient gratuitement des porte-cartes exclusifs à l'événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930113,
					"content": "Il n'y avait rien d'urgent à l'Académie, donc je suis venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930114,
					"content": "Même s'il y avait des affaires urgentes, j'ai le sentiment que vous auriez trouvé un moyen de les rendre moins urgentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930115,
					"content": "C'est vrai ! J'ai réussi à terminer presque tout mon travail après seulement deux semaines d'heures supplémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930116,
					"content": "Sethos m'a aussi aidé, alors je lui ai promis de lui ramener un porte-cartes pour le remercier. Il est très doué pour la paperasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930117,
					"content": "Alors, général mahamatra, allez-vous tirer une carte ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930118,
					"content": "Bien sûr. Vous dites que cette carte va prédire mon avenir, c'est bien ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930119,
					"content": "Techniquement, ce n'est pas tout à fait exact. Mais il n'y a aucun problème si vous choisissez de le comprendre ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930120,
					"content": "Je vois... C'est comme cette réplique dans « Maître des duels » : « Mise tout ton destin sur la prochaine pioche » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930121,
					"content": "Maintenant, c'est à mon tour de piocher...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930122,
					"content": "Cyno inspire profondément, prend une pose stylée et tire une carte...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Ah, la carte « La Tempérance » à l'envers. Une carte parfaite pour le général mahamatra de l'Académie de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930124,
					"content": "Vous savez qui est Cyno ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Alice l'a mentionné plusieurs fois. Elle trouve ça drôle que l'Académie, si guindée, ait un général mahamatra avec un sens de l'humour aussi développé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930126,
					"content": "Remerciez-la pour le compliment. Maintenant que j'ai tiré une carte, que dois-je faire ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930127,
					"content": "Puisque c'est la carte « La Tempérance » à l'envers, ou plutôt « L'Art » à l'envers, je vous suggère de ne rien faire pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930128,
					"content": "Vous avez agi de manière impulsive et vous avez failli perdre l'équilibre sur l'étroit pont du destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930129,
					"content": "C'est parce que j'ai trop joué aux cartes, c'est ça ? Sethos et Tighnari m'ont dit la même chose. J'ai déjà changé mon emploi du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930130,
					"content": "... Je ne parle pas de jouer aux cartes. Je parle de vos heures de travail. L'Invocation des Sept n'est tout de même pas la seule chose qui requiert toute votre attention, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930131,
					"content": "Mes obligations ne me laissent pas de marge pour les ajuster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930132,
					"content": "Vous avez l'habitude de supporter seul la pression d'un emploi du temps aussi strict ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930133,
					"content": "Il y a d'autres matras. On se partage la pression.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930134,
					"content": "Mais ils comptent tous sur vous, n'est-ce pas ? Pas seulement les matras, mais aussi les chercheurs et les habitants de Sumeru... Tant de gens ont placé leur confiance en vous, général mahamatra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930135,
					"content": "Ils ne vous le disent jamais, peut-être même ne s'en rendent-ils pas compte... Pourquoi le feraient-ils, alors qu'ils sont tous captivés par votre intelligence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930136,
					"content": "Mais vous pouvez sentir leurs regards posés sur vous jour et nuit... Oh, et l'ombre qui marche à vos côtés. Lui aussi fait partie de vos fardeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930138,
					"content": "Vous avez l'habitude de montrer la voie, de porter les fardeaux des autres... Je pense que c'est peut-être la raison de ce déséquilibre chez vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930139,
					"content": "J'ai beaucoup d'amis, et l'Invocation des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930140,
					"content": "Dans ce cas, il semblerait que vous n'ayez aucune intention de vous reposer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930141,
					"content": "Je n'ai pas le temps de me reposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930142,
					"content": "En effet. Si le combat intérieur est infini pour quelqu'un comme vous, alors même la mort ne pourrait mettre fin à votre devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930143,
					"content": "Prenez cet arcanum lunaire. Peut-être qu'il vous mènera à la raison qui rétablira votre équilibre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930144,
					"content": "Quand ce moment viendra, le combat qui fait rage en vous devrait également trouver son dénouement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930145,
					"content": "Cyno ne perdra pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#Merci, {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930148,
					"content": "Merci à vous aussi, je vais garder cette carte avec moi. Je vous promets de ne pas l'emmener dans la Forteresse de Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930149,
					"content": "... Hein ? Pourquoi l'emporteriez-vous là-bas... Attendez, c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930150,
					"content": "Oh non, pas encore !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "... Quel rapport avec la Forteresse de Méropide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930154,
					"content": "Parce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930155,
					"content": "... On pourrait bien me traiter de véritable « lunatique » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930151,
					"content": "Il en a encore inventé une autre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "Barbeloth, ne demandez pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "Cyno est très fort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "Je ne comprends pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "Vous êtes venu jusqu'ici pour jouer aux cartes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
