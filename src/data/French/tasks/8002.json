		{
			"id": 800207,
			"completionStepIds": [
				800208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Borée"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "Tss... Le rituel a été interrompu. Vous avez de la chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020702,
					"content": "Qu'un esprit aussi vieux possède une volonté aussi déterminée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020703,
					"content": "Peu importe. Ce n'est qu'une variable mineure, qui ne change rien à notre grand projet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020704,
					"content": "Et il disparaît encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020705,
					"content": "Au moins, on l'a arrêté cette fois-ci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "#Merci... Vous êtes {M#arrivés}{F#arrivées}... à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020708,
					"content": "Mon lupical humain... J'ai honte de me présenter devant vous dans cet état.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020709,
					"content": "Mais l'Apôtre de l'Abîme a sous-estimé ma force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020710,
					"content": "Borée refuse jamais... un défi. Mais l'étranger effrayant... Il respecte pas... les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020711,
					"content": "Moi non plus, je n'ai pas vu... le piège...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020712,
					"content": "Tu veux dire que l'Ordre de l'Abîme avait tout préparé pour corrompre l'esprit de Borée, et l'a attiré sous le prétexte d'un défi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020713,
					"content": "Ce n'est pas de ta faute, Razor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Merci, {NICKNAME}. À l'avenir, mes griffes... doivent être plus acérées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020716,
					"content": "#Vous... avez reniflé le danger... et vous êtes {M#venus}{F#venues}, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020717,
					"content": "Euh, non, on en avait entendu parler... Mon nez n'a aucune idée de l'odeur du danger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020718,
					"content": "On est ici pour aider, mais aussi parce qu'on a quelque chose à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020719,
					"content": "Euh... Excusez-moi, monsieur le Dieu Loup, le « Laboureur originel », ça vous parle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020720,
					"content": "Je ne prête guère attention aux inventions des humains. J'ignore tout de ce « Laboureur ». Mais j'ai par le passé rencontré une machine que jamais je n'oublierai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020721,
					"content": "Elle avait pénétré mon terrain d'épreuve par accident, et j'ai cru qu'il s'agissait de quelque guerrier venu me défier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020722,
					"content": "Mais elle ne pouvait pas penser, elle avait été programmée uniquement pour le combat. Elle avait été conçue pour être une machine à tuer, rien d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020723,
					"content": "Une de mes attaques a fini par l'endommager considérablement. Elle a fui l'endroit avant de s'écrouler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020724,
					"content": "Hmm... À vue de nez, c'était peut-être ce « Laboureur originel », non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020725,
					"content": "Pouvait-elle tourner sur elle-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Oui. Elle pouvait pivoter, bondir dans les airs, et même tirer des boules de feu. Elle n'était pas de taille face à un dieu, mais elle était malgré tout plus puissante que nombre de possesseurs d'œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020730,
					"content": "Des boules de feu... Hé, on a entendu ça ailleurs il n'y a pas longtemps, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020731,
					"content": "Bon, ça indique en tout cas que ce « Laboureur originel » est arrivé à Mondstadt, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020732,
					"content": "On dirait bien que ce premier modèle était bien plus puissant que les Gardiens des ruines produits en série par la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020733,
					"content": "Mais d'après cette histoire, il semblerait qu'il a été endommagé en combattant le Loup du Nord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020734,
					"content": "Je ne comprends pas... Mais ça vous aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020735,
					"content": "Oui, ça nous aide énormément ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020736,
					"content": "On doit continuer d'enquêter sur quelque chose d'important. L'Apôtre de l'Abîme est peut-être parti, mais les forces de l'Abîme continuent d'attaquer, alors soyez prudents tous les deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020737,
					"content": "Oui, je sens... plus de danger... Un danger plus grand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020738,
					"content": "Vous aussi... Attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020727,
					"content": "Pouvait-elle tirer des missiles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "Des « missiles » ? Je ne connais pas ce mot étrange... Comme je l'ai dit, je ne prête pas attention aux engins des humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020729,
					"content": "Elle pouvait pivoter, bondir dans les airs, et même tirer des boules de feu. Elle n'était pas de taille face à un dieu, mais elle était malgré tout plus puissante que nombre de possesseurs d'œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020714,
					"content": "Allez, ne te démoralise pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "Il est doué pour fuir, dis donc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}