			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "Vous... êtes pas bienvenu... ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Haha... Alors l'esprit misérable du loup s'amuse à élever des chiots à présent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020303,
					"content": "Et il prétend être un protecteur ? Ses griffes autrefois si acérées, se sont clairement émoussées depuis son ancienne gloire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020304,
					"content": "Rejoins-nous, et nous pourrons restaurer les pouvoirs qui étaient autrefois les tiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020305,
					"content": "Mensonges... Mensonges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 80020306,
					"content": "Mais qu'est-ce que c'est que ce rituel ? Il a l'air de tellement souffrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Oh non... Est-ce que c'est ça qu'ils ont fait pour corrompre l'esprit de Dvalin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "Les loups... se rendent jamais ! Mais... ça peut pas... continuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Je me charge d'arrêter ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Vous aurez beau nous résister, vos efforts seront vains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80020310,
					"content": "C'est parti pour le match retour contre l'Apôtre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Une immense statue, une cathédrale grandiose... Les Mondstadtois ont clairement dépensé beaucoup de ressources et d'énergie pour les édifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020402,
					"content": "Mais qu'a ressenti l'Archon Anémo en recevant ce cadeau, et qu'a-t-il donné en retour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020403,
					"content": "La foi ne demande rien en retour, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Hmm, tant que les dieux ont la conscience tranquille, je n'ai rien à ajouter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "Chut ! On va entrer dans la cathédrale. Il ne faut pas dire du mal de l'Archon Anémo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "Et en plus, l'Archon Anémo est... Ah, euh, rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Je n'ai jamais dit que j'entrerais dans la cathédrale. Je vous laisse vous débrouiller avec les sœurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Mais on a agi en équipe jusqu'ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "Vous êtes le chevalier honoraire de Mondstadt. Ils vous laisseront sûrement fouiner dans leurs affaires sans douter de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "M'avoir à vos côtés ne ferait qu'attiser leurs suspicions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "Parce qu'ils ne vous connaissent pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Exactement, et tout comme notre amie l'a dit... Je pourrais dire quelque chose de déplacé à tout moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "Lorsqu'un « hérétique » entre « en terre sainte », le résultat n'est jamais joli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Je n'ai jamais bénéficié des faveurs des dieux dans le passé, et je n'en aurai besoin ni maintenant ni dans le futur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "N'en parlons plus. L'Ordre de l'Abîme continue d'agir pendant que nous perdons du temps à discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Bon, {NICKNAME}, on va juste y aller {M#tous}{F#toutes} les deux et demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Je dois aussi vous avertir d'une chose. Ne parlez pas de cette « statue profanée » à l'intérieur de la cathédrale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "L'Église de Favonius ne pourrait ignorer cette affaire. Et si elle s'en mêle, les choses n'en seront que plus compliquées pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "Et puis... S'immiscer dans les affaires de l'Abîme se termine généralement plutôt mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "Vous pensez n'être pas le bienvenu auprès des sœurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Vous n'êtes pas un peu curieux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
