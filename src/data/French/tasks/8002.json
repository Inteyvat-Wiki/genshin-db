	"talks": [
		{
			"id": 800201,
			"completionStepIds": [
				800202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
						],
						"stepId": 800202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "Chevalier honoraire, comment allez-vous ? Avez-vous besoin de quelque chose aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020102,
					"content": "Euh... Je dois vous avertir par contre : si c'est encore pour emprunter Himmel, la lyre sacrée, vous perdez votre temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020103,
					"content": "(On dirait qu'elle n'a toujours pas remarqué que c'était juste une illusion...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020104,
					"content": "#On est {M#venus}{F#venues} se renseigner sur quelque chose. Barbara, avez-vous déjà entendu parler du « Laboureur originel » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020105,
					"content": "Hmm ? Qu'est-ce que c'est ? Un « Laboureur »... À quoi ça sert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020106,
					"content": "Bon, ça ne vous dit rien, sans surprise... Alors question suivante : l'Église a-t-elle déjà perdu une Statue des Sept ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020107,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020108,
					"content": "C'est cette vieille histoire qui vous intéresse ? Eh bien, je ne m'attendais pas à ça... Tout ça est arrivé il y a bien longtemps, et presque personne n'en parle de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020109,
					"content": "Il y a longtemps, une Statue des Sept a en effet disparu une nuit, sans qu'aucune trace ne soit laissée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020110,
					"content": "Presque tous les membres de l'Église se sont joints aux recherches, mais elle n'a jamais été retrouvée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020111,
					"content": "Dans les archives de l'Église, cet incident est appelé « La Statue perdue des Sept ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020112,
					"content": "Hmm... Évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020113,
					"content": "Évidemment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020114,
					"content": "Oh, non, rien ! Sinon, vous avez d'autres indices ? Euh, je veux dire... d'autres événements étranges dont vous vous rappelleriez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020115,
					"content": "(Désolée, Barbara, mais on ne peut pas vous parler de la statue qu'on a vue... Comme Dain l'a dit, c'est pour votre bien...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020116,
					"content": "D'autres événements étranges ? Je ne suis pas sûre... Voyons voir... Des incidents inhabituels dans les archives de l'Église... « La fureur finale du tyran » ? Non, ça ne date pas de ce moment-là, c'est probablement sans rapport...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020117,
					"content": "« La fureur finale du tyran » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020118,
					"content": "Oh, ceci fait référence à une période dangereuse de l'époque du vieux Mondstadt – l'endroit maintenant connu sous le nom d'« Antre de Stormterror ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020119,
					"content": "Il fut un temps, il y a bien des années, où des boules de feu pleuvaient du ciel chaque fois que quelqu'un s'approchait du vieux Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020120,
					"content": "Des boules de feu tombant du ciel ? Ça fait peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020121,
					"content": "Les gens de l'époque croyaient que c'était une malédiction du Dieu des tempêtes, et on a donné à ce phénomène le nom de « fureur finale du tyran ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020122,
					"content": "Cela a duré environ un an. Personne n'a jamais été capable de résoudre ce mystère. Ça a progressivement pris fin, sans explication.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020123,
					"content": "Très bizarre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "C'est vrai. Cette théorie a par la suite été considérée de moins en moins probable par l'Église. Après tout, pourquoi le Dieu des tempêtes utiliserait des boules de feu, n'est-ce pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020126,
					"content": "C'est sûrement autre chose qui en était la cause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020127,
					"content": "De toute façon, cette histoire n'est probablement pas liée à « la Statue perdue », mais aucun autre incident étrange ne me vient à l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020128,
					"content": "Eh bien, merci quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020129,
					"content": "Encore une fois ce mot inutile, « Merci » ? Je ne m'y ferai jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020130,
					"content": "Oh, Rosalia, c'est vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020131,
					"content": "Si vous cherchez les chevaliers de l'Ordre, ils sont à nouveau accaparés par ces monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020132,
					"content": "Quels monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020133,
					"content": "Ceux qui ont tenté d'attaquer Mondstadt la dernière fois, lors de l'incident avec Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020134,
					"content": "Mais... C'était l'Ordre de l'Abîme, non ? Ils recommencent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020135,
					"content": "En effet. Ils se rassemblent au <color=#00E1FFFF>Territoire des Loups</color>, provoquant une grande agitation parmi les bêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020136,
					"content": "Serait-il possible que... l'Ordre de l'Abîme vise l'esprit de Borée, le Loup du Nord ? Mais pour quelle raison, je l'ignore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020137,
					"content": "La Grande Maîtresse Jean est déjà partie pour le <color=#00E1FFFF>Territoire des Loups</color>. J'allais me mettre en route à mon tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020138,
					"content": "Alors... Je vous accompagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020139,
					"content": "La Grande Maîtresse a demandé que vous restiez à la cathédrale pour continuer votre travail avec le clergé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 80020140,
					"content": "Mais... Vous êtes membre du clergé, vous aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020141,
					"content": "Ne vous inquiétez pas ! Je vais lui prêter main forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "Oui, on va aller donner un coup de main à Jean !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020143,
					"content": "Hum... Soit. Tant que le chevalier honoraire s'en charge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020144,
					"content": "#Mais soyez {M#prudents}{F#prudentes}. Et que l'Archon Anémo vous protège !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020124,
					"content": "Ce n'est pas forcément lié au tyran...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "Eh bien... Ça fait quand même un sacré paquet d'ennemis dans le coin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020202,
					"content": "Les ennemis augmentent à mesure que nous nous rapprochons de notre objectif. Hum, voilà qui ressemble bien à l'Ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020203,
					"content": "On doit se dépêcher de trouver Borée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "Oui ! Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020205,
					"content": "Je... n'irai pas plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020206,
					"content": "Hein ? Pourquoi ça ? Vous avez peur des bêtes poilues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020207,
					"content": "À mon avis, c'est autre chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "Cela n'a rien à voir avec les loups. C'est parce que Borée était un ancien dieu, devenu volontairement un serviteur des Sept Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020210,
					"content": "Je ne peux pas accepter ses actions, et je ne souhaite n'avoir rien à faire avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020211,
					"content": "Et puis, vous êtes plutôt populaires auprès des gens. Moi, je suis... moins sympathique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020212,
					"content": "Vous détestez vraiment les Sept Archons, dites donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "Les dieux n'ont rien de spécial, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020216,
					"content": "Ce n'est que mon avis, mais un conseil : soyez toujours sur vos gardes lorsque vous côtoyez les dieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020217,
					"content": "Ne leur faites pas trop confiance, mais n'allez pas pour autant essayer de les renverser ou de les traquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020218,
					"content": "Même si le dieu en question est votre ennemi juré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020219,
					"content": "Ne pas leur faire confiance, ne pas les traquer... C'est du conseil un peu bizarre quand même. Dain déteste les Sept Archons, ou il essaye de les protéger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020220,
					"content": "Pourquoi votre opinion est-elle si contradictoire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020222,
					"content": "Je ne veux pas répéter les erreurs de mes ancêtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020223,
					"content": "Je... vais vous confier une dernière chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020224,
					"content": "Hein ? Quoi donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020225,
					"content": "La destruction de la nation de Khaenri'ah par les dieux... est la raison pour laquelle l'Ordre de l'Abîme désire détruire les nations protégées par les Sept Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020226,
					"content": "Enfin, assez parlé, retournons à nos affaires. Je vais m'occuper des autres membres de l'Ordre de l'Abîme dans la région. Essayez de ne pas trop faire durer votre visite à Borée, et retrouvons-nous ensuite à l'entrée du Territoire des Loups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020227,
					"content": "Et... Il s'en va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020228,
					"content": "Quel type étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020229,
					"content": "Je pense que je comprends plus ou moins ce qu'il voulait dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "Oui, c'est vrai, mieux vaut ne pas baisser sa garde face à des dieux inconnus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020231,
					"content": "Tu te rappelles le rituel de la descente à Liyue ? Tu as agi comme Dain l'aurait fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020232,
					"content": "Quand la confiance n'est pas là, mieux vaut éviter la situation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "*soupir* ... Ce n'est pas facile, tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020234,
					"content": "Chevalier honoraire ! Paimon ! Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020235,
					"content": "Oh, Grande Maîtresse Jean ! On vous a trouvée, génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020236,
					"content": "#Rosalia nous a {M#informés}{F#informées} que vous étiez ici pour combattre, alors on vient donner un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020237,
					"content": "Votre aide est grandement appréciée. Il y a quelque chose d'étrange dans cette offensive soudaine de la part de l'Ordre de l'Abîme... Ils sont en train d'encercler le Territoire des Loups. Je me prépare à envoyer des forces en riposte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020238,
					"content": "Je reviens juste d'un repérage à travers la zone... Je ne m'attendais pas à vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020239,
					"content": "D'après Rosalia, leur cible pourrait être Borée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020240,
					"content": "C'est étrange... L'Ordre de l'Abîme et Borée... Quel lien peut bien les unir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020241,
					"content": "Ils aiment simplement mettre la pagaille ! Pourquoi auraient-ils besoin d'une raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020242,
					"content": "L'Ordre de l'Abîme s'en est déjà pris à Dvalin. Donc, ce n'est pas vraiment surprenant qu'il s'attaque à un autre des copains de l'Archon Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020243,
					"content": "Hmm... C'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020244,
					"content": "Quelle que soit la raison derrière cette menace, je compte bien m'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020245,
					"content": "Chevalier honoraire, pourrais-tu aller voir si Borée est en danger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020246,
					"content": "L'esprit de ce dieu... ne voit pas souvent des hommes. Mais j'ai entendu dire que tu l'avais déjà rencontré. Mieux vaut sans doute dans ce cas que ce soit toi qui ailles à sa rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020247,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "Bien, et fais attention. Merci pour ton aide, chevalier honoraire de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020214,
					"content": "Vous n'êtes pas du genre sociable, dites donc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "Je n'ai aucun problème quand il s'agit d'interagir avec des gens. Mais pour tout ce qui concerne les dieux... C'est une autre histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020208,
					"content": "Plus c'est poilu, plus c'est mignon, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
