			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "Je vois... Est-ce que l'Ordre de l'Abîme aurait déjà lancé une nouvelle action ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020502,
					"content": "Cela pourrait avoir quelque chose à voir avec cette « statue profanée ». Nous devrions également y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020503,
					"content": "Mais qu'est-ce que l'Ordre de l'Abîme veut faire au Territoire des Loups à la fin ? Est-ce qu'ils veulent recommencer la même chose qu'avec Dvalin ? Aaaah... Pas encore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020504,
					"content": "Non, ce n'est probablement pas ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020505,
					"content": "Contrairement à Ortell, qui a été juste... repoussé, Andros est mort il y a longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020506,
					"content": "Aujourd'hui, seul son esprit monte la garde dans le Territoire des Loups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020507,
					"content": "L'Apôtre de l'Abîme vise peut-être simplement son esprit, pour obtenir des informations de l'un des plus anciens compagnons de l'Archon Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
