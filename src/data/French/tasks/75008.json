				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Manqu, nous revoilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Hmm, je ne vais pas vous mentir, l'attente a été longue. Plus j'attendais, plus j'étais anxieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "C'était mon idée au départ, c'est vrai... Mais si vous n'aviez pas pu revenir des ruines, je n'aurais vraiment pas eu la conscience tranquille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "Cependant, pardonnez-moi d'être aussi direct, mais... Vous avez dû trouver le jeton que le Sage de la flamme dérobée a laissé dans les ruines, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "C'était compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "J'étais sûr que vous y arriveriez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Regardez, c'est ce disque !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "Non, impossible... Une supplication dorée ? Ça veut dire que les supplications dorées des légendes sont bien réelles ?! Incroyable ! Je dois inclure ça dans mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "Ce truc s'appelle une supplication dorée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "Exactement ! Pardonnez mon enthousiasme, mais je suis tellement ému ! On dit que cet objet appartenait au Sage de la flamme dérobée en personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "L'espace d'un instant, j'ai pensé à le garder pour moi, comme un trésor de famille ou quelque chose comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#Ah non alors, on en a besoin pour sauver {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Je sais... Enfin, je ne connaissais que l'indice concernant ce jeton, quant à savoir où se trouve l'autre, je n'en ai aucune idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Hein ? Pardonnez-moi, {NICKNAME}... Mais vous venez de dire Ochkanatlan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "(Décrire ce que vous avez vu en touchant la stèle...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Qui aurait cru que ce serait à Ochkanatlan... Les ruines d'une ancienne cité située sur une étroite étendue d'eau, au nord du Clan des fleurplumes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "Si c'est vraiment là-bas que ça se trouve, je suis désolé, mais je ne vais pas pouvoir vous aider. C'est non seulement une zone interdite pour les membres de ma tribu, mais aussi pour ceux de l'Association des reliques sauriennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "Apparemment, il y a plusieurs années, des membres de l'Association ont été chargés d'enquêter sur cet endroit. Résultat, on n'a plus jamais entendu parler d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "Depuis, l'association ne s'occupe plus de tout ce qui a un rapport avec Ochkanatlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "Ce n'est rien, tout ce que vous venez de dire nous suffit déjà amplement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Bien, je tiens à vous remercier à nouveau. Vous n'avez pas idée de ce que cela représente pour moi d'avoir pu voir une supplication dorée. Il faut que je rentre au plus vite pour tout consigner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#Merci encore, {NICKNAME} et Paimon. Je souhaite que la suite de votre voyage se déroule sans encombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#Quant à toi {REALNAME[ID(2)|SHOWHOST(true)]}, je te souhaite de te débarrasser de la marque de la bénédiction du seigneur des flammes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "Au revoir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Oui... À la fin du voyage, là où toutes les âmes se reposent, nous nous retrouverons, j'en suis sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "C'était un jeu d'enfant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
