			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Melo Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "Madame Melo ! Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Euh ? C'est vous... J'ai entendu dire que mon incompétent de mari avait un petit repaire ici, alors je suis venue voir comment il s'en sortait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810103,
					"content": "Je ne m'attendais pas à trouver ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810104,
					"content": "Il a même gardé cette photo avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810105,
					"content": "Héhé, monsieur Rocher a l'air de toujours s'inquiéter pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "Lorsque nous avions des doutes sur vous, seul monsieur Rocher défendait avec fermeté que vous ne pouviez pas être coupable ! Bien que nous ne sachions pas d'où venait cette certitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "C'est peut-être sa dernière once de virilité qui le rendait si convaincant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Oh, vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810109,
					"content": "C'est vrai ! Et vous savez quoi, il a prétendu avoir perdu votre bijou lors d'une partie de jeu. En réalité, il mentait ! Il était simplement gêné de dire la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Eh bien, je le savais depuis longtemps. Je n'ai jamais cru à cette histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810111,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "Mon mari a beaucoup de défauts : il est un peu peureux, un peu lâche, et parfois un peu naïf, mais je sais que c'est une personne honnête. Peut-être qu'il avait été dupé par quelqu'un, mais je sais que ce n'est pas un joueur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810113,
					"content": "Je n'ai rien dit, parce que j'attendais qu'il me le dise de lui-même, en toute franchise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810114,
					"content": "Ouah... C'est dommage qu'il soit parti sans laisser de trace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Chut... Regardez là-bas, je suis sûre qu'il se cache dans ce coffre.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810116,
					"content": "(... Hein ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(*tousse* ... Lorsque nous nous disputons, il avait l'habitude de se cacher discrètement dans l'armoire. Il pense que je ne le sais pas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Vous voulez qu'on le fasse sortir ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Pas besoin. Aujourd'hui, je vais voir combien de temps il pourra se cacher.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810120,
					"content": "Ah, au fait, j'ai une autre chose à vous demander : si vous rencontrez les agents Courbe et Talochard, pourriez-vous leur transmettre un message de ma part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810121,
					"content": "J'ai préparé quelques chambres, ils sont les bienvenus à tout moment. Bien sûr, la famille Lombroso vous accueille également.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "Très bien. C'est noté, madame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Hmm... Très bien, nous ne vous dérangerons plus ! Espérons que monsieur Rocher osera bientôt se voir en face !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Merci, je vous souhaite de trouver les réponses à tous les problèmes que vous pourrez rencontrer à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Melo Lombroso"
				}
			]
		},
