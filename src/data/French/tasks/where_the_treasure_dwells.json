			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "Laisse-moi voir ! Hmm... On dirait une sorte de carte au trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "Hé ! Je ne me trompe jamais quand il s'agit de trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200116,
					"content": "Hum, on dirait que c'est « Ako Domeki et sa bande de pirates » qui ont laissé ça. J'ai l'impression d'avoir déjà entendu ce nom quelque part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200104,
					"content": "#Et puis regarde ça ! « Le secret indiquant l'emplacement du trésor... ». Tu vois{NON_BREAK_SPACE}? Il y a un trésor à trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200105,
					"content": "Continuons à lire... « Il a été divisé en quatre parties... ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200106,
					"content": "Hein ? Ils ont divisé quelque chose en quatre parties ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200107,
					"content": "Alors il y a quatre trésors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Je n'en sais rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200110,
					"content": "Mais quoi qu'il en soit, il est dit ici que les parties ont été « placées sur les récifs des quatre grandes îles ». Ça devrait faire référence aux récifs des quatre îles de l'Archipel de la pomme dorée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200111,
					"content": "Attends, on ne serait pas à un de ces récifs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200112,
					"content": "Hmm, ça veut dire qu'il doit y avoir quatre indices...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "Et ils devraient être proches des récifs des quatre îles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200114,
					"content": "#Hmm, ça doit faire référence aux quatre plus grandes îles de l'archipel, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200115,
					"content": "Allons voir ce qu'on pourra trouver sur les trois autres îles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200108,
					"content": "Alors il y a quatre indices ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
