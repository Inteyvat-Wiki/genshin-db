			"dialogs": [
				{
					"id": 790200101,
					"content": "Laisse-moi voir ! Hmm... On dirait une sorte de carte au trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "Vraiment ?",
