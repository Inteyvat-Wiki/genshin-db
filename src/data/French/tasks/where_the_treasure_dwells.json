				{
					"id": 790200601,
					"content": "C'est ça le trésor qu'Ako Domeki et son équipage ont laissé ? Mais comment ont-il fait pour le cacher ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200602
