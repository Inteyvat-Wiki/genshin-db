				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "Cela étant... Je ne peux pas m'empêcher de penser que vous êtes plus adaptées aux recherches que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030402,
					"content": "#Vous avez une sacrée expérience d'{M#aventurier}{F#aventurière}, et êtes quelqu'un d'extrêmement capable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030403,
					"content": "Mais plus important encore : vous avez beau ne pas posséder d'œil divin, vous êtes capables d'opérer les éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030404,
					"content": "Les éléments... Quel chercheur peut passer outre ce terme ? Pouvoir voir les éléments est un atout majeur pour tout chercheur qui se respecte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030405,
					"content": "Ah, mais je m'égare à nouveau... Mes excuses. Je ne veux pas vous importuner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Édith"
				}
			]
		},
		{
			"id": 2070305,
			"completionStepIds": [
				2070303
			],
