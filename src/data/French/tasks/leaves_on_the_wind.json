					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030303,
					"content": "Vous arrivez à repérer l'élément Anémo, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030304,
					"content": "Mon idée est la suivante : suivez les traces d'élément Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030305,
					"content": "Je vous attends au pied de l'arbre. Si vous trouvez quelque chose d'intéressant, redescendez me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Édith"
				}
			]
