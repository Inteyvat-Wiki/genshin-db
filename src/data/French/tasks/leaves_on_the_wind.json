			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dr. Édith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "... Non, ça ne fera pas l'affaire non plus. Quel dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030102,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "J'aimerais écrire un ouvrage ayant pour sujet le vent, portant sur l'histoire de Mondstadt. Je cherche l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030104,
					"content": "Ce lieu rassemble la Statue des Septs, qui est liée aux vents, ainsi que cet arbre, qui a connu Vennessa. Difficile de trouver un meilleur endroit pour s'inspirer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030105,
					"content": "Mais, ça va paraître risible... Je n'ai pas d'œil divin ; difficile dans ces conditions de faire des recherches fructueuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030106,
					"content": "Quand je dis que je cherche l'inspiration... Je suis juste là à ne rien faire. Tout ce que j'ai pour l'instant, c'est juste quelques informations guère utiles tirées de bouquins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030107,
					"content": "C'est comme ça par ici : ceux qui n'ont pas d'œil divin doivent faire deux fois plus d'efforts, pour deux fois moins de résultats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030108,
					"content": "Sans œil divin, impossible d'utiliser la force des éléments... Que ce soit pour les recherches ou dans la vie de tous les jours, on a un peu l'impression d'être mis à l'écart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030109,
					"content": "Hahaha, peut-être qu'aux yeux des Archons, les possesseurs d'un œil divin occupent les rôles principaux sur la scène qu'est le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030110,
					"content": "Ah, mes excuses, je parle trop. J'ai beau me plaindre, je ne compte pas abandonner mes recherches pour autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030111,
					"content": "Je n'ai peut-être pas d'œil divin, mais je ne peux pas me permettre de prendre du retard dans mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030112,
					"content": "Et puis, il paraît que vous êtes capable de voir les éléments sans l'aide d'un œil divin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030113,
					"content": "Si vous arriviez à trouver un objet riche en élément Anémo, je suis sûre que ça m'aiderait grandement dans mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030114,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous m'aideriez à jeter un œil au sommet de cet arbre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Édith"
				}
			]
		},
