					"Dr. Édith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "Alors, qu'avez-vous découvert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030502,
					"content": "J'ai trouvé ces feuilles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "... Des feuilles ? Montrez-les-moi. Vous les avez mises dans cette boîte...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030504,
					"content": "C'est vrai qu'on sent l'élément Anémo présent lorsqu'on prend ces feuilles en main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030505,
					"content": "Cet arbre possède donc cette force étonnante... Si seulement j'avais un œil divin, je ne perdrais pas autant de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030506,
					"content": "Merci. Voilà des matériaux de valeur, qui me seront utiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030507,
					"content": "Pourtant, je n'ai aucune méthode pour conserver ces feuilles. Et il se pourrait que l'élément Anémo qu'elles contiennent se dissipe rapidement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dr. Édith"
				},
				{
					"id": 207030508,
					"content": "Tenez, prenez ceci en remerciement. Peut-être que j'aurai encore besoin de votre aide plus tard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Édith"
				}
			]
		}
	]
