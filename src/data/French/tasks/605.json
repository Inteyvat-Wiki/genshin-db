			"dialogs": [
				{
					"id": 6050201,
					"content": "Vous avez défendu cet endroit à merveille, tous les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "On prend la relève.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Capitaine Kaeya, Swann est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "Je vais bien, moi ! Tu devrais plutôt te soucier de ta jambe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 6050205,
					"content": "Swann et Lawrence, vous devriez aller vous faire soigner à la Cathédrale. N'en faites pas trop. On s'occupe du reste ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "Mais maître Diluc... Vous ne faites plus partie de l'Ordre de Favonius, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 6050207,
					"content": "Et ? Les chevaliers de l'Ordre de Favonius sont-ils les seuls capables de défendre cette porte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "Ça ira. Maître Diluc est... un bon samaritain. Si un civil veut nous aider, on ne va pas l'en empêcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "... Très bien. Désolé, et merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swann"
				},
				{
					"id": 6050210,
					"content": "Merci beaucoup à vous deux. On reviendra dès qu'on peut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "J'ai un peu de temps libre maintenant, alors je voudrais faire quelques potions pour aider nos effectifs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051105,
					"content": "C'est une excellente initiative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "En tout cas, reste prudente. Je pense que cela n'arrivera pas, mais si tu es dans une situation que tu ne peux pas gérer seule, bats en retraite et va en lieu sûr. Ne te préoccupe pas du front.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
