			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101011001,
					"content": "#Oh ? Tu es de retour. Je me suis occupée de la paperasse, te voilà {M#gardien}{F#gardienne} des livres de la bibliothèque de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011002
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011002,
					"content": "Merci, Lisa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011003,
					"content": "... Je crois qu'on a oublié quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011004,
					"content": "Le Guide de voyage en Teyvat !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "Ah ! Regarde sur cette étagère, ce ne serait pas le <color=#00E1FFFF>Guide de voyage en Teyvat</color> dessus par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011008,
					"content": "Et on ne peut pas dire qu'on manque d'exemplaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011009,
					"content": "Héhéhé. Le <color=#00E1FFFF>Guide de voyage en Teyvat</color> est un ouvrage périodique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011010,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011011,
					"content": "Allez-y, prenez-en un. C'est pour vous remercier de m'avoir aidée aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011012,
					"content": "Vous avez rendu mon travail moins ennuyeux pour une fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011013,
					"content": "Je vois, ce Guide de voyage en Teyvat n'était qu'un prétexte pour qu'on fasse votre travail à votre place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011014,
					"content": "Oh, mais je ne pouvais pas savoir que ça nous mènerait aussi loin de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011015,
					"content": "Prenez donc aussi ces souvenirs en cadeau pour la peine que vous vous êtes donnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011016,
					"content": "Waouh, vous avez acheté ça rien que pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011017,
					"content": "Je les réservais pour notre prochaine promenade ensemble, mais tant pis. On en parlera plus tard ! J'espère que vous avez hâte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011018,
					"content": "*bâille* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011005,
					"content": "Notre rémunération !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011006
					]
				},
				{
					"id": 101011006,
					"content": "Tu es bien cupide, ma foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011007
					],
					"speakerTitle": "Lisa"
				}
			]
		},
