				"points": []
			},
			"dialogs": [
				{
					"id": 101011201,
					"content": "Comment avez-vous fait pour me trouver ? Nous sommes si bien cachés pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011202
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011202,
					"content": "Vous pouvez vous cacher où vous voulez, je m'en fiche royalement. Rendez-moi juste le livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011203,
					"content": "C'est étrange quand même... Vous trouvez le temps pour créer un sceau de protection, mais pas pour rendre un simple livre à la bibliothèque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011204,
					"content": "Les gens comme vous n'ont aucun respect pour le travail d'autrui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011205,
					"content": "Vous êtes donc venue ici pour le <color=#00E1FFFF>livre</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011206
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011206,
					"content": "Il y a donc quelqu'un à Mondstadt qui s'intéresse aux secrets qui y sont enfouis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011207,
					"content": "Q—Qui êtes-vous au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011208
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011208,
					"content": "Une bibliothécaire. C'est évident, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011209,
					"content": "Rendez-moi le livre. C'est mon dernier avertissement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011210,
					"content": "Hmph, vous me cachez votre vraie identité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011211
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011211,
					"content": "Ça ne me donne pas envie de vous le rendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011212,
					"content": "Après tout, ce livre renferme le secret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011213,
					"content": "Qu'est-ce que vous faites ?! Un tel pouvoir élémentaire... Ne me dites pas que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011214,
					"content": "AAAAAHHHHHH !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "Mage de l'Abîme"
				},
				{
					"id": 101011215,
					"content": "Ouh, elle n'y est pas allée de main morte !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "Hmph. Voilà une petite punition pour un vilain garçon pas sage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011218,
					"content": "Vous ne l'avez même pas laissé finir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "*soupir* Maintenant, vous savez pourquoi mon travail est si difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011221,
					"content": "Le livre devrait être dans le coin, cherchons-le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011219,
					"content": "Pardon ? Une « petite » punition ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011216,
					"content": "Maman, j'ai peur !!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				}
			]
