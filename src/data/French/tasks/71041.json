				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "Le mécanisme de verrouillage n'a pas encore rouillé. Il y a des traces de lubrifiant, comme si quelqu'un l'avait entretenu après la fermeture de la mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "La culasse est également intacte... Seule la sécurité est restée verrouillée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "Qu'est-ce qu'il raconte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "Les tunnels devant nous ont été scellés avec de gros rochers quand les mineurs ont été évacués... On dirait que c'est là qu'on va devoir utiliser le canon à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "Mais sans munition, un canon, quelle que soit sa taille, est inutile. Il faut en trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "Hmpf, pas la peine de le rappeler, monsieur Je-sais-tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "Il y a un dépôt à côté qui devrait contenir des munitions pour le canon. Avec de la chance, tout n'a pas été récupéré quand les mineurs ont été renvoyés chez eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "Allons dans cette direction, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
