			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "Pfiou ! Merci. Vous m'avez sauvé la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410102,
					"content": "Attendez... Je vous reconnais ! Vous êtes ce Toclipho qu'on a vu dans la mine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410103,
					"content": "Euh, quoi ? Non ! Ce n'est pas... Je... Je ne vends pas de faux médicaments ! Je suis Clitopho, oui, mais pas celui qui est dans le commerce de produits pharmaceutiques. Ah non, ça pas question !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410104,
					"content": "Hein. Donc les médicaments que vous vendiez étaient faux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "Quoi ? Non ! Impossible ! Les médicaments que je vends sont cent pour cent authentiques ! Je veux dire, vous avez vu l'effet sur les mineurs ! Ils en ont bu et ils se sont sentis beaucoup mieux d'un coup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410106,
					"content": "Mais ne venez-vous pas de dire que vous n'étiez pas dans le commerce de produits pharmaceutiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410107,
					"content": "Ah, euh... C'est vrai, c'est là que j'ai arrêté de vendre des médicaments. Tout s'est terminé quand ce... Quand ce Toclipho a vendu des contrefaçons sous une fausse identité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410108,
					"content": "Il a vendu de faux médicaments sous un faux nom et a ruiné ma réputation ! C'est ça. C'est pour cette raison que j'ai renoncé à vendre des médicaments pour toujours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410109,
					"content": "Et juste au moment où j'allais changer de carrière, j'ai été capturé par cette bande de Pilleurs de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410110,
					"content": "Ce charlatan est vraiment méprisable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410111,
					"content": "Oui, il faut être sacrément tordu pour vouloir jouer de tels tours à ceux qui sont dans le même métier que vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410112,
					"content": "#C'était quoi déjà le faux nom de ce «{NON_BREAK_SPACE}Toclipho{NON_BREAK_SPACE}»{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "Clitopho !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410114,
					"content": "Euh. Non, attendez. Clitopho n'est pas un faux nom. C'est un vrai nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410115,
					"content": "Est-ce que ça ne fait pas de « Toclipho » un faux nom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410116,
					"content": "Non... Attendez, oui. Oui. Il a pris mon nom, donc maintenant « Clitopho » est un faux nom. C'est clair, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410117,
					"content": "Oh... Donc « Toclipho » est devenu un vrai nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410118,
					"content": "Comme c'est dommage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "Qu'est-ce qui est dommage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410120,
					"content": "Vous avez presque tout avoué sans qu'on ait à vous le demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410121,
					"content": "Emmenons-le. Les Millelithes auront certainement des questions à lui poser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410122,
					"content": "Ou alors on peut s'occuper de lui ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410124,
					"content": "Hé ! Ce n'est pas le moment de faire ce genre de blagues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410125,
					"content": "Héhé, hihi. Moi, je trouve ça drôle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410126,
					"content": "Mais vous ne riez pas. Et non, ce n'est pas drôle du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410127,
					"content": "Vous avez raison. On va passer aux choses sérieuses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "A—Attends ! On n'a pas le temps pour un interrogatoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410129,
					"content": "Je ne sais pas pour toi, mais convoyer un Pilleur de trésors en panique ne m'enchante pas plus que ça. Ramenons-le d'abord au camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410131,
					"content": "Hé, hé, hé ! Emmenez-moi avec vous, vous voulez bien ? Je vous serai utile ! Je veux dire, comme vous pouvez le voir... J'ai été chassé des Pilleurs de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410132,
					"content": "Je suis à nouveau un citoyen modèle, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410133,
					"content": "Oh, alors c'est comme ça que vous voyez le « citoyen modèle », vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410134,
					"content": "Et quelles sont vos compétences exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410135,
					"content": "Je peux... fabriquer des explosifs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410136,
					"content": "Vous voulez dire des faux médicaments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410137,
					"content": "Non, non. Il a dit des explosifs !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "Et vos explosifs ne sont pas faux non plus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410139,
					"content": "Non, c'est pour de vrai cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410140,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410141,
					"content": "... Je n'ai pas la permission de vous intégrer dans l'équipe. Ça sera à Jinwu de décider ce que l'on fera de vous, mais mon petit doigt me dit qu'elle laissera les Millelithes se charger de votre cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410142,
					"content": "On va garder un œil sur vous. Aucun Pilleur de trésors n'est digne de confiance, encore moins ceux qui vendent de faux remèdes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410143,
					"content": "Oh allez, j'ai arrêté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410144,
					"content": "Oh, ça, on sait ! On y va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410130,
					"content": "On ne peut pas vous donner tort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
