				{
					"id": 710410401,
					"content": "C'est là. *tousse* Argh, la porte est verrouillée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410402,
					"content": "On dirait qu'on va devoir utiliser deux clés à la fois pour ouvrir la porte... Oh, pourquoi faut-il que les gens de Liyue rendent les choses si compliquées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410403,
					"content": "Oh, arrêtez avec vos bavardages inutiles... Vous voyez cet avis collé sur la porte ? Au moins, ça veut dire qu'on pourra trouver des munitions à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410404,
					"content": "Eh bien, c'est une chose de trouver des munitions, mais encore faut-il que les détonateurs aient été bien conservés. On ferait mieux de ne pas se faire trop d'illusions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410405,
					"content": "Oh, super. On a un optimiste parmi nous. Arrêtez avec votre discours de lâcheur, vous voulez bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410406,
					"content": "... D'ailleurs, pourquoi on devrait écouter les objections d'un Pilleur de trésors après tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410407,
					"content": "Clitopho n'a pas tort, cependant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "Exactement ! Arrêtez de vous disputer tous les deux, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410410,
					"content": "Hmpf, d'accord. Continuons. Peut-être que Jinwu sait comment ouvrir cette porte.",
