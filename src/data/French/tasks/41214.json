				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "On est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140102,
					"content": "Vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140103,
					"content": "Ça devient une habitude de vous voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140104,
					"content": "J'ai terminé ce que vous m'aviez demandé de faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "Merci infiniment. Je savais que je pouvais compter sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140107,
					"content": "Vous comptez vraiment sur moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "Bien évidemment. Sans vous, mes recherches ne seraient allées nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140109,
					"content": "Héhé, heureuse de vous l'entendre dire ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140110,
					"content": "Je n'oublierai jamais ce que vous avez fait pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140111,
					"content": "Vous pouvez maintenant reprendre cette épée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "Elle est suffisamment puissante désormais, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140113,
					"content": "En quelque sorte. Comment vous sentez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140114,
					"content": "Comme d'habitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "#C'est rassurant. Vous ne manifestez pas d'effets secondaires et vous ne semblez pas non plus {M#empoisonné ou possédé}{F#empoisonnée ou possédée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140116,
					"content": "On dirait que j'avais raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140117,
					"content": "Ça va vos chevilles ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140118,
					"content": "L'épée était-elle agréable à manier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140119,
					"content": "Oui, plutôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "Je vois. Quoi qu'il en soit, nous avons réussi à la faire évoluer comme nous le souhaitions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140122,
					"content": "Pourquoi vous la prenez, Albedo ? Vous voulez faire quelque chose avec ? Soyez prudent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140123,
					"content": "Je souhaite extraire sa force vitale qui est désormais purifiée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140124,
					"content": "Peut-elle exister sans l'épée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140125,
					"content": "Je peux accomplir ce que d'autres sont incapables de faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140126,
					"content": "Et voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140127,
					"content": "Waouh, ça ressemble à une boule de lumière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140128,
					"content": "Ah ! Vous l'avez mise en bouteille ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140129,
					"content": "Cette épée n'est guère une arme divine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140130,
					"content": "Mais elle fait un parfait souvenir de notre aventure. J'espère qu'elle vous sera tout de même utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140131,
					"content": "Je peux l'avoir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "Elle était indispensable pour mon expérience. J'en ai obtenu les résultats que je voulais, alors je vous en fais don. Au moins, vous saurez vous en servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140134,
					"content": "#Merci encore pour votre aide précieuse. Au revoir, {M#cher voyageur}{F#chère voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140135,
					"content": "La force vitale du dragon résonne en moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140136,
					"content": "Cela n'a rien à voir avec lui, mais tout avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140137,
					"content": "Rhinedottir... Professeur... Durin est-il l'une de vos créations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140139,
					"content": "Notre rencontre était-elle de bon augure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140132,
					"content": "Vous n'en avez plus besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "Non, pas vraiment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "J'ai fait ce que vous vouliez, comme promis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}