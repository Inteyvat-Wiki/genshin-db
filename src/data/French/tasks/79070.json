			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saborn",
					"Souffache",
					"Cimest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Votre Excellence. Je vous souhaite la bienvenue au nom du Royaume des brises et cloches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700102,
					"content": "Qu'allez-vous faire maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Tout d'abord, je vais annoncer à tout le royaume que la relique a pris sa décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700104,
					"content": "Et concernant le héros choisi... Je leur dirai que c'est monsieur Faurobert, le candidat venu de loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700105,
					"content": "Oh ?! Pourquoi feriez-vous ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Essayer d'expliquer tout ce que nous avons vécu serait trop compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700107,
					"content": "De plus, il leur faudrait beaucoup de temps pour comprendre le concept selon lequel je suis à la fois la princesse et la gardienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700108,
					"content": "Le moment venu, je ferai un rapport détaillé de tout ce qui s'est passé, puis j'en informerai mon peuple par écrit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700109,
					"content": "Mais d'ici là, je dirigerai toujours toutes les affaires du royaume en tant que princesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700110,
					"content": "Dès que ces terrains d'épreuve seront officiellement transformés en lieux de formation, je prendrai la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700111,
					"content": "Prendre la route ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Votre Altesse, vous souvenez-vous pour qui la relique s'est réellement illuminée dans la grotte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "Hum ? Pour qui... elle s'est réellement illuminée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700115,
					"content": "Oui, puisque nous étions tous les deux à proximité quand c'est arrivé. Bien sûr, Votre Altesse mérite évidemment d'être reconnue, mais moi, en revanche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "Vous êtes un champion approuvé par une championne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Exactement, et cette championne est venue spécifiquement pour demander votre aide ! Comment pouvez-vous encore penser que vous n'en êtes pas digne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "C'est peut-être simplement parce que Son Altesse est tellement étincelante que tout le monde s'est trompé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Pfft... Dans ce cas, monsieur le champion, seriez-vous prêt à passer une autre épreuve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700120,
					"content": "Cette relique et moi, la princesse Cimest du Royaume des brises et cloches, serons personnellement témoins de vos exploits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700121,
					"content": "Bien sûr que oui, comptez sur moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "Calmez-vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Il s'emballe à chaque fois qu'il entend le nom de la princesse. Héhé, Faurobert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Ne vous méprenez pas ! Je fais ça pour accomplir la mission de la Mare de chanpluie ! Tout cet entraînement que je me suis imposé n'avait pour but que de sauver... Euh, je veux dire, de protéger Son Altesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "C'est une tâche tellement importante, je dois donc m'assurer que tout se passe sans accroc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "Seriez-vous prêt à voyager avec Son Altesse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "B—Bien sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Héhé, tant mieux. Alors, monsieur le champion Faurobert, êtes-vous prêt pour mon épreuve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700130,
					"content": "Oui, Votre Altesse ! C'est quand vous voulez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "Waouh ! La relique s'est à nouveau illuminée, et elle brille encore plus cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Ça fait mal aux oreilles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "Qu'est-ce que vous préparez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Faurobert",
					"Horellou",
					"Estampe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampe ! Où étais-tu passé ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Je me baladais dans les environs et j'ai essayé cette épreuve. C'était amusant, mais j'ai dû adopter une approche légèrement différente pour réussir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "Horellou m'a tout raconté. Pas mal, monsieur le gardien. Il faut croire que tu es doué en fin de compte, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "T—Toi... Si tu avais été à côté de moi, je t'aurais poussé, tu peux en être sûr ! Je t'aurais même poussé dix fois si j'avais pu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "C'est pourquoi j'ai plutôt décidé de participer à l'épreuve. Faurobert, mon ami, j'ai toujours su que tu allais réussir. Et regarde... Tu l'as fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Haha, vous êtes de bons gars, tous les deux. Aujourd'hui est un jour heureux pour notre mare !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Nous avons enfin un véritable champion. Même si Faurobert n'a pas encore sauvé de princesse, je pense que sa chance viendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "*soupir* Mais je n'ai vraiment rien fait, monsieur Horellou. Je suis resté là à regarder Son Altesse faire tout le travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "C'est encore mieux, non ? Vous ne vouliez sûrement pas que la princesse soit en danger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "Je... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Ça suffit, monsieur Faurobert. C'est Cibrelus lui-même qui vous a confié la mission !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "Mouais ! Je ne sais même pas si c'était vraiment Cibrelus ! Après tout, j'ai entendu parler de lui, c'est vrai, mais je ne l'ai jamais entendu parler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "Et tu as même accepté l'épreuve de la princesse. S'il y a un champion, c'est bien vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "Pourrions-nous... ne pas parler de ça pour l'instant ? S'il te plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "Enfin, pour résumer, l'avenir de la Mare de chanpluie est entre vos mains compétentes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Désormais, nous pouvons sauter juste pour le plaisir ! À mon retour, je proposerai au comité que l'accent soit dorénavant mis sur le côté amusant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "C'est une très bonne idée que je soutiendrai volontiers. D'ailleurs, rentrons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "Hé, ne me laissez pas ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cimest",
					"Saborn",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Votre Altesse a été reconnue comme gardienne ? Et cette grenouille-gami aussi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "Incroyable, inouï ! C'est du jamais vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "Vous devrez également apporter des modifications à l'épreuve... Non, ne faites pas ça, Votre Altesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "Vous ne pouvez pas modifier une tradition aussi ancienne sur un coup de tête, Votre Altesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Très bien, très bien, baissez d'un ton. Vous commencez à me casser les oreilles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700306,
					"content": "Tout a déjà été décidé. Maintenant que je suis à la fois une princesse et une gardienne reconnue par la relique, vous avez encore moins de chances de m'arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700307,
					"content": "Mais, Votre Altesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "Détendez-vous. J'organiserai une cérémonie pour former des groupes d'écureuils volants fiables pour défendre le royaume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700309,
					"content": "Ce n'est qu'après ça que je quitterai le royaume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700310,
					"content": "Votre Altesse, nous... *soupir* Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Ne vous inquiétez pas, je suis capable de prendre soin de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700312,
					"content": "En tant que princesse, je dois affronter seule les vents violents du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700313,
					"content": "... À vos ordres, Altesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saborn"
				}
			]
		}
	]
}