					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851106,
					"content": "Oui, mais quel est le rapport ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851107,
					"content": "Je me suis dit qu'on pourrait faire d'une pierre, deux coups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851108,
					"content": "T'es sûre que c'est permis ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#C'est une épreuve spéciale dont j'ai eu l'idée sur le moment, rien que pour {NICKNAME}.",
