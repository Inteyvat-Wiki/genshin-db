			"dialogs": [
				{
					"id": 4850801,
					"content": "Félicitations ! Voilà ton permis ! Tu peux planer légalement maintenant, youpi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850802
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850802,
					"content": "#Pas que ça m'étonne. Tu es naturellement {M#doué}{F#douée} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850803,
						4850804
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850803,
					"content": "C'était facile !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Oh, et permets-moi de t'inscrire au prochain Championnat de planage qui aura lieu à Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Je plane si vite que personne ne peut me rattraper... C'est nul ! Je n'ai aucune compétition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "D'accord, mais c'est moi qui vais gagner cette année !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Est-ce un défi ? Hihihi, tu ne sais pas encore ce qu'on te réserve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "En attendant ta raclée pendant le championnat, amuse-toi bien à planer dans le respect des règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Obéis à la loi et ne va pas te faire révoquer ton permis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850812,
					"content": "C'est quand même culotté de sa part de te dire ça...",
					"roleType": "TALK_ROLE_NPC",
