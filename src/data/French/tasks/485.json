					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851102,
					"content": "Nous devons planer pour le rattraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851103,
					"content": "Mais ça grouille de monstres au sol ! Ils vont nous attaquer en plein vol !",
