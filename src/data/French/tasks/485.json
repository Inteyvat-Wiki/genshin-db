					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851104,
					"content": "Nous n'avons pas le choix. Il faut <color=#00E1FFFF>s'en débarrasser en même temps</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851105,
					"content": "#Au fait, {NICKNAME}. T'as encore une dernière épreuve à passer si je me souviens bien ?",
