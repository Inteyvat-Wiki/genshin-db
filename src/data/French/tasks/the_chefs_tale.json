			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantôme gourmand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "Le poulet est goûtu, et il y a assez d'accompagnements. C'est difficile de trouver des défauts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330402,
					"content": "Enfin, peu importe. Je ne suis pas là pour embêter les nouvelles recrues exprès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330403,
					"content": "Je ne suis qu'un chef. Je fais mon travail, et je dois bien le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330404,
					"content": "Pour ça, je me suis préparé à l'arrivée de la Chasse sauvage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330405,
					"content": "Mais c'est dommage... Je n'ai pas pu leur faire parvenir la nourriture à temps... Elle s'est renversée... renversée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantôme gourmand"
				}
			]
		}
	]
}