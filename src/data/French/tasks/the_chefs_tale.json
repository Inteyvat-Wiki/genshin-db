			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantôme gourmand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "#Hé, {M#le nouveau}{F#la nouvelle}, tu ne peux pas préparer ce genre de plats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330102,
					"content": "On fait des rations pour les ratnikis de l'île, alors il faut s'adapter à leurs goûts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330103,
					"content": "Ces plats ne feront pas l'affaire. D'abord, ils ne sont pas assez cuits, et ensuite, ça ne va pas avec notre régime alimentaire. Il faut changer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330104,
					"content": "Tu as encore beaucoup à apprendre. Je te conseille de commencer par nos plats les plus basiques, du style les hot-dogs de Nod-Krai. Reviens me voir quand tu les auras faits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantôme gourmand"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantôme gourmand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Mmm, la saucisse est bien grillée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330202,
					"content": "Tu pourrais seulement être commis de cuisine si tu travaillais dans un restaurant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330203,
					"content": "Mais on cuisine pour tous les ratnikis de l'île. On se fiche de manger des plats raffinés. Ce qui compte, c'est d'être rassasié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330204,
					"content": "Fais ton pain plus épais. Il n'y a pas beaucoup de légumes en ce moment, et tu devrais aussi ajouter d'autres viandes que les saucisses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330205,
					"content": "Tu as encore besoin d'entraînement ! Reviens la prochaine fois, tu me feras de la viande frite aux baies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantôme gourmand"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantôme gourmand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Hm, la viande a été coupée en assez gros morceaux et bien frite après. Pas mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330302,
					"content": "Mais je me permets de te rappeler qu'il faut bien réfléchir aux accompagnements quand tu prépares de la viande frite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330303,
					"content": "C'est facile de manger trop de viande. Voilà pourquoi on ajoute les baies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330304,
					"content": "On doit maintenir un régime alimentaire sain pour tout le monde sur cette île, alors il faut garder un équilibre entre viande et légumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330305,
					"content": "Le plat n'avait pas assez de légumes en accompagnement. Il n'est pas assez complet, et c'est mauvais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Fantôme gourmand"
				},
				{
					"id": 760330306,
					"content": "Tu as encore besoin d'entraînement ! Reviens la prochaine fois, tu me feras du poulet mariné aux lakkabaies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantôme gourmand"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
