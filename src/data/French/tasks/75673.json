			"dialogs": [
				{
					"id": 756730101,
					"content": "On dirait que nos ashas coloristes sont désormais pleinement satisfaits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Encore un défi relevé par nos merveilleux ashas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Génial ! On a réussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Est-ce que cet asha a déjà envie de se lancer dans une nouvelle création ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "Eh bien, tu sais bien que l'inspiration peut surgir et disparaître en un clin d'œil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Ah, regarde tous les trésors qu'il a laissés derrière lui... {NICKNAME} et Paimon, c'est à vous deux qu'ils reviennent ! Pour tout le mal que vous vous êtes donné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Peut-être que la prochaine fois que nous passerons, nous pourrons admirer le chef-d'œuvre des ashas coloristes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Imagine un peu ce que ça donnerait ! Surtout quand on sait que même les ashas ordinaires sont capables de produire des couleurs aussi magnifiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "J'ai hâte de voir ce que les coloristes ashas vont bien pouvoir créer ! Peut-être qu'ils vont nous proposer quelque chose... qui dépasse tout ce que les mots peuvent décrire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Peut-être nous offriront-ils... les couleurs du phlogistique, de la lune, ou quelque chose provenant des profondeurs du ciel étoilé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "Oui, c'est exactement comme ça que ça devrait être ! Si nous rencontrons une créature en difficulté au cours de nos aventures, nous devons faire tout notre possible pour l'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Oui ! Qui sait ? Peut-être qu'un jour, nous récolterons les fruits de nos bonnes actions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Je suis d'accord avec Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ah, mais... On ne devrait pas le faire uniquement dans l'espoir de recevoir une récompense. Ce n'est pas le but.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Même si nous n'y gagnons rien, aider nos amis dans le besoin et voir leur sourire revenir à mesure que les choses s'améliorent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "C'est un sentiment particulièrement agréable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "C'est aussi très gratifiant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Il faut donc battre le fer tant qu'il est chaud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}