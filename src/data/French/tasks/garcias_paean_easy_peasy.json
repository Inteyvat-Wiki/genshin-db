						230165102,
						230165105
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165102,
					"content": "Garcia est ici depuis longtemps ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Il est là depuis un moment. Ce type a plus soif d'apprendre que certains apprentis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Mais il n'a vraiment pas l'air de quelqu'un du métier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Est-ce que quelqu'un est venu lui rendre visite à part moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "En effet... Il y a bien une femme qui vient le voir de temps en temps et lui apporte des tas de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Je l'ai entendu dire que le nom de cette femme était Kaia... ou quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Pourquoi tous ces gens qui semblent n'avoir rien à voir avec la forge se rassemblent-ils chez moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				}
			]
