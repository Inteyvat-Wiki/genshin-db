			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong ! Cet engrenage est prêt à être démoulé, venez m'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "#Ah, {M#voyageur}{F#voyageuse}, vous revoilà. Vous avez demandé à monsieur Ahangar ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160303,
					"content": "Vite, dites-moi, qu'est-ce que je dois faire avec cet engrenage ?",
					"roleType": "TALK_ROLE_NPC",
