					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "Ah ! Ça a marché, cet engrenage est très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Espacement des dents... Épaisseur... Taille... J'ai besoin d'une règle pour mesurer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "#Laissons monsieur Garcia faire ses mesures. {M#Voyageur}{F#Voyageuse}, voici pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Vous avez toujours autant de réserves ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Oui, toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "On peut considérer que monsieur Garcia et moi étions en train d'errer devant une grande montagne, et que maintenant, tout ce qu'on a fait, ça a été d'enlever une petite pierre au pied de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Mais en fait, on n'a toujours pas trouvé notre chemin dans la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "J'espère que les talents de monsieur Garcia pourront nous guider sur la voie à suivre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Ou il ne me reste plus qu'à me raccrocher au dicton « Quand on arrive au pied d'une montagne, il y a toujours un chemin. ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
