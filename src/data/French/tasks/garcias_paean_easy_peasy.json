			"dialogs": [
				{
					"id": 230165001,
					"content": "Monsieur, il me semble que nous devrions peut-être... changer d'idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "Changer d'idée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Par exemple, on pourrait essayer de fabriquer des machines moins complexes, mais plus autonomes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "Je suis sûr qu'avec votre talent, créer de telles machines serait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Mon cher Lutong, nous en avons déjà discuté et vous connaissez ma réponse... Mais de toute façon, je respecterai toujours votre choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "Eh bien, nous devrions peut-être parler de l'endroit où vous allez dîner avec mademoiselle Kaia, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Merci, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "De rien, monsieur, notre contrat n'a pas encore expiré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
