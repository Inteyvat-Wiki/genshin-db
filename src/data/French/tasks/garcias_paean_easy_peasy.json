				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Mes mains... Argh ! Elles sont toutes engourdies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Monsieur, vous devrez bientôt gérer les comptes de mademoiselle Kaia, vous ne devez pas vous surmener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Je sais, je sais ! Lutong !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Bien sûr, si vous ne pouvez pas y arriver, je peux aussi le faire pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "Non ! Je vais y arriver, j'ai juste besoin de... forger quelques engrenages de plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Bon, je n'ai plus la force, je n'en peux plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "Qu'est-ce que vous faites cette fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "#Ah, c'est vous, {M#voyageur}{F#voyageuse}. Aïe... Mes mains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Eh bien, comme monsieur Ahangar a d'autres choses à faire et ne peut pas continuer à forger les pièces dont j'ai besoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Et en plus, les pièces qu'il fabrique sont toujours légèrement différentes de celles que j'ai en tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "Donc, pour m'assurer de la fiabilité des pièces, j'ai demandé à monsieur Ahangar de m'apprendre quelques techniques et j'ai décidé de me mettre à les forger moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "Heureusement que j'avais déjà fait quelque chose de similaire quand j'étais à Fontaine... Par contre, certaines des techniques que monsieur Ahangar m'a expliquées étaient vraiment impossibles à retenir, aïe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pourriez aller consulter monsieur Ahangar sur les techniques pour moi, j'ai vraiment besoin d'une pause...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "D'accord. Reposez-vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Et merci pour votre aide, c'est gentil. Aïe... Mes mains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Dites, qui est Kaia ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "C'est une de mes partenaires d'affaires ! Une... Euh... Partenaire d'affaires avec... Euh... Beaucoup de talent et beaucoup d'argent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "On a signé un contrat de gestion de compte à long terme ! C'est pourquoi je vais toujours la voir, pas vrai Lutong ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "Oui, c'est vrai, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "#Bon voilà, c'est tout... {M#Voyageur}{F#Voyageuse}, s'il vous plaît, allez consulter monsieur Ahangar dès que possible, je vous attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Je t'ai dit que ça allait prendre du temps... Hein ? C'est vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Je viens vous consulter pour lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Il l'a vraiment fait lui-même... Quel cinglé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "De toutes mes années en tant que forgeron, je n'ai jamais rencontré quelqu'un d'aussi exigeant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Il a même utilisé une règle pour mesurer l'épaisseur des jointures entre les tuyaux, et les pas de vis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "J'ai fini par perdre patience, alors je lui ai dit qu'il n'avait qu'à le faire lui-même... Je ne m'attendais pas à ce qu'il vienne le lendemain pour me demander de lui apprendre les techniques de forge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Je n'ai pas réussi à l'en dissuader, alors je l'ai laissé faire ce qu'il voulait. Il achète lui-même les matériaux. Quant aux outils, je lui laisse utiliser les miens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "Je n'ai aucune idée de ce que ce type fabrique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Il fabrique une grosse machine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Bon... Ça reste bizarre quand même. Vous êtes ici pour vous renseigner sur les techniques de forge, c'est ça ? Je n'ai rien d'autre à vous dire sur la forge des engrenages...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "Cependant, j'ai remarqué que les engrenages que ce type voulait fabriquer étaient tranchants sur les bords et bombés au milieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "C'est le genre de forme d'engrenage qui est difficile à réaliser à l'aide d'un moule seul et nécessite un traitement supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Je lui ai déjà expliqué tous les détails. Vous n'avez qu'à les lui rappeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "Tout d'abord, lorsque vous repassez l'engrenage au four, vous devez <color=#00E1FFFF>ajouter plus de combustible</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Puis, lorsque vous le sortez du four pour lui donner sa forme, vous devez <color=#00E1FFFF>le marteler de l'intérieur vers l'extérieur</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Bon, vous allez vous en souvenir ? Alors, retournez le lui dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Quel type étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Il fabrique une machine étrange.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Ses mains étaient engourdies et il avait besoin d'une pause.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
		{
