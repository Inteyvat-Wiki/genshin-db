			"trigger": {
				"objectNames": [
					"Netochka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "Les plats de Katya sont délicieux. Mon retour à Novokitezhgrad peut attendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034016,
					"content": "Comme on se retrouve, Netochka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "Ah ! Tu es là pour le duel ? C—C'est une attaque surprise ?! Si tu veux te battre, fixons un endroit et une heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034018,
					"content": "J'aimerais quand même passer un peu de temps ici, car je n'ai pas eu l'occasion de vraiment explorer le Village de Nasha. Et si on remettait le duel à plus tard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034002,
					"content": "À propos de Novokitezhgrad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "Je m'ennuyais là-bas quand j'y vivais, mais maintenant que je suis partie, ça me manque... C'est la première fois que je pars aussi loin de chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034004,
					"content": "Je pensais qu'il y aurait beaucoup de nivéoles qui vivaient ailleurs, comme à Novokitezhgrad. Il y en a aussi pas mal à Snezhnograd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034005,
					"content": "Mais je n'en ai vu aucune à Nod-Krai. Paimon dit qu'elle n'en est pas une... Peut-être qu'elles n'apprécient pas le climat local ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034013,
					"content": "Il n'y a pas de tempête de neige, et on ne reste pas coincé dans la nature sans chauffage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034014,
					"content": "J'ai même vu quelqu'un boire de l'alcool de Novokitezhgrad à Nod-Krai. Notre industrie de l'alcool n'est pas autant connue que notre industrie minière, mais ça m'a émue de voir des choses de chez moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034011,
					"content": "À la prochaine !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "Oui ! Bon courage à nous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				}
			]
		},
