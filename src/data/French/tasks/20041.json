			"trigger": {
				"objectNames": [
					"Patty la Curieuse"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Ça ne sert à rien de faire un plan quand on part à l'aventure ! On ne le respectera jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410102,
					"content": "Peut-être, mais il faut se préparer à toutes les possibilités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "Pourquoi vous vous disputez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Je suis une archéologue et je voudrais me rendre au Temple des Mille Vents, mais je ne sais pas me battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410105,
					"content": "Doolan est un aventurier, il s'est chargé de faire les préparatifs de notre expédition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410106,
					"content": "Je ne doute pas de son expertise et je sais que les ruines sont dangereuses, mais il insiste pour établir un plan d'aventure dans les moindres détails...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410107,
					"content": "On n'arrête pas d'enchaîner réunion sur réunion entre sessions de recherche, enquêtes de terrain et multiples ajustements, je n'en peux plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410108,
					"content": "Et là, il me dit que des nouveaux monstres sont en train de camper à proximité du temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410109,
					"content": "Par pitié, éliminez-les pour moi. Je ne supporte plus les réunions avec Doolan, au point que je me fiche de savoir si ça nous permettra ou non de rentrer dans ces ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410110,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Je vais prendre votre place dans ces réunions alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "C'est gentil de votre part, mais croyez-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 200410113,
					"content": "Il vaut mieux que vous affrontiez ces monstres plutôt que d'assister à une de ces réunions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patty la Curieuse"
				}
			]
		},
