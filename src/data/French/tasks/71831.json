			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "Le temple a déjà meilleure allure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310302,
					"content": "Ça a l'air pas mal, en effet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "Hein ? Oh ! Vous avez le sens du timing, vous, non ? Les réparations viennent de se terminer et je viens de finir de payer les artisans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310304,
					"content": "Ah, je n'aurais jamais pensé que ça me coûte autant. J'y ai plus ou moins fait passer toutes mes économies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310305,
					"content": "Mais maintenant, le temple est à nouveau debout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310306,
					"content": "Vous voulez faire une offrande d'encens ? J'ai fait construire un nouvel encensoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310307,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Prenez ces bâtons d'encens. L'encensoir est juste là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310308,
					"content": "Vous avez déjà offert de l'encens ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Évidemment. J'ai été le premier à le faire quand la rénovation a été terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
