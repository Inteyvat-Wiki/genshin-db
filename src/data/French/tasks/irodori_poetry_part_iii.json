			"dialogs": [
				{
					"id": 726930501,
					"content": "La baie sauvage doit faire allusion à des expériences douloureuses. Ce n'est pas un souvenir joyeux comme une première gorgée d'alcool ou la première lecture d'un poème, mais cela laisse une impression marquante.",
					"roleType": "TALK_ROLE_NPC",
