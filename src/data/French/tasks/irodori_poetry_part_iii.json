				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "#Qu'en est-il des photos, {M#jeune homme}{F#jeune femme} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930202,
					"content": "Les voici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "Merci infiniment. Grâce à ces photos, je pourrai écrire des vers dont je serai satisfait. Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930204,
					"content": "Voici ce que j'ai écrit en voyant les photos. Je vous laisse choisir les vers que vous souhaitez inclure dans le poème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
