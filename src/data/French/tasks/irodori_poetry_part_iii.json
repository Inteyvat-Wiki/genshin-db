					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "#Vous voilà, {M#jeune homme}{F#jeune femme}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "Dans son poème d'hier, Lenne a évoqué son regret de ne pas m'avoir connu plus tôt. Aujourd'hui, c'est moi qui vais lui dédier un poème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "C'est plus qu'un honneur de recevoir un tel cadeau, Ootomo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Le vieil homme que je suis s'est pris d'intérêt pour Mondstadt après avoir rencontré de nombreux amis originaires de là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "Je me suis fortement inspiré du style des bardes de Mondstadt pour écrire ce poème, et j'aborde son paysage dans les vers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "#Cependant, je n'y suis jamais allé et c'est fort dommage. Alors, je me demandais si vous voudriez bien me prendre quelques photos de <color=#00E1FFFF>produits de Mondstadt</color>, {M#jeune homme}{F#jeune femme}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Haha, je vous remercie. Comme d'habitude, quatre photos conviendront parfaitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
