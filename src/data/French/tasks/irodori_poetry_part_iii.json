			"trigger": {
				"objectNames": [
					"Lenne",
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "Le poème d'Ootomo rompt avec le format de la poésie inazumienne, mais décrit divers souvenirs inoubliables d'une vie à l'aide de sa technique classique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930602,
					"content": "Tout cela pour me dire que Mondstadt et Inazuma possèdent une beauté commune malgré leurs différences, tout comme nous qui communiquons en tant que poètes et faisons fi de notre nationalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930603,
					"content": "Vous êtes si jeune, Lenne, mais si rapide à déchiffrer les sentiments exprimés dans les vers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930604,
					"content": "Moi qui ne croyais pas à l'amitié intergénérationnelle, je découvre aujourd'hui que cela existe réellement. C'est une chose merveilleuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930605,
					"content": "#Et vous aussi, {M#jeune homme}{F#jeune femme} aux qualités exceptionnelles, le destin nous a permis de nous rencontrer, tous les trois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930606,
					"content": "En effet. Bien que le voyage jusqu'ici fut tumultueux, chaque détail d'Inazuma restera gravé dans ma mémoire lorsque je serai rentré à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930607,
					"content": "Vous y avez grandement contribué avec vos photos, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930608,
					"content": "J'espère qu'un jour, nous pourrons nous revoir de nouveaux tous les trois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930609,
					"content": "Je ne raterai cela pour rien au monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
