			"dialogs": [
				{
					"id": 726930401,
					"content": "L'association entre les fleurs et les amants est présente dans tous les pays. Le vers signifie qu'il faut se souvenir du paysage d'Inazuma comme son premier amour.",
					"roleType": "TALK_ROLE_NPC",
