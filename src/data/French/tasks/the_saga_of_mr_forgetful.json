					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "Pas d'inquiétude. J'attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750404,
					"content": "Ces champignons fluorescents sont tellement frais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750407,
					"content": "C'est un peu facile... Ce ne serait pas nous qui vous les avons donnés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750408,
					"content": "Enfin, ne nous attardons pas sur les détails ! Je mange ces champignons depuis tout à l'heure, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750409,
					"content": "... Espèce... Espèce de tête-en-l'air...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750405,
					"content": "On y travaille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "#Reposez-vous un peu ici si vous êtes {M#fatigués}{F#fatiguées}. Vous pouvez même avoir un champignon fluorescent ou deux, si vous voulez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				}
			]
		},
