			"dialogs": [
				{
					"id": 721750601,
					"content": "#Bonjour {NICKNAME} ! Et bonjour petite fée flottante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750602,
					"content": "Bonjour monsieur tête-en-l'air !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750603,
					"content": "Je m'appelle Paimon. PAI-MON, c'est compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750604,
					"content": "D'accord, petite PAI-MON.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750605,
					"content": "... Mais vous vous moquez de moi ?! Où sont donc passées vos manières ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750606,
					"content": "#Hmpf, tu sais quoi, {NICKNAME} ? Donne-lui les champignons fluorescents en vitesse. Je ne veux plus adresser la parole à cet individu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Paimon"
				},
				{
