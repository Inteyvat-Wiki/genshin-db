			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Je ne pensais pas que vous étiez toujours sur l'île. C'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Comment vont vos recherches ? Vous avez fait des découvertes intéressantes ? Dites-moi tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Rien de transcendant, je dirais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "C'est normal, ne vous en faites pas ! Les îles comme celles-ci ne manquent pas de mystères. Vous finirez par trouver quelque chose forcément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "Au fait, qu'est-ce que vous faites ici, monsieur Roald ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Moi ? Oh, j'étais juste en train de faire mes bagages et de me préparer à partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "Le brouillard ici est vraiment trop bizarre... Il suffit de s'enfoncer dedans pour perdre son chemin... Et avant qu'on puisse s'en rendre compte, on est déjà de retour à la case départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "J'ai oublié le chemin que Kama m'a montré... Résultat ? Je me suis encore perdu en voulant retrouver les habitants de l'île pour qu'ils m'aident...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "Rien ne permet de savoir dans quelle direction on va dans ce brouillard. Ma boussole ne marche pas et les ombres ne se projettent nulle part. Je suis même allé jusqu'à essayer la méthode des chaussures, mais pas moyen d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "La méthode des chaussures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Il veut dire qu'il a utilisé ses chaussures pour marquer son chemin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Les trucs d'aventuriers ne vous échappent pas, {NICKNAME} ! Tu devrais en prendre de la graine, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Oui, tu as encore beaucoup à apprendre, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Oh, ça va ! Moi j'appelle ça tenter sa chance ! J'ai pas besoin d'apprendre ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "Quoi qu'il en soit, mon exploration des lieux n'a pas avancé d'un poil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "*soupir* Si j'avais pensé à attacher une corde à un arbre et à la tenir tout en avançant, j'aurais pu faire quelques tentatives supplémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "Pourquoi ne pas l'avoir fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "J'ai utilisé toutes les chaussures que j'avais pour m'aider à me repérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Ce sont des chaussures à usage unique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Eh bien, elles n'étaient pas censées l'être, mais je, euh, ... J'en ai jeté trop et j'ai oublié de les récupérer, alors... Je manquais de temps, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Ah ! Je me souviens enfin de ce que je voulais vous demander !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Eh bien, quelle surprise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Haha, euh, désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Comme vous le savez, j'ai la mauvaise habitude d'oublier constamment des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "Ma mauvaise mémoire m'a mis dans le pétrin plus d'une fois, d'autant plus que je suis un aventurier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "Et l'un de mes objectifs en venant sur l'Île de Tsurumi était de collecter des champignons connus sous le nom de champignons fluorescents. Selon Sango, ces champignons peuvent aider à améliorer la mémoire et à soulager le cerveau. On dit qu'ils peuvent même améliorer l'acuité visuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "La dernière fois que je suis venu ici avec Kama, j'étais tellement préoccupé par le fait de « rencontrer des locaux » que j'ai oublié d'en ramasser... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "Je ne m'attendais pas non plus à rencontrer autant de difficultés en venant seul sur l'île. C'est vraiment dommage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Donc, si vous avez toujours l'intention de continuer à vous aventurer sur cette île, est-ce que vous pourriez me cueillir quelques champignons fluorescents ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Merci infiniment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Essayez de ne pas m'oublier alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Haha, ça ne risque pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "C'est dommage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "*soupir* En effet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "On est en train d'explorer l'île.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Je vois, haha ! Dans ce cas, je ne vous dérange pas plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Hmm... Ça devrait aller. Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "D'ailleurs, dites-moi si vous trouvez quelque chose près du site cérémoniel de l'île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Ah oui. Il me semble que vous avez sur vous un appareil de Fontaine qui prend des photos, n'est-ce pas ? C'est un objet onéreux... Je devrais en acheter un quand mon budget me le permettra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Des historiens locaux racontent que le peuple de l'Île de Tsurumi peignaient des moments oubliés de leur histoire sur les murs des grottes rocheuses et que ces fresques auraient plusieurs milliers d'années aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Lors de mon dernier voyage, j'ai été en mesure d'apercevoir ces fresques à la lueur du feu de la cérémonie... Elles étaient inoubliables. Je n'ai pas arrêté d'y penser pendant plusieurs nuits sans parvenir à trouver le sommeil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Je ne pense pas que quiconque ait déjà vu ces fresques en entier, mais si vous pouviez me ramener une preuve de leur existence... Il pourrait s'agir d'une grande avancée pour le département d'histoire de la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "C'est pour cette raison que j'aimerais que vous preniez le plus de photos possibles de ces fresques. Je vous rachèterai ces photos à un bon prix pour les utiliser dans mon journal et bien sûr, une récompense pour le dérangement sera de mise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Marché conclu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Du moment que vous ne perdez plus votre journal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Je vais essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
