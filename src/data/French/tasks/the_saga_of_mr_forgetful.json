			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#Comme on se retrouve, {NICKNAME}... Et... euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "#Est-ce que je peux vous demander à quel prix vous seriez {M#prêt}{F#prête} à vendre cette petite chose flottante ? Elle me paraît très intéressante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Euh, vous êtes sûr que vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "Bien sûr que non ! Il est redevenu amnésique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "De quoi parlez-vous ? *rote* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "Hahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahahahaha... *tousse* HAHAHA ! Vous devriez voir vos têtes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Je suis mort de rire... Désolé, hahahaha... C'est une de mes « blagues préférées »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Ce n'est pas du tout marrant !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Pardon, mais j'ai du mal à comprendre votre sens de l'humour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "*tousse* Assez plaisanté, je suis désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Un aventurier de votre notoriété devrait se comporter plus sérieusement, bon sang !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Haha, il vaut mieux ne pas avoir des idées trop arrêtées sur les aventuriers. La Guilde regorge de personnages étranges, je dirais presque que je fais partie des plus normaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "... De peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Merci encore pour les champignons. Je n'ai pas constaté d'effet pour l'instant, mais il faudrait peut-être en manger sur une longue période pour s'en rendre compte. Si ça se trouve, ils n'ont aucune propriété médicinale... Au moins, ils ont bon goût.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Je devrais éviter de tous les manger. Il faut que j'en garde pour mon ami à Sumeru qui m'aidera à déceler les propriétés médicinales de ces champignons, s'ils en ont réellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "J'ai l'impression que vous allez oublier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "Hum, revenons à nos Brutocollinus. Avez-vous trouvé les fresques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Voici les photos que vous vouliez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Ooh, tous mes remerciements pour votre aide généreuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Voyons voir... Fascinant, oui. Hmm... Avez-vous vu d'autres fresques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "C'est tout ce qu'il y avait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "C'est d'autant plus intéressant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Les habitants de l'Île de Tsurumi vénéraient un monstrueux volatile qui contrôlait l'élément Électro. Leur civilisation était centrée sur des cérémonies et autres rituels ayant un rapport avec cette créature. Personne parmi le peu de gens qui connaissent ce pan d'histoire ne conteste ce fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Cependant, aucune des fresques que vous avez prises en photo ne fait allusion à l'Oiselle du tonnerre. Il semblerait que la population vénérait tout autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "Le soleil, la lune, les étoiles et... ce que ces étranges symboles représentent. Une civilisation était peut-être déjà établie sur l'Île de Tsurumi avant l'arrivée de l'Oiselle du tonnerre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Outre ceci, il y a aussi le brouillard et le clair de lune, ainsi que les étoiles et les ténèbres... Par contre, je n'ai pas d'explication pour ces éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Vous devriez arrêter d'utiliser votre tête, Roald. Qui sait ce que ça fera à votre mémoire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "... Oui, pardon. J'étais perdu dans mes pensées et j'avais presque oublié que vous étiez là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Merci encore une fois pour votre travail. J'ai assez d'informations pour écrire la prochaine entrée de mon journal. Des historiens tomberont peut-être dessus, alors je ne manquerai pas de vous mentionner dans les remerciements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Bien, c'est l'heure de faire mon rapport à la Guilde et pardon de vous avoir pris autant de temps. J'espère qu'on se reverra un jour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Quel homme occupé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Ah et une autre chose... Ce n'est rien de très important, mais j'aimerais vous demander de retrouver quelqu'un. C'est un enfant qui s'appelle... euh, un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "Oui, il s'appelle « Ruu ». Je lui ai apporté un peu de nourriture cette fois-ci, j'ose espérer que c'est encore frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Je n'ai pas arrêté de penser à lui depuis ma dernière visite ici. La vie doit être difficile pour lui sur une île aussi dangereuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Voilà, je ne vous dérange pas une seconde plus. À la prochaine, {NICKNAME} ! Vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "On n'a trouvé que celles-là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "C'est donc comme ça que les personnes avec une mauvaise mémoire s'adaptent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Est-ce que les champignons ont marché ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "Dans ce cas, pourquoi ses problèmes de mémoire semblent s'être empirés ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
