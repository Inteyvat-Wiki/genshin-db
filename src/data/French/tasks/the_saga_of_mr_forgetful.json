			"dialogs": [
				{
					"id": 721750401,
					"content": "#Bonjour {M#tous les deux}{F#toutes les deux} ! Du nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "Roald"
				},
				{
