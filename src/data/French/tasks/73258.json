						732580302
					]
				},
				{
					"id": 732580302,
					"content": "« Arama a préparé des fleurs, mais a peur de ne pas pouvoir les lui donner. Arana a dit que la peur, ce n'est pas bien. En ressentant la peur, on croit à son pouvoir... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580303
					],
					"speakerTitle": "Note écrite de manière désordonnée"
				},
				{
					"id": 732580303,
					"content": "« ... Le Festival Utsava va commencer. Beaucoup d'amis qu'Arama n'a pas vus depuis longtemps sont revenus à Vanarana. Araja est aussi content de pouvoir le remplacer... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Note écrite de manière désordonnée"
				}
			]
		},
