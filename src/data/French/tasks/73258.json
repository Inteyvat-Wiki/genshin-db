				},
				{
					"id": 732580202,
					"content": "#« ... Arama est content d'avoir appris de Paimon. L'incantation était en fait un « trésor » et non un « tézor ». Nara {NICKNAME} a battu les Vanagnis avec facilité. Impressionnant... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580203
					],
					"speakerTitle": "Note écrite de manière désordonnée"
				},
				{
					"id": 732580203,
					"content": "#« Tout le monde les aime bien. Il y a {M#un doré}{F#une dorée} et une argentée. {M#Ils}{F#Elles} ressemblent à un grand soleil et à une petite lune aussi douce que luisante... »",
					"roleType": "TALK_ROLE_NPC",
