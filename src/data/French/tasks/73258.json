					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "#« ... C'est beau avec une couronne de fleurs et cela {M#le}{F#la} relie à tout le monde. Comme {M#s'il}{F#si elle} était {M#un}{F#une} aranara. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Note écrite de manière désordonnée"
				},
				{
					"id": 732580403,
					"content": "#« Nara {NICKNAME} et Paimon sont en train de se reposer. Je ne comprends pas pourquoi les naras doivent se reposer ? On ne peut pas créer de souvenirs avec ses amis quand on se repose... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Note écrite de manière désordonnée"
				},
				{
					"id": 732580404,
					"content": "#« ... On va voir Ashvattha. Ashvattha acceptera nara {NICKNAME} et Paimon. Nous sommes des enfants de la forêt. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Note écrite de manière désordonnée"
				},
				{
					"id": 732580405,
					"content": "#« Et puis, il y a sans doute plein d'histoires sur nara {NICKNAME}, Paimon et les autres dans l'aranyaka. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Note écrite de manière désordonnée"
				},
				{
					"id": 732580406,
					"content": "#« Après que nara {NICKNAME} et Paimon obtiennent le bija pour aider nara Rana, appelons Arana et lisons ensemble les histoires de l'aranyaka. »",
					"roleType": "TALK_ROLE_NPC",
