			"dialogs": [
				{
					"id": 191079701,
					"content": "Monsieur Elzer... C'est vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079702,
					"content": "Connor, il faut que Diona se rende compte de notre sincérité. C'est le plus important maintenant, compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079703,
					"content": "Oui... Je comprends, monsieur Elzer !",
