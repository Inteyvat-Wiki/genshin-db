				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Bon travail, Connor ! En continuant comme ça, Diona finira forcément par travailler pour le Domaine de l'Aurore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "J'espère que ça marchera. Il m'aura fallu plusieurs semaines pour finalement avoir la chance de la rencontrer. Il ne faut pas laisser passer cette opportunité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Merci beaucoup, Connor. Tous ces efforts en vaudront la peine si nous réussissons à convaincre Diona de venir travailler pour nous. C'est le premier pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "N'oubliez pas qu'il faut que Diona sente notre sincérité et notre hospitalité ! Mais rappelez-vous : il faut y aller en douceur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Pas de problème, monsieur Elzer ! On a pratiqué, cette fois ça ira sûre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "De quoi parlez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Ah ? Oh, rien... Rien du tout. On discutait juste des affaires du Domaine, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Oui... C'est ça, on parlait affaires, alors, euh... Monsieur Elzer, parlons encore un peu des dépenses du Domaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
