			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fu San'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "#C'est dangereux de se promener {M#seul}{F#seule} par ici, vous savez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102102,
					"content": "Qui sait sur qui... ou quoi vous pouvez tomber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "Ah, ça n'a pas l'air de vous faire grand-chose. Mais « celui qui marche le long du fleuve doit se tremper les chaussures », comme on dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102106,
					"content": "#À se promener dans ce genre d'endroit, vous êtes {M#voué}{F#vouée} à voir des choses étranges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102107,
					"content": "Et alors une vie de cauchemars et de tourments vous attend !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102108,
					"content": "Ah, vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "Euh, vous êtes trop calme, ça ne va pas. Les gens partent en courant avant que j'aie fini mon petit topo en général.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102111,
					"content": "C'est parce que vous avez une apparence normale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Ce n'est pas faux. Mais la meilleure façon de jouer un fantôme est d'utiliser la peur de l'audience et de jouer dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102113,
					"content": "Peu importe à quoi je ressemble, en réalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102117,
					"content": "Me grimer ne sert à rien face à quelqu'un qui ne croit pas aux fantômes comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102118,
					"content": "Vous ne faites pas d'efforts...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "Ne dites pas ça, allons. Bon, je vais chercher ailleurs quelqu'un à qui faire peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102120,
					"content": "Allez vite retrouver la personne qui vous accompagne. Si ça se trouve, elle est déjà morte de peur à l'heure qu'il est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102114,
					"content": "Vous n'avez pas de costume ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Si, bien sûr. Mais il est bien trop chaud... Et puis la meilleure façon de jouer un fantôme est d'utiliser la peur de l'audience et de jouer dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102116,
					"content": "Peu importe à quoi je ressemble, en réalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102109,
					"content": "Je ne vous suis pas. Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
