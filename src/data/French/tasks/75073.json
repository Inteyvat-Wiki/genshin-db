				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#Ah, {M#mon sauveur}{F#ma sauveuse} ! Merci de m'avoir aidée à... vaincre ces Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "J'étais debout sur la falaise en train d'admirer le paysage, et l'un d'eux m'a assommée. Et quand je me suis réveillée, j'étais coincée ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "C'est verrouillé. La clé... Ah, c'est vrai. La clé est dans ce coffre là-bas. Puis-je vous demander de me rendre un tout petit service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Je vous serais éternellement et entièrement reconnaissante si vous acceptiez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
		{
			"id": 7507302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
