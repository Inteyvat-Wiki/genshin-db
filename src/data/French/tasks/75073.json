			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730201,
					"content": "#S'il vous plaît, {M#mon sauveur}{F#ma sauveuse}, cet endroit est si haut et il y a tellement de qucusaures dans les parages. Vous ne pouvez pas me laisser seule ici dans cette cage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
		{
