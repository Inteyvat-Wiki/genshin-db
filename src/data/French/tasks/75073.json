			},
			"dialogs": [
				{
					"id": 750730301,
					"content": "*sniff* Je suis enfin libre de cette prison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Ce ballon continue à se balancer d'un côté à l'autre. Hmph, qui sait, peut-être qu'une rafale de vent va faire tomber la cage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Je crains que même grand-mère Itztli ne puisse pas nous sauver dans ce cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Au fait, qui êtes-vous et comment êtes-vous arrivée ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Ah, c'est vrai, je ne me suis pas présentée. Je m'appelle Conulaf, une apprentie prêtresse des Maîtres du vent nocturne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Comme mon titre l'indique, je suis actuellement en formation pour devenir prêtresse. Je suis restée au sein de notre tribu toute ma vie, alors les anciens m'ont dit : pourquoi ne vas-tu pas explorer le monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Et ils m'ont expulsée de la tribu sous couvert de formation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "Pourtant, je ne dirais pas que se faire enfermer par des Brutocollinus est une bonne façon d'explorer le monde, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "C'est dangereux de partir à l'aventure en solitaire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Mais, oui ! Sans vous, je ne sais pas combien de temps je serais restée coincée là-dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "En tout cas, merci beaucoup de m'avoir sauvée... Maintenant, après tout ce que j'ai subi, je ferais mieux de descendre avant de réfléchir davantage à la poursuite de mon entraînement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Je n'ai pas grand-chose sur moi, mais dans ma famille, nous rendons la gentillesse lorsqu'elle nous est offerte. Alors, laissez-moi vous offrir ceci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Eh bien, tant que vous êtes assez forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "#Héhé... Ça ne va pas me convaincre. Il n'y a pas beaucoup d'{M#aventuriers aussi forts}{F#aventurières aussi fortes} que vous dans ce monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
