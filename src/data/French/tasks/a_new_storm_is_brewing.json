				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "Mmm... La mer est bien calme aujourd'hui encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400402,
					"content": "Ma famille surveille les tempêtes de mer depuis des générations. C'est dame Vennessa qui a confié elle-même cette tâche à mes aïeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400403,
					"content": "Il n'y a pas eu une seule tempête à l'horizon depuis que Barbatos protège Mondstadt. Les tours de guet sont devenues de plus en plus obsolètes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400404,
					"content": "Quand bien même, je ne peux pas m'empêcher de venir ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400405,
					"content": "Vous êtes vraiment dévouée à votre mission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Merci du compliment, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400407,
					"content": "Je ne préférerais pas avoir à le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400410,
					"content": "Enfin... Merci de tout cœur pour votre aide. Tenez, ces chrysanthèmes sont pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400411,
					"content": "Dans le temps, mes ancêtres observaient comment poussaient les chrysanthèmes dans un lieu pour y déterminer la puissance des vents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400412,
					"content": "Ce type de fleur ne pousse ni dans les lieux où le vent ne souffle pas, ni dans ceux où il souffle trop fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400413,
					"content": "Cette plante ne peut que pousser dans des endroits où le vent est doux, comme à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400414,
					"content": "Espérons qu'elles continuent de fleurir éternellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400408,
					"content": "C'est assez douloureux comme histoire à raconter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Oui, j'espère que l'histoire ne se répétera jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 2004005,
