				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "... Comment vais-je faire pour passer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400102,
					"content": "Oh, bonjour. Je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400103,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "J'essaye de me rendre à la tour du Coin du guet pour voir si une tempête commence à se lever en mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400105,
					"content": "Malheureusement, il y a une bande de monstres qui bloque la route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400106,
					"content": "Ne vous inquiétez pas, je ne vais pas vous demander d'aller à la tour pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400107,
					"content": "C'est un devoir que moi seule peut accomplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400108,
					"content": "Vous avez probablement d'autres chats à fouetter, ne vous souciez pas de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 2004002,
			"completionStepIds": [
				2004003
			],
