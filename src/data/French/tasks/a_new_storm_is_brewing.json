				"points": []
			},
			"dialogs": [
				{
					"id": 200400501,
					"content": "Elle croit que tout est réglé, mais les monstres sont trop nombreux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400502,
					"content": "Débarrassons-nous d'eux pour lui libérer le passage. Qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400503,
					"content": "Elle croit à tort que ses jambes seront assez rapides pour semer les monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400504,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "On devrait l'aider. Elle en a besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400505,
					"content": "C'est ce qu'on appelle avoir la foi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "Sinon ça pourrait très vite tourner au vinaigre pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400508,
					"content": "Débarrassons-nous de ces monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
