			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "#Merci {M#voyageur}{F#voyageuse} d'avoir libéré le passage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "On ne roule pas sur l'or, et la maladie d'Anna ne montre aucun signe d'amélioration ; c'est pourquoi je viens ici cueillir moi-même certaines herbes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "#J'ai cueilli les herbes médicinales que j'étais venu chercher, mais une bande de Brutocollinus sortie de nulle part m'a attaqué. Vous êtes {M#arrivé}{F#arrivée} à temps pour me sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Prenez ces herbes en guise de remerciement. Je fais du thé avec pour ma sœur, ça aide à calmer la toux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Faites attention à vous quand vous vous baladez dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
