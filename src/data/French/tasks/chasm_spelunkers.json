			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, {NICKNAME} ! Te voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu a deux mots à te dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "C'est encore son couplet sur la sécurité, c'est ça ? J'en ai ras-le-bol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "J'ai grandi dans les mines, moi aussi. Tu crois que je ne suis pas au courant des dangers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Et puis pour ce qui est de l'inconnu... Eh bien, les anciens se fient toujours à leur expérience pour juger si les choses sont dangereuses ou non, et ensuite, ils utilisent le résultat pour justifier leur expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "#J'en ai marre qu'on me dise ce que je dois faire. Je suis sûre que tu me comprends en tant qu'{M#aventurier expérimenté}{F#aventurière expérimentée}, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "#Si Iris avait réussi à te dissuader de faire l'ascension des Monts Dosdragon avec ses conseils de sécurité habituels, tu serais {M#passé}{F#passée} à côté de tellement de choses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Bon, pas besoin d'essayer de me convaincre. Je ne veux pas me disputer avec toi pour des broutilles. On peut juste, tu sais, changer de sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Regarde. Je suis en train d'étudier le terrain pour dessiner une carte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "C'est juste que... J'ai découvert que le chemin devant était bloqué par des choses... étranges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Si tu pouvais récolter quelques échantillons ou prendre des photos, je suis sûre que le Bureau des affaires civiles et la Guilde des aventuriers seraient contents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Je l'aurais bien fait moi-même, mais... J'ai laissé tomber mon Daguerréotype en descendant dans la mine, alors je ne peux compter que sur toi maintenant, héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Il y a aussi d'autres endroits... Oui. Ici et là. J'ai trouvé des traces de Pilleurs de trésors dans ces zones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Désolée, c'est où qu'il faut aller ? Je n'arrive pas à suivre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Tu viens de dessiner quelques croix et des lignes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Hahaha, désolée... C'est l'habitude. J'ai tendance à oublier que tout le monde n'est pas forcément un cartographe dans l'âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "Ce n'est pas grave, je vais vous suivre et vous montrer le chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "On peut commencer par n'importe lequel de ces endroits, alors choisissez celui que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "Dans ce cas, allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Sois prudente sur la route.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Je sais, je sais. Merci de t'inquiéter pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370510,
					"content": "Qu'est-ce que tu fais au juste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Eh bien, je viens de le dire... J'étudie le terrain pour le cartographier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				}
			]
