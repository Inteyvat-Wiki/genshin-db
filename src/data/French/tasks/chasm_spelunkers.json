			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Nous y voilà. Étrange... Où est passée Zhiqiong ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Zhiqiong ! Zhiqiong !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "*soupir* Je parie qu'elle est encore allée dans un de ces endroits pour dessiner ses cartes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Elle a dessiné ça juste après votre départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "Elle est probablement allée plus loin pour explorer. S'il vous plaît, dites-lui de ma part qu'elle devrait arrêter de laisser tout le monde en plan et de partir toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "S'il arrive quoi que ce soit et qu'elle entraîne tout le monde avec elle, elle va entendre parler de moi, c'est moi qui vous le dis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "Ça fait froid dans le dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Ça fait peur, oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Très bien, assez parlé maintenant, il est temps de passer à l'action. Vous pouvez m'aider à installer le camp ici, ou vous pouvez partir en exploration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Je suis désolée d'être directe, mais j'essaye de me rendre utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Ah, au fait. Si vous trouvez du minerai brut de pierre de lumen en chemin, apportez-le-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Je trouverai un moyen de le transformer en un Adjuvant plus efficace. D'après mon expérience, c'est très utile dans les mines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Est-ce que Zhiqiong est en danger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Non, pas encore. Mais si elle continue à partir comme ça sans rien dire, ça ne va pas tarder !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
