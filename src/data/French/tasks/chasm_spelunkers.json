				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Pfff, l'air familier de la mine ! Ça fait longtemps que je ne suis pas descendue ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Fais attention à toi, Qiong. Je sens qu'il y a quelque chose d'inhabituel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "#Après tout, ce n'est pas comme si on pouvait sauter directement en bas. On a peut-être été {M#distraits}{F#distraites} par le balancement de l'élévateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "Toi... Tu as passé trop de temps à la surface.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Je ne sens rien du tout... Tous les mineurs ont le nez aussi sensible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha ! Ne pas avoir de nez peut signifier la mort ici ! Cela dit, ça devrait aller. Les pinsons ont encore l'air assez vifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Regardez, il y a des cristaux de lumen jusqu'ici. Ce n'était pas le cas la dernière fois qu'on est venus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Waouh, alors c'est vraiment arrivé ! Allons jeter un œil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Hmm... J'ai l'impression que quelqu'un vient de me voler ma phrase fétiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Alors, les cristaux de lumen peuvent proliférer aussi près de la surface ? J'ai toujours pensé que ces choses ne pouvaient pas apparaître dans les endroits structurellement vulnérables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "Ce sont des fragments de cette « chose » souterraine qui voyagent dans les veines de la roche avant d'arriver ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Hé ! Arrête de dire n'importe quoi. Ce sont des roches originaires de la région, c'est pour ça qu'elles sont devenues comme ça. Elles ont simplement subi le processus naturel et ont formé des cristaux, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "Les analyses que les Sept Étoiles nous ont demandé de mener révèlent qu'elles sont en grande partie constituées de minerai provenant de la région. Elles ont juste été affectées par une force extérieure, créant ainsi ces étranges cristaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Hé, regarde ce cristal ! Il ressemble à ton Adjuvant, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#Pourquoi ne pas prendre l'Adjuvant de pierre de lumen et jeter un œil, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "C'est vrai. L'Adjuvant est fait de la même matière que ces cristaux. Ces formations vont donc naturellement réagir les unes avec les autres en raison de cette similarité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "C'est vraiment étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "C'est tout ce que tu trouves à dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "#Hum, ne vous battez pas, {M#tous}{F#toutes} les deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "On ne se bat pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "Oui, on ne se bat pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "Ce que je veux dire, c'est que peu importe si vous vous battez ou non, Zhiqiong et moi devons installer un camp temporaire un peu plus loin, alors ne vous éloignez pas pendant ce temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "Les cristaux qu'on a découverts vont être très utiles pour le reste de l'exploration. N'hésitez pas à me faire savoir si vous faites d'autres découvertes de ce genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "Je ne suis pas encore complètement rouillée, je peux vous aider à raffiner une partie du minerai brut. Je pense que ça pourra vous être utile lors de vos aventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "Et, hum, aussi... Ne vous disputez pas, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "#Vous êtes {M#gentils}{F#gentilles}. Je vous apporterai des bonbons plus tard. En tout cas, si vous trouvez quoi que ce soit d'étrange dans les parages, venez le rapporter au plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Au fait, tu te souviens de ce qu'on disait la dernière fois à propos d'oncle He...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Je n'ai pas oublié. D'ailleurs, puisque vous êtes là, {NICKNAME}, est-ce que vous pourriez m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "Oncle He est un ancien de la mine. Il faisait partie des disparus quand les mineurs du Gouffre ont été évacués il y a de cela plusieurs années. Il était sourd, et n'a probablement pas entendu l'alerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "Les pensions reversées par le Hall Huishan et la Chambre Shenglu sont relativement généreuses, et sa famille a déjà organisé ses funérailles depuis longtemps... Mais bien que je ne croie pas beaucoup au surnaturel, je n'arrive pas à m'empêcher de penser qu'il est toujours en vie quelque part ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Il avait vraiment de l'expérience. Il en savait beaucoup sur la façon d'éviter les désastres de la mine, comment s'échapper, comment attendre les secours... Il savait tout ça. Il m'a beaucoup appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "C'est pourquoi j'ai l'intime conviction que même maintenant, il est encore vivant quelque part ici... Je n'ai pas l'intention d'arrêter de le chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Je vais vous indiquer quelques endroits où il a été vu avant qu'on soit évacués... Qui sait, peut-être que vous pourrez encore y trouver des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Quant à moi, je vais aller explorer les parties les plus profondes des cavernes minières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Au fait, n'oubliez pas vos bonbons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Tu ne viens pas avec nous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "On a besoin qu'elle nous aide avec les cartes. Les chemins des mines du Gouffre sont complexes et tortueux. Nous n'irons pas bien loin sans ces cartes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Fais attention à toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Tout ira bien. Ce n'est pas comme si j'étais une débutante. Ne t'inquiète pas pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "C'est incroyable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
