			"dialogs": [
				{
					"id": 710371101,
					"content": "Merci pour ton aide. Tiens, prends ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371102,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "#Oh, allez, pas besoin d'être aussi {M#poli}{F#polie}. Je veux dire, c'est Khedive qui régale après tout ! Oh, attends, chut... Il faut faire attention, si jamais il nous entendait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371104,
					"content": "*tousse* Ahem. Est-ce qu'on ne ferait pas mieux d'aller voir Jinwu ? Son expérience pourrait nous être utile pour répondre à certaines des questions qu'on se posait en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371105,
					"content": "#Tu sais quoi ? Jinwu n'aime pas trop en parler, mais de la même manière que tu es {M#devenu}{F#devenue} célèbre par tes exploits à Dosdragon, elle était une véritable légende dans les mines... *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371106,
					"content": "J'ai entendu dire qu'elle avait aidé à guider les équipes de recherche des Millelithes, et qu'ils avaient réussi à sauver beaucoup de monde grâce à elle. Mais c'est du passé à présent. Je vais éviter d'en parler, ou elle risque encore de se fâcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371107,
					"content": "Très bien, je ne te retiens pas plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
}