			"dialogs": [
				{
					"id": 60280301,
					"content": "Ça va ? Votre blessure vous fait encore mal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280302,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280303
					]
				},
				{
					"id": 60280303,
					"content": "J'ai demandé à quelqu'un de préparer un remède qui pourrait être efficace. Prenez-le si besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280304,
						60280305
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280304,
					"content": "Merci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				},
				{
					"id": 60280306,
					"content": "Dans ce cas, je vais vous raconter l'appel que nous avons fait à Alice après l'incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280307
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280307,
					"content": "Dottore est très rusé... Il a distrait l'Hexenzirkel en créant la pagaille aux frontières de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280308
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280308,
					"content": "J'ai cru que c'était une intrusion de l'Abîme depuis le monde extérieur, car cela arrive souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280309
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280309,
					"content": "Mais après avoir appris que vous avez réussi à influencer les mirages à Nod-Krai, j'ai réalisé que cette interférence venait peut-être de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280310
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280310,
					"content": "Mais on n'a pas pu changer leur destin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280311
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280311,
					"content": "Tu as raison. Vous n'avez pas réussi à changer la fin de leurs histoires, mais vous avez créé des « variables » autour de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280312
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280312,
					"content": "Des variables ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280313
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280313,
					"content": "Oui, des choses que vous avez entendues et que nous n'auriez jamais pu savoir, des idées qui ne vous auraient jamais traversé l'esprit... Voici ce que sont ces « variables ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280314
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280314,
					"content": "Face à des possibilités quasi infinies, la plupart des variables ne représentent pas grand-chose. Cela change dès que vous les considérez comme des blocs de constructions et que vous les empilez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280315
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280315,
					"content": "C'est ce que Dottore a fait. Il a créé les conditions nécessaires pour que vous soyez impliqués dans son plan dès que vous avez activé le portail ce soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280316
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280316,
					"content": "Cependant, nous n'avons aucun moyen de savoir ce qu'il a vraiment fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 60280317,
					"content": "Nous devons savoir ce qui est arrivé à Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280318
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280318,
					"content": "Et voilà tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280319
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280319,
					"content": "Comme je m'y attendais, Dottore a complètement disparu. Mais au moins, il n'a pas été en mesure de contrôler Columbina comme il l'aurait souhaité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280320
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280320,
					"content": "La situation actuelle n'est pas vraiment mieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280321
					]
				},
				{
					"id": 60280321,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280322,
						60280323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280322,
					"content": "Pour gâcher le plan de Dottore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280324,
					"content": "Quoi ? Qu'est-ce qu'elle a fait ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280325,
					"content": "Vous ne l'avez pas vue faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280326
					]
				},
				{
					"id": 60280326,
					"content": "Tout ce qu'on a vu, c'est que Dottore s'est servi d'un genre de pouvoir... Ensuite, Columbina et lui ont disparu, et tu étais en train de tomber dans l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280327,
					"content": "#(Je vois... Dottore a figé le temps. C'est pour ça que j'étais {M#le seul}{F#la seule} à pouvoir me déplacer librement.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280328
					]
				},
				{
					"id": 60280328,
					"content": "(De leur perspective, le combat et la décision de Columbina ne se sont produits qu'en un instant.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280329
					]
				},
				{
					"id": 60280329,
					"content": "#(Est-ce le pouvoir des trois lunes ? Mais pourquoi n'a-t-il pas eu d'effet sur moi ? Est-ce parce que je suis {M#un descendeur}{F#une descendeuse} ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280330
					]
				},
				{
					"id": 60280330,
					"content": "Du coup, Columbina a intentionnellement ouvert le portail de la lune pour s'échapper dans le même monde mystérieux que Rerir et Tholindis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280331
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280331,
					"content": "Ce n'est pas très rassurant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280332
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280332,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280333,
						60280334
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280333,
					"content": "C'est sûrement pour cette raison que Dottore a fait profil bas depuis tout ce temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280335,
					"content": "Vu sous cet angle, Dottore a peut-être tiré les ficelles de la « syzygie trilunaire » et de l'apparition de Rerir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280336
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280336,
					"content": "Selon Alice, il tente de transcender son destin et de mener à bien une expérience que seule une divinité pourrait accomplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280337
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280337,
					"content": "... Quel cinglé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280338
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280338,
					"content": "Attendez, où est le type au chapeau ? Il voudrait certainement être là pour ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280339,
					"content": "Après avoir parlé à Alice, il a dit qu'il avait peut-être une idée de ce qu'il fallait chercher, alors il a pris le dodommunicateur avant de partir enquêter seul de son côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280340
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280340,
					"content": "Il avait une mine effrayante... Je ne l'ai jamais vu comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280341
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280341,
					"content": "(Il était sans doute en colère et frustré que Dottore ait eu une longueur d'avance, malgré tous ses efforts.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280342
					]
				},
				{
					"id": 60280342,
					"content": "(Honnêtement, moi aussi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280343
					]
				},
				{
					"id": 60280343,
					"content": "Je suis de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280344
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280344,
					"content": "Le type au chapeau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280345
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280345,
					"content": "Je suis allé voir les mirages des Hyperboréens, et je crois que j'ai enfin compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280346
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280346,
					"content": "Je les ai fait parler à Nicole qui était à l'autre bout du fil. Il s'avère que l'histoire qu'ils ont décrite est différente de celle dont elle se souvient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280347
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280347,
					"content": "Ah bon ? Mais comment ? Nicole ne pourrait pas se tromper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280348,
					"content": "Parce que les mirages sont ceux qui ont été dupés. Ils parlent d'un « sauveur » qui n'aurait jamais dû exister dans leur histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280349
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280349,
					"content": "Cette personne a promis de créer une nouvelle lune dans le faux ciel, et même de ramener leurs Déesses de la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280350
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280350,
					"content": "Ils l'ont cru bêtement, et lui ont dit tout ce qu'il voulait savoir sur les lunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280351
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280351,
					"content": "C'est évident qu'il s'agit de l'œuvre de Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280352
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280352,
					"content": "Maintenant que vous le dites... La première fois que nous sommes entrés dans les ruines hyperboréennes, nous avons entendu les mirages discuter de leur histoire. Dans mes souvenirs, Nicole avait remarqué que quelque chose semblait un peu étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280353
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280353,
					"content": "Mais Dottore n'aurait pas dû avoir accès à cet endroit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280354,
					"content": "Il n'y est pas allé. Nicole a dit que c'était une anomalie causée par les perturbations de la causalité entre les mirages de la même époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280355
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280355,
					"content": "Les « variables » que Dottore a mises en place étaient si importantes qu'elles ont influencé les mirages qu'il n'a jamais vus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280356
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280356,
					"content": "Ce n'était pas une perte de mémoire... Leurs souvenirs ont été manipulés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280357
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280357,
					"content": "C'est exactement la possibilité que Dottore essayait de créer. Il a transformé ces variables en connaissances et a manipulé la situation pour que toutes ces connaissances tombent entre ses mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280358
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280358,
					"content": "Puis, il a mis à profit ces connaissances lors de la Nuit de la prière lunaire... pour créer une « fausse lune ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280359
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280359,
					"content": "Comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280360,
					"content": "Plus précisément, il a exploité une faiblesse dans le fonctionnement du sort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280361
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280361,
					"content": "Le sort détecte la localisation de la lune grâce au kuuvahki. Ainsi, tant que la « fausse lune » ressemble davantage à une lune que la Lune de Givre au-delà des cieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280362
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280362,
					"content": "Ce portail téléporterait Columbina vers l'emplacement de la fausse lune... en d'autres termes, aux côtés de Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280363
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280363,
					"content": "Une fois qu'elle était sous son contrôle, le sort de téléportation est resté actif, et il a manipulé le pouvoir de Columbina pour s'emparer des deux essences lunaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280364
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280364,
					"content": "À ce moment-là, les essences lunaires ont disparu sous nos yeux... C'était déjà trop tard alors même que nous quittions les ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280365
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280365,
					"content": "Dottore avait déjà rassemblé le pouvoir des trois lunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280366
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280366,
					"content": "Alors... Que se passe-t-il ? Que faisons-nous maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280367
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280367,
					"content": "J'aimerais bien sûr savoir ce qu'en pense Sa Majesté, vu que les inquiétudes que je lui avais exprimées se sont concrétisées. Par contre, nous ne pouvons pas rester les bras croisés en attendant qu'elle tranche sur la question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280368
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280368,
					"content": "Et de toute façon, ce n'est pas l'Exécutrice des Fatui qui nous considère comme ses amis, mais plutôt Columbina Hyposelenia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280369
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280369,
					"content": "Si, même dans des circonstances aussi extrêmes, la Tsarine ne lève pas l'interdiction faite aux Exécuteurs de s'affronter entre eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280370
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280370,
					"content": "Je vais faire ce que mon cœur me dit. Je combattrai en tant que Peruere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280371
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280371,
					"content": "Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280372,
					"content": "Le temps nous est compté, alors je vais agir en premier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280373
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280373,
					"content": "Ouah, même Arlecchino n'arrive pas à rester calme dans cette situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280374,
					"content": "(Je pense qu'elle se sent en partie responsable de ça... et moi aussi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280375
					]
				},
				{
					"id": 60280375,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280376
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280376,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280377
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280377,
					"content": "Allez, ne faites pas tous cette tête. Écoutez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280378
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280378,
					"content": "La situation est grave, très grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280379
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280379,
					"content": "Dottore a utilisé des moyens détournés pour prendre l'avantage sur nous, du moins pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280380
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280380,
					"content": "Et oui, au point que même les sorcières disent que ses « variables » ont influencé le destin. Enfin, je n'en suis pas si sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280381
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280381,
					"content": "Beaucoup de gens m'ont dit que le destin de Teyvat était scellé, ça me semble être le cas. Mais comment Dottore est-il si certain qu'il fera exception à la règle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280382
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280382,
					"content": "Certes, il a été capable de créer des « variables », mais qui dit qu'on ne peut pas faire pareil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280383
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280383,
					"content": "#Tu ne devrais pas être {M#découragé, voyageur venu}{F#découragée, voyageuse venue} de loin. Surtout pas toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280384
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280384,
					"content": "C'est loin d'être fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280385,
						60280386
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280385,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280387,
					"content": "#Et tu n'es pas {M#le seul}{F#la seule} dans ce cas. C'est ce que tout le monde ici ressent, peu importe si cela a été exprimé ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280388
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280388,
					"content": "Mais aucun d'entre nous n'est du genre à se tourner les pouces en attendant que le jour se lève.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280389
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280389,
					"content": "#C'est comme ça qu'un chevalier doit se comporter : quand tu tombes, tu te relèves ! N'oublie pas, chevalier honoraire, que tu es aussi l'{M#un}{F#une} des nôtres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280390
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280390,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280391
					]
				},
				{
					"id": 60280391,
					"content": "Varka a raison ! Ce n'est pas terminé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280392,
					"content": "Dottore mérite une bonne raclée depuis longtemps, vu ce qu'il nous a fait par le passé ! Et encore plus maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280393
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280393,
					"content": "Bien dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280394
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280394,
					"content": "Qu'en pensez-vous tous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280395
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280395,
					"content": "Je vais utiliser le kuuvahki pour retrouver la trace de Columbina. Je ne suis pas prête à renoncer non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280396
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280396,
					"content": "Laissez-moi m'occuper de la collecte de renseignements. Le Curatorium des secrets trouve toujours le moyen d'être au courant de tout ce qui se passe à l'intérieur de Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280397
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280397,
					"content": "Aino et moi ferons de notre mieux pour vous aider. Nous tenterons de reproduire les actions de Dottore afin de trouver des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280398
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60280398,
					"content": "Alice et Nicole sont occupées à gérer une urgence aux frontières de Teyvat. Elles ne peuvent donc pas revenir pour l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280399
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280399,
					"content": "Elles sont très en colère à ce sujet, et ont demandé à Albedo et moi d'agir en leur nom pour combattre Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280401
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280401,
					"content": "Es-tu prêt ? Nous allons devoir faire beaucoup de recherches, même au début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280402,
					"content": "Je ferai tout mon possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280403
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280403,
					"content": "Je connais le mode opératoire de Dottore, alors je pourrai essayer de prédire ses prochaines actions pour vous aider dans votre enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280404
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280404,
					"content": "Bon, toutes les tâches semblent avoir été réparties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280405
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280405,
					"content": "Je vais contacter Flins et Illuga pour qu'ils en parlent avec leur starshyna. Ça ne nous ferait pas de mal d'avoir l'aide des Gardiens de lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280406
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280406,
					"content": "Je demanderai aussi aux chevaliers présents à Nod-Krai de prêter main-forte aux Gardiens de lumière et aux autres organisations pour assurer la sécurité des habitants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280407,
						60280408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280407,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
