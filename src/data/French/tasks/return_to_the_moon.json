			"dialogs": [
				{
					"id": 60280201,
					"content": "C'est ici que les habitants de l'Hyperborée communiquaient avec les lunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280202,
					"content": "Lune éternelle, Lune de givre, Lune irisée... Quand leurs trois pouvoirs convergent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "Le portail des lunes s'ouvrira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280204,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "Les essences lunaires sont en position. Il ne reste plus que la dernière étape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280206,
					"content": "... Je suis sûre que le Village de Nasha n'a jamais été aussi animé qu'en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280207,
					"content": "Oui... C'est dommage que vous n'aviez pas pu être là. Mais c'est le moment ou jamais, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "Ce n'est pas grave. C'est le dernier bagage que j'emporte avec moi... Mon seul bagage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280210,
					"content": "Je peux déjà sentir la lune m'appeler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280212,
					"content": "Ce rayon de lumière te guidera vers chez toi, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280213,
					"content": "À partir de maintenant, nous aurons une raison de prier la véritable lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280216,
					"content": "Revenez nous voir dès que vous le pouvez !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Ah... Évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280218,
					"content": "Mais si ça n'arrive pas... N'oubliez pas que vous avez des amis sur cette planète à qui vous manquerez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Oui. Merci pour tout ce que vous avez fait pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280220,
					"content": "Vous non plus, n'oubliez pas... que le clair de lune nous unit, de jour comme de nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280221,
					"content": "#Bon... Je vous dis adieu, mes {M#amis}{F#amies}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
