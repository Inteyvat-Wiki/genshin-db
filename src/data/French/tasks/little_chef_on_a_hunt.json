			"dialogs": [
				{
					"id": 110000401,
					"content": "Ces sangliers ont l'air en bonne santé. Je parie que leur viande est très goûteuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000402,
					"content": "Ah, j'en ai l'eau à la bouche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Waouh ! Génial ! Je vais pouvoir sauter cette viande et la frire avec des champignons. Ah, je me demande si on pourrait la manger avec de la bave de Blob...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "Ça y est, on l'a perdue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "#Je crois qu'elle nous a {M#oubliés}{F#oubliées}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Ah, pardon ! Je me suis un peu trop emballée avec mes idées de recettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Comme je te l'ai promis, prends ce petit encas. Dis-moi ce que tu en penses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "#On est tes {M#goûteurs}{F#goûteuses} maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "MAIS C'EST TROP BON !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Tu peux nous donner la recette ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Bien sûr ! Mais je ne l'ai pas encore écrite pour l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "#Ah, je sais ! Je vais refaire la préparation, alors soyez {M#attentifs}{F#attentives}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "Ce plat est assez compliqué, alors il faudra du temps pour maîtriser sa recette. Sans compter le fait, qu'on n'a ni de poêle ni de condiments ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Ça ne va pas être simple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "On peut se servir d'une dalle en pierre et de graisse de sanglier pour cuisiner, puis on allumera un feu avec des branches et des herbes sèches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Quant au sucre et au sel, des fleurs sucrantes et des pierres de sel que j'ai trouvées dans une grotte l'autre jour devraient faire l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "On dirait qu'elle est habituée à ce genre de situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Héhé ! Je fonce toujours dès que j'ai l'occasion d'essayer un truc ! Dommage que je ne puisse pas emmener ma cuisine entière avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Juste une seconde, que je finisse de tout installer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "Hé ! Qu'est-ce que vous faites ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 110000601,
					"content": "Vous ne pouvez pas chasser les sangliers dans leur habitat naturel ! Vous allez tous les faire fuir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 110000602,
					"content": "Un chasseur préserve la nature qui le nourrit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 110000603,
					"content": "Ahhh ! Je comprends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "La meilleure viande provient des sangliers à l'état sauvage ! S'ils venaient à tous s'enfuir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "Ça serait un désastre pour la gastronomie... Non, pour l'humanité entière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "Hum, c'est une façon de le voir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Je suis désolée ! Je ne savais pas que ça causerait des problèmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "Si tu veux t'excuser, c'est auprès de Draff qu'il faut le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 110000610,
					"content": "C'est le chef des chasseurs du coin. Il met toujours un point d'honneur à respecter les règles de chasse, et ce que tu viens de faire l'a mis en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 110000611,
					"content": "Qu'est-ce qu'on fait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "Tu as raison. Il faut que je m'excuse pour mon erreur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000614,
					"content": "On t'accompagne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000615
					]
				},
				{
					"id": 110000615,
					"content": "Oh, merci ! Je vous cuisinerai plein de plats après ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000616,
					"content": "D'accord ~ C'est toi qui l'as dit ! Je m'en rappellerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000617,
					"content": "Draff est sûrement à Deauclaire. En route !",
