			"dialogs": [
				{
					"id": 240040401,
					"content": "#Argh, vous m'avez trouvée... Hmm, mais qui êtes-vous{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "#{M#Un ami}{F#Une amie} de Verut et Aurèle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "#Oh ! Ils m'ont parlé de vous... Verut disait que vous étiez vraiment {M#fort}{F#forte} à ce jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "#Eh bien, on dirait qu'il avait raison... Vous êtes vraiment {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
					"content": "Vous m'avez eue, je n'ai plus qu'à retourner au point de rassemblement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
