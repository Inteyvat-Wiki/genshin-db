			"dialogs": [
				{
					"id": 240040201,
					"content": "... J'ai l'impression d'avoir déjà lu cette page.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040202,
					"content": "En train de lire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Hmm... Je ne m'attendais pas à ce que vous me trouviez si rapidement, je venais seulement de commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040205,
					"content": "Le père de Lovi m'a prêté ce livre. Il a dit que je pouvais lui demander si j'avais des questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040206,
					"content": "Mais pour être franc... Il n'y a pas grand-chose qui n'en soulève pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040207,
					"content": "Enfin, je vais rentrer au point de rassemblement. Après tout, vous m'avez trouvé, et il faut respecter les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040203,
					"content": "Tu aimes te cultiver, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
