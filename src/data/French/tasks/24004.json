				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Vite, cachons-nous ici. Je parie que c'est une meilleure cachette que la sienne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Hé, Verut, reviens ! Si tu te perds, je ne pourrai peut-être pas te retrouver si facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040103,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "Hé ! Vous avez le temps de jouer maintenant ? Vite, cachez-vous avec nous ! Lovi a sûrement déjà trouvé sa cachette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "À propos de Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Pas le temps de discuter. Dépêchez-vous. Elle connaît très bien cet endroit... On doit trouver une meilleure cachette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut part en courant...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*soupir* Quand va-t-il écouter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040110,
					"content": "Désolé, mais je vais devoir vous demander de refaire une partie avec nous. Je ne sais pas pourquoi, mais Verut est très excité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040111,
					"content": "C'est peut-être parce qu'il s'est fait une nouvelle amie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "C'est ce que je pense aussi. Tant qu'il est heureux, tout va bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040113,
					"content": "Espérons simplement qu'il ne s'excite pas trop et qu'il suive Lovi pour se cacher dans un endroit étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040118,
					"content": "Désolé, mais rejouez avec nous, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040119,
					"content": "Je dois trouver une cachette. Sinon, Verut ne sera pas content. Et s'il commençait à pleurer dans la rue, je ne saurais vraiment pas quoi faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040120,
					"content": "Aurèle part se cacher...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "À propos de Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "C'est une fille qu'on vient de rencontrer. Elle nous a vus jouer à cache-cache et a insisté pour jouer avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040116,
					"content": "Elle a la même personnalité que Verut, donc ils s'entendent bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040117,
					"content": "Son père n'a pas l'air d'avoir beaucoup le temps de jouer avec elle, donc on a au moins ça en commun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040104,
					"content": "Vous jouez encore à cache-cache ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
