			"dialogs": [
				{
					"id": 240040501,
					"content": "Pourquoi vous me regardez comme ça, tous les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040502,
					"content": "Tu t'es caché quelque part pour lire, hein ? Tu n'as pas joué le jeu sérieusement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Ouais ! Avoue-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Vous aviez pris les bonnes cachettes, et je ne suis pas doué pour jouer à cache-cache... Je me suis donc dit que j'allais lire pour passer le temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040505,
					"content": "Vilain menteur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Mange-livres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Franchement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040508,
					"content": "Allez, laissez-le tranquille tous les deux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Haha, Lovi est très douée pour jouer à cache-cache. Elle connaît beaucoup de bonnes cachettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Haha, cet endroit est vraiment chouette quand Lovi est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Et Verut est très rapide pour grimper aux murs, et il est très fort. Il m'a bien aidé plusieurs fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "Quand on est ensemble, il n'y a que vous qui puissiez nous trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Bon, je pense que c'est tout pour la journée. On va te ramener à la maison, Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040514,
					"content": "Comme ça tu peux poser des questions à mon père, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040515
					],
					"speakerTitle": "Lovi"
				},
