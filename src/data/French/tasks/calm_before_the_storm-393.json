			"dialogs": [
				{
					"id": 3930101,
					"content": "Je chanterai nos aventures une fois que tout sera terminé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930102,
					"content": "Nous avons vécu tant de choses en si peu de temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "C'est ça... Et tout comme la légende de Vennessa, cette ballade sera chantée par-delà les générations de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930105,
					"content": "J'aime cette chanson depuis toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930106,
					"content": "#Comment se sent-on aujourd'hui, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930107,
					"content": "Moi, je me sens au plus haut de ma forme. Prête à aider tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930108,
					"content": "On peut vraiment compter sur vous, Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "Puisqu'on en parle, maître Diluc nous a accompagnés jusqu'au bout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930111,
					"content": "Alors que tout ça est... arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930112,
					"content": "Par accident...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930113,
					"content": "Vous avez partagé votre secret avec moi, et je vous suis redevable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3930114,
					"content": "C'est donc la confiance qui explique la présence de maître Diluc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "Quant à Jean, je pense que c'est le sens des responsabilités ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930116,
					"content": "Bon... Et le barde de pacotille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930121,
					"content": "C'est la liberté, naturellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930122,
					"content": "Liberté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930123,
					"content": "Vous a-t-on dit à votre arrivée que Mondstadt était la « cité de la liberté » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930124,
					"content": "Oui... Amber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "Hahaha ! Une vraie Mondstadtoise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930126,
					"content": "Mondstadt est une agréable cité-état, qui n'est pas gouvernée par un autocrate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930127,
					"content": "Quant aux gens de Mondstadt, ils jouissent du plus de liberté parmi les Sept Nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930128,
					"content": "J'espère juste que le dragon qui l'a protégée sera lui aussi bientôt libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930129,
					"content": "Personne n'aurait dû le tromper, et lui dire que cette ville l'avait renié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930130,
					"content": "Personne n'aurait non plus dû lui dire que protéger Mondstadt était son éternel devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930131,
					"content": "Il a aussi le droit de faire sa propre vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930132,
					"content": "Venti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930133,
					"content": "#{NICKNAME}, que les vents millénaires qui soufflent sur Mondstadt t'accompagnent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930134,
					"content": "Je vais invoquer le pouvoir Anémo en toi, comme la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930135,
					"content": "... Comme la dernière fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#Oh, je vois ! {NICKNAME} avait bien dit que ta voix lui était familière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930136,
					"content": "Je le savais ! Cette voix, c'était toi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "C'est le sens des responsabilités qui a conduit Jean ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "Quant à maître Diluc, je pense que c'est la confiance qu'il nous accorde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930119,
					"content": "Bon... Et le barde de pacotille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930120,
					"content": "Et Venti ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "Pas de souci ! Je me sens super bien, moi aussi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "Oui, à ce stade on est presque des frères d'armes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
