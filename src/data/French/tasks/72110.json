	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Pourquoi ai-je quitté le dojo pour devenir le maître du seigneur Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100102,
					"content": "Yanagiha et Okazaki, ainsi que Mifune... Pourquoi m'ont-ils tous laissé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "... À présent, il ne nous manque que la lame d'Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "L'ancestral « Hakuen Michimitsu d'Amenoma » du Clan Iwakura ? ... Dis, tu te rappelles quand Kunihiko et toi l'avez touché pour la première fois, pendant que le maître Eiin ne regardait pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "On a été expulsés. Ce n'est plus la peine de l'appeler « maître » à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Mais, Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "« Lorsque l'affection et la justice sont en balance, un vrai épéiste se doit de marcher sur la voie de la justice. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Ce sont les mots du maître, ce qui signifie qu'il était réticent à nous expulser mais qu'il n'avait pas le choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Bien sûr que ce n'est pas ce qu'il voulait. Mais puisqu'il a décidé de devenir l'épée de la Shogun et d'exécuter le décret de saisie, nous ne pouvons que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Nous ne pouvons que choisir notre propre voie. Après tout, « un vrai épéiste se doit de marcher sur la voie de la justice. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Et pourtant, la justice du maître a été vaincue au final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "C'est vrai. Nous devons les venger. Kunihiko, les autres, et même Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Telle est la justice des disciples expulsés que nous sommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "#Ce doit être une bénédiction du maître. Notre premier objet de vengeance se présente à nous {M#de lui}{F#d'elle}-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Ah, on dirait que tu as raison. Vous devez être {NICKNAME}, n'est-ce pas ? J'ai entendu parler de votre histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "#Dans le monde des épéistes, le sang appelle le sang. Je suppose que vous êtes {M#prêt}{F#prête} à affronter les anciens Menkyo Kaiden de l'École Iwakura ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Pourquoi ai-je quitté le dojo pour devenir le maître du seigneur Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100302,
					"content": "Yanagiha et Okazaki, ainsi que Mifune... Pourquoi m'ont-ils tous laissé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100303,
					"content": "J'ai déjà rencontré les disciples de l'École Iwakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100305,
					"content": "Il y a encore des gens pour se revendiquer de l'École Iwakura ? Après tout, leur maître a été si incompétent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100306,
					"content": "Je suis Iwakura Kouzou. Vous pouvez me considérer comme un maître d'épée. Et qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100307,
					"content": "#Je suis {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tamba... vous les avez vus ? Et les frères Okazaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100309,
					"content": "Ah, oui, il y a aussi Katayama. Il aimait toujours trouver des noms pour les duels avant de commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100310,
					"content": "Il aurait dit : « Si je deviens un vrai maître épéiste un jour, alors tous ces duels pourraient devenir des histoires. » Hahaha, c'est absurde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100311,
					"content": "Exact, et il ne faut pas oublier Shimada, qui a passé toutes les phases de formation « Eiin » et « Kouin », mais n'a jamais pu avancer au-delà du rang de Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100312,
					"content": "Ils ont dû fuir et sont devenus des bandits parce qu'ils ne pouvaient pas s'imaginer la puissance du décret de saisie de la Shogun toute-puissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100313,
					"content": "Je regrette le bon vieux temps où je leur apprenais à manier une épée. Pourquoi diable ai-je fermé le dojo et rejoint l'armée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, que valent-ils au combat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100315,
					"content": "#Je suis {M#désolé}{F#désolée} de dire ça, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100318,
					"content": "#Alors, {NICKNAME}, qui est votre maître ? Est-ce Domon ? Ou Shousen ? Ou peut-être Narukami elle-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100319,
					"content": "#Je pense que je peux être {M#considéré}{F#considérée} comme « autodidacte ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100321,
					"content": "#On dirait que l'École Iwakura s'est affaiblie sous mes ordres. Aucun de mes disciples n'a réussi à vaincre {M#un}{F#une} épéiste autodidacte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Est-ce vraiment le cas ? Je comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100324,
					"content": "Quelle que soit votre dojo, ça n'a pas d'importance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100325,
					"content": "Il semble que l'École Iwakura se soit affaiblie sous ma responsabilité. Aucun de mes élèves n'a réussi à vaincre quelqu'un qui ne veut pas révéler le nom de son dojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100326,
					"content": "Je suis vraiment un maître incompétent pour l'École Iwakura. En tant qu'épéiste, on m'appelle Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100327,
					"content": "Bien que j'aie oublié la clé de notre technique secrète et que mon œil divin ait été confisqué par la Shogun toute-puissante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100328,
					"content": "... Si vous me demandiez si je souhaite venger mes disciples qui n'ont pas supporté de me voir décliner et ont fini par devenir des fantômes torturés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100329,
					"content": "... Incapables de gagner face à vous. Eh bien oui, j'ai toujours cette flamme en moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100330,
					"content": "Ce n'est pas assez dégagé ici, j'ai peur qu'il soit difficile pour vous d'exécuter vos techniques d'épée. Venez avec moi en bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100316,
					"content": "J'ai appris beaucoup en les combattant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
	]
}