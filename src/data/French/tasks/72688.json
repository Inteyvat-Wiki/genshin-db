			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "Je continuerai d'attendre ici pendant les prochains jours pour attirer les visiteurs du Festival Irodori et leur faire connaître les merveilles des cours fleuries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "N'oubliez pas qu'un thème floral sera dévoilé chaque jour. Il y en aura quatre au total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "Évidemment, si vous avez des questions, je me ferai une joie d'y répondre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "À propos des compositions florales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Toutes les fleurs que j'utilise proviennent de la boutique « Aux jardins de Sakuya ». Leur qualité est exceptionnelle et elles sont vendues à un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "Peut-être que vous avez déjà entendu parler de Sakuya, on a étudié toutes les deux l'ikebana auprès du même professeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "Sakuya possède une formidable expertise de cet art, mais quand je lui ai dit qu'il y aurait beaucoup de visiteurs lors du Festival Irodori, elle s'est sentie quelque peu nerveuse et m'a dit ne pas pouvoir travailler avec autant de monde autour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "Voilà pourquoi j'assure aussi la promotion de sa boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "On peut vous aider si vous voulez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "Avez-vous d'autres questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "Merci, mademoiselle Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Je vous en prie. N'hésitez pas à venir me voir quand vous avez le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "À propos de la Commission culturelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "La Commission culturelle a toujours soutenu l'ikebana d'Inazuma. C'est la Shirasagi Himegimi qui a d'ailleurs financé cet événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "Elle fait preuve d'un talent surprenant dans ce domaine. J'ai déjà assisté à une de ses démonstrations d'ikebana et j'ai même eu le plaisir de parler avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Je suis son aînée, mais je ne peux pas rivaliser avec sa technique ou ses connaissances de l'ikebana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Lorsque la situation le permet, la Shirasagi Himegimi alloue des fonds pour promouvoir notre art. On raconte même qu'il lui arrive de financer ces activités de sa propre poche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "Elle avait ouvertement déclaré son souhait de rendre l'ikebana populaire, que les gens s'y intéressent et l'étudient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Ayaka a tant fait pour l'ikebana à Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "J'espère que son souhait se réalisera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "#Merci {M#tous}{F#toutes} les deux, c'est gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "Pas pour l'instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "N'hésitez pas à venir me voir quand vous avez le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
