			"dialogs": [
				{
					"id": 726880101,
					"content": "Comme on se revoit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880102,
					"content": "Votre cour fleurie de la dernière fois était superbe. Vous avez saisi très rapidement l'essence de l'ikebana, ce qui est la preuve d'un talent extraordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880103,
					"content": "Le nouveau thème floral vous attend à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880104,
					"content": "Commençons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "#On est {M#prêts}{F#prêtes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726880106,
					"content": "Les étincelles dans vos yeux ressemblent presque à une mer de fleurs radieuses. Que c'est beau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880107,
					"content": "Bref, le thème d'aujourd'hui est un peu plus difficile que celui de la dernière fois. Ce sera idéal pour perfectionner votre technique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880108,
					"content": "« Soyeux et robuste, le lotus dans l'étang ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880109,
					"content": "Réfléchissez au sens de ce thème et sélectionnez vos fleurs avec attention pour créer votre cour fleurie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880110,
					"content": "J'ai autre chose à faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "Je comprends. Il est vrai que l'ikebana requiert votre attention totale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880112,
					"content": "Une fois que vous aurez terminé vos tâches et serez libres de toute distraction, votre cour fleurie n'en sera que plus réussie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
