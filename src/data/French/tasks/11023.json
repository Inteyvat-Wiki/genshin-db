	"talks": [
		{
			"id": 1102303,
			"completionStepIds": [
				1102303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102303",
							"2"
						],
						"stepId": 1102303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Regardez. C'est à moitié rempli de sel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230302,
					"content": "Ça n'est sûrement qu'une salière. On dirait bien que la Déesse du Sel était une déité pauvre en trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230303,
					"content": "D'après mes connaissances, cet objet n'est pas si ordinaire. Il n'est rempli qu'à moitié, mais pour l'éternité. Autrement dit, il ne peut pas se vider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230304,
					"content": "Comment ? Vous voulez dire que si je verse du sel à l'extérieur, l'intérieur contient toujours autant de sel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230305,
					"content": "Absolument.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230306,
					"content": "Pouvoir produire du sel à l'infini... La Déesse du Sel avait de puissants pouvoirs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230307,
					"content": "Enfin, après tous ces déboires, un trésor qui en vaille la peine ! Je le prends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230308,
					"content": "Tout ce qu'il me reste à faire, c'est remplir des sacs de sel, des milliers de sacs de sel... Je vais me faire une fortune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230309,
					"content": "Hé là ! Comment pouvez-vous avoir aussi peu de respect envers une relique de la Déesse du Sel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230310,
					"content": "Rappelez-vous que si cet objet revient à sieur Kliment, le prochain que nous trouverons reviendra à dame Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230311,
					"content": "Oui, oui, bien sûr. Héhé, qu'est-ce qu'on pourrait trouver de mieux que ce petit trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230312,
					"content": "Soit, puisque nous avons un contrat, je ne vais pas discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230313,
					"content": "Bien. Continuons, si vous le voulez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Tsss, rien qu'un mètre. Pas l'air de valoir grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230502,
					"content": "C'est... Si mes souvenirs sont bons, il s'agit d'un outil servant à mesurer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230503,
					"content": "Vous ne vous trompez pas. Mais la Déesse du Sel y a infusé son pouvoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230504,
					"content": "Plantez cet objet dans le sol, et la zone environnante sera recouverte de sel, de la même manière que la marée montante recouvre la terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230505,
					"content": "Plus profond vous l'enfoncez, et plus vous obtenez de sel. C'est en quelque sorte une machine à récolter le sel à grande échelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230506,
					"content": "M—Mais... C'est mille fois mieux qu'une salière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230507,
					"content": "Bien, d'après les termes du contrat qui vous unit, ce mètre revient à dame Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230508,
					"content": "Non ! C'est inacceptable ! En quel honneur le meilleur trésor ne me reviendrait pas ? C'est moi qui vous ai embauché, c'est moi qui ai monté cette expédition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230509,
					"content": "Et cette fille a été inutile du début à la fin, qui plus est. Pourquoi aurait-elle droit à quoi que ce soit ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230510,
					"content": "Et le voilà qui recommence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230511,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "Ainsi donc vous voulez revenir sur votre part du contrat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230514,
					"content": "Et alors ? Maintenant que j'ai vu comment fonctionnait les mécanismes de ces ruines, je n'ai plus besoin de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230515,
					"content": "N'oublions pas qui travaille pour qui. En quel honneur devrais-je respecter VOS règles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230516,
					"content": "Vous avez établi un contrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230517,
					"content": "Comme l'a dit l'Archon Géo : « Celui qui ne respecte pas un contrat mérite la punition de la roche. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230518,
					"content": "C'est un dieu de Liyue. Je suis de Snezhnaya moi, et je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230519,
					"content": "... et vous allez connaître la punition de la roche. Ce n'est guère plaisant, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230512,
					"content": "C'est l'hôpital qui se moque de la charité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Quant à votre trésor, je le confisque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "Vous n'êtes plus dignes d'avancer plus avant. Partez maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Satané... Espèce de... Vous allez voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "Une expédition archéologique qu'il disait... Tu parles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "On avait des doutes sur lui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "C'est vrai, heureusement que je peux repérer un menteur à dix lieues à la ronde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "Les erreurs de Kliment sont causées par sa cupidité, c'est exact. Mais ce n'est pas la seule raison qui peut pousser quelqu'un à ne pas respecter un contrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "Combien sont capables de contrôler leurs instincts devant l'objet de leur désir et de continuer d'agir d'après les termes d'un contrat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "J'imagine que le moment est bien choisi pour arrêter la comédie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Hein ? Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "Personne dans cette « expédition » n'est là pour l'archéologie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "Que... Que voulez-vous dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "Vous, jeune fille, n'avez pas la moindre connaissance de base dans le domaine, et n'êtes capable que de reconnaître quelques pièces. Mais vous vous révélez en revanche étonnamment perspicace dès qu'il s'agit de la Déesse du Sel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "Vous n'avez aucun intérêt ni en archéologie ni dans les reliques. Ce qui vous intéresse vraiment, c'est la Déesse du Sel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "Les légendes de la Déesse du Sel dont vous nous avez parlé à bord de la Pagode Irisée sont, à ma connaissance, passées de génération en génération au sein de la Chambre Yinyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Je... Assez, assez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "... Je vois que vous êtes, comme je m'en doutais, un homme d'une grande perspicacité. Je ne regrette pas d'avoir eu le courage de venir vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "Vous avez raison, je n'ai rien d'une érudite en archéologie. Je suis l'envoyée de l'une des Huit Corporations de Liyue sous la jurisdiction des Sept Étoiles, la Chambre Yinyuan de l'industrie du sel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Les hommes et les femmes protégés il y a si longtemps par la Déesse du Sel des ravages de la Guerre des Archons étaient nos ancêtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "C'est vrai que vous n'avez jamais dit « Souverain de la Roche »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Tu as raison, tiens. Les Liyuéens utilisent rarement le nom « Morax »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "Morax a tué notre déesse parce qu'il enviait sa puissance ! Il a laissé mon peuple complètement seul et sans nul part où se réfugier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "Nous... Nous le haïssons tous ! Mais Liyue lui appartient, après tout. C'est lui qui écrit l'histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "C'est pour ces raisons que je cherche des preuves ! Morax n'est pas parfait, il a du sang sur les mains ! Il n'est pas celui qu'il prétend être !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "Nous avons passé un marché, sieur Zhongli, n'est-ce pas ? Votre avis doit être objectif d'après notre contrat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Absolument. Mais je me dois d'ajouter... Liyue n'appartient plus à Morax dorénavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Suivez-moi, les réponses que vous cherchez vous attendent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "C'est vrai que vous n'avez jamais dit « Archon Géo »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "J'espère que tu ne deviendras jamais aussi cupide, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Hé, j'aime les moras, mais ça veut pas dire que je suis du mauvais côté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "C'est... une épée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "Ah ! Une épée brisée, une preuve ! La Déesse a dû se défendre contre les attaques sans pitié de Morax ! Mais elle a été vaincue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "Le pouvoir contenu par cette épée doit sûrement être bien supérieur à celui d'une salière ou d'un mètre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "Si on répare cette épée, alors nous pourrons montrer au monde entier la vraie puissance de la Déesse du Sel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Hum... C'est vrai qu'on dirait une épée perdue au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Deux bris d'épée. D'un point de vue strictement archéologique, il s'agit là de deux reliques. D'après notre accord, vous ne pouvez en prendre qu'une seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "C—Comment ? Nous étions d'accord pour alterner, mais Kliment n'est plus ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Effectivement. Cela n'empêche pas notre accord d'être toujours valable. Vous ne pouvez pas prendre les deux morceaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "C'est... C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Euh... Zhongli, elle n'a pas l'air d'avoir de mauvaises intentions, et personne d'autre n'est vraiment intéressé par ce trésor... Pourquoi ne pas lui laisser, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "Un contrat ne peut être rompu. C'est ce dont se rend coupable celui qui ne le respecte pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "Non ! Si je n'en prend qu'une moitié, alors il sera impossible de réparer l'épée ! Et impossible de ressusciter le pouvoir de la Déesse du Sel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "Je dois garder foi en elle, quoi qu'il arrive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Quand bien même cela rompt notre contrat, je l'accepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "Vous avez pris votre décision ? Tout a un prix, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "En d'autres termes, c'est la punition de la roche qui vous attend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "Tant... tant pis, qu'il en soit ainsi. La Déesse du Sel a sacrifié sa vie pour mon peuple. Mon sacrifice n'est rien en comparaison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Punissez-moi comme vous le souhaitez. Je repartirai avec cette preuve de la foi de mon peuple !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "On ne tape pas les filles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "... Ce châtiment serait peut-être une délivrance, en comparaison de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "Soit. Mais je vais te dire la vérité. Ce sera là ta punition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "« La vérité » ? La vérité est ma punition pour avoir rompu le contrat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Oui. Ce que vous allez entendre à présent sera votre prix à payer pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "... Je crains de ne devoir vous dire qu'Havria, la Déesse du Sel, n'était pas la puissante déité que vous imaginez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Plutôt l'opposé, en réalité. Un dieu faible et vain, criant toujours après les autres dieux. Elle n'a jamais réussi à gagner une place parmi les Sept Archons. Rien d'un modèle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "C—Comment osez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "Tandis que la Guerre des Archons faisait rage, les dieux peuplant alors ce monde déployèrent tous leurs efforts pour s'emparer de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "Mais Havria choisit la fuite. Abandonner avant que le combat n'éclate lui permettrait de se sauver, et son peuple à sa suite – ou du moins c'est ce qu'elle pensait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "Mais dans une guerre si longue et si terrible, on se fait toujours rattraper. Vient un moment où la fuite n'est plus une option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "Concession après concession, le territoire de la Déesse du Sel se rapetissa, jusqu'à ce qu'il ne reste plus qu'un minuscule refuge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "Non... Non... C'est impossible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "Jusqu'à ses derniers instants, elle ne leva pas une seule fois l'épée pour défendre le peuple qui l'avait suivie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "Pas une seule fois levé l'épée ? Mais cette arme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "Oui. Cette arme n'appartenait pas à la Déesse du Sel. C'est l'arme qui la tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "L'arme qui la tua...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "Non ! Je refuse de vous croire ! C'est impossible, c'est... un test de ma foi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "Je vous l'avais dit. Rien que la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "Cette histoire n'a pas une once de vérité ! Vous... Vous êtes un servant de Morax et vous ne m'aurez pas aussi facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "Hé, revenez ! Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "Le choc était trop grand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "C'est un châtiment approprié. Je n'avais pas l'intention de lui dire la vérité, mais elle a rompu le contrat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Continuons, si vous voulez bien. Je crains que plus loin ne nous attende quelque chose qui ne lui laissera pas d'autre choix que d'accepter la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "Alors, c'était... vraiment vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "En effet. Sinon, quelle aurait été la valeur de cette punition ? Je n'avais pas l'intention de lui dire la vérité, mais elle a rompu le contrat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102310,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
