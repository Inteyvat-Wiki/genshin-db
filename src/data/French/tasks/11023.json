						],
						"stepId": 1102310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "... Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231132,
					"content": "Qu'est-ce qu'ils ont vu... Ou fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231133,
					"content": "... Qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231134,
					"content": "Avançons, puisque vous refusez de me croire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231135,
					"content": "Tout ce qui s'est passé alors repose derrière cette porte, intouché depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102311,
			"completionStepIds": [
				1102311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102311",
							"2"
						],
						"stepId": 1102311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "Regardez la scène du crime. Les vestiges du corps d'Havria ont disparu pour laisser la place à quelques traces de sel. Ses derniers instants ont été conservés jusqu'à ce jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "L'histoire continue... Parmi son peuple, certains commencèrent à réaliser que cette déité, malgré son bon cœur, était trop faible pour pouvoir les protéger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "La Guerre des Archons fut une guerre d'une cruauté inégalée. Il fut jugé qu'une mort rapide serait plus charitable que l'agonie de la défaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "Mais... Et ces espèces de statues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "L'énergie libérée par un dieu, aussi faible soit-il, lors de sa fin est extrêmement puissante. Trop puissante pour l'homme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Tous ceux qui ne réussirent pas à fuir ce lieu finirent ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "Les survivants fuirent à Liyue, où ils cherchèrent refuge auprès du Souverain de la Roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "Leurs descendants vécurent dans la peur des vestiges laissés par Havria, terrifiés à l'idée qu'ils portent quelque malédiction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "C'est pourquoi ils risquèrent leur vie pour venir ici briser l'épée et faire des offrandes, dans l'espoir que sa colère puisse être apaisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "Mais ces efforts étaient inutiles. Comment un dieu qui n'avait jamais résisté de sa vie, même à l'ultime moment, aurait pu nourrir à leur égard les intentions qu'ils imaginaient ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "Je... Je... Même si ce que vous dites est vrai, je refuse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "C'est un mensonge... Une farce, une histoire... Tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Ne testez pas... ma foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Zhongli... Quel cœur de pierre cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "C'est le prix qu'elle devra payer. Mais... Ce n'est pas nécessairement une mauvaise chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "D'après ce que mes yeux me disent, il lui faudra encore un moment pour absorber le choc... Mais même si ça prend du temps, elle finira par accepter la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "Vous êtes bien au courant de ce qui est arrivé à cette déesse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "En effet. Il y a de cela bien, bien longtemps, l'histoire d'Havria me servit d'avertissement à moi aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "Croire en un dieu qui n'est plus ne résulte jamais en rien de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "... Et cela est valable aussi bien pour Havria que pour Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "Un jour, les Liyuéens le comprendront eux aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Bien. Que dites-vous de m'accompagner à la Forêt de pierre de Guyun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231128,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Parcourir ces terres d'histoire, raconter le passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "Il est parfois difficile de ne pas penser aux amis d'antan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "Votre connaissance du sceau n'était pas due qu'aux rumeurs, je me trompe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "Quel esprit acéré. En effet... Disons que j'ai vécu longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}