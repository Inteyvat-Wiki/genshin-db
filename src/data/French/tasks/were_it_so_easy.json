				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Oh, c'est {NICKNAME} et Paimon, les pourvoyeurs de fleurs venues d'ailleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Bonjour, Cosanzeana. Est-ce que les fleurs qu'on vous a amenées poussent correctement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Euh... Je ne les ai pas regardées de la journée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Ah ? Vous ne les aimez pas ? Pourquoi n'êtes-vous pas allée les voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Ça a été vraiment difficile pour moi d'en avoir, donc je veux vraiment m'en occuper... Mais quand je pense qu'elles pourraient faner sous mes yeux, je... J'ai peur d'aller les voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "Waouh, vous vous en faites vraiment pour ces fleurs... Pourquoi n'irions-nous pas les voir ensemble ? Comme ça, si quelque chose de mal se passe, nous serons là pour vous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Ça ne sert à rien de trop s'en faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "Vous avez raison... Allons-y ensemble ! Avec votre aide, je sens qu'on peut y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
