						],
						"stepId": 7404908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#Incroyable, {NICKNAME} ! Vous avez transformé ces affreux mécanismes en jolis composants en un seul claquement de doigts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Eh bien, ils ne vous embêteront pas de sitôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Certaines des fleurs ont été endommagées, mais le reste a toujours l'air en bon état. Les Primus briseurs ne reviendront plus abîmer votre jardin, donc vos fleurs peuvent maintenant pousser et devenir fortes et saines !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "C'est super... Mais j'ai bien appris ma leçon. Désormais, je dois mieux prendre soin de ces précieuses fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}, Paimon... Vous m'avez apporté des fleurs si exotiques, et vous m'avez même aidée à défendre mon jardin. Comment pourrais-je vous remercier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Il n'est pas nécessaire d'être aussi polie, vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "#Ah, oui, je sais ! J'ai cueilli ces fleurs moi-même, elles me sont très précieuses{NON_BREAK_SPACE}! Puis-je vous les offrir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Oh ! Si ces fleurs sont vraiment si précieuses, tu devrais peut-être commencer ton propre jardin floral et l'y planter, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Seraient-ce des maréalgues ? Est-ce que ça compte comme des fleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Les maréalgues sont des plantes, et elles sont très belles, donc bien sûr que ce sont des fleurs. C'est ce que les humains appellent la « biologie ». J'ai passé du temps à l'étudier afin de pouvoir devenir une grande fleuriste à l'avenir. Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "J'ai l'impression qu'il y a quelque chose qui ne colle pas, mais ce n'est pas comme si j'en savais énormément sur la taxonomie des plantes non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Je vais continuer à travailler dur pour atteindre cet objectif. J'ai entendu des humains dire que d'excellents fleuristes sont capables de créer de nouveaux types de fleurs, qu'ils peuvent ensuite apporter à des « foires horticoles ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "J'ai très envie de faire ça, et j'espère gagner des prix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Eh bien, c'est très ambitieux et tout, mais j'ai le sentiment qu'il y a encore des malentendus qui ne sont pas faciles à expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "Le but de participer à une foire horticole est d'apporter les nouvelles variétés de plantes qu'elle a créées et de les faire apprécier par les humains, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Le fait est que ses sens et son esthétique sont peut-être un peu trop différents de ceux des humains... Tu penses que les humains pourraient trouver bizarres les fleurs qu'elle cultive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Je vois que tu t'investis dans sa carrière d'horticultrice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Bien sûr ! Je suis son enseignante, après tout. Si elle gagne, c'est tout bénéfice pour moi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Il ne faut pas avoir les yeux rivés sur les récompenses, l'important est d'être satisfaite de votre travail.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "C'est vrai, oui. La seule personne qui doit trouver vos fleurs jolies, c'est vous-même ! Vous ne devez pas trop vous focaliser sur ce que les autres pensent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Vous devez juste prendre soin de votre jardin, profiter de vos jolies fleurs et être heureuse toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Oui ! Je vais faire en sorte qu'elles deviennent saines et fortes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Vous avez fait le premier pas vers le succès.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "C'est vrai. Les variétés qu'elle va cultiver seront sans doute uniques, mais certaines personnes ne manqueront pas d'apprécier ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "Lorsque vous aurez cultivé vos variétés uniques, n'oubliez pas de nous le dire en premier, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "Bien sûr ! Vous m'avez beaucoup aidée, c'est normal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
