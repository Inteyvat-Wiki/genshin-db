					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "*sniff* Mes précieuses fleurs... Elles ont été détruites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Quel dommage... Donc si vos fleurs ne poussent pas, c'est à cause des dégâts provoqués par les Primus briseurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "Dorénavant, je vais monter la garde près de mes fleurs et ne plus jamais les quitter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Attendez, calmez-vous un instant, Cosanzeana. Essayons de trouver une solution ensemble. Déjà, pourquoi les Primus briseurs endommagent votre jardin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "Quand vous aviez ramené d'autres fleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "Jamais, non ! Pff, ces brigands n'osent agir que quand je ne suis pas là. Grr, je suis hors de moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Waouh... Je ne me doutais pas que Cosanzeana avait ça en elle. Elle doit vraiment tenir à ces fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Mais quand on y pense, ce n'est pas comme si les Primus briseurs s'étaient enfuis en voyant Cosanzeana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Peut-être que ce ne sont pas les fleurs qui les ont attirés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "C'est possible. Faisons un tour, on va peut-être trouver quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "Est-ce que les Primus briseurs les ont aussi endommagées ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
