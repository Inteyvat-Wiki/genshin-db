	"talks": [
		{
			"id": 7404901,
			"completionStepIds": [
				7404902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7404902",
							"2"
						],
						"stepId": 7404902,
						"stateName": "QUEST_STATE_UNFINISHED"
