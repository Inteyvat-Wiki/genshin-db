				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Hé, mais c'est Yoimiya. Entrez, installez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "#Ce sont tes {M#amis}{F#amies} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "#Oui, ce sont des {M#voyageurs venus}{F#voyageuses venues} de loin. Les étrangers ont du mal à entrer à Inazuma de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "#Les temps qui courent sont sans précédent. Mais vu tout le chemin qu'{M#ils}{F#elles} ont parcouru, nous devons faire preuve d'autant plus d'hospitalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Mm-hmm. Oh, avant que j'oublie, j'ai apporté les feux d'artifice que vous aviez commandés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Oh, merci, ma chère. On embête ta famille avec ça tous les ans. D'abord ton père, et maintenant toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Je me demande si je verrai le prochain héritier des Feux de Naganohara de mon vivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Bien sûr que vous le verrez, vous êtes tous les deux en excellente santé ! Ne dites pas des choses comme ça, ça porte malchance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "*soupir* Nous ne sommes pas aussi jeunes qu'avant. Notre corps nous le fait sentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Autrefois, je pouvais passer toute la journée à travailler la terre, à transporter de l'eau dans les deux sens, mais maintenant, même un moment de travail léger me laisse avec toutes sortes de maux et de douleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Hier, j'ai voulu désherber, mais à peine je me suis penchée, que j'ai senti que je ne pourrais pas me redresser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "Aucun problème. N'en dites pas plus, on s'en occupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "Oh non, non, non. Comment puis-je faire travailler une invitée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Je vais chercher du thé et des petits gâteaux, et on pourra continuer à discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "C'est bon, ce n'est pas comme si c'était la première fois que je vous aidais dans vos tâches ménagères. Je n'ai juste pas eu beaucoup de temps dernièrement avec les feux d'artifice, mais une fois que ce sera terminé, je reviendrai plus souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "Ce n'est pas un problème, vraiment. Cela ne nous dérange pas d'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "*soupir* Vous êtes de si bons enfants... Pas comme le nôtre. Il est grand maintenant, il n'a encore trouvé personne, mais il ne nous rend jamais visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Si vous insistez, alors... J'ai du radis mariné pour Satoru. Pourriez-vous aller le lui livrer à l'autre bout du village ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Bien sûr, ce ne sera pas long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Les personnes âgées ont les jambes fragiles, alors aidons-les d'abord à <color=#00E1FFFF>désherber</color>, et ensuite, à <color=#00E1FFFF>livrer le radis mariné</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Bonjour monsieur Satoru. Comment allez-vous ces derniers temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Comme d'habitude, rien n'a changé. Tu as l'air pleine de vie, comme toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "C'est grâce au soutien de nos fidèles clients. Les affaires de la famille vont de mieux en mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "On a vendu des feux d'artifice à Liyue il y a quelque temps, et il paraît qu'ils ont remporté un franc succès. On dirait qu'on va avoir de plus en plus de clients là-bas à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Cela doit signifier beaucoup plus de travail aussi ? Tu t'en sors avec monsieur Ryuunosuke ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Si vous en avez trop, n'oubliez pas que vous pouvez toujours me demander de l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Ça devrait aller. Je pense qu'on peut s'en sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Oh, oui, au fait, voici du radis mariné de la part de madame Imatani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Ouah, merci beaucoup ! À vrai dire, je n'ai jamais été fan de radis mariné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Mais après avoir essayé ceux fait maison de madame Imatani, je n'arrive plus à m'en passer. C'est devenu un classique de notre famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Comment va votre famille, d'ailleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Elle va bien. Il nous arrive d'avoir des disputes, mais... c'est comme ça, la famille, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Je pense qu'il est préférable d'être entouré de ses proches, même s'il y a des conflits, que de rester seul tout le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "Bien que monsieur et madame Imatani aient une très bonne relation, je pense qu'ils doivent se sentir un peu seuls sans leur fils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Euh, ils ne m'ont pas donné cette impression. On dirait qu'ils y sont habitués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "Mais vous avez raison, je viendrai leur rendre visite plus souvent à l'avenir. Comme ça, ils ne s'ennuieront pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Je suis sûr qu'ils adoreraient ça. Tout le monde au Village de Konda aimerait que tu viennes plus souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Héhé, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "Ah, les jeunes ! Toujours aussi rapides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Les gens jeunes ont beaucoup d'énergie et les personnes âgées ont beaucoup d'expérience. Chacun a ses points forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Cette année, cela fera exactement cinquante ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "C'est vrai, on perd le fil des années. Ces cinquante ans sont passés en un clin d'œil sans qu'on le sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "Cinquante ans depuis quoi ? Un événement important ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Haha, si vous voulez vraiment savoir, ça va faire cinquante ans que cette jeune femme a essayé de me conquérir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "Qu'est-ce que tu racontes ? C'est toi qui me poursuivais comme un fou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Bien, passons... Quoi qu'il en soit, ça fait 50 ans que j'ai demandé ma femme en mariage au Festival de feux d'artifice de Naganohara, et on a été ensemble depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Félicitations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "À vrai dire, j'hésitais encore. Je ne savais pas vraiment ce que je faisais quand j'ai passé ma commande chez les Feux de Naganohara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Je ne savais toujours pas quoi dire même après avoir tiré le feu d'artifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Quand il a explosé, le ciel s'est illuminé... C'est là que j'ai vu ses yeux briller, reflétant la lumière du feu d'artifice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "Je ne sais plus ce qui s'est passé, mais je crois avoir dit ce que j'avais à dire, et elle m'a répondu « oui ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "Cinquante ans, c'est long et court à la fois, mais ce n'est qu'un nombre au bout du compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Mais nos cinquante ans main dans la main valent la peine d'être célébrés, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "Je ne savais pas que c'était vos cinquante ans. Sinon, j'aurais préparé un feu d'artifice spécial pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Non, ce n'est pas la peine. Nous allumons les mêmes feux d'artifice tous les ans, ça nous ferait bizarre de changer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Le simple fait de regarder ce feu d'artifice nous rappelle cette époque. Même à notre âge avancé, nous ne regrettons rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Leur relation est merveilleuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Assez parlé de nous. Vous devez être occupée avec les feux d'artifice en ce moment, Yoimiya. Qu'est-ce que qui vous amène chez nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Oh, c'est un sujet assez délicat à aborder, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Sakujirou... Il est donc de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Oh ? Vous le connaissez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Il était le meilleur ami d'enfance de notre fils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*soupir* Ils ont grandi ensemble, se disaient tout et étaient inséparables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Mais un jour, ils ont eu une grosse dispute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Je me souviens qu'à l'époque, Sakujirou voulait voir le monde. Il trouvait Inazuma trop paisible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Mais notre garçon, Keisuke, est comme nous. Pour lui, il n'y avait aucun mal à vivre dans la paix et la tranquillité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Les enfants, eh bien, ils se disputent beaucoup pour savoir qui a raison ou tort. À la fin, Sakujirou s'est mis en colère avant de partir de son côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Bien que Keisuke ne nous ait rien dit à ma femme et moi, nous avions remarqué qu'il était triste. Malheureusement, il ne voulait pas nous raconter ce qu'il avait sur le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Je ne sais pas si c'était sur un coup de tête ou non, mais il a rejoint la Commission administrative peu de temps après et ne revient que rarement à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Si c'était pour autre chose, j'aurais pu vous aider à en parler à Keisuke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Mais si ça concerne Sakujirou... je ne pense pas que nous ayons le droit de nous mêler de cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Quelle drôle de coïncidence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Je vois. Quand j'ai demandé à Sakujirou la raison de son retour, il n'a pas voulu rentrer dans les détails et m'a seulement dit qu'il avait « fait une erreur dans le passé ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Je comprends maintenant pourquoi il n'arrivait pas à se décider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Deux amis d'enfance... L'un est au service de la Commission administrative et l'autre est activement recherché par la Commission administrative...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "C'est le destin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Ce n'est pas grave. Dans ce cas, je vous laisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "On va aider Sakujirou d'une autre manière, vous n'avez pas à vous embêter. Seuls Sakujirou et Keisuke peuvent régler leur différend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Ce serait bien s'ils pouvaient se réconcilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Ça fait déjà tant d'années, ils devraient avoir mis leur rancœur de côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "Je ne m'y attendais pas non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Je vous envie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
