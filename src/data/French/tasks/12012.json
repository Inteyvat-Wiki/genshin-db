	"talks": [
		{
			"id": 1201201,
			"completionStepIds": [
				1201201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201201",
							"2"
						],
						"stepId": 1201201,
						"stateName": "QUEST_STATE_UNFINISHED"
