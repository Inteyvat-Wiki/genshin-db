			"dialogs": [
				{
					"id": 120120801,
					"content": "C'est bientôt le Festival de feux d'artifice de Naganohara, non ? Ma fille est déjà sortie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120802,
					"content": "Elle était si impatiente que ça arrive. Tout le monde sait qu'elle a le béguin pour ce garçon de la ville, ça se lit sur son visage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120803,
					"content": "*soupir* Mais je suis content qu'elle soit heureuse.",
					"roleType": "TALK_ROLE_NPC",
