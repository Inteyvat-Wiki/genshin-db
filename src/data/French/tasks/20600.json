					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000401,
					"content": "La Tsarine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "Tu veux que je te parle de la Tsarine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000403,
					"content": "Tu ne voudrais quand même pas rejoindre les Fatui juste à cause de la Tsarine, quand même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000404,
					"content": "Je ne veux pas te refroidir, mais fais attention à ce que tu dis, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000405,
					"content": "De toute façon, je ne vais pas t'en parler comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000406,
					"content": "Va donc me chercher quelque chose sur un Gardien des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000407,
					"content": "OK.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Bon, vas-y alors, je t'attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000409,
					"content": "Pourquoi ça t'intéresse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Hein ? J'en ai envie, ça ne suffit pas ? Quoi, les gens de Mondstadt n'osent pas s'en prendre aux Gardiens des ruines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000411,
					"content": "Pour les Fatui, ça ne représente pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000412,
					"content": "Mais le vent est agréable, et je ferais bien un petit somme, donc je te laisse t'en charger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
