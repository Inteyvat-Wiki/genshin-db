			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "Parle-moi de l'œil maléfique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Hé ! Tu fais exprès d'agir en imbécile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000303,
					"content": "Pas encore membre des Fatui, et tu poses ce genre de questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000304,
					"content": "Tu penses vraiment que je vais tout déballer comme ça ? Je ne suis pas un idiot de l'Ordre, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000305,
					"content": "Enfin... Pour l'instant, disons juste que l'œil maléfique est un trésor appartenant aux Fatui... Hum, j'imagine que ça ne coûte rien que tu en apprennes un peu plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000306,
					"content": "Faisons comme ça : tu as sûrement entendu parler des Pilleurs de trésors qui traînent vers Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000307,
					"content": "Ils ne sont en temps normal guère efficaces, mais il arrive qu'ils mettent la main sur quelque chose d'intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000308,
					"content": "Va récupérer quelque chose qu'ils possèdent et remets-le-moi. Je t'en dirai plus sur l'œil maléfique ensuite. Qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000309,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "Ah, j'aime cette énergie ! Allez, vas-y alors, ne perds pas de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000311,
					"content": "Alors, on n'a plus de moras, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Plus de moras ! Hahaha ! Tu crois que je fais partie de ces pauvres chevaliers de l'Ordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000313,
					"content": "Je suis juste curieux de voir sur quoi les Pilleurs ont mis la main à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000314,
					"content": "Mais... Héhé... Ça m'étonnerait qu'ils aient trouvé quoi que ce soit de bien intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
