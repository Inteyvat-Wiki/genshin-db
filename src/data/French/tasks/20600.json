			"dialogs": [
				{
					"id": 206001001,
					"content": "Alors, tu as ce que j'ai demandé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001002
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001002,
					"content": "Tiens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Ah, mais c'est pas mal du tout ! Tu te débrouilles bien, dis donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001004,
					"content": "Alors, tu veux en savoir plus sur la Tsarine, c'est ça ? Par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001005,
					"content": "Oui... Pour simplifier, la Tsarine est une déesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001006,
					"content": "Attention : ce n'est pas une image, mais la réalité. La Tsarine est l'Archon Cryo, l'une des Sept patriarches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001007,
					"content": "Mais aux yeux des Fatui, elle est encore plus que ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001008,
					"content": "Je te dirais bien pourquoi, mais... tu ne comprendrais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001009,
					"content": "Si tu veux en savoir plus, rejoins-nous. Tout te sera expliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206001010,
					"content": "Je n'en dis pas plus. Cette satanée nonne est encore en train de me regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
