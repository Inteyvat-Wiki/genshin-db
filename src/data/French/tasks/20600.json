				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "Alors, tu as ce que j'ai demandé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000602,
					"content": "Tiens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Laisse-moi voir... Hum, pas terrible, mais ça fera l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000604,
					"content": "Bon, à mon tour d'honorer ma part du marché et de t'en dire un peu plus sur notre organisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000605,
					"content": "Les Fatui viennent du Palais zapolyarny, et obéissent à la Tsarine. Nous travaillons pour elle à travers le monde entier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000606,
					"content": "Nous avons onze dirigeants, les Onze Exécuteurs, nommés par la Tsarine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000607,
					"content": "Ne t'y trompe pas : les Onze sont extrêmement puissants. Toi et moi ne sommes que du menu fretin en comparaison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000608,
					"content": "Qui sait ? Si tu nous rejoins et que tu fais tes preuves, peut-être que l'un des Exécuteurs te choisira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000609,
					"content": "Et alors là, le monde t'appartiendra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000610,
					"content": "Oh, moi ? Être choisi par les Onze ? Non, impossible. Je suis juste ici pour m'occuper de certaines affaires pour Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000611,
					"content": "Enfin... À choisir, je préférerais être sous les ordres de Capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
