			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "#Par ici, {M#voyageur}{F#voyageuse}. Ça fait un moment que je t'observe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000102,
					"content": "Qu'est-ce que tu me veux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "Allons, pas la peine d'être sur la défensive. J'ai une bonne nouvelle pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000104,
					"content": "Ça t'intéresse de rejoindre les Fatui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000105,
					"content": "Et puis quoi encore ! Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000106,
					"content": "Je vais y réfléchir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "Hein ?! Tu vas y réfléchir ? Dis non directement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000108,
					"content": "Ah, je vois que tu sais où est ton intérêt... Ceux qui rejoignent les Fatui ne le regrettent pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000111,
					"content": "Ah, je vois que tu as des questions, peut-être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000109,
					"content": "On est à Mondstadt, ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "Et alors ? On est présents sur tout le continent. Même les chevaliers de l'Ordre ne peuvent rien contre nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Victor"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060002",
							"2"
						],
						"stepId": 2060002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "Parle-moi des Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "Ah, droit au but, à ce que je vois. Héhé, il y a beaucoup à dire sur le sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000203,
					"content": "#Tu n'es pas encore membre {M#officiel}{F#officielle} de l'organisation. Je ne vais pas parler comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000204,
					"content": "Hum... Il paraît que des Brutocollinus se sont regroupés aux alentours de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000205,
					"content": "Va les chercher, ramène-moi le trophée du Brutoviandu qui les dirige, et je t'en dirai plus. Qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000206,
					"content": "OK.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "Haha, excellente réponse ! C'est rare de voir quelqu'un de ton calibre à Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000208,
					"content": "Bon, alors je te laisse y aller. Je t'attendrai ici, ne perds pas de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000209,
					"content": "C'est tout ce qu'il te faut ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "Comment ça ? Ça ne te suffit pas ! Tu trouves ça trop simple ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000211,
					"content": "Vas-y vite. Je t'attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 206000212,
					"content": "Ah... Encore un peu, et je vais finir par m'endormir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
			"id": 2060003,
			"completionStepIds": [
				2060003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
