			"dialogs": [
				{
					"id": 701040301,
					"content": "Alors ? Est-ce que les balises sont en place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040302,
					"content": "Oui, tout est prêt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "Vous avez été d'une grande aide ! Voilà une récompense pour vous, et merci encore mille fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040304,
					"content": "Hélas, avec si peu de balises, je ne sais pas si je vais récupérer beaucoup d'informations exploitables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
