				"points": []
			},
			"dialogs": [
				{
					"id": 200010901,
					"content": "#Ah, {M#voyageur}{F#voyageuse}, merci pour ton aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010902,
					"content": "Que Barbatos soit loué ! *soupir* Ça fait un moment que je suis coincé sur cette route bloquée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010903,
					"content": "Mes fruits vont pourrir si je reste ici trop longtemps. Je me suis donné tant de mal pour les récolter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010904,
					"content": "Pourrais-tu m'aider à dégager le chemin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010905,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "Haha, merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010906,
					"content": "#Je suis {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "Ah, vraiment ? Je pensais que tu pouvais... Tu es mon seul espoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
