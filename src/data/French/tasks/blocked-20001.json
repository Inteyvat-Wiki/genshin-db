			},
			"dialogs": [
				{
					"id": 200011001,
					"content": "#Mille mercis, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "Je voulais juste cueillir quelques fruits dans le coin pour les vendre ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "Je ne m'attendais pas à ce que mon plan tombe à l'eau. Une route bloquée et une attaque de Brutocollinus, j'ai tout gagné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Bon, je ne peux que rebrousser chemin... Passe à mon échoppe si tu reviens à Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Tiens, accepte ceci en remerciement. Ce n'est pas grand-chose, mais je te garantis que mes fruits sont frais. C'est pour ça que Béatrice vient toujours les acheter chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		}
