			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "La conque a flotté jusqu'en haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "Elle est encore affectée par l'illusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#Fantastique... Ah, des images apparaissent. {NICKNAME}, regarde, quelqu'un se penche... Oh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}, ne bouge pas. Derrière toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "C'est quoi ? Ça fait peur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "Ah, ce n'était qu'une image produite par la conque qui est soudainement apparue derrière toi ! J'ai eu peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "Deux séries de tests de signaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "*soupir* Franchement, j'ai cru qu'il était dans de beaux draps cette fois-ci. On lui a seulement donné une tâche plus ingrate ! C'est un soulagement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "Tu aurais dû voir à quel point il avait peur que tu le grondes. On aurait dit un petit frère qui avait peur de la réprimande de son grand frère... Dis, tu penses qu'il a peur de nous décevoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "Nous faisons simplement partie de la même équipe, mais parfois, j'ai l'impression que nous formons aussi une famille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "Une famille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "Hum, je crois qu'on a entendu quelque chose qu'on n'aurait pas dû...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "Ces Fatui n'ont pas l'air si méchants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "Ce n'est pas le moment de faire des blagues !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "Elle est probablement remplie d'air...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903305",
							"2"
						],
						"stepId": 7903305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "Oh, on dirait deux personnes allongées sur le sol... et qui regardent les étoiles dans le ciel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330302,
					"content": "C'est un peu étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330303,
					"content": "Que t'a dit le chef pour que tu fasses une tête pareille, Yakov ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330304,
					"content": "Les vagues étaient agitées, alors je suis tombé avec l'appareil dans les bras. Heureusement que j'ai réagi rapidement pour amortir sa chute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330305,
					"content": "Mais je me suis quand même fait enguirlander par le chef qui m'a ordonné de faire des tests de réception de signaux. C'est la plus difficile de toutes les tâches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330306,
					"content": "Ne déprime pas, on est tous passés par là. Allez, prends quelque chose à manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330307,
					"content": "Ils pointent vers quelque chose en haut. Est-ce qu'ils cherchent de la nourriture ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330308,
					"content": "Hé, mais la conque ne serait pas un peu courbée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}