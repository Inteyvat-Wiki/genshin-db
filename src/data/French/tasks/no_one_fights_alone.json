			"dialogs": [
				{
					"id": 50130801,
					"content": "Le territoire des Enfants des échos est sécurisé, tous les monstres ont été éliminés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "Je vais m'occuper de la tumeur de l'Abîme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "Tout va bien ici aussi chez le Peuple des sources. Nous n'avons fait qu'une bouchée de ces monstres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Les Maîtres du vent nocturne sont aussi hors de danger. Devrions-nous aller aider le Clan des fleurplumes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50130805,
					"content": "Ça a encore l'air sérieux là-bas. Je suis déjà en route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "Ce ne sera pas nécessaire, je viens de m'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "Déjà ?! Mais vous étiez au Stade à l'instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Oui, en effet. Tu n'imagines pas depuis combien de temps j'avais envie de me défouler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "Oh... Je comprends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansan, que devrions-nous faire pour le Collectif de l'abondance ? Ta maison est loin du Stade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "Oh, pas besoin de s'inquiéter. Je viens d'avoir des nouvelles de Varesa, elle dit qu'ils sont en sécurité maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50130812,
					"content": "On dirait que toutes les régions sont sécurisées. Les forces de l'Abîme faiblissent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "C'est vrai, leur seul plan était le surnombre, et ça ne fonctionnera plus maintenant que nous avons l'Ode à la résurrection de notre côté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Attendez... L'Abîme envoie un contingent important vers le Stade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "Je suppose qu'ils ont réalisé que l'Ode à la résurrection changeait la donne, alors ils vont essayer de détruire le sanctifeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "Nous ne les laisserons pas s'en tirer comme ça. Direction le Stade, les amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "D'autres tumeurs de l'Abîme sont descendues sur terre, toutes à proximité du Stade. Séparons-nous pour les éliminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Oh, et nous avons besoin de quelqu'un pour garder l'entrée principale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Très bien, c'est la bataille finale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
}