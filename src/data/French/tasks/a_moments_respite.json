			"dialogs": [
				{
					"id": 40190601,
					"content": "#Nous sommes de retour dans notre cellule ! Mais nous ne sommes plus des {M#détenus}{F#détenues}, alors ça change quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190602,
					"content": "On a été au fond du trou, mais regarde-nous maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "C'est vrai ! On n'a rien fait pour atterrir ici, alors on devrait quand même avoir un sentiment de réussite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "C'est comme si on avait regagné notre liberté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "C'est clair qu'elle n'a plus le même goût maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "Tu veux me dire quelque chose, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "Oh ? Comment tu sais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Parce que tu t'endors immédiatement d'habitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "Ce n'est pas vrai ! Bon... Je voulais juste te dire qu'on forme un duo génial ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "Nous avons voyagé dans tant d'endroits et avons rencontré plein d'amis... sans jamais nous arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "Il y a beaucoup de mauvaises choses qui se passent dans le monde. Nous ne sommes que deux personnes, mais à nous deux, nous résolvons des problèmes où que notre voyage nous mène... C'est la classe, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "#Nous sommes les {M#meilleurs aventuriers}{F#meilleures aventurières} qui existent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "#Tu me comptes dedans aujourd'hui ? C'est toi {M#le seul aventurier}{F#la seule aventurière}, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "La guide compte aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "La prochaine fois, demandons à Catherine de me donner un Guide de l'aventurier ! Je serai une aventurière à partir d'aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "Ah, l'idée me rend enthousiaste... Je vais dormir... Tu devrais en faire de même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190617,
					"content": "#La dernière fois que nous nous sommes {M#endormis}{F#endormies}, c'était n'importe quoi à l'extérieur à notre réveil... L'eau de la mer primordiale avait quasiment monté jusqu'ici. C'était effrayant...",
