			"dialogs": [
				{
					"id": 40190101,
					"content": "Sigewinne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME} et Paimon, vous êtes de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "#Ça va ? Vous n'êtes pas {M#blessé}{F#blessée} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Ne vous en faites pas, on va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "Oui, tout va bien ! Et vous ? Quelle pagaille ! C'était horrible, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Nous avons quelques blessés, mais rien de grave. Monsieur Neuvillette nous a rendu visite. C'est grâce à lui que nous avons réussi à neutraliser le danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Évidemment, vous nous avez aussi beaucoup aidés. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Comment Neuvillette a su qu'on aurait besoin de lui ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Monsieur Neuvillette a une résonance élevée avec l'élément Hydro. Il peut sentir les vagues lorsque la marée se lève.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "#J'ai croisé les frangins bombeurs lorsque je traitais les blessés. Ils n'arrêtaient pas de dire que vous étiez {M#partis}{F#parties} sans rien dire... Je suis soulagée de vous voir {M#sains et saufs}{F#saines et sauves}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Si vous n'avez pas d'affaires urgentes, j'aimerais que vous restiez avec nous pendant quelques jours de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Dites-moi tout si vous avez envie de manger un plat en particulier. Je peux demander à monsieur Wolsey de vous le préparer. N'hésitez pas non plus à venir à l'infirmerie pour prendre une pause dès que vous le souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "#J'aimerais pouvoir également étudier vos muscles faciaux. Vos sourires sont contagieux, vous savez. Ils m'ont beaucoup manqué quand vous étiez {M#absents}{F#absentes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
