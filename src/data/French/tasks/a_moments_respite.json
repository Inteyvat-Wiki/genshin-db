			"dialogs": [
				{
					"id": 40190501,
					"content": "Jurieu ! Mademoiselle Sigewinne a dit que vous n'avez toujours pas mangé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190502,
					"content": "J'étais tellement occupé que j'ai oublié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190503,
					"content": "Ça ne justifie... Hein ? Mais vous êtes là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190504,
					"content": "Jurieu, Lourvine, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190505,
					"content": "Bonjour, ça fait un moment depuis l'incident. Comment allez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "Tout va bien pour nous, merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "Et vous ? Vous prenez toujours le passage secret de l'infirmerie pour travailler sur le navire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Oui, mais c'est toujours secret. Ne dites rien à personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "C'est délicat quand il y a du monde à l'infirmerie, mais je préfère emprunter ce passage plutôt que celui depuis le bureau du duc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "L'infirmerie ne vous en tiendra pas rigueur si vous vous détendez un peu, j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "Oh ? Mais pourquoi vous êtes ici aussi souvent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Vous utilisez vos métiers pour couvrir votre relation, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "Pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
				}
			]
		},
