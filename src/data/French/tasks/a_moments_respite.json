				]
			},
			"dialogs": [
				{
					"id": 40190301,
					"content": "#Je rêve ou ce sont bien deux {M#détenus}{F#détenues} que je vois revenir après s'être {M#évadés}{F#évadées} vers la surface ? C'est bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190302,
					"content": "On voulait voir comment la Forteresse se portait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "Nous nous en sortons plutôt bien. Neuvillette est descendu pour s'occuper du pire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "Si c'est le cas, pourquoi vous ne lui demandez pas de rester ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "Quelle grandiose idée. Allons convaincre l'iudex d'abandonner les tribunaux de Fontaine pour vivre dans une flaque d'eau au milieu de nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "Je crois que ça ne va pas marcher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Il est venu ici en un coup de vent et ne s'est même pas arrêté pour prendre une tasse de thé. En revanche, il n'a pas oublié de prendre le cadeau de mademoiselle Sigewinne avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Il a l'air très occupé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "Mademoiselle Clorinde est également partie, le cadeau de mademoiselle Sigewinne sous le bras, elle aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "C'étaient des milkshakes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "Neuvillette a eu un milkshake et Clorinde, un rouge à lèvres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "Hein ?! Mais ce sont deux choses complètement différentes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "C'est juste que Clorinde est moins occupée et en meilleure santé que Neuvillette. Enfin, notre infirmière en chef aime aussi offrir des produits de beauté aux femmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "Oh, j'ai aussi des cadeaux pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "De la part de Sigewinne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "Non, de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Votre travail à la Forteresse est terminé, alors vous pouvez retourner à la surface quand vous voulez. Cependant, votre peine n'a pas encore été totalement purgée. Votre cellule reste à votre disposition jusqu'à la fin de celle-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "Vraiment ? On va pouvoir habiter ici encore longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "Nourriture incluse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Vous pouvez manger à la Cantine gratuitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "N'oubliez pas de venir remplir vos papiers de décharge lors de votre libération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
