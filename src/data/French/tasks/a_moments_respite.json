			"dialogs": [
				{
					"id": 40190401,
					"content": "#Hein ? Vous êtes {M#revenus}{F#revenues} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "Cuistot ! Laverune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "Ne me dites pas que vous vous êtes encore fait jeter ici en commettant un crime ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190404,
					"content": "Hein ? Pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "#Argh ! Et moi qui pensais que vous aviez réussi à vous évader pendant l'agitation. Vous étiez des {M#évadés}{F#évadées} de légende à mes yeux... Mais voilà que vous me dites que vous n'étiez jamais {M#partis}{F#parties}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "#Haha... {M#Désolés}{F#Désolées}, on avait des affaires à régler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "Allez, ce ne sont que des détails. Nous sommes soulagés de vous revoir. Il était très inquiet pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190408,
					"content": "Il n'y avait pas que moi ! Toi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Oui, c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "#J'ai été muté à la cuisine il y a quelques jours. Je peux encore entendre Cuistot ruminer aux carottes : « Est-ce qu'{M#ils}{F#elles} vont bien ? Sont-{M#ils}{F#elles} en vie ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "#Et je lui disais : « Je suis sûr que ça va ! {M#Ils}{F#Elles} doivent sans doute admirer le paysage quelque part, un verre à la main. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "#Hé ! J'ai le droit de m'en faire pour mes {M#codétenus}{F#codétenues} ! {M#Ils étaient friands}{F#Elles étaient friandes} de mes ragots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Ces deux-là sont beaucoup plus sympas que ce que j'imaginais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "#Je suis {M#sûr}{F#sûre} que les repas gratuits ont gagné en qualité ces derniers temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "... Si vous le dites. Je vous regarderai manger votre repas jusqu'à la dernière miette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Vos repas attireront tous les prisonniers à la Cantine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
