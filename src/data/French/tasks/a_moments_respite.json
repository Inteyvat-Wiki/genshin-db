			"dialogs": [
				{
					"id": 40190201,
					"content": "Devinez à quelle suite appartient la prochaine carte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190202,
					"content": "Hmm... Un chat qui montre les dents ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190203,
					"content": "Ah, c'est vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190205,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190206,
					"content": "Vous avez l'air d'être rétabli, Fréminet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190207,
					"content": "C'est grâce à l'aide de tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190208,
					"content": "Ah oui ! J'ai... J'ai trouvé le courage de remercier mademoiselle Clorinde en personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190209,
					"content": "Comment a-t-elle réagi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190210,
					"content": "Elle m'a dit que ce n'était pas grand-chose, qu'elle avait l'habitude et de ne pas m'en préoccuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190211,
					"content": "Mademoiselle Clorinde ne voulait pas que tu t'inquiètes. Elle a raison, tu n'as pas besoin de trop y penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190212,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190213,
					"content": "Ah ! D'ailleurs, nous avons croisé Arlecchino en revenant à l'Opéra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190214,
					"content": "#Vous êtes {M#tombés}{F#tombées} sur Père ? Que vous a-t-elle dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190215,
					"content": "Des propos difficiles à comprendre... mais qu'elle avait hâte de travailler avec nous à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190216,
					"content": "C'était assez surprenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "#Elle vous a beaucoup mieux {M#traités}{F#traitées} que ce que j'aurais pensé... C'est génial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190218,
					"content": "Vous devriez lui faire confiance. Père a un sens des responsabilités qui lui est propre et fait toujours tout son possible le moment venu. Elle adorerait que vous soyez des nôtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190219,
					"content": "Oui. Père est quelqu'un d'exceptionnel et de fiable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190220,
					"content": "Oh, c'est vrai. Arlecchino a dit qu'elle vous trouvait un peu fier, Lyney. D'après elle, vous devriez apprendre à compter sur les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190221,
					"content": "Hum... D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190222,
					"content": "Ça lui ressemble bien de dire ce genre de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190223,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190224,
					"content": "Allez-vous rester ici les prochains jours ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190225,
					"content": "On dirait bien que oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190226,
					"content": "Super, je vais organiser un goûteron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190227,
					"content": "Vraiment ? Je veux encore manger du gâteau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190228,
					"content": "« Encore » ? Ça veut dire que vous en avez déjà mangé là-haut. La chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190229,
					"content": "Venez prendre le thé avec nous aussi la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
