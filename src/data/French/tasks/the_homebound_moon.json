						761180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180502,
					"content": "Vous pouvez ouvrir les yeux maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180503
					]
				},
				{
					"id": 761180503,
					"content": "...",
