					"nextDialogs": [
						761180504
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180504,
					"content": "(Elle a vraiment ouvert les yeux !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(J'ai dit ça sans réfléchir...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "C'est magnifique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180507,
					"content": "Cette paire d'ailes la rend complète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180508,
					"content": "C'est un cadeau que nous, les Descendants de givrelune, souhaitons vous offrir, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Pour célébrer notre déesse qui peut désormais voler librement, dont les doigts peuvent enfin toucher ce lieu qu'elle appelle « chez elle ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "... Auparavant, cette statue ne me rappelait que la confusion que j'avais ressentie à ma naissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180511,
					"content": "Mais maintenant, ce que je ressens, c'est la chaleur d'un foyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180512,
					"content": "Peut-être que, comme cette statue, j'ai choisi de rester ici même si j'ai maintenant des ailes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180513,
					"content": "... Merci à tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180514,
					"content": "Nous avons préparé un autre cadeau, mais il faudra me suivre un peu plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Hein ? Il y a une autre surprise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Mes compagnons Descendants de givrelune et moi avons organisé un petit banquet de bienvenue dans la forêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "Désormais, ce sera aussi chez vous, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Si jamais le mal du pays vous prend, n'hésitez pas à rester ici et à profiter de notre hospitalité, aussi modeste soit-elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "D'accord. Je le ferai..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180520,
					"content": "Tiens donc ? La lune s'est levée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Allons-y, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "J'espère que chaque nuit sera aussi merveilleuse que cette Nuit de la prière lunaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Bienvenue chez vous, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
