			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "Vous voulez rénover la statue de Kuutar ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Exactement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "Elle n'est plus cette Kuu{RUBY#[S]Dame de la lune}tar sans ailes qui ne pouvait que contempler solitairement la lune au-delà des cieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "Nous l'avons vue déployer ses ailes, et nous savons qu'elle a retrouvé la liberté de vivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "De ce fait, c'est normal que la statue soit également restaurée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "C'est effectivement une excellente idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "Vous en avez parlé aux autres Descendants de givrelune ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Oui, je l'ai fait. Je leur ai parlé du sacrifice de la Déesse de la lune, et de son retour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "Et comment nous nous sommes dressés contre la force qui souille ce monde, guidés par cette douce lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Tout le monde était ravi d'apprendre son retour, alors j'en ai profité pour leur transmettre les pensées de Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "Qu'elle souhaite nous considérer comme sa famille, et aimerait que nous fassions de même pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "Et qu'est-ce qu'ils ont dit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "La Déesse de la lune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "Ce ne serait pas... présomptueux de la considérer comme un membre de notre famille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "Je pense que c'est ce que Columbina souhaite sincèrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(L'Émissaire de chantelune a appelé la Déesse de la lune « Columbina » !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Vous vous souvenez peut-être encore des paroles que j'ai prononcées il n'y a pas si longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "« La route ne sera pavée que de vérité et par nous-mêmes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "Je ne vous demanderai pas de faire le même choix que moi, mais j'aimerais partager quelques mots avec vous aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "« Si nous souhaitons inviter le clair de lune à demeurer, nous devons d'abord ouvrir les portes qui étaient autrefois closes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "... C'est ce qui s'est passé. En considérant la situation de ces derniers jours, les choses semblent s'être mieux déroulées que je ne l'aurais pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Dame Lauma. Un nouveau lot de pierres est arrivé à l'entrepôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Compris. J'arrive tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "Pourriez-vous garder secret ce que je viens de dire, y compris ce que vous avez vu, et ne rien dire à Columbina ? Du moins pour l'instant ? J'aimerais que ce soit une surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
					"content": "Je sais que vous avez de bonnes intentions, mais franchement, vous aimez vraiment les surprises... Votre Déesse de la lune aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180327,
					"content": "Motus et bouche cousue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "Dites, Lauma, à propos de mon pot-de-vin... Euh, je voulais dire, il ne vous resterait pas des parts du festin de la lune par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180329,
					"content": "Oui, il en reste. Venez, je vais vous en préparer. Ah, et une dernière chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
