			},
			"dialogs": [
				{
					"id": 761180401,
					"content": "Ah, vous revoilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180402,
					"content": "#Vous savez, Columbina ? Vous aviez raison, Lauma ne nous a rien dit du tout{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "Elle a l'air assez occupée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Du coup, on va vous tenir compagnie ces prochains jours. Restez tranquille et attendez de voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "De voir quoi au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180406,
					"content": "Ah... ! Oh ! Euh, r—rien ! On ne sait rien du tout, promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Héhé... Très bien, alors. J'ai hâte de passer ces prochains jours avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Ibis longplumé"
				},
				{
					"id": 761180409,
					"content": "Oh, voilà notre repas... Une minute. Où est la nourriture ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Ibis longplumé"
				},
				{
					"id": 761180411,
					"content": "Il dit : « L'heure est venue ». Savez-vous ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180412,
					"content": "Ah, je comprends maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180415,
					"content": "Vous portez habituellement un bandeau sur les yeux, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Oui, et ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180417,
					"content": "Mais vous pouvez quand même utiliser le kuuvahki pour observer le monde extérieur, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "C'est exact. Je dirais même que je perçois les choses plus clairement ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180419,
					"content": "Dans ce cas, euh, pourriez-vous faire l'effort de ne pas détecter les changements à l'extérieur pour le moment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "Pour que ce soit une « agréable surprise » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180421,
					"content": "... On dirait que vous avez déjà deviné ce que c'était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Très bien. Je comprends. Dans ce cas, accepteriez-vous de me tenir la main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
