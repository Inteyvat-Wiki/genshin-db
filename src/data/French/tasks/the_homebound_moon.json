			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180102,
					"content": "Je me fais des idées ou tu sens aussi cette délicieuse odeur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180104,
					"content": "Columbina se fait un festin en solo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180106,
					"content": "On dirait que quelqu'un en profite bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Vous voulez goûter aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180108,
					"content": "Non, je vous en prie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "On n'a pas l'habitude de vous voir manger ici ! Vous êtes sortie juste pour aller acheter ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "C'est Lauma qui m'en a donné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180111,
					"content": "Elle prend vraiment soin de vous, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "À condition que je ne parte pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180113,
					"content": "Attendez, quoi ?! C'est juste un pot-de-vin pour que vous acceptiez l'assignation à résidence ? Et un petit pot-de-vin, en plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Elle m'a aussi apporté des livres intéressants et des jouets magnifiquement fabriqués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180115,
					"content": "Euh, maintenant, on dirait plutôt une mère qui part en voyage d'affaires et un enfant qu'elle laisse à la maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Est-ce que Lauma vous a expliqué ses raisons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Elle m'a juste dit de ne pas sortir pour le moment, et surtout d'éviter les Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180118,
					"content": "J'ai interrogé les animaux qui venaient m'apporter mes repas, mais Lauma leur avait ordonné de garder le silence, ce qu'ils ont fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180119,
					"content": "Euh, c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Si je devais deviner, elle prépare quelque chose qui me concerne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180121,
					"content": "Ne vous inquiétez pas. Je n'ai jamais trouvé que c'était ennuyeux de rester ici, de toute façon. La nourriture est bonne et correspond parfaitement à mes goûts. Ça ne me dérange pas de ne pas sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180122,
					"content": "Et si les Descendants de givrelune préparent effectivement quelque chose... C'est une raison de plus pour ne pas les interrompre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180123,
					"content": "Voulez-vous qu'on aille se renseigner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Je suis aussi curieuse maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "Vous pouvez... mais il faut vous préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180126,
					"content": "Elle sait probablement que vous viendriez me voir, donc elle ne vous dira peut-être rien du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
