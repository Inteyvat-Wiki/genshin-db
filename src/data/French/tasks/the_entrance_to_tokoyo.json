			"dialogs": [
				{
					"id": 722420401,
					"content": "#Je n'aurais jamais cru qu'un lieu aussi vaste se trouvait sous l'Île de Watatsumi{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420402,
					"content": "On dirait que notre objectif est d'arriver à cet endroit au milieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420403,
					"content": "#Allez, {NICKNAME}, on y va. Doucement cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Ces ruines semblent proches de nous, commençons par là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "S'il y a des bâtiments, c'est que des gens s'y trouvaient bien un jour... Et ils laissent toujours des documents derrière eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "Bien sûr, c'est toujours les trucs illisibles qu'on trouve le plus facilement dans ces tas de papiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
