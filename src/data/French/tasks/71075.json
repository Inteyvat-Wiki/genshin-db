			"dialogs": [
				{
					"id": 710750101,
					"content": "Hé, mais qui vois-je !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Cet Erge... Il a passé tout ce temps à fouiller sans résultat. Il aura fallu quelqu'un qui connaisse les lieux comme toi pour finalement réussir à le trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "Si tu cherches quelque chose que tu n'arrives pas à trouver, rien de plus simple : il faut attendre qu'une personne capable cherche pour toi, puis de la forcer à vous remettre ce qu'elle a trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "On m'appelle le « Gamin de Qingce ». Je me débrouille plutôt bien, alors c'est pas une misérable bande de mineurs du Gouffre qui va réussir à m'arrêter. Allez, donne-moi ce que tu as trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "Le trésor des Millelithes doit revenir aux Pilleurs de trésors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "Peu importe ce que tu cherches...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "Tu penses qu'il te suffit de le dire pour que je te croie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "#Hmph. Je pensais que tu serais plus {M#malin}{F#maline} après avoir passé autant de temps dans la mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "Fais ton choix : soit tu me donnes le heaume de protection, soit je te pulvérise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "Tu ferais mieux d'éviter de te battre contre moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Eh bien ! Je vois qu'on ne manque pas d'audace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750113,
					"content": "Il semblerait que la manière douce ne soit plus une option. Il ne reste donc que la manière forte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 710750107,
					"content": "Tu ne le trouveras pas ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
