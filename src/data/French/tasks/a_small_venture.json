			"dialogs": [
				{
					"id": 761390101,
					"content": "Il n'y a pas d'argent à se faire dans l'édition. On ferait peut-être mieux d'investir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Laissez-moi voir les coupons d'investissement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Voilà. 2 000 moras pour un coupon. Chaque investissement arrive à échéance après une semaine et dans cette petite bourse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "... Ugh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "Non, rien du tout. Je ne m'attendais pas à vous voir, dame Nefer. Seriez-vous... aussi intéressée par l'achat d'un coupon d'investissement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "#Ça va aller. On ne fait que regarder avec mon {M#ami}{F#amie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "J'ai entendu dire que votre affaire d'investissements se portait à merveille. À ce que je vois, les rumeurs sont vraies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "N'exagérez pas, haha... Ce n'est qu'une petite affaire que j'ai commencée pour mettre du beurre dans les épinards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Peut-on vraiment gagner de l'argent comme ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "#Bien sûr, monsieur Dhabit est un excellent homme d'affaires. Si vous investissez avec lui, vous ne serez pas {M#perdant}{F#perdante}. Ai-je tort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "Oui, oui... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Voyons voir si la chance me sourit aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "Vous avez acheté notre tout nouveau... coupon d'investissement à court terme, seulement disponible aujourd'hui ! Les bénéfices et les pertes sont immédiatement calculés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Vous venez d'inventer tout ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "#Euh... B—Bref, merci d'avoir acheté un coupon d'investissement à court terme{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "Voici votre retour d'investissement. Bonne journée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "C'est toujours une bonne chose que de gagner de l'argent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Vraiment ? Héhéhé ! J'en veux une en forme d'oiseau ! C'est mes préférées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Je vais vous laisser moi aussi. Monsieur Dhabit, vous êtes vraiment à la hauteur de votre réputation de marchand honnête et intègre. J'espère que vos affaires prospèreront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390122,
					"content": "Merci pour vos gentilles paroles, dame Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
					"content": "À propos de ce que je vous ai demandé la dernière fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390124,
					"content": "On a trouvé ce que vous recherchez, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390125,
					"content": "Soyez patient, monsieur Dhabit. Il faut procéder lentement et sûrement en affaires.",
