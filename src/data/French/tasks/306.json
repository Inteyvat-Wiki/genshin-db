			"dialogs": [
				{
					"id": 3061001,
					"content": "Pfiou, j'en peux plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061002,
					"content": "Au moins, nous n'avons pas laissé tomber Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061003,
					"content": "Jusque-là, nous avons su défendre la cité et la maintenir en sécurité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061004,
					"content": "Tout ça, principalement grâce à Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061005,
					"content": "Mais maintenant que Stormterror s'en prend directement à la cité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061006,
					"content": "« Comme le vent qui change de direction, notre stratégie doit connaître une évolution. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061007,
					"content": "C'est profond...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "C'est ce que Lisa dit toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061010,
					"content": "Bon... Nous parlions des Quatre Vents tout à l'heure...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061011,
					"content": "Si tu veux en savoir plus sur eux, Lisa est la mieux placée pour t'en parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061012,
					"content": "Ça ne veut pas dire que je ne connais pas leur histoire ! C'est juste que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061013,
					"content": "Une bibliothécaire saura mieux t'expliquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061008,
					"content": "Tu viens d'inventer ce dicton ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
