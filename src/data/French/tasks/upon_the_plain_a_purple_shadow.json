			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kagotsurube Isshin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "Hmm ? Vous n'avez pas d'œil divin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370402,
					"content": "#On dirait bien que je vous ai {M#pris}{F#prise} pour quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370403,
					"content": "Vérifiez un peu avant d'attaquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370404,
					"content": "Non mais d'ailleurs... Peu importe, on ne tombe pas sur les gens comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370405,
					"content": "Auriez-vous vu quelqu'un qui réponde au nom de Kaedehara Kazuha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370406,
					"content": "Il utilise une épée à une main comme vous, et j'ai entendu dire qu'il avait un œil divin Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370407,
					"content": "Pourquoi vous le cherchez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "Ça ne vous regarde pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370409,
					"content": "Peu importe, vous n'avez pas l'air de savoir quoi que ce soit, je perds mon temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370410,
					"content": "Qu'est-ce qu'il a, ce gars ? Il vient nous agiter son épée bizarre sous le nez, et il ne s'excuse même pas ! C'est pas des manières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370411,
					"content": "Ce n'est clairement pas à ce genre de personne qu'on va dire quoi que ce soit à propos de Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370412,
					"content": "Tu as raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "C'est vrai, quoi ! Même si je pense qu'il n'aurait pas pu faire quoi que ce soit contre Kazuha s'ils s'affrontaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370416,
					"content": "Au cas où, on ferait mieux d'informer Kazuha dès que possible et de lui rappeler d'être prudent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370417,
					"content": "En fait, j'ai une idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "Hmm ? Laquelle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370419,
					"content": "Il a peut-être un lien spécial avec Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "Un lien spécial ? Tu veux dire qu'il connaît Kazuha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370421,
					"content": "C'est juste une vague impression...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "#Maintenant que tu le dis... Mais les techniques de combat se ressemblent plus ou moins donc on ne peut être {M#sûrs}{F#sûres} de rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370424,
					"content": "En tout cas, on doit prévenir Kazuha avant qu'il ne soit en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370425,
					"content": "J'ai entendu dire que la Flotte du Crux était en train de se ravitailler à Ritou. Il devrait se trouver là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370422,
					"content": "Sa technique de combat est similaire à celle de Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Bien vu pour une fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "Hé, je ne suis pas d'accord. Je vois toujours bien les choses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
