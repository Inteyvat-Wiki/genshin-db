				"objectNames": [
					"Chao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "Bonjour, savez-vous où se trouve Kazuha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "Alors vous aussi, vous êtes à la recherche de Kazuha ? On dirait bien qu'il a fait quelque chose d'extraordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "« Aussi » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Haha, on était venus ici dans ce petit bateau pour se réapprovisionner. Mais dès notre arrivée au port, les habitants ont afflué pour nous demander des nouvelles de Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Si c'est à cause de ses exploits à la bataille de la Plage de Nazuchi, capitaine Beidou y était aussi et elle n'a pas autant de succès !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "Kazuha est plutôt réservé la plupart du temps. Parfois, il n'écoute même pas ce que la capitaine lui dit, mais elle se contente d'en rire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "Vous n'avez pas l'air d'être au courant de ce qu'il a fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "J'ai entendu quelque chose comme le fait de bloquer le Kendo d'insouciance de la Shogun Raiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "C'est si impressionnant que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "C'est comme l'attaque de Beidou qui a éliminé Haishan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "#Ah, j'ai compris. Hahaha, il est vraiment fort ! Alors, il mérite sa réputation{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Il a dit qu'il avait été convoqué par quelqu'un de la Commission administrative qui avait quelque chose d'important à lui dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "Au début, j'ai pensé qu'il s'agissait d'une arrestation, mais la personne s'est avérée très amicale et avait l'air d'avoir vraiment beaucoup de respect pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Il n'y a pas si longtemps, cela aurait été totalement impensable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Le Shogunat veut probablement montrer sa bonne foi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Merci beaucoup, on va aller à la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Quant à moi, je vais continuer à m'occuper des passants ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Après tout, la Shogun Raiden a changé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Oh ? C'est vous, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "Salutations, nous étions justement en train de discuter de l'abolition du décret de saisie. Puisque vous êtes là, pourquoi ne pas vous joindre à nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "La raison pour laquelle j'ai invité monsieur Kaedehara Kazuha à venir ici, c'est pour exprimer la gratitude du Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "C'est grâce à vos efforts que nous avons pu en arriver là. Je suis également reconnaissant d'avoir eu l'opportunité de corriger les erreurs de mon clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "La Shogun travaille d'arrache-pied à résoudre ou du moins à apaiser les conflits qui se sont accumulés au fil du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "Les Trois Commissions ont proposé de saisir cette occasion pour rétablir la réputation du Clan Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Vous avez entendu parler du Clan Kaedehara, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Pour faire court, il y avait autrefois un groupe de forgerons impériaux à Inazuma qui avait hérité des techniques de forge de la Shogun et les perpétuait. Le Clan Kaedehara était l'un d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "Cependant, à un moment donné, certains forgerons se sont rebellés et sont partis pour Snezhnaya. Le Clan Kaedehara et le Clan Kamisato ont été tenus pour responsables de cette mauvaise gestion et ont connu un grand bouleversement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "On a appris plus tard que c'étaient les Fatui qui étaient à l'origine de cette affaire. Il était donc non seulement inapproprié, mais également injuste d'en attribuer la faute aux Clans Kamisato et Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "La Shogun estime qu'elle doit non seulement récompenser monsieur Kaedehara Kazuha pour sa contribution exceptionnelle à Inazuma, mais aussi le dédommager pour la punition excessive subie par son clan dans le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Cependant, nous n'avons pas rendu publics les résultats de l'enquête sur l'affaire des forgerons afin d'éviter toute action de la part des Fatui visant à leur nuire. Nous espérons que vous comprenez pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "C'est un véritable honneur d'avoir l'occasion d'accepter les bonnes grâces de la Shogun et du Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Cependant, je ne pense pas que cet élan de gentillesse soit totalement désintéressé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Vous vous trompez, il s'agit d'une simple compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Une fois votre réputation rétablie, le Clan Kaedehara pourra reprendre son activité de forge et vous n'aurez plus à vivre une vie d'errance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Avec le soutien de la Shogun et du Shogunat, vous pourrez vivre tranquillement et dans la prospérité à Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Je suis habitué à être à la merci des éléments. J'ai bien peur que cette vie de faste ne soit pas faite pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "Cependant, mes ancêtres ont toujours été fiers du nom de Kaedehara et de l'héritage des techniques de forge. J'ai le devoir de restaurer leur réputation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "Vous avez l'air d'hésiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Si vous acceptez, je pense que beaucoup des rumeurs qui circulent sur vous en ville disparaîtraient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "Des rumeurs ? On n'a entendu que du bien sur lui en venant ici, à tel point qu'on s'est demandé s'il n'y avait pas un autre Kaedehara Kazuha en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Aux yeux de certains, le Kendo d'insouciance est quelque chose d'imparable. Ils n'arrivent pas à accepter l'idée que monsieur Kaedehara ait pu y résister aussi facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Des témoins l'ont vu utiliser l'énergie élémentaire Électro en plus d'Anémo, et la nouvelle s'est vite répandue que « Kaedehara Kazuha utilisait un œil maléfique »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "Quoi ? Les gens qui utilisent des yeux maléfiques vieillissent prématurément, ce n'est pas le cas de Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Exact. Néanmoins, certains ont encore plus de mal à concevoir qu'une personne puisse manipuler deux énergies élémentaires à la fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Il y a beaucoup d'autres rumeurs de ce genre, et cela me met mal à l'aise d'être au centre de l'attention publique, que ce soit pour me critiquer ou me féliciter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Mais si le Shogunat est prêt à me soutenir, peut-être que les rumeurs à ce sujet se tairont plus rapidement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "C'est pourquoi je vous encourage à y penser sérieusement, ce serait une bonne chose pour tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Oui, laissez-moi y réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Mettons cette discussion de côté. Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "Ah, j'ai failli oublier le plus important !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Vous parlez à Kaedehara Kazuha de l'attaque.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "Il y a un tel individu qui me cherche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "Avez-vous des frères ou des sœurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Non, je suis confus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Ma famille m'a enseigné les arts martiaux à l'origine dans le but d'essayer les épées. Nous nous entraînons beaucoup afin d'effectuer une coupe de la façon appropriée lors des essais et de vérifier de manière équitable la qualité de chaque épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Au fil du temps, une technique familiale a fini par émerger et les compétences correspondantes ont vu le jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "C'est très différent des techniques de combat, il est donc difficile de penser qu'il s'agisse juste d'une coïncidence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "Alors, faites attention, cette personne est étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Oui, il a l'air très agressif. S'il attaque quelqu'un, cela pourrait avoir des conséquences graves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "Dans ce cas, je vais envoyer quelqu'un immédiatement pour enquêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Je vous remercie pour votre sollicitude, mais je dois dire que je suis curieux à propos de cette histoire. En ce qui concerne votre proposition, j'ai besoin de temps pour y réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "#Je vais commencer par accompagner {M#le voyageur}{F#la voyageuse} pour enquêter sur cet agresseur. Je vous donnerai ma réponse définitive ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "D'accord. Faites attention à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Allons trouver cet agresseur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "Pourrait-il être un autre disciple de votre maître ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Je ne me souviens pas bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
