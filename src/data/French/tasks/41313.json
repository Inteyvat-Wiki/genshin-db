			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "Alors, l'incident a-t-il été résolu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130202,
					"content": "#On s'en est {M#occupés}{F#occupées}, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "C'est une bonne chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130204,
					"content": "Vous n'irez vraiment pas voir la lanterne Mingxiao ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "Non... Je vous l'ai déjà dit, je n'aime pas la foule, surtout pendant cette période de l'année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130206,
					"content": "Mais cette année, la lanterne est en hommage à Brise-Cieux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Ouais, c'est un cerf géant super impressionnant ! Il faut vraiment qu'on aille voir ça tous ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130208,
					"content": "Brise-Cieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130209,
					"content": "Cela ne reste cependant qu'une simple lanterne Mingxiao, une création éphémère née de la main de l'homme. Je n'y attache aucune importance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130210,
					"content": "Si c'est quelque chose qui pique néanmoins votre curiosité, je vous suggère d'aller en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "On dirait que Xiao et vous avez pris les choses en main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "Les nouvelles vont vite, comme on dit, et elles sont même arrivées jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130303,
					"content": "Et pourtant... Encore un Festival des lanternes qui se termine, encore une année où il n'y assistera pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "Ah... Dire que ça fait tant d'années et qu'il n'y est jamais allé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130305,
					"content": "Franchement, je dirais même que ce serait plus facile d'amener le festival jusqu'à lui, plutôt que de l'amener, lui, jusqu'au festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130306,
					"content": "Amener le Festival des lanternes jusqu'à lui... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "Bonne idée !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "Oui ! Si Xiao ne va pas au festival, c'est le festival qui viendra à lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "Hein ? Mais je plaisantais, voyons... Comment pourrait-on lui amener le festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130310,
					"content": "Quand nous étions en ville pour assister aux festivités, nous avons appris à faire des lanternes célestes. Et puis, on a même trouvé un étal servant des spécialités locales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "Plein de trucs super bons, plein de jolies lanternes célestes, et aussi... euh... oh oui, les héros tombés ! Ses anciens compagnons, quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "N'est-ce pas là l'essence-même du Festival des lanternes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "Vous n'avez pas tort, mais où pourrions-nous installer tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Voyons voir, laissez-moi réfléchir... Nous avons besoin de place pour installer notre étal... Hmm... Il y a peut-être assez d'espace <color=#00E1FFFF>sous l'auberge</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130315,
					"content": "Descendons pour voir si ça peut convenir. Je vois à peu près de quel genre d'étal vous avez besoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130316,
					"content": "Hmm, je devrais pouvoir trouver quelques références... Je dois y réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Ici, c'est pas mal... Et c'est assez éloigné des passants en plus. Un bon choix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130702,
					"content": "Nous nous sommes trouvés un bon emplacement, maintenant il nous faut construire l'étal. J'y ai un peu réfléchi, et je pense savoir quel genre d'étal conviendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130703,
					"content": "Si vous voulez bien patienter un moment, je vais essayer de trouver par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130704,
					"content": "Et voilà ! J'ai fait ce que j'ai pu, mais qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130705,
					"content": "Waouh, vous auriez dû devenir menuisier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "Ah, ce n'est rien du tout ! Juste un peu de bricolage que j'ai appris au fil des années. J'avais pratiquement tout oublié en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130707,
					"content": "Bon, l'étal, c'est fait ! Et ça l'air joli avec cette petite lanterne céleste que j'ai accrochée, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130708,
					"content": "En plus, vous savez fabriquer des lanternes célestes !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Bah oui... Vous savez, c'est tout à fait normal pour les gens de mon âge qui ont grandi à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130710,
					"content": "Bon, voyons... Qui dit fête dit festin ! Avez-vous une idée de ce que vous voulez comme menu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130711,
					"content": "Du tofu aux amandes, ça c'est sûr ! On en a déjà fait pour Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "Et il ne faut pas oublier le poisson chihu grillé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "Du tofu aux amandes et du poisson chihu grillé, hmm... Une combinaison intéressante ! J'irai en toucher deux mots à Yanxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130714,
					"content": "Il devrait pouvoir préparer ça en un rien de temps. Heureusement, le garde-manger de l'auberge contient tous les ingrédients nécessaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130715,
					"content": "Bon, il est temps d'appeler notre invité d'honneur. Pourriez-vous aller le chercher ? Tout sera prêt quand vous descendrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
