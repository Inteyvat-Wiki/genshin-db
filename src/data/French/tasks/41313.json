			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "Je n'irai pas plus loin. Vous pouvez entrer dans la ville à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131102,
					"content": "Attendez un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131105,
					"content": "Vous êtes clairement l'un des héros célébrés pendant ce festival, alors pourquoi ne pas vous joindre aux festivités ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131106,
					"content": "Je... déteste les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131107,
					"content": "Ils ne se soucient de rien, vivent en paix, dans la joie... Rien à voir avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131108,
					"content": "Je côtoie la violence depuis bien trop d'années, accompagnée du fardeau de la souffrance qui s'ensuit. Me mêler à cette foule en liesse ne fera que me faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131109,
					"content": "... Ahhh. Je n'ai rien d'autre à ajouter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131110,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131111,
					"content": "Êtes-vous sûr de ne pas vouloir nous accompagner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "Appréciez-vous tellement ces choses insignifiantes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131113,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "Hé, c'est un festival légitime, pas un truc insignifiant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131115,
					"content": "Légitime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131116,
					"content": "J'en ai assez. Allez donc regarder vos lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131117,
					"content": "#Mais restez {M#vigilants}{F#vigilantes}. Si vous vous trouvez en difficulté... vous n'avez qu'à m'appeler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131118,
					"content": "Vous êtes sûr d'arriver à temps à la rescousse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "Peu importe où ou quand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131120,
					"content": "Que ce soit les vôtres ou ceux de Liyue, j'entends tous les appels à l'aide, toutes les prières pour la paix et tous les vœux que portent les lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131104,
					"content": "(... Qu'importe, on peut voir d'ici.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
