			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "Qu'est-ce que vous avez encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130802,
					"content": "On veut que vous veniez au Festival des lanternes avec nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "... Je vous ai déjà dit ce que je pensais des endroits bondés. Allez-y sans moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130804,
					"content": "Qui a dit qu'il fallait aller au Port de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "C'est-à-dire...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130806,
					"content": "Nous avons amené le festival jusqu'ici !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "Vous avez... amené le festival ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130808,
					"content": "Haha, c'est juste sous l'auberge ! Il y a plein de trucs à manger, des tonnes de lanternes, et en plus, il n'y a pas grand monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130809,
					"content": "Il y a même du tofu aux amandes et du poisson chihu grillé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "Allons-y vite, ou ça va être froid !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
