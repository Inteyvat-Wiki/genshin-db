				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "Ta-da ! Votre Festival des lanternes perso ! Eh bien, ça fait saliver, dis donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130902,
					"content": "Voilà donc ce à quoi vous faisiez référence en parlant de m'amener le festival... L'excentricité des humains ne connaît-elle donc aucune limite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130903,
					"content": "Quel est l'intérêt d'un tel projet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130904,
					"content": "Comme ça, vous pouvez participer au Festival des lanternes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "... Vraiment ? La motivation des humains dépasse mon entendement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130907,
					"content": "Bon, moins de crise existentielle, et plus d'empiffrage ! Sinon, ça va refroidir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130908,
					"content": "Bon ben moi, j'attaque !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130909,
					"content": "Bon, maintenant que nous en avons fini avec la partie la plus importante des festivités, nous devrions aller voir la lanterne Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130910,
					"content": "Venez avec nous, Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "Vous pouvez y aller. Il n'y a rien pour moi là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130912,
					"content": "Vous n'avez qu'à nous accompagner sur le chemin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "Ouais, même si vous vous en fichez de la lanterne Mingxiao... Vous pouvez toujours aller vous promener avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130915,
					"content": "La route est longue jusqu'au Port de Liyue... Et puis, c'est dangereux... Super dangereux même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130916,
					"content": "Personne n'a dit que vous deviez pénétrer dans la ville... Vous n'avez qu'à nous laisser aux abords de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130918,
					"content": "... Hmpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130919,
					"content": "Qu'il en soit ainsi. J'accepte de vous accompagner aux <color=#00E1FFFF>abords de la ville</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130920,
					"content": "Eh bien voilà ! Bon, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130913,
					"content": "Accédez à notre humble requête, ô Gardien Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "Le Festival des lanternes est une fête pour tous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
