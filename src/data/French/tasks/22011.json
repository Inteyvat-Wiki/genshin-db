				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "Vous avez terminé de nettoyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110202,
					"content": "Oui, ça y est.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Merci beaucoup. Je vais reprendre ces présages et les mettre au bon endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110204,
					"content": "Et voici une récompense pour votre aide. Encore merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110205,
					"content": "Je comprends parfaitement tous ceux qui veulent se débarrasser de leur malchance ou se couvrir de chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110206,
					"content": "Mais ils feraient mieux d'affronter leurs problèmes plutôt que de tout miser sur des omikuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110207,
					"content": "S'ils ne se bougent pas un minimum, même la faveur des divinités ne peut rien pour eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				}
			]
		},
