				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Sérieusement... Qui a bien pu répandre cette rumeur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "Quelle rumeur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Celle à propos des omikuji de l'autel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "Vous savez ce que c'est ? Pour faire simple, c'est une méthode de divination qui consiste à piocher des bâtonnets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "Le présage sur le bâtonnet que vous avez tiré vous donne une prédiction concernant votre avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "Tant mieux si vous en tirez un qui vous prédit une bonne fortune. Dans le cas contraire, il faut placer le bâtonnet dans l'autel et prier pour repousser la malchance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "Je ne sais pas d'où elle vient, mais à ce qu'il paraît, des esprits aident à conjurer le mauvais sort si l'on jette le bâtonnet au sommet d'un arbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "Aussi, on raconte que plus le bâtonnet se trouve haut dans l'arbre et plus vite les esprits feront leur travail. N'importe quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Cette histoire a tellement bien circulé que les gens se mettent non seulement à jeter leurs bâtonnets, mais également des moras dans les arbres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Ils croient que les divinités accepteront leur prière et la réaliseront, en plus de leur porter chance toute l'année s'ils arrivent à y loger une pièce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "C'est vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "Bien sûr que non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "Est-ce qu'ils croient que les divinités vont s'amuser à ramasser chaque mora pour savoir qui les a jetés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "Je comprends qu'ils veuillent mettre toutes les chances de leur côté, mais ils n'obtiendront rien comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "De plus, le vent transporte à la fois les présages et d'autres objets... Il y a donc des choses qui traînent partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "J'ai déjà essayé de les enlever, mais je ne suis pas très habile. Je n'ai pas réussi à atteindre les objets et je suis restée coincée en haut pendant un moment, car je ne savais pas comment descendre de là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "#Malgré tout, je ne peux pas laisser les choses telles qu'elles sont... Pourriez-vous m'aidez à nettoyer le toit, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "Je compte sur vous alors. Si vous trouvez des bâtonnets, ramassez-les et donnez-les-moi quand vous aurez terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "Que dois-je faire avec les bâtonnets ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Hmm... D'après mademoiselle Hotomi, ces bâtonnets représentent la fortune de chacun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "On ne peut pas les jeter comme ça, alors je les remettrai à leur place selon le rituel adéquat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "*soupir* Si tout le monde avait respecté ce rituel dès le début, on n'en serait pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "Je compte sur vous alors. Si vous trouvez des bâtonnets, ramassez-les et donnez-les-moi quand vous aurez terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "Pourquoi ne leur dites-vous pas que c'est faux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Il y a trop de personnes à qui le dire, je n'en peux plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
