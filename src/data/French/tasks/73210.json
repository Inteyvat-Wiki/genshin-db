			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Hmm... Je me demande quels trésors on va trouver ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "Le placard est rempli de cahiers. Vous les parcourez. Ils semblent être des documents d'hôpital tels que des dossiers médicaux et des registres comptables.\\nVous fermez le placard avec déception.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Hmph, et dire que je m'attendais à trouver un trésor unique là-dedans... J'aurais même préféré que ce soit un de ces tonneaux ou coffres en bois qu'on voit dans nos aventures ! Au moins, il y a des choux et de la volaille à l'intérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Hé, qu'est-ce que c'est ? On dirait que c'est tombé de là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Voyons voir... Peut-être qu'il y a un indice qui mène à un trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Ouah, l'éléazar a l'air d'être vraiment quelque chose d'horrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "Que dit l'autre document ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Hmm... Je ne comprends rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Moi non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Tout ce que j'ai réussi à comprendre, c'est quelque chose qui parle d'une voix de divinité qui montre la voie... Pourrait-il vraiment y avoir une voix étrange ici qui guide les gens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Peut-être qu'il s'agit de veines d'eau souterraines ou d'activités de créatures...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Oui ! Qui sait, il y a peut-être des ruines sous terre ! Si on entend des bruits, on n'aura qu'à aller voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "Peut-être est-il préférable de ne pas comprendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Hein ? Tu as compris ? Tout ce que j'ai réussi à comprendre, c'est quelque chose qui parle d'une voix de divinité qui montre la voie... Pourrait-il vraiment y avoir une voix étrange ici qui guide les gens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
