					}
				]
			},
			"dialogs": [
				{
					"id": 766500201,
					"content": "Nous y voilà. Le miroir de lune est devant vous. Il renferme une semblance lunaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500202,
					"content": "Cette statue doit être précieuse pour avoir été gardée là-dedans... Y a-t-il des pièges à l'intérieur ? Du style à tirer des flèches si on pose le pied au mauvais endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500203,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
