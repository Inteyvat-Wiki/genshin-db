			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME} et Paimon ? Quelle coïncidence ! Je savais que vous étiez à Nod-Krai, mais je ne pensais pas qu'on se reverrait aussi vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Je croyais que j'étais en train d'halluciner ! Que fais-tu aussi loin de chez toi, Varesa ? Tu voyages aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Héhé, plus ou moins ! Je suis ici pour acheter des machines agricoles pour le verger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Papa dit qu'il y en a de bonnes à Nod-Krai, elles permettent une meilleure croissance des fruits et m'évitent des efforts inutiles. Comme ça, j'aurai plus de temps pour dormir... et euh, m'entraîner, évidemment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "Quand je suis arrivée ici, j'ai découvert plein de bonne nourriture qu'on n'a pas à Natlan ! En dehors de mes affaires officielles, j'ai passé la majeure partie de mon temps à festoyer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "... C'est bientôt l'heure de rentrer à Natlan, mais je n'ai pas envie de partir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Du coup, je vais en profiter pour me promener tant que je le peux ! Goûter à tout ce que je n'ai pas encore goûté et voir tout ce que je n'ai jamais vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#Et vous deux ? Laissez-moi deviner... Notre {M#héros}{F#héroïne} {NICKNAME} va défendre la justice sur de nouvelles terres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "On se promène juste dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Oh, je comprends ! Il y a plein de choses à voir quand on arrive dans un nouvel endroit ! Ça donne envie de tout immortaliser avec son Daguerréotype, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "D'ailleurs... Rah ! J'aurais dû prendre plus de photos de tous les bons plats que j'ai mangés ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "J'aurais pu demander à oncle Atolli de les recréer, une fois rentrée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Qui sait ? Peut-être qu'une carrière de photographe culinaire t'attend ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Héhé, tu crois ? Moi, une photographie culinaire... Honnêtement, ça a l'air génial ! Être au contact de délicieux mets tous les jours, prendre des photos pour faire saliver les gens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Mais avant de prendre de la nourriture en photo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Hein ? Une photo de moi ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "Mes cheveux sont tous décoiffés, non ? J'ai encore de la sauce autour de ma bouche ? Ah, si j'avais su que je vous croiserais ici, j'aurais porté les accessoires que j'ai achetés au marché hier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Tu es très bien comme tu es !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "D'accord ! J—Je te laisse faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Ton sourire sera plus que suffisant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Pourrait-on te prendre en photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "Ah oui, on cherche de l'inspiration pour des photos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
