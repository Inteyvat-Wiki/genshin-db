			},
			"dialogs": [
				{
					"id": 721610301,
					"content": "Vous êtes de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610302,
					"content": "Problème réglé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "Euh... L'atmosphère est bizarre soudainement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610305,
					"content": "#Je m'excuse d'avoir dû demander à {M#un étranger}{F#une étrangère} de faire ce sale boulot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610306,
					"content": "Vous semblez bien poli d'un coup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610309,
					"content": "J'ai utilisé toutes les herbes médicinales que j'avais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610310,
					"content": "Je n'ai plus d'herbes pour panser ma plaie, mais elle est encore enflammée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610311,
					"content": "Mais... Pas besoin de vous inquiéter pour moi. Je peux tenir le coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610312,
					"content": "Occupez-vous de vos propres affaires, allez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610313,
					"content": "Vous êtes un véritable enfant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610315,
					"content": "Vous avez dit quoi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610316,
					"content": "J'ai dit que vous agissiez comme un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610317,
					"content": "Vous êtes clairement mal en point, et vous avez besoin d'aide et pourtant vous agissez comme si de rien n'était... Vous ne dites pas la vérité du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610318,
					"content": "Il n'y a que les enfants pour faire des choses comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610319,
					"content": "Et n'oubliez pas, monsieur Kyuuzou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610320,
					"content": "Vous nous en devez une.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "Hmpf... Vous deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610323,
					"content": "Alors aidez-moi à trouver des herbes à sanglots. On en voit partout sur l'île. Les feuilles entières sont les meilleures, à presser pour en faire une bouillie, puis à appliquer en externe pour l'anti-inflammation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610324,
					"content": "C'est tout. Je vais faire une sieste à présent, alors laissez-moi tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610321,
					"content": "Nous sommes là pour aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "Vos blessures vont mieux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Vous devriez avoir la paix pour un moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
