			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611301,
					"content": "#Vous êtes {M#étranger}{F#étrangère} ? Intéressant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611302
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611302,
					"content": "Si vous êtes touriste, vous êtes au mauvais endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611303,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "Quoi, vous travaillez pour le Shogunat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611305,
					"content": "Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "Alors occupez-vous de vos affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611307,
					"content": "Ce mec, si grossier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611308,
					"content": "Je suis envoyé par le Shogunat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "Hum... Vous, les étrangers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611310,
					"content": "Devant le Commissaire administratif, vous mendiez comme des chiens. Devant les samouraïs d'Inazuma, vous jouez les grands et les puissants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611311,
					"content": "Courant, espionnant partout, dérangeant tout le monde... Et maintenant vous venez jusqu'à ce bateau cassé, je ne sais pas pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611312,
					"content": "Eh bien, malheureusement, je ne suis qu'un soldat blessé. Il n'y a rien que je puisse faire pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611313,
					"content": "Alors s'il vous plaît, sortez avec vos propres jambes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611314,
					"content": "Ce mec ne peut pas du tout parler gentiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611315,
					"content": "Hé ! Vous produisez trop de bruits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611316,
					"content": "Avant que vous ne partiez, laissez-moi vous donner un conseil : ne restez pas trop longtemps sur l'Île de Yashiori. Cette île a été maudite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611317,
					"content": "Malédiction ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "Vous ne comprenez pas ? Cette île a été maudite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611319,
					"content": "La guerre, les désirs des seigneurs, le désespoir des personnes ordinaires, la haine des victimes innocentes, l'odeur des potions qui remplit les chambres des vieux mourants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611320,
					"content": "Bref, c'est une malédiction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611321,
					"content": "Partez avant de vous faire écraser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611322,
					"content": "Hum... Quelle personne étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
