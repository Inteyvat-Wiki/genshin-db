					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "#{M#Étranger}{F#Étrangère}, comment allez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610602,
					"content": "Désolé, ce n'est pas un endroit idéal pour accueillir des invités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610603,
					"content": "Mais... Je suis content que vous ayez pu venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610604,
					"content": "Vous vous portez mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Oui, je vous en dois une autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610606,
					"content": "Haha, dommage que j'ai encore survécu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610607,
					"content": "C'est une bonne chose, n'est-ce pas ? Qu'est-ce qui est dommage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "Vous allez faire quoi alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Je ne sais pas encore ce que je vais faire, mais je ne pense pas que je vais retourner chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610611,
					"content": "Kujou Masahito n'est pas une mauvaise personne, mais son père demande que les déserteurs soient arrêtés et punis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610612,
					"content": "Je ne peux pas me permettre de me faire attraper par son père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610613,
					"content": "Je vais peut-être mettre cette armure au placard. Ça a été agréable de vivre ici seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610614,
					"content": "Mais jusqu'à ce qu'on retrouve la paix, il ne faut pas que je me fasse d'illusion. Je sais que je suis toujours le même soldat blessé et taché de sang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610615,
					"content": "*soupir* Et qui sait ce qui se passera à l'avenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Comme je le disais, je n'ai jamais douté des décisions de Son Excellence, alors je pense que même si je mourais, je mourrais sans regret, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610619,
					"content": "Eh bien... Le sujet de la conversation est soudain devenu lourd...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "Ah, en parlant de ça, il est temps pour moi de rendre visite à mes anciens compagnons d'armes, qui sont toujours avec moi sur cette île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610621,
					"content": "Dans la tradition d'Inazuma, on offre aux camarades tombés au combat un dendrobium sanglant, c'est une fleur délicate et noble... Le symbole du destin de tous les samouraïs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610622,
					"content": "Au fait, si vous rencontrez mes anciens compagnons d'armes au cours de votre périple, arrêtez-vous un instant et faites connaissance avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Avez-vous déjà pensé à revenir chez vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
