					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "Cela va prendre beaucoup de temps pour écraser les herbes en pâte. Vous pouvez partir maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610506,
					"content": "Non, ne vous méprenez pas. Je ne vous chasse pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610507,
					"content": "Revenez plus tard. C'est bien d'avoir quelqu'un avec qui discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610508,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "#Prenez soin de vous, {M#étranger}{F#étrangère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610509,
					"content": "Prenez soin de vos blessures.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				}
			]
		},
