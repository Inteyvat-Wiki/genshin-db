			"dialogs": [
				{
					"id": 721610701,
					"content": "... Les rats par ici sont prêts à bouger à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610702
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610702,
					"content": "#Hé, {M#étranger}{F#étrangère}. Faites attention aux pirates si vous vous promenez par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610703
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610703,
					"content": "Merci pour le conseil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610704
					]
				},
				{
					"id": 721610704,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610705,
					"content": "Ils ne sont pas de taille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "Haha, vous ne manquez pas d'air, vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "Vous pourrez revenir dire ça quand vous les aurez tous chassés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610708,
					"content": "Marché conclu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "Je vous prends au mot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				}
			]
		},
