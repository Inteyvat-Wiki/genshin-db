			"dialogs": [
				{
					"id": 721611401,
					"content": "Encore vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611402,
					"content": "Je ne vous ai pas dit... *soupir* Oubliez ça, comme vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611403,
					"content": "N'abîmez pas mes affaires. Il y a encore assez de provisions à bord pour en partager avec vous. Lorsque vous êtes satisfait, partez rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611404,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "Non. Vous ne voyez pas que je me débrouille bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611406,
					"content": "Mais vos plaies...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "Ce sont mes plaies, pas les tiennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611408,
					"content": "Nous avons demandé par gentillesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Alors moi aussi, je vous répondrai par gentillesse : laissez-moi tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611410,
					"content": "Je peux vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "Comment ? En me livrant au Shogunat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611412,
					"content": "Haha, je vous conseille de ne pas faire de bêtises... Je serai traité comme un déserteur. Le seigneur Kujo ne montre jamais de pitié pour les déserteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611413,
					"content": "Excusez-moi, j'ai besoin d'être seul pendant un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
