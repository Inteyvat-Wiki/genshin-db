			"dialogs": [
				{
					"id": 740920101,
					"content": "Pourquoi... Pourquoi... Mince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "Mademoiselle Chronie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME} ! Vous êtes ici ! Tant mieux... Au moins... vous connaissez la vérité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Mademoiselle Chronie, calmez-vous. Que vous est-il arrivé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Même si... Même si mon reportage ne peut pas être publié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "Qu'est-ce qui se passe avec votre reportage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "Oui ! On se demandait quand l'article sortait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "Vous ne l'avez pas vu... Vous ne l'avez pas vu, oui, oui... Vous n'auriez pas dû le voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "Pourquoi vous... avez l'air paniquée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "Voilà... J'ai commencé la rédaction de mon article l'autre jour quand je suis rentrée de l'Institut de recherche de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "J'ai écrit tout ce que j'ai vu, entendu et ressenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "J'ai dit que l'Institut de recherche de Fontaine ne s'était pas débarrassé de tout l'arkhium, et au contraire, il a commencé un autre projet en rapport avec ce minerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Et qu'un ancien subordonné d'Edwin avait été envoyé pour explorer les décombres de l'Institut de recherche de Fontaine, mais qu'il est mort dans l'explosion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "Raimondo, le technicien aîné de l'Institut de recherche de Fontaine, refuse de reconnaître sa mort et déclare toujours que ces explosions étaient prévues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "Sans parler de la grande machine hors contrôle et les eaux contaminées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "J'ai parlé de tous les événements que l'Institut de recherche de Fontaine essaye de cacher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Mais... Juste après avoir rendu mon article, j'ai appris que l'Institut de recherche de Fontaine a porté plainte contre moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Selon le règlement du journal, tous mes articles en lien avec l'Institut de recherche de Fontaine doivent passer par un examen de crédibilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "Ce reportage sur l'Institut de recherche de Fontaine a également été rejeté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "Un examen de crédibilité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "Non, l'examen ne vise pas mes articles, mais ma propre personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "En bref, l'Institut de recherche de Fontaine m'accuse d'avoir traité le sujet de manière subjective en raison d'un conflit d'intérêts et de répandre des informations erronées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "Vous avez un conflit d'intérêts avec l'Institut de recherche de Fontaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Mais vous n'avez pris que des photos de pierres et d'une grosse machine immobile... Où est le « conflit d'intérêts » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "Parce que vous avez dévoilé leurs pratiques immorales ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Ils... m'ont accusée d'avoir divulgué leur dernier type de fonta qu'ils ont inventé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Les gens de l'Institut de recherche de Fontaine insistent sur le fait que certaines photos que j'ai prises dans les ruines le dévoilaient en partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Ils vont examiner toutes les photos. Pendant ce temps, la plainte de l'Institut de recherche de Fontaine sera maintenue et je devrais rester sous examen de crédibilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "C'est évident que l'Institut de recherche de Fontaine a trouvé ce moyen pour m'empêcher de publier mon reportage... Mais je n'abandonnerai jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "Tenez ça ! J'ai imprimé ces journaux secrètement et je les distribuerai plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Je dois dévoiler la vérité et le vrai visage de l'Institut de recherche de Fontaine, et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Mademoiselle Chronie ! Vous êtes encore ici, et je vous ai cherchée longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "Oh non ! Quelqu'un arrive, et je ne peux pas rester ici une seconde de plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Cet exemplaire est pour vous. Gardez-le bien. J'y ai écrit toute la vérité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "Selon les règles, vous devez maintenant vous rendre à la Maison Gestion pour votre examen quotidien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "Hein ! Ne partez pas, mademoiselle Chronie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "C'est juste du fonta. C'est peut-être un malentendu ! Si vous leur expliquez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "Attendez ! Mademoiselle Chronie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "Votre rédaction pense que votre reportage n'est pas crédible ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}