							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#{M#Loué}{F#Louée} soit {NICKNAME} ! Louée soit Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Ça fait longtemps que j'appelle à l'aide et personne ne répond. Les multipattes et les quatre-pattes ne m'ont pas répondu, et même les deux-pattes ont fait la sourde oreille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#Seules des personnes éclairées ont répondu à mon appel. Paimon en est une, et {NICKNAME} aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "Vous êtes la crème des deux-pattes. Vous êtes dignes de mes remerciements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "Héhé ! Attention, maintenant je suis éclairée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "Ce n'est rien, voyons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Je suis sûr qu'un jour viendra où les talents de {NICKNAME} et Paimon pourront être comparés aux miens ainsi qu'à ceux de mes semblables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "Une seconde, qu'est-ce que tu veux dire par là, Coupe-au-bol ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "Les multipattes sont inférieurs aux quatre-pattes, tout comme les quatre-pattes ne valent pas les deux-pattes. Naturellement, les deux-pattes sont inférieurs aux sans-pattes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "Bien que vous soyez faibles de naissance, en y mettant du cœur et des efforts, il ne vous sera pas impossible de changer le cours de votre destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "Tu ne manques pas de toupet pour un champignon lumineux, dis-moi ! Je me demande si les champignons fluorescents font de bons ingrédients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Ça pourrait être pas mal sur une brochette de poulet et de champignons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "Les champignons les plus jolis sont souvent les plus toxiques.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Tu es bien gourmande, Paimon. Lundi, des champignons. Mardi, des champignons. Mercredi, des champignons aussi... Et au bout de cent jours, on ne trouvera plus de Paimon ; il ne restera que des champignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#Brrr ! {NICKNAME}, Coupe-au-bol dit des choses qui font peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "Eh bah, tu n'as pas le sens de l'humour, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "C'est pas du tout drôle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Je suis libéré de l'énergie néfaste, mais les miens continuent d'en souffrir. Je n'ai plus la force aujourd'hui de fournir un refuge aux plus faibles comme je le faisais avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#{NICKNAME}, je te le demande sincèrement : sois {M#bienveillant}{F#bienveillante} et porte secours à ceux qui n'ont pas les moyens de se défendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#Tu veux dire qu'il y a d'autres champignons malades ? Et si on allait les aider, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610320,
					"content": "Tant qu'on y est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Si c'est sur notre route, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Alors, allons-y vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Ouah ! D'où sort cette boue noire ? C'est ça, l'énergie néfaste dont parle Coupe-au-bol ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
