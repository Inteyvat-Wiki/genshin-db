			"dialogs": [
				{
					"id": 710610201,
					"content": "Vous partagez l'énergie de l'Adjuvant avec Xamaran.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Ouah ! Coupe-au-bol se met à briller ! On devrait l'appeler « Coupe-au-bol fluorescente »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610203,
					"content": "#{M#Loué}{F#Louée} soit {NICKNAME} ! Louée soit Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610204,
					"content": "#Grâce à {NICKNAME} et Paimon, la flamme de la vie se remet à brûler en moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610205,
					"content": "Par contre, on ne peut pas se relâcher : je sais que la source de cette énergie néfaste est toujours présente et qu'elle peut nous envahir à tout moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610206,
					"content": "Hein ? Qu'est-ce qu'on doit faire, du coup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Ouah ! D'où sort cette boue noire ? C'est ça, l'énergie néfaste dont parle Coupe-au-bol ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
