				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#{M#Loué}{F#Louée} soit {NICKNAME} ! Louée soit Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "Même si c'est gênant, je dois vous parler franchement. Comme disent les deux-pattes : « Quand on aide quelqu'un, on l'aide jusqu'au bout ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "Tu vas encore nous faire courir, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "Les citations des humains fonctionnent-elles aussi dans le monde des champignons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "Quelle deux-pattes perspicace ! J'ai eu raison de dire que tu étais une personne éclairée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "On est tous deux des êtres vivants baignant dans les bienfaits de la terre. Il est naturel pour nous de nous entraider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Allez, prends cette bénédiction de sagesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Vous obtenez une bénédiction de sagesse.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Ah... C'est quoi, ça ? Ça a l'air assez louche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Il y a encore beaucoup d'énergie néfaste dans l'air. Je peux la sentir sans toutefois être capable d'en déterminer l'origine. En suivant le cours d'eau, vous pourrez sûrement la découvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}, en utilisant la bénédiction de sagesse sur la source d'énergie néfaste, mes semblables accourront pour résoudre le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "On ne peut pas laisser la source d'énergie néfaste sans surveillance, en effet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "Mais pourquoi n'y vas-tu pas toi-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#Tu as décidément plus d'humour que Paimon, {NICKNAME}. Je n'ai pas de pattes, contrairement à toi. Il est naturel que les tâches nécessitant des pattes ne soient pas faites pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "De plus, j'ai déjà une importante mission à remplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "Quel genre de mission importante ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#J'ai déjà dépensé beaucoup d'énergie. Ça a été un plaisir de parler avec vous, {NICKNAME} et Paimon, mais je dois maintenant me reposer et reprendre des forces pour repousser l'énergie néfaste et offrir une vie paisible à mes semblables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#{M#Béni}{F#Bénie} soit {NICKNAME}, bénie soit Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "Hé, Coupe-au-bol ! Hé oh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, Coupe-au-bol s'est endormi. Allons-nous-en.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Ouah ! D'où sort cette boue noire ? C'est ça, l'énergie néfaste dont parle Coupe-au-bol ?",
