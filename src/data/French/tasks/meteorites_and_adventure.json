				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "Ah, si seulement je pouvais aller voir ce qu'il se passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ah, c'est toi. Rien de spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "En fait, si. Quelque chose me turlupine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Les météorites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Oui ! Tu les as vues, pas vrai ? Il en pleut depuis un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Grâce à l'Archon Anémo... ou par chance, aucune d'entre elles ne s'est écrasée dans la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Mais certaines ont atterri à l'extérieur, puis on raconte que tous ceux qui les touchent s'endorment profondément et qu'il est impossible de les réveiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Cyrus a envoyé certains membres de la Guilde pour retrouver ceux qui seraient restés dehors et leur dire de se réfugier dans la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "D'autres ont été chargés d'aider l'Ordre de Favonius à déterminer l'emplacement des météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Ceux-ci apportent aussi leur aide dans les missions de recherche et de sauvetage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Quant à moi, Cyrus m'a demandé de rester dans la cité pour veiller sur les personnes endormies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Je sais que je ne suis pas à la hauteur comparé aux autres, mais si on ne me confie que des tâches comme celle-ci, je ne pourrais jamais devenir plus fort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "*soupir* Je dois faire ce qu'on me demande malgré tout... Dis-moi, tu pourrais me faire une fleur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "J'aimerais que tu me permettes de rassembler des informations sur les météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "Pour quelle raison ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Cyrus dit toujours qu'il faut bien se préparer avant de partir à l'aventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Si je lui montre que c'est le cas en connaissant les enjeux sur le bout des doigts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Peut-être qu'il me laissera participer à l'enquête avec les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Mais je suis coincé ici pour le moment, alors impossible d'aller à la pêche aux informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "S'il te plaît, mène l'enquête pour moi ! Tu n'as pas besoin d'aller bien loin, le Bois aux Murmures fera très bien l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Tiens-moi au courant si tu trouves quelque chose. Tout repose sur toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Tu veux y aller en douce, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Hein ? Quoi ? Mais non, pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Bien sûr que j'aimerais participer à l'enquête, mais on a besoin d'aide ici aussi ! Je ne peux pas filer comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "C'est juste que Cyrus dit toujours qu'il faut bien se préparer avant de partir à l'aventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Si je lui montre que c'est le cas en connaissant les enjeux sur le bout des doigts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Peut-être qu'il me laissera participer à l'enquête avec les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Mais je suis coincé ici pour le moment, alors impossible d'aller à la pêche aux informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "La promo pour l'anniversaire du Bon Chasseur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Quoi ?! Ils ont une promo aujourd'hui ? Je ne le savais pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Hum, ce n'était pas ce dont je voulais parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Il pleut des météorites depuis un moment. Tu ne les as pas loupées, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250112,
					"content": "Grâce à l'Archon Anémo... ou par chance, aucune d'entre elles ne s'est écrasée dans la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				}
			]
		},
