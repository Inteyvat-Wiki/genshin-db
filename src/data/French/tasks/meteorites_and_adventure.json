			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Je crois que j'ai réussi à leur fausser compagnie, mais que se passe-t-il ici au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250202,
					"content": "Tu es venu enquêter sur les météorites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Oui, je suis en mission pour la Guilde des aventuriers. Je dois enquêter sur les phénomènes liés à ces météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250204,
					"content": "Mais les monstres qui se trouvent près des zones d'impact ont soudainement commencé à se comporter étrangement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250205,
					"content": "Que ce soit leur force ou leurs mouvements, il y a quelque chose qui cloche chez eux. Et en plus, ils sont plus nombreux que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250206,
					"content": "Ils m'ont repéré alors je n'ai pas osé rester. J'ai dû emprunter un raccourci pour les semer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250207,
					"content": "Je dois signaler ça à Cyrus immédiatement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250208,
					"content": "Tu as remarqué autre chose de particulier ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Hum, il y a des chercheurs qui refusent de retourner en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250210,
					"content": "Ils sont têtus comme des mules. Je ne suis pas arrivé à les convaincre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250211,
					"content": "On n'est déjà pas assez nombreux chez les aventuriers alors on ne peut pas venir ici les rappeler à l'ordre tous les jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250212,
					"content": "Quel casse-tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 411250213,
					"content": "Toi aussi, tu ferais mieux d'aller te réfugier dans la ville si tu n'as rien d'autre à faire ici. Ce n'est pas le moment de traîner dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad"
				}
			]
		},
