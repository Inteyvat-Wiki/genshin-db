					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "#Salut à vous, {M#étranger}{F#étrangère} à la chevelure dorée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820102,
					"content": "Comme on se retrouve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "Cette chevelure blonde me paraît familière... Est-ce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820105,
					"content": "Mais oui ! C'est vous la « Tornade dorée » qui s'est illustrée au dernier Hyakunin Ikki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820106,
					"content": "La tornade dorée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "La dernière fois, j'ai assisté au tournoi dans un coin du dojo en observant la performance de tous les participants dans le but de trouver l'inspiration grâce au spectacle. Votre posture au combat était telle une tornade dorée qui rasait l'herbe et balayait ses adversaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820108,
					"content": "Arrêtez vos flatteries...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "En tout cas, un nouveau Hyakunin Ikki a été organisé récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820114,
					"content": "D'ailleurs, d'où est-ce que ça vient ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "C'est un tournoi pendant lequel les gens ont l'habitude de se lancer dans des combats acharnés que ce soit pour célébrer ou se débarrasser de la malchance. Artistes martiaux et monstres mettent leurs identités et différends de côté pour profiter de la pure joie que ça leur procure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820116,
					"content": "On raconte que toutes sortes de trésors vous attendent si vous arrivez à démontrer votre talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820117,
					"content": "Cependant, le mystère reste entier quant à l'identité des organisateurs et des sponsors de l'événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820119,
					"content": "Mais ce n'est pas vraiment un sujet à aborder dans un endroit très fréquenté. Suivez-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820118,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "Mais encore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "#Ahem... « Les spectateurs aux yeux aussi vifs que des épéistes l'eurent remarqué : l'{M#étranger}{F#étrangère} à la chevelure blonde libéra le Kouranka Daitatsumaki, une technique considérée interdite, même dans les arts martiaux anciens ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820111,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "C'est un passage que vous m'avez inspiré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820103,
					"content": "Vous avez une mission pour moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
