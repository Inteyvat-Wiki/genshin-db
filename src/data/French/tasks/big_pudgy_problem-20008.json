			"dialogs": [
				{
					"id": 200080101,
					"content": "Merci beaucoup ! Vous me sauvez la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Je ne pensais pas tomber sur des Blobs dans les environs, mais ceux-là sont sortis de nulle part... Ils m'ont encerclé avant que je puisse faire quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "N'allez pas le raconter à mon père, s'il vous plaît. Il m'a répété plein de fois que les Blobs du coin sont devenus plus dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Mais aujourd'hui, j'ai réussi à m'éclipser pour me dégourdir les jambes après tant de jours passés à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Rendez-moi un service, s'il vous plaît. Regardez si la voie est libre, sinon éliminez les Blobs pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Génial ! Je peux continuer à me promener tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "J'ai autre chose à faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "M—Mais je ne peux pas demander de l'aide à mon père ! Pitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
