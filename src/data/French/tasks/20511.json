						205110402
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110402,
					"content": "Et voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "C'est ça ? Ça n'a pas l'air bien différent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110404,
					"content": "On dirait juste une baie ordinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110405,
					"content": "Peu importe. Puisque ce sont les conseils du médecin, autant suivre l'ordonnance à la lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110406,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Tenez, pour vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110407,
					"content": "J'aurai peut-être encore besoin de votre aide plus tard... Je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
