				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Est-ce que ce médicament marchera...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "#Ah, {M#voyageur}{F#voyageuse}, vous tombez à pic. Je suis bien embêté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Vous vous souvenez de ma sœur Anna, qui est malade ? On n'a encore rien trouvé qui puisse la guérir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Mais j'ai entendu parler d'un célèbre médecin vivant au Port de Liyue, capable de guérir même les plus incurables... Alors j'ai demandé à quelqu'un de s'y rendre et de me ramener une ordonnance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Les ingrédients qui y sont mentionnés sont assez étranges... Mais j'imagine que ça vaut le coup d'essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Voyons voir... Seriez-vous assez aimable pour aller me trouver une, hum, baie ingérée par un Dendroblob ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "... Ça existe vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "À dire vrai ça ne me parle pas plus qu'à vous ! Les Dendroblobs mangent des baies...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Enfin, est-ce que vous pouvez voir ce que vous pouvez faire ? Je connais un endroit où on trouve des baies, et des Dendroblobs, justement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Ça vous dérangerait d'aller y jeter un œil ? On ne sait jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Ce docteur est un charlatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Vous pensez ? Mais... Je n'ai pas d'autre choix ; je dois essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Je connais un endroit où on trouve des baies, et des Dendroblobs, justement. Pourriez-vous aller jeter un œil quand même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "Je goûterai d'abord le médicament qu'on en tirera. Je ne peux pas prendre le risque que la santé d'Anna se détériore davantage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Je pourrais vous trouver un Dendroblob et...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Hein ? Quoi ? Vous voulez que je le force à avaler des baies moi-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Non merci ! La dernière fois que je suis parti chercher des herbes pour Anna, une bande de Dendroblobs m'a chassé jusqu'à Deauclaire... Ça m'a suffi, croyez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Je connais un endroit où on trouve des baies, et des Dendroblobs. Allez y faire un tour, d'accord ? J'espère que vous trouverez quelque chose d'intéressant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Mais si... si vraiment vous ne trouvez rien du tout, alors... Pour Anna, a—attrapez un Dendroblob et ramenez-le. Je... Je peux y arriver. Je dois y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
