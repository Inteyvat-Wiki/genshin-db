					"nextDialogs": [
						740241604
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241604,
					"content": "Euh... Ce n'est pas tout à fait vrai. On les appelle comme ça parce qu'elles se forment près des coraux.",
