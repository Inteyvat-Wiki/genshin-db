			"dialogs": [
				{
					"id": 740241601,
					"content": "Oh, c'est une perle ! Mais elle est un peu différente de celles que j'ai vues auparavant. Elle me donne une sensation de... froid, en quelque sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241602
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241602,
					"content": "#Haha. Ce n'est pas une perle ordinaire. C'est une perle Sango ce qui signifie «{NON_BREAK_SPACE}perle de corail » !",
					"roleType": "TALK_ROLE_NPC",
