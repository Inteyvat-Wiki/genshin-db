						740240701
					]
				},
				{
					"id": 740240701,
					"content": "#Merci beaucoup. Avec cela, je suis sûre que je pourrai faire des pigments «{NON_BREAK_SPACE}aussi brillants que le soleil », que je pourrai ensuite lui offrir en cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240702
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240702,
					"content": "Ça va vraiment fonctionner...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "Ou plutôt, peut-on vraiment créer des « couleurs vives » avec de tels matériaux de base ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "Je crains que non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Mais Sluasi a l'air heureuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "#Quoi qu'il en soit, je vous remercie {M#tous}{F#toutes} les deux pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Veuillez accepter ceci en remerciement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "Des gemmes brillantes, et des composants aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Haha. Je suis contente qu'ils vous plaisent. Si vous désirez des ornements à l'avenir, vous savez où me trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Ce n'est pas totalement impossible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "C'est vrai que les couleurs utilisées par Mamère sont assez bizarres aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
