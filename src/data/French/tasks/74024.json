			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi inspecte soigneusement le matériau avant de vous le rendre...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Ah, je vois, c'est donc la couleur que vous appelez « blanc », c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "#Je ne peux pas m'empêcher de penser que c'est l'exact opposé de ce qu'est la «{NON_BREAK_SPACE}couleur du soleil ». Son contraire n'aurait-il pas plus de sens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "Son « opposé »... Vous voulez dire noir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "« Noir »... Oui, ça doit être ça. « Noir », je trouve ça brillant. Ce doit être la couleur du soleil en effet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "#Hmm... Je ne suis pas vraiment {M#convaincu}{F#convaincue}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Mais pourquoi noir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Eh bien, le soleil est doré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "Dans ce cas, puis-je vous demander encore une chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Pourriez-vous m'apporter quelque chose de « noir », s'il vous plaît. Ainsi, je saurai quel matériau je dois utiliser pour créer « une couleur aussi rayonnante que le soleil ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "V—Vraiment ? Je pense qu'on s'éloigne de plus en plus de tout ce qui est associé au soleil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "Mais puisque c'est ce qu'elle nous a demandé... Allons lui trouver quelque chose de « noir », d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "Alors si c'était le soleil la nuit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Le soleil ne devient pas noir la nuit ! Il n'y a même pas de soleil la nuit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Merveilleux et digne de ta part, chère Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "Hé, arrête avec ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
