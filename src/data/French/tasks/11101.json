					"nextDialogs": [
						111011104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011104,
					"content": "Ces Brutocollinus démoniaques qu'on a vus... C'était peut-être ces mutations qui en sont la cause, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
