			},
			"dialogs": [
				{
					"id": 111010701,
					"content": "Je ne comprends pas... Pourquoi le talisman de permission n'a-t-il pas fonctionné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010702,
					"content": "Est-ce que l'esprit maléfique de ces Brutocollinus s'intensifie...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010703,
					"content": "Le talisman de permission, hein ? Pourquoi ça me rappelle quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "C'est la carte de libre accès au Karst Jueyun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Correct ! C'est une relique des Adeptes. Il doit donc encore y avoir des traces de leur pouvoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "Pas étonnant qu'il ait réussi à effrayer ces monstres la dernière fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "Que... Qu'est-ce vous racontez, vous deux ? J'ai juste un peu mal dormi... ce qui signifie que ma puissance d'Adepte n'est pas à son plein potentiel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010709,
					"content": "Mais si j'avais une autre chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010710,
					"content": "Ça tombe bien, il y a un autre groupe de Brutocollinus maléfiques là-bas. On vous les laisse, alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Je... Je ne me sens pas bien d'un coup. J'ai sûrement abusé de mes pouvoirs d'Adepte, sinon j'aurais purgé la zone de ces êtres infernaux en un rien de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010712,
					"content": "Ugh, ce n'était donc que des paroles. Nous avons eu raison de nous méfier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "#Allons-y {NICKNAME}, on dirait bien qu'on ne peut compter que sur nous-mêmes. Utilise ta vue élémentaire et allons les chasser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "C'est donc ce qu'il utilisait pour les exorcismes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
