			"dialogs": [
				{
					"id": 111010501,
					"content": "Entendez mes paroles... Démons, fuyez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010502
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010502,
					"content": "Fuyez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010503,
					"content": "Pourquoi... pourquoi vous ne fuyez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010504,
					"content": "Beru nye ! Beru nya ! Beru nyaaaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010505
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 111010505,
					"content": "Oh oh, on dirait que Céleste a des problèmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010506
					],
					"speakerTitle": "Paimon"
				},
				{
