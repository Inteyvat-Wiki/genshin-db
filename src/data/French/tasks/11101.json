			},
			"dialogs": [
				{
					"id": 111010201,
					"content": "Alors, vous ne prenez que celui-ci, « Les Yakshas, gardiens Adeptes » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010202,
					"content": "Oui... Voilà pour vous, et gardez la monnaie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111010203,
					"content": "Oh, comme c'est généreux... Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010204,
					"content": "Hé, ne serait-ce pas, hum... le « Céleste voleur d'érable » ? Quelle coïncidence de tomber encore sur lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010205,
					"content": "C'est le « Céleste voleur d'étoiles »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "Je crois que le livre qu'il vient d'acheter s'appelle... « Les Yakshas, gardiens Adeptes », non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010208,
					"content": "Enfin, peu importe, c'était définitivement un livre à propos des Adeptes. Mais pourquoi un Adepte voudrait-il acheter un livre à propos de lui-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010209,
					"content": "Je l'ai toujours trouvé louche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "Vraiment ? Qu'est-ce qu'il a de si louche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010214,
					"content": "Pourquoi un Adepte aurait-il besoin de moras ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "Huh, tu marques un point... Aucun des autres Adeptes que nous avons rencontrés n'avaient l'air d'avoir besoin de quoi que ce soit de quiconque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010220,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010221,
					"content": "Je pense qu'on devrait jeter un œil à ce livre. On pourra peut-être y trouver quelque chose à propos de ce type !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010216,
					"content": "Je pense que c'est un charlatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "Tu veux dire... qu'il ne peut pas exaucer de souhaits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010218,
					"content": "Son masque est tellement moche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "C'est vrai, il est vraiment moche. C'est très louche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010211,
					"content": "Peut-être qu'il est narcissique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "C'est possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010213,
					"content": "Mais maintenant que j'y pense, il y a quelque chose qui cloche avec ce type.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010206,
					"content": "Coïncidence, ou Adeptincidence ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
