				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "#Bonjour ! {M#Intéressé}{F#Intéressée} par une partie de Théâtre mécanique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "Le « Théâtre mécanique » ? C'est quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Oh, vous ne connaissez pas ? Alors, je vous explique : le Théâtre mécanique, c'est une sorte de jeu de plateau que j'ai inventé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Vous voyez les pièces posées sur la table ? Elles représentent les éléments que vous pouvez utiliser dans le jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Ça a l'air compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "Seulement en apparence ! C'est en fait très simple. Il suffit de quelques parties pour se familiariser avec les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Qu'en dites-vous ? Une petite partie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Et combien ça va me coûter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "Ne vous en faites pas. C'est le Festival des lanternes après tout ! Je veux simplement voir ce que les gens pensent de mon jeu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "Donc, cela ne vous coûtera qu'une lanterne céleste par partie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "Si vous voulez jouer, il vous suffit de m'apporter une lanterne céleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "Alors ? Vous voulez essayer ? Allez, la première partie est gratuite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "Ça a l'air onéreux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
