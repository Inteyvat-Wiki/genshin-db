			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "C'est lui. C'était son sang. Méchants hommes ont fait ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541302,
					"content": "C'est terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541303,
					"content": "Pauvre bête, mais ça ne change rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541304,
					"content": "On n'a pas attaqué le village ! C'était pas nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541305,
					"content": "C'était un loup noir et sa meute, des étrangers. Ils voulaient le territoire. Ils ont cassé le code.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>Le code de qui ?</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541307,
					"content": "Du maître du territoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541308,
					"content": "C'est la deuxième fois que tu le mentionnes. Tu ne peux pas nous dire qui c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541309,
					"content": "Je dois mener mon lupical plus loin. Suivez-moi, peut-être que vous verrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
