			"dialogs": [
				{
					"id": 4540601,
					"content": "Du calme, s'il te plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540602
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540602,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540603,
					"content": "Ce petit a raison. Une meute de loups qui vient d'ailleurs sème la zizanie sur notre territoire... mais ils récolteront bientôt ce qu'ils ont semé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540604,
					"content": "Razor, tu ne devrais pas te mêler à ce conflit. Il appartient aux loups de le régler entre eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540605,
					"content": "Contrairement aux loups qui se battent avec leurs griffes et leurs crocs, tu te bats avec une épée et la foudre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540606,
					"content": "Tu es humain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540607,
					"content": "Je ne suis pas des leurs ! Nous ne sommes pas pareils !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540608,
					"content": "Ça ne change rien au fait que tu ne sois pas un loup, Razor. Tu dois les laisser régler leurs comptes entre eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540609,
					"content": "Mais tu n'es pas non plus un humain ordinaire. Tu es un lupical. Ceci est un grand honneur et fait de toi quelqu'un de très spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540610,
					"content": "Je pourrais me charger de ton entraînement si le cœur t'en dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540611,
					"content": "C'est tout ce que j'avais à dire. À la prochaine, Razor et compagnie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 4540612,
					"content": "Allez, ne fais pas cette tête, Razor ! Tu pourrais rester quelques jours à Mondstadt avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540613,
					"content": "Oui, viens ! T'as une amie là-bas, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540614,
					"content": "Cette fille en rouge très flambante ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540615,
					"content": "Tu n'es pas en sécurité ici avec ces gens qui veulent te faire du mal, même si tu ne leur en veux aucun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540616,
					"content": "J'irai bien, pas d'inquiétude. Ma place n'est pas dans la... cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540617,
					"content": "Ni ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540618,
					"content": "Pauvre Razor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#Merci {NICKNAME}, Paimon et fille en rouge nº2.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540622,
					"content": "Ça fait une éternité qu'on cause et tu ne sais pas comment je m'appelle ?! C'est Amber ! A-M-B...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540623,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540619,
					"content": "Allez, ne sois pas triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
			]
		},
