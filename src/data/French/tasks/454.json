			"dialogs": [
				{
					"id": 4540101,
					"content": "C'est qui ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540102,
					"content": "Calme-toi, Razor. C'est nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540103,
					"content": "Tu es aussi chevalier de l'Ordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540104,
					"content": "Vous ne vous connaissez vraiment pas ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540105,
					"content": "La fille en rouge très flambante ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "Non, je ne la connais pas. Cette fille est aussi rouge, mais pas aussi flambante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540108,
					"content": "Je crois que je comprends maintenant. C'est de lui dont tu me parlais, Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540109,
					"content": "Oui, il s'appelle Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540110,
					"content": "Aidez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540111,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540112,
					"content": "Pas le temps d'expliquer. J'ai dispersé mon lupical. Les méchants vont encore venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540113,
					"content": "Ceux de tout à l'heure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540114,
					"content": "D'accord, mais j'aurais quelques questions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540115,
					"content": "*sniff* L'odeur du sang. Vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540116,
					"content": "Du sang ?! J'espère que les loups n'ont pas attaqué ces imbéciles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540106,
					"content": "Ce n'était pas d'Amber dont tu nous parlais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
