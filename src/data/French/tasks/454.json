				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "On est de retour ! Il y en a assez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Razor me parlait du code de conduite des loups. Incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "On a cherché partout, mais il n'y a pas d'autre loup dans les parages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4540307,
					"content": "Oui, c'est souvent comme ça avec ces bêtes. Celui qu'on vient d'attraper ne doit pas être très futé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "Qui va là ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4540309,
					"content": "Vous allez payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "C'est le garçon loup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4540312,
					"content": "Alors c'était toi qui étais derrière l'attaque ? Les loups ne sont pas assez intelligents pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4540313,
					"content": "Je n'arrive pas à croire que tu aies pu nous faire ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4540314,
					"content": "Ils n'ont qu'à te donner à manger pour que tu les traites comme ta famille ? Tu as oublié ce que tu es ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4540315,
					"content": "Stop !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Ouais ! Vous ne pouvez pas vous en prendre à Razor comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "L'Ordre de Favonius protège donc ce genre de scélérat ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "C'est pas nous qui avons attaqué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
