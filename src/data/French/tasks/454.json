			"dialogs": [
				{
					"id": 4541501,
					"content": "Où est-on ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}, aide-moi d'accord ? Rassemble ça pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541503,
					"content": "Des graines de baie à crochet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541504,
					"content": "Leur poudre arrête le saignement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541505,
					"content": "Tu as raison, ces graines sont recouvertes d'un liquide aux propriétés antalgiques et hémostatiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541506,
					"content": "... J'ai lu ça dans un livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541507,
					"content": "Comment ça se fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541508,
					"content": "Aucune idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541509,
					"content": "Les crochets aident la distribution des graines, et le liquide arrête douleur et saignements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541510,
					"content": "Les animaux ne voient pas les crochets, et emportent les graines loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541511,
					"content": "Le professeur violet me l'a dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541512,
					"content": "Je reste ici pour en prendre soin, et pour donner des réponses à la fille en rouge nº2.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541513,
					"content": "Bonne idée. Je ne crois pas qu'ils feront les malins avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541514,
					"content": "#Votre ami n'est pas encore blanchi de tout soupçon ! Mais on a vraiment besoin de ces graines, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
