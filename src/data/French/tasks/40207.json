			"dialogs": [
				{
					"id": 402070201,
					"content": "Bonjour, Ineffa... Oh, tu es encore là, Jahoda ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070202,
					"content": "Après tout ce travail, je mérite bien une part de gâteau, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070203,
					"content": "Du gâteau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070204,
					"content": "#Vous tombez bien, {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070205,
					"content": "#Aino voulait que vous goûtiez aux desserts de Kniep-clang 70 % sucré maintenant qu'il a été secouru pour {M#tous}{F#toutes} vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070206,
					"content": "Clang... Clang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "Kniep-clang 70 % sucré"
				},
				{
					"id": 402070207,
					"content": "Ouah, c'est à ça que Kniep-clang ressemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070208,
					"content": "Oui. Heureusement que le noyau était intact. Aino n'a eu qu'à lui fabriquer un nouveau corps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070209,
					"content": "Clang... Clang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "Kniep-clang 70 % sucré"
				},
				{
					"id": 402070210,
					"content": "Ooh, c'est prêt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070211,
					"content": "*om nom nom* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "Kniep-clang 70 % sucré"
				},
				{
					"id": 402070212,
					"content": "Hé, il a tout mangé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070213,
					"content": "C'est normal qu'un chef goûte à son plat avant de le servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070214,
					"content": "Ne vous inquiétez pas. Quand il aura assez mangé, il pourra en préparer pour tout le monde. Ça ne prendra qu'un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070215,
					"content": "En parlant de desserts... Où est passée Aino ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070216,
					"content": "Aino a eu une idée pour un nouveau robot, alors elle s'est enfermée dans l'atelier pour travailler dessus. C'est quelqu'un qui passe à l'action dès qu'elle a de l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070217,
					"content": "Pourquoi Aino aime-t-elle tant fabriquer des robots ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070218,
					"content": "Hm... Récupération d'archives historiques de la banque de données...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070219,
					"content": "Au début, je pense qu'Aino était surprise de trouver quelque chose qui la fascinait encore plus que les desserts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070220,
					"content": "Elle a eu de la chance. Ses amis respectaient sa passion, même si elle n'avait pas beaucoup de temps à y consacrer, parce qu'elle était occupée à essayer de joindre les deux bouts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070221,
					"content": "Un jour, un enseignant exceptionnel l'a découverte et a reconnu sa passion pour ce que c'était vraiment : du talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070222,
					"content": "Tout comme ses amis, elle a fini par trouver sa voie, qui plus est dans un domaine où elle excelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070223,
					"content": "Et lorsque le génie et la passion se rencontrent, il n'y a pas grand-chose qui puisse les arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070224,
					"content": "Aino a quitté ses amis d'enfance pour fonder la Knieperterie Cling-clang et fabriquer toutes sortes de robots compagnons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070225,
					"content": "C'est peut-être de l'instinct d'un génie... que de voir son imagination prendre vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070226,
					"content": "Oh... C'est ce qui l'a attirée vers la robotique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070227,
					"content": "D'après mon vécu avec Aino, je pense que c'est plus que ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070228,
					"content": "Avant qu'elle ne me recueille, elle faisait déjà tout pour donner une personnalité distincte à chacun de ses robots. Elle les traitait déjà comme ses amis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070229,
					"content": "Je veux dire que ce n'est pas avec moi qu'elle a commencé, juste parce que j'ai des origines particulières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070230,
					"content": "Après avoir été considérée comme un génie pendant aussi longtemps, elle a réalisé que personne n'était à ses côtés, et s'est sentie très seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070231,
					"content": "Kniep-clang, les robots de l'atelier et moi-même ne sommes pas seulement une preuve de son ingéniosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070232,
					"content": "Nous sommes sa famille. Nous lui apportons la compagnie qu'elle désire tant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070233,
					"content": "C'est comme ça que je comprends la relation entre Aino et ses robots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070234,
					"content": "Ouah, vous comptez vraiment beaucoup pour elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070235,
					"content": "Oui. C'est pour cette raison qu'Aino ne se soucie pas de la puissance que Kniep-clang pourrait avoir, d'à quel point sa technologie pourrait effrayer ou être convoitée par les factions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070236,
					"content": "Elle a décidé qu'il faisait partie de sa famille, alors elle aurait tout fait pour le sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070237,
					"content": "Ça tombe sous le sens ! Mais je me demande pourquoi quelqu'un comme Aino choisirait d'habiter à Nod-Krai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070238,
					"content": "... J'ai bien peur que mon module de logique ne puisse pas apporter de réponse à cette question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070239,
					"content": "Je trouve que Nod-Krai est un lieu hostile où la loi du plus fort règne. Personne n'est à l'abri de se faire trahir. Les gens qui arrivent à prospérer ici doivent être faits pour ce genre d'environnement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070240,
					"content": "N'importe qui d'autre utiliserait la technologie d'Aino pour fabriquer des armes et menacer les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070241,
					"content": "Mais Aino... prend quelque chose qui pourrait être une arme et la transforme en un robot qui fait des gâteaux... Elle n'a pas l'air d'être faite pour cet endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070242,
					"content": "À vrai dire, je pense le contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070243,
					"content": "J'ai rencontré beaucoup de gens à Nod-Krai. Mais d'après mon expérience, peu d'entre eux représentent vraiment cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070244,
					"content": "Vous dites qu'Aino n'a pas l'air d'être à sa place ici, Paimon. Mais si je devais définir ce que devrait être une personne de Nod-Krai, Aino est la personne qui s'en rapprocherait le plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070245,
					"content": "Ding... Ding...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "Kniep-clang 70 % sucré"
				},
				{
					"id": 402070246,
					"content": "Ooh, les desserts sont prêts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070247,
					"content": "Oui, un instant. Je vais les servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070248,
					"content": "Je veux celui avec le plus de crème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070249,
					"content": "C'est prêt. Régalez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070250,
					"content": "... C'est trop bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}