						721411204
					]
				},
				{
					"id": 721411204,
					"content": "Il est maussade, et il va se mettre en colère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411205,
					"content": "Quoi ?",
