			"dialogs": [
				{
					"id": 721410101,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410102,
					"content": "Bonjour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410106,
					"content": "Vous m'écoutez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410108,
					"content": "Euh, bonjour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "... Ne me dérangez plus, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410111,
					"content": "« Il » n'est pas content, avec la perturbation causée par les mots de la langue, noyant la sagesse des « mots du cœur ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410112,
					"content": "Mots de la langue...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "Les mots de la langue sont comme la pluie qui tombe à verse, elle fait gronder les tympans et perturbe le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410114,
					"content": "Et les « mots du cœur » sont comme le brouillard, ils s'infiltrent et enveloppent l'esprit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410116,
					"content": "Chut...! « Il » écoute, « il » est en train de parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410117,
					"content": "N'utilisez pas la langue, n'utilisez pas les oreilles, écoutez avec le cœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410118,
					"content": "Venez ici, vénérez, priez, et puis écoutez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410119,
					"content": "Il faut vénérer trois fois, n'oubliez pas, trois fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410120,
					"content": "(Essayer.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "Euh... Non, merci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "Hochez la tête si vous pouvez parler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
