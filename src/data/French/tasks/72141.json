			"dialogs": [
				{
					"id": 721411701,
					"content": "Il faut apaiser sa colère... Il faut le calmer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411702,
					"content": "Vous avez fait du bon travail, bravo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411703,
					"content": "N'oubliez pas que certaines personnes vous tromperont en portant des masques, mais « il » vous aidera. « Il » vous aidera toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "Cette femme est comme les Kitsunes démoniaques des légendes. Je l'ai laissée partir une fois, et « il » est très en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "« Il » est encore en colère... C'est ma faute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "S'il vous plaît, pardonnez-moi... Je me sacrifierai à nouveau. Je trouverai un sacrifice pour le « retour »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411709,
					"content": "Pardonnez-moi, pardonnez-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411710,
					"content": "Pardonnez-moi, pardonnez-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
