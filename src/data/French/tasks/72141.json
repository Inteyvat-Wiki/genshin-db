					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "Et pourquoi ? À cause de cette femme ! Celle qui refuse de payer le tribut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411208,
					"content": "Cette femme...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "Elle s'enfuit, mais comment lui échapper ? Dix-huit paires d'yeux sanglants ! Des milliers de crocs acérés ! D'innombrables bouches et langues qui sont avides de sang !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411211,
					"content": "Elle ne peut pas se cacher, elle ne peut pas se cacher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411212,
					"content": "Ah, le pays du désert, l'humble mendiante qui prétend à la sagesse dans la forêt, aucun de vous ne peut la protéger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411213,
					"content": "Calmez-vous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "Vous avez la bénédiction, allez-y et vénérez ! Allez-y, vénérez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411214,
					"content": "Oui, bien dit !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "Oui, maudite soit-elle, hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
