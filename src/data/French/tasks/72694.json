				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "#{M#Voyageur}{F#Voyageuse} et Paimon, pile là quand j'ai besoin de vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940102,
					"content": "Besoin de nous pour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "#Pour une mission que vous {M#seuls}{F#seules} pouvez accomplir ! J'étais sur le point de vous contacter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940104,
					"content": "Qu'est-ce que ça veut dire ? Ne me dis pas que tu souhaites qu'on retrouve un objet ou qu'on se débarrasse de Brutocollinus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "Ou qu'on ramasse des déchets sur les toits...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "#Ne vous méprenez pas, quand je dis que vous {M#seuls}{F#seules} pouvez l'accomplir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940108,
					"content": "C'est qu'il s'agit d'une mission intéressante avec de généreuses récompenses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940109,
					"content": "Super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Il n'y a que les moras qui t'intéressent dans cette histoire, on dirait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "P—Pas du tout ! C'est très important qu'elle soit intéressante cette mission ! D'ailleurs, qu'est-ce qu'on doit faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "Le commanditaire est un fabricant de jouets originaire de Fontaine qui s'appelle Bertrand. Il souhaite faire affaire à Inazuma et cherche un assistant pour l'aider dans son travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940113,
					"content": "Les récompenses qu'il a promises pour cette mission quand il est venu voir la Guilde sont aussi généreuses en raison de sa profession.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940114,
					"content": "Cependant, il ne peut pas quitter Ritou pour l'instant. Vous pouvez lui rendre visite là-bas et lui demander plus d'informations sur la mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 726940115,
					"content": "D'accord ! On ira le voir à Ritou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "Ou qu'on transporte de la marchandise suspecte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Haha ! Tout est prêt. Je n'ai qu'à vendre une dizaine de milliers de ces jouets... pour quelques milliers de moras l'unité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940202,
					"content": "Et j'empocherai des millions de moras... Héhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940203,
					"content": "Hé ! C'est vous Bertrand ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940204,
					"content": "Ah ? En effet, vous avez la bonne personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940205,
					"content": "#Êtes-vous {M#venus}{F#venues} m'acheter des jouets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940206,
					"content": "Malheureusement, vous me voyez dans l'incapacité de répondre à votre demande. Leur production en masse n'a pas encore commencé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940207,
					"content": "#Mais pas de panique ! La chaîne de fabrication est en cours de préparation. Je peux vous inscrire sur la liste des clients si vous êtes toujours {M#intéressés}{F#intéressées} sous la réserve d'un acompte. Je vous informerai dès que les jouets seront disponibles et vous n'aurez plus qu'à régler le reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940208,
					"content": "Arrêtez-vous tout de suite ! Nous ne sommes pas là pour vous acheter des jouets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940209,
					"content": "Oh, je vois... Bien, dites-moi pourquoi vous venez m'importuner et en vitesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940210,
					"content": "#Soyez {M#concis}{F#concises}. Le temps, c'est de l'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940211,
					"content": "Waouh ! Tu parles d'un changement complet d'attitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940212,
					"content": "Nous sommes là pour vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "#Oh, vous êtes les {M#assistants}{F#assistantes} qui m'ont été {M#envoyés}{F#envoyées} par la Guilde des aventuriers ! Bonjour ! Vous auriez pu me le dire plus tôt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940215,
					"content": "Je suis bien à l'origine de cette requête. Comment dois-je vous appeler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940216,
					"content": "(Encore un changement d'attitude...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940217,
					"content": "Je m'appelle Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940218,
					"content": "#Et vous, {M#très cher}{F#très chère} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME} ? J'ai l'impression d'avoir déjà entendu votre nom quelque part... Étiez-vous aussi {M#un criminel recherché}{F#une criminelle recherchée} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940221,
					"content": "Plus d'une fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "#Je me disais bien que les agents de la Commission administrative vous avaient {M#mentionnés}{F#mentionnées} quand ils m'ont arrêt... Euh, posé quelques questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940225,
					"content": "Qu'est-ce que vous avez bien pu faire pour vous faire arrêter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940226,
					"content": "*soupir* Ce n'était pas si grave que ça en avait l'air. Juste un petit souci lors de la fabrication de mon dernier lot de jouets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940227,
					"content": "Pas si grave ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940228,
					"content": "Un petit souci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Héhé ! Vous voyez, ils explosaient après avoir déclenché quelque chose par mégarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940230,
					"content": "Quoi ? Ils explosaient ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940231,
					"content": "Ce n'était que des petites explosions de rien du tout, personne n'a été blessé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940232,
					"content": "Les doushins n'étaient pas du même avis : ils m'ont tout confisqué immédiatement... Franchement, quel gâchis ! Ces jouets auraient pu être vendus comme des petites bombes toutes mignonnes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940233,
					"content": "*soupir* Quand je suis arrivé ici, j'ai contracté un prêt auprès de Kaede de l'Association du commerce international pour démarrer mes activités entrepreneuriales. Qui aurait cru que je finirai coincé à Ritou, interdit de déplacement dans le reste d'Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940234,
					"content": "Vous l'avez quand même mérité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940235,
					"content": "Hé, mais comment allez-vous nous payer si vous devez déjà de l'argent à l'Association du commerce international ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940236,
					"content": "Ne vous en faites pas, il me reste des économies. Je pourrai m'affranchir de ma dette dès que j'aurai vendu les jouets que je vais produire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940237,
					"content": "Et vous rémunérer comme il se doit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940238,
					"content": "... Vous pensez que ça va marcher votre affaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940239,
					"content": "Le marché du jouet à Inazuma est plein de potentiel ! Mes jouets étaient très appréciés avant cette histoire d'explosions... Leur popularité n'a pas vraiment faibli non plus après cet incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940240,
					"content": "En tout cas, si les choses ne se déroulent pas comme prévu, je n'aurai qu'à payer ma dette à Kurisu en lui donnant tous mes jouets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940241,
					"content": "Du coup, je vous prie de bien vouloir m'aider. Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940242,
					"content": "Et comment pourrait-on vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940243,
					"content": "#En résumé, mes jouets sont fabriqués par une machine que j'ai construite, l'«{NON_BREAK_SPACE}infaillible et merveilleuse machine à jouets à l'ingénierie stable et au fourneau de deuxième génération ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940244,
					"content": "En parlant de ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940245,
					"content": "Son nom est trop long...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Tu as raison, laisse-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940247,
					"content": "Appelons-la simplement la « méga-machine ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940248,
					"content": "#C'est réducteur comme appellation ! Ça ne reflète en rien toute sa grandeur{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940249,
					"content": "Au moins, c'est plus facile à retenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940250,
					"content": "La méga-machine... Je trouve que ça lui va parfaitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940251,
					"content": "*soupir* Bon, comme vous voudrez. Il est vrai qu'on m'a souvent reproché de n'avoir aucun talent pour nommer les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940252,
					"content": "Paimon ne fait pas vraiment mieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940254,
					"content": "Hahaha ! Bref, ma méga-machine peut analyser toutes sortes de matériaux qu'on y met et choisir la méthode la plus adaptée pour les assembler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940255,
					"content": "Hélas, la dernière fois, j'ai ajouté des mécanismes étranges aux jouets qui ont provoqué ces explosions. J'ai appris de mon erreur et j'ai reconstruit la machine... Il ne devrait pas y avoir de problème, en théorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940256,
					"content": "En théorie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940257,
					"content": "C'est exactement pour cette raison que j'ai besoin d'aide pour la tester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940258,
					"content": "Il y a trois processus de collecte : collecte de matières premières, recharge élémentaire et activation des noyaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940259,
					"content": "Le minerai, les fruits et les fleurs peuvent être considérés comme des matières premières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940260,
					"content": "Ensuite, nous les infusons avec de l'énergie élémentaire pour faire avancer le processus. Enfin, il ne reste plus qu'à alimenter les matériaux avec la force provenant de noyaux de créatures élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940261,
					"content": "Essayons d'effectuer le premier processus, la collecte de matières premières, aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940262,
					"content": "Tenez, c'est un Collecteur de matériaux. N'oubliez pas de mettre les matériaux collectés à l'intérieur pour éviter que d'autres éléments ne les contaminent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940263,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Merci. Je vais procéder à un dernier ajustement sur l'appareil et je m'en remets à vous pour le reste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940223,
					"content": "C'était également votre cas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Haha, disons que j'ai été détenu par la Commission administrative à la suite d'un malencontreux accident...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940213,
					"content": "La mission que vous avez confiée à la Guilde des aventuriers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
