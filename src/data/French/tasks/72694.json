					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Parfait, je vais les mettre dans la merveilleuse et infaillible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940404,
					"content": "La méga-machine.",
					"roleType": "TALK_ROLE_NPC",
