						726940503,
						726940505
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940503,
					"content": "Qu'est-ce que vous vendrez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "Des jouets, mais... *soupir* ils ne sont pas encore produits. Revenez me voir quand ce sera le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940505,
					"content": "Non...",
