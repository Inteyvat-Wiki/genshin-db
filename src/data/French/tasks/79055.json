			"dialogs": [
				{
					"id": 790550101,
					"content": "C'est une scène coupée de l'œuvre « Accon maudit ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790550102,
					"content": "À l'origine, c'est l'histoire de deux Eidolons Hydro qui tombent profondément amoureux à bord d'un bateau cassé voguant sur les flots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790550103,
					"content": "Après s'être avoué leurs sentiments l'un pour l'autre, ils se tiennent sur la proue du bateau illuminée par les dernières lueurs du coucher du soleil. La scène est extrêmement romantique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790550104,
					"content": "Cependant, cette scène a été abandonnée parce que... les deux Eidolons Hydro jouant le rôle avaient tout simplement trop d'énergie et ne pouvaient pas s'arrêter de bouger pour la grande scène romantique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790550105,
					"content": "Si seulement je pouvais en capturer <color=#00E1FFFF>deux sur la proue du bateau en même temps</color>, la scène serait parfaite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790550106,
					"content": "- Le metteur en scène",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes de scène"
				}
			]
		},
