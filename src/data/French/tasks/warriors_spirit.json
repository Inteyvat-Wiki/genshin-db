				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Votre technique est époustouflante. J'ai perdu d'une belle manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Ce fut un honneur de vous affronter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Mesdames et Messieurs, après un combat exaltant, nous avons désormais {M#un champion}{F#une championne} pour cette édition de la compétition d'escrime de la voie du guerrier ! Veuillez faire un tonnerre d'applaudissements pour... {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "#Demain, nous assisterons à la dernière étape de ce tournoi, à savoir le match de démonstration ! Celui-ci verra {NICKNAME} et mademoiselle Kamisato se confronter à l'émissaire de la Shogun toute-puissante, un humanoïde maniant l'épée s'appelant Le sabre oni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Chers spectateurs, soyez au rendez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "#C'était un superbe combat, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "#Félicitations, {M#voyageur}{F#voyageuse}. Vous méritez amplement votre titre de {M#champion}{F#championne}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Je ne m'attendais pas à ce que notre adversaire de demain soit Le sabre oni. Ce nom me fait penser à celui du bonhomme qu'on a rencontré sur l'Île de Yashiori. On dirait que ça ne va pas être de la rigolade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Sois sans crainte, Paimon. L'émissaire est peut-être puissant, mais l'utilisation des yeux divins ne sera pas interdite lors du duel de demain. Nous aurons donc un atout dans notre manche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "En outre, il nous suffira d'analyser les failles dans ses techniques pour trouver une ouverture et riposter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Ouah, vous êtes si confiante, c'est très rassurant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Je ne peux pas garantir que nous allons gagner, mais nous devons nous battre de toutes nos forces pour fournir un spectacle inoubliable au public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Nous allons gagner, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Quelle vigueur vous avez, vous deux ! N'oubliez pas de bien vous reposer ce soir et de faire le plein de forces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "On va pouvoir voir la nouvelle tenue d'Ayaka dès qu'on se réveillera demain... Oh, j'ai hâte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Ah, oui. Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "#Comment, {M#voyageur}{F#voyageuse}... Vous aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Allez, Ayaka, ne décevez pas leurs attentes. Si je n'avais pas quelque chose à faire demain, j'aurais moi aussi aimé voir ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Bien, alors je suppose que c'est décidé. Demain matin, je vous attendrai au Domaine Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Vous avez besoin que je passe vous prendre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Nous allons offrir au public un spectacle sensationnel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Vous voilà enfin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Oh, c'est Hirotatsu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#{NICKNAME} vous a déjà battu il y a quelques jours, et c'est {M#lui le champion}{F#elle la championne} maintenant ! Vous avez quelque chose à dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "#Rassurez-vous, je ne suis pas venu vous chercher des ennuis, je suis ici pour présenter mes excuses. {M#Voyageur}{F#Voyageuse}, je reconnais que j'ai perdu dans les règles de l'art face à vous il y a quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "#Vos talents de {M#bretteur}{F#bretteuse} sont dignes d'admiration. Vos techniques sont subtiles sans être envahissantes, on peut voir votre personnalité s'exprimer à travers elles. J'ai commis une erreur de jugement à votre sujet et vous ai {M#offensé}{F#offensée} par mon comportement et mes paroles. Je vous prierais de m'en excuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Ce n'est rien, je ne l'ai pas pris à cœur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Je suppose que vous êtes ici pour mademoiselle Kamisato ? Elle est en train de préparer sa tenue à l'intérieur et devrait sortir dans peu de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "#{M#Voyageur}{F#Voyageuse}, avant que mademoiselle Kamisato n'arrive, j'aimerais vous demander quelque chose, même si c'est un peu présomptueux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "D'accord, je vous écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Bien que mademoiselle ne nous ait jamais parlé du combat de démonstration d'aujourd'hui, elle s'est entraînée à l'épée chaque soir pendant plusieurs heures, malgré son emploi du temps chargé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "Mademoiselle a toujours été diligente et consciencieuse. Bien qu'il ne s'agisse que d'un match de démonstration et qu'il importe peu qu'elle perde, je suis convaincu qu'elle fera de son mieux pour gagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Étant son serviteur, j'ai foi en ses capacités martiales, seulement... J'espère que vous pourrez porter assistance à mademoiselle dans l'arène et assurer sa sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Rassurez-vous, j'y veillerai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "#{M#Voyageur}{F#Voyageuse}, je vous la confie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Oh, ça doit être Ayaka !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Ouah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "#Eh bien, pourquoi êtes-vous si {M#silencieux}{F#silencieuses} ? Est-ce que quelque chose ne va pas avec mon accoutrement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Pas du tout ! Ayaka, vous êtes vraiment magnifique comme ça... Vous rayonnez devant nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Cette tenue vous va à merveille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Oui, tout à fait ! Vous ressemblez à une jeune femme fontainoise, et ça vous donne une certaine énergie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Vraiment ? J'avais peur que ça ne soit un peu trop extravagant... Je n'étais pas sûre que cela me conviendrait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Mais bon, puisque vous trouvez ça bien, alors je suis rassurée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Hihi, j'ai hâte de voir la réaction des gens quand ils vous verront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "#Merci pour ces compliments, Paimon. {M#Voyageur}{F#Voyageuse}, puisque vous êtes {M#prêt}{F#prête}, nous pouvons nous diriger vers l'arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "#Mademoiselle, {M#voyageur}{F#voyageuse}, bonne chance pour le combat de démonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "Ces vêtements sont splendides, ils vous vont parfaitement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Oui ! En regardant de plus près, on peut même voir le blason du Clan Kamisato brodé sur la robe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Oui, Onodera a demandé à quelqu'un du clan de l'ajouter ces derniers jours. On m'a dit que cette idée avait été reprise des suggestions que les spectateurs ont écrites sur les bulletins de vote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "Cette tenue a été très bien taillée. Elle me va bien, et il m'est facile de me mouvoir dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "J'ai beaucoup aimé notre combat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
