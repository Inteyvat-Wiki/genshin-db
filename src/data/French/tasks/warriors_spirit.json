			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "#Regardez, c'est mademoiselle Kamisato et {M#le voyageur}{F#la voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "J'avais déjà vu des illustrations de cette tenue, mais la voir sur mademoiselle Kamisato lui donne vraiment une touche unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Ça valait la peine de faire la queue le matin pour avoir des places au premier rang. Ça promet pour le combat d'aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "#Ouah, Ayaka attire l'attention de tout le monde dès qu'elle apparaît{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Chers spectateurs, votre attention s'il vous plaît. Le combat de démonstration de la voie du guerrier est sur le point de commencer. Veuillez entrer dans l'arène de manière ordonnée et rejoindre vos places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "#Mademoiselle Kamisato, {M#voyageur}{F#voyageuse}, veuillez me suivre dans l'arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "#{M#Voyageur}{F#Voyageuse}, êtes-vous {M#prêt}{F#prête} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Oui, allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Bien. Faisons de notre mieux. Je suis impatiente de me battre à vos côtés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Il me faut encore un peu de temps pour me préparer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "Ne vous pressez pas, il nous reste encore un peu de temps. Nous entrerons dans l'arène quand tout sera en ordre pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}, Ayaka, on est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "Quel duel extraordinaire. Même si je n'y connais pas grand-chose à l'art de l'épée, je me suis laissée prendre par la tension ambiante dans l'arène, mon cœur bat encore la chamade !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "#Oui, les attaques de l'ennemi m'ont fait bondir plus d'une fois, mais vous aviez l'air d'être {M#préparés}{F#préparées} pour y faire face à chaque fois, et vous les avez déjouées sans difficulté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "#{M#Voyageur}{F#Voyageuse}, mademoiselle Kamisato, félicitations pour votre victoire pendant le combat de démonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Ouah, c'est Sara ! Vous aussi, vous avez regardé la compétition ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "#C'est la Shogun toute-puissante qui m'a ordonné de venir assister à ce tournoi. Vous avez {M#tous}{F#toutes} deux fait preuve d'une remarquable maîtrise de l'épée et avez su coopérer d'une brillante manière. En plus d'avoir montré la beauté de l'art de l'épée au grand public, vous m'avez appris beaucoup de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Vous nous flattez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Vous avez tous beaucoup travaillé pour préparer cette compétition, et la journée d'aujourd'hui constitue une conclusion parfaite à la voie du guerrier. La Shogun a pu constater tous vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Je vais maintenant retourner au Tenshukaku faire mon rapport de la compétition à la Shogun. Vous m'excuserez de vous laisser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "Alors, qu'est-ce que vous comptez tous faire, maintenant ? Est-ce que cela vous dirait d'aller à la Pagode Uyou pour fêter cette victoire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "Chouette ! On n'a pas arrêté de penser au tournoi ces derniers jours, ça fait longtemps qu'on n'a pas bien mangé ! Allons-y vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Pfiou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "Qu'est-ce qu'il y a, Ayaka ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Oh, ce n'est rien. Ce n'est que maintenant que je commence à réaliser que nous avons gagné. Mademoiselle Kujou Sara a dit qu'elle avait beaucoup appris de ce combat, et il en va de même pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Le public ne l'a sans doute pas remarqué, mais je suis consciente que si j'ai pu désamorcer le danger à de nombreuses reprises, c'est parce que vous étiez à mes côtés pour détourner les attaques de l'ennemi à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Si vous n'aviez pas été là, il ne fait aucun doute que je n'aurais pas pu remporter la victoire. Sans surprise, ma technique à l'épée est loin d'égaler la vôtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "#Vous m'avez aussi {M#aidé}{F#aidée} à de nombreuses reprises, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Vraiment ? Vous entendre dire cela me donne soudainement envie de me mesurer à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Pour ne rien vous cacher, depuis que j'ai fait votre connaissance, j'espérais toujours avoir la chance d'échanger quelques passes d'armes avec vous. On peut dire que le combat de démonstration d'aujourd'hui m'a permis de réaliser mon souhait à moitié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "La prochaine fois, nous pourrons trouver un moment pour s'affronter sérieusement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "D'accord. Cependant... Avant cela, prenez bien soin de votre épée. Si je parviens à vous la dérober un jour, votre vie sera entre mes mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Héhé... J'ai toujours eu envie de dire ce genre de choses. Est-ce que ça vous paraît étrange ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Ça ressemble à ce que pourrait dire mademoiselle Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "#Hé, pourquoi vous êtes si {M#lents, tous}{F#lentes, toutes} les deux ? De quoi êtes-vous encore en train de parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "#Nous étions en train de dire qu'il fallait trouver un moment pour s'affronter et voir qui de nous deux est {M#le plus doué}{F#la plus douée} à l'épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "#Ouah... L'art de l'épée, c'est vraiment du sérieux pour vous, Ayaka ! Mais {NICKNAME} et vous êtes {M#amis}{F#amies}, non ? Alors, pourquoi vouloir vous affronter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "#C'est justement parce que nous sommes {M#amis}{F#amies} que nous devons souvent croiser le fer et apprendre {M#l'un}{F#l'une} de l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Oh... Dit comme ça, ça se comprend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "#{M#Voyageur}{F#Voyageuse}, gardez secret ce que je viens de vous dire, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Hein ? Qu'est-ce que vous venez de dire, Ayaka ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Rien. Avançons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "C'est mignon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Vous êtes trop modeste, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
