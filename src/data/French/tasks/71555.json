			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Merci infiniment de m'avoir sauvée ! Je pensais que ça en était fini de moi... Cette bande de Pilleurs me suivait depuis le début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "J'avais avancé dans mes recherches concernant ce lieu et je m'étais dit qu'il aurait été bien de trouver le trésor pour le ramener avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "Mais les Pilleurs de trésors ont fait irruption à mon campement pour me ligoter et m'amener ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Ils n'ont pas cessé de me poser des questions sur l'emplacement du trésor en me menaçant de mettre fin à ma vie si je refusais de répondre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Au fond de moi, je savais qu'ils ne m'auraient pas épargnée même si je leur avais révélé l'information...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*soupir* J'aurais dû écouter Soraya. Elle me répète que des archéologues comme nous devrions nous contenter de faire des avancées sur le plan théorique au lieu de chasser des trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Je n'ai pas assez de subventions pour ma recherche et publier des articles de temps en temps ne me permet pas de couvrir mes frais de voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Je ne sais même pas comment Soraya a pu survivre pendant tout ce temps seule à Liyue. Rien que de voir sa pile d'articles rejetés me fatigue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "Que vas-tu faire maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Pas grand-chose. J'ai terminé ce que je devais faire ici. Quant au trésor... Il est à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Je ne veux pas revivre ce traquenard. Sachez que le trésor est enterré sous un <color=#00E1FFFF>grand arbre aux feuilles d'or</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Trouvez-le si vous le souhaitez. Je vais noter son emplacement sur un papier pour ne pas que vous l'oubliiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Je vais me reposer un peu avant de revenir au campement pour ranger mes affaires. Il faut que je parte d'ici au plus vite avant que d'autres Pilleurs de trésors ne rappliquent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "Je n'ai aucune idée du temps que je mettrai pour atteindre l'Auberge Wangshu, mais j'ose espérer que Soraya ne sera pas partie avant mon arrivée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*soupir* Si seulement elle pouvait être ma tutrice de thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
