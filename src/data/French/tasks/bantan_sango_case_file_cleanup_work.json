			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada",
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "#Hmm ? Vous êtes... {M#le voyageur}{F#la voyageuse}, non ? J'ai entendu Amano parler de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "Qu'est-ce qui vous amène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Tenez, de la part de Ryuuji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Oh, des mochis de fleur de cerisier... Eh bien, je ne peux pas les manger comme ça. Je dois trouver un endroit approprié pour les savourer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, prends ma place un moment. Si quelqu'un vient me voir, dis-lui d'attendre un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Mais nous sommes encore en service, monsieur Owada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Haha, ce n'est rien. Je sors juste prendre l'air, je serai vite de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "*soupir* ... D'accord, mais ne tardez pas. Si un supérieur passe par là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "Ne t'inquiète pas ! On vient de résoudre une affaire, donc si quelqu'un vient, ce sera pour nous féliciter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Alors, je te fais confiance, Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "#{M#Voyageur}{F#Voyageuse}, venez faire un tour avec moi. Je connais l'endroit parfait pour déguster ces mochis en toute tranquillité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202005",
							"2"
						],
						"stepId": 2202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Ah... Cet endroit n'est pas mal, hein ? Je viens souvent ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "La vue est belle et l'air est frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "S'il y a quelque chose que vous voulez me demander, c'est le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Vous étiez aussi un collègue de Ryuuji ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "C'est Ryuuji qui vous l'a dit ? Oui, lui et moi, on a travaillé ensemble avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "Je ne sais pas si Ryuuji a mentionné ce qui s'est passé à l'époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "Pour faire simple, il était trop impulsif. Et il a fini par tomber dans un piège et par devenir un bouc émissaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Je me suis porté garant pour lui, mais le juge a quand même insisté pour le condamner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "J'ai demandé à de nombreuses personnes de m'aider à enquêter, mais soit elles sont revenues les mains vides, soit elles m'ont dit de ne pas poursuivre l'enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Ah... À ce moment-là, j'ai... Comment devrais-je dire ça... J'ai tenu compte des avertissements et je n'ai pas approfondi mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "C'est un « secret » que tout le monde connaît, tout comme le fait que Ryuuji ait été accusé à tort. Donc, ça ne me dérange pas de vous le dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Mais comme tout le monde le sait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Ah, c'est justement parce que tout le monde le sait que personne n'osait s'en mêler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Heureusement, une détective qui n'était pas au courant s'est rendue au Poste de police pour autre chose, et elle a commencé à s'intéresser à cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Grâce à elle, l'affaire a finalement été résolue et le nom de Ryuuji a été blanchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Ryuuji a ensuite quitté la police et il est allé travailler pour cette détective. Voilà toute l'histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Pourquoi me racontez-vous ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Qui vous a demandé de me faire ce cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Je suis sûr que c'était de la part de Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Connaissant Ryuuji, si Sango lui avait demandé de livrer ce cadeau personnellement, il l'aurait apporté en parfait état, même s'il devait traverser une mer de feu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Mais Ryuuji vous a demandé de me le remettre, ce qui signifie que Sango lui a dit de vous demander de le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "C'est donc Sango qui voulait que je sois au courant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "#Hahaha, vous n'êtes pas {M#long}{F#longue} à la détente à ce que je vois. Le fait que vous soyez {M#venu}{F#venue}, c'est comme si Sango m'envoyait un message en disant : « J'ai {M#un nouvel assistant}{F#une nouvelle assistante} ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "On dirait qu'elle n'en a pas encore fini avec ce qui s'est passé à l'époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "En fait, ce n'est pas surprenant. Après tout... Elle n'a pas encore trouvé l'instigateur de ce piège...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Eh bien, je vous ai dit tout ce que je pouvais. Vous pouvez décider vous-même si vous souhaitez rejoindre Sango ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Oh, et remerciez Ryuuji pour les mochis de ma part. J'ai toujours adoré ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Pourquoi a-t-il quitté la police ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "C'était son choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
