			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}. Avez-vous donné les cadeaux à chacun d'eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "Est-ce que c'est Sango qui a arrangé tout ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Vous avez compris ? Désolé... C'était l'idée de Sango de vous faire livrer les mochis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Sango a dit que vous serez indispensable pour aider à résoudre cette affaire et découvrir le vrai coupable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Cette affaire n'est pas encore résolue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Pas encore. Sango a déclaré que tout indiquait parfaitement le « coupable » à l'époque. Trop parfaitement, en fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Lorsque Sango a commencé son enquête, les indices et les preuves lui sont tombés entre les mains comme par magie, et tout pointait du doigt ce « coupable ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Cette personne a finalement été reconnue comme coupable par la police, mais Sango pensait que le vrai fautif était quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Je pense que si elle m'a recruté dans son agence, c'était pour avoir la chance de résoudre cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Mais comment pourrais-je aider...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Les idées de Sango... Je n'arrive pas à les comprendre parfois. Mais elle m'a mentionné une fois qu'il se pourrait bien qu'elle ait l'esprit étriqué après avoir passé autant de temps à Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Avec quelqu'un de bien informé au regard neuf pour nous aider, on pourrait peut-être faire une nouvelle découverte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "#{M#Voyageur}{F#Voyageuse}, Sango doit penser que vous êtes {M#celui}{F#celle} qui peut l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "#Eh bien, je suppose que je suis {M#un}{F#une} détective maintenant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "#Bien sûr, tant que vous êtes {M#disposé}{F#disposée} à nous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "De toute façon, vous avez déjà bien aidé notre agence. Alors acceptez déjà ce paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Est-ce que c'est encore Sango qui vous a dit de me raconter tout ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "Non. Ce que je viens de vous dire, ça vient uniquement de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Merci encore pour votre aide ! N'hésitez pas à venir plus souvent. Je suis sûr que Sango appréciera également de vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Une affaire comme ça, ça doit rapporter pas mal, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Je ne peux pas vous donner de chiffre exact. Mais la paie sera suffisante, j'en suis sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "Est-ce que cette affaire est le crime parfait dont parlait Sango ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "En effet. Sango m'a dit un jour que tout indiquait parfaitement le « coupable » à l'époque. Trop parfaitement, en fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Lorsque Sango a commencé son enquête, les indices et les preuves lui sont tombés entre les mains comme par magie, et tout pointait du doigt ce « coupable ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "Cette personne a finalement été reconnue comme coupable par la police, mais Sango pensait que le vrai fautif était quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Vous auriez pu simplement me dire ce qui s'était passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
