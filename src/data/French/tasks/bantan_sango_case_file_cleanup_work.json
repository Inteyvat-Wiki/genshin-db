			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "#{M#Voyageur}{F#Voyageuse}, je n'arrive pas à croire que je vous rencontre ici. Il semble que Sango avait raison en disant que nous nous reverrions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "Sango m'a demandé de finir le dernier boulot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Ce qui implique simplement d'apporter des desserts aux doushins pour les remercier de leur aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Ce sont eux qui devraient nous remercier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "C'est vrai. Mais bon, c'est juste une excuse pour améliorer nos relations avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Après tout, notre agence pourrait avoir besoin de leur aide un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "Vous parlez comme Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Haha, oui. Votre intuition est toujours aussi bien aiguisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "Et vous alors, que pensez-vous de tout ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Moi ? Amano et Andou... On était collègues avant. C'est donc normal de leur faire plaisir avec quelques sucreries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Par contre... Sango m'a également demandé d'enquêter sur une autre affaire aujourd'hui. Donc je n'ai pas vraiment le temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à livrer ces desserts à trois personnes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Merci de bien vouloir m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "Tenez, trois desserts pour Amano, Andou et monsieur Owada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "Monsieur Owada ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "C'était aussi mon ancien... collègue. Il s'est bien occupé de moi avant que je ne quitte la police.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Et il nous a aussi un peu aidés pendant l'affaire des vols en série.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "#Bon, je vous laisse vous en occuper, {M#voyageur}{F#voyageuse}. On se retrouve ici quand vous en avez fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Ce serait mieux si vous le faisiez vous-même.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Mais... La demande de Sango est plus importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Et puis, je pourrais aller les voir tous les trois un peu plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "C'est Sango qui a dû vous apprendre ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "N'est-ce pas nous qui les avons aidés ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202002",
							"2"
						],
						"stepId": 2202002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
