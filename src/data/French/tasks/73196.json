				},
				{
					"id": 731961502,
					"content": "« Et au théâtre Zubayr, vous ne pouvez absolument pas manquer la danse de Nilou ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961503,
					"content": "« Votre voyage à Sumeru ne sera jamais complet si vous manquez la danse de Sabzeruz de Nilou ! »",
					"roleType": "TALK_ROLE_NPC",
