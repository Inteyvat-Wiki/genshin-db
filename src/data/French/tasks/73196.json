			"dialogs": [
				{
					"id": 731960601,
					"content": "Des produits d'excellente qualité au meilleur prix. Épices de Jut, votre boutique d'épices de proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960602,
					"content": "Achetez maintenant et profitez d'un cadeau gratuit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
