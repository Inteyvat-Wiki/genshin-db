				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "Tapis tissés à la main, un chef-d'œuvre de l'art de Sumeru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960502,
					"content": "Chaque habitant de Sumeru devrait avoir un tel tapis dans sa vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960503,
					"content": "Les tapis ont un prix, l'art est quelque chose d'inestimable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319606,
			"completionStepIds": [
				7319606
