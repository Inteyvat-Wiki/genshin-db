			"dialogs": [
				{
					"id": 731961601,
					"content": "Mettez-vous en quête de bonheur ! Partez de chez vous pour explorer le monde ! Rejoignez la Ligue des aventuriers aujourd'hui ! Les frais d'inscription sont de seulement 5 moras le premier mois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961602,
					"content": "Le savoir véritable ne peut être obtenu que par la pratique. Il vaut mieux perdre sa vie dans une expédition que de passer sa vie à ne rien faire du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961603,
					"content": "« Soyez bien attentifs ! Ce n'est pas la vraie Guilde des aventuriers. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961604,
					"content": "« Quoi ! J'ai payé un an de frais d'inscription ! Est-ce que je vais pouvoir récupérer mon argent ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
