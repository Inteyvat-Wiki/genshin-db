				{
					"id": 731961101,
					"content": "Grâce à ses techniques subtiles et son savoir-faire d'excellence, la Teinturerie d'Ani fera resplendir vos vêtements avec de nouvelles couleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961102,
					"content": "« Quand pourrai-je récupérer les vêtements que j'ai envoyés chez vous le mois dernier ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961103,
					"content": "« Je suis vraiment désolé ! Ma femme a donné naissance à notre bébé hier, alors je n'ai pas eu le temps de travailler. Revenez demain, s'il vous plaît. Je vous garantis que vos vêtements seront là à temps. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961104,
					"content": "« Mais ça fait déjà trois mois. Rendez-moi mes vêtements. Je ne veux plus les teindre. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961105,
					"content": "« Mes plates excuses ! Vos vêtements ont été volés par un voleur alors qu'ils étaient en train de sécher après avoir été teints. Si vous souhaitez les récupérer, veuillez vous adresser au voleur en question. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
