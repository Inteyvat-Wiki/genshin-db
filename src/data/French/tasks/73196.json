			},
			"dialogs": [
				{
					"id": 731960101,
					"content": "Ce panneau d'affichage de l'Échange Kalimi est destiné à la publication d'informations commerciales des négociants domestiques et étrangers. Il est interdit d'y publier des messages hors sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "L'Échange Kalimi fait tout son possible pour assurer l'exactitude et la fiabilité de toutes les informations fournies, mais ne garantit en aucune manière leur exactitude et leur intégrité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960202,
					"content": "Les parties prenantes ne peuvent pas réclamer des dédommagements partiels ou intégraux après avoir subi des pertes résultant de l'utilisation d'informations commerciales publiées sur ce panneau d'affichage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Avez-vous entendu parler de l'art de la lévitation ? Avez-vous déjà vu un spectacle de trapèze ? Voulez-vous découvrir les secrets de la bête de somme volante ? Alors ne manquez pas le premier spectacle à Sumeru du Cirque du ciel de Fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960302,
					"content": "Bienvenue à vous ! Notre spectacle artistique unique est toujours là ! Seulement cinq moras l'entrée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960303,
					"content": "Suite à des plaintes du public, nous avons découvert que ce spectacle n'avait pas été approuvé par l'Académie. L'autorisation de ce spectacle a été annulée et cette publicité va être enlevée immédiatement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
						],
						"stepId": 7319604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Une agence de la Banque du Nord va bientôt ouvrir à Sumeru ! Chers futurs clients, nous avons hâte de vous voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960402,
					"content": "Pour toutes vos procédures, veuillez contacter Victor pour que notre succursale à Liyue puisse les traiter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960403,
					"content": "Pour les demandes de prêt, veuillez en parler avec notre usurier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
