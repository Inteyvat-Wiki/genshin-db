			"dialogs": [
				{
					"id": 731960901,
					"content": "Viande grillée du désert authentique ! Assaisonné de sauce secrète du roi Deshret et cuite avec des épices locales !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960902,
					"content": "De la nourriture goûteuse et des boissons délicieuses pour tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
