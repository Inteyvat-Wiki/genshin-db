				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "« Je possédais autrefois une richesse illimitée. Mais dépenser tout l'argent du monde n'a jamais su m'apporter la paix. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961002,
					"content": "« Après ce voyage, il ne reste plus un seul mora dans ma poche, mais je me sens plus paisible que jamais. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961003,
					"content": "« Si vous voulez écouter mon histoire, alors venez dans mon magasin de légumes. Bien sûr, il est préférable que vous achetiez des légumes en passant. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
