			"dialogs": [
				{
					"id": 731961201,
					"content": "Nous nous spécialisons dans les services liés au commerce extérieur et nous coopérons depuis longtemps avec de puissantes flottes navales comme la Flotte du Crux pour livrer vos marchandises en toute sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961202,
					"content": "Nous avons ouvert quatre nouvelles routes cet été pour des matières premières telles que la soie, les épices et les minerais. Nos nouveaux navires ont une grande capacité de chargement. Nous invitons sincèrement les personnes intéressées à nous rejoindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731961203,
					"content": "Si vous souhaitez réserver l'intégralité d'un itinéraire maritime, nous vous invitons à vous adresser en personne à Farzaneh, la directrice de la compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
