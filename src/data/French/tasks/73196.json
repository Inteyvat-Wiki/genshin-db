			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "Le magasin propose toutes sortes de produits d'épicerie. La qualité de nos produits est garantie grâce à des contrôles effectués par la propriétaire en personne, vous en serez donc assurément satisfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960702,
					"content": "« Papa, tu peux me prêter encore un peu d'argent ? J'ai entendu dire que le prix des noix d'ajilenakh allait bientôt monter en flèche. Je suis sûr que je vais faire fortune cette fois. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
