			"dialogs": [
				{
					"id": 731960801,
					"content": "Nous cherchons à acheter les statues d'or perdues de Kazeni. Prix négociable. Veuillez contacter le propriétaire de notre magasin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731960802,
					"content": "Si vous avez des informations à leur sujet, veuillez visiter la Boutique de Menakeri et vous adresser au collectionneur Khalid. Vous recevrez une belle récompense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
