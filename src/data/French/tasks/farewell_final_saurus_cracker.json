			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "Hein ? Taruka ! Tu es déjà revenu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#{M#Monsieur}{F#Mademoiselle} {NICKNAME} ! Je suis vraiment content que vous alliez bien... J'ai raconté à ma sœur et à tout le monde ce qui s'était passé. Lamizana est un idiot, comme je le pensais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Ha raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Oui, même plus que toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#D'accord, d'accord. Il doit être vraiment bouleversé d'avoir été séparé de toi pendant si longtemps. Il a montré un excellent esprit d'équipe avec {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Il y a encore des points à améliorer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Il est encore petit. Du moment que Taruka s'en occupe bien, je suis sûre qu'il deviendra un qucusaure exceptionnel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "D'ailleurs, comment es-tu revenu ici ? Est-ce que quelqu'un est venu te sauver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Je me suis échappé tout seul. Je voulais emmener Oberon avec moi, mais il était obsédé par les biscuits sauriennaurus et refusait catégoriquement de bouger. Ça m'a énervé, alors je suis parti sans lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Quoi ? C'était aussi simple que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Après avoir compris les habitudes de déplacement des gardes sauriens, j'ai réalisé qu'il y avait une brèche que je pouvais exploiter pour m'échapper et je suis sorti en douceur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Tu pourrais bien être le plus fiable d'entre nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Qu'est-ce qui t'a pris si longtemps ? J'étais sur le point de régler les problèmes avec cette menteuse... et de m'excuser officiellement auprès de vous... J'ai été trop arbitraire et j'ai presque accusé des innocents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "C'est trop tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "C'est clair ! Vous n'êtes apparu que lorsque tout était terminé. Je suis presque sûre que vous essayez de voler du mérite, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Je ne sais pas quoi vous dire. Je vais vous rémunérer comme promis ou tout ce que vous exigerez. Je ne serai pas avare là-dessus. Vous pouvez même me frapper si ça peut vous défouler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Je suis un homme, un vrai. Je n'essayerai donc pas de me soustraire à mes responsabilités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#Je vais demander à {REALNAME[ID(2)|SHOWHOST(true)]} de vous frapper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Aïe ! J'ai mal rien que d'y penser ! Ayez pitié, je vous en prie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Ne venez-vous pas de dire que vous étiez un homme qui n'essayera pas de se soustraire à ses responsabilités ? Vous êtes vraiment pathétique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Peu importe, nous valons mieux que ça. N'est-ce pas, {NICKNAME} et {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Merci de m'avoir pardonné. L'Aérocadémie... Eh bien, elle n'a pas de portes. Mais si elle en avait, elles vous seraient toujours ouvertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
