					"nextDialogs": [
						750870303
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870303,
					"content": "Hein... C'est toi, Oberon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870304,
					"content": "Ha raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870305,
					"content": "Eh bien, tu as beaucoup grandi depuis la dernière fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870306,
					"content": "Taruka avait raison quand il disait que tu prenais facilement du poids. D'ailleurs, où est-il ? Pourquoi n'est-il pas avec toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870307,
					"content": "Raouh... Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870308,
					"content": "Oh, sortons d'abord d'ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870309,
					"content": "Maintenant que nous avons retrouvé Oberon, nous n'aurons plus besoin de nous cacher, n'est-ce pas ? Mais je m'inquiète pour Taruka... Nous devons le retrouver au plus vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
