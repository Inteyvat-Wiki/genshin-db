			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Oh ? Cette Statue des Sept s'est mise à émettre une lumière éblouissante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "C'est trop bizarre ! Ça n'était pas arrivé les autres fois, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "C'est tout à fait normal pour une Statue des Sept de briller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#Tu te sens bien, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Euh ? L'eau... Elle m'a parlé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Ce serait bien si elle pouvait ! Si ça t'amuse de raconter ce genre de blagues, donne-t'en à cœur joie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Par contre, je t'avoue que l'air semble beaucoup plus humide après l'illumination de la Statue des Sept. Peut-être à cause de toute cette énergie Hydro qui s'est libérée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Héhé, j'ai entendu dire qu'à Fontaine, il était possible de nager sous l'eau en utilisant l'énergie élémentaire de la bonne manière ! Peut-être qu'on trouvera un trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Je te laisserai aller le chercher dans les profondeurs des mers, pendant que je... Je t'attendrai sur le rivage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "#Je vais me sentir {M#seul}{F#seule} sous l'eau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Bouh, mais ça me fait peur d'être dans l'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "Et si je me faisais emporter par le courant et que ça me donne le tournis ? Je ne pourrais même pas voler pour sauver ma peau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "#Comme la première fois qu'on s'est {M#rencontrés}{F#rencontrées} à Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "Je te repêcherai à nouveau !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "Pour de vrai ? Bon, dans ce cas, je peux essayer d'aller sous l'eau avec toi. Tu as intérêt à tenir parole !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Tu pourrais au moins faire quelque chose pour une fois !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Ouah, j'ai l'impression de respirer grâce à des branchies...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "D'accord... Vas-y, montre-les-moi ! Hmph, on dirait que tu n'as rien. Et moi qui m'inquiétais pour toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Un courant d'eau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "C'est bien la nation de l'Archon Hydro ! Même les Statues des Sept sont des fontaines d'eau... Je me disais que ce n'était pas normal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}