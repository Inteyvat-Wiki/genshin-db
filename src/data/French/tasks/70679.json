			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Bonjour, comment allez-vous ? Quelle coïncidence de vous revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Excusez-moi, vous êtes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Je m'appelle Gygax ! De la Poursuite du vent, vous vous souvenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Alors, c'est vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Je me souviens maintenant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "On dirait que vous ne vous souvenez pas du tout d'après votre expression...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Mais peu importe, regardez. Vous vous souvenez certainement de la Poursuite du vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Vous m'avez fait beaucoup de suggestions la dernière fois que vous avez testé le jeu. Ça m'a beaucoup aidé, je les ai pratiquement toutes adoptées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "J'ai revu les règles et les modes jeu... Et j'y ai même apporté quelques améliorations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Ce n'est pas devenu trop difficile à comprendre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Ne vous inquiétez pas. Vous allez adorer cette nouvelle version. Laissez-moi vous expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Tout d'abord, dans cette toute nouvelle version de la Poursuite du vent, j'ai ajouté pour la première fois ce que j'appelle des dispositifs signalisateurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Les rebelles doivent activer 4 dispositifs signalisateurs pour vaincre le chasseur et remporter la victoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Rien n'a changé pour le chasseur. Il doit toujours capturer tous les rebelles pour gagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Mais dans cette version, les rebelles ne sont pas immédiatement vaincus lorsqu'ils sont capturés par le chasseur. Ils sont envoyés dans un endroit qu'on appelle la zone de surveillance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Pour qu'un rebelle puisse quitter la zone de surveillance et continuer à jouer, il faut qu'un certain temps s'écoule ou qu'un autre rebelle l'aide à s'échapper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Mais si un rebelle qui a déjà été attrapé est capturé à nouveau... Il est éliminé pour de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Ça semble assez compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Ne vous inquiétez pas. Ça a l'air compliqué, mais vous aurez tout compris après quelques tours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "Très bien, je vais essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Super ! C'est par ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "#Je suis {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Aucun problème. Revenez quand vous en aurez l'occasion. Je serai ici pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Tant de nouvelles règles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Vous n'avez pas ajouté de mode de jeu bizarre quand même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Vous êtes... celui de la Poursuite du vent !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Je m'appelle Gygax ! Mais ce n'est pas faux... Et puis, ce n'est pas comme si j'allais m'offenser du fait que la Poursuite du vent soit plus connue que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}