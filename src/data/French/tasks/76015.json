			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantôme bruyant"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Qui es-tu ? C'est ma place, et tout le monde le sait ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150102,
					"content": "#Tu es {M#venu}{F#venue} sur l'île pour faire ton rapport ? Ne vole pas la place d'un autre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150103,
					"content": "Où est passée ma bière ? Vite, je dois partir en patrouille bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150104,
					"content": "Taverne ? Bière ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Si tu insistes, mais d'abord, viens boire et chanter avec nous. Tu pourras t'asseoir où tu veux quand on sera amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150107,
					"content": "#Tu connais la chanson, non ? You-hou, viens ! Chacun chante une phrase, t'es {M#le prochain}{F#la prochaine} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150108,
					"content": "« Mon voisin me donne envie de danser avec ses pas cadencés ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "Non, non, non, ce n'est pas ça ! Sérieusement ? Tous les gens à Nod-Krai connaissent cette chanson !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150113,
					"content": "Tu ne vas jamais t'intégrer si tu ne chantes pas, hein ? Et ce sera ballot quand il n'y aura personne pour t'aider quand la Chasse sauvage frappera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150114,
					"content": "Va apprendre la chanson avant de revenir ici ! C'est compris ? Allez, une autre bière pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150110,
					"content": "« Mon amie Paimon me donne envie de rire avec ses blagues bien rodées ! »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "« Les fantômes de l'île chantent et dansent autour des chaises, déchaînés ! »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Prêtez-moi votre place un instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
