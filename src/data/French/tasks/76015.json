						760150211
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150211,
					"content": "« Venez danser ! »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Haha, et voilà ! Tu apprends vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150213,
					"content": "Je m'appelle ███. Maintenant, on se connaît. La chaise est à toi ! Je suis un type généreux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150214,
					"content": "T'es un ratniki aussi ? T'inquiète, c'est ma tournée aujourd'hui. Peut-être qu'on se reverra à l'entraînement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150215,
					"content": "Merci, même si je ne peux pas en boire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Je dois aller patrouiller. À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantôme bruyant"
				},
				{
					"id": 760150216,
					"content": "Enchanté. Je m'appelle Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "Et si j'ai juste envie de m'asseoir ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
