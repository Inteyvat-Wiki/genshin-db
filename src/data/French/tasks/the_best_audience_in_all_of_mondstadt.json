					"content": "C'est à peu près la description que Stanley avait faite. Il m'a dit qu'il s'est jeté corps et âme dans ce combat pour éteindre les flammes sur le corps du monstre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630603
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630603,
					"content": "Il n'a pas voulu m'en dire davantage quand j'ai insisté pour savoir comment il a fait. Je me demande ce qu'il cache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
