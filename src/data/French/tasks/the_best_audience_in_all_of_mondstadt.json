					"nextDialogs": [
						200631607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631607,
					"content": "Je sais que ça ne sert à rien de raconter des mensonges, mais la situation me désespère. Je suis trop vieux pour me battre contre des monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631608
					],
					"speakerTitle": "Cyrus"
				},
				{
