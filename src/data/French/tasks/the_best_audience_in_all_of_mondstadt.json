					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200631001,
					"content": "« Des cristaux de glace se formèrent sur le corps du monstre, et le rendirent plus grand, plus menaçant... Mes jambes étaient paralysées par la peur, mais je parvins à déloger des morceaux de glace grâce à mon arme... Leur aspect était curieusement captivant... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631002,
					"content": "C'est ce que m'a raconté Stanley. Vu son état, ses propos étaient plus décousus que je ne l'ai fait paraître. Il a poursuivi son histoire après avoir décuvé, mais je ne m'en rappelle plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631003,
					"content": "D'habitude, on utilise des compétences Pyro pour combattre un monstre d'affinité Cryo, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631004
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631004,
					"content": "Enfin, avec un monstre de cette taille, qui sait combien de compétences il aurait fallu pour en venir à bout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
