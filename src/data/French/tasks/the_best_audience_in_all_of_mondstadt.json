					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "*soupir* J'aimerais voir ça de mes propres yeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "Voir quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Waouh, tu m'as fait peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "Hier, j'ai bu un verre avec Stanley et il m'a raconté une aventure qu'il avait vécue dans la <color=#00E1FFFF>Vallée Dadaupa</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "Il m'a dit : « Ce monstre au corps amorphe et brûlant rampa vers moi... Toutes mes tentatives d'attaques furent vaines sous son regard empreint du mépris le plus total... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Je n'étais pas là pour le voir, mais je suis certain que ça a été un défi de taille pour un grand aventurier comme Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "J'aimerais vraiment trouver ce monstre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "Même si je sais pertinemment que je le fuirai après qu'il m'ait botté les fesses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "D'ailleurs, tu peux m'aider dans ma recherche si ça te dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Super ! Je savais que je pouvais compter sur toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Je peux t'accompagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "J'aurais bien aimé y aller avec toi, mais il me reste une tonne de choses à faire, malheureusement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "Je veux dire par là, que les aventures ne rapportent pas assez d'argent à la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "Alors j'ai dû accepter des petits boulots comme chercher des chats disparus, tondre la pelouse et j'en passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "C'est pour ça que je te laisse t'occuper du monstre de Stanley. Tu me raconteras tout à ton retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
