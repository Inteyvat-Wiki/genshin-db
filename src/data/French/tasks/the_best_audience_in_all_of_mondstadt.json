					"nextDialogs": [
						200631203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631203,
					"content": "Oui, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "Quoi ? Ce n'était qu'un Pyroblob ? Pourtant, ce n'est pas du tout ce que Stanley m'avait dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631205,
					"content": "Heureusement qu'il est là. Stanley, vas-y, raconte-lui ton aventure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631206,
					"content": "C'est à propos du monstre « au corps amorphe et brûlant »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631207,
					"content": "Ahem... euh, j'étais ivre ce jour-là, et je... je ne me rappelle plus très bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631208
					],
					"speakerTitle": "Stanley"
				},
				{
