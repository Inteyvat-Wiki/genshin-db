					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630801,
					"content": "« Son bouclier rugueux était un véritable cauchemar. J'avais beau frapper et frapper encore avec mon épée, il restait intact. Le monstre me regarda avec dédain et se moqua de mon impuissance. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630802,
					"content": "C'est ce que Cyrus m'a dit, j'en suis certain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630803,
					"content": "Il m'a aussi expliqué qu'il fallait d'abord trouver un moyen de détruire rapidement le bouclier du monstre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630804,
					"content": "Si on ne s'en débarrasse pas d'abord, aucune chance de lui infliger même la plus petite des égratignures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630805,
					"content": "D'après Cyrus, le monstre guette aussi le moindre moment de faiblesse de notre part pour attaquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630806,
					"content": "On parle de Cyrus, quand mêmme ! Ça ne m'étonne pas qu'il ait réussi à triompher d'un monstre aussi redoutable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630807,
					"content": "On ne peut pas en dire autant de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
