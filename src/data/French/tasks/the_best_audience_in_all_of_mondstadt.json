			"dialogs": [
				{
					"id": 200631201,
					"content": "Écoute-moi, Jack. C'est pas ce que tu crois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631202
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631202,
					"content": "Mais... Ah, tu es de retour ! Alors ? Tu as trouvé le monstre ?",
