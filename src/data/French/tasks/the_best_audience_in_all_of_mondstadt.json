						200631603
					]
				},
				{
					"id": 200631603,
					"content": "OK, j'avoue, j'ai un peu exagéré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631604,
					"content": "Tous les jeunes d'ici veulent rejoindre l'Ordre de Favonius ! Les aventuriers, ça ne fait plus rêver.",
