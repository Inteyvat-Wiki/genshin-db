					"nextDialogs": [
						200631405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631405,
					"content": "#T'es {M#sûr}{F#sûre} que tu ne t'es pas {M#trompé}{F#trompée} d'endroit ? Qu'en dites-vous, Stanley ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631406,
					"content": "Ahem ! J'ai une autre histoire à te raconter, Jack ! Je parie que tu vas l'adorer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631407
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631407,
					"content": "Mais le Cryoblob...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631408
					],
					"speakerTitle": "Jack"
				},
				{
