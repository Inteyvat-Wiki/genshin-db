					"speakerTitle": "Jack"
				},
				{
					"id": 200631305,
					"content": "#Impossible. Cyrus parlait sûrement d'un autre monstre... Tu es {M#sûr}{F#sûre} d'avoir été au bon endroit ?",
					"roleType": "TALK_ROLE_NPC",
