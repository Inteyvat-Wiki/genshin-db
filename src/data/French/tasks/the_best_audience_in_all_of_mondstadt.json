				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "J'en ai marre de rester ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Stanley m'a encore raconté une histoire hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Il était plus éméché que d'habitude, alors le tout était assez incohérent. En tout cas, j'ai cru comprendre que ça s'était passé près du <color=#00E1FFFF>Domaine de l'Aurore</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "Je me souviens qu'il m'a dit : « Des cristaux de glace se formèrent sur le corps du monstre, et le rendirent plus grand, plus menaçant... Mes jambes étaient paralysées par la peur, mais je parvins à déloger des morceaux de glace grâce à mon arme... Leur aspect était curieusement captivant... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "Ce monstre devait être costaud pour mettre Stanley en difficulté. Tu ne penses pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "J'aimerais tellement voir à quoi il ressemble, mais me connaissant, je n'oserais jamais m'en approcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "Toi, par contre, tu t'en tirerais beaucoup mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Merci ! Tu me raconteras tout dans les moindres détails quand tu reviendras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Allons-y ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "J'aurais voulu y aller avec toi, mais avec tout ce que j'ai à faire pour la Guilde... Bref, tu connais la chanson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Cyrus ne va pas tarder à prendre sa retraite. Il voudrait couler des jours heureux à Deauclaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Herman n'a plus quitté Mondstadt depuis la naissance de sa fille. C'est dommage, il était vraiment le meilleur aventurier de nous tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "Et Stanley est en congé jusqu'à nouvel ordre, puis ça fait des siècles qu'il n'est plus parti à l'aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "La Guilde a commencé à accepter des petits boulots pour renflouer ses caisses, mais nous n'avons même pas assez de membres pour les faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630317,
					"content": "C'est pour cette raison que je dois courir de gauche à droite pour pallier notre manque d'effectif. Bennett a d'autres chats à fouetter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
