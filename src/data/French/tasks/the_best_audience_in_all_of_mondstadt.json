					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "Quand est-ce que je pourrais devenir un aventurier légendaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Hier, Cyrus m'a raconté une aventure qu'il avait vécue dans les <color=#00E1FFFF>Montagnes du guet</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "Je cite : « Son bouclier rugueux était un véritable cauchemar. J'avais beau frapper et frapper encore avec mon épée, il restait intact. Le monstre me regarda avec dédain et se moqua de mon impuissance. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "J'aimerais bien voir ce fameux bouclier qui peut tout parer de mes propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Hélas, je suis débordé et le monstre que Cyrus m'a décrit à l'air terrifiant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Tu peux le chercher si jamais ça t'intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Génial ! Tu me raconteras tout dans les moindres détails quand tu reviendras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Allons-y ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Désolé, mais ça ne sera pas possible. J'ai encore une tonne de petits boulots à faire pour la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Partir à l'aventure ne rapporte plus rien de nos jours. Ces petits boulots n'ont rien de palpitant d'ailleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Je dois chasser des sangliers pour Draff, trouver le chat de Margaret, cueillir des fleurs pour Flora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "Ce n'est pas vraiment le genre d'aventures que je m'imaginais vivre quand j'ai rejoint la Guilde des aventuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
