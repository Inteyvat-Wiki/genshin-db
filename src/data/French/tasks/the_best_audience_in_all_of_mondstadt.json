					"nextDialogs": [
						200631310
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631310,
					"content": "Merci quand même, Jack. J'y vais, j'ai des choses à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
