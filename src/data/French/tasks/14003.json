			"dialogs": [
				{
					"id": 140030101,
					"content": "Je suis désolé, mademoiselle Charlotte. Ma sœur et moi sommes très occupés aujourd'hui, cette interview devra attendre plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "Ça ne prendra pas beaucoup de temps ! S'il vous plaît, monsieur Lyney !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "Oh, qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "J'ai passé toute la nuit à rédiger mon article sur la Belette fantôme et ça devait partir à l'impression ce matin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "C'est là que j'apprends soudainement que Jemma, la fiancée de César, est passée aux aveux chez les Gendarmes et qu'elle était la véritable Belette fantôme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "C'était rapide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "Ahem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "Oh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Trop tard, Lyney.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Haha ! Votre première réaction m'en dit long. On dirait que j'ai raté un épisode, pourriez-vous me raconter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "Ah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Je le savais, vous me cachez quelque chose ! Mon petit doigt me dit que les aveux de Jemma ont un lien avec le spectacle d'hier soir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Peut-être s'est-elle racheté une conscience parce que mon tour d'évasion lui a rappelé sa relation avec César ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Je vois... Non, c'est trop simple ! Il doit y avoir autre chose ! Ça ne lui aurait pas pris dix ans pour se dénoncer sinon, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "À ce propos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(L'instinct de journaliste de Charlotte est déchaîné aujourd'hui, il faut trouver un moyen de la distraire...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "Ah, je me souviens ! Jemma et vous étiez introuvables après la représentation. Quelque chose s'est passé entre vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "Une petite question ! Où êtes-vous allés après le spectacle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "#Après le spectacle ? On est {M#allés}{F#allées} au cimetière avec Lyney et il nous a montré un tour spécial rien que pour nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "D'ailleurs, Lyney utilise des roses arc-en-ciel dans ses tours maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "*tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "Oh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "#J'ai l'impression de n'avoir jamais reçu de rose arc-en-ciel de ta part, frérot. {M#Ils}{F#Elles} sont plus {M#importants}{F#importantes} que moi à tes yeux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "Non ! Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "C'est quoi cette réaction ? J'ai dit un truc qu'il ne fallait pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#L'ambiance est en train de devenir bizarre ici... Qu'est-ce qu'on fait, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "*soupir* On dirait que cette interview n'est pas pour aujourd'hui. Tant pis, je vous embêterai une prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Désolée d'avoir insisté, mais je ne peux pas m'en empêcher quand je flaire un scoop ! La nouvelle concernant Jemma a fait pas mal de remous, alors je ne renoncerai à rien pour découvrir toute la vérité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "Apparemment, elle aurait dit aux Gendarmes que son dernier vœu serait de revoir Lorenzo une dernière fois. *soupir* Les relations entre les protagonistes de l'affaire ont l'air compliquées et ça attise ma curiosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Bon, je vais vous laisser discuter tranquillement. À bientôt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "Hum, Lynette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "Pas d'inquiétude, je ne suis pas du tout fâchée. C'était juste pour la distraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "Ah bon ? Pfiou, vous m'avez bien eue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Et moi donc... Heureusement que ça a marché, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "... Prenez soin de cette rose arc-en-ciel, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Je serais triste aussi si vous la perdiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}