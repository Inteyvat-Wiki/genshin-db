						100060803
					]
				},
				{
					"id": 100060803,
					"content": "Ah oui, c'est vrai. J'ai l'habitude des chats qui parlent, mais c'est la première fois que j'en vois un capable d'imiter la voix des autres.",
					"roleType": "TALK_ROLE_NPC",
