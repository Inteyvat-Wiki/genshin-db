			"dialogs": [
				{
					"id": 100060101,
					"content": "Durin ! C'est là que tu étais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060102,
					"content": "#Oh, {NICKNAME} et Paimon. Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060103,
					"content": "Héhé ! Que fais-tu ici à lire quand il fait si beau dehors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060104,
					"content": "Depuis que j'ai l'occasion de parler à plus de monde à Mondstadt, je remarque que j'ai du mal à savoir si les gens plaisantent ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060105,
					"content": "Par exemple, j'ai vu une jolie fleur chez la fleuriste l'autre jour. Je l'ai dit à la patronne, et elle m'a répondu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060106,
					"content": "« Si vous aimez autant ces mauvaises herbes, pourquoi ne pas en faire un joli bouquet avec de la menthe et des fleurs sucrantes ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060107,
					"content": "Mais quand je lui ai montré le bouquet que j'avais fait selon ses conseils, elle a fait une tête effrayante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060108,
					"content": "Tu as des goûts particuliers, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Plus tard, Albedo m'a expliqué que c'était parce que je n'arrivais pas encore à comprendre l'implicite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060111,
					"content": "Après avoir appris le mondstatois, il m'a conseillé de venir ici pour lire des livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060112,
					"content": "Comme je suis né des pages d'un livre de contes, je devrais pouvoir apprendre les « règles » de ce monde à travers ces livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060113,
					"content": "#Et voilà que je me suis retrouvé à lire jusqu'à maintenant. J'ai un peu perdu la notion en temps... Au fait, pourquoi êtes-vous {M#venus}{F#venues} me voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060114,
					"content": "Les amis se voient régulièrement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Ah, je vois. Ça fait aussi partie des « règles », j'en apprends tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060116,
					"content": "C'est vrai, mais il faut quand même qu'on discute de choses importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060118,
					"content": "On a un « message » de Rhinedottir à te transmettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060119,
					"content": "Oh, c'est de tante Rhinedottir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060120,
					"content": "Ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "Hmm, je suis juste un peu surpris... Rhinedottir est une amie de ma mère, et aussi la mère du dragon qui existait autrefois dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060123,
					"content": "Et j'ai pris sa place et son destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060124,
					"content": "Je ne saurai pas quoi faire si elle me déteste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060125,
					"content": "Je ne pense pas qu'elle t'en veuille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "Oui ! Ne t'inquiète pas Durin, il ne va rien se passer de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060128,
					"content": "Vous me rassurez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060129,
					"content": "Je vais ouvrir ça, et voir ce qu'il y a dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060126,
					"content": "En tout cas, on sera à tes côtés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "Ne sois pas aussi nerveux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "On est là de la part de l'Hexenzirkel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "Je crois que c'est plutôt elle qui a un problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
