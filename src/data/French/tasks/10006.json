			"dialogs": [
				{
					"id": 100060601,
					"content": "« Hmm, on dirait qu'Albedo ne s'est pas trompé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060602,
					"content": "La prochaine fois, évitez les attaques surprises de monstres quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "J'ai l'impression que j'arrive à mieux contrôler la force qui est en moi, après les avoir éliminés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "« Après avoir entendu parler de ta situation, j'ai préparé un rituel capable de sceller le pouvoir maléfique dans ton sang. Je comptais te le transmettre à cette occasion. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060605,
					"content": "« Bien sûr, l'utilisation de cette technique a un prix. Elle te permettrait de maintenir ton existence en Teyvat, mais elle affaiblirait ton lien avec ce monde. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060606,
					"content": "« Tu es l'enfant de M, et je ne pourrais pas la regarder en face si tu devais subir le même destin que ton prédécesseur à cause de ces pouvoirs mal maîtrisés. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060607,
					"content": "« Mais je vois maintenant que mes inquiétudes étaient infondées. M est une mère remarquable, et bien plus compétente que je ne l'ai été. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060608,
					"content": "« À présent, je suis impatiente de voir ton évolution. Comment une créature alchimique bien intégrée dans ce monde trouvera-t-elle sa place dans la société humaine ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060609,
					"content": "« Je n'ai encore jamais mené une telle expérience. Peut-être que je trouverai une « réponse » inattendue à travers toi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "Rhinedottir"
				},
				{
					"id": 100060610,
					"content": "Hé, mais Durin n'est pas une expérience, c'est notre ami !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Je ne comprends pas vraiment, mais merci de votre gentillesse, tante Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
