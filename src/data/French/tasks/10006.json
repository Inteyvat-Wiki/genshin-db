			"dialogs": [
				{
					"id": 100060901,
					"content": "D'ailleurs, d'un point de vue biologique, en tant que créature alchimique, je ne peux pas être considéré comme un « chat ». C'est aussi absurde que de dire que ces spectres qui volent et toi êtes de la même espèce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Hum ? Un spectre ? Qu'est-ce que tu insinues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Je vois ! C'est ce qu'on appelle « lire entre les lignes », non ? Sebas voulait dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Ne le dis pas, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Hé ! Qu'est-ce que vous racontez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "Ah, maître Rhinedottir a dit que cette technique était inutile désormais, alors je vais la détruire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "C'est rare d'arriver à lui faire changer d'avis. Je suis impressionné, gamin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
