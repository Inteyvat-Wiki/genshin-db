			"dialogs": [
				{
					"id": 736810101,
					"content": "#{M#Voyageur}{F#Voyageuse}, Paimon, vous êtes là. J'ai entendu dire que vous aviez participé à la chasse aux paniers d'abondance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810102,
					"content": "C'était amusant ! Et on a reçu plein de décorations, je ne sais pas si ça a un lien avec la tenue de la foire vinicole du Weinlesefest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736810103,
					"content": "Haha, effectivement, certaines personnes aiment préparer ce genre de cadeaux. D'ailleurs, puisque nous tenons une boutique de snacks, pourquoi pas mettre ces décorations ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810104,
					"content": "Une boutique bien décorée permettrait d'attirer plus de clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810105,
					"content": "#En outre, les gens seront très heureux de voir que leurs cadeaux ont été utilisés pour décorer la boutique {M#du voyageur}{F#de la voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810106,
					"content": "#Vous avez raison ! {NICKNAME}, décorons notre boutique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
