					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130211,
					"content": "Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130212,
					"content": "Tellement d'années après les faits, ce n'est même plus son ami qui le retient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130213,
					"content": "C'est l'héritage de son ami. Voilà une histoire que Mondstadt n'est pas prête d'oublier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011303",
							"2"
						],
						"stepId": 1011303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Stanley, dis-moi ce que je dois faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130302,
					"content": "Tiens ? Pourquoi est-ce qu'il répète son propre nom comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130303,
					"content": "Peut-être qu'il cache quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Est-ce qu'il y a quelqu'un d'autre qui s'appelle Stanley ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130307,
					"content": "*sniff* Oh, Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130308,
					"content": "C'est moi qui aurais dû mourir ce jour-là dans la Mare Jivari... Pourquoi ton esprit ne revient-il pas pour m'empêcher d'utiliser ton nom ? Pourquoi, Stanley ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130309,
					"content": "Si tu n'avais pas sauvé le débutant que j'étais, tu ne serais pas mort dans cet endroit où le vent n'existe pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130310,
					"content": "Tu étais un aventurier célèbre, destiné à devenir une légende... Et à cause de moi, un moins-que-rien... Tu n'es plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130311,
					"content": "Euh... Quelqu'un a une idée de ce qui est en train de se passer là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130312,
					"content": "... J'ai bien l'impression que notre ami disait la vérité au sujet de la Mare Jivari et de la tragédie qu'il y a vécu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130313,
					"content": "Mais le grand aventurier Stanley, le vrai Stanley, était son partenaire – pas lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130314,
					"content": "Le vrai Stanley est mort pour sauver notre Stanley à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130315,
					"content": "Attends... Notre Stanley s'appelle comme ça parce qu'il a volé le nom du VRAI Stanley ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130316,
					"content": "J'en ai bien peur, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130317,
					"content": "Stanley, oh Stanley... Ça fait si longtemps que je vis dans la peur... Peur que Mondstadt n'oublie un jour ton nom... Alors je raconte tes aventures dès que j'en ai la chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130318,
					"content": "Mondstadt doit se souvenir que Stanley a atteint le centre de la Mare Jivari... Tu es le plus grand aventurier qui ait vécu, et tu continueras à vivre dans les mémoires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130319,
					"content": "Stanley ne mourra jamais, parce que je suis Stanley ! ... Je suis... Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130320,
					"content": "Pardon, Stanley... Je me fais vieux à présent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130321,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130322,
					"content": "Vous comptez rester là à espionner longtemps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130323,
					"content": "Zut ! Il nous a repérés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130305,
					"content": "Quelqu'un d'autre s'appelle Stanley ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "J'en doute... Je n'ai jamais entendu parler d'un autre Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "Partez, s'il vous plaît... Ne me posez pas de question, partez. Laissez-moi seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130402,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130403,
					"content": "Partez ! Ne m'obligez pas à vous le répéter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130404,
					"content": "Chevalier honoraire, Venti, Paimon ! Je suis bien content de vous trouver là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130405,
					"content": "Je vous ai cherchés partout ! Je voulais vous remercier de m'avoir aidé à trouver cette épée et ce bouclier ! Grâce à vous, mes parents m'apportent enfin leur soutien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130406,
					"content": "Oh, vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130407,
					"content": "Oui ! Et ils vont même payer pour restaurer l'Épée brillante de vaillance et l'Écu éclatant de l'honneur, et je pourrai les emporter quand je partirai à l'aventure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130408,
					"content": "Voilà une excellente nouvelle, Jack. Alors, tu te prépares à quitter Mondstadt pour partir vivre d'intrépides aventures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130409,
					"content": "Pas encore, non. Je ne suis pas encore assez fort, je crois bien que je n'irais pas très loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130410,
					"content": "Et puis, je suis sûr que Stanley a encore quelques histoires en réserve, héhé... Après tout, c'est à lui que je dois ma vocation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130411,
					"content": "Stanley, je... Oh, encore saoul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130412,
					"content": "Bon, alors à demain. Tu pourras me raconter d'autres histoires quand tu auras décuvé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130413,
					"content": "J'ai bien l'impression que Stanley aime beaucoup ce garçon, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130414,
					"content": "Jack ? Jack !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130415,
					"content": "Jack est parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130416,
					"content": "Ah, je vois... Merci de ne pas lui avoir dévoilé mon secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130417,
					"content": "Tiens ? Voilà que vous faites face à la réalité... Ça ne vous ressemble guère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130418,
					"content": "Je... Je n'ai pas osé croiser son regard. Son esprit aventurier n'est pas terni par les bassesses de ce monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130419,
					"content": "Je ne suis qu'un pauvre charlatan, mais ce garçon a tellement de potentiel... Son idéal doit rester vivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130420,
					"content": "« Charlatan », il ne faut quand même pas exagérer. Les aventures de Stanley sont réelles, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130421,
					"content": "Bah, à quoi bon, tout ça ne veut rien dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130422,
					"content": "À dire vrai, mes souvenirs de ces aventures et de Stanley ne sont plus ce qu'ils étaient, tout se brouille dans ma tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130423,
					"content": "Et c'est là mon plus grand secret, ma plus grande peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130424,
					"content": "J'ai vécu pour ses histoires toutes ces années ; mais je n'arrive déjà plus à me rappeler avec exactitude de sa personnalité, des détails de sa vie... Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130426,
					"content": "Il a vécu dans la culpabilité toute sa vie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "Il ne reste plus de tout ça qu'un ami imaginaire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "La seule chose que je ne pourrai jamais oublier, c'est qu'il nous a quittés là où le vent ne souffle jamais, et que son esprit ne pourra jamais trouver le repos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130428,
					"content": "Oui, en effet... Même dans ses souvenirs, le vrai Stanley n'est plus l'ami qu'il a connu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130429,
					"content": "Il ne voit maintenant plus que l'image d'un guerrier couvert de cicatrices... et cette image a pesé sur sa vie entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130430,
					"content": "Je suis trop vieux... Je n'ai jamais voulu abandonner, et pourtant tellement de choses m'ont échappé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130431,
					"content": "Je ne sers à rien ! À rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130432,
					"content": "Aucun aventurier ne devrait mourir comme ça... Non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130433,
					"content": "Je... J'ai du mal à y croire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130434,
					"content": "Merci... Merci à vous tous ! Et merci à toi, Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130435,
					"content": "Pardonnez-moi, je crois qu'il va me falloir un peu de temps pour retrouver mes esprits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130436,
					"content": "Mais... Je crois que ça ira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130437,
					"content": "Bien, voilà qui est merveilleux ! Stanley a enfin fait face à ses démons, et Jack peut suivre son chemin à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130438,
					"content": "Voilà une journée féconde en bonnes nouvelles ! Ça mérite d'être fêté, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130439,
					"content": "Et j'imagine que tu veux dire par là que tu ne partiras de cette taverne que quand tu rouleras par terre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130440,
					"content": "Haha, l'alcool est bien trop cher ici. Jack me doit encore une récompense – il m'avait promis une bouteille de bon vin, vous vous en souvenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130441,
					"content": "Je vais de ce pas aller me rappeler à son bon souvenir ; je vous retrouve à l'<color=#00E1FFFF>endroit habituel</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130443,
					"content": "Il ne nous reste plus qu'à deviner...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "Je pense savoir de quoi il s'agit... Sans doute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Je vous retrouve à l'<color=#00E1FFFF>endroit habituel</color> !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "Hein ? Quel endroit habituel ? Pourquoi ça ne me dit rien ? Hé ! Barde de pacotille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130446,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "Ah, vous voilà, enfin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130502,
					"content": "Dis-nous où on se retrouve la prochaine fois ! On a cherché partout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130503,
					"content": "Ah, d'ailleurs, tu as récupéré ta bouteille, le barde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130504,
					"content": "Oui. Jack m'avait promis un vin exceptionnel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130505,
					"content": "Mais il ne s'agit que d'une demi-bouteille de cidre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130506,
					"content": "Ah, cela fait remonter des souvenirs, tiens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130507,
					"content": "Je n'avais pas encore pris cette forme la première fois que j'ai admiré cette vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130508,
					"content": "Euh... Quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "C'était il y a quelque chose comme 2 600 ans, avant même que le monde ne soit sous la férule des Sept Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130510,
					"content": "L'ancienne Mondstadt était alors dirigée par un tyran ; la cité était enfermée dans un ouragan rageur ; même les oiseaux ne pouvaient ni y entrer, ni en sortir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130511,
					"content": "« L'ancienne Mondstadt » ? Oh, l'endroit qu'on appelle maintenant l'Antre de Stormterror, c'est ça ? Je me souviens que tu l'avais mentionné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130512,
					"content": "En effet. Le tyran des vents qui régnait alors depuis la haute tour était Décarabian, le dieu des tempêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130513,
					"content": "À cette époque, je n'étais qu'une brise légère parmi les vents. Je n'étais pas un dieu – je n'avais même pas forme humaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130514,
					"content": "Je n'étais rien de plus qu'un être élémentaire vivant dans le vent, une bise porteuse de changements minuscules, et d'espoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130515,
					"content": "Tu n'étais qu'un être élémentaire ? Pas de forme humaine ? Venti, tu es en train de dire que tu n'as pas toujours été comme euh... tu es maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130516,
					"content": "Hé oui. La forme que vous voyez aujourd'hui rappelle un peu l'histoire de Stanley... J'ai pris la forme d'un ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130517,
					"content": "Et...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130518,
					"content": "Qu'est-ce qui est arrivé à cet ami ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130519,
					"content": "(C'est la même histoire qu'avec Stanley...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "Tu voudrais connaître la suite de l'histoire, Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130521,
					"content": "Oh oui ! Évidemment ! Ce suspense est intenable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130522,
					"content": "Paimon, va nous chercher deux pommes, d'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "Hein ? Pourquoi tu as envie de pommes, tout à coup ? C'est bien le moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130526,
					"content": "Hahaha, on a un petit creux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130527,
					"content": "Hé oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "Pfff... Je te jure, toi des fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130529,
					"content": "#Tsss... Tu sais, je me dis par moments que tu es un peu trop {M#intelligent}{F#intelligente}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130530,
					"content": "Mais après tout, les vrais amis n'ont pas de secret l'un pour l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130531,
					"content": "Un bon verre, un vent léger... Ce genre de moments fait remonter pas mal de souvenirs à la surface...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130532,
					"content": "Je me souviens de cette chanson qu'il chantait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130533,
					"content": "Je t'écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "Paimon, tu irais nous chercher un peu de viande ou de poisson ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "Hein ? Et l'histoire alors ? Tu veux vraiment manger ce genre de trucs tout de suite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}