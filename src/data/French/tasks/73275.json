				},
				{
					"id": 732750307,
					"content": "Nous devrons en prendre soin. J'ai l'intention de les léguer à Sabbah. Ces fleurs seront les siennes lorsque j'aurai quitté ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Tu m'as vraiment été d'une grande aide et sans rien demander en retour. Je ne pourrais pas dormir la conscience tranquille si je ne te donnais pas un petit cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Ce plant a germé récemment et Sabbah m'a suggéré de te l'offrir. Elle te l'a même emballé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Prends-le comme un souvenir de nous. J'espère que tu seras toujours aussi tenace que lui et que tu ne perdras jamais confiance en toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
