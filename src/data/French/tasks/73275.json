			"dialogs": [
				{
					"id": 732750102,
					"content": "Les graines de rose dorée ont donné des plants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Où as-tu bien pu trouver ces graines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Elles viennent de loin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Ma foi, je suppose que les graines d'oncle Shafaqat sont bel et bien revenues ici après avoir été répandues dans tous les coins du désert. Même si le chemin qu'elles ont pris n'a pas été de tout repos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Nous devrons en prendre soin. J'ai l'intention de les léguer à Sabbah. Ces fleurs seront les siennes lorsque j'aurai quitté ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Merci. Je n'ai pas grand-chose à offrir, mais acceptez ces fruits et fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
