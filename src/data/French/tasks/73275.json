			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "À propos de la chanson...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "#Tu te souviens de cette chanson ! Héhé, encore {M#un}{F#une} jeune qui s'en rappelle, c'est bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "« Rose, rose, réalise mon souhait. Elle fleurit de la pierre et chante pour moi, la rose dorée. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "« Aucune terre ne veut de moi, seuls les chants me portent. Les chants triompheront de mon cruel destin, eux seuls triompheront de ma fin. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "« Ils triompheront de moi, ils triompheront du temps et triompheront de l'éternel flétrissement... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
