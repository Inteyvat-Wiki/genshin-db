			},
			"dialogs": [
				{
					"id": 250290201,
					"content": "C'est bien ! Tu as beaucoup mangé aujourd'hui ? Tu as la force de t'entraîner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290202,
					"content": "Raouh, raouh raouh, raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290203,
					"content": "Bravo ! Tu es en forme aujourd'hui. C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "Allez !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#Oh ? Bonjour {NICKNAME} ! On s'entraine à escalader la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "Raouh raouh ! Raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290208,
					"content": "Raouh raouh, raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290209,
					"content": "Comment se passe votre entraînement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Eh bien... On fait des progrès. Qica a grimpé beaucoup plus haut que la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
