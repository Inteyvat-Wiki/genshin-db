			"dialogs": [
				{
					"id": 250290101,
					"content": "Oh mon petit, ne te décourage pas. Quand tu te seras rétabli... Persévère et tu atteindras le sommet en un rien de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290102,
					"content": "Raouh raouh... Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290103,
					"content": "Tu as faim ? Hmm... Je vais te chercher quelque chose à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290104,
					"content": "Raouh... Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290105,
					"content": "Qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "Je joue avec mon copain Qica. Il est encore tout petit, mais ma maman dit que quand il sera grand, il deviendra un yumkasaure aussi fort que les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290107,
					"content": "Raouh... Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290108,
					"content": "Ne sois pas triste. Ton physique n'est pas encore très robuste, et tu t'es blessé en plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290109,
					"content": "Maman dit que tu iras mieux si tu manges plus et que tu fais plus d'exercice avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290110,
					"content": "Raouh ? Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290111,
					"content": "(Toucher Qica...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "Raouh raouh... Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290119,
					"content": "Oups, on a trop parlé. C'est presque l'heure de faire de l'exercice. Mangeons quelque chose d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290120,
					"content": "Ce sont des fruits secs que ma maman a faits. Elle fait revenir les fruits dans une grande marmite et y ajoute plein d'assaisonnements délicieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290121,
					"content": "Ensuite, elle met beaucoup de sucre et de pétales... Bref, c'est tellement bon ! Je vais t'en donner... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290122,
					"content": "Où sont mes fruits secs ? J'étais sûr de les avoir mis dans mon sac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290123,
					"content": "... Raouh, raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290124,
					"content": "Ah, Qica ! Tu as tout mangé, hein ? Je t'ai déjà dit de ne pas être trop gourmand, sinon ça va être difficile de courir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290125,
					"content": "... Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290126,
					"content": "C'est bien d'avoir de l'appétit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "Raouh raouh, raouh raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290129,
					"content": "Vraiment ? Moi aussi, je veux être comme Qica. Si je mange beaucoup, je pourrai grandir très vite et aider maman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290130,
					"content": "Bon, commençons l'entraînement, Qica !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290131,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290132,
					"content": "Voyons voir... Et si on faisait de l'escalade aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290133,
					"content": "Raouh, raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290134,
					"content": "Ça sera comme la dernière fois, pas du tout difficile. Allez, Qica !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290135,
					"content": "... Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290136,
					"content": "Au fait, oncle Yawar m'a dit la dernière fois que si l'on voulait bien s'entraîner, il fallait trouver un « objectif d'entraînement » raisonnable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290137,
					"content": "Si seulement je pouvais trouver un aventurier pour m'aider à fixer des objectifs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290138,
					"content": "#Je suis {M#celui}{F#celle} que tu recherches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "C'est vrai ? Vous pouvez m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290141,
					"content": "Voulez-vous que j'escalade la montagne avec vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "#Non, attendez. Si vous êtes très {M#fort}{F#forte}, on n'arrivera pas à avoir le même rythme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290144,
					"content": "On restera ici pour voir combien de temps ça vous prend pour atteindre le sommet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290145,
					"content": "Bon courage ! Grimpez au sommet de la montagne aussi vite que possible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290146,
					"content": "Raouh ! Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290142,
					"content": "D'accord. Suivez-moi alors. On part maintenant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "#{M#Un aventurier}{F#Une bonne aventurière} se tient juste devant toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "Plus on mange, plus on devient fort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "Comment s'est-il blessé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "Aucune idée... Peut-être que maman le sait ! Quand elle l'a ramené à la maison, il était déjà malade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290115,
					"content": "Il ne mangeait rien et n'avait pas la force de bouger. Tout ce que j'ai pu faire, c'était dissoudre un médicament dans l'eau et le lui faire boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290116,
					"content": "Bien que sa maladie soit guérie, ça... Ça l'a affaibli. Il ne peut pas se déplacer sur le côté des falaises comme les autres yumkasaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290117,
					"content": "Tout ça l'a rendu très triste, alors je veux l'aider à retrouver sa forme et puis... à devenir plus fort que les autres yumkasaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290118,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				}
			]
		},
