				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "#Que diriez-vous d'une partie en équipe cette fois{NON_BREAK_SPACE}? Ou un duel{NON_BREAK_SPACE}? Ah, c'est vous{NON_BREAK_SPACE}! Bienvenue au terrain d'entraînement{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "À propos du terrain d'entraînement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "De plus en plus de gens viennent ces derniers temps. Tout ça grâce à vous. Bien sûr, les gamins et les Creusemains ont joué un rôle dedans aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Je pense que le terrain d'entraînement est parfait pour se retrouver entre amis. Lorsqu'on croise quelqu'un qu'on n'a pas vu depuis longtemps, on ne sait jamais quoi dire pour commencer. Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "À propos des Creusemains...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah... Je n'ai pas encore trouvé de meilleure solution que les cibles pour les terriers des taupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "Les gamins et moi avons essayé avec toutes sortes de matériaux, mais rien n'y fait. Elles adorent les cibles. Pour l'instant, les échanges sont notre seule option...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Mais on connaît bien leur taux de change en matière de trésors, alors on est toujours gagnants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Je repasserai vous voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "#Vous êtes les {M#bienvenus}{F#bienvenues} quand vous voulez ! Ce sera toujours gratuit pour vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
		{
