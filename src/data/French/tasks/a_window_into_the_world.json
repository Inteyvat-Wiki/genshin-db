			"dialogs": [
				{
					"id": 761410501,
					"content": "Je comprends si vous voulez rester un moment. Après tout, ce paysage n'existe que dans mes souvenirs. Vous ne le trouverez nulle part ailleurs.",
					"roleType": "TALK_ROLE_NPC",
