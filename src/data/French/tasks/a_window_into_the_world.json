			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "Bon retour, vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "Mais ce n'est pas encore le moment pour des adieux longs, émouvants et larmoyants... Après tout, vous n'avez pas encore terminé la visite de mon petit chalet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "Mais je jurerais qu'on a déjà visité toutes les pièces, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Je n'ai jamais dit qu'il n'y avait pas de pièce secrète. Les sorcières ont toujours leurs petits tours... Vous devriez commencer à vous y habituer, depuis le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "Par ici, je vous prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "En tant que point d'observation fixe des changements du monde, je dois disposer d'un excellent champ de vision. Tout comme un sculpteur a besoin de son burin, un écrivain ne peut se passer de plume et d'encre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "Mes accomplissements dans ces deux domaines artistiques peuvent être sujets à débat, mais en ce qui concerne mon activité principale, je prends les choses très au sérieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}, vous l'avez sûrement ressenti vous aussi. Ces derniers temps, le «{NON_BREAK_SPACE}destin{NON_BREAK_SPACE}» de Teyvat est de plus en plus souvent ébranlé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "Parfois, je ne peux m'empêcher de penser que si j'avais encore la forme, la puissance et les capacités d'autrefois, je pourrais accomplir bien plus que ce que je suis capable de faire actuellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "Mais je chasse rapidement ces pensées de mon esprit. Si les choses étaient comme avant, j'aurais bien plus de restrictions imposées par les cieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "Quand je pense au nombre de sujets que je ne peux même pas aborder, j'ai l'impression que c'est un terrible compromis. Sans la liberté de dire ce que je veux, comment pourrais-je raconter des histoires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "C'est pourquoi je n'ai jamais regretté le prix que j'ai payé, ni aucun des choix que j'ai faits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "Je voulais devenir humaine, vivre comme une personne ordinaire... mais ce genre de vie est un luxe. Je ne peux pas oublier que je suis un ange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Même condamnée à rester un ange dans le silence, je continuerais d'accomplir mes devoirs : défendre la civilisation, défendre la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Oh là là... On dirait que j'ai encore parlé de manière trop sérieuse. C'est sans doute à cause de cet endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "En réalité, je suis plutôt satisfaite de mon côté angélique. On pourrait même dire que j'en suis fière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "Et vous avez raison de l'être ! Vous n'intervenez pas souvent, mais quand vous le faites, nous savons tous que nous sommes entre de bonnes mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "Vous avez de quoi être fière.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "Vraiment ? Haha, tant que vous me voyez comme quelqu'un de fiable, alors je sais que je fais du bon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "Il se fait tard. Tenez, prenez ma bénédiction et continuez votre aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "N'ayez jamais peur de vous égarer, et n'oubliez pas qu'un ange veille sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
