						741210304
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210304,
					"content": "Hé ! Je vous ai sonné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210305,
					"content": "... Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210306,
					"content": "Quel temps agréable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210307,
					"content": "La personne là-bas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "Qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210309,
					"content": "Je ne sais pas de qui vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210310,
					"content": "Nous sommes juste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210311,
					"content": "... En train de nous promener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210312,
					"content": "Tout à fait, nous faisons une promenade. Une promenade que deux individus complètement ordinaires ont décidé de prendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210313,
					"content": "Quel temps agréable. C'est beau de se promener, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210314,
					"content": "C'est totalement normal de se promener. Je suis sûr que vous êtes d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210315,
					"content": "Euh, qu'est-ce que vous racontez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210316,
					"content": "Vous n'avez pas entendu quelqu'un appeler à l'aide ? Un homme est enfoui dans le sable là-bas et il a failli se faire manger par les crabes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210317,
					"content": "Comment ? Une telle chose s'est produite pendant notre promenade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210318,
					"content": "Sous ce beau temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210319,
					"content": "S'il se fait manger par les crabes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210320,
					"content": "Ce serait vraiment trop drô... Euh, vraiment trop triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210321,
					"content": "Dommage que nous ne laisserions pas ça se produire... Euh, je veux dire que nous ne pouvons pas laisser ça se produire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210322,
					"content": "Nous ne resterons pas les bras croisés si ce genre d'événements arrive pendant notre promenade. Enfin, si ça arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210323,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "On se promène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210325,
					"content": "On vous l'a déjà dit, qu'on se promenait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210326,
					"content": "Vous n'avez rien remarqué d'étrange ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210327,
					"content": "Rien du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210328,
					"content": "Oui, rien du tout. À part le fait que vous interrompez notre promenade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210329,
					"content": "Les promenades sont... très personnelles. Nous n'aimons pas être interrompus quand on en fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210330,
					"content": "Si vous voulez vous promener, nous vous suggérons la Fontaine de Lucine. C'est un endroit idéal pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210331,
					"content": "Mais ici, c'est le lieu de nos promenades. Enfin, où nous ressentons la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210332,
					"content": "C'est pour cette raison que nous ne voulons pas être interrompus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Turner"
				}
			]
		},
