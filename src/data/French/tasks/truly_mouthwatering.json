					}
				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "... Quoi ? Ils ne voulaient pas me tuer ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "*soupir* Vous êtes vraiment perspicaces. Oui, c'est moi qui ai cassé la machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Mais pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Pourquoi ? Eh bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Autrefois, ma vie était pauvre et misérable. J'étais vraiment déprimé. Et c'est là que j'ai rencontré un bon gars qui m'a offert une boisson saine qui m'a remonté le moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "Il a été vraiment gentil avec moi, alors je voulais lui rendre la pareille. Un jour, la chance m'a enfin souri ! Il m'a présenté à des gens très fortunés et m'a demandé de les aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Je ne faisais que des petits boulots, comme récupérer des composants mécaniques qui appartenaient à l'Institut de recherche de Fontaine. Ces gens fortunés me payaient plutôt généreusement pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "Ouah, mais c'est super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "Pas vrai ? Cette fois, ils m'ont demandé de trouver cette machine étrange et d'en extraire le noyau pour le leur donner. C'était l'occasion de rendre la faveur que je devais et de me faire des moras. Il fallait que je me donne à fond !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Mais ces individus méprisables... Ils étaient peut-être jaloux de me voir me démener pour améliorer ma qualité de vie, alors ils m'ont perturbé pendant mon travail et m'ont menacé de ne pas remettre les, euh, composants de précision, à mes employeurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "Mais ils ne m'ont pas eu ! C'est un travail qu'on m'a confié, alors je ne me suis pas laissé faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "Du coup, comme vous l'avez dit, ils m'ont donné une leçon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Oh, pauvre de vous... Mais votre travail est-il vraiment bien payé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Bien sûr, c'est pour cette raison que je ne voulais pas vous dire pourquoi je me suis opposé à eux. Mais vous m'avez sauvé la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "Votre vie n'était pas vraiment en danger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "... De plus, je vous estime assez perspicaces, alors je vais vous dire toute la vérité. Voyez ça comme une proposition de collaboration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "D'étranges machines comme celle-ci ont été installées à la surface et sous l'eau. Elles sont faciles à repérer grâce à la lumière particulière qui les entoure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Mettez-les hors service et ramenez-moi le noyau qui se trouve à l'intérieur d'elles. Il y en a <color=#00E1FFFF>sept</color> en tout. Une fois que c'est fait, on se partagera la récompense 50/50. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Ça me va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Hum, mais à quoi servent ces machines au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Elles détruisent l'environnement. Ce sont des machines utilisées à des mauvaises fins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "Qu'est-ce que j'en sais ? Je ne fais pas partie de l'Institut de recherche de Fontaine. Des anomalies se sont déjà produites de toute façon, c'est donc un danger pour l'environnement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Hum... Ça me semble plausible. Il y a des problèmes qui arrivent à chaque fois qu'on se retrouve dans des environnements surnaturels dans nos aventures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#Et si on aidait Henri, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Haha, génial ! C'est marché conclu ! <color=#00E1FFFF>Ramenez-moi les sept noyaux</color> et faisons fortune ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "À quoi servent ces machines ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "Je demande 70 % de la récompense avec 20 % d'acompte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "... *soupir* D'accord, mais je ne peux pas vous donner ça en avance. Il faut avoir réussi pour être payés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Hum, mais à quoi servent ces machines au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
