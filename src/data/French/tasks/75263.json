				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Votre attention, s'il vous plaît ! Le Tournoi des champions de la vitesse de Brisedouce est sur le point de commencer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "La personne qui battra notre champion en titre, « Le Nanassien impétueux », vainqueur depuis trois jours consécutifs, remportera le grand prix surprise d'aujourd'hui ! C'est votre dernière chance de vous inscrire au tournoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "#Hmph ! Il n'y a plus aucun adversaire pour m'affronter, moi, «{NON_BREAK_SPACE}Le Nanassien impétueux{NON_BREAK_SPACE}»{NON_BREAK_SPACE}? Hein, c'est ça{NON_BREAK_SPACE}? Vous avez tous trop peur maintenant{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*soupir* Personne ne peut battre « Le Nanassien impétueux ». Il a gagné trois jours d'affilée, personne n'est à sa hauteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Oh, tu veux essayer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hmph. Nous en sommes donc réduits à laisser des sauriens concourir ? Très bien ! Envoyez toutes vos bêtes et je vous montrerai à quoi ressemble la vraie vitesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Quel tournoi unique en son genre ! Les puissants compagnons sauriens parviendront-ils à détrôner notre triple vainqueur, « Le Nanassien impétueux » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
