				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Je voudrais m'inscrire, moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "#Quel rebondissement ! {M#Un courageux}{F#Une courageuse} adversaire se présente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Hein ? Tu penses avoir la moindre chance contre moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Il y a tant de rebondissements aujourd'hui... Qui sera le champion ? Découvrons-le ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "Le personnel termine de préparer le parcours et la foule se rassemble... Vous vous placez sur la ligne de départ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
