			"dialogs": [
				{
					"id": 752630501,
					"content": "La course est terminée ! Quel incroyable renversement de situation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#Et {M#le grand gagnant}{F#la grande gagnante} de ce tournoi est... {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "#Waouh ! {M#Il}{F#Elle} est incroyable ! {M#Il}{F#Elle} a même réussi à battre « Vite fait » et «{NON_BREAK_SPACE}Bien fait{NON_BREAK_SPACE}»{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{M#Il}{F#Elle} ressemble à un éclair doré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Oh, allez... Et cet éclair argenté ? Personne n'a vu l'éclair argenté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "C'était une défaite cuisante... Je doute pouvoir un jour atteindre une telle vitesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "« Le Nanassien impétueux »"
				},
				{
					"id": 752630507,
					"content": "N'abandonne pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Je suivrai ton exemple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "« Le Nanassien impétueux »"
				},
