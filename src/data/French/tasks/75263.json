			"dialogs": [
				{
					"id": 752630301,
					"content": "Incroyable ! Quelqu'un a réussi à battre « Le Nanassien impétueux » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "#{M#Ce concurrent}{F#Cette concurrente} a remporté la victoire grâce à ses mouvements rapides comme l'éclair ! Félicitations !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "J'ai perdu ?! Impossible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "« Le Nanassien impétueux »"
				},
				{
					"id": 752630304,
					"content": "#{M#Il}{F#Elle} est trop {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Mais nos spectateurs de longue date doivent savoir que « Le Nanassien impétueux » n'était pas le coureur le plus fort à parcourir cette piste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Avant lui, deux légendes locales indétrônables dominaient la compétition. Et aujourd'hui, elles sont de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Veuillez accueillir « Vite fait »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪, ♩ ~ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "... Et « Bien fait » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫, ♩ ~ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "#{M#Cher concurrent}{F#Chère concurrente}, ces deux-là ne rigolent pas. Même après la performance que vous venez de livrer, les battre sera quasi impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "#Êtes-vous {M#prêt}{F#prête} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "#Je suis {M#prêt}{F#prête} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "Le personnel termine de préparer le parcours et la foule se rassemble... Vous vous placez sur la ligne de départ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
