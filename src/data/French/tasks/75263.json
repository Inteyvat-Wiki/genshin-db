					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "#Veuillez accepter ce prix réservé {M#au champion}{F#à la championne} du tournoi. Vous l'avez mérité{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
