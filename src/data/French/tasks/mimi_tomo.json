					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "#{M#Voyageur}{F#Voyageuse}, par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240102,
					"content": "#Désolée de t'accaparer comme ça, mais serais-tu {M#intéressé}{F#intéressée} par une nouvelle mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240103,
					"content": "Je t'écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "Bon, selon un rapport récemment obtenu par la Guilde, des Brutocollinus sauvages se sont à nouveau rassemblés pour attaquer les routes commerciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240106,
					"content": "On a déjà déployé pas mal d'aventuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240107,
					"content": "Mais les rapports signalent qu'un Brutocollinus particulier se trouverait parmi les Brutocollinus rassemblés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240108,
					"content": "La Guilde pense que cet étrange Brutocollinus pourrait être la cause des troubles récents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240114,
					"content": "Nous avons besoin de quelqu'un pour capturer ce Brutocollinus, ou au moins pour le chasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240109,
					"content": "#{M#Voyageur}{F#Voyageuse}, es-tu {M#prêt}{F#prête} à accepter cette mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240110,
					"content": "Sans problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "Merci. J'ai déjà indiqué plusieurs endroits sur ta carte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240113,
					"content": "C'est là que tu trouveras ces Brutocollinus. Tu n'as qu'à commencer ton enquête à ces endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240115,
					"content": "#Si tu tombes sur cet étrange Brutocollinus, sois {M#prudent}{F#prudente}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 700240111,
					"content": "Je vais me renseigner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "Quelle mission ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "On tombe à pic...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "Tu vas bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "Ouf... C'était moins une ! Heureusement que vous étiez là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240204,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240205,
					"content": "Tout allait bien jusqu'à présent... J'aurais mal prononcé quelque chose...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240206,
					"content": "#Peu importe... Merci d'être {M#intervenus}{F#intervenues}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240207,
					"content": "Elle a l'air plutôt triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240208,
					"content": "Ma foi, vous avez bien vu ce qui vient de se passer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240223,
					"content": "Discuter seule avec les Brutocollinus peut être assez risqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240210,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "Est-ce qu'on peut t'aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "Mais je ne vais pas renoncer à communiquer avec les Brutocollinus pour autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240212,
					"content": "Si ça continue, je vais prendre du retard dans la rédaction de mon dictionnaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240213,
					"content": "Je peux t'aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "L'idéal serait que quelqu'un puisse vérifier à ma place que ce j'ai écrit dans mon carnet est correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240214,
					"content": "Vraiment, c'est vrai ? Génial ! Bon, alors prends ce carnet avec toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240215,
					"content": "Waouh... D'un coup d'un seul, on nous donne des ordres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240217,
					"content": "« En théorie » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "Si tu as des problèmes pour communiquer, il te suffit de regarder dans le dictionnaire... Enfin, en théorie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240218,
					"content": "Alors même Ella ne sait pas ce qu'elle écrit ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240219,
					"content": "Opinion de néophyte ! Comment savoir si la logique est correcte tant qu'on ne met pas les résultats obtenus en pratique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240225,
					"content": "*soupir* ... Laisse tomber. De toute façon, tu ne comprendrais pas si j'en disais plus. Quoi qu'il en soit, je te suis très reconnaissante de m'avoir sauvée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240221,
					"content": "Avec plaisir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "Plus on est de fous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "Si ça ne vous dérange pas, j'aimerais vous accompagner pour discuter avec les Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "Ella Musk"
				}
			]
		}
	]
}