						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "Est-ce que je peux faire quelque chose pour aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Vous ? Hmm, laissez-moi réfléchir... Donnez-moi un peu de temps, il y a sûrement une solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Pour le moment, le plus important est que vous continuiez votre exploration pour découvrir ce qu'il se passe en dessous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Ne vous inquiétez pas, je ne vais pas négliger une affaire aussi importante... Je suis responsable de la sécurité de l'équipe d'exploration et je ne veux pas que mon argent ait été dépensé pour rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "Prenez-vous la responsabilité de ma sécurité aussi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "#Hmm, je dois dire que vous êtes plus capable que ce que je pensais, alors... vous êtes suffisamment {M#fort}{F#forte} pour être responsable de vous-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "*soupir* Bon, d'accord. Oubliez ce que je viens de dire... S'il vous arrive quelque chose, je paierai pour vous dédommager, ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
