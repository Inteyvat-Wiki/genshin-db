	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "Ah, vous voilà. Merci beaucoup d'avoir ouvert la voie. Zhiqiong nous a aussi beaucoup aidés à nous frayer un chemin. On vous remercie beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "À propos du camp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Qu'est-ce que vous en pensez ? C'est pas mal, non ? J'ai du métier, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "J'ai commencé à apprendre ces choses-là avec mon père quand j'avais à peu près dix ans... Il m'a enseigné comment monter un camp, comment fabriquer des lampes à cristal, et comment entretenir les outils de la mine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Je n'ai pas arrêté d'apprendre et mon père se faisait de plus en plus vieux... Sa vue s'est détériorée, puis il a fallu que je prenne la relève pour l'entretien de l'équipement de sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "Après ça, eh bien... Je ne suis plus toute jeune, vous voyez. Il n'y a pas grand-chose à dire sur les années qui ont suivi. J'ai trouvé un mari, puis il est parti. J'ai eu une fille, puis elle s'en est allée faire des études à Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Il arrive que les hommes de la mine s'en aillent plus tôt que prévu, et c'est moi qui dois m'occuper des enfants qu'ils laissent derrière eux... J'ai toujours des petites sucreries sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Dans mon esprit, les enfants ont toujours une odeur sucrée sur eux pour cette raison. Ils attendent par terre avec leurs yeux tout ronds que vous leur donniez des sucreries ou que vous leur montriez une jolie pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "Ouah... Donc vous avez des bonbons sur vous en ce moment même, Jinwu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Des bonbons ? Euh... Je n'ai pas ces gourmandises multicolores que l'on trouve en ville, non. Mais vous ne refuseriez pas un morceau de sucre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "C'était donc ça, vos fameuses sucreries...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "#Les gens qui m'entourent vont et viennent. La seule chose qui persiste, c'est le souci que je me fais pour eux. Et bien sûr, il y a vous, ces {M#aventuriers}{F#aventurières} qui descendent dans la mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Parlez-moi de Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong fait partie de la nouvelle génération de mineurs. Elle est née dans le Village Mingyun. En fait, tous les mineurs expérimentés du Gouffre viennent du Village Mingyun... Zhiqiong n'est pas arrivée à la bonne époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Ne vous méprenez pas. Je ne suis pas en train de dire que les temps sont mauvais aujourd'hui. Je veux simplement dire que le Village Mingyun a dû arrêter ses activités il y a quelques années parce que ses ressources minières se sont épuisées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Plus tard, Zhiqiong est arrivée au Gouffre et les activités au Gouffre ont, elles aussi, cessé... Peut-être que cette enfant n'est pas destinée à travailler dans les mines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Euh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "À la suite de ces événements, tout le monde a cherché un nouveau gagne-pain. Moi, je suis restée à la mine pour entretenir les équipements restants après le départ des autres. Quant à elle, elle est devenue aventurière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Cette enfant ne grandit jamais, elle ne fait pas du tout attention à elle-même. Elle n'a pas passé assez de temps à la mine, ça se voit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Si Zhiqiong avait pu s'habituer à la vie de mineuse et qu'elle avait sauvé des personnes en situation de danger... Elle aurait compris bien des choses à la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Je sais que ce n'est pas décent de demander une telle chose, mais... J'aimerais que vous la surveilliez un peu, qu'elle ne mette pas sa vie en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Oui, faites attention à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Bonjour ! Comment se passe votre voyage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "Bonjour, comment allez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Je dois vous remercier de m'avoir offert une chance. Depuis que nous avons réussi à déployer le boulet de canon et son détonateur, tout le monde est d'accord pour que je reste ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Quant à ce que je vais faire quand je serai à la surface... Haha, je n'y ai pas encore réfléchi ! En tout cas, je ne vais probablement plus être un Pilleur de trésors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "Probablement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Je n'en serai plus un, plus jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Pour de vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "Cette fripouille... Grr... Hein ? Ah, bonjour. Désolé, mais vous me dérangez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "On est quittes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "C'est bon, arrêtez vos bêtises. Je suis dans une très mauvaise situation, vous savez ? Ce n'est pas bon du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Vous aussi, vous avez vu ce fragment de cristal lumineux, n'est-ce pas ? Selon moi, il devrait y en avoir un plus grand en bas... Je suppose que vous vous en doutiez aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "En théorie, nos relevés d'énergie auraient dû se stabiliser lorsque le bloc supérieur est « revenu »... Eh bien, c'est exactement ce qui s'est passé. Cependant... la forme d'onde était complètement anormale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Qu'est-ce que vous racontez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "Je vois que vous n'avez pas fait d'études... Bon, je vais faire simple : nous sommes en ce moment pris dans une lutte entre deux puissantes forces, comme des grains pris entre deux meules, vous voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "À long terme, nous allons être réduits en bouillie par une force venant du dessus et une autre venant du dessous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Si vous ne me croyez pas, attendez de voir. Cette aventurière, Zhiqiong... J'ai pu voir ce qui lui était arrivé après avoir été en contact avec cette chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Aujourd'hui, elle tousse du sang. Mais demain, peut-être qu'elle crachera ses poumons.",
					"roleType": "TALK_ROLE_NPC",
