					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "Mais où est-il passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "Qu'est-ce que tu as – encore – perdu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Je n'ai rien perdu cette fois... Je cherche toujours ! Mais je n'arrive pas à remettre la main dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "Où est-ce qu'il peut bien être ? Après tous les efforts que ça m'a coûté de déterminer sa position...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "Aide-moi à mettre la main dessus, d'accord ? On ne peut pas laisser un tel objet au milieu de nulle part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Chercher par là-bas, moi je continue à chercher ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "Il faut qu'on le retrouve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "C'est quoi comme relique cette fois-ci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "C'est un, euh... C'est super ancien en tout cas, ça remonte à des centaines d'années – non, à la Guerre des Archons même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "Enfin, c'est une relique très précieuse et qui ne doit pas rester perdue ! Allez, en chasse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
