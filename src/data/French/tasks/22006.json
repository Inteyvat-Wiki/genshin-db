			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "Dis donc, ça t'a pris longtemps ? Tu as trouvé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060602,
					"content": "Oui... Ceci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Hum, c'est pas si mal, mais... Ça n'a rien à voir avec ce que je cherchais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060605,
					"content": "Enfin, c'est toujours ça de pris, hein ! Laisse-le moi, j'en prendrai soin. Ne t'inquiète pas, je veillerai à ce qu'on en prenne bien soin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060609,
					"content": "Merci ! Tiens, en récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060610,
					"content": "Ah, mais cette autre relique perdue au milieu de nulle part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060603,
					"content": "C'est ça que tu cherches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "Hum, c'est pas si mal, mais... Ce n'est pas ce que je cherchais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060607,
