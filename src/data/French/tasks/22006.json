		{
			"id": 2200603,
			"completionStepIds": [
				2200604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200604",
							"2"
						],
						"stepId": 2200604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "#Merci, {M#voyageur}{F#voyageuse}... C'était terrifiant, dis donc. Ces Pilleurs sont de plus en plus dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Et tu es...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Ah, je m'appelle Soraya ; je vais où mes recherches me portent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Il y a quelques jours, j'ai suivi des indices qui m'ont amenée dans des ruines, où j'ai trouvé une plaque de jade narrant la Guerre des Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Mais je l'avais à peine récupérée que je me suis fait attaquer par des Pilleurs de trésors... J'ai couru comme j'ai pu, mais ils ne m'ont pas lâchée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Heureusement que vous étiez là, où alors la plaque et moi étions bonnes pour pas mal d'ennuis. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Tu es aussi une chercheuse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "... « aussi » ? Il y en a d'autres par ici ? De qui s'agit-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er... Attends voir. J'ai entendu un des Pilleurs qui me coursaient se plaindre qu'une Bao'er gardait tous les trésors pour elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Sacrée coïncidence non ? Tu pourrais me décrire la personne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Voilà ce qui s'est passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "... Alors cette Bao'er est en train de chercher les lieux que j'avais marqués. Ça fait beaucoup de coïncidences, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "S'il s'agit comme je le pense d'un membre des Pilleurs, alors ils devaient me suivre depuis un bon moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Et cette Bao'er veut les trésors pour elle seule, et est partie toute seule à leur recherche. Mais la zone étant trop grande pour elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "#On dirait bien qu'elle t'a {M#utilisé}{F#utilisée}, j'en ai peur. Et je parie qu'elle avait repéré le coin depuis un bon moment ; ses confrères et moi sommes juste arrivés avant toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Pas de quoi s'inquiéter, c'est juste une hypothèse ; mais ce nom, Bao'er... Ça ressemble à un faux, ou un nom de code peut-être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "Hum, pourrais-je te demander de l'embobiner ? Il ne faut pas que cette plaque de jade tombe dans de mauvaises mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Pas de problème !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Merci. En effet... Elle aura des doutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "J'ai une bricole ici qui ne vaut pas grand-chose, ça devrait faire l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Elle n'en tirera pas grand-chose, mais ça suffira à lever ses doutes pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Bien ! Vas-y vite. Tu as peut-être vaincu ses amis, mais elle l'ignore si elle voyage seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Ah ! Si par hasard elle te redemande de partir à la recherche d'un autre objet, n'hésite pas à revenir me voir si tu le trouves. Je suis souvent à l'Auberge Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "*soupir* Je suis limitée dans mes actions, mais je sais au moins conserver une relique historique en sécurité quand il le faut... C'est toujours ça, j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Mais si je reviens les mains vides...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Hum, pas faux... Bon. J'ai ici une babiole qui ne vaut pas grand-chose ; prends-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Elle n'en tirera pas grand-chose, mais ça suffira à lever ses doutes pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
