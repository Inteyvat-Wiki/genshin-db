					"Noëlle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "Ah... Bonjour, chevalier honoraire ! Tu viens voir la Grande maîtresse Jean ? Ou puis-je t'aider en quoi que ce soit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190402,
					"content": "Je me promène juste un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Je suis en train de faire le grand ménage dans les bureaux de l'Ordre de Favonius. J'ai déjà presque terminé de faire la poussière, il ne me reste plus qu'à classer les archives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190405,
					"content": "Les documents s'accumulent depuis longtemps. Je pense que si je les classe par catégories, ce sera beaucoup plus facile pour tout le monde de les consulter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190406,
					"content": "De plus, en organisant les archives de mes prédécesseurs, j'apprends beaucoup de choses. Pour moi, c'est aussi une forme d'entraînement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190407,
					"content": "Tu es toujours aussi sérieuse et fiable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "C'est mon devoir. Et puis, toi et tous les autres chevaliers de l'Ordre de Favonius, progressez sans cesse, alors je veux vite vous rattraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190409,
					"content": "Pour commémorer ta détermination...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Hein ? Tu veux prendre une photo ? Je... Bien sûr, j'en serais ravie ! Mais je viens juste de finir le ménage, je suis encore couverte de poussière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190412,
					"content": "C'est justement cette Noëlle qui travaille dur que je veux photographier !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "Hum... C'est encore trop tôt pour me donner ce titre ! Mais si c'est toi qui veux me prendre en photo... ce sera un grand honneur, même si je suis couverte de poussière !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190415,
					"content": "Je suis certaine que tu vas appuyer sur le déclencheur au bon moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 745190413,
					"content": "C'est « l'instant décisif » de la servante chevalier !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "Je vais te prendre en photo !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Que fais-tu en ce moment, Noëlle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
