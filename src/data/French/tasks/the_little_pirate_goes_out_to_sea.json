			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{NICKNAME} ! Tu arrives au bon moment, je m'apprêtais justement à aller te voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270102,
					"content": "Oh ? Petit Meng, qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "La dernière fois, je t'avais demandé de m'accompagner pour aller jeter une bouteille avec tous mes soucis dedans, tu te souviens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270104,
					"content": "Au départ, je n'espérais rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270105,
					"content": "Mais il y a quelques jours, mon papa m'a dit qu'un de ses partenaires en affaires était soudainement venu le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270106,
					"content": "Ce monsieur a dit qu'il prévoyait de lancer un commerce de champignons et qu'ils allaient se rendre à Sumeru prochainement pour faire des recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270107,
					"content": "Ils ont demandé à papa s'il voulait les accompagner pour voir la situation là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270108,
					"content": "Et il a même dit... qu'il pouvait m'emmener avec eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270109,
					"content": "Papa n'était pas d'accord au départ, mais un de ses amis a sorti une lettre et a demandé à lui parler en privé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270110,
					"content": "Une fois leur discussion terminée, papa a finalement bien voulu me laisser partir avec eux à Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270111,
					"content": "Hum, je ne sais pas ce qui lui a fait changer d'avis aussi subitement, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270112,
					"content": "#Je peux partir en voyage à Sumeru ! {NICKNAME} ! Je peux partir en voyage à Sumeru ! Trop cool !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270113,
					"content": "Félicitations !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#C'est grâce à la bouteille qu'on a jetée, c'est sûr ! Merci, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270117,
					"content": "Papa a dit que lui et ses amis iraient à un endroit qui s'appelle le Village de Qiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270118,
					"content": "Le Village de Qiaoying ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Ouaip. D'après papa, c'est un village où on cultive plein de théiers qui produisent des feuilles d'une qualité extra. Son nom n'est pas évident à mémoriser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270120,
					"content": "Bref, on en reparlera plus tard ! Il faut qu'on aille à Sumeru d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270121,
					"content": "C'est vraiment loin d'ici, alors ça va nous prendre beaucoup de temps pour y arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270122,
					"content": "Apparemment, il faudrait bien se préparer avant de partir en voyage parce qu'on peut faire face à toutes sortes de situations sur la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270123,
					"content": "#{NICKNAME}, vu que tu voyages souvent à l'extérieur, tu pourrais m'enseigner quelques trucs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270124,
					"content": "Comme... euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270125,
					"content": "Les choses que l'on mange quand on part en voyage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270126,
					"content": "Mon père m'a dit que les gens qui voyagent cuisinent eux-mêmes tout ce qu'ils mangent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270127,
					"content": "#Héhé. La cuisine, c'est notre domaine de prédilection, pas vrai, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Je vais t'enseigner ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Il faut d'abord que l'on trouve un réchaud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Laissez-moi réfléchir... Sinon, on n'a qu'à demander au chef Mao si on peut emprunter sa cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Le chef Mao ? Il fait peur, ce monsieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270133,
					"content": "Chef Mao ne fait pas peur du tout ! C'est quelqu'un de bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "Ah bon ? Pourtant, à chaque fois que je vais manger avec mon père là-bas, il me fait les gros yeux parce que j'enlève les fleurs de Qingxin de mon bol pour ne pas les manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270129,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Je vais peut-être aller à Sumeru aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "C'est vrai ? Alors, on se voit là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Petit Meng"
				}
			]
		},
