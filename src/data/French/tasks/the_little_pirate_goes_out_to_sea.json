					"content": "Un poulet mariné aux fleurs sucrantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270502
					]
				},
				{
					"id": 210270502,
					"content": "C'est un plat délicieux ! Mais n'est-il pas un peu difficile à cuisiner ?",
					"roleType": "TALK_ROLE_NPC",
