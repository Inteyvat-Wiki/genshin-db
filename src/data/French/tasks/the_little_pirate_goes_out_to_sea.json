			"dialogs": [
				{
					"id": 210270201,
					"content": "#Tiens ? {M#Voyageur}{F#Voyageuse} et Petit Meng ? Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270202,
					"content": "Ah... Eh bien... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270203,
					"content": "On voudrait vous emprunter votre cuisine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Il n'y a pas de problème, mais pourquoi aussi soudainement...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270205,
					"content": "Je vois... Allez-y, je vous en prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270206,
					"content": "Petit Meng, il ne faudra pas que tu fasses ton difficile avec la nourriture quand tu partiras en voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270207,
					"content": "D—D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270208,
					"content": "#Alors, {NICKNAME}, est-ce que tu peux m'enseigner quelques plats ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270209,
					"content": "Comme ça, je vais faire la surprise à mon père pendant le voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210270210,
					"content": "Fais-nous confiance, on s'en occupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, quel plat devrait-on cuisiner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
