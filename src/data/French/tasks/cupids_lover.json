					"nextDialogs": [
						740751802
					]
				},
				{
					"id": 740751802,
					"content": "Les choses ont été prises ici aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751803,
					"content": "On dirait que c'est le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751804,
					"content": "Mais qui aurait pu le faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751805
					]
				},
				{
					"id": 740751805,
					"content": "C'est Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751806
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751806,
					"content": "Auparavant, nous avons déjà eu un conflit avec lui à Elynas. Je corrige : récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751807,
					"content": "J'ai su que c'était son œuvre quand j'ai vu la malheureuse victime à la porte tout à l'heure. Il est toujours en vadrouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751808,
					"content": "Que voulait-il faire en prenant ces objets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751809,
					"content": "C'est simple. Il veut aussi forger à nouveau la sainte lame du Narzissenkreuz, parce que l'œuvre de l'Ordo Narzissenkreuz reste encore inachevée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751810,
					"content": "Dépêchons-nous d'aller au dernier endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
