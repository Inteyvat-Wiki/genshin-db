			"dialogs": [
				{
					"id": 740750101,
					"content": "« Ici se trouve l'Orthant de l'âme, le Sanctuaire de l'âme, la Salle de l'âme. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "#« Auprès de vous dans un sommeil éternel »... «{NON_BREAK_SPACE}Né en un instant, souvent contradictoire, toujours unis »... « Le trésor de ce monde »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "Pfiou... Il n'y a rien de terrifiant cette fois-ci. La réponse est... une montre de poche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "D'ailleurs, vous en avez une, Ann. Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Les montres coûtent cher, effectivement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "La réponse, c'est l'argent ! Les moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Mourir avec de l'argent est la deuxième plus grande tragédie dans une vie. Ne demandez pas ce qu'est la première.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750108,
					"content": "C'est quoi, la première ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750109,
					"content": "Je sais, c'est « reposer dans un cercueil sans le sou ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "Je ne sais pas. Il y a tellement de choses plus importantes que ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750111,
					"content": "C'est pourquoi j'ai dit de ne pas demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750112,
					"content": "Je suis désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "Cela dit, je ne pense pas que la réponse soit une montre de luxe ou des moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750114,
					"content": "Qu'est-ce que c'est alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "La réponse est simple. Je peux consulter des énigmes similaires avec un taux de correspondance de 70 %.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Ça provient d'un roman classique datant d'il y a plusieurs siècles. Le texte d'origine dit : « Je suis né dans l'instant fugace où les regards se croisent, et je fuis celui que je poursuis. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "« ... Même si ma chair, mes os et mes entrailles me sont retirés, je gis avec toi dans la moelle. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "La réponse, c'est l'« amour ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Ah, je comprends. Cette montre de poche, tout comme la mienne, est une source de souvenirs affectueux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750120,
					"content": "Si seulement elle pouvait s'ouvrir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Ce sera possible un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750122,
					"content": "Bien joué, idiot de chien ! C'est qui le chien mécanique le plus mignon ? C'est toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750123,
					"content": "Avec plaisir. Cependant, « mignon » est une description subjective. J'aimerais qu'on m'appelle « Prototype 4ACV07, fiable et durable ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "Et c'est pour ça que t'es trop mignon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750125,
					"content": "... Est-ce que vous faites référence à une ancienne conversation ? J'ai une impression de déjà-vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750126,
					"content": "Quoi qu'il en soit, cette énigme a déjà été résolue par quelqu'un d'autre. Passons à l'action !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
