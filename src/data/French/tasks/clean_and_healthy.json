			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Golshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "*soupir* Il semble impossible de trouver la personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "#Ah ! Bon... Bonjour {M#voyageur}{F#voyageuse}, êtes-vous ici pour un traitement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "Je passe juste par là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Haha... C'est si évident ? Mais je suis vraiment très inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "Je ne sais pas pourquoi, mais ces derniers temps, il y a de plus en plus de gens qui se font soigner au Bimarestan, et presque tout notre personnel se consacre aux soins des patients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "Mais le docteur Zakariya a insisté quand même pour que je trouve des moyens de garder les environs propres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "Il a dit que, pour que l'hôpital et les patients puissent recevoir plus facilement la bénédiction de l'Archon Dendro, ils doivent être maintenus propres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "*soupir* Mais on manque de personnel pour le moment. Et je ne peux quand même pas demander aux patients avec des symptômes légers de m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "Pourquoi ne pas me laisser faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Vous voulez nous aider ? C'est très gentil de votre part ! Je vais préparer le paiement, bien que... bien que ce ne soit pas beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "*soupir* Que l'Archon Dendro nous protège tous des maladies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "Ne pouvez-vous pas engager des personnes pour vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Si, mais peu de gens seraient volontaires pour travailler dans un tel endroit rempli de patients, et de plus, nous n'avons pas assez d'argent pour engager autant de personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "Normalement, on est en service par rotation, mais maintenant nous sommes tellement occupés que plus personne n'est disponible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "#{M#Voyageur}{F#Voyageuse}, si... Si vous voulez bien, pourriez-vous venir nous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "On va vous payer ! Même si... Même si ce ne serait pas beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "Mais les maladies ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "La plupart des patients ici ne souffrent que de symptômes mineurs, comme des maux de tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "Le docteur Zakariya a déclaré à plusieurs reprises au public que ces maladies ne sont pas dangereuses, mais personne ne le croit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "Je pense que ce dont les gens ont peur ce n'est pas de la maladie elle-même, mais du fait de tomber malade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "#Alors, je vous laisse le soin de nettoyer, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "Et je vois que vous avez l'air inquiète...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
		{
