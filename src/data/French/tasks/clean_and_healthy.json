			"dialogs": [
				{
					"id": 230060301,
					"content": "#{M#Voyageur}{F#Voyageuse}, avez-vous quelque chose à me demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "À propos de Zakariya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Le docteur Zakariya est un médecin exceptionnel et un fervent adepte de l'Archon Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Il travaille souvent 24 heures sur 24 pour soigner les patients et oublie même de manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Le docteur Zakariya a également dit qu'il était de son devoir d'assurer que les bénédictions de l'Archon Dendro touchent plus de personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Donc vous dépendez vraiment des bénédictions de l'Archon Dendro pour guérir les gens ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Pour être exacte, le fait de « guérir des maladies » est une bénédiction de l'Archon Dendro en soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "L'Archon Dendro nous bénit afin que nous puissions trouver des moyens de traiter les patients, et faire pousser des herbes pour le traitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Merci à l'Archon Dendro pour la bénédiction et que nous soyons tous libérés des maladies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
