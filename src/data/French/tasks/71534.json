			"dialogs": [
				{
					"id": 715340101,
					"content": "Hmm, je devrais probablement jeter un coup d'œil aux autres enveloppes-cadeaux d'abord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#Oh, {NICKNAME} ! Ça fait longtemps... Pourquoi as-tu l'air {M#surpris}{F#surprise} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Je ne m'attendais pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "À voir une soldate comme moi s'amuser pendant le Festival des lanternes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Je crois ne jamais vous avoir vue vous détendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "La Commission administrative a une grande responsabilité auprès du peuple. Je ne peux pas me permettre de me détendre la plupart du temps pour cette raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Les autres pensent peut-être que je suis une brute qui ne comprend pas l'élégance et qui n'a pas sa place dans un endroit festif et raffiné comme Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Mais baisser ma garde, c'est laisser la porte ouverte au crime... Ce n'est pas seulement au détriment de mon devoir, mais aussi à l'atmosphère de Hanamizaka dans son ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Tout ce que je peux faire, c'est profiter de chaque moment libre qui se présente à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Ah, pardon. Je ne devrais pas parler de sujets aussi sérieux pendant les fêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "J'essaye de fabriquer une enveloppe-cadeau, mais je n'y arrive pas. Aurais-tu des conseils à me donner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Hmm, je vais y réfléchir un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
