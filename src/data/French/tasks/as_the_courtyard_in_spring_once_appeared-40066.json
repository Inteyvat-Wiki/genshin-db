			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "... Très bien, voilà. Kazuha, viens par ici, comment trouves-tu ma sculpture de pierre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "Raffinée et élaborée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "Héhé, c'est la vue sur la montagne que j'ai vue dans un livre. Il existe d'innombrables montagnes célèbres et imposantes dans d'autres pays. J'aimerais voyager pour les voir si j'en ai l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "Vous pouvez entreprendre cette aventure quand vous le désirez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "C'est facile à dire. Bien que le Clan Kaedehara ne possède plus sa gloire d'antan, j'en reste son chef. Il y a des responsabilités dont je ne peux pas me défaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "Mais... Cela vaut-il vraiment la peine de s'efforcer à suivre le chemin tracé par nos aïeux et de consacrer tout son être à un clan en déclin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "Père, je n'arrive pas à comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "... Kazuha, je veux que tu te souviennes d'une chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "La famille est importante, mais ce n'est pas la seule chose qui compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "Une famille existe grâce à ses membres. S'ils sont malheureux, comment pourraient-ils rendre leur famille heureuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "Tous les événements qui sont arrivés par le passé à notre famille l'ont beaucoup affectée. Ce n'est pas pour autant qu'il faut en faire un fardeau à porter pour les générations suivantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "... Si un jour tu en as assez de ce quotidien ennuyeux, abandonne-le et pars voyager. Il ne faut pas qu'il t'empêche d'avancer dans la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "Excusez-moi, mais je ne comprends pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Kazuha, as-tu oublié notre accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "Allez-vous vraiment tout abandonner ? Même si... Même si nous faisons face à des difficultés, vous m'aurez toujours à vos côtés. Ce n'est pas suffisant pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "Quand vous aviez mon âge, vous épauliez déjà grand-père. Suis-je trop incompétent ? Vous ai-je déçu ? Ou bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "Kazuha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "... *soupir* Tu te blâmes pour cela. C'est la preuve que j'ai échoué en tant que père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "Le Clan Kaedehara a déjà payé suffisamment pour les erreurs du passé. De la génération de ton arrière-grand-père jusqu'à maintenant, nous n'avons toujours pas réussi à nous en sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Forger des épées est notre affaire familiale, mais n'oublie pas : ce n'est pas forcément à toi qu'incombe cette responsabilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "Une bête affaiblie qui veut se libérer d'un piège doit renoncer à contrecœur à sa patte qui est coincée dedans. Sans ce sacrifice, elle perdrait tout simplement la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "C'en est assez, Kazuha. En tant que chef de clan, je n'ai pas réussi à lui donner un nouveau souffle et à faire de toi un noble jeune maître. J'en serais plus qu'heureux si tu ne m'en tenais pas rigueur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "Cette douleur transmise à travers les générations... doit prendre fin à présent. À partir d'aujourd'hui, je te retire ce fardeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "J'assumerai l'entière responsabilité de la mauvaise réputation engendrée par l'abandon de notre entreprise familiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "Père... S'il vous plaît, ne faites pas ça. Vous ne devriez pas être blâmé pour cette raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Si un tel jour arrive, je voudrais partager cette responsabilité avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Attendez encore un peu. Tôt ou tard, je prendrai la tête du Clan Kaedehara et à ce moment-là, je saurai m'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006614,
			"completionStepIds": [
				4006614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006614",
							"2"
						],
						"stepId": 4006614,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661401,
					"content": "Quelque chose cloche, il n'a pas l'air différent de d'habitude... Pourtant, il n'entend rien de ce qu'on lui dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661402,
					"content": "On dirait que c'est une illusion, ce n'est pas le Kazuha qui est venu avec nous.",
