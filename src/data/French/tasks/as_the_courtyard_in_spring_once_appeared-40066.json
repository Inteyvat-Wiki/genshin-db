			"dialogs": [
				{
					"id": 400661701,
					"content": "Sans surprise, vous étiez encore enfermé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661702,
					"content": "Haha, on dirait qu'ainsi sont les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661703,
					"content": "Nous sommes à nouveau dans le labyrinthe de l'illusion, mais ça ne ressemble pas tout à fait à la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661704,
					"content": "Vous racontez à Kazuha ce que vous avez vu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "L'atmosphère était plus sombre et l'endroit meublé de manière moins faste... Hmm, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661706,
					"content": "Je crois que vous étiez dans la demeure du Clan Kaedehara au moment de sa déchéance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661707,
					"content": "Cependant, dans l'illusion, vous ressembliez plutôt à une ombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661708,
					"content": "En effet, je peux en attester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400661709,
					"content": "Par rapport à sieur Kazuha qui se tient devant nous, l'illusion semblait perdue. On aurait dit que le poids du destin pesait sur ses épaules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400661710,
					"content": "En effet, on peut considérer qu'elle portait un lourd destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400661711,
					"content": "Cela signifie que j'ai grandi aujourd'hui. Je suis vraiment désolé que vous m'ayez vu avec une telle immaturité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661712,
					"content": "Après avoir quitté Inazuma, j'ai vécu longtemps en vadrouille. Je ne vois pas cela comme une mauvaise chose, car j'ai beaucoup appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661713,
					"content": "Si seulement le moi du passé pouvait voir celui que je suis devenu, il comprendrait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661714,
					"content": "La vie est un long voyage, j'ai encore beaucoup de chemin à parcourir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
