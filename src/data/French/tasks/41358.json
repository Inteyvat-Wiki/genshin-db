				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "Bienvenue, voici les kaléidolanternes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580102,
					"content": "Oh ? Les lanternes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Ah, c'est toi. Tu tombes à pic... J'ai changé les lanternes depuis la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580104,
					"content": "Alors, envie de tenter ta chance ? Ce ne sera pas aussi facile cette fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580105,
					"content": "Pourquoi ? À cause de la nouvelle image à trouver ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "Non, l'image n'est pas difficile, et ce n'est toujours que trois motifs qu'il faut combiner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580107,
					"content": "Ce qui risque de te poser des problèmes, c'est le système de rotation des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580112,
					"content": "Oh, c'est vrai... Cette fois, l'image, c'est la monnaie, le <color=#00E1FFFF>mora</color>. Et n'oublie pas, il faut trouver l'image avant d'aller chercher le trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580108,
					"content": "Ah, c'est plus compliqué ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Héhé ! Cette fois, les trois lanternes sont <color=#00E1FFFF>reliées ensemble</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580110,
					"content": "Pour faire simple, quand tu tournes une lanterne, il se peut que ça en fasse tourner une autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580111,
					"content": "Assez parlé : essaye et tu verras bien ce que je veux dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				}
			]
		},
