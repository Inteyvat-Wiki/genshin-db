			"dialogs": [
				{
					"id": 761680101,
					"content": "Rien ne me donne autant d'énergie pour patrouiller qu'une délicieuse miche de pain chaud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "Je cherche les fournitures nécessaires pour la patrouille, mais on dirait que mon produit préféré, le fantôme de champignon, est en rupture de stock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "C'est un nouveau pain créé par madame Beryna. Tout le monde l'aime tellement qu'il n'est jamais en stock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "*soupir* Rien que l'idée de ne pas pouvoir obtenir de fantôme de champignon me décourage complètement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "Je sais comment en faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "#Vraiment ? C'est génial, {M#mon ami}{F#mon amie} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "Si c'est le cas, pourriez-vous me préparer un fantôme de champignon ? Ne vous inquiétez pas, je ne vous laisserai pas travailler gratuitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lantainen"
				}
			]
		},
