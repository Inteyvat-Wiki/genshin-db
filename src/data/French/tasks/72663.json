				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "Vous êtes là. Désolée de vous avoir embêté avec ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630102,
					"content": "Vous avez l'air radieuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Haha, vous me flattez. Disons que tout est clair maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630104,
					"content": "Il y a certains mystères qu'il vaut mieux laisser non résolus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630105,
					"content": "Pourriez-vous me rejoindre sur la place à l'ouest ce soir ? J'aimerais vous offrir quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630106,
					"content": "Ouah, un trésor ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630107,
					"content": "Vous le saurez une fois sur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "C'est ici que mon père a pris la mer pour la dernière fois, à la tombée de la nuit, comme maintenant. Je ne l'ai plus revu depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630202,
					"content": "Il doit beaucoup vous manquer, non ? Votre vœu était de pouvoir le revoir au moins une fois, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630203,
					"content": "Haha, c'est vrai qu'il me manque, mais les enfants de la mer finissent par la retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630204,
					"content": "Cependant, mon vœu était de devenir une meilleure pêcheuse que mon père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630205,
					"content": "Quand j'étais petite, je voulais toujours aller en mer avec mon père, mais il demandait à ma mère de me ramener à la maison. Il emmenait parfois le fils du voisin avec lui, mais jamais moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630206,
					"content": "Il me disait : « Momiji, ne passe pas ton temps sur la plage. Tu devrais faire des choses que les filles font. » ou bien : « Prends cet argent et va t'acheter une robe avec. Arrête de toujours courir vers le bateau. »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630207,
					"content": "Je ne l'ai jamais accepté. Pourquoi ? Eh bien, qu'est-ce qu'une fille est supposée faire, au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630208,
					"content": "Aller acheter des bonbons, cueillir des fleurs et jouer à la princesse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630209,
					"content": "Mais pas partir à l'aventure, ni explorer des mers lointaines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630210,
					"content": "J'ai toujours refusé de me plier à ces idées reçues. Une fois que mon père nous a quittés, j'ai commencé ma carrière de pêcheuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630211,
					"content": "J'explorerai les lieux qu'il n'a pas explorés. J'attraperai tous les poissons qu'il n'a pas attrapés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630212,
					"content": "Je serai celle qui perpétuera la technique de pêche de notre famille et qui continuera de faire prospérer notre nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630213,
					"content": "Le léviathan lunaire a beau n'être qu'une légende, ce n'est pas ça qui va m'empêcher de vivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630214,
					"content": "Vous réussirez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630216,
					"content": "Le poisson légendaire n'existe pas, alors je vais me contenter de faire mon vœu à la mer. Je pense que mon père le verra ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630217,
					"content": "Vous avez un vœu, vous aussi ? Faisons nos vœux ensemble alors, écrivons notre vœu sur un papier et mettons-le dans une bouteille qu'on jettera à la mer. Je suis sûre qu'ils se réaliseront un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630218,
					"content": "Ouh, ça marche ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630219,
					"content": "Mais j'ai plein de vœux, moi ! Si je ne devais qu'en choisir un... Ah, c'est trop difficile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630220,
					"content": "Merci beaucoup pour tout ce que vous avez fait ! Je ne savais vraiment pas comment faire pour vous montrer l'étendue de ma gratitude, alors voici quelques cadeaux. J'espère que vous apprécierez quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630221,
					"content": "Ouah, regardez par là ! Qu'est-ce que c'est ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630222,
					"content": "C'est un gros banc de poissons ! Ils brillent, je crois qu'ils aiment bien les bouteilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630223,
					"content": "D'ailleurs, ils forment comme une grande lune dans l'eau lorsqu'ils se rassemblent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630224,
					"content": "Ces poissons... Ce sont des séléneaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630225,
					"content": "Ah ! Mais oui, je comprends maintenant ! C'est ça le léviathan lunaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630226,
					"content": "Hein ? C'était donc ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630227,
					"content": "Oui ! Je n'oublierai jamais cette lumière semblable à celle de la lune... Le léviathan lunaire a été attiré par la bouteille que Jiawei avait jeté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630228,
					"content": "Pas étonnant que personne n'ait réussi à l'attraper pendant toutes ces années !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630229,
					"content": "Le léviathan lunaire était formé par un banc de séléneaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630230,
					"content": "Ces séléneaux... aiment donc les objets ordinaires tels que ces bouteilles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630231,
					"content": "Héhé, peut-être qu'ils aiment plutôt les vœux que contiennent ces bouteilles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630232,
					"content": "Haha ! Puisqu'ils sont là, moi, Kujirai Momiji, vais les attraper jusqu'au dernier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630233,
					"content": "On va vous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630234,
					"content": "Eh bien, laissez-moi vous faire cadeau de cette canne à pêche. Elle a été spécialement fabriquée par ma famille pour capturer le léviathan lunaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630235,
					"content": "C'est loin d'être suffisant pour exprimer toute ma gratitude envers vous, mais c'est déjà quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630236,
					"content": "Utilisez-la pour pêcher tous les séléneaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		}
	]
}