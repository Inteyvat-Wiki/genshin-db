			"dialogs": [
				{
					"id": 740330101,
					"content": "Depuis la fermeture du Tunnel minier de géode, cet endroit est devenu moins fréquenté, et les dispositifs mécaniques sur place ne sont pas faits pour les non-initiés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "Cette fois-ci, quelqu'un a joué avec la valve d'entraînement et a enfermé son compagnon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "Bref, commençons par actionner la valve d'entraînement afin d'ouvrir la porte d'accès à l'<color=#00E1FFFF>entrepôt de provisions 1</color>. Si cette personne vous propose une boisson, il est préférable de refuser poliment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "Qui va nous offrir une boisson ? Et pourquoi devrions-nous la refuser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Vous le découvrirez bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
			"id": 7403304,
