			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Il est plutôt solide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "#Je n'arrête pas d'être {M#emporté}{F#emportée} par le vent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#Salut, {NICKNAME} ! Je t'ai {M#cherché}{F#cherchée} partout ! Que penses-tu du planeur de vent que je t'ai offert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Tu as l'air de bien t'amuser avec le planeur de vent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Il te manque plus qu'à obtenir ce permis de planer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "Un permis de planer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Comme son nom l'indique, il te permet de pouvoir planer légalement dans Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Oui, mais {NICKNAME} plane depuis longtemps déjà ! Et on n'en a jamais entendu parler de ton permis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "#Bien sûr que tout le monde a remarqué que {NICKNAME} planait n'importe comment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "#Donc, tu {M#le}{F#la} cherchais pour lui donner ce permis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "Dans tes rêves ! Le planage est strictement règlementé par l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "On doit passer un examen avant de recevoir le permis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "C'est pourquoi je suis là aujourd'hui ! C'est moi l'examinatrice de l'épreuve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Je t'ai donné ce planeur, alors c'est à moi de faire en sorte que tu te plies aux règles. Enfin, je suis sûre que c'est ce que Jean dirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "Ne sois pas trop dure avec moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "OK, ça me va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Mais si Amber est ton examinatrice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "Ce n'est certainement pas toi qui vas me dire comment faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#Je suis sûre que ça sera une promenade de santé pour {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "L'examen sera vraiment rapide, ça sera juste une formalité. Tout le monde t'a vu planer lors de ton affrontement contre Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Mais il faut respecter la loi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "Tiens, prends cet exemplaire du « Guide de planage ». Tu n'as pas besoin de le connaître par cœur, mais il faudra te familiariser avec l'intégralité du contenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Par exemple : une personne par planeur, respecter la limite de poids autorisée, interdiction de planer à l'aide d'un Anémoblob, etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Il faut que tu le lises au moins une fois en entier. Moi aussi, j'ai dû lire plein de gros livres quand Lisa m'enseignait la magie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "C'est vrai qu'il est gros ! On ferait mieux de commencer la lecture bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Venez me trouver à Ventlevé quand vous aurez fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "Ce « Guide de planage » n'est pas très amusant à lire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Finissons-en au plus tôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "On dirait un conte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "Les Mondstadtois sont vraiment de grands romantiques dans l'âme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "C'est une belle histoire, mais je trouve ça un peu bizarre pour un soi-disant guide de planage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Bref, trouvons Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}