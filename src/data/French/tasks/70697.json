			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME} ! Quelle surprise de vous croiser à Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Je n'ai jamais été dans un endroit avec un climat pareil. Il fait tellement froid ! Mais c'est une expérience incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "J'ai fait ma première bataille de boules de neige et mon premier bonhomme de neige... Oh, et il y a même des bandes dessinées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "La Légende des âmes embrasées est super populaire à Inazuma, mais je ne m'attendais vraiment pas à trouver autant de gens qui la lisent ici aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "J'ai discuté avec des fans de Natlan tout à l'heure. Ça m'a tellement inspirée que... j'ai fini par créer une figurine de personnage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "... Oh, pardon, je vais peut-être un peu trop vite. Vous avez déjà entendu parler de la Légende des âmes embrasées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Vous parlez à Yoimiya de la Légion des âmes embrasées.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Incroyable ! Vos amis sont aussi des fans ? Quelle coïncidence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Dans ce cas, laissez-moi vous donner ce panneau de Fietena. Héhé, il sera parfaitement à sa place auprès de la Légion des âmes embrasées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
