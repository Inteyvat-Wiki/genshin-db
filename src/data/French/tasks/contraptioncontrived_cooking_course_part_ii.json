			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souffle-Nuages"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "Je me demande si cette machine peut aussi confectionner des desserts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010102,
					"content": "Qu'est-ce que vous préparez cette fois-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "#Tu arrives à point nommé, {M#voyageur}{F#voyageuse}. Je viens de décider quel sera mon prochain mets, ce sera un « pudding ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010104,
					"content": "J'ai consulté les recettes récentes les plus populaires pour trouver ce plat. On dit que c'est doux et sucré à la fois : le dessert idéal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010105,
					"content": "J'y ai apporté quelques modifications aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010106,
					"content": "Comme l'ajout de riz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010107,
					"content": "Je me dois donc de donner un nouveau nom à ce dessert... Appelons-le « pudding de riz ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010108,
					"content": "Ça a l'air bien rassasiant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "La qualité des grains de riz est primordiale pour la réussite de ce dessert. J'ai mis en marche le cuiseur suprême pour qu'il recherche des cultures de riz de qualité supérieure, et c'est ici qu'il m'a menée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010110,
					"content": "#{M#Voyageur}{F#Voyageuse}, je profite de ta présence pour te demander si tu veux bien m'aider à collecter ce riz ? La machine dit qu'on peut en trouver non loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010111,
					"content": "Pourquoi moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "Quelqu'un doit bien s'occuper de la machine et je ne peux pas me dédoubler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010114,
					"content": "Tu es habile aussi bien de tes mains que de ton esprit, ce qui fait de toi une aide précieuse. Je te promets une part de pudding de riz si tu m'aides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010115,
					"content": "Je compte sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010116,
					"content": "Cuiseur suprême... Activation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010117,
					"content": "#{M#Voyageur}{F#Voyageuse}, je viens de démarrer la machine. Suis les traces qu'elle a laissées et collecte le riz dont j'ai besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 705010112,
					"content": "Vous pouvez voler, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "Merci ! Vous m'avez sauvé la vie... Je suis Brunn, un marchand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010202,
					"content": "*soupir* C'est bien ma veine. J'étais en train de transporter des marchandises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010203,
					"content": "Mais je ne pensais pas me faire soudainement attaquer par des monstres sur la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010204,
					"content": "Je suis allé aussi vite que je le pouvais, sans avoir le loisir de me préoccuper de la marchandise ou de savoir où est-ce que j'allais... C'est comme ça que je me suis retrouvé ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010205,
					"content": "Je pensais les avoir semé après avoir fait tout ce chemin, alors je suis descendu de la charrette pour vérifier l'état de la marchandise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010206,
					"content": "Mais ces monstres sont subitement sortis de nulle part... Merci encore pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010207,
					"content": "Quel genre de marchandise transportez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "Des aliments, comme du riz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010209,
					"content": "On dirait qu'il s'agit du riz que Souffle-Nuages voulait qu'on lui ramène, mais il n'en reste pas beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705010210,
					"content": "Je peux vous acheter du riz ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "Vous en voulez ? Je voudrais bien vous le vendre, mais j'ai quasiment tout perdu pendant que je prenais la fuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010212,
					"content": "Les monstres ont sans doute emporté les marchandises tombées comme butin chez eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010213,
					"content": "Rah, comment vais-je m'en sortir ? Si je ne récupère pas tout ça, je vais perdre pas mal d'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010214,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous qui savez vous débrouiller, pourriez-vous m'aider à récupérer ma marchandise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010215,
					"content": "J—Je vous donnerai tout le riz que vous voudrez en échange !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010216,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "Merci beaucoup ! Je m'en remets à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010220,
					"content": "Prenez mon ballon de transport avec vous. Vous pourrez mettre la marchandise dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010221,
					"content": "#Je compte sur vous, {M#voyageur}{F#voyageuse}. Revenez me voir dès que vous aurez tout récupéré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010218,
					"content": "#Je ne crois pas pouvoir porter autant d'objets {M#tout seul}{F#toute seule}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "Pas de panique, j'ai une solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050107",
							"2"
						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "#Ça y est, vous avez tout ? Merci infiniment, {M#Voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010302,
					"content": "Vous vouliez... du riz, c'est ça ? Attendez un peu, je vais vous donner le meilleur que j'aie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010303,
					"content": "Et voilà votre riz ! Il devrait y en avoir assez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010304
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010304,
					"content": "#Merci encore, {M#voyageur}{F#voyageuse}. Je vais reprendre mon chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010305
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010305,
					"content": "J'espère que je ne croiserai pas de monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050108",
