			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "#(Remettre « Le rêve de Rhonabouillet{NON_BREAK_SPACE}»)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Oh, un recueil de poésie de Fontaine ! Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "#Voyager dans le passé... la cour du chevalier de source... et il a le coup de foudre pour une servante{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "#Pfff ! C'est hilarant ! Vous avez la chance de retourner dans le passé, et la seule chose à laquelle vous pensez, c'est de draguer quelqu'un qui a l'âge de votre ancêtre{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "#Ah, j'ai compris ! C'est un poème d'amour{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "#Haha, je comprends maintenant. L'amour rend vraiment les gens fous. Bon, je vais l'acheter et le lire correctement plus tard. Merci, {M#aventurier}{F#aventurière} aux cheveux dorés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
