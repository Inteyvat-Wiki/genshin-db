	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "#Ah ! Excusez-moi ! Vous, l'{M#aventurier}{F#aventurière} aux cheveux dorés ! Attendez un instant, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Oh, non, ce n'est rien de tout ça ! Je voulais juste vous demander si vous aviez par hasard un recueil de poèmes sur l'amour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Écoutez, je suis une barde incroyable, peut-être la plus incroyable de tout Mondstadt après le seigneur Barbatos lui-même ! Sérieusement, je suis géniale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Mais il y a Linus... ce barde agaçant ne semble jamais vouloir admettre que je suis meilleure ! Il débarque tout le temps, me récitant des poèmes sans arrêt ! Peu importe comment on voit les choses, il essaie clairement de me surpasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "Et le pire dans tout ça ? Chacun de ses poèmes parle d'amour et de romance... des choses que je n'ai jamais abordées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Du coup, je prends les choses en main. Je vais écrire un poème d'amour si épique que Mondstadt ne l'oubliera jamais ! Ça lui apprendra ce qu'est le vrai talent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Évidemment... J'ai consacré tout mon temps à la pratique d'un art véritablement grandiose, je n'ai pas encore eu l'occasion de vivre l'amour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Si par hasard vous avez un recueil de poésie sur l'amour, vendez-le-moi ! J'ai juste besoin de le feuilleter un peu. Une fois que je l'aurai fait, l'inspiration commencera à venir. Avec un talent comme le mien, c'est sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "#{M#Désolé}{F#Désolée}, j'ai des choses à faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "Non, non ! Je ne voulais pas dire que vous devriez m'aider. Après tout, si tout le monde demandait de l'aide à des inconnus dès que quelque chose ne va pas, personne n'oserait plus voyager !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "Ahem. Je voulais juste vous demander si vous auriez par hasard un recueil de poèmes d'amour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
