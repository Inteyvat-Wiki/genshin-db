				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280701,
					"content": "(Remettre « La Brise de la Forêt ».)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Haha, « La Brise de la Forêt » ? Allons, je suis une barde brillante. Vous croyez vraiment que je ne le connaîtrais pas ? Je l'ai lu de la première à la dernière page plus de fois que je ne peux compter ! Vous n'avez rien de nouveau ?",
