			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Haha, merci, {M#aventurier}{F#aventurière} aux cheveux d'or ! Vous êtes mon {M#héros}{F#héroïne} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Je sens déjà l'inspiration monter en moi, comme les vents de l'Antre de Stormterror, le miasme du Vallon Chenyu et le tonnerre de l'Île de Seirai... C'est sur le point d'exploser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Ça a l'air très dangereux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Héhé, vous allez voir ! Je note toutes mes idées maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Les poèmes prétentieux de Linus ne feront pas le poids. Une fois mon chef-d'œuvre terminé, les tavernes de tout Teyvat connaîtront de mon nom !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
