				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "#(Remettre « La Chanson d'Ay-Khanoum{NON_BREAK_SPACE}»)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Oh, quel beau livre ! Bon, voyons ce qu'il dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "#« ... Nul trône ne tient sans serpents sous ses pieds, nulle rose ne fleurit sans épines. Bois l'amertume jusqu'à la dernière goutte, Ferigees, et avec ces doux yeux qui sont les tiens, promets-moi... promets-moi...{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Euh... Attendez, comment on prononce ça déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "#Ouh, c'est définitivement trop obscur pour moi ! J'ai déjà la langue qui fourche ! Je vais juste le ramener à la maison et le lire tranquillement plus tard... Merci, {M#aventurier}{F#aventurière} aux cheveux dorés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(Donner « Révélations sur l'amour divin »)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Oh ! J'en ai déjà entendu parler. C'est un recueil de poésie de l'Église de Favonius, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Voyons voir... « Son âme est un champ de flammes, déversant son chant ardent dans le vent. Entre les étoiles, la lune et le soleil radieux, même ma propre lumière est consumée par son éclat... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "#Quel genre de poème est-ce ? C'est franchement un peu inquiétant... et l'Église de Favonius ne connaît clairement pas grand-chose à la poésie. Je veux dire, les étoiles, la lune et le soleil qui apparaissent ensemble{NON_BREAK_SPACE}? N'importe quoi{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "#Bon, c'est décidé ! J'ai retrouvé confiance en moi. Si c'est le niveau de poésie de ce livre, alors même moi je peux faire mieux. Je l'achète. Merci, {M#aventurier}{F#aventurière} aux cheveux dorés{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
