			"dialogs": [
				{
					"id": 708280601,
					"content": "#Oh ! {M#Aventurier}{F#Aventurière} aux cheveux d'or ! M'avez-vous apporté des poèmes d'amour dignes d'inspirer mon génie ?",
					"roleType": "TALK_ROLE_NPC",
