			"dialogs": [
				{
					"id": 50280501,
					"content": "La vie des descendeurs a plus de valeur que vous ne pouvez l'imaginer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280502,
					"content": "Vous avez détruit l'espoir de ce monde de vos propres mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280503,
					"content": "Si je suis vouée à l'échec, pourquoi avez-vous peur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280505,
					"content": "(Nous partons en pèlerinage pour les souhaits du peuple.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280506,
					"content": "(Nous choisissons de nous battre pour obtenir un nom glorieux.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280507,
					"content": "(À la fin, notre flamme se consume pour un rêve.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280508,
					"content": "(Et ainsi, ce cycle s'est poursuivi, encore et encore...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				}
			]
		},
