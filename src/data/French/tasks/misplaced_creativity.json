			"dialogs": [
				{
					"id": 766530201,
					"content": "Où est-ce que je me suis trompée ? Si seulement j'avais plus de connaissances théoriques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Bon, pas besoin de confirmer cette commande... Ginette, une ingénieuse fontainoise ? C'est la commande la plus intéressante que j'ai reçue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Vous êtes là ! Il y a donc encore de l'espoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "#Bonjour, on est les {M#assistants}{F#assistantes} d'Aino... Enfin, je pense qu'on peut nous appeler comme ça. Que peut-on faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Elle a conçu un type de robot qui permet de communiquer à longue distance grâce au kuuvahki... Ça a l'air super cool, mais elle a eu pas mal de dysfonctionnements. Du coup, elle veut que je l'aide à les corriger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "J'ai honte de l'admettre, mais ma curiosité ne me mènera nulle part. Tout est une question de pratique au bout du compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Ça n'a pas l'air très difficile... Comptez sur nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "C'est un peu gênant, mais... J'aimerais modifier ma commande. En attendant votre réponse, je... j'ai fini par remettre la pagaille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "J'ai été soudainement curieuse de savoir si un changement d'environnement pouvait résoudre le problème, alors j'ai effectué d'autres tests dans des zones avec différentes concentrations de kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "... Mais il y a quand même eu des dysfonctionnements, et j'ai fini par perdre les robots. Hum... En plus des corrections convenues... Pourriez-vous m'aider à récupérer les robots ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Vous avez perdu tous vos robots ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Si je dois vous payer des frais supplémentaires, je ferai tout ce que je peux ! C'est promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Hmm... Il devrait y avoir de nombreux moyens de les retrouver. Puisque les robots sont tous alimentés au kuuvahki, ils laissent des ornements kuuvahkiques lorsqu'ils se déplacent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Je vais vous concevoir un appareil spécial. Une fois que vous aurez collecté assez d'ornements kuuvahkiques, vous serez en mesure de retrouver le robot qui les a laissés derrière lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Hmm, cette mission est marrante ! Alors je ne demanderai pas de frais supplémentaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Vraiment ? Merci infiniment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}