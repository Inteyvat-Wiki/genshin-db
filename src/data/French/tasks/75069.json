					"speakerTitle": "Quenin"
				},
				{
					"id": 750691310,
					"content": "Ensuite, un visage pâle vous regardera avec colère. Ah, comme... votre propre visage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691311
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691311,
					"content": "Ah, il n'y a qu'à la cascade, il n'y a que là-bas que je peux échapper à ces bruits. Héhé, vous ne les entendez pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691312
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691312,
					"content": "#Vous pourriez finir comme moi si vous restez trop longtemps ici, {M#brave guerrier}{F#brave guerrière}. Alors, partez tant que vous le pouvez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691313,
					"content": "Non, ça ira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691314
					]
				},
				{
					"id": 750691314,
					"content": "D'accord... Un conseil : vous feriez mieux de partir vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
