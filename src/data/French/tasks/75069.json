			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Il n'y a jamais eu beaucoup de visiteurs ici... C'est dangereux, alors ça se comprend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "Vous faites aussi partie de l'équipe d'aventure ? Hmph, on raconte que l'ombre du Serpent noir est descendue du Tonatiuh... Faites attention à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "Honnêtement, partez tant que vous le pouvez. Il y a des choses inhumaines qui se cachent dans l'équipe... Ces voix, ces malédictions... Elles sont si bruyantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "C'est plutôt calme par ici grâce à la cascade. Haha... Le bruit des chutes étouffe tout le reste, on n'entend rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
