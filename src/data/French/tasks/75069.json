			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Une page déchirée sur laquelle figure une belle écriture au début...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690502,
					"content": "« ... Les monstres de l'Abîme sont de plus en plus nombreux, comme prévu... L'équipe d'aventure a échoué dans sa mission. Un plan de retraite est en cours d'exécution. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690503,
					"content": "« Il faut permettre aux personnes restantes d'évacuer en toute sécurité. Méfiez-vous de ceux qui disparaissent la nuit, ou qui reviennent d'endroits dépourvus de lumière. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690504,
					"content": "« ... Les monstres de l'Abîme apparaissent de plus en plus fréquemment. Ils découvriront peut-être bientôt la base, mais avant... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690505,
					"content": "(L'écriture commence à être tremblante et déformée...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690506,
					"content": "« Ah, qu'est-ce qu'il fait froid... Un froid glacial... Là-bas, le sang se vide... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690507,
					"content": "« Le bruit de la cascade est si fort... Oui, tant mieux. Tant que... ce sera calme sous la cascade... Des visages pâles, des bouches ouvertes, du sang vidé... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690508,
					"content": "« Là... Juste... là... Il y a quelque chose... C'est là... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Journal de Quenin"
				},
				{
					"id": 750690509,
					"content": "« Sous la cascade, sous la cascade, sous la cascade, sous la cascade, sous la cascade, sous la cascade, sous la cascade... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Journal de Quenin"
				}
			]
		},
