					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691203,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "Je suis... un guerrier de l'équipe d'aventure. Enfin, je ne suis pas aussi puissant que le seigneur Taika, mais j'ai mes points forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "Je surveille le camp de l'équipe... Parfois, quand je n'arrive pas à dormir la nuit, je patrouille dans les environs pour assurer notre protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "En revanche, je ne sais pas quand cela a commencé, mais il y a de moins en moins de monde au camp chaque jour... Étrange... Pourquoi suis-je ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691207,
					"content": "Non, ça ira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
