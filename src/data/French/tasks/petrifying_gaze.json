			"dialogs": [
				{
					"id": 790460901,
					"content": "Mais si une Gouttelette s'est transformée en pierre, peut-elle encore boire une potion ? Et comment une Gouttelette peut boire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460902,
					"content": "Oh ! Peut-être que c'est un remède qu'il faut appliquer ! Essayons ça !",
					"roleType": "TALK_ROLE_NPC",
