					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "Pff ! C'est impossible d'éviter leur ligne de mire ! C'est de la triche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "Je veux leur donner une leçon à coups de pied !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "La Gouttelette, attends ! Qu'est-ce que tu fais ! Il y a des fantômes là-bas, c'est dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "Sale braillard ! Tu es devenue folle ? Ou tu as abandonné tout espoir et es pressée de rejoindre tes amis dans l'autre monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Chef fantôme en colère"
				},
				{
					"id": 790461005,
					"content": "Oh non ! Elle a utilisé son corps pour bloquer le regard... Pourquoi veut-elle se sacrifier ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Chef fantôme content"
				},
				{
					"id": 790461006,
					"content": "Quel coup de théâtre ! L'Eidolon Hydro esseulé s'est jeté devant les fantômes, utilisant son corps pour bloquer le regard pétrifiant, et se transforme lentement en pierre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Narration dans le haut-parleur"
				},
				{
					"id": 790461007,
					"content": "La Gouttelette s'est transformée en pierre... juste pour que nous puissions obtenir la clé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "La Gouttelette peut encore être sauvée !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Oh, c'est vrai ! Tant qu'elle n'est pas trop longtemps à découvert, ça devrait aller !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "La Gouttelette doit tirer profit de ça. Quel courage, quelle intelligence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, dépêchons-nous de trouver la clé et de récupérer le remède ! Ne laissons pas la Gouttelette souffrir trop longtemps !",
					"roleType": "TALK_ROLE_NPC",
