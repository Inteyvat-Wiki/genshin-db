			"dialogs": [
				{
					"id": 790460101,
					"content": "Tous les acteurs sont arrivés et tous les mécanismes de la scène fonctionnent normalement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Haut-parleur d'annonce du parc"
				},
				{
					"id": 790460102,
					"content": "Cette représentation d'« Un regard pétrifiant », une pièce de la Rêverie de trois jours de Daiya, va maintenant commencer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Haut-parleur d'annonce du parc"
				},
				{
					"id": 790460103,
					"content": "À l'orée d'une forêt épaisse et étrange, deux sages tombent sur un Eidolon Hydro, errant seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Narration dans le haut-parleur"
				},
				{
					"id": 790460104,
					"content": "À l'aide ! Aidez-moi, s'il vous plaît... Je ne veux pas abandonner mes compagnons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460105,
					"content": "Une Gouttelette ?! Est-ce qu'elle vient de parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "Non, ça vient du haut-parleur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Oh, donc cette Gouttelette est un personnage principal de cette pièce, et nous devons interagir avec elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "C'est vraiment une chance que ces deux sages aient déjà étudié en profondeur la langue des Eidolons Hydro et puissent comprendre son appel à l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Narration dans le haut-parleur"
				},
				{
					"id": 790460110,
					"content": "Ce doit être un signe du destin ! Une heureuse coïncidence, pourriez-vous seulement imaginer ne pas aider cet Eidolon Hydro ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Narration dans le haut-parleur"
				},
				{
					"id": 790460111,
					"content": "Waouh ! Nous avons aussi nos propres personnages ? C'est trop cool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Concentrons-nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "Nous... Alors que nous étions perdus dans les bois, nous sommes tombés sur un ancien château et avons accidentellement réveillé les mauvais esprits qui y sommeillaient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460115,
					"content": "Deux de leurs chefs, ils... Ils nous ont jeté une malédiction ! Maintenant, dès qu'un fantôme nous voit, nous... Nous nous transformons en pierre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460116,
					"content": "J'ai réussi à m'échapper de justesse, mais mes compagnons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460117,
					"content": "*sanglote* ... Ils doivent tellement souffrir... Qu'avons-nous fait de mal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460118,
					"content": "Vous n'avez rien fait de mal ! Même si ces fantômes se sont fâchés parce que vous les aviez réveillés, ce n'est pas une excuse pour être des brutes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "Non mais ! Transformer des pauvres Gouttelettes en statues... C'est inacceptable. Ces fantômes sont tous de super méchants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "Si nous leur donnons une leçon qu'ils n'oublieront pas de sitôt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "Non, les deux chefs fantômes ne se montrent jamais, et le château est vaste... Même la personne la plus forte et la plus compétente ne pourrait jamais les trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460123,
					"content": "Mais j'ai entendu l'un des fantômes dire qu'au plus profond du château se trouve un coffre contenant un vieux remède contre les malédictions. C'est le seul espoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460124,
					"content": "Le coffre est enfermé dans une chambre secrète dont vous devez d'abord trouver la clé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460125,
					"content": "Mais... j'ai déjà été maudit, et si j'y vais seul, je serai certainement vu par les fantômes... Et je serai alors transformé en statue pour l'éternité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460126,
					"content": "Ça a l'air facile ! Nous allons t'accompagner, trouver la clé et récupérer ce remède !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "Tant que tu évites le... regard de ces fantômes, tout ira bien, n'est-ce pas ? Ce sera une partie de plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "#C'est vrai, vous êtes {M#tous}{F#toutes} les deux... des sages, et vous devez certainement savoir quoi faire... Aidez-moi, je vous en prie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Eidolon Hydro esseulé"
				},
				{
					"id": 790460129,
					"content": "Tu es vite entrée dans le personnage, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Haha, c'était facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "Même si nous ne pouvons pas vaincre leurs chefs, éliminer les fantômes et sauver les compagnons de la Gouttelette devrait être un jeu d'enfant pour toi, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "Allez, la Gouttelette, allons trouver ce remède, vaincre la malédiction et sauver tes compagnons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "Tu savais exactement où allait l'intrigue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "Pouvons-nous sauver tes compagnons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "Qu'est-il arrivé à tes compagnons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "Faisons comme si c'était la Gouttelette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
