				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "Q—Qu'est-ce qu'il fait froid... Je n'aurais pas dû sortir aussi négligemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140102,
					"content": "#Oh ? {NICKNAME}, Paimon ! Vous... A—Atchoum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140103,
					"content": "Asagiri ? Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "Est-ce que ça va ? Comment êtes-vous arrivée aussi loin toute seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745140105,
					"content": "Je... Euh... Ça va mieux ! Regardez, je ne tousse même plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140106,
					"content": "Haha... Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140107,
					"content": "Vous en êtes sûre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "#Non, c'est bon, j'avoue être sortie en douce ! Vous êtes {M#satisfaits}{F#satisfaites} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140110,
					"content": "Je... n'avais pas le choix. Comment voulez-vous que je peigne de belles œuvres si je ne sors jamais d'Inazuma ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140111,
					"content": "Même si vous prenez beaucoup de photos pour moi, ça ne pourra jamais remplacer le fait de voir ces choses de mes propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140112,
					"content": "J'ai donc demandé à un auteur avec qui j'avais déjà travaillé de contacter une caravane marchande pour moi, et je l'ai accompagnée afin de pouvoir voyager en toute discrétion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140113,
					"content": "Et vous avez même emporté tout votre matériel de peinture...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "Évidemment ! La toile est comme mon âme ! Comment pourrais-je m'en séparer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140115,
					"content": "De plus, mes tableaux se vendent particulièrement bien à Fontaine. Certains auteurs fontainois m'ont même demandé de réaliser la couverture de leurs ouvrages !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140116,
					"content": "Mais... Apparemment, il n'est pas courant pour eux de faire illustrer leur histoire ! Je ne m'y attendais pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140117,
					"content": "#Bon... Puisque vous êtes là, {NICKNAME}... Pourriez-vous m'aider à rassembler de l'inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140118,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "Super ! Grâce à votre aide, je sais que l'affaire est dans le sac.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140123,
					"content": "Bon, laissez-moi regarder. Il se trouve que j'ai reçu quelques commandes supplémentaires de certains auteurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140120,
					"content": "D'accord, mais ne vous éloignez pas trop.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "Je sais. Ce n'est de toute façon pas comme si je pouvais gérer ces Mékas horlogoïdes toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140122,
					"content": "Lorsqu'il s'agit d'affronter toutes sortes de monstres étranges, vous êtes ce qui se fait de mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140108,
					"content": "Je vais leur écrire pour vérifier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}