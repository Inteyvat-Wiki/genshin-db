			"dialogs": [
				{
					"id": 735340701,
					"content": "#Ah, alors {M#le volontaire qualifié}{F#la volontaire qualifiée} pour les expériences sur les paysages oniriques est si jeune ? La jeunesse est vraiment impressionnante de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Appelez-moi Nitesh. Je suis un chercheur itinérant du Spantamad, ça fait longtemps que je travaille à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "#Nous, les personnes âgées, avons tendance à rencontrer plus facilement toutes sortes de problèmes. Je compte sur vous pour m'aider à aller au bout des choses, jeune {M#homme}{F#fille}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
