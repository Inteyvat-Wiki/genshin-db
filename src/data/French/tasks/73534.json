			"dialogs": [
				{
					"id": 735340101,
					"content": "Bonjour ! C'est vous qui allez m'aider avec l'onirithérapie ? Pour tout vous dire, je ne sais pas de quoi je vais rêver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Je suis originaire de Mondstadt et je n'ai pas vraiment de passe-temps... À part boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "Et je suis du genre à faire des erreurs quand j'ai trop forcé sur la boisson, alors... Je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
