			"dialogs": [
				{
					"id": 735340501,
					"content": "Ravi de vous rencontrer. Je suis Higuchi Tetsuya, un auteur de romans sur les démons d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "J'ai subi beaucoup de pression ces derniers temps, alors... Je vais faire tout ce qu'il faut pour me remettre sur pied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "À propos, mon paysage onirique pourrait avoir un aspect plutôt personnalisé, étant donné qu'il s'agit d'un monde que j'ai créé, avec tous les problèmes que ça implique. Toutes mes excuses par avance pour toute chose étrange que vous pourriez voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
