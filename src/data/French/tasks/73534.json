			"dialogs": [
				{
					"id": 735340901,
					"content": "Alors vous êtes cette remarquable connaissance dont Dharmakirti m'a parlé ? Je m'appelle Piyush, je suis architecte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "J'ai déjà entendu Kaveh prononcer votre nom, mais je n'ai pas encore eu l'occasion de vous saluer, c'est donc une heureuse coïncidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Je suppose que je vais rêver d'un projet que je viens de soumettre. C'était un véritable cauchemar... Je ne m'attendais pas à vous rencontrer de manière aussi formelle, c'est dommage... Enfin bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
