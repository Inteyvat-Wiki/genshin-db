			"dialogs": [
				{
					"id": 735340301,
					"content": "Ravie de vous rencontrer. Nous sommes sur le point d'entrer ensemble dans un paysage onirique, je pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Je m'appelle Youguang, je suis une garde de Liyue. J'ai été exposée à quelque chose... d'impur au travail récemment, et je n'ai pas passé une bonne nuit de sommeil depuis. J'ai donc besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Si je pouvais dissiper mes cauchemars grâce à cette onirithérapie, ce serait vraiment incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
