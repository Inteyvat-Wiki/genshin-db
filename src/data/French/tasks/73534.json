			"dialogs": [
				{
					"id": 735340401,
					"content": "Ô démons, grands êtres divins et vénérables Adeptes, je vous en prie, comblez-moi de votre miséricorde ! Ne vous cachez pas dans des objets, je vous en conjure, et montrez-vous avant que la peur n'emporte mon esprit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
