				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Comment ça s'est passé, Comète dorée ? Quel est votre ressenti après ce premier essai du Théâtre fongique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "À en juger de votre expression, je suppose que vous n'avez pas encore d'avis définitif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Je n'ai testé qu'un seul niveau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Oui, avec si peu de contenu à tester, il est difficile d'analyser les forces et les faiblesses du jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Ne vous en faites pas. Je vais rester ici pendant un moment avec Haniyyah pour vous proposer un nouveau niveau de Théâtre fongique par jour. Il y en aura sept au total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Quand vous aurez le temps, venez me voir pour les essayer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "Bien que toute décision finale soit de votre ressort, c'est Haniyyah et moi-même qui avons pris l'initiative de créer ce jeu. Ce n'était pas dans vos plans, et cela vous occupe votre temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "De ce fait, une compensation vous sera octroyée pour vos services !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Haha, je ne peux pas refuser ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "Splendide ! Votre magnanimité est digne de louanges !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "J'ai fait une demande de résidence suffisamment longue pour que nos deux amis Fongus puissent rester au Port Ormos lors de la phase de test du Théâtre fongique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "Le Compagnon argenté pourra s'amuser un peu plus longtemps avec Chapotoc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "Quelle bonne nouvelle pour Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Héhé, toi aussi, tu devrais aller voir Chapotoc. Tu lui manques beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Tiens, prends ça. Quand tu joueras avec Chapotoc et Pyrojoie, tu pourras les nourrir avec, c'est ce qu'ils préfèrent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Moi aussi, j'ai hâte !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Je vous rendrai la pareille lors du prochain tournoi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
