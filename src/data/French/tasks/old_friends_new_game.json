			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#{NICKNAME}, la Comète dorée et son Compagnon argenté, Paimon... Quel plaisir de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "Je vois que vous êtes en pleine forme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Tu as l'air d'aller bien, toi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "H—H—Haniyyah ! Et... Et... Monsieur Balfour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Quelle surprise de vous revoir au Port Ormos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "Bref. Qu'est-ce que vous faites là, Haniyyah et monsieur Balfour ? Je me souviens que c'était l'emplacement du stand de gelée florale, ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "#Ah, mes {M#braves héros}{F#braves héroïnes} ! Je me sens beaucoup plus confiant quand j'entends vos voix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Bien, il est temps pour moi de vous faire un rapport sur les résultats obtenus lors de notre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "#Auparavant, vous aviez {M#tous}{F#toutes} deux déclaré que le tournoi de dompteur de la Coupe des nilotpalotus devait être suspendu le temps que l'Académie améliore les Orbes de sagesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Je suppose que vous attendez toujours des nouvelles à ce sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Oui ! Quand des progrès auront été effectués, Layla, Cyno ou les chercheurs responsables devraient venir nous en informer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Tu ne comprendras pas leur jargon, de toute façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "C'est bien vrai. On ne leur serait pas d'une grande aide. Peut-être même qu'on les perturberait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Quel sang-froid, quelle prudence ! Je repense souvent à notre précédente édition grandiose du tournoi, et chaque fois, je suis submergé par les émotions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "C'est pour cela que j'ai récemment cherché à interroger certaines personnes à l'Académie en lien avec ce projet pour obtenir quelques détails...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "À l'heure actuelle, l'amélioration des Orbes de sagesse est encore en phase de conception théorique, il faudra encore un certain temps avant qu'ils soient mis en production.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Cependant, la première édition du tournoi fait de moins en moins partie des discussions, au point où les gens sont en train de l'oublier peu à peu. Nous ne pouvons pas nous permettre que l'influence de l'événement précédent soit ainsi perdue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "C'est pourquoi j'ai approché mademoiselle Haniyyah pour lui proposer de préparer un nouvel événement thématique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "Un « événement thématique » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Vous voulez parler de ces espèces de pièces d'échecs en forme de Fongus disposées sur la table ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Dans le cadre de l'organisation du prochain tournoi, monsieur Balfour est allé chercher des sponsors partout où il le pouvait, et il s'est même rendu à Liyue pour apprendre de nouvelles techniques commerciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Ce faisant, il a fait la découverte d'un certain type de jeu que l'on appelle le « Théâtre mécanique ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Il a ensuite acheté les droits d'exploitation du Théâtre mécanique pour la région de Sumeru, et m'a demandé d'être sa consultante afin de l'aider à élaborer un tout nouveau type de jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Nous l'avons appelé le Théâtre fongique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "Le Théâtre fongique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Laissez-moi deviner... Ça consiste à diriger des Fongus pour qu'ils aillent en découdre avec des mécanismes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Une réponse digne du Compagnon argenté ! Vous avez deviné du premier coup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Selon moi, ce jeu est facile à comprendre et donc à populariser. Il dispose d'un très grand potentiel que l'on pourra exploiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Si nous parvenons à le commercialiser comme un produit dérivé du tournoi de dompteur, nous pourrons permettre à ce dernier de rester dans l'esprit des gens à long terme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Ainsi, le prochain tournoi que nous organiserons attirera un public plus large et un plus grand nombre de participants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Bien sûr, cela ne peut se faire qu'avec votre accord. Après tout, vous avez le dernier mot sur la façon dont le tournoi sera organisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Je pense que ça vaut le coup d'essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Je suis bien d'accord. {NICKNAME} et moi, on ne comprend pas grand-chose au commerce, mais ce que vous dites est loin d'être dénué de sens, monsieur Balfour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "C'est le fruit d'un travail commun entre Haniyyah et vous, et je crois en vos capacités, alors foncez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Même sans avoir joué au jeu, je parie qu'il y a plein de gens qui vont l'adorer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Merveilleux ! Avec un tel soutien de votre part, je peux faire la promotion du Théâtre fongique sans me faire de souci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "Le jeu est toujours en phase de test, donc il nous faut encore demander à des gens de l'essayer et recueillir leurs avis afin d'y apporter des améliorations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Je suis certain que la Comète dorée, qui a déjà essayé une multitude de jeux dans tout Teyvat, saura fournir les commentaires les plus pertinents !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#N'hésite pas, {NICKNAME} ! C'est peut-être un des domaines que tu connais le mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "J'ai l'impression que tu me donnes des ordres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Par contre, il y a quelque chose que j'aimerais te demander, Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Tu veux des nouvelles de Chapotoc et les autres, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Oui ! Nos amis Fongus me manquent. Ils vont bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Ne t'en fais pas, ils sont tous en très bonne santé, et ils ont la vie tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "Tournicoti-tournicoton et Flashello habitent dans <color=#00E1FFFF>mon logement temporaire au nord du Port Ormos</color>. C'est un des participants de la dernière fois qui veille sur eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Chapotoc et Pyrojoie ne sont pas loin d'ici. Tu peux aller jouer avec eux si tu veux, Compagnon argenté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Pas loin d'ici ? {NICKNAME}, je vais aller voir Chapotoc pendant que tu essayes le nouveau jeu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Bien sûr, vas-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Sans plus attendre, je vous invite à essayer notre version préliminaire de test du Théâtre fongique, chère Comète dorée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Je te rejoins dans un instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Allez ! À l'attaque, Comète dorée !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Vous vous êtes vraiment donné du mal !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Je n'aurai pas de suggestion pour eux, de toute façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Vous êtes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}, qu'est-ce qui t'arrive !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "#On a participé à la Coupe des nilotpalotus, tu te souviens ? On s'était bien {M#amusés}{F#amusées} avec nos amis Fongus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "#On est {M#devenus amis}{F#devenues amies} avec Haniyyah à ce moment-là. Et monsieur Balfour était un des organisateurs de la compétition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Tu ne vas pas me dire que tu ne te souviens même pas de Chapotoc, Tournicoti-tournicoton et de tous nos autres amis Fongus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "Ah, ça y est ! Ça me revient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
