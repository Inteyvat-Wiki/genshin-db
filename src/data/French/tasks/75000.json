						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "J'ai oublié de te demander, est-ce que ça va ? Tu ne te sens pas malade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "J'ai attrapé une sauriennite aigüe.",
