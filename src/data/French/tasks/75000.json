			"dialogs": [
				{
					"id": 750000601,
					"content": "Oh... Tu vas bien, mon p'tit gaillard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000602,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000603
					],
					"speakerTitle": "P'tit gaillard ?"
				},
				{
					"id": 750000603,
					"content": "Qu'est-ce qui se passe ? Tu as l'air d'avoir mal. Oh, tu t'es fait mal à la queue en tombant de la cage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000604,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000605
					],
					"speakerTitle": "P'tit gaillard ?"
				},
				{
					"id": 750000605,
					"content": "Si seulement on pouvait lui faire un bandage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000606
					]
				},
				{
					"id": 750000606,
					"content": "Héhé, c'est le moment pour moi d'intervenir... Ton sac à dos déborde de trucs, ça prend une éternité pour trouver quelque chose dans un moment crucial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000607,
					"content": "Utilisons ce foulard de mon sac à dos d'urgence pour lui faire un bandage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000608,
					"content": "Où est ton sac à dos d'ordinaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000609
					]
				},
				{
					"id": 750000609,
					"content": "Pff, quelque part où personne ne peut le trouver facilement, bien sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000610,
					"content": "Hé, tu comptes utiliser ce foulard ou non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000611,
					"content": "Oui, merci Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000612
					]
				},
				{
					"id": 750000612,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000613
					],
					"speakerTitle": "P'tit gaillard ?"
				},
				{
					"id": 750000613,
					"content": "Petit, ne bouge pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000614,
					"content": "#Héhé, tu ne trouves pas qu'il est plutôt bien élevé, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000615,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000616,
					"content": "Ça fera l'affaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000617
					]
				},
				{
					"id": 750000617,
					"content": "Comment tu te sens, mon p'tit gaillard ? Ça va mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000618,
					"content": "Yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000619,
					"content": "Bien, il a l'air en forme maintenant... Quel soulagement. Pourquoi étais-tu enfermé dans cette cage ? Et ces Limiers de faille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000620,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000621,
					"content": "Tu ne le sais pas non plus ? Même si tu le savais, ce n'est pas comme si on pouvait te comprendre... Mais bon, maintenant qu'on t'a sauvé, tu peux rentrer chez toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000622,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000623,
					"content": "Hein ? Tu ne sais pas où est ta maison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000624,
					"content": "Et ta famille ? Oh, le grand gaillard de tout à l'heure, c'était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000625,
					"content": "#Qu'est-ce qu'on fait, {NICKNAME} ? Ce ne serait pas correct de le laisser ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000626,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000627
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000627,
					"content": "Il pourrait nous suivre pour le moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000628
					]
				},
				{
					"id": 750000628,
					"content": "C'est vrai, peut-être qu'à Natlan, on pourrait retrouver sa famille... Mais on n'a encore jamais vu de créature qui lui ressemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000629,
					"content": "#Oh, « {M#élu}{F#élue} du dragon », ça voudrait dire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000630
					]
				},
				{
					"id": 750000630,
					"content": "Hmm... Tu as entendu quelque chose de ce style ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000631,
					"content": "#Du coup, Natlan est la nation des dragons, alors... Ça voudrait dire que ce petit gars en serait un{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000632,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000633
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000633,
					"content": "En le regardant de plus près, il ressemble plutôt à un Élémentosaure, avec ses deux jambes et sa queue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000634,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000635,
					"content": "Je pense qu'on peut le prendre avec nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000636
					]
				},
				{
					"id": 750000636,
					"content": "Mais on devrait lui demander son avis d'abord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000637
					]
				},
				{
					"id": 750000637,
					"content": "C'est vrai. Est-ce que tu veux voyager avec nous, petit gars ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000638,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000639
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000639,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000640
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000640,
					"content": "#Héhé, il est d'accord. Au fait, je suis Paimon ! {M#Lui}{F#Elle}, c'est {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000641,
					"content": "Grr hmm ? Yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000642
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000642,
					"content": "Ah oui, on devrait te donner un nom aussi... Laisse-moi réfléchir, comme tu es jaune et marron... Que penses-tu de « Galette de patate » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000643
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000643,
					"content": "Raouh... Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000644,
						750000646
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000644,
					"content": "Je crains qu'il n'y ait qu'au Bon Chasseur qu'on apprécie ce nom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000645
					]
				},
				{
					"id": 750000645,
					"content": "Tu veux dire qu'il ne serait pas apprécié ailleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000647,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000648
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000648,
					"content": "#Tu veux que {NICKNAME} te nomme ? Je te préviens, {M#il}{F#elle} donne toujours des noms... assez particuliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000649,
						750000650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000649,
					"content": "Tous les noms que j'ai choisis jusque-là étaient parfaitement normaux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000650,
					"content": "Oh, pauvre petit... Quel terrible destin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000646,
					"content": "J'ai l'impression que ça ne lui plaît pas beaucoup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000647
					]
				}
