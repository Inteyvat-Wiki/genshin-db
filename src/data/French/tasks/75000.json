					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "Une sauriennite aigüe ? Ce n'est pas l'heure de plaisanter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Mais dis-moi, {NICKNAME}, je n'ai jamais entendu parler de gens qui se transforment en saurien à Natlan... C'est vraiment étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "On vient tout juste d'arriver ici et il s'est déjà passé tant de choses... Enfin, la priorité est de trouver un moyen de sortir d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hmm ? Tu sais comment faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "C'était plutôt cool d'être un saurien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "#Tant mieux, mais si un jour, tu te retrouves {M#coincé}{F#coincée} dans ta forme de saurien, on sera dans de beaux draps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
