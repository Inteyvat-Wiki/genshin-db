				},
				{
					"id": 750640611,
					"content": "Ouh hmm ? Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Oui... Je suis déçue aussi... Je pensais que cette rémunération serait plus conséquente par rapport à l'acompte...",
