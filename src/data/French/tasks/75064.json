					"id": 750641113,
					"content": "Hein ?! Oh, zut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Je suis désolé, mais la concentration atmosphérique élémentaire d'ici est peut-être différente de celle de Fontaine. Quelque chose a dû mal se passer avec la machine... Mais pas de panique, je vais vérifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "Hmm... Pas ici, non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Bon sang ! Argh, tu m'énerves ! Espèce de gâté, d'incapable gâté ! Argh !",
