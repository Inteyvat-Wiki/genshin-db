					"nextDialogs": [
						750641118
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641118,
					"content": "Hé, calmez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641119,
					"content": "Il y a de la fumée qui s'en échappe !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "Ugh, c'est complètement fichu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "Magnifico"
				},
