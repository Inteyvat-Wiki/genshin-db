			"dialogs": [
				{
					"id": 750641101,
					"content": "Hmm... Prochaine étape : un iktomisaure au clair de lune ! Oui, ça m'a l'air bien. Par contre, il faudra trouver l'éclairage idéal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641102,
					"content": "#Ah ! C'est à ton tour de briller, mon petit {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641103,
					"content": "Petit ? Il est presque plus grand que vous, hein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641104,
					"content": "Ouh ? Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Très bien... C'est le moment parfait... Haha ! Mon chef-d'œuvre est presque complet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "Assurez-vous de prendre une jolie photo, comme l'une de vos Fontainoises ! Héhé, c'est bien ça la réplique, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "Ouh, hmm hmm !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Haha, détendez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Oui, cet angle ! Le clair de lune, parfait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Un instant... J'aurai besoin de deux sources de lumière supplémentaires. L'une d'elles devrait éclairer l'iktomisaure de profil, afin d'obtenir un contraste entre la lumière chaude et le fond de la nuit... Ça crée une ambiance mystérieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "L'autre source de lumière devrait illuminer la silhouette du saurien, juste par nécessité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Oui... C'est ça ! Comme dans un rêve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
