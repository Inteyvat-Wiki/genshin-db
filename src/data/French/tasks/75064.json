					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641129,
					"content": "Magnifico se remet à bricoler sur son Daguerréotype et vous laisse réfléchir à la fabrication d'une source lumineuse adaptée...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "Que se passe-t-il ? Vous allez divorcer ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
