				},
				{
					"id": 750640615,
					"content": "Ugh, vous croyez vraiment qu'on n'a pas autre chose à faire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Haha ! Ce n'est pas moi qui décide, mais le destin ! Il nous a réunis !",
