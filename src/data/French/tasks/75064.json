			"dialogs": [
				{
					"id": 750640601,
					"content": "Haha, très bien ! Allez, mon petit modèle, ne bouge plus... Oui, c'est bien ! Trois, deux, un, ouistiti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Regardez-moi ça, c'est un chef-d'œuvre ! Qui en est l'auteur ? Moi, Magnifico de la Magnificans, évidemment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Merci, merci beaucoup ! Haha ! Bon, voici ce que je vous dois ! Et prenez ça aussi, regardez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Ouah... Le dernier paiement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Quoi ? Un mora seulement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Superbe... Et maintenant, notre véritable protagoniste est sur le point de faire son apparition ! Viens, ne sois pas timide ! Tu es une star, alors fais une entrée fracassante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Pfiou, c'est fini ! Tenez, prenez cet exemplaire en cadeau... Et sachez que vous avez eu ce chef-d'œuvre avant n'importe quelle galerie fontainoise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "Merci, on en prendra soin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Et le paiement...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "Je vais me rendre à cet endroit ensuite... Laissez-moi vous l'indiquer sur la carte. Qui sait, peut-être nous reverrons-nous un jour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "À ce moment-là, j'aurai peut-être à nouveau besoin de votre aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
