			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "Vous aimez cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "Vous voulez discuter un peu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "Vous avez envie de faire quelque chose en particulier ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Oh oui, j'aime beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901510,
					"content": "Les paysages ici sont vraiment différents de Mondstadt, je trouve ça très rafraîchissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901511,
					"content": "Et ici, je peux chanter aussi fort que je le veux sans avoir à m'inquiéter de déranger qui que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901512,
					"content": "Vous ne dérangez personne en chantant, allons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Tant mieux alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901514,
					"content": "C'est gentil de votre part. Mais... Il faut quand même savoir prendre les autres en considération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901515,
					"content": "Enfin, quoi qu'il en soit, je suis bien contente que vous m'ayez invitée à venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901517,
					"content": "Oui... Je suis vraiment contente que vous m'ayez invitée ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901518,
					"content": "J'aimerais rester un peu plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901520,
					"content": "Oh, avec plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901521,
					"content": "Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901522,
					"content": "Pourquoi ce sourire tout à coup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "#Oh, je pensais juste que je n'ai pas pris le temps de discuter avec {M#un ami}{F#une amie} depuis une éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901525,
					"content": "Ça me fait vraiment plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901526,
					"content": "Vous vous satisfaites de peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "C'est parce que vous faites toujours passer les autres avant vous-même.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "Ah, euh... Ah bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901528,
					"content": "Mais... Ce n'est peut-être pas une mauvaise chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901529,
					"content": "Celui qui ressent facilement de la joie a d'autant plus d'énergie à la partager ensuite avec d'autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901531,
					"content": "Bien sûr, c'est normal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901532,
					"content": "Tellement de gens ont veillé, et veillent encore sur moi. Je veux juste faire mon possible pour rendre la pareille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901533,
					"content": "Vous êtes irremplaçable, Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Ah... Je vous en prie, arrêtez avec tous ces compliments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901535,
					"content": "C'est la critique constructive qui permet de progresser, après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901537,
					"content": "Oh, je travaille sur une nouvelle chanson, ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901538,
					"content": "Mais il reste encore quelques détails à améliorer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901539,
					"content": "Est-ce qu'il ne vaut pas mieux monter le refrain d'un ton, est-ce que la chorégraphie ne peut pas être améliorée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901541,
					"content": "Vous avez mon soutien sans réserve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "Ce serait un honneur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Si ça ne vous dérange pas, ça me ferait vraiment plaisir si vous pouviez me donner votre avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901543,
					"content": "Merci...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901544,
					"content": "Euh... S'il y a des choses pas encore au point, ne vous moquez pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901545,
					"content": "J'ai beaucoup réfléchi avant de trouver le courage de chanter devant vous, et d'aussi près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901547,
					"content": "Allons, ça n'arrivera pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "Alors, si vous riez, je ne saurai plus où me mettre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901549,
					"content": "*soupir* ... Bon, d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901550,
					"content": "Dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901551,
					"content": "Que le spectacle commence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
