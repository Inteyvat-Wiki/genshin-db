				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "Nous y sommes enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820102,
					"content": "Et votre rêve d'enfant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "En devenant adulte, j'ai enfin compris pourquoi les brigadiers forestiers étaient contrariés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820104,
					"content": "*tousse* Enfin, j'aurais au moins essayé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820105,
					"content": "Et j'ai également appris qu'il ne fallait pas approcher le Champieffroi panaché avec les fruits d'un Arbre enflammé non traités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820106,
					"content": "Il était déjà trop tard quand j'ai senti l'odeur de brûlé. J'ai failli m'étouffer à cause des spores qu'il répandait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820107,
					"content": "On a tendance à oublier que les Fongus sont une espèce complètement différente des porpignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820108,
					"content": "Les Fongus sont donc bien des champignons, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820109,
					"content": "C'est ça, et ils sont particulièrement délicieux en soupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820110,
					"content": "Bref, revenons-en au défi d'aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820111,
					"content": "Eh bien, je n'ai pas encore trouvé quoi cuisiner, vous... Oh, vous parlez des négociations, désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820112,
					"content": "#Peut-être avez-vous entendu l'histoire des deux souverains Aberrants fontemarins ? Elle décrit l'Hippocampe perlé millénaire comme étant «{NON_BREAK_SPACE}fier » et « noble ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820113,
					"content": "En revanche, l'Empereur du feu ferreux semble être un être impitoyable. Puissant, mais brutal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820114,
					"content": "Je pensais que vous choisiriez un adversaire plus coriace. Il faut un adversaire redoutable pour que l'histoire soit vraiment cool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820115,
					"content": "C'est vrai, mais l'Empereur est un Cuiracrabe puissant... Et de l'autre côté, l'Hippocampe perlé millénaire est un hippocampe volant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820116,
					"content": "On devrait peut-être plutôt l'appeler Pégase ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "C'est vraiment ça qui t'inquiète ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820119,
					"content": "Si seulement je pouvais le monter, ne serait-ce qu'une seule fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820120,
					"content": "Très bien. On dirait que vous souhaitez aller jusqu'au bout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820121,
					"content": "#Nous n'allons pas rentrer les mains vides, puisque nous sommes déjà là. Nous partirons quand vous serez {M#prêts}{F#prêtes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820122,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "#Je suis {M#occupé}{F#occupée}. À plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "Pas de problème, j'attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820118,
					"content": "Ça m'est égal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}