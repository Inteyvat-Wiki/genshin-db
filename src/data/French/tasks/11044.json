					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Hmm... Un résultat moyen pour un bon plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "En ce qui concerne l'hypothèse de propagation, nous avons échoué... On dirait que la nourriture présente les mêmes complexités dans votre monde que dans le nôtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "À moins que... Serait-ce que les lois naturelles de ce monde limitent vos capacités uniques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "On ne savait tout simplement pas comment canaliser l'énergie élémentaire dans la nourriture... C'est un peu plus compliqué que de rajouter des herbes et des épices, enfin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "#Ne vous inquiétez pas. Au moins, nous faisons bon usage de la nourriture, pas besoin de se sentir {M#découragés}{F#découragées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "Et voici votre portion, profitez-en ! Je peux vous la mettre dans une boîte si vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Youhou, merci ! Heureuse que vous vous en soyez souvenu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Vous êtes la nouvelle personne préférée de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "#On voit que vous êtes de {M#bons amis}{F#bonnes amies}, Paimon gardait un œil sur vous pour votre sécurité pendant toute l'expérimentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Non pas qu'elle aurait pu faire grand-chose si les choses avaient mal tourné, mais enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "Hé ! Vous étiez encore gentil il y a une seconde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Mais vos recettes sont savoureuses, alors je vous pardonne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "#Et vous avez raison, nous sommes de {M#bons amis}{F#bonnes amies}. Vous en avez aussi, non ? Ou de bons élèves ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "... Euh, oui ! J'ai aussi cette chance, je suppose. Quoi qu'il en soit, passons à l'expérimentation suivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Il y a toutes sortes d'objets alchimiques ici, et les garder à leur place est un défi de tous les instants. Il y a quelque temps, j'ai eu le malheur d'en perdre quelques-uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "J'ai réussi à en récupérer la majorité, mais deux fioles me manquent : de l'extrait élémentaire de papillon cristallin Anémo et de la poudre d'Hypostase Électro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "J'ai à peine fini de manger et vous voulez qu'on y retourne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Ce n'est pas grave si vous n'arrivez pas à les retrouver. J'avais l'intention de les remplacer de toute façon, mais les trouver m'éviterait cette peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Si vous aviez, disons, un « super-pouvoir », comme une vision nocturne ou un pouvoir de détection, nous n'aurions plus à nous inquiéter de perdre des objets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "J'ai dû les perdre quelque part dans le coin où vous regardiez tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Donc... Je suppose qu'on ferait mieux de jeter un œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Il devrait y avoir des traces élémentaires venant des objets perdus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Oh oui ! Tu peux utiliser ta vue élémentaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Ce n'est pas souvent qu'on s'occupe autant de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
