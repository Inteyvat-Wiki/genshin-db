			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Je suis revenu. Avez-vous vu quelque chose d'intéressant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440142,
					"content": "On ne comprend rien à ce qui se passe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "Ne vous inquiétez pas ! Tout est là à des fins alchimiques. Vous auriez du mal à trouver un usage à tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440146,
					"content": "Bon, continuons les recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440101,
					"content": "Il peut y avoir des différences significatives entre les différents mondes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440102,
					"content": "Prenons Teyvat, par exemple... Ici, ceux qui ont des yeux divins peuvent manipuler les éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440103,
					"content": "Mais il pourrait exister des mondes où une seule personne est capable de le faire, ou même tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440104,
					"content": "#Donc, {NICKNAME}, en laissant les éléments de côté... Possédez-vous des... capacités uniques ? De celles qui n'existent pas dans ce monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440105,
					"content": "Je pense que la réponse à cette question nécessite la même méthodologie que la dernière fois. En d'autres termes, c'est l'heure de la prochaine expérimentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440106,
					"content": "Dois-je encore combattre des Blobs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "#Non, non ! Vous ne serez pas {M#obligé}{F#obligée} de faire autant d'efforts cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440109,
					"content": "Bon, vous voyez ce pilier-là ? Utilisez votre volonté pour essayer de le briser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440110,
					"content": "#{M#Désolé}{F#Désolée}, je ne peux vraiment pas faire ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "Et c'était ce que vous pouviez faire de mieux ? Hmm... Eh bien, nous n'avons pas le choix, je suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440112,
					"content": "Pourquoi cette déception !? C'est pas, genre, impossible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440116,
					"content": "Ah ! Avez-vous déjà essayé d'utiliser votre énergie élémentaire avec de la nourriture ? Je ne parle pas de la cuisine en tant que telle, mais plutôt de canaliser votre énergie dans les ingrédients eux-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440117,
					"content": "Je suis curieux de voir comment le goût et la texture réagissent. Cela peut même aider pour... La propagation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440118,
					"content": "Les alchimistes ont vraiment une imagination active...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Haha, je suppose que j'ai de la curiosité pour certaines choses que les autres trouvent surprenantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440121,
					"content": "Bref, pourquoi ne pas nous cuisiner un poisson frit au beurre ? Je viens de terminer la préparation de la recette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440151,
					"content": "De la cuisine ? J'attendais avec impatience d'autres trucs de savants fous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440122,
					"content": "Non seulement je trouve que cette recette est un classique, mais elle est utile pour les expérimentations et très nutritive !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440123,
					"content": "Hum, je parie juste que vous avez faim !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440124,
					"content": "Mais ça a l'air vraiment délicieux... D'accord, j'approuve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440125,
					"content": "Je vois où tu veux en venir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "#Miam, les {M#vrais amis}{F#vraies amies} sont toujours sur la même longueur d'onde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440128,
					"content": "Je vous laisse donc vous en occuper, et j'ai hâte de voir les résultats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440130,
					"content": "S'il en reste trop, Timaeus pourra peut-être finir ce qui est en excédent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440131,
					"content": "Euh... Je ne pense pas que nous allons rencontrer ce genre de... problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440126,
					"content": "Je t'en garderai une nageoire ou deux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "Vous êtes sûr de ne pas avoir juste un petit creux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Essaye donc, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "Tu penses que je sais comment faire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440115,
					"content": "Et c'était ce que vous pouviez faire de mieux ? Hmm... Eh bien, nous n'avons pas le choix, je suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440107,
					"content": "Je n'ai plus soif, merci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "C'est un peu tout en vrac...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Hmm, c'est vrai... J'adorerais trouver un moment pour tout mettre en ordre. Mais les expérimentations passent avant tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "Diantre, vous avez réussi à les retrouver ? Incroyable ! Mille mercis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440321,
					"content": "Je me demande, cette « vue élémentaire »... C'est ce qui vous a permis de localiser mes objets, et de me retrouver dans les montagnes, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440322,
					"content": "Ouaip ! Je suppose que ça compte comme un super-pouvoir, héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440323,
					"content": "Malheureusement, bien que la vue élémentaire soit rare, elle n'est pas inconnue en Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440324,
					"content": "Seul un pouvoir d'un autre monde jamais vu auparavant serait bénéfique pour mes recherches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440325,
					"content": "Vous voulez dire... On a encore échoué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440326,
					"content": "Ne vous découragez pas ! Cela faisait partie des possibilités. En plus, pouvoir retrouver ces objets ? J'appellerais ça une expérimentation très utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440301,
					"content": "Je dois aussi vous féliciter pour votre déduction... Comprendre que les objets contiendraient des traces élémentaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440302,
					"content": "#Bon, jusqu'à présent, nos recherches se sont concentrées sur votre identité d'{M#étranger venu}{F#étrangère venue} d'un autre monde. Nos recherches sur votre identité en tant que l'un des nôtres ne font que commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440303,
					"content": "Nous vous aiderons jusqu'au bout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "En substance, les différences entre les humains se reflètent dans nos capacités intellectuelles et physiques. Commençons par ce qui est physique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440306,
					"content": "En regardant d'où nous sommes situés, pouvez-vous voir ce que fait Sucrose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440307,
					"content": "Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "Et si vous sautiez d'ici et atterrissiez sur cette falaise là-bas, vous pourriez la voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440309,
					"content": "Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "Et si vous frappiez d'un seul coup la montagne ici et qu'elle éclatait en un million de morceaux ? Pourriez-vous alors la voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440311,
					"content": "Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Hmm, alors je ne devrais pas être si enthousiaste. Bon, nous approfondirons notre compréhension avec une expérimentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440314,
					"content": "Je connais un endroit qui sera parfait pour un test physique. Suivez-moi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440312,
					"content": "On dirait qu'on en est toujours aux tests de super-pouvoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "... Et on peut descendre de ce train en marche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
				1104416
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
