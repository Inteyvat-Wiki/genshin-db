			},
			"dialogs": [
				{
					"id": 761170501,
					"content": "Excellent, vous avez accompli la mission. Je vous prie de patienter pendant que je vais chercher votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170502,
					"content": "Tout va bien, mademoiselle Jahoda ? Vous êtes un peu pâle... Avez-vous eu des problèmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170503,
					"content": "Ne vous inquiétez pas, je vais bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Très bien. Un instant, je reviens tout de suite avec votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170505,
					"content": "Tu es sûre que ça va, Jahoda ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Je sais qu'on a promis de ne pas appeler de médecin, mais... Ihanti avait vraiment l'air mal en point tout à l'heure. Peut-être qu'on devrait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "Non. J'ai dit que je respecterai le code, alors je vais le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Tu le connaissais bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "On était « collègues ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "C'était peut-être un lâche, mais quand il s'agissait de récupérer des moras... Haha, Ihanti était le meilleur dans son domaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Pendant que les autres faisaient des arnaques stupides et des petits larcins, lui jouait si bien avec les mots que les gens finissaient par lui donner leur argent de leur plein gré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "Il avait vraiment le don de persuader les gens. À l'époque où on « travaillait » ensemble, il m'a transmis beaucoup de ses techniques... et il m'invitait toujours à manger dans d'excellents restaurants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "C'était ton ami ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "Mon ami ? Évidemment que non. Il faudrait être fou pour essayer de se faire des amis dans ce trou à rats. Au mieux, on... on peut dire qu'on était des connaissances. C'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "S'il prenait si bien soin de moi, c'était juste pour se la jouer. Avoir un larbin à ses côtés devait lui donner l'impression d'être quelqu'un d'important, j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Mais il a pris soin de moi, je dois le reconnaître. Je l'ai aidé pour lui rendre la pareille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Voici votre récompense, mademoiselle Jahoda. La Guilde des aventuriers vous remercie pour votre aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170518,
					"content": "#Voici ta part, {NICKNAME}. Merci pour le coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "Bon, je devrais rentrer au Curatorium. Si la patronne veut quelque chose et que je ne suis pas là, elle va encore me tomber dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(J'ai dit que je n'appellerais pas de médecin, mais je peux quand même lui apporter des antalgiques ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Je vais demander de l'aide à la patronne, je suis sûre qu'elle pourra faire quelque chose. Au pire, je sacrifierai mon salaire de ce mois-ci... Hum, peut-être juste la moitié...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Oui, je vais faire ça. Je ferais mieux d'apporter les médicaments à Ihanti demain...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
