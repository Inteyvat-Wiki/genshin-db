			"dialogs": [
				{
					"id": 761170101,
					"content": "Hmm, on dirait que vous avez mené cette mission à bien. Merci, mademoiselle Jahoda. Voici votre paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170102,
					"content": "Vous voyez ? Je vous l'avais bien dit que tout irait bien ! La paie n'est pas mal non plus, héhé... Vous n'auriez pas d'autres petits boulots rapides comme ça qui rapportent pas mal de moras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Je vais regarder. Un instant s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170104,
					"content": "Hein ?! Mais c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Dites, Catherine... Ce pendentif là-bas, il a été utilisé pour publier une prime ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "En effet, vous avez l'œil, mademoiselle Jahoda. Monsieur Ihanti l'a laissé comme garantie pour une demande de prime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170107,
					"content": "Dans ce cas, je m'en charge. Donnez-moi juste les détails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Le problème, c'est que... la récompense n'est pas très élevée. De nos jours, ce genre de pièce ne vaut plus grand-chose non plus. Je ne suis pas sûre que ce soit le type de mission qui vous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170109,
					"content": "Ne vous inquiétez pas, je m'en charge. Je peux bien faire un peu de charité. Il faut bien accumuler un peu de bon karma de temps en temps, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Haha... Très bien. Un instant, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170111,
					"content": "Tu acceptes encore des missions ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "En même temps, ce n'est pas comme si j'avais grand-chose d'autre à faire en ce moment. Je ne peux pas passer mes journées à jouer avec Ashru, hein ? Nef... enfin, la patronne me mettrait à la porte en moins de deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Hmm, maintenant que vous êtes là... {NICKNAME}, Paimon, vous êtes plutôt {M#débrouillards tous les deux}{F#débrouillardes toutes les deux}, non ? Ça vous dirait qu'on fasse équipe ? On pourrait partager la récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#Une mission ? C'est à {M#lui}{F#elle} qu'il faut demander !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Je parie que ce n'est rien de difficile. Crois-moi, Ihanti est bien trop froussard pour que ce soit quelque chose de sérieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Mademoiselle Jahoda, voici les détails de la mission de monsieur Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761170120,
					"content": "Bon, voyons voir ce que cette poule mouillée a encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "... Tsss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "Qu'est-ce qu'il y a ? J'espère que ce n'est pas quelque chose de super compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Non, pas du tout. C'est juste que je ne m'attendais pas à ce qu'un gars incapable de faire du mal à une mouche puisse donner une mission où il est question de vie ou de mort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "Comment ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "Toi ? Hahaha, mais bien sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Détends-toi, je te taquine. Il s'agit juste de récupérer quelque chose auprès d'une bande de malfrats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Pour un escroc, l'argent c'est la vie, et la vie c'est l'argent. Du coup, c'est une question de vie ou de mort, pas vrai ? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "Allez, suivez-moi. Je suis certaine de pouvoir gérer ces petites frappes toute seule. Il y a des chances pour que t'aies même pas à lever le petit doigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Sache que je suis quelqu'un qui respecte la loi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "D'accord, pourquoi pas. De quel genre de mission parle-t-on ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Toujours aussi occupée à ce que je vois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
