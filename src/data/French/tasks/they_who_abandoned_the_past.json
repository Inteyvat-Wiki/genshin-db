					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "*halète* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Qui est là ? Je n'ai pas le moindre mora, absolument aucun... Si c'est ma vie que vous voulez, alors... allez-y, prenez-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "J—J'ai rapporté tes affaires, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "... Jahoda, c'est toi ? J'entends ta voix, mais je n'arrive plus à voir clairement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "C'est moi, Ihanti, je suis juste là, devant toi. Pourquoi n'es-tu pas venu me chercher ? Tu as l'air dans un sale état.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Même un chien errant affamé n'ose pas s'aventurer sur le territoire des riches... Pas après avoir reçu tant de coups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "Je ne suis pas ce genre de personne, et Nef... je veux dire, la patronne non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "C'est justement pour ça que je ne pouvais pas venir te voir. Si les gens apprenaient que tu étais du genre à donner un coup de main, ils viendraient frapper à ta porte tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Personne ne serait assez fou pour tenter un coup pareil avec la patronne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Mais toi, tu fais toujours le bien autour de toi en secret. Tout ça pour te faire poignarder dans le dos par ceux que tu as aidés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "Hé. J'ai beaucoup appris de la patronne, tu sais. Plus personne ne m'aura comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "... Tu ne peux vraiment pas t'empêcher de veiller sur les autres. Pas vrai, Jahoda ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "... Ça ne regarde que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Haha... C'est peut-être pour ça que le chef te tient en si haute estime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "C'est peut-être la seule raison pour laquelle je suis encore en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Hahaha... *tousse*... Tu as raison, Jahoda. C'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "... Bref, si tu as besoin de quelque chose, Ihanti, c'est le moment de me le dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Toujours la même, à ce que je vois... Et si tout ça n'était qu'une arnaque, ou si je te tendais un piège ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Tu ne ferais pas ça. Pas après tout ce temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "Et c'est suffisant pour gagner ta confiance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Allons, regarde dans quel état tu es. Comment pourrais-tu représenter une menace pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Hah ! Enfin, on avance. Je suppose qu'aider un serpent venimeux qui peut à peine ouvrir la gueule est plutôt sans risque, tout compte fait... *tousse*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Rends-moi service. Enroule la peinture qui se trouve dans ce sac et glisse-la dans ma poche. Je n'ai plus la force de le faire moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "J'ai peint ça avec ma femme et ma fille. C'est la seule chose au monde à laquelle je tiens encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Pour moi, plus rien d'autre n'a d'importance désormais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "L'ancien toi aurait éclaté de rire en t'entendant dire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Hah... Et qu'est-il advenu de ces choses que je chérissais tant autrefois ? Elles n'ont pu sauver ni ma femme, ni ma vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Un voleur récolte ce qu'il sème, je suppose. Tout ce que nous dérobons finit toujours par nous être volé en retour, et nous nous retrouvons à nouveau les mains vides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Ce pendentif que j'ai mis en gage pour la mission était tout ce qu'il me restait... Même si je ne peux pas vraiment dire qu'il était « à moi ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "C'était le premier bijou que tu aies volé. Tu m'as raconté cette histoire au moins une douzaine de fois, comment tu t'y étais pris, la tête qu'a fait le type riche quand il s'en est rendu compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "De toute façon, il est à toi maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "À qui appartenait-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "À un Snezhnayien qui s'appelait Holomov. Il vivait à Nod-Krai, mais il est probablement rentré chez lui à Snezhnaya maintenant. Ne me dis pas que tu penses à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Je ne suis plus une voleuse, et je n'ai pas l'intention de commencer à posséder des biens volés. Ce pendentif doit être rendu à son propriétaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Haha... Hahaha... Tu es vraiment quelqu'un d'unique, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "Le chef avait raison... Une personne comme toi ne pourrait jamais... *tousse* être une bonne voleuse... *tousse*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Ça suffit, arrête de t'épuiser. Je vais rentrer et te chercher un médecin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Laisse tomber. Laisse-moi partir comme je le dois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, tu connais le code du patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "Accorde le repos à ceux qui le cherchent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Tu sais très bien de quoi je parle, alors laisse-moi tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Je suis content que ce soit toi qui sois venue m'aider, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Désolé, je n'ai pas de trésor à t'offrir. Mais si tu veux, tu peux prendre cette poupée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Attends, mais... Je croyais t'avoir dit de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "Ne t'inquiète pas, c'est moi qui l'ai fabriquée. Celles que tu avais assemblées ont disparu depuis longtemps. Je les ai toutes brûlées jusqu'à la dernière, comme tu me l'avais demandé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Pas mal, hein ? Surtout pour quelqu'un qui était déjà presque aveugle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Prends-la, Jahoda. Considère ça comme mon dernier cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
