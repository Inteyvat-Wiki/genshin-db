			"dialogs": [
				{
					"id": 761170201,
					"content": "Pff, quel minable. Ce type est tellement fauché qu'il n'y a rien à voler sur lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "Yo, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Qui va l— Oh, mais c'est notre chère Jahoda ! Qu'est-ce qui t'amène ici, demi-portion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Du calme, ce n'est rien de grave. Il paraît que tu as volé quelque chose à un certain Ihanti il y a quelques jours. C'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Tiens, prends cet argent et rends-moi la marchandise. Je suis d'humeur généreuse aujourd'hui, alors je te rachète tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Oh, regardez-moi ça, elle fait genre qu'elle est civilisée maintenant. C'est comme ça quand Nefer te couvre, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "Et si je préférais la garder ? Qu'est-ce que tu vas faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Rends-moi service, Kaleva. Ta bande de crétins et toi ne pourriez pas essayer d'agir normalement pour une fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Ne me dites pas que vous avez fait tout ce chemin jusqu'ici en espérant négocier avec un voleur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Ou peut-être pensais-tu naïvement que j'allais tout te donner gentiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "On dirait que cette négociation était vouée à l'échec avant même d'avoir commencé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Désolée, Kaleva. Je n'aurais pas dû essayer de négocier avec toi comme la patronne le fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Un coup de poing dans la figure, c'est la seule façon de négocier avec des crétins comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Allez {NICKNAME}, on va leur régler leur compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Tu nous prends de haut ? Allez les gars, il est temps de remettre cette petite insolente à sa place. Attrapez-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
