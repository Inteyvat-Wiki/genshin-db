							200.186,
							9563.697
						],
						"pointId": 14265
					}
				]
			},
			"dialogs": [
				{
					"id": 761170301,
					"content": "D'accord, tu as gagné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "Tu vois ? Si tu avais joué le jeu dès le début, tu ne te serais pas retrouvé dans ce pétrin. Maintenant, prends ces moras et va consulter un médecin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "Pff, c'est comme ça que tu montres ta compassion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Arrête de parler et prends les moras. Que tu les jettes à l'eau ou que tu les utilises pour engager des voyous et te venger, c'est toi qui décides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Une chose est sûre : avoir faim et se faire taper, c'est nul dans les deux cas. Ne te complique pas la vie, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "Les trucs que j'ai piqués au malade sont là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "À part un peu de monnaie, il n'y avait qu'une peinture et une poupée en mauvais état. Les moras ont été dépensés depuis longtemps, mais je n'ai pas encore eu le temps de jeter le reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Bon, dernière question. Tu viens de qualifier Ihanti de « malade ». Qu'est-ce que tu voulais dire par là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Ça veut dire ce que ça veut dire. Cette mauviette est dans un tel état qu'on arrive à peine à savoir s'il est encore en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Quand je l'ai trouvé, il était étendu là, raide comme une planche. Franchement, je pensais qu'il avait déjà... Enfin, tu vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "... De toute façon, je me suis dit qu'il n'aurait plus besoin de son sac, alors je l'ai embarqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Dis-moi l'endroit où tu l'as vu pour la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "Où je l'ai vu pour la dernière fois ? Je dirais... par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#D'accord. {NICKNAME}, Paimon, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "J'aimerais remettre ces objets au client en personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
			"id": 7611704,
			"completionStepIds": [
				7611705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
