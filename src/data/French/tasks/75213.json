			"dialogs": [
				{
					"id": 752130201,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Hm ? Vraiment ? Bon, si vous insistez... Nous avons déjà déployé tout le personnel, mais nous avons encore une livraison urgente à effectuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Une note sur la commande indique que cela doit être livré à <color=#00E1FFFF>un visiteur en short bleu sur la plage</color>. Tout ira bien tant que c'est livré à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "Plus sérieusement, merci pour votre aide. En plus des frais de livraison, j'ajouterai la recette de notre boisson en guise de compensation. Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
