			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "Bonjour, voici vos boissons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "#Oh ! Ah ! Vous êtes les {M#livreurs}{F#livreuses}. Je me demandais pourquoi ça prenait autant de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "C'est votre faute ! Vous avez demandé à ce que cela soit livré à « un visiteur en short bleu sur la plage », mais vous vous êtes enterré dans le sable ! On a passé une éternité à vous chercher, vous et votre fichu short bleu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Vous devriez nous payer le double des frais de livraison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Ah, je suis vraiment désolé. J'avais oublié ça... J'aurais dû laisser mon short sur le sable pour que vous puissiez me trouver plus facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Mais que faites-vous enterré au juste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "#C'est super amusant{NON_BREAK_SPACE}! J'ai entendu dire que c'était une des choses que les gens font en vacances, alors j'ai voulu essayer{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Mais euh, vous n'avez pas l'air de le faire correctement. Vous ressemblez à une carotte coincée dans la terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "Hein ? Est-ce que ça pose un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Vous pourriez faire trébucher quelqu'un, vous seriez tous les deux blessés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Hmm, je vois... Je vais y réfléchir. Oh, et voici votre rémunération, je l'ai doublée ! Merci encore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
