			"dialogs": [
				{
					"id": 790540401,
					"content": "Des photos... Je n'arrive pas à croire que quelque chose d'aussi incroyable existe. Il est donc désormais possible de garder un souvenir de toutes sortes de paysages incroyables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540402,
					"content": "#Eh bien, {NICKNAME}, avez-vous terminé ? J'ai vraiment hâte de voir votre photo des étoiles.",
