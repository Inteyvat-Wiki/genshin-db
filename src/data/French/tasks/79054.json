			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney, nous revoilà ! Tenez, voici la photo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "... Waouh, on dirait presque la réalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "Vous allez vraiment me donner cette photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Bien sûr, nous l'avons prise pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Haha, merci... Je n'aurais jamais pensé voir une technologie aussi incroyable. Avec des avancées technologiques comme celle-ci, on peut rêver pouvoir construire un chariot tchou-tchou en dehors du Mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Quel beau ciel étoilé... Si seulement nous avions eu une technologie comme celle-ci à l'époque, alors... alors il aurait pu voir cette belle vue quand il le voulait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
