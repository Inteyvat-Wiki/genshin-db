				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeroney"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "#Oh, que faites-vous ici {M#tous les deux}{F#toutes les deux} ? Il n'y a pas de rails ici, et c'est très haut, nous sommes à l'extrémité du Mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "Les gens viennent rarement ici. Je ne suis même pas sûr qu'Idyia en connaisse l'existence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Mais que faites-vous ici alors, s'il n'y a rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Je viens seulement prendre un peu l'air... Hé, ne me regardez pas avec l'air de dire « vous vous êtes encouru après une autre dispute avec Ferdinand » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "Je vous assure, il n'y a pas eu de dispute. Je me promène juste par, euh... Par intérêt personnel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Je suppose que vous savez déjà que le chariot tchou-tchou était mon idée. À cette époque, je n'arrêtais pas de me demander : qu'est-ce qui peut facilement atteindre des sommets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Alors j'ai eu l'idée du chariot tchou-tchou et des rails, tout ça par amour du ciel et des hauteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Cela semble idiot, n'est-ce pas ? Je me souviens qu'Inazuma a un dicton qui dit quelque chose comme « seuls les idiots et la fumée aiment prendre de la hauteur »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "C'est génial que vous ayez inventé le chariot tchou-tchou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Malheureusement, il ne peut exister que dans le Mirage de veluriyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "... Oubliez ça, n'en parlons plus. Je suis aussi venu ici pour observer les étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Je sais que les étoiles ici ne sont qu'une ombre éphémère de l'extérieur du Mirage, mais elles sont assez jolies pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Chaque nuit, quand je regarde le ciel étoilé... Ça me permet de me vider la tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Celui qui aime le ciel étoilé... Est-ce Jeroney...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Mais quiconque voit un ciel étoilé comme celui-ci ne peut s'empêcher d'en tomber amoureux. Si seulement je pouvais aussi voir les étoiles pendant la journée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Ou mieux encore, si je n'avais pas à grimper ici tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "Attendez ! C'est possible, j'ai une idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Hein ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Il suffit de prendre une photo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "Une photo ? Cela ressemble à une technologie de pointe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Ouais, on n'a qu'à prendre une photo du ciel étoilé pour Jeroney ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "C'est vraiment possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Mais... je ne sais pas trop d'où on pourrait la prendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "Ici ! La nuit, c'est d'ici qu'on voit le mieux les étoiles ! C'est pour ça que j'y viens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Vraiment ? Super ! Attendez qu'on prenne la photo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "C'est vraiment très amusant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
