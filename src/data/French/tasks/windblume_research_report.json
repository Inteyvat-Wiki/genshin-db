				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "Avez-vous pris les clichés dont j'avais besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Les voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Oh, c'est du très bon travail. Je suis sûr que ça me sera très utile pendant mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Ah, ces si beaux paysages me rappellent les festivals de ma Sumeru natale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "Quel genre de fêtes célébrez-vous à Sumeru ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Ah, vous l'ignorez sûrement, mais nous célébrons chaque année le Festival Sabzeruz, qui commémore la naissance de la Rani Kusanali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "Mais si on veut comparer l'ambiance, je dirais quand même qu'il y a une différence entre la Fête des alizées et celles de chez nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Je n'ai d'ailleurs pas pu participer au Festival Sabzeruz de cette année. Ça fait si longtemps maintenant... Je me demande comment ça va à l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Enfin, je m'égare. Quoi qu'il en soit, merci pour votre aide. Veuillez accepter ceci en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
	]
