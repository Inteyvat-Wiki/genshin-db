			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "Des coutumes si romantiques, voilà ce qui vaut vraiment la peine d'être étudié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "Que faites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "#Ah, c'est vous, {M#voyageur}{F#voyageuse}. Vous aussi, vous venez ici en apprendre plus sur les chansons romantiques de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Les mots portés sur papier peuvent être lus n'importe quand, mais l'histoire qui se déroule tout autour de nous disparaît en un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "Les Mondstadtois ont de nombreuses coutumes particulières pendant cette période romantique et chaleureuse connue sous le nom de Fête des alizées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "Quelle forme prennent ces traditions, et qu'en est-il de leurs origines ? Ce sont des angles de recherche très prometteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "J'écris actuellement un rapport de recherche, mais je pense que des descriptions seules ne suffiront pas. Pourriez-vous m'aider à prendre quelques clichés des sites majeurs de la Fête des alizées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "Merci de m'aider dans mes recherches ! Je n'oublierai pas de vous créditer dans mes annexes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "Voici les endroits qui valent d'être documentés : les <color=#00E1FFFF>décorations florales de la Place de la fontaine</color>, la <color=#00E1FFFF>statue de l'Archon ornée de fleurs devant la cathédrale</color> et la <color=#00E1FFFF>fleuriste en plein travail</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Je vous en prie, aidez-moi à prendre ces clichés et ramenez-les dès que vous avez fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "Vous devriez y aller vous-même.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "Non, non. Je ne peux pour l'instant pas partir. Je viens à peine de rédiger les grandes lignes directrices de ma thèse. Si je pars maintenant, je perdrai le fil de ma pensée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "#Alors je compte sur vous, {M#voyageur}{F#voyageuse}. Bien qu'elle soit maigre, je préparerai une compensation pour vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
		{
