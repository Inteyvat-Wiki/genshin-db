				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "Bienvenue au Langage des Fleurs. Que puis-je faire pour toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "À propos des clichés de Sayid...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Hmm, ce n'est pas faux, la Fête des alizées est unique à Mondstadt. Les Sumériens ne la célèbrent probablement pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "Alors il veut prendre une photo de mes fleurs et de moi ? Bien sûr. Sayid a vraiment une façon étrange de penser. J'imagine que les chercheurs sont tous un peu comme ça, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
