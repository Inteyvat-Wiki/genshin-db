				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Oh, bonjour ! Quoi de beau aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "On aide Neko à sculpter une statue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Euh... Quoi ? Une statue, ici ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "J—Je vais apprendre la sculpture... sur-le-champ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "Ce sera un peu trop long...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "C'est une autre demande de Neko ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "Tu sais, je ne pense pas que tu auras du mal à trouver un artisan à la recherche de travail, vu la situation à Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "La Guilde des aventuriers a reçu pas mal de missions en ce sens et j'ai moi-même entendu dire qu'il y avait des personnes à la recherche d'un emploi à Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "Je suis d'ailleurs passée près d'un tel campement lors d'une mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "Tu peux tenter ta chance là-bas si ça te dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Haha, n'y prête pas attention. Ce n'était pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "Et puis tu sais ? Moi aussi, j'aimerais voir ce sanctuaire revenir à la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Et surtout rencontrer cette « Hibiki » dont Neko parle sans cesse. Elle doit être spéciale pour susciter une telle adoration chez ce chat, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Enfin, je parle toute seule. Va trouver cet artisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "Reste à savoir s'il sera capable de travailler la pierre... J'imagine que ce sera une question de chance, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Alors Etsuko, toi aussi, tu veux venir en aide à dame Neko, n'est-ce pas ? Ah là là, tu es vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, est-ce que le plan est terminé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "Euh, p—presque. Désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Vous n'êtes pas comme d'habitude, Etsuko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "Tu n'as pas l'habitude que je donne les informations aussi facilement, c'est ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
