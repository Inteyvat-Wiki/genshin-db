			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Vous êtes toujours là quand il faut. J'ai encore besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "Qu'y a-t-il cette fois-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "J'aimerais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "J'aimerais que vous placiez une grande pierre qui me ressemble à côté du sanctuaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "#Et où est-ce qu'on est {M#supposés}{F#supposées} trouver ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "Elle veut une statue à son effigie, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Je veux quelque chose de similaire à ce que ces renards ont sur cette île lointaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Hibiki disait qu'ils étaient nombreux sur cette île, et m'a même demandé si j'en voulais une à mon image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "Si Hibiki y a pensé, c'est que ça doit être utile. Voilà pourquoi je vous demande de m'en faire une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "Je n'y connais rien en sculpture...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Hmm, comment faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "Ah, pourquoi ne pas demander à Taisuke ? Il adore les chats et serait même partant pour apprendre la sculpture juste dans le but d'aider Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "On peut toujours demander à Taisuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "C'est vrai ! Il adore les chats, peut-être qu'il pourra nous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
