			"dialogs": [
				{
					"id": 722120301,
					"content": "*soupir* Quand est-ce que j'aurai à nouveau du travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Vous me cherchiez ? C'est à propos de quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Savez-vous sculpter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Hein ? Eh bien, c'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Toutes mes excuses, j'ai oublié de me présenter : je m'appelle Ooshima Junpei et je travaillais à Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "Après l'accident, nous avons tous été évacués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "Mais jusqu'à présent aucune nouvelle quant à la reprise du travail, alors je reste ici à attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "Vous cherchez quelqu'un pour travailler la pierre ? Eh bien, ce n'est pas ma spécialité mais je me débrouille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "De quel genre de sculpture vous avez besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Eh bien, voilà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Euh, si j'ai bien compris... Un chat qui parle veut que vous trouviez un artisan pour sculpter une statue à son effigie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "Ce n'est pas que je remette votre parole en doute, mais c'est juste un peu... spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "Si j'accepte ce travail, comment cette grande prêtresse suppléante va-t-elle me rémunérer ? Je ne vais pas travailler gratuitement quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Ne vous en faites pas, tout ira bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(Est-ce que ça ira vraiment ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "#Vous en êtes {M#sûr}{F#sûre} ? J'ai l'impression de me faire avoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Bon, tant pis. Ce n'est pas comme si je faisais quelque chose de mes mains de toute façon. Je vous suis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "J'espère vraiment que je pourrai être payé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "Nous cherchons un artisan qui sache travailler la pierre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
		{
			"id": 7221204,
