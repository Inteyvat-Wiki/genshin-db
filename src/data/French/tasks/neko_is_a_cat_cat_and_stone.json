				{
					"id": 722120601,
					"content": "Je me demande vraiment comment une chose aussi dure que la pierre peut prendre ma forme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "Est-ce que cet humain sculpteur de pierre est particulièrement puissant ? Peut-il utiliser la magie ?",
