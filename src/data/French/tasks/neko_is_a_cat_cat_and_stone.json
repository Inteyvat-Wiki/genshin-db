			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Ooshima Junpei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "#Ah, vous êtes {M#revenus}{F#revenues}. Cet humain est celui qui s'occupera de la pierre, je présume ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120402,
					"content": "C'est un artisan que nous avons engagé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "Hein ? Mais ce chat peut vraiment parler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120405,
					"content": "Miaou miaou miaou, pas de quoi être étonné. C'est si étrange de voir un chat parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120406,
					"content": "Pas besoin d'en faire tout un plat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Quoi ? Mais vous en voyez souvent des chats qui savent parler, vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120409,
					"content": "Ça ne sort pas de l'ordinaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "Je vois que nous n'avons pas la même définition du mot « ordinaire »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120411,
					"content": "Trêve de bavardage, vous n'êtes pas là pour prendre le thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120412,
					"content": "Humain sculpteur de pierre, pouvez-vous frapper la pierre et faire en sorte qu'elle me ressemble ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120413,
					"content": "Humain sculpteur de pierre ? Moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120414,
					"content": "« Frapper la pierre »... Euh, je peux essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120415,
					"content": "Vraiment ? Super, miaou miaou miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120416,
					"content": "Hum, je vois mieux de quoi il retourne... Eh bien, c'est toujours mieux que de rester à ne rien faire de ses journées. Je n'ai jamais travaillé pour un chat, alors... Je suppose qu'on discutera rémunération plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120417,
					"content": "Bon, je dois préparer certaines choses avant de commencer. Il y a beaucoup de pierres sur cette île, mais il m'en faut une bonne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120418,
					"content": "D'ailleurs, comment devrais-je vous appeler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120419,
					"content": "Je suis Neko, la grande prêtresse suppléante du Sanctuaire d'Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120420,
					"content": "Vous pouvez m'appeler comme vous voulez, humain sculpteur de pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120421,
					"content": "Oh ? Eh bien, ce sera « Madame la grande prêtresse suppléante ». Vous êtes mon employeur, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120422,
					"content": "Qu'est-ce qu'un « envoyeur » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120424,
					"content": "Euh, je vais me mettre au boulot et chercher une pierre. Attendez-moi ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120425,
					"content": "Travailler pour un chat, c'est du jamais-vu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120426,
					"content": "Monsieur Ooshima n'a plus l'air de se soucier de son paiement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120407,
					"content": "C'est juste un chat qui parle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Oui, c'est un humain sculpteur de pierre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
