						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Comme vous êtes un véritable cordon-bleu, préparez-moi un <color=#00E1FFFF>délice de viande et carottes au miel</color>, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
