					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "Les chevaliers en commandent toujours quand ils viennent manger ici en groupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Venez, je vais vous apprendre la recette du <color=#00E1FFFF>délice de viande et carottes au miel</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Vous allez nous apprendre votre recette secrète ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
