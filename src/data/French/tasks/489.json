				},
				{
					"id": 4890304,
					"content": "Un <color=#00E1FFFF>délice de viande et des carottes au miel</color> ? On en a déjà mangé avec Amber, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "C'est le plat vedette du Bon Chasseur. J'en suis fière !",
