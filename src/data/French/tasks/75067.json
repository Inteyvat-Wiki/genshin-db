					}
				]
			},
			"dialogs": [
				{
					"id": 750670301,
					"content": "Que faites-vous encore ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670302,
					"content": "Le chef de l'équipe d'aventure, le héros au masque de faucon, est déjà... Nous ne tiendrons plus très longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670303,
					"content": "#Vous devez partir immédiatement. Cet endroit est maudit, {M#brave guerrier}{F#brave guerrière}. Personne ne devrait mettre les pieds ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
