							-157.399,
							359.244,
							10151.47
						],
						"pointId": 10050
					}
				]
			},
			"dialogs": [
				{
					"id": 750670501,
					"content": "Vous feriez mieux de partir tout de suite. Si vous vous attardez ici, ce sera trop tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670502,
					"content": "Pourquoi ? Parce que... toute l'équipe d'aventure a été anéantie. Cette bête noirâtre géante... Ils se sont tous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670503,
					"content": "Ils m'ont demandé de protéger les personnes à évacuer. Du moins, de veiller à ce qu'elles quittent la ville en toute sécurité. En ce moment même, des renforts du Clan des fleurplumes sont en route...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670504,
					"content": "Je dois éliminer ces monstres maléfiques pour que les survivants puissent revenir et revoir la lumière du jour... Mais... Pourquoi suis-je ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670505,
					"content": "Ce bruit dans mes oreilles... Il devient de plus en plus fort. Je... Je dois retourner à la cascade. Oui... Retourner à la cascade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670506,
					"content": "#Brave {M#guerrier}{F#guerrière}, vous devez partir sur-le-champ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
	]
