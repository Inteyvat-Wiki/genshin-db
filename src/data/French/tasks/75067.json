							10151.47
						],
						"pointId": 10050
					}
				]
			},
			"dialogs": [
				{
					"id": 750670201,
					"content": "Ah, cet endroit est vraiment maudit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670202,
					"content": "Ne vous attardez pas trop ici. Partez, et vite... avant l'arrivée de la marée noirâtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670203,
					"content": "Oui, la marée noirâtre. Cette ombre immense arrive bientôt. Nous devons nous assurer que tout le monde soit évacué... Oui, en sécurité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
