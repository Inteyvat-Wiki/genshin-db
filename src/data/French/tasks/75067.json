					}
				]
			},
			"dialogs": [
				{
					"id": 750670101,
					"content": "#Ces créatures sont vraiment coriaces. Ce sont des monstres qui n'ont rien d'humain. Brave {M#guerrier}{F#guerrière}... Je m'appelle Quenin et je fais partie de l'équipe d'aventure. Mon devoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670102,
					"content": "#Mon devoir... est d'éliminer ces monstres. Oui, je suis un soldat d'une équipe d'aventure... Soyez {M#prudent, brave guerrier}{F#prudente, brave guerrière}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670103,
					"content": "Ces monstres... sont extrêmement rusés. Ils sont capables de prendre différentes formes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670104,
					"content": "Tous les soirs, avant de m'endormir... J'entends les sons qu'ils font depuis leurs cachettes dans ces ruines anciennes. C'est pour cette raison que je ne peux pas dormir au camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670105,
					"content": "Cet endroit grouille de monstres. Vous devez faire attention aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506702,
