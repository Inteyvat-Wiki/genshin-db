			"dialogs": [
				{
					"id": 751320101,
					"content": "#... Ah... Nos {M#héros étrangers venus}{F#héroïnes étrangères venues} de loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320102,
					"content": "Écoutez mes paroles. Je suis le corbeau de nuit qui montre la voie, mais aussi le chant d'adieu mélancolique du véritable maître de la nuit... Ou peut-être que je ne suis qu'une pensée parmi des milliards au clair de lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320103,
					"content": "Prêtez-moi l'oreille. Depuis que la rivière spirituelle souterraine s'est brisée, je ne peux vous parler qu'à travers cette apparition pour vous exhorter à vous méfier des ennemis noirâtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320104,
					"content": "Ce miroir brisé projetait autrefois des rayons lumineux. Mais maintenant, la fumée noire s'est lentement étendue à trois endroits. Souvenez-vous-en :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320105,
					"content": "Il y a d'abord le côté est. Des ombres cachées dans une fresque représentant des héros légendaires émergent peu à peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320106,
					"content": "Ensuite, il y a le côté ouest, sur une mer de mystère, où des incarnations noirâtres imitent la voix du seigneur de la nuit comme des perroquets agaçants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320107,
					"content": "Enfin, le troisième se trouve sous les falaises, où une brume sèche qui aurait déjà dû se dissiper se propage désormais à mesure que la Cité de braise redevient la source de problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320108,
					"content": "#{M#Héros venus}{F#Héroïnes venues} de loin, soyez particulièrement {M#prudents}{F#prudentes}... Faites attention aux ennemis noirâtres qui rôdent et aux forces corrodantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Volonté du graffiti mystérieux"
				}
			]
		},
		{
			"id": 7513205,
