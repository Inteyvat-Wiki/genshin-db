			},
			"dialogs": [
				{
					"id": 751320601,
					"content": "#Ah, des {M#héros venus}{F#héroïnes venues} de loin... Je peux percevoir... tout ce que vous avez accompli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320602,
					"content": "C'est incroyable ! Le pouvoir corrodé est revenu au Fief nocturne. Je peux ressentir la joie des noctâmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320603,
					"content": "#... Prenez ça comme récompense, {M#cher héros}{F#chère héroïne}. {M#Celui}{F#Celle} qui atteint la grandeur mérite d'être {M#récompensé}{F#récompensée}, tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Volonté du graffiti mystérieux"
				}
			]
		}
	]
