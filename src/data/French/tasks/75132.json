			},
			"dialogs": [
				{
					"id": 751320501,
					"content": "Faites attention aux ennemis noirâtres qui rôdent et aux forces corrodantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320502,
					"content": "#{M#Héros venus}{F#Héroïnes venues}... Y a-t-il quelque chose que vous aimeriez savoir...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320503,
					"content": "À propos des héros de cette fresque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "Ils se trouvent à l'est, à l'intérieur des grottes où les arbres brillants vacillent et se balancent. Là, comme le dit le conteur tenant les rouleaux tissés, se trouve une terreur cachée dans les histoires du passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320505,
					"content": "Peut-être que cette ombre cherche à s'échapper de tout à travers des histoires d'autrefois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320506,
					"content": "À propos de la mer de mystère...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "C'est une île cachée par la brume à l'ouest. C'était à l'origine un sanctuaire sacré pour les affaires cérémonielles où habitaient ceux qui avaient jadis signé un pacte avec les iktomisaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320508,
					"content": "Mais ensuite, la crasse et la boue y sont apparues, transformant l'endroit en un marécage noirâtre qui a été scellé et oublié... Mais hélas, notre ennemi rusé n'allait pas abandonner aussi facilement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320509,
					"content": "À propos de la brume sèche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "Cette brume souillée a été créée par la destruction de l'ancienne ville d'Ochkanatlan. Elle aurait dû être scellée... Mais le temps et la mémoire ne jouent pas en notre faveur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320511,
					"content": "Si seulement... Ah... Si seulement quelqu'un pouvait dissiper à nouveau cette brume sèche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volonté du graffiti mystérieux"
				},
				{
					"id": 751320512,
					"content": "Non, il n'y a rien que j'aimerais savoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "#Ah... N'oubliez pas d'être très... {M#prudent}{F#prudente} s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Volonté du graffiti mystérieux"
				}
			]
		},
