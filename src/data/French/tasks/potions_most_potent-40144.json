				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "Voici la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Ouah, c'est pas mal déjà ! Vous avez fait ça toute seule ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "C'était un effort collectif de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean a réussi à acquérir les fonds pour ouvrir la boutique. Albedo et Sucrose ont fourni les ingrédients et le matériel pour concocter les potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "Et la division logistique se chargera du matériel ultérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Grâce à votre aide, j'ai maintenant l'impression d'avoir un poids en moins sur les épaules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "L'Ordre de Favonius est occupé à promouvoir notre boutique depuis quelques jours. Nous pourrons ouvrir quand tout sera prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
