			"dialogs": [
				{
					"id": 401440401,
					"content": "On dirait que tout va bien. Tu as vendu ton premier lot de potions, c'est un bon début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Il faudra se tenir au courant de l'actualité du marché pour savoir quelles potions fabriquer ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "Ça signifie qu'il faut s'informer des dernières nouvelles et tendances afin d'anticiper les besoins. C'est crucial quand on fait du commerce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Ça m'a l'air bien compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Héhé, ne t'en fais pas. J'ai déjà rassemblé tout ça pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "Qu'en pensez-vous ? Des idées sur les prochaines potions à vendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Essayez de cultiver des ingrédients. Vous pouvez leur conférer des effets et des propriétés différentes grâce à un traitement bio-alchimique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "L'utilisation de différents ingrédients dans le processus de concoction va jouer sur les effets de la potion. Il y a plusieurs combinaisons à essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Voilà tout. Et si tu te mettais au travail, petit chou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
