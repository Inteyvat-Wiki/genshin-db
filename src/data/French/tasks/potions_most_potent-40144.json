					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Ah oui, un chevalier de la division logistique est arrivé. C'est elle qui se chargera de vous approvisionner en matériel, alors vous feriez mieux de faire un peu connaissance.",
					"roleType": "TALK_ROLE_NPC",
