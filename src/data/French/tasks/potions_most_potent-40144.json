			"dialogs": [
				{
					"id": 401440701,
					"content": "Bonjour, chevalier honoraire et Paimon ! Je m'appelle Freda, chevalier de la division logistique de l'Ordre de Favonius. C'est un honneur de rencontrer le chevalier honoraire et son écuyère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "Ouah, je commence à devenir célèbre aussi ? Par contre, je ne suis pas son écuyère, mais son amie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Oh, désolée ! Je me suis trompée de vocabulaire sans le vouloir. C'est parce que vos exploits sont dignes des histoires dans les romans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Enfin, vous êtes pratiquement des légendes vivantes. Je vous envie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "J'aimerais bien vivre des aventures aux quatre coins du monde comme les chevaliers dans les histoires. Ça a l'air grisant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Peut-être que vous aurez l'occasion de faire pareil un jour !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "Oui, je l'espère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Bref, nous avons des préparatifs à boucler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "La Grande Maîtresse suppléante m'a donné l'ordre de vous apporter toute l'aide dont vous aurez besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "N'hésitez pas à me solliciter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Acheter du matériel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "Je viens de recevoir un nouveau lot de matériel ! Regardez et dites-moi si quelque chose vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
