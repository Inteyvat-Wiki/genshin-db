			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "Oh, c'est mon petit chou ! Tu as du temps libre aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Tu viens consulter des livres ou pour me voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Pour vous voir, bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "Héhé, tu es toujours aussi adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Malheureusement, je suis en plein milieu d'une tâche importante. Nous prendrons le thé une autre fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Vous faites votre travail ? Ce n'est pas tous les jours qu'on voit ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Haha, tu as raison. La dernière fois que j'étais aussi assidue remonte probablement à l'époque de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Ça fait longtemps que je n'ai pas eu à réfléchir autant. C'est fatigant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Vous rédigez une thèse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Si ça t'intéresse à ce point, pourquoi ne te joindrais-tu pas à moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "Qu'en dis-tu ? Tu m'aiderais à me remémorer ma vie d'étudiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "Ne demandez pas aux autres de faire votre travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#Tu ne veux pas, {NICKNAME} ? L'occasion de travailler ensemble ne se représentera pas de sitôt... Évidemment, tu seras {M#recompensé}{F#récompensée} généreusement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Je vous écoute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Comme tu le sais sûrement, l'Ordre de Favonius mène des recherches sur l'alchimie depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Cependant, elles ont principalement été menées en laboratoire. L'alchimie est peu connue du grand public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "En d'autres termes, les recherches et les découvertes faites dans ce domaine sont éloignées du quotidien des gens, malgré leur coût faramineux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Après avoir remarqué cela, Jean a décidé de partager ce savoir avec les gens. Pour l'instant, il s'agit de leur faire connaître les potions alchimiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Ça tombe bien, parce que j'ai de l'expérience en la matière. J'ai beau être tout le temps à la bibliothèque, j'ai cependant déjà contribué à la gestion de la réserve de potions de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "La création de potions était aussi l'une de mes spécialités académiques, alors Jean a vu en moi la personne idéale pour s'en charger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Par contre, de nombreux ajustements au niveau des ingrédients et une simplification des procédés alchimiques sont nécessaires pour pouvoir créer des potions dont les gens peuvent se servir au quotidien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Ce qui était un simple projet de recherche s'est progressivement transformé en casse-tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "#Vous êtes donc en train de nous demander de vous aider avec cette recherche ? Par contre, on est loin d'êtres des {M#experts}{F#expertes} en alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Ne vous inquiétez pas, haha. Je sais exactement que ce que je vais vous demander de faire. Vous en serez capables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Les pratiques alchimiques ont évolué avec le temps, mais une absence de lien entre la recherche et le grand public subsiste. Nous avons besoin de savoir ce que l'alchimie peut faire pour servir les gens. Pour cela, il faut les interroger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Mais s'il faut faire de la recherche et recueillir l'avis des gens en même temps, nous devons faire les choses plus efficacement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "J'y ai donc réfléchi et ma solution serait d'ouvrir une boutique de potions ! Ainsi, nous pourrions raffiner nos produits et mieux connaître les besoins du public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Oh ! C'est une pierre deux coups ! Bonne idée, Lisa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Et qui de mieux pour s'occuper de cette tâche ? {NICKNAME}, notre chevalier d'élite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "De mon temps à l'Académie, les étudiants s'entraidaient dans leurs recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Je suis certaine que vous ne voudriez pas rater l'occasion de vivre cette expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Ça paraît génial quand vous le dites, mais je suis toujours persuadée que vous cherchez juste un moyen de nous refiler votre travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Allez, on va dire qu'on le fait pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Héhé, je savais que je pouvais compter sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "Quand le travail sera terminé, je veillerai à vous récompenser personnellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Tous les préparatifs devraient être terminés, alors allons à la boutique. Nous finirons de discuter là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "#Je suis toujours {M#prêt}{F#prête} pour un défi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "J'aime ton enthousiasme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Dites-m'en plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Vous travaillez sur un projet de recherche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "J'étais dans le coin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "Et tu as décidé de venir papoter avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
