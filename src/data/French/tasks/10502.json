			"dialogs": [
				{
					"id": 105020301,
					"content": "J'ai trouvé ! C'est ce coffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Tiens, même pas abîmé par des explosions ? Tant mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
