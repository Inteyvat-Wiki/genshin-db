				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "Ah, vous revoilà enfin. Je commençais à m'ennuyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "Je voulais lire pour passer le temps, mais ce bouquin est juste un journal sans intérêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "Il est tombé du sac de Klee, j'imaginais qu'il contiendrait peut-être quelque savoir ancien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "Bref. Alors, vous avez trouvé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "Oui, et en parfait état en plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "Excellente nouvelle ! Et— Attendez, pourquoi n'est-il pas verrouillé ? Et... Il est vide ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Ben... C'est parce que je l'ai emprunté pour ranger mes trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "« Emprunté » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "Ben oui... Et puisque vous vouliez le coffre, j'ai dû enlever tous mes trésors, donc il est vide maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "Tu y as mis tes affaires ?! ... Mais... Et ce qu'il y avait à l'intérieur ? Où c'est ? C'est ça qui m'intéresse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Oh, c'est ça que tu voulais ? Il fallait le dire plus tôt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "Tu ne l'as pas cassé, dis-moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "Mais non ! C'est pas cassé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "Ouf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "C'est le livre que tu tiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "C'est... Ce... Ce journal... C'est juste le journal que la vieille a écrit il y a cinquante ans ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "L'objet précieux qu'elle voulait récupérer à tout prix, c'est juste son journal avec ses histoires privées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "Je... Pas étonnant qu'elle m'a dit de ne surtout pas regarder ce que le coffre contenait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "Euh... J'ai fait une bêtise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Ah ! Tu as dis que tu voulais le coffre, pas ce qu'il y avait dedans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "J'y comprends plus rien, je m'en vais ! Salut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "Quel dénouement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Hum... Mona, si tu ne dis rien, ton maître ne le saura pas, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "Impossible : l'astromancie voit à travers le mensonge. Vous avez pu le voir plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "*soupir* Avoir autant dépensé pour venir à Mondstadt, tout ça pour n'obtenir aucun nouveau savoir ; et maintenant je ne peux plus rentrer... Comment en suis-je arrivée là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "Pauvre Mona... Peut-être que tu peux essayer d'oublier ce que tu as lu et rentrer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "Ça... Ça serait trop difficile. Et je ne peux pas non plus rester à Mondstadt, ça serait trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "... Embarrassant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Oui... Et puis, comment garder l'esprit requis pour l'astromancie au milieu de tous ces philistins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "Dans ce cas, tu n'as pas d'autre solution que de retourner voir ton maître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "N'en... N'en parlons plus ! Bon, voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "Bien, j'ai décidé de rester à Mondstadt pour le moment. Une fois que la vieille aura passé l'arme à gauche, je serai de nouveau libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "Dis donc, tu ne fais pas les choses à moitié.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "Mais comment je vais faire pour mes recherches ? ... Je n'ai même pas d'endroit où habiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "Hum, on pourrait aller demander à <color=#00E1FFFF>Catherine, à la Guilde des aventuriers</color> si elle ne peut pas aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "La Guilde des aventuriers ? Oh, en acceptant des quêtes en échange de... Tu vois ce que je veux dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Évidemment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "*soupir* Hum, merci. Je... Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "C'était l'idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "C'est ça ta solution temporaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "... Cher pour toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "En ef... Euh, non, enfin ! Ne raconte pas n'importe quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "Ça ne sert à rien d'en vouloir à Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
