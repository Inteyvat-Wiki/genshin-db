			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "À propos du problème de Mona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 105020502,
					"content": "Ah, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 105020503,
					"content": "Il y a un <color=#00E1FFFF>laboratoire de magie</color> vide ici à Mondstadt ; mais quelqu'un l'a scellé d'un sceau magique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 105020504,
					"content": "Il existe bien quelques spécialistes capables de l'enlever, mais tous ont déjà leur propre laboratoire, et aucun n'est intéressé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 105020505,
					"content": "À mon avis, si ton amie astromancienne arrive à lever le sceau, le propriétaire devrait être suffisamment reconnaissant pour lui laisser le laboratoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 105020506,
					"content": "Elle devrait pouvoir s'en sortir je pense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "D'accord ; dans ce cas, laisse-moi t'indiquer où il se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 105020507,
					"content": "Je vais l'y emmener jeter un œil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050211",
							"2"
						],
						"stepId": 1050211,
						"stateName": "QUEST_STATE_UNFINISHED"
