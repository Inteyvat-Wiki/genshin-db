			"dialogs": [
				{
					"id": 752380201,
					"content": "#Hmph... {M#Il}{F#Elle} ne perd rien pour attendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380204,
					"content": "Il est déjà si tard ? Très bien, mademoiselle Guillotin, faites attention sur la route en rentrant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "L'heure du thé est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
