			"dialogs": [
				{
					"id": 752380101,
					"content": "Le thé vous convient-il ? Ou préférez-vous que je vous serve une boisson alcoolisée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380102,
					"content": "Le thé me convient très bien. Je me sens coupable de boire pendant la journée. Mieux vaut ne pas en faire une habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Mademoiselle Guillotin, qu'est-ce qui vous amène à Natlan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Je voyage un peu partout pour rendre visite à de vieilles connaissances. Et puis, je voulais vous remercier d'avoir accepté d'aider pendant le Festival Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380105,
					"content": "Vous êtes trop polie. Vous êtes vraiment venue jusqu'ici juste pour ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Eh bien... Même si vous avez été assez aimable pour ne pas en parler la dernière fois, je sais très bien que je vous ai causé des ennuis par le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380107,
					"content": "Ah... Cette affaire avec votre subordonné ? L'incident impliquant le robot, Ineffa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Hé... La vie est étrange, pas vrai ? On peut se retrouver ami avec le patron de son ancien ennemi... Voire même se retrouver à travailler pour cette personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "J'espère que vous accepterez ce petit geste en guise d'excuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380110,
					"content": "C'est... une édition limitée ? Non... une édition collector ! Et c'est exactement le genre que je préfère ! Comment avez-vous su...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#J'ai demandé à {NICKNAME} ce que vous pourriez aimer, {M#il}{F#elle} connaît bien vos préférences en matière de lecture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Pourquoi je me sens à la fois heureuse et gênée...?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "#(Même {M#s'il}{F#si elle} sait que j'aime ce genre de choses, ça ne veut pas dire qu'il faut le crier sur tous les toits... Je préférerais qu'{M#il}{F#elle} m'offre un cadeau {M#lui}{F#elle}-même !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Ça vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380116,
					"content": "Ah... Merci beaucoup. Mademoiselle Guillotin, vous êtes vraiment trop gentille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Si cela vous plaît, je pourrai vous en apporter d'autres la prochaine fois. Bien sûr, il faudra sans doute que je demande à {NICKNAME} de m'accompagner pour les choisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380118,
					"content": "#Vous accompagner ?! Vous êtes {M#allés}{F#allées} le choisir ensemble à la librairie ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "#Oui, {M#il}{F#elle} a vraiment pris le temps de m'aider à choisir ce livre. La prochaine fois, peut-être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380120,
					"content": "Il ne doit pas y avoir de prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Euh... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
