			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "#Comment ça se passe, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300202,
					"content": "Ça devrait aller maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "Waouh, tu es incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300204,
					"content": "Papa a dit qu'il embaucherait des gens pour nous protéger pendant notre voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300205,
					"content": "#J'espère qu'ils seront aussi doués que toi, {M#voyageur}{F#voyageuse}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300206,
					"content": "Est-ce que ça veut dire qu'on peut continuer d'extraire du minerai et à fabriquer des objets avec ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300207,
					"content": "Hahaha, bien sûr ! Donne-moi juste le temps de me préparer. Je vais récupérer ces minerais et je me remets au travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300208,
					"content": "Cela dit, il y a quand même une limite à ce que je peux transporter. J'espère qu'il n'y aura pas de monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maître Zhang"
				}
			]
		},
