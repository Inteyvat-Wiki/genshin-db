			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Meng",
					"Maître Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Hein ? Alors comme ça, ces deux minerais ne sont pas les mêmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300102,
					"content": "Bien sûr que non. La qualité et le prix de ce que l'on peut forger à partir de l'un ou de l'autre sont complètement différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300103,
					"content": "Euh, mais... Il n'en reste pas grand-chose, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300104,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300105,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#Salut, {M#voyageur}{F#voyageuse} ! J'aide papa à passer en revue le matériel de forge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300107,
					"content": "C'est le meilleur des forgerons ! Il a même dit qu'il me ferait une petite épée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300108,
					"content": "Mais il dit qu'on n'avait pas assez de matières premières ces derniers temps, donc il va y avoir du retard dans les commandes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300109,
					"content": "Quant à savoir quand il pourra faire mon épée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300110,
					"content": "*soupir* Eh bien, ce n'est pas de ma faute. On a été très occupés ces derniers temps, du coup, on n'a quasiment plus de minerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300111,
					"content": "Les zones où le minerai est le plus abondant sont celles qui regorgent de monstres. Alors, je n'ose pas trop y aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300112,
					"content": "Tout ce que je peux faire, c'est d'attendre que ça passe. Ensuite, je pourrai demander à un aventurier de m'accompagner jusqu'à une zone où je peux miner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300113,
					"content": "Mais ce sera quand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300114,
					"content": "#D'ailleurs, {M#voyageur}{F#voyageuse}, j'ai entendu dire que tu te débrouillais plutôt bien avec les monstres. C'est vrai ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300115,
					"content": "Si c'est le cas, tu pourrais peut-être m'aider ? S'il te plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300116,
					"content": "Haha, très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous allez voir ce qu'il se passe là-bas ? Dans ce cas, laissez-moi marquer les endroits où j'ai l'habitude de miner sur votre carte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300119,
					"content": "#Très bien, ça devrait aller comme ça. Soyez {M#prudent}{F#prudente} quand vous serez là-bas. Ça grouille de monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Maître Zhang"
				},
				{
					"id": 210300120,
					"content": "#Je compte sur toi, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210300117,
					"content": "Je vais voir ce que je peux faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
