						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "Merci ! Prenez cette récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "Grâce à vos efforts, la lanterne Mingxiao n'en sera que plus colorée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Puisque vous serez là pendant tout le festival, n'oubliez pas de jeter un œil sur l'avancement de la lanterne de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "Le chantier sur le port va devenir un spectacle de plus en plus impressionnant à mesure que la construction avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Cool ~ Ça te dit qu'on aille jeter un coup d'œil, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
