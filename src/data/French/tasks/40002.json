						400021502
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021502,
					"content": "#Nous sommes {M#venus}{F#venues} vous signaler une activité suspecte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "On a vu un gars super louche traîner à côté des matériaux de construction de la lanterne Mingxiao !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021504,
					"content": "Il faut faire quelque chose pour le chop suey Zhongyuan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021505,
					"content": "C'est effectivement très grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021506,
					"content": "N'est-ce pas ?! Il faut sauver la cuisine liyuéenne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021507,
					"content": "Hum, nous ne parlons visiblement pas de la chose. Mais vous n'avez pas tort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021508,
					"content": "Je prends votre déclaration en compte et en informerai mes supérieurs dans les meilleurs délais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021509,
					"content": "Merci d'avoir pris la peine de nous informer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021510,
					"content": "Nous nous assurerons que ça sera réglé très vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
