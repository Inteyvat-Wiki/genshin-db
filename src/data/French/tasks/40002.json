			"dialogs": [
				{
					"id": 400020201,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Ça tombe à pic, je voulais vous parler d'autre chose. Cette fois-ci, il s'agit d'un travail rémunéré. Ça vous dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "Ça m'intéresse tant que je ne travaille pas gratuitement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "Haha, génial ! Je vous explique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "J'aurais besoin de deux variétés de plaustrites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "Dans un premier temps, il faudrait que vous trouviez de l'azurite. Il y en a dans la partie nord des Monts Tienheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "Lorsque l'azurite se fait piéger dans les racines de la végétation, elle produit parfois un fruit pompon, aux graines flottantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "Puis, j'aimerais de la vermillionite. C'est une pierre très dangereuse pour les humains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "Les Chasseurs des ruines des plaines Guili, qui ont perdu le pouvoir de voler, utilisent la vermillionite en remplacement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "De l'azurite et de la vermillionite ! Reçu 5/5 !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(Ce ne sont que des plaustrites bleues et rouges... Les marchands leur ont donné des noms compliqués juste pour impressionner les clients...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "Tout à fait, merci de les ramener. Courage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
