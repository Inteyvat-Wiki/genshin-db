						400021002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021002,
					"content": "Ça serait dangereux de laisser un individu louche en liberté lors de cet événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021003,
					"content": "Surtout s'il a touché au matériel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021401,
					"content": "On devrait en parler aux autorités ! En route pour le Bureau des Affaires Civiles de Liyue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021406,
					"content": "Tu m'as l'air bien inquiète, Paimon... Pourquoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Tant de Liyuéens ont contribué à la construction de cette lanterne ! Je ne veux pas que leur travail parte en fumée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021408,
					"content": "Tu peux me dire la vérité, tu sais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "Le chop suey Zhongyuan près du port est vraiment sympa, on n'oublie pas le plat une fois qu'on y a touché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021410,
					"content": "Je vois qu'ils t'ont eue avec leur publicité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Héhéhé.",
					"roleType": "TALK_ROLE_NPC",
