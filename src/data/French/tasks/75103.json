				]
			},
			"dialogs": [
				{
					"id": 751030101,
					"content": "Ouah, il y a tellement de poissons ! Que faites-vous tous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Hmm ? Oh ! Bonjour, {M#grand monsieur}{F#grande madame} aux cheveux blonds ! Et à vous... Sa petite sœur aux cheveux blancs...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Iwai et moi attendons que les oiseaux fluxeaux reviennent sur la terre ferme. De toute façon, ce n'est pas comme si on avait grand-chose d'autre à faire pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Vous les attendez ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Raouh, raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Allez, Iwai. Tu es gentil, pas vrai ? Sois patient, ça ne sert à rien de s'agiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Au début, on voulait jouer ici. Personne ne vient dans le coin, à part oncle Ronko, alors c'est notre base secrète ! Ou quelque chose du genre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Mais on ne pensait pas que ces oiseaux nous couperaient l'herbe sous le pied aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "C'est pour ça que j'ai préparé ces poissons pour les attirer. Les oiseaux fluxeaux les adorent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Ils n'ont pas l'air très emballés, pourtant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "C'est vrai. Peut-être qu'ils n'arrivent pas à sentir le poisson parce qu'on est trop loin ? Comment pourrait-on faire pour les faire venir sur le rivage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "Si oncle Ronko était là, il dirait un truc du style : <color=#00E1FFFF>« Il n'y a qu'à les bousculer jusqu'au rivage, non ? »</color>... Iwai et moi, on n'a pas la force physique pour ça. C'est nous qui nous ferions bousculer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hmm... Et si on essayait, {NICKNAME} ? En les faisant venir sur le rivage, ils pourraient sentir le poisson !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Je vois... Paimon, tu es donc une sous-espèce d'oiseau fluxeau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Rond et qui aime le poisson... Je vois ce que vous voulez dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Mmm ! Mmmm !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "N'importe quoi ! Bref, pour en revenir au sujet, vous n'avez attiré aucun oiseau fluxeau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
