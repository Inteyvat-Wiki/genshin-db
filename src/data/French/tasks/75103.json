			"dialogs": [
				{
					"id": 751030801,
					"content": "Ouah, ça en fait des poissons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "Attendez, n'y touchez pas ! C'est pour attirer les oiseaux fluxeaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Oui ! Iwai et moi attendons que les oiseaux fluxeaux reviennent sur la terre ferme. De toute façon, ce n'est pas comme si on avait grand-chose d'autre à faire pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Raouh, raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Allez, Iwai. Tu es gentil, pas vrai ? Sois patient, ça ne sert à rien de s'agiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "Au début, on voulait jouer ici. Personne ne vient dans le coin, à part oncle Ronko, alors c'est notre base secrète... ou quelque chose du genre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Mais on ne pensait pas que ces oiseaux nous couperaient l'herbe sous le pied aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "C'est pour ça que j'ai préparé ces poissons pour les attirer. Les oiseaux fluxeaux les adorent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Ils n'ont pas l'air très emballés, pourtant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "C'est vrai. Peut-être qu'ils n'arrivent pas à sentir le poisson parce qu'on est trop loin ? Comment pourrait-on faire pour les faire venir sur le rivage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "Si oncle Ronko était là, il dirait un truc du style : <color=#00E1FFFF>« Il n'y a qu'à les bousculer jusqu'au rivage, non ? »</color>... Iwai et moi, on n'a pas la force physique pour ça. C'est nous qui nous ferions bousculer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Hmm... Et si on essayait, {NICKNAME} ? En les faisant venir sur le rivage, ils pourraient sentir le poisson !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Je vois... Paimon, tu es donc une sous-espèce d'oiseau fluxeau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Rond et qui aime le poisson... Je vois ce que vous voulez dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Mmm ! Mmmm !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "N'importe quoi ! Bref, pour en revenir au sujet, vous n'avez attiré aucun oiseau fluxeau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
