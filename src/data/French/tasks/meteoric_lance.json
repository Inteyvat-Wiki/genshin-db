			"dialogs": [
				{
					"id": 740742001,
					"content": "Vous examinez soigneusement le haut du mécanisme sans rien trouver.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740742002
					]
				},
				{
					"id": 740742002,
					"content": "Il n'y a toujours rien ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742003,
					"content": "Caterpillar, pouvez-vous nous dire ce que nous cherchons exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742004
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740742004,
					"content": "Nous cherchons des matériaux pour forger la sainte lame du Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742005,
					"content": "En se basant sur l'ésotérisme du royaume souterrain et de l'ancienne Fontaine, l'Ordo Narzissenkreuz a recréé les quatre substances imaginaires nécessaires dans le monde matériel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742006
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742006,
					"content": "Je n'ai rien compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742007
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742007,
					"content": "Ces choses mystiques sont expérientielles. Elles sont sans doute encore plus extraordinaires que les pouvoirs élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742008,
					"content": "Il y a quelques décennies, j'ai enregistré le manuel d'introduction au Spantamad de l'Académie de Sumeru dans ma mémoire. Les pouvoirs élémentaires n'ont rien de bien mystérieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742009
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742009,
					"content": "Vraiment ? Bref, la conclusion est qu'il s'agit de l'intersection des anciennes traditions de Fontaine et des technologies de l'ancien royaume souterrain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742010
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742010,
					"content": "Les quatre substances, soit la mémoire, le souhait, l'âme et la personnalité, sont apparues dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742011
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742011,
					"content": "Pour éviter toute ambiguïté, appelons-les : bloc de la mémoire, bloc du souhait, bloc de l'âme et bloc de la personnalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742012,
					"content": "Pourquoi ces éléments servent-ils à forger la sainte lame ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742013,
					"content": "Dans l'ésotérisme de l'Ordo Narzissenkreuz, le temple est l'incarnation de l'univers, les membres de l'Ordo sont les représentants des dieux et l'huile sainte est la volonté raffinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742014,
					"content": "La sainte lame est la « raison » qui brise tout. Elle doit naître de la volonté d'un humain complet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742015,
					"content": "C'est tellement ésotérique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742016
					]
				},
				{
					"id": 740742016,
					"content": "C'est ça, l'ésotérisme. Des choses similaires peuvent être facilement associées les unes aux autres. Quand ça devient de la magie, elle transforme la fiction en réalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742017
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742017,
					"content": "Bref, dépêchons-nous d'aller à l'endroit suivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
