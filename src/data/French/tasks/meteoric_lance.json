			"dialogs": [
				{
					"id": 740740101,
					"content": "... Attendez, tu ne devrais pas être plus préoccupé par le fait qu'il y ait une personne par terre dans ton champ de vision ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Hein ? Ouah ! Qu'est-ce qui se passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Je suis désolé, mademoiselle. J'ai accordé la priorité à la recherche de la stèle. Laissez-moi faire un scan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "... Je suis vraiment désolé, mademoiselle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Il est encore en vie, mais le souffle de la vie s'est échappé de ses orifices. Je reconnais cette méthode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "Ah, je n'ose pas regarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Dépêchons-nous d'aller chercher de l'aide ! On ne peut pas le laisser comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Ensemble, vous avez amené cet homme inconscient au Port de Lumidouce.\\nLes gens du port l'ont immédiatement emmené se faire soigner.\\nMaintenant qu'il est entre de bonnes mains, vous reprenez là où vous vous en étiez arrêtés.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Bon, jetons un coup d'œil à la stèle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "« Ici se trouve l'Orthant du souhait, le Temple du souhait, la Salle du souhait. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "« Souvent contradictoire »... « Né en un instant, à vos côtés pendant votre long sommeil, toujours unis »... « Souillé par le fruit du péché »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Encore une énigme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "Pourquoi faire une chose aussi terrible ici... Et est-ce qu'il y a un rapport avec l'énigme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "#Parce que les habitants de Fontaine sont des «{NON_BREAK_SPACE}pécheurs », des êtres « entachés par le péché originel ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "La réponse est donc « la vie ». Je l'avais déjà devinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "Êtes-vous sûr que c'est la réponse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Je connais le système de symboles linguistiques de l'Ordo Narzissenkreuz sur le bout des doigts. C'est la réponse, sans surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Bon, nous devons nous dépêcher. Le temps presse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
