			"dialogs": [
				{
					"id": 740741901,
					"content": "Vous examinez soigneusement le haut du mécanisme sans rien trouver.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "Il n'y a rien ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741903,
					"content": "Non, on dirait que quelqu'un a déjà pris ce qui se trouvait ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741904,
					"content": "Dans ce cas, notre plan est un échec ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741905,
					"content": "La naissance de la « raison » nécessite l'unification des quatre Orthants. Du moment que nous pouvons obtenir ceux qui restent, nous aurons peut-être une chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741906,
					"content": "Dans ce cas, dépêchons-nous d'aller à l'endroit suivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
