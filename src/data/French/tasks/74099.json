			"dialogs": [
				{
					"id": 740990101,
					"content": "Attraper des monstres au lieu de poissons...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Ah ! Maintenant que j'y réfléchis... C'était assez particulier comme expérience d'attirer des monstres au lieu de poissons avec mon appât !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Je n'ai pas vraiment peur des monstres, car j'ai l'habitude de faire le chemin entre l'Institut et la Cour de Fontaine tout seul. Je me suis battue beaucoup de fois contre des bandits et j'en ressortais victorieux la plupart du temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Mais maintenant, je suis la directrice de l'Association des pêcheurs, alors je dois agir en tant que tel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Si j'effraie les poissons ou que je cause des problèmes aux autres pêcheurs, ce serait trahir les attentes que les gens pourraient avoir de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "C'est pour cette raison que je dois agir de manière réfléchie et prudente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		}
	]
