			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790000401,
					"content": "Trouvé ! Trésor, trésor... Je me demande ce qu'on va trouver dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000402,
					"content": "Hein ? Il y a un verrou dessus, avec un code... Il va falloir trouver la combinaison pour l'ouvrir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000403,
					"content": "On n'a qu'à casser la serrure, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "Attends ! Et si on casse ce qu'il y a à l'intérieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000406,
					"content": "Trouvons plutôt un moyen de la débloquer, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000410,
					"content": "Mais puisque cette boîte contient un héritage familial et qu'elle est fermée par un code...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000411,
					"content": "Cela doit vouloir dire que la personne qui l'a verrouillée pense que la combinaison est suffisamment facile pour pouvoir la retenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000412,
					"content": "On dirait bien que notre seul espoir, ce sont ces conques qui capturent les sons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000413,
					"content": "Écoutons à nouveau ces conques. Espérons qu'elles nous donnent des indices sur la combinaison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000404,
					"content": "Il faut trouver un moyen de débloquer ce verrou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "Mais je ne vois pas de stèles, de fresques, de notes, de gravures ou de carnets à proximité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000408,
					"content": "Il y a également pénurie de chercheurs, de Pilleurs de trésors et d'aventuriers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Oui. Hmm... C'est du jamais-vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
