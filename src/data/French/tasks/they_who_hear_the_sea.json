			},
			"dialogs": [
				{
					"id": 790000301,
					"content": "Oh, le coffre ne s'est pas ouvert... On dirait qu'on n'a pas la bonne combinaison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000302
					],
					"speakerTitle": "Coffre verrouillé"
				},
				{
					"id": 790000302,
					"content": "Écoutons attentivement les conques. Peut-être qu'on y trouvera des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000302
					],
