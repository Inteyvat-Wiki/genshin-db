			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Ça ne va pas me servir à grand-chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "Excuse-moi, tu n'aurais pas vu une boîte par ici par hasard ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Une boîte ? Si, justement, je viens d'en trouver une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "Je l'ai déjà ouverte, elle ne contient que des bons de commande... Une sacrée commande même, si tu veux mon avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "Je me demande bien qui est derrière, et combien cette personne serait disposée à payer pour la récupérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "C'est-à-dire...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Haha, pas la peine de me regarder comme ça, je plaisante ! Détends-toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "D'après ce que j'ai vu, ce n'est pas une petite commande ; je me demande juste qui à Liyue peut se permettre de débourser ce montant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "Ne t'inquiète pas, je ne suis pas du genre à chercher les ennuis, et je sais où s'arrête ma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "Mais... J'ai quand même pris soin de cette boîte, et tu voudrais partir comme ça ? C'est un peu limite, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "Et si on faisait un échange ? Qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "Donne-moi trois jades noctiluques, et la boîte et tous ces bons sont à toi, ça marche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "Comparé à la valeur de ce qu'il y a là-dessus, trois jades noctiluques, c'est pas grand-chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Alors retrouve-moi une fois trouvés les jades, je t'attendrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "... De quel genre de commande s'agit-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Comment ça, tu l'ignores ? Ah, tu n'es qu'un sous-fifre, c'est ça ? Remarque, ce n'est pas plus mal si tu veux mon avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "Crois-en mon expérience : moins on en demande sur ce genre d'affaires, et mieux ça vaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "Bien, va chercher les jades et je te donnerai les bons de commande ; et tu n'auras plus qu'à les redonner à celui qui t'emploie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "Un marché simple et rapide, rien de bien compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
