				"points": []
			},
			"dialogs": [
				{
					"id": 210240901,
					"content": "Alors ? Vous avez retrouvé mes bons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "On les a tous récupérés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "#Ah, merci mes {M#amis}{F#amies}, merci. Tout ça n'aura été qu'une grosse frayeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Je n'ose vraiment pas imaginer la colère de mon employeur si j'étais rentré les mains vides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "... Vous vous demandez quel genre de commerce peut mettre un homme dans tous ses états.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Je m'excuse, mais je crains de ne pouvoir vous le dire. C'est... confidentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Tenez, acceptez ce paiment, je vous... Attendez. La boîte a été ouverte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "... Et la femme a regardé ce qu'elle contenait ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Que les Archons aient pitié de moi. Je... Excusez-moi, il faut que je... Je dois retourner en informer mon employeur au plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Soyez sans crainte, je ne vous impliquerai pas. Je sais ce que vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Hum. Il faut que je trouve le moyen de le joindre, vite... Excusez-moi. Je vous laisse retourner à vos affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
