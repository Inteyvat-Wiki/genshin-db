					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "Et voilà ! « Aventures en montagne et en mer » de Léonard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141402,
					"content": "Mais il manque des pages ! Je ne comprends rien du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141403,
					"content": "Nous sommes peut-être juste en train de perdre notre temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141404,
					"content": "Ne sois pas si pessimiste, ramenons ça à Mona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "Tu as raison, elle saura quoi faire avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
