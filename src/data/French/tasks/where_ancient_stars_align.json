				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "Tu t'es démenée comme jamais pendant ce combat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141502,
					"content": "C'est ce qui arrive quand on me cherche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141503,
					"content": "Tu es trop forte, Mona !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "Tout le monde le sait ! Pas vrai, Paimon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141505,
					"content": "Oui ! Sans toi, ces gars nous auraient donné du fil à retordre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141506,
					"content": "Vous avez entendu ça, imbécile d'Exécuteur ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141507,
					"content": "Je ne pense pas qu'il mentait tout à l'heure. En astromancie, j'utilise souvent la notion de « ciel mensonger »... Je ne pensais pas que cette formule avait une signification particulière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141508,
					"content": "#Ahem, retournons-en à nos Brutocollinus. Nous avons du travail à terminer, mes {F#amies}{M#amis}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141509,
					"content": "La <color=#00E1FFFF>météorite spéciale</color> ne doit pas se trouver bien loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
