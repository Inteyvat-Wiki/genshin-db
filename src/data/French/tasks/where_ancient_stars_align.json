			"trigger": {
				"objectNames": [
					"Mona",
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "Oh, Fischl nous attend ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140102,
					"content": "Ma maîtresse a le cœur lourd, mais le temps est venu pour elle de vous faire une annonce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140103,
					"content": "Mes loyaux serviteurs, nous avons affronté tant de défis ensemble... mais je ne crains qu'il soit temps pour nos chemins de se séparer. Le vent chante les louanges de votre bravoure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140104,
					"content": "Attendez un peu, vous nous abandonnez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140105,
					"content": "Devez-vous vraiment partir, Fischl ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "Depuis l'apparition de cette météorite géante, le nombres d'endormis ne cesse d'augmenter. Bien que les soldats fassent tout leur possible pour gérer la situation, des demandes de renfort affluent de toutes les zones touchées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140107,
					"content": "Ma maîtresse et moi-même avons décidé de nous occuper des victimes des météorites à la place des soldats. Nous laissons donc l'enquête entre vos mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140108,
					"content": "#Au revoir, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140109,
					"content": "J'ai apprécié les discussions que nous avons eues, car vous savez écouter les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140110,
					"content": "En général, les aventuriers de la Guilde m'adressent la parole seulement quand ils veulent entendre les rapports de reconnaissance d'Oz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140111,
					"content": "Ce petit bout de chemin que nous avons fait ensemble était une grande aventure. Je suis désolée d'y mettre fin aussi soudainement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140112,
					"content": "Princesse ? Vous parlez un peu différemment de d'habitude...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140113,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140114,
					"content": "(Ah, mais qu'est-ce que je fais ? Je ne suis plus dans mon personnage...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140115,
					"content": "Euh, ma maîtresse veut dire que... que tous les mystères du monde se dévoileront devant votre grand courage et votre profonde sagesse qui dépassent de loin ceux du commun des mortels !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140116,
					"content": "Et c'est votre « traduction » qui sonne bizarre maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140117,
					"content": "Ahem ! Elle est tout simplement convaincue que vous saurez résoudre cette affaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140118,
					"content": "En effet, Oz a tout résumé. Mes chers vassaux, le preux chevalier du châtiment vous guidera telle la lumière à travers cette sombre épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140119,
					"content": "Nous, des « vassaux » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140120,
					"content": "Merci à vous, Fischl et Oz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "Nous nous reverrons un jour. Lorsque nous en aurons fini avec cette affaire, je vous propose de fêter ça ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140122,
					"content": "Bon, nous voilà avec deux personnes en moins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140123,
					"content": "Ne nous laissons pas abattre, car j'ai trouvé un autre indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140124,
					"content": "J'ai prélevé un peu de poussière sur la météorite géante pour conduire une autre séance d'hydromancie et ça m'a permis d'y voir plus clair !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140125,
					"content": "Ces météorites datent d'il y a des centaines, voire des milliers d'années. Ce Léonard doit avoir vécu il y a longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140126,
					"content": "Les météorites transmettent encore sa volonté. Elle est encore intacte malgré tout ce temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140127,
					"content": "Son ambition était si grande qu'il rêvait d'escalader une montagne les plus élevées qui existait... C'était un aventurier, j'en mettrais ma main à couper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140128,
					"content": "Un aventurier ? Mais ça explique tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140129,
					"content": "Le temps ne joue pas en notre faveur... Il faudrait qu'on frappe à la source du problème pour pouvoir progresser dans notre enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140130,
					"content": "Je suis d'accord ! Concentrons-nous sur ce Léonard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140131,
					"content": "Oui, si les météorites sont imprégnées de sa volonté, alors Fischl avait raison : nous avons affaire à une malédiction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140132,
					"content": "J'ai du mal à croire qu'elle ait réussi à deviner juste... Hum, une astromancienne aussi réputée que moi ne devrait pas dire ce genre de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140133,
					"content": "Bref, nous devons donc briser cette malédiction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140134,
					"content": "En route, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "Je te suis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140136,
					"content": "Léonard était a priori un aventurier, alors on pourrait commencer par interroger la <color=#00E1FFFF>Guilde des aventuriers</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
