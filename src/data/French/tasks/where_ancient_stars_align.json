			"dialogs": [
				{
					"id": 411140801,
					"content": "Léonard... Léonard... Ah, ça y est, je te tiens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140802,
					"content": "Ça dit que les ouvrages de Léonard sont dans <color=#00E1FFFF>la section nord-ouest</color> du <color=#00E1FFFF>rez-de-chaussée</color> de la bibliothèque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140803,
					"content": "Section nord-ouest... Je crois que c'est là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
