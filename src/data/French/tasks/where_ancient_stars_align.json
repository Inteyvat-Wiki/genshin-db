			"dialogs": [
				{
					"id": 411140701,
					"content": "Plusieurs de nos membres portaient ce prénom alors je suis incapable de savoir duquel vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411140702,
					"content": "Le nom me dit quelque chose... Il me semble avoir vu un livre écrit par quelqu'un de ce nom à la bibliothèque. Tu pourrais y faire un tour pour voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411140703,
					"content": "Par contre, il me semble avoir vu un livre écrit par quelqu'un de ce nom à la <color=#00E1FFFF>bibliothèque</color>. Vous pourriez y faire un tour pour voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				}
			]
		},
		{
			"id": 4111408,
