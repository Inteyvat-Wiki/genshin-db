				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "On a trouvé un livre écrit par Léonard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140902,
					"content": "Montrez-moi ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140903,
					"content": "Il est en piteux état et son contenu est illisible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "Je savais que ça allait arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140905,
					"content": "Un astromancien de seconde zone aurait abandonné en voyant ça, mais pas moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140906,
					"content": "Je suis un prodige de l'astromancie ! Rien ne peut m'arrêter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140907,
					"content": "Je n'ai qu'à déduire les morceaux manquants grâce à mon astrolabe et combler les trous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140908,
					"content": "Pfiou ! J'ai enfin terminé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140909,
					"content": "Alors ? Qu'est-ce que ça raconte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140910,
					"content": "Comme je l'avais deviné, Léonard était bien un aventurier qui a vécu il y a deux mille ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140911,
					"content": "Son rêve était d'atteindre le sommet d'une montagne appelée le Mont Pilos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140912,
					"content": "Deux mille ans ? La vache !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140913,
					"content": "Pour une raison qui m'échappe encore, sa constellation a été invoquée sur terre. Et mon petit doigt me dit que les Fatui y sont pour quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140914,
					"content": "Tu as certainement raison. Les Fatui sont toujours mêlés à des affaires suspectes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140915,
					"content": "De l'énergie élémentaire émane des météorites et fait dormir les gens par le biais d'une méthode qui ressemble à de l'hypnose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140916,
					"content": "Si mes déductions sont exactes, il y aurait donc une météorite spéciale parmi toutes les autres qui abriterait l'esprit de Léonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140917,
					"content": "Où serait-elle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "Si j'étais Léonard, je m'assurerais que cette météorite soit au sommet de la montagne que je n'ai jamais pu atteindre de mon vivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140919,
					"content": "D'après toi, elle devrait être sur le Mont Pilos... Où c'est ? Je n'en ai jamais entendu parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140920,
					"content": "C'est aussi la première fois que j'en entends parler. J'ai comparé une carte du livre à une carte actuelle de Mondstadt et apparemment cette montagne n'existe plus de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140921,
					"content": "Quoi ? Elle a disparu ? Mais comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140922,
					"content": "J'ai lu que Barbatos, l'Archon Anémo dispersa la neige, puis refaçonna Mondstadt et ses environs grâce à ses pouvoirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140923,
					"content": "Les montagnes qui existaient alors ont été remplacées par un océan. Mais une montagne aussi élevée n'a pas pu complètement disparaître sous l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140924,
					"content": "Le sommet du Mont Pilos n'a pas été submergé et de nos jours, nous connaissons cet endroit sous le nom de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140925,
					"content": "... <color=#00E1FFFF>Récif de Musk</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111411",
							"2"
						],
						"stepId": 4111411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scaramuccia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "Ah bon ? Eh bah ! Ce n'est plus ce que c'était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141102,
					"content": "Hé, on dirait que quelqu'un est déjà là... C'est un site touristique ? Je n'étais pas au courant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141103,
					"content": "Ah, mais c'est vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141104,
					"content": "Oh. Encore vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141105,
					"content": "Comment avez-vous fait pour trouver cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "Vu son état, on dirait qu'il était dans ce rêve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141108,
					"content": "Il a réussi à s'extirper du rêve par ses propres moyens ? Comment cela est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141109,
					"content": "Hmph. Vous en êtes incapables, mais ça ne veut pas dire que je le suis aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141110,
					"content": "Vous arrivez trop tard, j'ai terminé ce que j'avais à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141111,
					"content": "J'en étais sûre ! C'est encore un coup des Fatui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141112,
					"content": "Inutile d'avoir peur, je n'ai pas le temps de m'amuser avec vous aujourd'hui. Je vous retrouverai quand le moment sera venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141113,
					"content": "Attendez ! Quel est votre objectif au juste ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "Vous vous êtes introduit dans le rêve de toutes les victimes, n'est-ce pas ? Qu'avez-vous appris sur Léonard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141115,
					"content": "Léonard ? Écoutez, j'ai autre chose à faire que de m'occuper de ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141116,
					"content": "J'ai découvert quelque chose de bien plus important... et de bien plus effrayant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141117,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141118,
					"content": "Dites-nous ce que vous savez !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "Le ciel et les étoiles ne sont qu'un vaste mensonge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141120,
					"content": "Qu'est-ce que vous dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141121,
					"content": "Vous ne seriez pas en train de commencer un débat d'astromancie avec Mona par hasard ? J'ose espérer que vous avez quand même un meilleur sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141122,
					"content": "Le ciel et les étoiles sont juste là au-dessus de nos têtes. Vous ne pouvez pas nier leur existence ! Personne ne vous croira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141123,
					"content": "Mouhahaha !! Que vous êtes naïfs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141124,
					"content": "Je ne vous en veux pas, moi aussi, j'y croyais jusqu'à tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141125,
					"content": "Vous voulez dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141126,
					"content": "Si vous voulez bien m'excuser, je dois vous fausser compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141127,
					"content": "Ce Pierro... Qu'avait-il en tête ? Me confier une mission pareille sans me prévenir des implications... Essayait-il de me faire une frayeur ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141128,
					"content": "Bien, je m'en vais donc à la recherche de la vérité. À la prochaine, les incapables !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141106,
					"content": "Vous venez de vous réveiller ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
