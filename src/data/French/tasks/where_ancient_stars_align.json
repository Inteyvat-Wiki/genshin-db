			"dialogs": [
				{
					"id": 411141601,
					"content": "Ah, la voilà ! Elle est vraiment différente des autres ! J'ai l'impression qu'elle est plus brillante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141602,
					"content": "Cette météorite dégage une quantité d'énergie élémentaire extraordinaire. Je sens qu'elle abrite aussi une volonté humaine inébranlable en elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141603,
					"content": "On doit vraiment la démolir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "Oui, sinon les victimes ne se réveilleront jamais... Cette météorite est l'origine de tout le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141605,
					"content": "#Allez, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141606,
					"content": "Oh, c'était quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141607,
					"content": "C'était un alpiniste ambitieux, déterminé à atteindre des sommets.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "Qui aurait cru qu'une volonté humaine serait vivante pendant des millénaires dans le ciel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141610,
					"content": "L'astromancie ne finit jamais de me surprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141611,
					"content": "... Qu'est-ce qui vous fait dire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141612,
					"content": "Le pouvoir de communiquer avec les étoiles nous dévoile tous les secrets de l'histoire humaine... Mais ce n'est pas à la portée de tous, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141613,
					"content": "Ton aide n'en a été que plus précieuse, Mona !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "P—Pas de quoi, voyons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141615,
					"content": "D'ailleurs, Fischl a une façon de s'exprimer très... particulière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141616,
					"content": "Je comprends ce que tu veux dire ! Elle est tellement... Hum, comment dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141617,
					"content": "Pleine de mystères ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "On peut dire ce qu'on veut, mais elle avait raison sur toute la ligne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141620,
					"content": "Peut-être qu'elle fait partie de ces gens qui parviennent à la bonne solution, mais de la mauvaise façon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141621,
					"content": "Oui, si ça se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141622,
					"content": "N'empêche que la chose qui m'aura la plus étonnée dans cette aventure est le fait que le Mont Pilos soit devenu un espèce d'îlot riquiqui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141623,
					"content": "Cette montagne qui existait autrefois est aujourd'hui un îlot en pleine mer où presque tout le monde peut se rendre en bateau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141624,
					"content": "Tout le monde peut atteindre son sommet maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141625,
					"content": "Oui, n'importe qui peut le faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "Vous pensez que Léonard serait ravi ? À mon avis, l'état actuel du Mont Pilos le choquerait sûrement... Mais grâce à Barbatos, les humains peuvent planer de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141627,
					"content": "Grâce à ça, ils peuvent désormais voyager plus haut et plus loin qu'ils ne pouvaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141628,
					"content": "(J'espère que vous êtes heureux, Léonard...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "Tout le monde devrait se réveiller maintenant que nous avons détruit cette météorite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141630,
					"content": "Notre mission pour la Guilde des aventuriers touche aussi à sa fin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141631,
					"content": "Espérons que tout le monde sera bientôt remis sur pied.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "Pleine d'imagination ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "Sa volonté était si forte qu'il voulait la transmettre à d'autres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}