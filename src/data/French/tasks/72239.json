			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "Après le coucher du soleil, les ténèbres se réveillent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "Mais sa véritable lueur... se cache dans nos cœurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "... Ça fait si longtemps que je n'avais pas entendu cette phrase. Je l'avais presque oubliée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Dites-moi, camarade. Qui vous envoie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Maître Spartacus ?! C'est lui qui vous a dit de venir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Où est-il ? Je sais qu'il a été capturé lors de la rébellion par les sous-fifres de l'enfant du soleil, mais nous avons perdu tout contact avec lui depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "#Il a été emprisonné dans l'autel du Cœur du serpent... Malheureusement, il n'a pas la possibilité de s'évader. C'est pourquoi il nous a {M#envoyés}{F#envoyées} vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Maudit soit l'enfant du soleil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Quels sont les ordres qu'il vous a donnés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Il a seulement voulu qu'on vous transmette un message :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "« N'abandonnez jamais, mes enfants. L'espoir de Byakuyakoku réside en vous. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "P—Pardon, maître ! Nous avons échoué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "La résistance n'est plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Le pilier de la résistance s'est complètement effondré quand notre maître s'est fait capturer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Il ne reste que nous, ses disciples, qui avons pu fuir, car nous étions loin des événements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Ceux qui ont eu la chance de s'échapper se sont réfugiés dans les cachettes préparées à l'avance, dans l'espoir de rassembler des forces à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Nous comptons d'excellents stratèges, des chercheurs spécialisés, des mages remarquables et des médecins fiables dans nos rangs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "C'est plutôt prometteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "C'est ce que nous pensions aussi, qu'il faudrait peu de temps pour que notre mouvement regagne sa vigueur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Cependant, une seule chose nous manquait : des fonds pour financer tout ça... Nous n'avions rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Au bout du compte, certains membres ont suggéré la vente d'orbes d'os-dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "Qu'est-ce qu'un orbe d'os-dragon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "Il s'agit d'un fruit magique que les fleurs d'os-dragon produisent dans des circonstances particulières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Son parfum peut calmer les esprits, soulager les humeurs anxieuses et balayer tous vos soucis. On peut en trouver à un prix très élevé sur le marché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "Il est vraiment magique votre truc ? Vous n'êtes pas en train de nous berner, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "J'aurais aimé que ce ne le soit pas... Naïf comme j'étais, je n'ai pas pu anticiper le danger que cela représentait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "J'ignore d'où la formule pour le fabriquer venait, mais je sais que ça nous a rapporté beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Tout se passait bien, jusqu'à ce que certains de nos camarades commencent soudainement à éviter le conflit et à refuser de combattre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "Ils étaient de plus en plus nombreux au fil du temps, à un tel point qu'on devait leur demander de quitter nos rangs. Je n'ai rien pu faire pour empêcher que ça ne se produise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "Pourquoi les choses se sont finies comme ça ? Les orbes vous avaient-ils rapporté tellement d'argent qu'il n'était plus nécessaire de se battre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Vous pensez que c'était le charme corrupteur de l'argent ? Non... Je ne... Je ne sais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "Je sais seulement qu'une fois que les gens se satisfont de leur vie, ils perdent toute volonté de se battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "C'est là que tout a commencé à s'effondrer, sans qu'on puisse faire quoi que ce soit pour y remédier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "Parfois, je me demande si la formule de fabrication de ces orbes ne nous a pas été délibérément dévoilée par nos ennemis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "La valeur monétaire de ces orbes a-t-elle été fabriquée de toutes pièces par ces odieux dignitaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "*soupir* Je me demande comment les choses se seraient passées si notre maître avait été là. Aurait-il anticipé le problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Je suis désolé, maître. Nous n'avons pas pu incarner l'espoir que vous vouliez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "#Je suis {M#désolé}{F#désolée} d'entendre ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Je ne peux pas lui faire face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "En revanche, je vous remercie de m'avoir apporté de ses nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "Je n'ai rien à vous offrir en guise de ma gratitude, mais je peux toujours vous dévoiler le secret des orbes d'os-dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Ils ne peuvent qu'être créés avec les eaux de Tokoyo Reisen, ou aussi appelées « eau de Lethe ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Vous pouvez vendre ces orbes ou bien les garder pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Ceci dit, ne les laissez pas saper votre désir d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Aimeriez-vous voir votre maître ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
