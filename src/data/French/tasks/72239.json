			"dialogs": [
				{
					"id": 722392401,
					"content": "(Il y a deux lignes de texte sur cette pierre tombale. La première est écrite dans la langue de Byakuyakoku, ce qui la rend illisible.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Stèle ancienne en pierre"
				},
				{
					"id": 722392402,
					"content": "(La deuxième ligne est en langue commune. Elle dit :)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Stèle ancienne en pierre"
				},
				{
					"id": 722392403,
					"content": "« Ci-gît Spartacus le juste, aussi connu sous le nom de Supada no Hiko. Ici figure la liste de ses crimes. Prenez-en connaissance et souvenez-vous de notre histoire. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Stèle ancienne en pierre"
				},
				{
					"id": 722392404,
					"content": "#« Supada no Hiko, cerveau criminel notoire et source d'agitation dans le royaume. Au nom d'Ookami Tokoyo, qu'il perde la vue et que son âme soit écrasée. Qu'il soit jeté dans une prison abyssale, maintenant et pour toujours.{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stèle ancienne en pierre"
				}
			]
		}
	]
}