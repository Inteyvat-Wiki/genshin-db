			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "Alors, comment se passe ta chasse au trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590202,
					"content": "J'ai tout trouvé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Waouh, tu as réussi à déchiffrer toutes les images... C'est impressionnant, vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590204,
					"content": "#Ahem... La Guilde a préparé un cadeau spécial, rien que pour toi. C'est parce que tu es {M#un aventurier vraiment compétent}{F#une aventurière vraiment compétente}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590205,
					"content": "Tu vois ces coffres ? Fais-toi plaisir, ils sont à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590206,
					"content": "Mais si je les prends tous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "#Eh oui, il ne reste plus rien pour les autres. C'est ça, l'aventure : {M#premier arrivé, premier servi}{F#première arrivée, première servie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590208,
					"content": "Eh bien, il ne me reste plus qu'à te souhaiter un joyeux Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
