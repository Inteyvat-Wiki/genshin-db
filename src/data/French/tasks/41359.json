					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "Bienvenue, voici les kaléidolanternes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590102,
					"content": "Tu as préparé une autre image ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "Bien sûr ! Et comme tu as résolu les deux précédentes si facilement, j'ai mis les lanternes les plus difficiles que j'avais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590104,
					"content": "Le principe reste le même : tu combines trois motifs pour former une image, mais cette fois les lanternes sont <color=#00E1FFFF>connectées entre elles</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590105,
					"content": "Héhé, tu verras quand tu essayeras... Cette fois, l'image est celle d'une <color=#00E1FFFF>grue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590106,
					"content": "Une fois les motifs alignés, tu pourras aller chercher le trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
