				},
				{
					"id": 413590302,
					"content": "#Pas vraiment un problème pour toi... Tu es {M#un grand aventurier}{F#une grande aventurière} après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
