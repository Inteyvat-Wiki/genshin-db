			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea est une aînée que je respecte profondément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "Après la disparition de son grand-père, les anciens du village m'ont élue cheffe tribale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "J'ai toujours des idées excentriques et novatrices, alors ils ont pensé que j'étais la mieux placée pour mener notre tribu vers un autre avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "Pourtant, je n'ai pas su quoi faire pendant longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "Mais Atea a toujours été là pour m'encourager. Quand je faisais des erreurs, elle ne s'est jamais fâchée. Au contraire, elle m'aidait à analyser ce qui n'allait pas pour que je fasse mieux la fois suivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "Je la respectais tellement, alors... Je n'oublierai pas ce qu'elle m'a enseigné et je ferai de mon mieux pour être la cheffe que ma tribu mérite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
}