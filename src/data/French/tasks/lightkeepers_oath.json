			"dialogs": [
				{
					"id": 760761101,
					"content": "#Bonjour, mon {M#ami}{F#amie}. C'est un plaisir que de vous revoir parmi les tombes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761102,
					"content": "Vous décrivez les lanternes du serment à Flins, ainsi que les mots incompréhensibles inscrits dessus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "« Le vent se lève, les feuilles tourbillonnent... »... C'est le serment que prêtent ceux qui rejoignent les Gardiens de lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761104,
					"content": "D'habitude, nous avons chacun une lanterne. On l'abandonne uniquement quand on n'a pas d'autre choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761105,
					"content": "Chaque lanterne sans maître est un signe de malheur. C'est une tragédie qui m'attriste profondément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761106,
					"content": "Mais ils savaient déjà ce qui les attendait en prêtant serment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761107,
					"content": "S'il y a quelque chose que nous pouvons faire pour eux, ce serait de nous souvenir de leur serment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761108,
					"content": "« Protéger les lanternes allumées par un espoir éternel » était leur vœu le plus cher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		}
	]
