			"dialogs": [
				{
					"id": 150180301,
					"content": "Bonjour, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "#Vous êtes {M#perdus}{F#perdues} ? Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "Non, nous passions dans le coin et voulions rendre visite au Collectif de l'abondance. Sommes-nous dans la bonne direction ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Oui, c'est ma tribu. Je vous y emmène si vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "#Super, {NICKNAME}. Nous avons trouvé une guide locale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "Je pensais que c'était ton rôle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Une guide, euh... Oui, voilà ! Héhé, je serai votre guide, désormais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "Il y a beaucoup de jolis paysages sur le chemin, je vous les montrerai. Les gens sont toujours émerveillés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Merci beaucoup ! Mais, euh... Tu as accepté sans réfléchir... Ça ne te dérange pas, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Oh non, pas du tout ! Je suis venue m'entraîner, mais j'étais sur le point de rentrer. Nous allons dans la même direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "Et puis, je pourrai vous apprendre plein de choses sur la tribu en tant que guide. C'est toujours chouette d'apprendre, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "#Si vous êtes {M#contents}{F#contentes}, alors moi aussi. C'est comme ça qu'oncle Acatl nous apprend l'hospitalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "Oh... D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Elle a l'air chaleureuse et amicale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Nous avons de la chance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "C'est clair, je l'aime vraiment bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "#Tout va bien ? Allons-y dès que vous serez {M#prêts}{F#prêtes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Oh, attends ! Nous ne connaissons même pas encore ton nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Tu as raison. Je m'appelle Varesa, enchantée de faire votre connaissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
