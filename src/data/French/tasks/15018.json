			"dialogs": [
				{
					"id": 150180401,
					"content": "Bonjour, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180403,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Vous êtes... {NICKNAME} et Paimon ?! Je vous attendais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "Oh, tu nous connais ? On dirait que nous sommes célèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Mais, attends un peu... Est-ce qu'on a dit à qui que ce soit que nous allions rendre visite au Collectif de l'abondance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "#Oh, vous n'êtes pas au courant ? Madame Iansan a dit qu'elle vous avait {M#invités}{F#invitées} à la tribu, alors je suis venue m'entraîner ici en vous attendant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "#Et vous voilà... Héhé, je suis vraiment contente que vous soyez {M#venus}{F#venues} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "Pourquoi un tel enthousiasme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "#Vous êtes les {M#héros}{F#héroïnes} qui ont vaincu l'Abîme, vous êtes célèbres dans tout Natlan ! J'ai entendu l'histoire de Tum{RUBY#[D]Espoir}aini tellement de fois que je la connais par cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "Je suis impatiente depuis que madame Iansan m'a dit que vous alliez peut-être venir nous rendre visite. Oh, je m'appelle Varesa, je ne sais pas si elle vous a déjà parlé de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Oui, ce nom me dit quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Lors de l'invasion de l'Abîme, nous avons demandé à Iansan si le Collectif de l'abondance avait besoin d'aide, mais elle nous a répondu que Varesa maîtrisait la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Tu dois donc être une guerrière redoutable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Non, c'est à oncle Acatl que revient tout le mérite ! Je n'ai fait que nous débarrasser de quelques monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Le simple fait de penser à l'invasion me donne encore des frissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Mais toute cette histoire est derrière nous, désormais. Le Collectif de l'abondance n'a pas été trop fortement touché, et nous avons déjà terminé les réparations. Les membres tribaux se consacrent donc désormais à aider les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Héhé. Allez, je vous emmène au camp de la tribu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Très bien, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "Et une véritable héroïne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
