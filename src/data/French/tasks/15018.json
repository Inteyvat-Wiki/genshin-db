			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "Alors c'est toi, Varesa. Nous avons déjà entendu ton nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Je m'appelle Paimon, et voici {NICKNAME}. Nous sommes les meilleurs compagnons du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#Très bien, Paimon et {NICKNAME}. Ce sont de jolis noms, je m'en souviendrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Très bien, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
