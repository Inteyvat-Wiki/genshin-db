						],
						"pointId": 10947
					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "#Nous sommes enfin {M#arrivés}{F#arrivées} au Collectif de l'abondance. C'est aussi chez moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Waouh, c'est magnifique ! Et cette plateforme en forme de tête de taureau est impressionnante, j'adore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Héhé. Là, c'est l'Arène résonante. On y organise toutes sortes de compétitions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "#Merci de nous avoir {M#amenés}{F#amenées} ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Avec plaisir, aucun problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "J'aurais bien aimé vous faire visiter, mais je dois d'abord rentrer chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Tu viens de te souvenir de quelque chose d'important ? Tu avais l'air particulièrement inquiète lorsque les Brutocollinus sont apparus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "J'espère qu'on ne t'a pas retardée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "#Oh non, pas du tout. Nous sommes {M#arrivés}{F#arrivées} à temps. Il y a quelque chose d'important que je dois faire... La chose la plus importante après un entraînement, manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Quand j'ai faim, je me sens faible. Ça me donne la tête qui tourne, puis je perds le fil de mes pensées. Les conséquences d'un estomac vide sont désastreuses, il faut faire attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Je suis vraiment désolée, mais il faut absolument que je mange quelque chose tout de suite ! Et vous devriez faire de même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "On se retrouvera à l'Arène, à plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Et la voilà partie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Waouh, quelle tornade... Elle était calme et posée, puis voilà qu'elle fonce littéralement la tête la première...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "C'est la fougue de la jeunesse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "De la jeunesse ? Si tu le dis, vieille branche... Moi, je nous trouve encore jeunes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Pourquoi n'en profiterions-nous pas pour faire un tour en attendant ? On ira plus tard à l'Arène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "La vue doit vraiment être superbe depuis là-haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
