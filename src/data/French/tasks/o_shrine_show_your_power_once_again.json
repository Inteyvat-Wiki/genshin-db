			},
			"dialogs": [
				{
					"id": 220280501,
					"content": "C'est ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "On m'a raconté qu'il y a longtemps, un doushin a offert de nombreuses grues en papier à cet autel, souhaitant la paix et la sécurité pour tous à Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Puis, il y a eu un incendie dans ce quartier et une maison a pris feu. Comme la maison avait été construite avec des matériaux de fortune, elle s'est vite fait réduire en cendres et le feu ne s'est pas propagé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Tout le monde pensait que c'était la bénédiction des divinités... Héhé. Du coup, j'ai aussi plié des grues en papier pour les apporter ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Assez bavardé ! Que devrions-nous donner en offrande cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Nous pourrions obtenir une réponse si nous offrons des grues en papier comme le doushin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Mais puisque cet autel se trouve près d'un salon de thé, il serait plus peut-être mieux d'offrir des bonbons konpeito au matcha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Et puis, j'aime bien ces bonbons aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "Qu'en penses-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
