			"dialogs": [
				{
					"id": 220280901,
					"content": "C'est ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280902
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280902,
					"content": "Il y a longtemps, quelqu'un a offert du minerai de fer pour forger des épées à cet autel dans l'espoir que ses compétences en arts martiaux s'améliorent rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280903
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280903,
					"content": "Plus tard, cet homme s'est rendu à un tournoi et a vaincu facilement tous ses adversaires. Tout le monde saluait ses compétences martiales exceptionnelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280904
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280904,
					"content": "Cependant, cet homme a dit que tous ses adversaires semblaient se sentir mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280905,
						220280906
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280905,
					"content": "Cette divinité a des drôles de méthodes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280907,
					"content": "Mais en tout cas, tout le monde a senti que c'était aussi une manifestation divine. En faisant un vœu à cet autel, je pense qu'il devrait se réaliser aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280908,
					"content": "Assez bavardé ! Que devrions-nous donner en offrande cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280909
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280909,
					"content": "Nous pourrions avoir une réponse aussi, si nous faisons une offrande de minerai de fer comme cet homme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280910,
					"content": "J'ai trouvé du minerai devant l'atelier du forgeron, mais ils n'étaient pas de si bonne qualité alors il a bien voulu me les donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280911,
					"content": "De plus, j'ai ramassé des herbes marines dans le coin tout à l'heure. Je les ai fait bouillir et je les ai saupoudrées de sucre... Elles sont bonnes comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280912,
					"content": "Je ne sais pas si les divinités aiment ce genre de petits plats froids...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280913,
					"content": "Qu'en penses-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280906,
					"content": "Peut-on dire qu'on s'améliore vraiment si les autres deviennent moins bons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				}
			]
		},
