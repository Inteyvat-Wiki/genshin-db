			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Écoute-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Après mon offrande de la dernière fois à l'autel, mon souhait s'est réalisé... en partie ! Même s'il ne s'est pas réalisé en totalité, les divinités m'ont quand même entendu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Qu'est-ce que tu as souhaité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Euh... J'ai souhaité que l'auteur du manga que je suis en train de lire dessine plus vite pour avoir un chapitre tous les deux jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Et ensuite, un double chapitre a été publié dans le dernier numéro du magazine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Mais... C'est parce qu'il prendra une pause pendant les trois prochains numéros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "C'est une manière plutôt équilibrée d'accorder un souhait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Hmm... De toute façon, les divinités ont sûrement dû entendre mon souhait. La raison pour laquelle elles ne l'ont pas entièrement exaucé doit être parce que je n'ai pas fait assez d'offrandes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "Alors aujourd'hui, faisons des offrandes à d'autres autels aussi ! De cette façon, je suis sûr que mes souhaits seront complètement exaucés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "J'ai demandé à mes parents et il y aurait deux autres autels par ici. Un près du Salon de thé Komore et un autre à la sortie de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "#{M#Voyageur}{F#Voyageuse}, auquel devrions-nous aller en premier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Tu ne louperas qu'un seul numéro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
