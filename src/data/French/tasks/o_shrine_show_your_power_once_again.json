				{
					"id": 220280601,
					"content": "Faisons une offrande de bonbons konpeito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280801
					]
				},
				{
					"id": 220280801,
					"content": "Oui ! Faisons ça, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280802
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280802,
					"content": "J'espère vraiment que cette fois, les divinités me répondront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280803,
					"content": "Je reviendrai demain pour voir s'il y a des signes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280804,
					"content": "#Au fait, merci d'être {F#restée}{M#resté} avec moi jusqu'à maintenant. C'est pour toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280805,
					"content": "J'espère que les divinités répondront à mes souhaits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
