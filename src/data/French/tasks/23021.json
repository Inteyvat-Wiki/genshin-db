			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Vous arrivez juste à temps. Le bateau vient d'être mis à l'eau et il est très stable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210102,
					"content": "Mes calculs ont été entièrement corrects !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210103,
					"content": "Alors, quand commençons-nous le test de charge dont nous avons parlé plus tôt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210104,
					"content": "#Ne sois pas si pressée. {M#Le voyageur}{F#La voyageuse} est là, on va commencer tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210105,
					"content": "#Qu'est-ce que c'est, le test de charge{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "En gros, il s'agit de tester la capacité de charge du navire avec des objets lourds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210107,
					"content": "Oui... Ça veut dire que quelqu'un va devoir m'aider à transporter tous les objets lourds pour les mettre à bord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210108,
					"content": "#{M#Voyageur}{F#Voyageuse}, j'ai pu constater votre force et votre dynamisme, vous avez le profil parfait pour ce travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210109,
					"content": "C'est pour ça que vous m'avez fait venir ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "P—Pas du tout. C'est juste que je ne peux vraiment pas faire ça tout seul, donc je n'ai pas d'autre choix que de vous demander de m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210112,
					"content": "D'ailleurs, je ne serai pas avare avec vous en matière de rémunération ! Rassurez-vous, je viens de réparer un gros bateau il y a quelques jours et j'ai empoché une somme coquette grâce à ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210113,
					"content": "Euh... Une somme coquette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210114,
					"content": "Hein ? Attendez. Je pense que j'ai dépensé tout l'argent que le client m'a donné pour réparer le bateau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210115,
					"content": "Tout l'argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210116,
					"content": "Il en reste un peu ! Je vous offrirai un café...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210117,
					"content": "#{M#Voyageur}{F#Voyageuse}, commençons vite ! Ne tardons pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210110,
					"content": "#Je ne suis pas {M#content}{F#contente}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
