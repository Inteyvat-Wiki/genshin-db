				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "Très bien ! C'est bon. Voyons ce qui va se passer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210601,
					"content": "Ouah ! Il y a une fuite là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210615,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210602,
					"content": "Le bateau, il penche ! Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210603,
					"content": "Vite, déchargez le bateau ! Quelque chose ne va pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210604,
					"content": "Rafiq et vous déchargez vite les objets lourds qui encombrent le bateau...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "Ouf... On a de la chance qu'il n'y ait pas grand-chose à déplacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210606,
					"content": "Quoi... Oh non, où est-ce que je me suis trompé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210607,
					"content": "Qu'est-ce que je t'avais dit ? Tes calculs sont trop près de la limite, ils ne sont donc pas fiables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210608,
					"content": "Ouf... Je... Je... Eh bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210609,
					"content": "Ça n'aurait pas dû arriver, mes calculs sont si précis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210610,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}. Veuillez accepter ceci en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210611,
					"content": "Je vais recalculer... Qishan, peux-tu m'aider cette fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210612,
					"content": "Tu dis ça comme si je ne t'avais pas aidé avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210613,
					"content": "Laisse-moi m'en occuper. N'oublie pas de m'inviter à prendre un café une fois que j'aurai terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
		{
			"id": 2302108,
			"completionStepIds": [
