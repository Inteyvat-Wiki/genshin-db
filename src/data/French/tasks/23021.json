			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "Génial, c'est un succès total !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "Il n'y a aucun problème dans la structure de la coque... La ligne de flottaison est stable et il n'y a pas de déséquilibre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Qishan, tu vois ? Mes schémas et mes calculs sont impeccables !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Ce n'est que la première phase des tests de charge, ne te réjouis pas trop vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "De plus, tu n'as pas tenu compte de la météo et du déplacement du centre de gravité du navire dû au déplacement de la cargaison pendant la navigation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Euh... Euh, d'accord, je vais y réfléchir. Mais laisse-moi me réjouir au moins un peu avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "#Ah oui, {M#voyageur}{F#voyageuse}, veuillez accepter ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Dis Qishan, ça te ferait du mal de m'encourager pour une fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Quand il est question de construire un bateau, s'encourager ne sert à rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "Tu ferais mieux de réfléchir à la manière d'encourager ton portefeuille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
