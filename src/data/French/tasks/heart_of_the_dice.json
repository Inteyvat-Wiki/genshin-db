			"dialogs": [
				{
					"id": 705340101,
					"content": "Je ne vois pas l'intérêt d'avoir autant de versions d'un jeu de plateau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "#C'est vous, {M#voyageur}{F#voyageuse} ! Vous m'avez fait peur. Vous êtes aussi là pour le Grand prix du Roi des invocations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "#C'est un jeu qui a été conçu par un aventurier de la Guilde. Apparemment, il s'agit d'un mélange entre l'Invocation des Sept et des combats... Ça s'appelle «{NON_BREAK_SPACE}Au cœur des dés ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Comme nous participons à l'organisation du Grand prix du Roi des invocations, la Guilde a décidé de mettre en place un mini-jeu inspiré par la vision de cet aventurier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Comment faites-vous pour mélanger l'Invocation des Sept à des combats ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Hahaha ! Personnellement, je ne saisis pas vraiment le concept non plus. En revanche, nous avons un livre de règles juste là... Regardez-moi cette épaisseur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "De ce que je comprends, il faut utiliser un dé pour jouer à « Au cœur des dés ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "En tout cas, n'hésitez pas à essayer si le cœur vous en dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "C'est un mélange assez inédit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Quel jeu de plateau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
