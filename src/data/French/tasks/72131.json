			"dialogs": [
				{
					"id": 721310101,
					"content": "La lanterne de pierre aux formes étranges semble émettre une énergie inquiétante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721310102,
					"content": "C'est... une lanterne de pierre ? Pourquoi il y a une lanterne de pierre ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Oh, quelqu'un a écrit quelque chose dessus. On jette un coup d'œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "« Chers collègues : si vous avez des questions à propos de cette protection, veuillez vous rendre aux Gorges de Musoujin et parler à monsieur Kaji. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721310105,
					"content": "L'écriture semble récente. Il y a quelques lignes plus grossières et plus petites en dessous :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721310106,
					"content": "« Je suis désolé que nous ne puissions pas vous aider. Nous avons reçu l'ordre d'évacuation de la Commission administrative hier. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721310107,
					"content": "« J'espère pouvoir vous revoir un jour et discuter de la façon de résoudre notre problème avec le Tatarigami. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721310108,
					"content": "Ce monsieur Kaji semble assez préoccupé par ces lanternes de pierre. Pourquoi ne pas aller aux gorges de Musoujin et lui demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
