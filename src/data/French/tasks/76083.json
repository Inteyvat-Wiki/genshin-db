					"nextDialogs": [
						760830411
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760830411,
					"content": "Revenez maintenant. Vous avez fait du bon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
