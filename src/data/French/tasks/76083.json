					"nextDialogs": [
						760830512
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760830512,
					"content": "Revenez maintenant. Merci, je sais que ce n'était pas facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
