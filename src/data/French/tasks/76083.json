						760830413
					]
				},
				{
					"id": 760830413,
					"content": "N'importe qui peut voir que c'est un arc ! Comment la réponse peut-elle être aussi simple ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "Vous n'avez pas tort techniquement, mais je crains que ce ne soit pas exactement ce que les kuuhenkis avaient en tête.",
