						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "#Ce n'est pas logique... Comment avez-vous fait ça ?! Ma réputation est fichue{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "C'était un honneur de vous affronter, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665003,
					"content": "Quelle politesse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Haha ! On dirait que tu n'as fait que perdre depuis notre absence, le vach{RUBY#[S]Authentique Roi oni des scarabées de combat}eron ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Je ne vois pas les choses comme ça. L'Authentique Roi oni des scarabées de combat n'a pas encore perdu, à moins qu'il renonce maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665006,
					"content": "À la guerre, comme dans la vie, c'est normal d'être confronté à des obstacles parfois. Ce n'est que lorsqu'on arrête d'essayer de les surmonter qu'ils se transforment en échec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665007,
					"content": "Exactement ce qu'elle a dit ! Je n'admets pas encore ma défaite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Cependant, c'est inutile de trouver des prétextes pour se justifier sans cesse. Parlez moins et utilisez plutôt votre énergie dans les combats de scarabées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665009,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Roi oni, tu n'es pas doué pour affronter ce genre d'adversaire. Envoie plutôt un de tes subordonnés se battre contre lui et observe attentivement leur match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716665011,
					"content": "L'observation est une part importante de l'entraînement d'un guerrier. Certaines compétences sont acquises en les appliquant soi-même, d'autres en regardant les autres faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716665012,
					"content": "Tu as raison, Grand Maître ! Et tu tombes bien, Bras droit du Roi oni ! Je te confie ce combat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Haha ! C'est enfin ton tour ! Montre de quoi tu es capable, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Héhé ! Fastoche !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Je vais donc me mesurer {M#au}{F#à la} légendaire {NICKNAME} ? Dans ce cas, je ne retiendrai pas mes coups...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665015,
					"content": "Ouh, j'ai peur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
