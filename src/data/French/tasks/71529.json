			},
			"dialogs": [
				{
					"id": 716665101,
					"content": "Magnifique. J'admets ma défaite totale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665102,
					"content": "#Mais cela reste un honneur de perdre contre vous, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "Massacreur instantané sans fioritures"
				},
				{
					"id": 716665103,
					"content": "C'est comme ça que t'as gagné ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Eh oui, il faut faire preuve de créativité face à un adversaire rusé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "#Quand la stratégie ne fonctionne pas, il faut aborder la situation sous un autre angle. Au cours de nos voyages avec {NICKNAME}, on doit souvent improviser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "S'accrocher à tout prix à une seule méthode ne résoudra pas le problème, peu importe combien de fois on essaye !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Je crois que Shinobu a dit quelque chose de semblable un jour. J'imagine que vous avez raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "J'y réfléchirai une prochaine fois. Pour l'instant, je dois me concentrer sur l'essentiel : les combats de scarabées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
