			"dialogs": [
				{
					"id": 722020101,
					"content": "L'Oiselle du tonnerre m'a-t-elle abandonné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020102,
					"content": "Bonjour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "Ô grande et illustre Oiselle du tonnerre... Ne sois pas fâchée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020105,
					"content": "Je ferai tout mon possible pour lire tes décrets et instructions, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020106,
					"content": "Pourquoi me rejettes-tu ? Pourquoi... *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020107,
					"content": "Pourquoi ne puis-je pas entrer dans le brouillard que tu as créé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020108,
					"content": "Lire ? Mais de quoi parlez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "Je trouverai un moyen de m'occuper des rocs tonnerres que tu as laissés... Mais le bateau argenté approche, je n'ai plus beaucoup de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020110,
					"content": "De quels rocs tonnerres parlez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "Des rocs tonnerres des Plaines d'Autake... Seuls ceux qui manient la foudre peuvent les raviver et seuls ceux qui peuvent traverser le brouillard peuvent les trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020112,
					"content": "Pour se tenir telle l'Oiselle du tonnerre... et déployer ses ailes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020113,
					"content": "Attendez, mais le brouillard s'est dispersé pourtant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
