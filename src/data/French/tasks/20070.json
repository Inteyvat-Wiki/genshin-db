			"dialogs": [
				{
					"id": 200700201,
					"content": "Alors ? Et les fleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700202,
					"content": "Pardon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700204,
					"content": "J'ai abîmé la boîte sans faire exprès...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "Quoi ? Mes fleurs sont abîmées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700206,
					"content": "*soupir* ... J'avais choisi ces fleurs avec soin en plus... Ce n'est pas évident d'en trouver des aussi jolies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700207,
					"content": "#Alors, les Monts Dosdragon sont si dangereux ? Même {M#un aventurier}{F#une aventurière} de ta trempe a du mal à gérer une simple boîte de fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700208,
					"content": "#Enfin bon, merci quand même d'y être {M#allé}{F#allée} pour moi ! Tiens, c'est pour toi. Je dois retourner m'occuper des fleurs de la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700209,
					"content": "*soupir* Sinon... je peux toujours essayer la méthode de Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
