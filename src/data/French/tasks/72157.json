					"nextDialogs": [
						721570107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570107,
					"content": "On dirait que « trouver la pierre de protection » fait partie des problèmes éventuels quand on veut la sceller, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570108,
					"content": "Espérons simplement qu'on pourra trouver des indices dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570109,
					"content": "Allez, Taisuke. On perd du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
