			"dialogs": [
				{
					"id": 721570101,
					"content": "Hein ? Où est la pierre de protection ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570102,
					"content": "Hmm. Ça ne va pas être aussi facile qu'on ne le pensait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570103,
					"content": "Regardons un peu dans les environs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "Oui, on dirait bien que c'est notre seule option. Voyons si on peut trouver quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570105,
					"content": "Mais cet endroit est immense ! Combien de temps on va devoir chercher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570106,
					"content": "Eh bien, j'imagine que c'est une question de chance. Dans tous les cas, il faut s'y mettre.",
