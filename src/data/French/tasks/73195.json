					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "« Il est de retour ! Seigneur Al-Ahmar, est de retour ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950802,
					"content": "« Le jour de son retour sera le jour où vous serez châtiés, vous les types avec des feuilles sur la tête ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950803,
					"content": "Cette information est fausse, nous sommes actuellement en train d'enquêter sur sa source. Toutes les informations importantes relatives à Sumeru seront affichées régulièrement dans l'Akasha. Ne vous laissez pas duper par les rumeurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "« Mon ami, êtes-vous troublé par un problème quelconque ? Le tout-puissant seigneur Sangemah Bay est à votre disposition pour vous donner toutes les réponses que vous cherchez. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950902,
					"content": "« Si vous êtes prêt à vous délester d'un peu de moras, votre problème ne sera plus un problème. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950903,
					"content": "« Ne réfléchissez plus et passez à l'acte ! Voici mes coordonnées... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950904,
					"content": "Ce panneau d'affichage a été mis en place par le vizir dans le but de fixer des règles pour les transactions commerciales. Veuillez ne pas poster des publicités ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
