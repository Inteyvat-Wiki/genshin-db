				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "« Après être devenu un brigadier forestier et avoir passé tout mon temps dans la forêt, j'en suis au point où j'ai envie de parler aux fauconuits. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951302,
					"content": "« Si seulement je pouvais comprendre les paroles des fauconuits, je ne m'ennuierais pas autant que maintenant. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
