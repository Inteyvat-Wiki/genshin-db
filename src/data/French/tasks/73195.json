			"dialogs": [
				{
					"id": 731951601,
					"content": "« Paraît-il que Diwan nous défendait autrefois, nous les habitants du centre-ville. Pourtant, maintenant, il obéit totalement aux mahamatas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951602,
					"content": "« Comme le vizir, son poste n'a pas de réel poids politique. Et on ne pense à lui que lorsque les mahamatas veulent se débarrasser de leurs responsabilités. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951603,
					"content": "Les directives de l'Académie émises à l'intention de tous les organes administratifs sont fondées sur les derniers enseignements de la Molrani Rukkhadevata. Veuillez vous abstenir de toute diffamation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
