			"dialogs": [
				{
					"id": 731950101,
					"content": "Ce panneau d'affichage a été mis en place par le vizir pour faire informer les citoyens des affaires importantes de la Ville de Sumeru. Si vous avez des questions, veuillez les poster ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "« Nous recherchons des spécialistes pour attraper ces tigres rishbolands... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950202,
					"content": "L'annonce a été effacée par des traits de pinceau. À côté se trouve un texte en italique à l'écriture enfantine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950203,
					"content": "« Le Radja rishboland ne cherche qu'à jouer avec les gens ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "« Si après avoir consommé des champignons, vous voyez des petits êtres danser, veuillez ne pas vous inquiéter. Il s'agit d'une réaction normale. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950302,
					"content": "« Mais si vous constatez que les plantes qui vous entourent se mettent à parler, demandez immédiatement de l'aide du garde forestier le plus proche. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "« Pour des raisons inconnues, les zones de siccité ont commencé à s'étendre, non seulement en ce qui concerne leur nombre, mais aussi leur superficie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950402,
					"content": "« Non seulement les zones de siccité font flétrir toute la végétation dans la zone qu'elles affligent, mais elles peut également être mortelles pour la faune et même les humains. Les brigadiers forestiers ont mis en place des zones contaminées pour marquer les zones concernées, veuillez rester à l'écart de ces zones. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950403,
					"content": "« Si vous remarquez en chemin une nouvelle siccité dans la forêt, veuillez contacter un garde forestier à proximité pour que des professionnels s'en occupent. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Les matras ont découvert de multiples cas de commerce illégal de concentrés de connaissances lors de récentes inspections dans les bazars locaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950502,
					"content": "Le commerce de concentrés de connaissances est interdit par l'Académie. Tout contrevenant sera sévèrement puni une fois découvert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950503,
					"content": "L'Académie ne sera pas responsable des conséquences suivant l'utilisation illégale de concentrés de connaissances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "« Le Festival Sabzeruz annuel est à nos portes. Cette année aussi, un grand festival sera organisé dans le Grand bazar. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950602,
					"content": "« Pour ajouter à l'ambiance festive, mademoiselle a préparé une subvention spéciale pour tous les commerçants participants. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950603,
					"content": "« Fêtons ensemble l'anniversaire de la Rani Kusanali ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "« Mademoiselle a quitté la maison et n'est toujours pas revenue. Si vous voyez une jeune fille aux cheveux bruns portant une robe bleue et une veste violette, veuillez contacter la famille Homayani. Nous vous récompenserons pour votre aide ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731950702,
					"content": "« Si mademoiselle elle-même voit cette affiche, qu'elle nous contacte immédiatement. Vos parents sont très inquiets pour vous. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
