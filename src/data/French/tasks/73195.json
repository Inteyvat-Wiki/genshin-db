				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "« En fait, je me souviens d'une mercenaire très forte qui s'appelle la crinière ardente ou quelque chose comme ça... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951402,
					"content": "« Je l'engageais chaque fois que je partais en mer pour mes affaires. Peu importe que je tombe sur des Pilleurs de trésors ou des Millelithes, je n'avais rien à craindre quand elle était à mes côtés. J'ai fait fortune grâce à elle. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951403,
					"content": "« Mais elle n'accepte pas de missions dernièrement, et j'ai entendu dire que les monstres se sont multipliés sur les routes menant à Liyue... Si cela continue, je vais devoir investir mon argent à l'Échange Kalimi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951404,
					"content": "« Vos affaires n'ont pas l'air très légales... Mais pour ce qui est de la crinière ardente, j'ai entendu dire qu'elle avait accepté une grosse mission de la famille Homayani récemment. Donc vous devrez attendre un certain temps. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951405,
					"content": "« Et si vous voulez un conseil, vous feriez mieux de dépenser votre argent en achetant 100 tapis que de l'investir à l'Échange Kalimi ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731951406,
					"content": "« Il a tout à fait raison ! Veuillez visiter notre boutique pour acheter 100 tapis ! Je peux même vous expliquer en détail comment vous servir au mieux de chacun d'entre eux ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
