					{
						"sceneId": 3,
						"position": [
							-1551.289,
							164.198,
							7728.138
						],
						"pointId": 350400157
					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "Hora ! Tiens-toi bien, ne bouge pas ! C'est juste une petite toilette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "Raouh raouh, raouh raouh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200103,
					"content": "Hé ! Et si on allait se baigner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Il y a une mare pas loin d'ici. Quand on aura fini de te laver, on pourra revenir jouer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "Raouh raouh, raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200106,
					"content": "Hé, attends un peu ! Ne cours pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "Hein ? Quelque chose vient de passer à toute vitesse, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "#Êtes-vous {M#venu}{F#venue} rendre visite à notre tribu ? Je suis désolé pour Hora. Il est un peu trop énergique ces derniers temps et court dans tous les sens. Il ne vous a pas effrayé, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "Vous êtes en train de le persuader à prendre un bain ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "Le persuader ? *soupir* Je suis plutôt en train de le supplier. Il a beaucoup plu ces derniers jours, alors il est couvert de boue chaque fois qu'il sort jouer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "J'aimerais le nettoyer un peu, mais il a envie de rien faire à part courir et jouer toute la journée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "Je n'arrive pas à le rattraper... Je suis une personne ordinaire, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "Pourquoi ne pas essayer de l'appâter avec de la nourriture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "J'ai déjà essayé, mais c'est comme s'il lisait dans mes pensées. Il va faire semblant de ne pas être intéressé s'il me voit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Il rampe et dévore toute la nourriture avant de s'enfuir, dès que j'ai la tête tournée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Il agit comme un tepetlisaure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Oui, c'est vrai. Je frémis déjà à l'idée des ennuis qu'il va causer quand il grandira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "J'espère simplement qu'il ne va pas semer la pagaille dans la boutique de Cheven... Je ne pourrais pas rembourser s'il casse ses pierres précieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "*soupir* Il n'y a plus qu'à essayer l'idée que Batz m'avait donnée auparavant, mais cette balle... plaît-elle vraiment aux tepetlisaures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "Qui est Batz ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Oh, il s'occupe des tepetlisaures dans la tribu. C'est quelqu'un de vachement intelligent et de très doué pour la musique. Les sauriens, aussi bien que les gens, l'aiment beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "Lorsque je lui en ai parlé il y a bien longtemps, il a sorti immédiatement un plan pour fabriquer une flottiballe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "C'est quelque chose qu'il a récupéré de Mataoho et les petits sauriens ont l'air d'aimer ça. Il m'a suggéré d'essayer d'en faire une pour Hora aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Une fois les matériaux rassemblés, je m'apprête à commencer la fabrication, mais Hora recommence à s'agiter et je n'arrive pas à le calmer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "Cette flottiballe est la seule idée que j'ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "Je peux vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "Vous voulez me donner un coup de main ? C'est génial, j'ai vraiment de la chance d'être tombé sur quelqu'un d'aussi serviable que vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "Pourriez-vous prendre des fleurs braisées dans la boîte là-bas ? Je serai ici en train de travailler sur la flottiballe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Dites-moi si vous avez besoin d'aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Ouah ! Ça a failli me renverser !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
