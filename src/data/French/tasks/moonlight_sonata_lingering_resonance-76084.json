			"dialogs": [
				{
					"id": 760840101,
					"content": "Ah, vous êtes là ? Les kuuhenkis jouent de la lyre. Pourriez-vous leur jouer un morceau comme la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760840102,
					"content": "J'ai aussi envie d'entendre quelque chose de différent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760840103,
					"content": "(Hmm... Quel morceau devrais-je jouer ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
