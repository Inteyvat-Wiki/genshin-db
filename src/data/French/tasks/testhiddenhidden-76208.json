			"dialogs": [
				{
					"id": 762080101,
					"content": "Tiens ? On dirait qu'un rideau translucide s'est levé... Ça vient de ce tronc d'arbre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "On dirait qu'il crache de la résine pour transformer cet endroit en un morceau d'ambre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "#On serait {M#piégés}{F#piégées} dedans comme des insectes alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "De l'ambre avec nous deux à l'intérieur ? Je suis sûre que ce serait la pièce maîtresse d'une vente aux enchères !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "Et que serait le véritable trésor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "Cet arbre évidemment ! Parce que c'est lui qui fabrique l'ambre, après tout. Dommage qu'on ne puisse pas l'emporter avec nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080107,
					"content": "Je me demande s'il y a des indices à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
