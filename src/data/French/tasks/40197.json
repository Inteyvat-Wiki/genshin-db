			},
			"dialogs": [
				{
					"id": 401970201,
					"content": "Génial ! Je vous en dessinerai une <color=#C4D6EAFF>blanche</color> !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Une moustache de crème ? C'est assez traditionnel, mais aussi délicieux. Je vous donne ma permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "Alors c'est décidé ! Maintenant que cette carte est à vous, vous pourrez y ajouter autant de moustaches que vous désirez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Héhé, cette carte sera délicieuse ! On en prendra bien soin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Si ça vous plaît, c'est tout ce qui compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Toutes les installations du parc sont désormais opérationnelles. On peut enfin se reposer et en profiter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
