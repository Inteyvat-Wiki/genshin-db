			"dialogs": [
				{
					"id": 401970101,
					"content": "Eh bien, maintenant que nous en sommes là, nous devrions ajouter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "Une pincée de sel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "Non, de poivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Oh, c'est brillant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "Que faites-vous, toutes les deux ? Vous travaillez sur un nouveau dessert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Du poivre dans un dessert ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Il ne s'agit pas de dessert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "On parle du scénario !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "#{M#Mon cher}{F#Ma chère} partenaire, photographe, {M#metteur}{F#metteuse} en scène {M#débutant}{F#débutante}... Notre créativité doit sans cesse être à la hauteur de l'enthousiasme débordant de nos fans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "Il n'y a pas de place pour d'ennuyeux scénarios sur ma scène ! Les rebondissements doivent toucher le public comme un nuage de poivre, le faisant éternuer par surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "L'assiette aussi est sa propre scène !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "J'ai un jour entendu mademoiselle Émilie dire qu'on pouvait mettre du poivre dans certains parfums. Je pourrais peut-être trouver un moyen d'en utiliser dans un dessert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Oui ! Peut-être qu'une touche poivrée pourrait agrémenter la douceur de la crème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Ouah, elles ont l'air de faire une sacrée équipe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "J'ai du mal à imaginer le goût d'un gâteau poivré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Qu'avons-nous là ? Escoffier prépare un nouveau gâteau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Oui, elle prépare une douceur poivrée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Génial ! Faites-moi savoir lorsque ce sera prêt, j'ai hâte d'y goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "C'est moi ou tout le monde a l'air encore plus motivé maintenant que le travail est fini ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "C'est bien normal, non ? Après tous ces efforts, c'est le moment de célébrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "C'est comme pour des macarons tout juste sortis du four. Ce n'est pas parce qu'ils sont sucrés qu'il faut s'empêcher d'ajouter la garniture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "S'il y a bien un moment pour foncer sur le sucre, c'est quand on fait des macarons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "À fond le sucre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "À fond le sucre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970127,
					"content": "Euh... De quel type de sucre parle-t-on, au fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lépine-Pauline, vous voilà ! Est-ce que tout est prêt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Oui, tout s'est déroulé comme prévu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Oh ? Vous faisiez quelque chose d'important ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "Et pas qu'un peu ! Tenez, prenez ceci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970132,
					"content": "C'est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Ouah, c'est génial ! C'est une vue panoramique du parc, avec les illustrations de tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Héhé, puisque le Parc cinématographique a été un véritable succès, nous avons décidé de créer un souvenir unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "Tout le monde a mis la main à la pâte lors de la construction du parc. C'est donc ensemble que nous avons décidé d'élaborer cette carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "Bien que la plupart des illustrations aient été réalisées par Lépine-Pauline. C'est elle notre experte en dessins, après tout. Mais nous y avons tous contribué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "Exactement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#Et ce n'est pas tout. {NICKNAME}, je vous offre un privilège très spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "Vous avez le droit de dessiner une moustache sur mon portrait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
