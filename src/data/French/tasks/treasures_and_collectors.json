			"dialogs": [
				{
					"id": 750090601,
					"content": "Comment ça s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} a trouvé ceci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090603,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "Laissez-moi regarder... Bien qu'il s'agisse d'un objet plus courant, il s'agit bien d'une trouvaille rare. Il est très bien conservé et les schémas d'écoulement du phlogistique sont clairement visibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090605,
					"content": "#Seriez-vous {M#prêts}{F#prêtes} à vous en séparer contre dix mille moras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090606,
					"content": "Quoi ?! Nous avons vraiment trouvé une relique saurienne inestimable ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090607,
					"content": "#Je savais que {REALNAME[ID(2)|SHOWHOST(true)]} était génial et qu'il nous porterait chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090608,
					"content": "Non, ce n'est pas aussi précieux que vous semblez le penser. Si vous l'apportiez au siège de l'Association des reliques sauriennes pour le faire évaluer, vous en tireriez peut-être cinq mille moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090609,
					"content": "Je ne vais pas me faire avoir ! Si ça ne vaut vraiment que cinq mille moras, pourquoi seriez-vous prête à en payer dix mille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090610,
					"content": "C'est à cause de ses motifs uniques. Je les trouve vraiment remarquables. Même si ça n'a peut-être pas beaucoup de valeur pour les autres, je suis prête à payer un peu plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090611,
					"content": "Vous pouvez me trouver excentrique, ou penser que c'est simplement la nature des collectionneurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090612,
					"content": "Hmm... Dit comme ça, je comprends mieux. Et comparé aux trois cents que nous avons payés pour entrer, dix mille moras, c'est une très belle somme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090613,
					"content": "Alors, on l'échange contre dix mille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090614,
					"content": "Raouh, raouh raouh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} n'a pas l'air très content... Tu préfères le garder pour toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090616,
					"content": "Ouh... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "Après tout, c'est lui qui l'a trouvé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#Puisque {REALNAME[ID(2)|SHOWHOST(true)]} ne veut pas le vendre, nous allons le conserver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090620,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#On dirait que vous accordez beaucoup plus d'importance à {REALNAME[ID(2)|SHOWHOST(true)]} qu'aux moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090622,
					"content": "#Naturellement ! {REALNAME[ID(2)|SHOWHOST(true)]} est notre compagnon, après tout. Mais si nous trouvons quelque chose de similaire à l'avenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090623,
					"content": "Merci, mais la passion des collectionneurs est aussi capricieuse que les marées. Elle monte rapidement, mais peut redescendre tout aussi brusquement. Peut-être que je serai obsédée par autre chose à l'avenir, mais je suis bien incapable de dire ce que ce sera.",
					"roleType": "TALK_ROLE_NPC",
