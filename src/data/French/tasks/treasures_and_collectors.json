				},
				{
					"id": 750090202,
					"content": "Cette petite balle... Elle ressemble à un composant ou quelque chose comme ça. Tu l'aimes bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090203,
					"content": "Ouh... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Même si nous ne l'avons pas déterré, puisque nous l'avons trouvé ici... Peut-être que c'est quelque chose de vraiment précieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090205,
					"content": "Nous demanderons avant de partir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
