					"speakerTitle": "Quipia"
				},
				{
					"id": 750090624,
					"content": "Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090625
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090625,
					"content": "Tu es d'accord avec elle ? Oh, je sais ! Ce doit être le respect et la compréhension mutuels entre collectionneurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090626,
					"content": "C'est un honneur pour moi d'avoir été reconnue par un jeune tepetlisaure aussi brillant. Pourtant, même si nous ne pouvons pas faire d'affaires, ça ne veut pas dire que nous ne pouvons pas être amis ! N'hésitez pas à venir me trouver si jamais vous avez envie de parler collection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090627
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090627,
					"content": "Je ne vais pas vous retenir plus longtemps. Bonne chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090618,
					"content": "#On dirait que {REALNAME[ID(2)|SHOWHOST(true)]} veut aussi devenir collectionneur.",
