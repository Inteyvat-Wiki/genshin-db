					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "#Ah, {M#voyageur}{F#voyageuse}, vous arrivez à pic. Les données devraient être toutes collectées, il est temps d'aller récupérer ces balises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Bien, alors je vous laisse y aller. Ne laissez pas les Fatui le découvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Comment le savez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Ces balises sont accompagnées d'un manuel d'instruction très détaillé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Le manuel décrit en fonction des circonstances la durée requise pour la collecte des données.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "Et pour ce qui est des énergies inconnues comme celle du Tatarigami, je vais simplement considérer qu'elles nécessitent la durée la plus longue. Dans tous les cas, la récupération de ces balises vous incombe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
