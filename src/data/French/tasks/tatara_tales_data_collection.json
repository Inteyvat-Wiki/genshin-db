			"dialogs": [
				{
					"id": 721170301,
					"content": "Comment ça s'est passé ? Vous avez toutes nos balises ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170302,
					"content": "Les voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "Bravo ! Maintenant, donnez-moi juste un moment pour que je modifie cet appareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170304,
					"content": "Je dois dire que les Fatui agissent de plus en plus étrangement ces derniers temps. On dirait qu'ils se rassemblent autour du noyau du fourneau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170305,
					"content": "J'espère qu'ils ne manigancent pas encore un autre de leurs complots ignobles... Ou pire, qu'ils ne tentent pas quelque chose contre lequel on ne pourrait pas se défendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
