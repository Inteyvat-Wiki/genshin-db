			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270401,
					"content": "Ouf, on arrive enfin à la fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270402,
					"content": "Le moins que l'on puisse dire, c'est que ça a été une longue aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270403,
					"content": "Il faut qu'on en parle à Jazari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Oui, s'il apprend ce qui s'est passé avec le noyau, il pourra nous aider à demander un financement ou quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270405,
					"content": "#Cependant, rejoindre l'Académie ne m'intéresse pas. {NICKNAME}, toi non plus, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270409,
					"content": "Bon, même si on ne connaît pas le lien entre l'avatar de la Marana et l'Ordre de l'Abîme, c'est au moins une très bonne chose que la maladie de la forêt ait été guérie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270410,
					"content": "*sanglote* Ararycan vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270411,
					"content": "De rien, Ararycan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "Mais que vas-tu faire ensuite, Ararycan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270413,
					"content": "Ararycan veut participer au Festival Utsava, mais Ararycan a très peur de la maladie de la forêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270414,
					"content": "Il peut y avoir des choses mauvaises qui reviennent et qui veulent du mal à la forêt, et c'est à Ararycan de la protéger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270415,
					"content": "Alors, aussitôt après le Festival Utsava, Ararycan reviendra ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270416,
					"content": "Ouah, c'est pas facile d'être un aranara !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "Ararycan, si jamais tu as besoin d'aide, viens nous voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270418,
					"content": "Oui, Ararycan le fera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270419,
					"content": "Alors, prends soin de toi, nous nous reverrons certainement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270406,
					"content": "Il faut qu'on en parle à Royinjan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Oh oui, et Royinjan dira certainement : « Quelle histoire intéressante ! ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270408,
					"content": "C'est incroyable, mais on a véritablement sauvé la forêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}