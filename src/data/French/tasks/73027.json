			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "Hé, Ararycan, qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270202,
					"content": "Ararycan vous attend ici depuis qu'Ararycan a fini de planter la fleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270203,
					"content": "Mais quelque chose est tombé de la grande montagne de fer, ça a failli heurter Ararycan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270204,
					"content": "Oh non ! Désolée, Ararycan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270205,
					"content": "Paimon n'a pas à s'excuser. Ararycan va bien, Ararycan court vite, donc Ararycan n'a pas été touché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270206,
					"content": "Tant mieux si tu vas bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "Il semble que le bras cassé du gros robot ait réussi à forcer l'entrée des ruines souterraines. Ça a quand même un peu marché, en fin de compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270208,
					"content": "Descendons pour jeter un œil. Peut-être que des choses mauvaises nous y attendent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270209,
					"content": "Ararycan vous accompagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302705",
							"2"
						],
						"stepId": 7302705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "La chose brillante là-dedans doit être le noyau du chaos dont parlait Jazari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Il est barré par des branches et des lianes, mais on dirait qu'il y a quelque chose qui s'en échappe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "Beurk, c'est une chose sale. Ararycan peut le sentir. C'est ce qui rend la forêt malade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Oh, il y a beaucoup de Mages de l'Abîme autour de ces grosses branches. J'ignore ce qu'ils manigancent, mais ça ne peut pas être quelque chose de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Je me souviens que monsieur Jazari disait que le sceau du noyau avait été endommagé. Peut-être que ces mages de l'Abîme y sont pour quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Bref, trouve un endroit où te cacher Ararycan. Arrêtons-les !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
