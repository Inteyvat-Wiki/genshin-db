					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Ce plat sera excellent, alors soyez prêt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Mon plat sera tout aussi bon, préparez-vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "#C'est vous, {M#voyageur}{F#voyageuse} ! Parvaneh et Julie sont allées chercher des ingrédients, et nous devons cuisiner leur repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Mais Munehisa et moi ne sommes pas d'accord sur le plat à préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Nous allons donc faire un duel de cuisine, et le gagnant pourra décider du menu d'aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Je vais préparer une spécialité de Liyue : la soupe aux perles et au jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "Et moi, ce sera des brochettes trois saveurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "Vous avez besoin de mon aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "#Eh bien, si vous êtes libre, nous avons besoin d'{M#un}{F#une} juge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Mais avec quatre portions de chaque plat à préparer, nous risquons d'être un peu dépassés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Aidez-nous donc à cuisiner avant de goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "#Choisissez le plat que vous souhaitez faire. Après tout vous êtes {M#seul}{F#seule} aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Vous vous en sortez, Xudong ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "Vous n'avez pas à vous inquiéter, j'ai été propriétaire d'un restaurant à Liyue. J'ai l'habitude de tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Mais avec un peu d'aide, le plat sera bien meilleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Bref, choisissez un plat qui vous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Xudong, laissez-moi vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "Oh, génial ! Munehisa, préparez-vous à mordre la poussière face à mon plat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "Je ne serai pas vaincu si facilement, alors faites ce que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Je vais vous aider, Munehisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Merci. Soyez préparé, sieur Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "Pas de problème. Faites de votre mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Vous vous en sortez, Munehisa ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Quand je travaillais pour le Shogunat, j'avais l'habitude de préparer des repas pour de nombreuses personnes. Cuisiner quatre plats n'est qu'un jeu d'enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "#Mais si vous êtes {M#prêt}{F#prête} à m'aider, je suis sûr que mes repas auront meilleur goût.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "Il doit vous manquer un juge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Hahaha, absolument. Nous avons besoin d'un juge pour goûter les plats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "#C'est tout. Merci, {M#voyageur}{F#voyageuse}. Ça sent bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Je vais goûter ça en premier... Waouh, c'est bon, les ingrédients sont bien mijotés et c'est plein d'arôme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Vous pourriez même dire qu'elle est parfaite, cette soupe aux perles et au jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "#Alors, Munehisa, comment ça se passe pour vous ? Montrez ça {M#au voyageur}{F#à la voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Eh bien, j'ai raté mon coup. Quand j'ai commencé à cuisiner, je me suis rendu compte que je n'avais pas préparé assez d'œufs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "J'ai immédiatement été en ramasser dans les bois voisins, mais les autres ingrédients ont déjà dépassé leur temps de traitement optimal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Des brochettes trois saveurs préparées avec des ingrédients si peu frais ne pourront jamais être considérées comme bonnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "J'ai honte d'avoir été si négligent, j'ai besoin de plus de formation en cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "J'ai perdu cette fois, mais je vous battrai certainement la prochaine fois, sieur Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "Bon courage, Munehisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Je ne me laisserai pas faire non plus, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "#Au fait, {M#voyageur}{F#voyageuse}, c'est pour vous. Merci de nous avoir assistés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "La prochaine fois qu'on s'affronte, assurez-vous d'être là aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Je trouve que ça a quand même bon goût...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Non. Même en cuisine, il ne faut pas se contenter d'un résultat passable. Je dois me dévouer à atteindre la perfection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "C'est ainsi que je pourrais me hisser au sommet de l'art culinaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "Oui, bien dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "Tout à fait !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Cette philosophie s'applique aussi bien aux arts martiaux qu'à la cuisine. Ma vie repose aussi dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Super, Munehisa ! C'est l'esprit qu'il faut avoir, haha... hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Pfiou, comment fait-on pour tenir la conversation avec quelqu'un d'aussi sérieux... Seule Julie est capable de cet exploit, mais elle n'est pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "En effet, ça m'intimide aussi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "#Ahem... Encore merci pour votre dur labeur, {M#voyageur}{F#voyageuse}... Prenez ceci, je v...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Sieur Xudong, j'aimerais vous poser quelques questions sur votre cuisine. Seriez-vous libre maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "Hein ? Oui, je suis libre ! J'arrive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202103,
			"completionStepIds": [
				2202110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202110",
							"2"
						],
						"stepId": 2202110,
