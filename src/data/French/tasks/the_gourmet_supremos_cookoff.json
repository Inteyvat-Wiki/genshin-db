			},
			"dialogs": [
				{
					"id": 220210701,
					"content": "Merci de bien vouloir m'aider. Les brochettes trois saveurs sont simples à préparer, mais elles nécessitent des ingrédients particulièrement frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "J'ai préparé tous les autres ingrédients, mais il me faudrait plus d'œufs... Par précaution, pourriez-vous aller me chercher deux œufs frais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "S'il vous plaît, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "Comment avez-vous appris à cuisiner ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Lorsque je servais encore au sein du Shogunat, j'avais l'habitude d'en préparer pour les partager avec quelques-uns de mes collègues officiers autour d'un verre de sake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Mais maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Ne parlons pas du passé. Je vous laisse chercher les œufs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Je vais m'occuper des ingrédients ici, alors apportez-moi les œufs dès que vous les avez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
