			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Hmm. Avec cette odeur et cette apparence... Ces brochettes trois saveurs devraient en fait s'appeler « brochettes saveur suprême » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "« Brochettes saveur suprême » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Oh, je veux dire que c'est un plat parfait... Eh bien, voyez-vous l'heure ! La soupe aux perles et au jade de sieur Xudong devrait aussi être prête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Bien sûr ! Et voilà ma soupe aux perles et au jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Je n'ai pas eu le temps de bien préparer les ingrédients, alors elle peut être un chouïa trop cuite, mais délicieuse quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Laissez-moi goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Il y a bien un léger goût de brûlé. Pas au point de gâcher le plat, mais un défaut reste un défaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Hahahaha, je me suis précipité aujourd'hui. La prochaine fois, je préparerai tous les ingrédients à l'avance pour ne pas avoir ce problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "J'ai perdu cette fois-ci, mais je ne ferai pas la même erreur la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Vous avez été négligent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Hahaha... Vous avez raison, j'ai perdu contre Munehisa à cause de ça. Je ferai attention la prochaine fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "#Au fait, {M#voyageur}{F#voyageuse}, c'est pour vous. Merci de nous avoir assistés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "La prochaine fois qu'on s'affronte, assurez-vous d'être là aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Les « brochettes saveur suprême » de Munehisa étaient meilleures.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Les brochettes saveur suprême ? Qu'est-ce que c'est que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Cela signifie que ces brochettes trois saveurs sont parfaites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "« Suprême » car il ne faut jamais se contenter d'un résultat passable et toujours rechercher la perfection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Ce n'est qu'avec cette approche que l'on peut se hisser au sommet de l'art culinaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Oui, bien dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "Tout à fait !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "Cette philosophie s'applique aussi bien aux arts martiaux qu'à la cuisine. Ma vie repose aussi dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Venez, sieur Xudong. Permettez-moi de vous en parler davantage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "#Ah ? Euh... Attendez un peu, j'arrive. {M#Voyageur}{F#Voyageuse}, prenez ceci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Pfiou, comment fait-on pour tenir la conversation avec quelqu'un d'aussi sérieux... Seule Julie est capable de cet exploit, mais elle n'est pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Allez, c'est l'heure pour vous d'étudier la cuisine suprême.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Sieur Xudong ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Hein ? J'arrive, tout de suite ! Tout de suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
