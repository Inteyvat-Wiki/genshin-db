			"dialogs": [
				{
					"id": 220210601,
					"content": "Commençons. Pour la soupe aux perles et au jade, il faut des gueules-de-loup, du tofu et des fruits du lotus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210602
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210602,
					"content": "Des fruits du lotus... Du tofu... Bon, ça va, il m'en reste. Mais les gueules-de-loup n'ont pas l'air de suffire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210603
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210603,
					"content": "#{M#Voyageur}{F#Voyageuse}, je m'occupe des ingrédients que j'ai déjà. Juste au cas où, pouvez-vous aller me chercher trois autres gueules-de-loup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
