			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Hein ? Les enfants, vous êtes là pour me voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830202,
					"content": "À propos des graines d'herbe à sanglots...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Des graines... Euh, vous voulez planter ce genre de graines dans la Sérénithéière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830204,
					"content": "Ce n'est pas impossible, après tout, c'est un petit monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830205,
					"content": "Seulement, vous n'avez apporté que ce paquet de graines aujourd'hui, vous n'allez planter que ce seul paquet de graines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830206,
					"content": "Ah oui ! Nous ne savons même pas comment collecter les graines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Après avoir planté ce paquet, où trouve-t-on le reste des graines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "OK, bien, calmez-vous. J'ai une petite boîte que j'ai utilisée il y a des années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830209,
					"content": "Lorsque j'ai transplanté des fleurs auparavant, j'ai utilisé cette petite boîte pour les contenir, et elles peuvent être conservées longtemps dans la boîte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830210,
					"content": "De plus, après avoir mis les fleurs dans la boîte, cette boîte peut également faire sortir plusieurs graines de fleurs... Vous pouvez les planter facilement si vous le souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830211,
					"content": "Bien que la boîte ne soit pas aussi efficace maintenant... Au moins, elle est encore en mesure de « transformer les graines ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830212,
					"content": "Eh bien... Je n'utilise plus la boîte de toute façon... Je vais vous la donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830213,
					"content": "Que vous souhaitiez faire pousser des fleurs et des herbes ou d'autres cultures, cette boîte devrait vous être utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830214,
					"content": "Merci Madame Ping !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "Merci Madame Ping !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "Oh, je vous en prie, allez-y et essayez, mais s'occuper des fleurs n'est pas une tâche facile, alors préparez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830217,
					"content": "Madame Ping est vraiment forte... Mais avant d'examiner cette boîte, retournons dans la « Sérénithéière » et essayons de planter cette graine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "J'aimerais que ces graines poussent vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}