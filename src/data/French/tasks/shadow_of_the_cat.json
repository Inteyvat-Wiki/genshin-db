			},
			"dialogs": [
				{
					"id": 220450401,
					"content": "Alors ? Vous avez les photos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450402,
					"content": "Oui, elles sont là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "Voyons voir... Oh ! Cet angle... Cette pose... Vraiment pas mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450404,
					"content": "Vous êtes tout content...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "C'est mieux que ce que j'espérais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450407,
					"content": "#Merci énormément, {M#voyageur}{F#voyageuse}. Prenez ça en cadeau, je vais me mettre au travail tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450408,
					"content": "Ah, mais c'est pas mal du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450405,
					"content": "Ça ira ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				}
			]
		},
