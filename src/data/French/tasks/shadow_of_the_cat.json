			"dialogs": [
				{
					"id": 220450301,
					"content": "Hmm ? Que faites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Je prends des photos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "... Qu'est-ce que c'est ? Vous êtes vraiment bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Peu importe, tant que vous ne mettez pas le désordre au sanctuaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2204504,
