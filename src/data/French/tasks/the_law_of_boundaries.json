			"dialogs": [
				{
					"id": 100090101,
					"content": "Hmm... Au vu des résultats précédents, je devrais apporter quelques ajustements à l'expérience et m'assurer que tout le matériel est bien en place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090102,
					"content": "#Quant à la potion que je dois préparer... Oh, {NICKNAME}, Paimon ! Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090103,
					"content": "On est venus t'aider avec ta « tâche ». On se demandait si tu n'avais pas besoin d'un coup de main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "Ma « tâche »... Oh, vous voulez dire celle dont monsieur Albedo m'a parlé ? Celle de l'Hexenzirkel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090105,
					"content": "Eh bien, tu arrives juste à temps. L'expérience est en cours, et j'étais sur le point de m'y mettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090106,
					"content": "En cours ? Tu travailles dessus depuis tout ce temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Oui, c'est en rapport avec d'autres sujets de recherche sur lesquels je travaille, alors je n'ai pas trop eu de travail supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090108,
					"content": "Mais bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090109,
					"content": "Quoi ? Y a-t-il un problème avec l'expérience ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "Ce n'est pas une grande réussite pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090111,
					"content": "Ah, tu enchaînes les échecs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "Ce n'est pas aussi simple. Le cadre théorique derrière cette tâche est un peu plus complexe que ce que j'imaginais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090113,
					"content": "En quoi consiste cette tâche au juste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Ah oui, c'est vrai ! Tu ne nous as toujours pas dit quel type d'expérience c'était.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "Une expérience pour créer une potion capable de transformer les fleurs sucrantes en une variante seize fois plus grande que leur taille normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090116,
					"content": "C'est-à-dire, la formulation du réactif d'augmentation botanique de type IV, version 7. Comme vous pouvez le deviner, c'est la septième fois que je mène cette expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090117,
					"content": "Waouh ! En gros, on doit fabriquer un sérum de croissance ! Ou plutôt, sa septième version.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "Hum, oui... C'est à peu près ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090119,
					"content": "C'est ma septième tentative, mais je n'ai pas fait beaucoup d'ajustements à la formule cette fois-ci, car les principes théoriques sur lesquels se basent cette expérience et les résultats du processus prouvent que tout va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090120,
					"content": "Mais tu n'as pas encore « réussi ». C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Oui. Je ne pense pas que ma formule actuelle est fausse en soi, mais plutôt... qu'il manque un autre élément clé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090122,
					"content": "Ohhh... Je sais exactement quoi faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Laisse-nous t'aider !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "Oui ! C'est pour ça qu'on est là, après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Hum, on pourrait essayer, mais c'est juste que... je devrais ajuster les proportions de la formule originale, ce qui rendrait la potion encore plus instable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090128,
					"content": "Non, on ne va pas essayer ça ! Montre-nous plutôt l'original !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "La voici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090130,
					"content": "Cela dit, il me manque encore deux ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090131,
					"content": "On peut t'aider avec ça. De quoi as-tu besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "J'ai besoin d'eau de source de Deauclaire comme base, ainsi que des fragments de Noyau de tempête... mais ces derniers risquent d'être délicats à obtenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090133,
					"content": "On s'en occupe ! Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "On pourrait peut-être ajouter un peu d'essence de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Héhé, c'est pour ça qu'on t'aide... Hé oh, je ne suis PAS un ingrédient !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
