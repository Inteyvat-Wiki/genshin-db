				]
			},
			"dialogs": [
				{
					"id": 100090901,
					"content": "Bon, on a versé le sérum de croissance sur les fleurs... C'est tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090902,
					"content": "Oui. Les fleurs doivent absorber complètement la potion, ça mettra un peu de temps avant de voir une réaction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090903
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090903,
					"content": "Que se passe-t-il ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090904,
					"content": "Les fleurs vont grandir tout en conservant leur apparence d'origine. Mais lorsqu'elles atteindront 12 à 14 fois leur taille normale, ce sera plus qu'elles ne peuvent supporter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090905
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090905,
					"content": "Elles se flétrissent et pourrissent comme si une limite avait été atteinte, puis prennent une forme anormale jusqu'à ce qu'elles se réduisent en liquide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090906
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090906,
					"content": "Attends, quoi ? Ça veut dire qu'il y a problème avec le sérum de croissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090907,
					"content": "Non. J'ai ajusté la formule à maintes reprises pour résoudre tous les problèmes qui surviennent lorsqu'on fait pousser des petites plantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090908
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090908,
					"content": "Des problèmes comme... s'assurer que les feuilles ne deviennent pas trop grandes, renforcer le diamètre des racines et leur capacité de charge, calculer comment l'augmentation de la surface pourrait affecter l'exposition au soleil et la nutrition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090909
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090909,
					"content": "Alors pourquoi ça ne fonctionne pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090910,
					"content": "Parce que les fleurs ne peuvent pas se transcender... « Ce qui est en haut est comme ce qui est en bas » est l'un des principes fondamentaux de l'alchimie. L'alchimie cherche la maîtrise de la matière, mais ce monde a ses limites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090911
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090911,
					"content": "C'est comme... ne « spécification » gravée dans la loi qui régit toutes choses. L'un des objectifs de ces expériences multiples est de déterminer la stabilité de cette « spécification ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090912
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090912,
					"content": "L'« échec » est donc un résultat valable aussi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090913
					]
				},
				{
					"id": 100090913,
					"content": "Exactement. Ça prouve que la limite « continue d'exister ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090914
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090914,
					"content": "Bon, j'ai un peu de mal à suivre, mais en gros... Tu avais besoin que l'expérience échoue pour prouver que les limites et les frontières de ce monde sont stables ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090915,
					"content": "Quelle étrange expérience... Oh ? On dirait qu'une des fleurs réagit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090916,
					"content": "Attends une seconde... Ce n'est pas du tout une fleur sucrante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090917,
					"content": "Attention ! C'est Une Fleur mensongère ! Elle a dû absorber une partie de la potion. Hé, mais c'est déjà arrivé avant. Pourtant, elle n'avait jamais atteint cette taille. Est-ce que ça voudrait dire que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090918
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090918,
					"content": "On en parlera plus tard. Débarrassons-nous d'abord de cette chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
