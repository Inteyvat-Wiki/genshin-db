			"dialogs": [
				{
					"id": 100090801,
					"content": "C'est ça... Ton exécution était parfaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Oui, je ne vois aucun défaut dans la préparation... Je vais en extraire un peu pour regarder la composition du produit. Un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose prélève un peu de potion et en examine la composition avec un appareil...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Comme je l'ai dit, l'exécution est parfaite. La potion est impeccable. C'est exactement ce à quoi je m'attendais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "La septième fois aura été la bonne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Après l'avoir examinée, la potion est identique aux six versions précédentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Oh... Mais dans ce cas, les résultats seraient identiques, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Pas nécessairement. Les résultats expérimentaux peuvent varier, malgré des variables similaires. On ne sait jamais quel sera le résultat, et c'est justement ce qui rend les expériences si précieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Allez, testons-la. J'ai planté à l'avance des fleurs sucrantes que nous pourrons utiliser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "Il nous suffit de les arroser avec la potion et de voir ce qui se passe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
			"id": 1000909,
			"completionStepIds": [
				1000909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
