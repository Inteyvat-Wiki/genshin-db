			"dialogs": [
				{
					"id": 100091101,
					"content": "Pfiou, c'est fini. Même avec cette taille, une Fleur mensongère reste une Fleur mensongère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091102,
					"content": "... Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091103,
					"content": "Mais, euh... c'était censé devenir aussi grand ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091104,
					"content": "Je n'ai pu faire qu'une estimation approximative pendant le combat, mais elle faisait au moins... 16 fois sa taille d'origine, peut-être même plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091105,
					"content": "Ça veut dire que l'expérience... a fonctionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091106,
					"content": "Attends, mais n'est-ce pas une bonne chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Je n'en suis pas encore certaine... mais si on parvient à reproduire ce résultat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091108,
					"content": "Ça voudrait signifier que quelque chose a changé... Peut-être que les limites et les lois de ce monde sont en train de se transformer à cause d'un facteur inconnu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091109,
					"content": "Je ne saurais pas dire si c'est une bonne ou une mauvaise chose, mais d'un point de vue alchimique, ces frontières élargies signifient que de nouvelles possibilités s'ouvrent à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091110,
					"content": "En tout cas, ma tâche s'arrête ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091111,
					"content": "On dirait bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Hmm. Cela dit, ça pourrait aussi être en raison de la personne qui a préparé la potion. Il y avait peut-être aussi quelque chose de particulier avec cette Fleur mensongère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091113,
					"content": "Il y a encore beaucoup de choses à confirmer, je suppose que cette tâche ouvre la voie à d'autres questions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091114,
					"content": "On sera là si tu as besoin d'aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "On pourrait essayer d'utiliser ce sérum de croissance sur Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Héhé, imagine un peu... Si j'étais 16 fois plus grande, je pourrais écrbouiller toute une bande de Pilleurs de trésors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "J'ai des doutes. Si le sérum a fonctionné sur la Fleur mensongère, c'est uniquement parce que sa structure interne était assez proche de celle d'une fleur sucrante... Si tu en buvais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091118,
					"content": "Tu pourrais devenir 16 fois plus grande, mais tu pourrais aussi te transformer en une forme de vie végétale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091119,
					"content": "Ouais, non. Hors de question, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "Au fait, je voulais te demander... Pourquoi toutes tes recherches portent-elles sur des choses comme les fleurs sucrées et les pommes crépusculaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Oh, parce que le nectar des pommes crépusculaires et des fleurs sucrantes est sucré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091122,
					"content": "Du coup, faire accidentellement grandir une Fleur mensongère 16 fois plus que sa taille normale a un avantage, car son nectar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091123,
					"content": "... a exactement le même goût que celui des fleurs sucrantes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091124,
					"content": "Exactement ! Une fois que j'aurai extrait le sucre du nectar, je t'en donnerai un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091125
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091125,
					"content": "Héhé, ça marche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
