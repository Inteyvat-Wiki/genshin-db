			"dialogs": [
				{
					"id": 100090601,
					"content": "Bon, les ingrédients sont prêts, et le chaudron est juste là-bas, on devrait pouvoir commencer. Mais, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "Quelque chose ne va pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "Non, non. C'est juste que... Ça ne vous dérange pas si j'observe depuis le côté ? C'est uniquement pour assurer une documentation précise, bien sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "Je sais que beaucoup de gens n'aiment pas être observés pendant leurs expériences, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "Aucun problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Merci. Je suis prête quand vous l'êtes. Je prendrai aussi des notes détaillées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "#Êtes-vous {M#prêts}{F#prêtes} à commencer l'expérience ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
