				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "Des feuilles mortes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "C'est pas un présage, ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071203,
					"content": "Bien sûr que si !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071204,
					"content": "Ces feuilles mortes sont peut-être... mortes, mais moi, je l'interprète autrement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071205,
					"content": "Il suffit d'une étincelle pour les embraser ! Le vent peut aussi les emporter loin dans le ciel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071206,
					"content": "Cette analogie est bien celle de mon amour à sens unique. Avec un peu de chance, Qiming et moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071207
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071207,
					"content": "Ahem, le destin décidera de ça. Je ne sais même pas comment cette chance se manifestera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071208,
					"content": "Je ne dois pas déprimer et prendre mon mal en patience, car tout arrive en temps et en heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071209
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071209,
					"content": "Merci quand même...",
