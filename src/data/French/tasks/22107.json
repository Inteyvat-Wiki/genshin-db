			"dialogs": [
				{
					"id": 221071401,
					"content": "J'ai vu un groupe de chiens...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071402
					]
				},
				{
					"id": 221071402,
					"content": "Malheur ! Ma vie amoureuse est-elle vouée à l'échec avant même d'avoir commencé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Ah bon ? Pourtant, ces chiens avaient l'air d'être copains comme cochons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "Je sais de quels chiens vous parlez. Ils sont tout le temps fourrés ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "Comme ça, on croirait que c'est de bon augure, mais ces chiens restent ensemble parce qu'ils n'ont pas encore de partenaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Ils finiront par vieillir, puis il sera trop tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Est-ce que ça signifie que je vais devoir passer le restant de ma vie avec mes amis, car je ne trouverai jamais mon âme sœur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "Excusez-moi, j'ai besoin d'être seul pendant un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
