				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "J'ai vu des inséparables sur le toit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Super ! C'est de bon augure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071003,
					"content": "Deux colombes qui se sont séparées de leur groupe pour vivre leur amour ensemble et s'envoler vers de nouveaux horizons rien que tous les deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071004,
					"content": "C'est le signe que je vais bientôt rencontrer l'amour de ma vie ! Oh oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071005,
					"content": "Elle bravera les vents et les marées qui nous séparent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071006,
					"content": "Ah, euh, merci à vous, merci infiniment ! Je vais voir Qiming de ce pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
				2210711
			],
