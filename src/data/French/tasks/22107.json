				{
					"id": 221071701,
					"content": "Des feuilles mortes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071702
					]
				},
				{
					"id": 221071702,
					"content": "C'est pas un présage, ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071703,
					"content": "Bien sûr que si !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071704
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071704,
					"content": "Ces feuilles mortes sont peut-être... mortes, mais moi, je l'interprète autrement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071705
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071705,
					"content": "Il suffit d'une étincelle pour les embraser ! Le vent peut aussi les emporter loin dans le ciel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071706
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071706,
					"content": "Cette analogie est bien celle de mon amour à sens unique. Avec un peu de chance, Qiming et moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071707
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071707,
					"content": "Ahem, le destin décidera de ça. Je ne sais même pas comment cette chance se manifestera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071708
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071708,
					"content": "Je ne dois pas déprimer et prendre mon mal en patience, car tout arrive en temps et en heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071709
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071709,
					"content": "#Tout comme je suis {M#arrivé}{F#arrivée} pour ces feuilles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071710
					]
				},
				{
					"id": 221071710,
					"content": "Que voulez-vous dire par là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071711
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071711,
					"content": "Hé, ne me dites pas que vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071712
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071712,
					"content": "Ma vie amoureuse est fichue ! Vous avez perturbé la nature des choses, et vous avez tout ruiné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071713
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071713,
					"content": "Qu'est-ce que vous avez fait ?! C'est sympa de vouloir m'aider, mais vous avez tout ruiné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071714
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071714,
					"content": "Allez embêter quelqu'un d'autre, j'ai besoin qu'on me laisse seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
