				"points": []
			},
			"dialogs": [
				{
					"id": 221071601,
					"content": "J'ai vu des inséparables sur le toit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "Super ! C'est de bon augure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Deux colombes qui se sont séparées de leur groupe pour vivre leur amour ensemble et s'envoler vers de nouveaux horizons rien que tous les deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "C'est le signe que je vais bientôt rencontrer l'amour de ma vie ! Oh oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "Elle bravera les vents et les marées qui nous séparent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "Ahem ! Merci de m'avoir aidé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Quel coup du destin les a amenés à se rencontrer et à s'éprendre l'un de l'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "*soupir* Dommage que je ne sois pas une colombe. Je ne pourrais jamais ressentir l'amour de mon âme sœur sur mon bec... Quelle tragédie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Vous pouvez toujours en manger si vous le souhaitez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "En manger ? ... Attendez, vous n'avez pas fait ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "Je ne disais pas ça pour de vrai ! C'était une métaphore ! L'amour ça ne se mange pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "#Il y a des gens qui ne comprennent rien au romantisme, mais vous êtes vraiment {M#le pire de tous}{F#la pire de toutes} ! Mon avenir amoureux est fichu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "Je... Non, rien. J'ai besoin d'être seul pour me calmer. Reprenez ce que vous étiez en train de faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
