					"content": "Je sais de quels chiens vous parlez. Ils sont tout le temps fourrés ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071905,
					"content": "Comme ça, on croirait que c'est de bon augure, mais ces chiens restent ensemble parce qu'ils n'ont pas encore de partenaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071906,
					"content": "Ils ne sont jamais seuls, alors ils ne s'en rendent pas compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071907,
					"content": "Maintenant, si.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "Pourquoi ? ... Ne me dites pas que vous les avez dispersés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071909,
					"content": "... Tout compte fait, votre technique pourrait bien marcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071910,
					"content": "Parfois, nous avons besoin d'un bon coup de pied au derrière pour nous sortir de notre zone de confort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071911,
					"content": "Génial ! Merci de m'avoir ouvert les yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071912,
					"content": "Qiming, un jour vous verrez...",
					"roleType": "TALK_ROLE_NPC",
