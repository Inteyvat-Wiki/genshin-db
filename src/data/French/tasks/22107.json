					"content": "Surtout envers ce poisson qui a su faire abstraction de la nature de prédateur du chat et a mis ses sentiments et son âme à nu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071807
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071807,
					"content": "#Je suis {M#ravi}{F#ravie} qu'il en soit ainsi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
