					"nextDialogs": [
						221071809
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071809,
					"content": "Comment avez-vous pu arracher ce poisson à son ami félin ? Quel manque de cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071810,
					"content": "Nous venons d'assister à une amitié inter-espèce très rare et vous gâchez tout, alors que vous auriez dû la protéger ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Tout aurait été parfait sans votre intervention...",
