					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "Tout comme l'amour, cette amitié transcende tous les obstacles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "J'éprouve le plus grand respect à leur égard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Ils m'ont montré ce que je dois faire : braver toutes les difficultés sur mon chemin pour enfin vivre mon histoire d'amour ! Oui ! Qiming s'en rendra compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "Bref, merci ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
