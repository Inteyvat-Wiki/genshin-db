			},
			"dialogs": [
				{
					"id": 751200201,
					"content": "#Hmm ? {M#Guerrier étranger}{F#Guerrière étrangère}, voulez-vous relever ce défi guerrier ? Je viens d'ajuster les intervalles de chute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200204
					],
					"speakerTitle": "Kinne",
					"speakerSubtitle": "Maîtresse-formatrice des Maîtres du vent nocturne"
				},
				{
					"id": 751200204,
					"content": "En ce qui concerne les intervalles dont je viens de parler... Vous verrez une fois que vous aurez commencé. Qu'en dites-vous ? Ça vous dit d'essayer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200202,
						751200203
					],
					"speakerTitle": "Kinne",
					"speakerSubtitle": "Maîtresse-formatrice des Maîtres du vent nocturne"
				},
				{
					"id": 751200202,
					"content": "Commençons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751200203,
					"content": "Un instant, je dois me préparer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
