			},
			"dialogs": [
				{
					"id": 751200101,
					"content": "Vous pouvez sauter d'un endroit élevé comme bon vous semble, mais il faut bien choisir l'endroit où vous atterrissez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200104
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Maître-formateur des Maîtres du vent nocturne"
				},
				{
					"id": 751200104,
					"content": "#C'est pourquoi ce défi guerrier a été mis en place. Peu importe votre niveau, vous devez faire attention à ce que vous faites... Voulez-vous tenter de le relever, {M#guerrier étranger}{F#guerrière étrangère} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200102,
						751200103
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Maître-formateur des Maîtres du vent nocturne"
				},
				{
					"id": 751200102,
					"content": "Commençons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Maîtresse-formatrice des Enfants des échos"
				},
				{
					"id": 751200103,
					"content": "Je dois me préparer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Maîtresse-formatrice des Enfants des échos"
				}
			]
		},
