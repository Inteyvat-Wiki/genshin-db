						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Pardon, j'étais venue pour observer la mer, ça n'a pas du être facile de me trouver... Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Rentrez vous réfugier à Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "À cause des météorites ? Je sais, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "Vind"
