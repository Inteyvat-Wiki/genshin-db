			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "On devrait faire une pause dans nos recherches et retourner en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "Mais une occasion comme celle-ci ne se représentera pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 411200303,
					"content": "Vous devriez vous réfugier à Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "Encore ? L'heure n'est pas à la fuite, mais à l'exploration ! Ces météorites sont peut-être la clé pour enfin trouver l'entrée du Temple des Mille Vents !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 411200305,
					"content": "L'entrée du Temple des Mille Vents ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Ce que veut dire Patty, c'est que peut-être qu'une de ces météorites aura créé une ouverture en atterrissant sur le temple. Auquel cas on n'aura plus qu'à suivre le chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "Mais c'est prendre ses désirs pour des réalités. Un pas de travers, et on se retrouve endormis à jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "Allez, on ferait mieux de rentrer en ville. Et s'il y a vraiment une ouverture créée par les météorites, on peut toujours revenir plus tard, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "Et si quelqu'un d'autre a la même idée ? Si tu veux rentrer, ne te prive pas. Moi, je reste ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "Patty la Curieuse"
				},
				{
					"id": 411200310,
					"content": "#*soupir* Comme tu voudras. {M#voyageur}{F#voyageuse}, toutes mes excuses. Je crois bien qu'on va rester par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "Ne vous inquiétez pas. Je saurai quoi faire en cas de... danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Ah oui, on a croisé il y a un moment un type qui avait l'air terrifié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "Il nous a demandé à boire, a dit qu'il voulait rentrer à Mondstadt, et est parti aussi vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "Mais il s'est mis à courir dans la direction du Coin du guet, pas de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Peut-être qu'il était trop terrifié pour garder l'esprit clair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "Je serais vous, j'irai du côté du Coin du guet voir si je peux le retrouver. Mieux vaut éviter qu'il lui arrive quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "Je vais rester ici avec Patty. S'il se passe quelque chose... Eh bien, je me débrouillerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
		{
			"id": 4112004,
