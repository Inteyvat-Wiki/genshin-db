			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "J'espère que tout le monde va bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200102,
					"content": "Pourquoi êtes-vous inquiète ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "#Oh, {M#voyageur}{F#voyageuse}, c'est vous. Vous devez être au courant de ces météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200104,
					"content": "C'est une chance qu'elles n'aient pas atterri dans l'enceinte de Mondstadt, mais les environs sont un autre spectacle. Je m'inquiète pour ceux qui se trouvent encore à l'extérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200105,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce trop vous demander d'aller les chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200106,
					"content": "Dites-leur que Mondstadt peut être leur refuge, et qu'ils y seront en sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200107,
					"content": "Entendu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200112,
					"content": "Vous pouvez d'abord aller demander à Lynn si elle sait s'il reste encore des personnes dehors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200113,
					"content": "Puis essayez de la convaincre de se réfugier à l'intérieur de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200114,
					"content": "Ce n'est vraiment pas le moment de s'entraîner à la survie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200109,
					"content": "Comment se fait-il que la cité ait été épargnée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "Nous avons eu de la chance. La Cité de Mondstadt a toujours été un endroit sûr, de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200111,
					"content": "Au moins, être ici vaut mieux qu'être dehors, vous n'êtes pas d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112002",
							"2"
						],
						"stepId": 4112002,
						"stateName": "QUEST_STATE_UNFINISHED"
