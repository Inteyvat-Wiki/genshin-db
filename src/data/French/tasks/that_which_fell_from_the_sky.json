						411200602
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200602,
					"content": "Donc vous allez rentrer à Mondstadt ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "Toutes mes excuses, mais c'est impossible pour l'instant. Les pluies de météorites ne sont pas un phénomène ordinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200604,
					"content": "Avec une météo comme celle-ci, une tempête est vite arrivée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200605,
					"content": "Je dois rester ici monter la garde pour pouvoir avertir la ville au cas où ça se produirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200606,
					"content": "#Merci d'être {M#venu}{F#venue} me voir. Je serai prudente, promis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
