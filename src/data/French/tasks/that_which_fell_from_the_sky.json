					"nextDialogs": [
						411200811
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 411200811,
					"content": "À force de tourner en rond, j'ai fini par me retrouver au Coin du guet à nouveau, mais toujours pas de sœur Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "Shute le terrifié"
				},
