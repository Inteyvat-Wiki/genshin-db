				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200401,
					"content": "Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200402,
					"content": "Je vous cherchais.",
