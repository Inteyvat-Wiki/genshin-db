			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "Ah, rien de tel que ces conditions difficiles pour s'entraîner à survivre dans la nature... Voilà un vrai challenge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Tu serais mieux réfugiée à Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "Me réfugier ? Allons, pas besoin de se faire de bile pour moi ! Je fais toujours gaffe à mon environnement, il ne m'arrivera rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "Et toi, alors ? Tu fais quoi ici au lieu d'être à l'intérieur de la cité ? Tu ferais mieux de repartir avant de te recevoir une météorite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Est-ce qu'il y a d'autres personnes à l'extérieur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "D'autres, tu dis ? Il y en a, et pas mal en plus. Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "Pour leur demander de rentrer se réfugier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Ah, je vois... Si mes souvenirs sont bons, la Guilde a déjà fait paraître un ordre de mission de ce genre. J'ai aussi été avertir pas mal de monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "Ceux qui sont près de Mondstadt sont déjà tous sans doute à l'abri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "Mais il reste les aventuriers qui n'ont pas encore été prévenus, faute d'effectif. Un coup de main de ta part ne nous ferait pas de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Laisse-moi me souvenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "Ah ! Patty et Doolan sont toujours près du Temple des Mille Vents. Je leur ai touché deux mots sur les météorites, mais pas moyen de les faire bouger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "Il y a aussi sœur Vind au Coin du guet. La Guilde m'a envoyée la chercher, mais elle était absente à chaque fois que j'y suis passée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "C'est tout ce dont je me rappelle... Va vite leur dire de rentrer à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "De mon côté, j'irai aussi faire le tour des environs pour informer le plus de gens possible après avoir fait le plein de nourriture et de produits de première nécessité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Espérons qu'ils ne soient pas partis à l'autre bout du monde, ou ça sera un sacré boulot de les ramener...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "Sœur Grace se fait un sang d'encre pour eux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "Sœur Grace ? Ah, c'est à cause d'elle... Si mes souvenirs sont bons, la Guilde a déjà fait paraître un ordre de mission de ce genre. J'ai aussi été avertir pas mal de monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "Ceux qui sont près de Mondstadt sont déjà tous sans doute à l'abri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "Mais il reste les aventuriers qui n'ont pas encore été prévenus, faute d'effectif. Un coup de main de ta part ne nous ferait pas de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
		{
