			"dialogs": [
				{
					"id": 411200701,
					"content": "Ah, vous êtes de retour. Alors, vous les avez trouvés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200702,
					"content": "On leur a dit de rentrer, mais ils refusent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "Ils refusent ? Qu'est-ce qui peut bien les retenir à l'extérieur de la ville ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200704,
					"content": "Les Mondstadtois et la liberté...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "Hahaha... Ha... Vous avez raison, on ne rigole pas avec la liberté ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200706,
					"content": "Mais en ce moment, je préférerais qu'ils l'oublient un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200707,
					"content": "*soupir* Et les chevaliers de l'Ordre ont les mains prises, ils ne pourront pas s'en occuper... Bon, je vais trouver un autre moyen. Merci à vous.",
					"roleType": "TALK_ROLE_NPC",
