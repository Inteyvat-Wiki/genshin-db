			"dialogs": [
				{
					"id": 150420101,
					"content": "Wouhou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "Du soleil, des vagues et des koholasaures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "Elle a tellement hâte qu'elle oublie que son antique nom est « Um{RUBY#[S]Unité}oja ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "Allez, vite ! Par ici ! Dépêchez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "On arrive !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "Regardez ! Qu'est-ce que c'est, d'après vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Une planche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "Lisez ce qu'il y a d'écrit dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Oh, c'est une carte touristique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "Exactement ! Une carte touristique ! C'est une clé vers un énorme trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Je comprends complètement. Ce genre de cartes marque le début d'une aventure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "Un peu comme une particule phlogistique qui brûle, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "Du phlogistique ? Euh... C'est un type d'énergie ? Tu veux dire qu'un simple regard peut te remplir d'une motivation infinie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "Oui ! Parce que c'est très important aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Avec une carte en main qu'on peut consulter à tout moment, on est libres de se frayer le chemin de notre aventure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Héhé ! Liberté et aventure, bien dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Attends, ne sois pas d'accord avec elle aussi vite... Pourquoi j'ai l'impression que Mualani nous cache quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "Allez, on y va ! Chacun de son côté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "Quel genre de guide touristique part après avoir atteint une destination ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Mualani veut peut-être explorer les environs seule...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#Tu es vraiment {M#un bon ami}{F#une bonne amie} ! Je n'oublierai pas ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Regardez, tout le monde. Ces deux grandes attractions sont encore en phase de test. Peut-être qu'elles ont eu des problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "Pourquoi ne pas nous séparer pour aller voir l'attraction qui nous intéresse le plus ? On s'amusera, tout en contribuant aux tests. Si ça se trouve, grâce à nous, la Baie vaguelée pourra ouvrir plus vite que prévu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "Et moi qui pensais que vous nous abandonneriez dès que vous auriez pu vous amuser dans l'eau. Finalement, vous avez pris en compte l'intérêt du groupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Héhé ! Retrouvons-nous près du bâtiment géant en forme de koholasaure quand on aura terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "Selon mon expérience de guide, je parie que l'entrée du défi principal se situe dans le coin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Super ! Allons-y, et n'oubliez pas de regarder la carte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "On dirait que notre « guide » est aussi en vacances aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
			"id": 1504213,
