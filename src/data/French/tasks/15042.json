			"dialogs": [
				{
					"id": 150421701,
					"content": "Beau travail, Mualani !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "Pfiou... C'était génial ! Comment je m'en suis sortie ? Pas mal, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "C'est splendide ! Pas étonnant que tu fasses partie des six héros !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Pendant ton absence, Paimon m'a parlé de toi et j'ai été très impressionné par tes exploits. C'était tellement palpitant que j'avais l'impression de m'enflammer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Haha, merci ! Tes compliments me touchent beaucoup ! Je suis super motivée en ce moment, au point de pouvoir organiser une fête de source chaude ici même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Regardez, le personnel de la Baie vaguelée est là aussi ! Après tout ce travail, ils doivent être impatients de pouvoir enfin se détendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Je pense que tu te trompes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "Mualani ! Pourrais-je avoir un autographe, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "Moi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150421712,
					"content": "Vous vous êtes fait repérer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "Vite, prenons la photo de groupe avant que la foule n'arrive !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "Faites un grand sourire et soyez confiants ! Pensez à l'océan et à vos couleurs porte-bonheur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421715,
					"content": "Trois, deux, un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421716,
					"content": "Koholasaure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421717
					],
					"speakerTitle": "Paimon"
				},
				{
