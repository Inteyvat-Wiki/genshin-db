			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Bien vu. Je ne pensais pas que tu me remarquerais ici en haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "On dirait que les installations t'intéressent aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "Sont-elles amusantes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "Je pense qu'elles sont pas mal du tout, mais la notion d'amusement est subjective. Mes paroles seules ne te convaincront pas, il faut que tu les essayes toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "Tu vois les rails là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Utilise les balles de peinture pour colorer les boules alignées dessus. Une fois qu'elles sont toutes de la même couleur, elles disparaîtront en éclatant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "Je veux dire par là qu'une autre se tiendra à proximité avec son propre pistolet. Il attendra pour envoyer ces balles colorées en l'air lorsque le moment sera venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "Trop bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Ma parole n'a aucune valeur si tu n'essayes pas. Prends ce pistolet là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "Je vais te regarder jouer cette fois-ci. Bonne chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "J'y croirais presque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "C'est compliqué de se déplacer ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Détends-toi, c'est facile. Pas étonnant, vu le nom de cet endroit. Tu ne trouveras rien de « compliqué » ou de « difficile » ici, même si tu cherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
