			"dialogs": [
				{
					"id": 150421501,
					"content": "Bon, faisons le compte. Un, deux, trois, quatre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421502,
					"content": "Il y a quelqu'un en plus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421503,
					"content": "Bonjour ! J'imagine que vous êtes ici pour relever le défi principal de la Baie vaguelée ? Malheureusement, nous avons quelques problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421504,
					"content": "Si vous avez besoin de prendre une photo de groupe pour vos albums, je peux la prendre pour vous maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421505,
					"content": "Non, ça ne marche pas comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421506,
					"content": "Les photos sont un juste moyen de préserver les souvenirs et se remémorer des moments heureux. C'est l'expérience en elle-même qui nous importe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421507,
					"content": "N'oublions pas que ces photos sont à échanger contre des récompenses... Sinon, je suis d'accord avec vous. Prendre une photo et partir ne me semble pas très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421508,
					"content": "Je comprends. Je suis vraiment désolée. Veuillez patienter encore un peu, nous ferons de notre mieux pour résoudre les problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421509,
					"content": "Combien de temps doit-on attendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421510,
					"content": "C'est compliqué à estimer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421511,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421512,
					"content": "On peut faire quelque chose pour vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421513,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421514,
					"content": "J'ai remarqué qu'il y a peu d'employés sur les autres attractions de la Baie vaguelée et les employés sauriens ont l'air plutôt épuisés aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421515,
					"content": "Je suppose que tout le monde a été réaffecté temporairement pour aider avec les travaux de réparation de l'attraction principale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421516,
					"content": "Ne paniquez pas, je comprends qu'il y a des choses que vous ne pouvez pas nous dire. Je n'ai pas l'intention de vous rendre la vie difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421517,
					"content": "Au contraire, mes amis sont des gens compétents qui seront ravis de vous donner un coup de main. Ils viennent de terminer le test de la Croisière crépusculaire et de l'Asha-ccélération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421518,
					"content": "Si vous nous faites part de votre problème, je parie que nous pourrions le résoudre tous ensemble plus rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421519,
					"content": "Waouh, elle sait vraiment bien négocier ! C'est donc ça, le talent d'une médiatrice ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421520,
					"content": "#Chasca... Comment sais-tu où on est allés ? Tu ne nous as pas observés depuis un arbre ou quoi{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421521,
					"content": "Est-ce que c'est vraiment important ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421522,
					"content": "L'important, c'est qu'on sait bien aider les gens ! Si vous avez un problème, on sera ravis de vous prêter main-forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421523,
					"content": "Je ne m'attendais pas à ce que vous arriviez à voir l'état de nos sauriens. Désolée, je n'aurais pas dû essayer de vous le cacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421524,
					"content": "Je vais vous expliquer la situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421525,
					"content": "Pendant le test, j'ai remarqué que les travaux de peinture du Scintilloboggan n'était pas du tout parfaits. Comme la peinture doit être graffée depuis la voie spirituelle, ce n'est pas très facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421526,
					"content": "Pour ne pas retarder l'ouverture officielle de la Station balnéaire, nous avons dû la fermer temporairement. À l'heure actuelle, chaque seconde compte pour achever les travaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421527,
					"content": "Haha, c'est du gâteau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421528,
					"content": "Dites-moi où se trouve la peinture. Je ferai tout en une seule fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421529,
					"content": "Hein ? Mais... comment pourriez-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421530,
					"content": "Vous ne l'avez sûrement jamais vue auparavant. C'est « Um{RUBY#[S]Unité}oja » Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421531,
					"content": "Mualani... Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421532,
					"content": "Mualani des six héros ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuksina"
				}
			]
		},
