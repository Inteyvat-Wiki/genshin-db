			"dialogs": [
				{
					"id": 150421401,
					"content": "Comment te sens-tu à l'instant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421402,
					"content": "#Plutôt {M#détendu}{F#détendue}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "#Tu es bien {M#audacieux}{F#audacieuse}, mais je pense que tu t'es bien {M#débrouillé}{F#débrouillée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421408,
					"content": "Je peux peut-être faire des suggestions au personnel pour qu'il apporte des améliorations par la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421409,
					"content": "En tout cas... Ils devraient vraiment laisser deux candidats s'affronter pour la victoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421404,
					"content": "Mes yeux... Tout est flou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "#Haha, rester {M#concentré}{F#concentrée} demande beaucoup d'énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421406,
					"content": "C'était amusant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "#Ah oui ? On dirait que nous sommes {M#arrivés}{F#arrivées} à la même conclusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				}
			]
		},
