			"dialogs": [
				{
					"id": 721840201,
					"content": "Bonjour. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840202,
					"content": "À propos de la pizza du Restaurant Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "Ah, vous voulez parler de cette pizza-là, elle est plutôt bonne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840204,
					"content": "Mais... comment dire, elle ne me plaît pas tellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840205,
					"content": "Personnellement, je pense qu'il serait bien d'y ajouter quelques ingrédients locaux d'Inazuma, du melon lavande par exemple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840206,
					"content": "Peut-être qu'elle sera plus populaire comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rie"
				}
			]
		},
