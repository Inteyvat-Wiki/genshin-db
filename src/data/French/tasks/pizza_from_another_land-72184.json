			"dialogs": [
				{
					"id": 721840301,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "Alors ? Vous avez eu des informations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "À propos des commentaires des clients...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Une pizza à base de melon lavande... Pas trop compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "Le reste des ingrédients est préparé comme d'habitude, enfin, puisqu'il faut « ajouter quelques ingrédients locaux d'Inazuma », je vais en ajouter quelques-uns supplémentaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Des ganodermas marins ? L'herbe à sanglots ? Hmm, pouvons-nous utiliser les champignons fluorescents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Vous avez besoin d'un coup de main ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Waouh ! Désolé, j'étais trop occupée à réfléchir à ce qu'il fallait mettre dans le plat ! Je vois, il n'y a pas assez de melon lavande dans le magasin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "#{M#Voyageur}{F#Voyageuse}, pouvez-vous me chercher un melon lavande ? Nous ne manquons que de cet ingrédient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Bien sûr, comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Alors, s'il vous plaît, un melon lavande devrait suffire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Vous cherchez d'autres ingrédients ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "Les autres ingrédients sont suffisants dans le restaurant. Apportez-moi un melon lavande, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
