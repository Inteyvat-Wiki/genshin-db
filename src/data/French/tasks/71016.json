			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Et voici les trois parties.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "Vous avez réussi ? Laissez-moi y jeter un coup d'œil... En effet, les dessins décrivent bien l'histoire d'Azhdaha lorsqu'ils sont mis côte à côte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Cette grue représente sans doute Souffle-Nuages, et ce cerf doit être Grave-Lune... Par contre, le dernier m'échappe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Hum, il semblerait que quelqu'un ait effacé le dessin de façon à ce qu'on ne découvre pas l'identité du troisième Adepte. Qui est-ce que ça pourrait bien être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Tant pis, je ne peux malheureusement pas tout savoir. La relique est désormais complète et c'est tout ce qui compte. Je devrais pouvoir en tirer un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Souhaitez-vous la garder ou me la revendre ? Je vous ferai une offre généreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "Je vous la revends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Merci bien. Prenez donc ces moras en échange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Hmm... Pourquoi aurait-on voulu cacher l'identité du troisième Adepte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "Mais qui a fabriqué cette relique au juste ? Puis, qui a eu l'idée de la briser et de dégrader le dessin de l'Adepte qui se trouvait dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Linlang"
				},
				{
