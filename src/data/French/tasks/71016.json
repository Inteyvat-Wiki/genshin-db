			"dialogs": [
				{
					"id": 710160401,
					"content": "Je vais essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Très bien, revenez me voir si vous y arrivez.",
					"roleType": "TALK_ROLE_NPC",
