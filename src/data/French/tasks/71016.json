				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Le trésor anonyme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "L'objet que vous tenez est fort intéressant... Le motif semble être assez ancien. Laissez-moi l'ouvrir pour l'examiner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Bien qu'il présente certains défauts, je peux vous proposer un prix équitable si vous souhaitez vous en débarrasser. Mais sachez qu'il ne sera pas élevé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Ces motifs affirment qu'il s'agit d'un objet fabriqué à Liyue et ici, ces inscriptions sont une anecdocte au sujet d'Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "La légende raconte qu'Azhdaha était un dragon né d'une convergence des esprits Géo de Liyue et que même le Souverain de la Roche peinait à rivaliser avec lui en termes de force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Il fit donc fait appel à trois Adeptes qui créèrent une caverne pour l'aider à neutraliser la créature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Le Souverain de la Roche se battit contre le dragon et l'attira dans la caverne avant d'ordonner aux Adeptes de l'y sceller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Les motifs sur l'objet que vous m'avez amené représentent les trois Adeptes en train de créer la caverne, main dans la main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "À mon avis, il doit exister deux autres objets similaires à celui-ci. En les réunissant tous, nous obtiendrons sans doute une relique entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Vous en savez beaucoup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Je fais du commerce d'antiquités après tout. Il est souhaitable de savoir de quoi on parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Ah, je m'égare. Comme je vous l'ai dit tout à l'heure, vous devriez trouver deux autres objets identiques à celui-ci. Malheureusement, je ne peux pas vous racheter ce que vous avez pour un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Mais c'est une autre histoire si vous parvenez à me ramener les deux autres parties manquantes. Cette tâche pourrait se révéler difficile au vu de leur ancienneté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue est une terre mystique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Je n'en suis pas si sûre, mais un confrère m'a dit que tout était possible dans un endroit aussi vaste que Liyue et qui possède une histoire tout aussi longue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "#Ne soyez pas {M#surpris}{F#surprise} de découvrir d'anciennes reliques par-ci, par-là ici. Nos connaissances actuelles de l'histoire de Liyue ne représentent qu'une goutte d'eau dans la mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
			"id": 7101603,
