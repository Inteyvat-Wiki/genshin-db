			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160301,
					"content": "Le trésor anonyme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "Si je ne me trompe pas, l'objet que vous m'avez amené est une des trois parties qui composent une relique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "Elle ne pourra être complète qu'en réunissant ces trois parties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "Je serais ravie de vous les reprendre à un prix exceptionnel si vous parvenez à toutes les trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "Cela dit, j'ai bien peur que cette tâche ne s'avère difficile en raison de leur ancienneté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
