			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "Je me demande si cette idée est viable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Vous êtes encore en train de chercher cette épée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Vous, ici... Oui, je suis toujours à la recherche du Glaive occulte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Mais je n'ai trouvé aucune piste intéressante jusqu'à maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Je n'y peux rien. Trouver une épée cachée dans tout Liyue n'est pas une mince affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Quelqu'un m'a dit que cette épée a peut-être été détruite il y a longtemps par un monstre. Mais même si c'est le cas, j'en trouverai tous les fragments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "#Excusez-moi, je divague. J'ai indiqué l'endroit que je veux que vous vérifiiez cette fois sur votre carte. Je vous remercie pour votre aide, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "J'espère... que cette épée n'a pas réellement été brisée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
