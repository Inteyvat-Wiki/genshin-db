			"dialogs": [
				{
					"id": 210330403,
					"content": "Elle m'a l'air plutôt intacte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "#A-t-elle un lien avec le Glaive occulte{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Je dois l'examiner en détail pour en être sûre... Ah, mais je dois vous dire que cela fait déjà un certain temps que j'amasse des fragments d'armes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "J'en ai trouvé au marché, dans la nature et chez les aventuriers de la Guilde... J'ai pensé qu'ils pourraient me mener au Glaive occulte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Cependant, je n'ai pas trouvé la moindre trace de cette épée à ce jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Ce n'est pas grave. Un adage liyuéen dit que « persévérance est mère de réussite ». Si je continue à chercher... je finirai bien par la trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "#Ah, et voici une récompense pour vous. Merci, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
