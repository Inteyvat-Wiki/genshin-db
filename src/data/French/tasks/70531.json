			"dialogs": [
				{
					"id": 705310101,
					"content": "Attendez ! Vous êtes là pour participer au Grand prix du Roi des invocations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "#Si vous avez un peu de temps, j'aimerais vous parler du « Tour des merveilles{NON_BREAK_SPACE}», un événement organisé par la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "... D'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Merci ! Tout d'abord, je vais vous présenter brièvement l'événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "En résumé, la Guilde des aventuriers a placé plusieurs plateformes panoramiques à travers tout Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Vous devez les trouver et obtenir le tampon commémoratif de chaque plateforme panoramique sur votre carnet de visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "Le défi sera considéré comme accompli dès lors que vous aurez obtenu les tampons de toutes les plateformes panoramiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Ça ressemble bien à un événement organisé par la Guilde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Héhé... Nous avons beaucoup réfléchi à l'emplacement des plateformes panoramiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Cependant, certaines d'entre elles sont situées dans des endroits reculés et il y aura peut-être des monstres autour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "#Mais je suis sûre qu'ils ne poseront aucun problème pour {M#un aventurier aussi expérimenté}{F#une aventurière aussi expérimentée} que vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "C'est tout pour moi ! Voici votre carnet de visite et amusez-vous bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Je vous écoute...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
