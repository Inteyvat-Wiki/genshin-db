					"content": "Où suis-je... Oh ? Je vous connais, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030705,
					"content": "Que se passe-t-il ? Je me sens tout... léger ! Je flotte !",
