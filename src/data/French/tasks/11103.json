					"Pervases"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "L'esprit s'envole vers les montagnes élevées, tandis que le corps se repose au fil du temps passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030102,
					"content": "Désolé de vous déranger, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "On aimerait emprunter un encensoir et des lampes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "... Alors voilà quelque chose qu'on ne voit pas tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030105,
					"content": "Ces deux-là visitent un sanctuaire, non pas pour chercher ou honorer ses dieux ou ses Adeptes, mais pour prendre les outils d'adoration à leur propre compte. Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030106,
					"content": "Nous avons conscience que notre requête est un peu déplacée, mais nous n'en avons pas besoin longtemps... Promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "Pour le rituel de la « Voie des rêves », je suppose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030108,
					"content": "Quoi ? ... Comment avez-vous su ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "J'ai passé dans ce sanctuaire plus de temps que vous ne pouvez l'imaginer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030110,
					"content": "Peut-être qu'à force de dévouement, j'ai acquis une certaine compréhension des arts Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030111,
					"content": "Waouh. Je n'ai jamais entendu parler de ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Ah, ça n'a pas d'importance. Prenez ce dont vous avez besoin. Il est fortuit que ces objets puissent vous être utiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030113,
					"content": "... Ils ne servaient plus à grand-chose ici, de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030114,
					"content": "Est-ce que quelque chose vous préoccupe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Ha, rien dont vous deviez vous préoccuper. Je vous en prie, prenez ce que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030116,
					"content": "Eh bien... merci, alors !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Je vous en prie. Prenez ce dont vous avez besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110301",
							"2"
						],
						"stepId": 1110301,
