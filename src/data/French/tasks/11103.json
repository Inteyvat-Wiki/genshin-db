				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031101,
					"content": "Ah, vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031102,
					"content": "Nous avons récupéré le talisman de permission. Vous le voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031103,
					"content": "Merci profondément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031104,
					"content": "Souhaitez-vous commander, monsieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031105,
					"content": "Un poisson chiwen grillé, je vous prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031106,
					"content": "Bien sûr, ce sera prêt dans un instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031107,
					"content": "Oh ? Pas de tofu aux amandes aujourd'hui ? Ça ne vous ressemble pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031108,
					"content": "C'était le mets préféré de Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031109,
					"content": "J'aimerais... savoir quel goût ça a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031110,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031111,
					"content": "« Par vagues et tempêtes, je cherche du poisson, qu'il vente ou qu'il neige, j'éradique les démons... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031113,
					"content": "Vous avez besoin d'autre chose ? Je préférerais manger seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031114,
					"content": "On ne vous dérange pas, dans ce cas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "#Oui ! « Et ainsi, le détective Paimon et {M#le voyageur}{F#la voyageuse} résolurent cette énigme, et s'éloignèrent silencieusement vers l'horizon... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031115,
					"content": "Allez, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
		},
