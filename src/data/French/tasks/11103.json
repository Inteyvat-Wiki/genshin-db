					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "Cet encensoir... Ça fera l'affaire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "Tant qu'il ne tombe pas en ruine comme ce sanctuaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "Après l'encensoir... Il nous faut encore les sept lampes des étoiles, c'est ça ? Ne perdons pas de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Hein ? Où est-ce qu'il est passé !? Il était juste ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "#J'avais supposé qu'une fois que vous auriez acquis ce pour quoi vous étiez {M#venus}{F#venues}, vous prendriez simplement congé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Oh ! C'est la voix du type de tout à l'heure ! Mais... Où êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Ma forme corporelle a cessé d'exister il y a plus de mille ans. Ce que vous avez vu était une illusion, créée par la technique Adepte connue sous le nom de « Persistance mortelle ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Maintenant que vous avez récupéré les sept lampes des étoiles et l'encensoir utilisés dans le rituel de « Persistance mortelle », mon illusion n'est désormais plus visible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Alors vous êtes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "J'étais jadis disciple junior dans l'ordre des Yakshas, et c'est le Souverain de la Roche en personne qui m'a donné mon nom, « Pervases », il y a des milliers d'années. Cependant, ma force m'a fait défaut et j'ai péri au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Aujourd'hui est l'anniversaire de ma mort. Mon dernier souhait était de pouvoir contempler Liyue telle qu'elle est aujourd'hui, alors j'ai pris la liberté d'utiliser cette technique ici même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "D'ailleurs... C'est le Dompteur de démons qui vous envoie, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Oh, vous vous connaissez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Je peux ressentir son aura sur vous... et son intense « karma » également...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "*soupir* Même si des milliers d'années ont passé, il souffre toujours du fardeau de la douleur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "J'ai vraiment honte de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Ne dites pas ça, Pervases... Vous avez sacrifié votre vie pour le bien de Liyue, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "La vie est précieuse, c'est vrai... Mais comparé à ce que le Dompteur de démons endure, la mort n'est qu'un tracas éphémère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Haha, toutes mes excuses... Les anniversaires sont des occasions joyeuses, mais il m'est difficile de ne pas me sentir mélancolique au jour de ma mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "L'effet de la « Persistance mortelle » est presque dissipé. Prenez soin de vous, et saluez le Dompteur de démons pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "Comptez sur nous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "Ah... Je me serais bien mangé un poisson chiwen grillé avant de partir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "« Par vagues et tempêtes, je cherche du poisson, qu'il vente ou qu'il neige, j'éradique les démons »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "On dirait qu'il est parti... J'aurais aimé que quelqu'un se souvienne de ce Yaksha appelé Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "On devrait aussi y aller. Quand on aura le temps, revenons pour lui rendre hommage !",
					"roleType": "TALK_ROLE_NPC",
