			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031001,
					"content": "Bonjour patronne, est-ce que le « Céleste voleur d'étoiles » est là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031002,
					"content": "Le « Céleste voleur d'étoiles »... Vous voulez parler de ce faux Adepte qui porte un masque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031003,
					"content": "Il a pris une chambre sous le nom de « Wang Ping'an ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031004,
					"content": "C'est un nom... tout ce qu'il y a de plus ordinaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "Il est parti tôt ce matin. Il a dit qu'il allait faire un pèlerinage dans la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031007,
					"content": "#Ah, oui... Il m'a demandé de remettre cette lettre si {M#un voyageur accompagné}{F#une voyageuse accompagnée} d'une « espèce de pipelette volante » le cherchait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031008,
					"content": "« Une espèce de pipelette volante »... De qui peut-il bien s'agir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031009,
					"content": "Euh... Il devait parler de vous, je pense. Voici la lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031010,
					"content": "Hmm... Il nous a laissé une lettre. Est-ce que c'est encore une de ses entourloupes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031011,
					"content": "Allez, ouvre-la vite ! Je veux la lire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031019,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031012,
					"content": "Oh, on dirait qu'il y a un truc en plus de la lettre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031013,
					"content": "C'est le talisman de permission à l'intérieur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031014,
					"content": "Cela fait longtemps que je n'avais pas rencontré un sale type comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031015,
					"content": "Un sale type assez gentil, en fait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "Oui... Oh, c'est vrai ! Il faut ramener ce talisman de permission à Xiao, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031016,
					"content": "C'est grâce à Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "C'est le nom de quelqu'un d'ordinaire, aucun doute...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
