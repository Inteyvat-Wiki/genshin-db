					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Avez-vous récupéré les objets pour le rituel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Hmm... Cet encensoir, et ces lampes... Ils ont l'air parfaits, comme s'ils avaient été spécialement conçus pour les techniques d'Adepte... Où les avez-vous trouvés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Auprès du Yaksha nommé Pervases...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "#Et il nous a {M#chargés}{F#chargées} de vous passer le bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "... Oui, cela lui ressemble bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Comme je le pensais, il n'a pas pu délaisser Liyue... J'espère que la situation présente l'aura rassuré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "Bon, préparons-nous pour la cérémonie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "Mettez l'encensoir au milieu, et éparpillez les sept lampes des étoiles. Ensuite, parsemez de choses réfrigérantes tout autour. Quand ce sera prêt, nous pourrons continuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Oui, très bien ! Nous arrivons maintenant à l'étape la plus importante pour mener à bien la « Voie des rêves »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "Le rituel est divisé en quatre phases : l'offrande de l'encens, la méditation, l'incantation et envoyer une flèche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "Ah... C'est si compliqué que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Les arcanes d'Adepte sont le résultat de milliers d'années d'études et de recherches. Leur mysticisme n'est pas chose à prendre à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Tout manque de sérieux peut entraîner la perte de l'âme ou du corps de celui qui conjure l'incantation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Ah, ça fait peur ! Je suis désolée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "L'offrande de l'encens consiste à placer un bâton d'encens sur l'encensoir, en signe de révérence envers le Souverain de la Roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "La méditation permet de couper toutes les pensées distrayantes, et de figer l'image du sujet dans son esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "Pour l'incantation, il faut réciter à haute voix : « Devayaksha, apportez le péché ! ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "Et pour finir, nous enverrons une flèche en direction de chacune des deux statues de Yaksha pour sceller le pacte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Si tout se déroule comme prévu, l'âme de la personne apparaît après un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Si vous n'avez pas de question, nous pouvons commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Bon, commençons par offrir l'encens, non ? Tu sais, avec respect pour le Souverain de la Roche, et tout et tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030522,
					"content": "*gloups* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
