						111030912
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030912,
					"content": "On dirait bien que Xiao lui a fait une sacrée peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "Ô grand Adepte... Puis-je vous demander votre nom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030914,
					"content": "Dompteur de démons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "C'est vraiment vous ! C'est vraiment vous ! Je n'aurais jamais imaginé pouvoir un jour rencontrer le Dompteur de démons, le Gardien Yaksha en personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030917,
					"content": "Vous connaissez Xiao ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Bien sûr. Mon grand-père était un expert du folklore... J'ai grandi avec les récits du Dompteur de démons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030919,
					"content": "Aujourd'hui encore, je collectionne les ouvrages sur les Yakshas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030920,
					"content": "Et un jour, j'ai trouvé ce talisman de permission dans les affaires de mon grand-père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030921,
					"content": "Au début, je faisais juste semblant pour m'amuser... Mais ensuite, j'ai commencé à m'éloigner de plus en plus du droit chemin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030922,
					"content": "Euh, donc pour résumer... Vous êtes le plus grand fan de Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Oui. Et merci à vous deux de m'avoir permis de rencontrer le Dompteur de démons en chair et en os. C'est comme un rêve devenu réalité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030924,
					"content": "En fait, on ne s'attendait pas du tout à ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Je ne dois pas manquer cette occasion ! Ô illustre Dompteur de démons, j'en fais le serment ici même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030926,
					"content": "Dès à présent, je jure de me détourner du mal, de mener une existence honnête, et de ne plus souiller le nom des Adeptes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030927,
					"content": "Je n'oublierai pas votre promesse... Maintenant, partez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Merci... Merci pour votre bonté, et pour tout ce que vous avez fait pour Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030929,
					"content": "Il avait vraiment l'air sincère à la fin. Je pense qu'il ne trompera plus personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Mais avec tout ça, on n'a toujours pas récupéré le talisman de permission... Bon, laissez-nous faire ! On n'a qu'à aller à l'Auberge Wangshu demain matin pour le voir en personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "Gardien Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Alors, vous arrêtez le prêchi-prêcha et toute la comédie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "D'accord, d'accord ! V—Vous m'avez presque fait mourir de peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
