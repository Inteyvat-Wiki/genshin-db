						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Non, ce n'est pas un rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Ah ? Ne savez-vous pas que les rêves d'Adepte sont sacrés ? Je ne saurais tolérer un tel comportement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030718,
					"content": "Je crois qu'il est temps de le faire descendre de ses grands chevaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "On ne sent pas la douleur, dans les rêves, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "C'est parce que vous êtes mort...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "M—M—Mort ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030711,
					"content": "Impossible ! Je m'étais endormi à l'Auberge Wangshu...",
