					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030708,
					"content": "Passons... Quel est donc cet endroit ? Je me souviens m'être endormi paisiblement à l'Auberge Wangshu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030712,
					"content": "Euh, mais oui... C'est ça ! C'est parce que je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030713,
					"content": "Je suis en train de rêver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111030714,
					"content": "Ahh... Ce type est vraiment sans espoir...",
