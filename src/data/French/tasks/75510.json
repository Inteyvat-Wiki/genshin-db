			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petite pomme de pin",
					"Figurine en bois de flammabombe",
					"Vigee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "Bien que la guerrière masquée ne puisse pas voler comme la médiatrice, il lui suffit de charger au bon moment pour gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Petite pomme de pin"
				},
				{
					"id": 755100102,
					"content": "Imbécile ! Tu ne peux pas te contenter de penser à la vitesse à laquelle elle court en ligne droite ! Si elle ne peut pas tourner, ça ne sert à rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Figurine en bois de flammabombe"
				},
				{
					"id": 755100103,
					"content": "Ça suffit, les enfants. C'est tout à fait possible de discuter de manière civilisée, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100104,
					"content": "On est civilisés... C'est juste que quand on parle de grandes guerrières, on est gonflés à bloc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Figurine en bois de flammabombe"
				},
				{
					"id": 755100105,
					"content": "Ne vous inquiétez pas, mademoiselle Vigee ! On est peut-être en guerre, mais on se battra grâce à la raison et aux preuves !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Petite pomme de pin"
				},
				{
					"id": 755100106,
					"content": "Oh ! Je viens de penser à une nouvelle stratégie. Je te mets à nouveau au défi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Figurine en bois de flammabombe"
				},
				{
					"id": 755100107,
					"content": "Une revanche ! Une revanche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Petite pomme de pin"
				},
				{
					"id": 755100108,
					"content": "C'est animé par ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "#Oh, {M#un nouveau client}{F#une nouvelle cliente} ! Bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100111,
					"content": "#À en juger par votre tenue, vous devez être {M#un voyageur}{F#une voyageuse}, non ? Ça nous fait un point commun !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100112,
					"content": "Ça vous dit d'essayer ce rouleau tissé interactif que j'ai créé avec les enfants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100113,
					"content": "Un rouleau tissé interactif ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "En bref, c'est un jeu qui combine les scènes de papier de Liyue, les bandes dessinées d'Inazuma et la technologie du cinéma de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100116,
					"content": "Il est inspiré de nos héros locaux. Nous avons également ajouté un concept de défi hybride pour créer une histoire innovante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100117,
					"content": "Essayez ! Qui sait, vous vivrez peut-être une expérience inédite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100118,
					"content": "Avec plaisir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "Super, amusez-vous bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100114,
					"content": "#C'est un rouleau qui bouge tout seul{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "Que se passe-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
		},
