				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "Bienvenue à Mondstadt ! Je suis Timaeus, chercheur en alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "Qu'est-ce que c'est l'alchimie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "L'alchimie est un art qui est pratiqué depuis les temps anciens, mais elle compte peu d'adeptes aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "Ses principes sont mystérieux et fantastiques, contrairement à ceux qui façonnent le monde physique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "Celui qui maîtrise l'alchimie est capable de créer des choses qui sortent de l'ordinaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "C'est votre plan de travail ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "Tout à fait. Vous pouvez essayer de synthétiser quelque chose si ça vous tente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "Je ne sais pas, ça m'a l'air compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "Mais non ! Tout se passera bien, je vous assure. Je peux vous montrer les bases si ça vous intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Synthétiser",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Je vais tout faire sauter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
