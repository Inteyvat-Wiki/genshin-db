					"nextDialogs": [
						722620620
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620620,
					"content": "Tiens, en y repensant, l'objectif d'Ioroi était qu'on emmène Kichiboushi s'entraîner à huit endroits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620621,
					"content": "Les Monts Dosdragon, la Forêt de pierre de Guyun, la Cité de Mondstadt, le Port de Liyue, le Mont Hulao... On a déjà fait plus de la moitié du travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620622
					],
					"speakerTitle": "Paimon"
				},
