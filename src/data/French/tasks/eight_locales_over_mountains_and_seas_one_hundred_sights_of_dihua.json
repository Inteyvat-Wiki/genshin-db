			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "Ouah, mer est belle ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620102,
					"content": "Hein ? C'est le Marais Dihua ici, pas la mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620103,
					"content": "Il débouche sur la mer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Oui, mais c'est quand même bizarre d'appeler ça la mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620105,
					"content": "Hmm, Kichiboushi comprend pas c'est quoi « la mer » et « pas la mer ». Une différence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620106,
					"content": "L'eau a un goût différent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "L'eau de forêt est un peu sucrée, alors pas la mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620108,
					"content": "Mais si le Lac de cidre était vraiment rempli de cidre, qu'est-ce que ce serait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620109,
					"content": "Un endroit que Venti apprécierait tout particulièrement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Ce problème mis à part, c'est moi ou Kichiboushi parle de mieux en mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620121,
					"content": "Selon les dires d'Ioroi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "Qu'est-ce qu'il a dit ? « Mon nom est Ioroi, le Bake-danuki de renommée mondiale ! ». Non, ce n'est pas ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620124,
					"content": "« J'ai le ventre qui gratte, hohoho. »... « Hiii ! »... Non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620125,
					"content": "Mouhaha, Paimon imite bien ! Très drôle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620126,
					"content": "« Quand vous vous serez fait à son odeur... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "Ah oui ! Plus on se fait à son odeur, et mieux on le comprendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620128,
					"content": "#Entraînement aussi ! Kichiboushi apprend plein de choses avec Paimon et {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620129,
					"content": "Paimon est une excellente guide, après tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620131,
					"content": "#Tu te souviens encore de tout ça, {NICKNAME} ? Ça me fait plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620132,
					"content": "#Merci Paimon, merci {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620136,
					"content": "Cette « mer-pas-mer » est très jolie. La grande maison derrière, très belle aussi. Aider Kichiboushi à prendre photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620137,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "On grandit ensemble quand on voyage ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "Ouais ! Compagnons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620135,
					"content": "Les meilleurs compagnons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620122,
					"content": "Ioroi nous a dit quelque chose à ce sujet avant notre départ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "La mer est une vaste étendue d'eau située au-delà d'un continent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Ouah, c'est une définition bien stricte ! En revanche, ça nous ramène à la question des limites géographiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME} a dit que le Marais Dihua relié à la mer. Alors c'est quoi différence entre « continan-nan » et « pas le continan-nan » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620113,
					"content": "... Ta définition aussi stricte soit-elle, n'a pas résolu notre problème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620114,
					"content": "Ces concepts ont été définis par l'homme, ils n'ont aucun sens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Si le Marais Dihua pense qu'il est une mer, eh bien, c'est une mer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Si Kichiboushi pense être Adepte, alors Kichiboushi est Adepte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620117,
					"content": "#Hé ! Ne l'écoute pas, Kichiboushi. Qu'est-ce que tu racontes, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620118,
					"content": "... Je suppose que tu n'as pas tout à fait tort malgré tout. Tu peux devenir le Bake-danuki que tu veux, Kichiboushi ! Et pourquoi pas un Tanuki Adepte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620119,
					"content": "Tanuki Adepte ! Youhou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
