			"dialogs": [
				{
					"id": 722620201,
					"content": "C'est dans la boîte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620202,
					"content": "Ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620203,
					"content": "Ah, je sais ! Tu as déjà été pêcher, Kichiboushi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620204,
					"content": "Pêcher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620205,
					"content": "On dirait bien que non. Très bien, allons au bord de l'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620206,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226207",
							"2"
						],
						"stepId": 7226207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kichiboushi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "Bouhouhou... Pourquoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620302,
					"content": "Kichiboushi ! Pourquoi t'as foncé droit dans ce repaire de Brutocollinus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620303,
					"content": "Kichiboushi pensait jouer avec Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620304,
					"content": "Hein ? Pourquoi ? Les Brutocollinus sont des monstres dangereux, tu sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620305,
					"content": "Je ne dirais pas qu'ils sont dangereux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "Hé ! Kichiboushi n'est pas aussi doué que toi pour le combat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620309,
					"content": "Quand on s'est rencontrés pour la première fois dans la Forêt de Chinju...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "Mais oui ! Tu t'étais transformé en objet après t'être fait encercler par des Brutocollinus, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620311,
					"content": "Rencontrés pour la première fois... Kichiboushi réfléchit... Oh oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620312,
					"content": "Kichiboushi jouait à cache-cache avec Brutocollinus. Brutocollinus de forêt n'attaquent pas Bake-danuki, mais jouent avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620313,
					"content": "Ah bon ? Vous vous entendez bien avec eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620314,
					"content": "Kichiboushi sait pas pourquoi Brutocollinus d'ici sont méchants. Bouhouhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620315,
					"content": "En tout cas, tu dois faire plus attention ici, même avec les Brutocollinus... Non, surtout avec les Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620316,
					"content": "#Hum, c'est compliqué... {NICKNAME}, explique-lui, toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620317,
					"content": "Il faut savoir différencier les bonnes et les mauvaises personnes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "Absolument ! Comme ça, tu pourras te protéger à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620319,
					"content": "Ceci dit, n'oublie pas d'être gentil et ouvert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "Tout à fait ! Et tu pourras profiter des bonnes choses de la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620321,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME} et Paimon disent des choses compliquées. Kichiboushi comprend pas trop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620323,
					"content": "Mais Kichiboushi sait que vous deux, des bonnes personnes. C'est pourquoi Kichiboushi doit apprendre de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620324,
					"content": "#Bref, n'en parlons plus. {NICKNAME} va t'enseigner la pêche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620325,
					"content": "Ouais ! La pêche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620307,
					"content": "Ils sont très dangereux, oui !",
