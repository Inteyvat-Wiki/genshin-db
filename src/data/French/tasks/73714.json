			"dialogs": [
				{
					"id": 737140101,
					"content": "Héhé, place à un itinéraire spécial que j'ai choisi moi-même ! On va marcher un bon moment, par contre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140102,
					"content": "Première étape, l'oasis du désert ! Ensuite, on traversera la Forêt de Mawtiyima, et après ça, on rentrera au Port Bayda !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140103,
					"content": "J'y réfléchis depuis un moment... Le désert, la forêt et les vallées de Sumeru sont tous tellement différents ! Mais on n'a presque jamais eu l'occasion de tout voir en un seul voyage, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140104,
					"content": "Heureusement que nous ne sommes pas pressés. Je propose qu'on prenne notre temps et qu'on profite bien du paysage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140105,
						737140106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140105,
					"content": "Pas de souci ! On y va tranquille, à notre rythme !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737140107
					]
				},
