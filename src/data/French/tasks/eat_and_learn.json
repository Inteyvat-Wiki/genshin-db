				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "#Mon {M#ami}{F#amie}, vous avez l'air très {M#pressé}{F#pressée}. Quelque chose vous préoccupe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100102,
					"content": "Pas mal de choses, en vérité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "#Oh... Je peux voir que vous êtes {M#fatigué}{F#fatiguée}, mais vos mouvements sont très hâtifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100104,
					"content": "Ce qui vous tracasse est un problème auquel vous devez trouver une solution dès que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100109,
					"content": "Si cela ne vous dérange pas de patienter un peu, j'aimerais vous inviter à manger un repas en ma compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100110,
					"content": "Il est tout à fait normal de courir dans tous les sens dans la vie... Mais comme on le dit souvent : les eaux des torrents déchaînés s'écoulent parfois silencieusement dans des courants tranquilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100111,
					"content": "#Même si vous êtes très {M#occupé}{F#occupée}, vous devez toujours trouver du temps pour vous reposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100112,
					"content": "Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100113,
					"content": "Goûtons ensemble à la soupe de pois-menthe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100114,
					"content": "Pas besoin de me payer en moras, trouvez-moi juste un plant de menthe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100115,
					"content": "#Ah oui, ne soyez pas trop {M#exigeant}{F#exigeante} dans votre recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100116,
					"content": "C'est une simple plante dont nous avons besoin, pas de problèmes supplémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100105,
					"content": "Non, je vais bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "Oh, tant mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100107,
					"content": "Votre empressement me dit que vous essayez de résoudre un problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100108,
					"content": "Hum, je ne sais pas quel problème vous avez à résoudre, mais j'ai quand même un conseil à vous donner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				}
			]
		},
