					"nextDialogs": [
						740841104
					]
				},
				{
					"id": 740841104,
					"content": "Hein ? Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841105
					],
					"speakerTitle": "Paimon"
				},
				{
