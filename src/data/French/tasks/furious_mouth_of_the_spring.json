			"dialogs": [
				{
					"id": 740840605,
					"content": "#Attention ! Il y a un Élémentosaure à côté de l'autel ! Est-ce qu'il est endormi{NON_BREAK_SPACE}? Soyons {M#prudents}{F#prudentes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840601,
					"content": "Attends ? La clé... La clé n'est pas ici ? Est-ce que ça veut dire que l'autel a été activé prématurément ? Et quelqu'un a déjà pris la clé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840602,
					"content": "GRAOU !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Élémentosaure endormi"
				},
				{
					"id": 740840603,
					"content": "Oh non ! L'Élémentosaure s'est réveillé ! Sauve qui peut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840604,
					"content": "L'Élémentosaure à côté de l'autel se réveille et se balance, ses yeux pleins de colère et malveillance.\\nVous vous précipitez vers la rive, mais il vous poursuit de près.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
