			"dialogs": [
				{
					"id": 740841201,
					"content": "... Mélusine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841202,
					"content": "Pahsiv ? D'où est-ce que tu es sortie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841203,
					"content": "Sans trace, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841204,
					"content": "Ah, en tout cas, éloigne-toi rapidement de cet Élémentosaure, c'est très dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841205,
					"content": "Gentille Paimon, Pahsiv ! Danger, mélusine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841206,
					"content": "Pahsiv tend la main pour caresser l'Élémentosaure. Ce dernier, qui était en colère, baisse docilement la tête.\\nIl ouvre la bouche et crache une perle d'eau étincelante, avant de se retourner et de sauter dans l'eau.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "Clé, clé, Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841208,
					"content": "Waouh, l'Élémentosaure a en fait remis la clé de son bon gré ? Je ne m'attendais pas à ça, il t'a réellement écoutée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841209,
					"content": "Truc bleu, bon. La clé, protégée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841210,
					"content": "Le truc bleu... Tu veux dire l'Élémentosaure ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841212,
					"content": "Il t'a aidé à protéger la clé ? Tu es amie avec l'Élémentosaure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841213,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841214,
					"content": "Truc violet, vole la clé... Truc bleu, s'évanouit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841215,
					"content": "Hein ? Le truc violet ? C'est qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841216,
					"content": "#Truc violet, mauvais ! Truc bleu, Paimon, {NICKNAME}, gentils !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841217
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841217,
					"content": "Euh, d'accord. Je sais que tu nous complimentes, mais c'est toujours un peu bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841218,
					"content": "Le truc violet, très méchant, Erinnyes, très beaucoup mélusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841219,
					"content": "D'accord... Tu es vraiment la mélusine la plus spéciale que j'ai jamais rencontrée... Au fait, la plupart des mélusines que je connais vivent à la Cour de Fontaine ou au Village Mérusea... Comment es-tu arrivée ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841220,
					"content": "Cour de Fontaine ? Village Mérusea ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841221,
					"content": "#Tu as l'air plutôt perplexe. Tu n'as jamais entendu parler de ces deux endroits{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841222,
					"content": "Cour de Fontaine, mélusine... Village Mérusea, mélusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841223,
					"content": "Ah... Erinnyes, Pahsiv, maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841224,
					"content": "Erinnyes, Pahsiv, protéger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841225,
					"content": "Attends, tu dis que c'est là que tu habites ? Et que tu protèges l'endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841226,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841227,
					"content": "Mais les mélusines sont originaires du Village Mérusea, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841228
					]
				},
				{
					"id": 740841228,
					"content": "Oui, c'est bizarre, y a-t-il d'autres mélusines nées ailleurs qu'au Village Mérusea ? Mais il ne semble pas y en avoir d'autres ici, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841229,
					"content": "Pahsiv, tu vis ici toute seule ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841230,
					"content": "Seule ? Mélusine. Lavalette ! Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841231
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841231,
					"content": "Lavalette ? Il y a quelqu'un d'autre ? Qui c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841232,
					"content": "#Lavalette ! Paimon, Paimon, {NICKNAME}, {NICKNAME}. Lavalette, Lavalette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841233
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841233,
					"content": "C'est qui Lavalette au juste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841234
					]
				},
				{
					"id": 740841234,
					"content": "Pahsiv... Tu veux dire que, comme Paimon s'appelle Paimon, Lavalette s'appelle « Lavalette » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841235,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841236,
					"content": "Haha ! Je le savais, je suis vraiment trop intelligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841237,
						740841238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841237,
					"content": "C'est très étrange comme nom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841238,
					"content": "C'est trop stylé comme nom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841239,
					"content": "Lavalette, Pahsiv, connaissances, bang bang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841240,
					"content": "Euh... Tu veux dire que Lavalette t'a enseigné quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841241,
					"content": "Pahsiv ! Très beaucoup. Langue, intelligence... Très beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841242,
					"content": "J'ai l'impression qu'il n'en a pas tant que ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841243,
					"content": "Pahsiv, Lavalette, protéger, bang bang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841244,
					"content": "Il t'aide aussi à protéger cet endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841245,
					"content": "Mélusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841246,
					"content": "C'est toi qui l'aide à protéger cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841247
					]
				},
				{
					"id": 740841247,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841248
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841248,
					"content": "Je vois... Alors dis-moi quel genre de personne est Lavalette ? Pourquoi veut-il que tu protèges cet endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841249,
					"content": "Il s'est vraiment passé des choses inquiétantes ici. Les inscriptions sur la stèle que nous avons vue ont été effacées et nous avons aussi vu beaucoup de saleté tout à l'heure... C'est le truc violet qui a fait ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841250,
					"content": "Paimon curieuse, Pahsiv ! Mais le temps, pas très beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841251
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841251,
					"content": "Clé, clé, clé, place, ouest. Bang bang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841252
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841252,
					"content": "On va se dépêcher !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841253
					]
				},
				{
					"id": 740841253,
					"content": "#Paimon, Pahsiv ! {NICKNAME}, Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841254
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv saute joyeusement deux fois avant de partir précipitamment.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740841255,
					"content": "Le temps a l'air de presser. Heureusement que nous avons déjà deux clés, alors mettons les bouchées doubles pour obtenir la troisième clé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
