			"dialogs": [
				{
					"id": 740300301,
					"content": "Qu'est-ce qui ne va pas ? Il y a quelque chose que vous ne comprenez pas ? Tirez le levier avec moi. C'est facile.",
					"roleType": "TALK_ROLE_NPC",
