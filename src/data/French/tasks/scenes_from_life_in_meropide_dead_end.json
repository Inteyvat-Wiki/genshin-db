						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "#{M#Voyageur}{F#Voyageuse} et Paimon. Vous tombez à pic, pourriez-vous me donner un coup de main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "Vous pouvez lire dans les pensées ? C'est effrayant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Galvaryet nous a demandé de vous aider... Comment le saviez-vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "#Ah ? Parce que vous êtes les {M#seuls}{F#seules} à pouvoir m'aider ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "... C'est vrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "De toute façon, ce n'est pas difficile. Il faut deux personnes pour faire fonctionner la borne d'étude ici. J'ai déjà saisi les instructions spécifiques, alors allez là-bas et tirez le levier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "J'allais oublier... Le périphérique de stockage d'énergie devrait être à proximité, alors installez-le avant de l'activer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "D'ailleurs, rassurez-moi : vous n'êtes pas des assassins d'objets mécaniques, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "#Cela dépend de votre définition d'«{NON_BREAK_SPACE}assassin d'objets mécaniques ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Pourquoi vous nous demandez ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "En fait, j'avais demandé à Galvana de m'aider avant. J'ai détourné les yeux un seul instant et la borne d'étude est tombée en panne. Quand je lui ai demandé ce qui s'était passé, elle n'a pas su me le dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Plus tard, j'ai appris de sa sœur qu'aucune création mécanique ne pouvait tenir une demi-journée entre ses mains. Je suppose que même Alain Guillotin aurait soupiré en la voyant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "À ce moment-là, les frais de réparation ont été déduits de ma rémunération... Si vous êtes comme elle, je perdrai les coupons que j'ai travaillé dur pour avoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "Quelle histoire... On n'est certainement pas comme elle, alors ne vous inquiétez pas et laissez-nous le faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Merci, ça m'aiderait beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Si la borne d'étude m'attaque, alors c'est que je le suis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "On ne peut pas faire ça gratuitement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Je dirai à Galvaryet de faire une demande de rémunération pour vous plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Hein ? Mais elle nous a dit de voir directement avec vous pour la récompense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Ah bon ? D'accord, alors. C'est encore plus difficile de demander du financement ici qu'à l'Institut de recherche de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
			"id": 7403003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
