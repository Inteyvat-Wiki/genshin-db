						"position": [
							4373.582,
							184.163,
							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "#Vous êtes très {M#compétents}{F#compétentes}. Si l'on n'était pas ici, je vous engagerais comme {M#assistants}{F#assistantes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Ce n'est rien du tout. D'ailleurs, à quoi sert exactement ce dispositif ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "À l'origine, il y avait une faille qui menait à l'extérieur et qu'il fallait surveiller. Mais maintenant, nous pouvons économiser de la main-d'œuvre en fermant la route avec le dispositif de verrouillage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Cette technologie n'est pas vraiment nouvelle à l'Institut de recherche de Fontaine, mais comme je n'avais rien d'autre à faire, j'y ai apporté une légère modification.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "Ce que vous voyez maintenant n'est pas la version complète qui est utilisée dans le Tunnel minier de géode... Ahem, je crois que j'en ai trop dit. Faites comme si vous n'aviez rien entendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "Il y a aussi un moyen de sortir dans le Tunnel minier de géode ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "#Oui, vous êtes vraiment {M#intelligent}{F#intelligente}. Mais si vous l'étiez davantage, vous l'auriez gardé pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "Bon, maintenant que le problème est résolu, Galvana n'aura plus à venir ici aussi souvent pour faire le guet, et je pourrai aussi faire une pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "... J'ai failli oublier, voici votre récompense. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "La version complète est-elle plus puissante ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Bien sûr ! Il y a des composants supplémentaires dans la version complète... Pourquoi voulez-vous savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "Si vous souhaitez connaître les spécificités de la version complète, essayez-la vous-même... Mais ne racontez pas que c'est moi qui vous ai dit d'y aller si vous vous faites prendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}