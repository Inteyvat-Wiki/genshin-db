			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "#Bonjour {M#voyageur}{F#voyageuse}, comment se passent tes dernières aventures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430202,
					"content": "Tout va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "#Hmm... Tu sais, j'ai entendu parler de tes dernières péripéties. Si tu continues sur ta lancée, tu deviendras {M#un aventurier}{F#une aventurière} extraordinaire un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430204,
					"content": "Au fait... J'ai avec moi un exemplaire des « Renseignements d'aventurier ». Au cas où ça t'intéresse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430205,
					"content": "#C'est pour une nouvelle mission ? Je suis {M#partant}{F#partante} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "On dirait que tu sais déjà tout de la Guilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430207,
					"content": "Mais cette fois, ce n'est pas une mission. C'est juste un exemplaire des « Renseignements d'aventurier ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430208,
					"content": "C'est au sujet des Monts Dosdragon, cette formation montagneuse recouverte de neige près de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430209,
					"content": "Eh bien, la Guilde y a installé un camp, et de nombreux aventuriers y sont stationnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430210,
					"content": "#J'ai indiqué l'endroit sur ta carte. Une fois {M#arrivé}{F#arrivée}, va parler avec une aventurière nommée Iris pour en savoir plus sur ce qui se passe là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 701430211,
					"content": "Comme on dit, les voyages forment la jeunesse ! Vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				}
			]
		}
	]
