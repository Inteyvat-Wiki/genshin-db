						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130204,
					"content": "#Hein{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Alors, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130208,
					"content": "#Je... Je sais quoi{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "Dormez quand il faut dormir, sachez quand il faut savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130211,
					"content": "Retournez d'où vous venez, et quand le monde s'effondrera, vous n'aurez qu'à rentrer.",
