			"dialogs": [
				{
					"id": 762130101,
					"content": "#Hein{NON_BREAK_SPACE}? On dirait que cette pièce est complètement bloquée par des livres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130102,
					"content": "#Vous cherchez un livre{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130103,
					"content": "Hum... Non pas vraiment, on se demandait juste ce qu'il y avait à l'intérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130104,
					"content": "#On dirait qu'on peut entrer en passant sur le côté, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "Alors, vous ne pourrez pas entrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130106,
					"content": "Les livres doivent être ailleurs. Sans ça, vous n'y arriverez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130107,
					"content": "Je comprends rien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "Les livres doivent être ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130109,
					"content": "#Qu'est-ce que vous voulez dire{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "Si les livres sont ailleurs, alors ils ne sont pas là. Le vieux moine que je suis ne fait que regarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130111,
					"content": "Je vais essayer avec Dex.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Tout droit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
