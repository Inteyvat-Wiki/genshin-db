					}
				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "Aïe... Pourquoi cette boîte est-elle si lourde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "Est-ce que ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "#{M#Le chercheur aîné}{F#La chercheuse aînée} d'honneur, nous nous retrouvons ! Désolée... Je... Je pense m'être blessée à la taille, ça fait vraiment mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "J'avais l'intention d'amener une boîte ici pour organiser les documents qu'elle contient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Je... Je n'aurais jamais imaginé que la boîte soit si lourde. J'ai un peu perdu l'équilibre en la soulevant, et j'ai dû compenser avec ma taille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Et là... Je déguste un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Vous voulez que je vous emmène chez un docteur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "Non, ce ne sera pas nécessaire... Ce n'est pas la première fois, j'ai juste besoin de me reposer un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Il y a combien de fichiers dans cette boîte pour qu'elle soit si lourde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Il doit y avoir... Eh bien, une tonne de fichiers. L'Institut a promu un style de travail visant à « tout documenter » pendant un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "Donc, en résumé, la moindre chose devait être physiquement documentée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Avec la mise en place de cette politique, la consommation de papier de l'Institut a été multipliée par 5...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "Et parce qu'il y avait tellement de documents, chaque bureau a été obligé de créer un poste de « gestion des documents » juste pour catégoriser et trier ceux-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Donc, tout devait être écrit ? Ça semble vraiment ennuyeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Ça l'était ! Ce style a ensuite été révisé pour être progressivement mis en œuvre dans une mesure limitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "#Mais n'en parlons pas maintenant... {M#Chercheur aîné}{F#Chercheuse aînée} d'honneur, pourriez-vous m'aider à déplacer la boîte ? J'ai beau avoir mal, je dois tout de même organiser les dossiers qu'elle contient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Reposez-vous bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Ne vous inquiétez pas, je n'ai besoin que de mes mains. Je ne me blesserai pas davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Je peux demander à quelqu'un de venir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
