			"dialogs": [
				{
					"id": 730410101,
					"content": "#Oh, c'est {M#le nara doré}{F#la nara dorée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "#{F#Amie narienne}{M#Ami narien}, viens jouer avec Aralila{NON_BREAK_SPACE}! Aranishat est trop nul, ne joue pas avec lui{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Pff, Aralila a perdu contre Aranishat la dernière fois, donc Aralila est encore plus nul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "#Bien. Inutile de tergiverser sur le soleil ou la lune. Jouons avec l'{F#amie narienne}{M#ami narien} et voyons qui est le plus fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Ça marche. Aranishat n'a pas du tout peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "#Aralila va se cacher, puis l'{F#amie narienne}{M#ami narien} devra me trouver. Ensuite, c'est à Aranishat de se cacher. Celui qui est trouvé en premier a perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "#{F#Amie narienne}{M#Ami narien}, tu veux jouer ? Si tu es {M#prêt}{F#prête}, on commence tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
		},
