			},
			"dialogs": [
				{
					"id": 730410601,
					"content": "Oups ! Mais comment ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "Aranishat aussi a été trouvé super rapidement. Aussi nul qu'Aralila !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "#Oh... On est tous les deux nuls, il n'y a que {M#le nara doré qui est fort}{F#la nara dorée qui est forte}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "#Ça ne va pas, tout ça ! Il faut entraîner l'ararakalari pour qu'elle soit plus forte et que l'{M#ami narien}{F#amie narienne} ne puisse pas me trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "Ce n'est pas comme ça que ça marche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "#{M#Ami narien}{F#Amie narienne}, as-tu peur de perdre ? Quand on joue, l'important c'est pas de gagner ou perdre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "#On a perdu, mais on s'est bien amusés quand même. {M#Le nara doré}{F#La nara dorée} est vraiment {M#un gentil}{F#une gentille} nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "#L'{M#ami narien}{F#amie narienne} a gagné. Trop {M#fort}{F#forte} ! Prends notre fleur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "#Merci, {M#gentil}{F#gentille} nara ! Tu es {M#un bon ami}{F#une bonne amie} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "Tu t'en sortiras mieux la prochaine fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
					"content": "Oui ! Je ne perdrai pas la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aranishat"
				}
