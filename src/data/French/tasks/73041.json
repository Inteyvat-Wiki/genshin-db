			"dialogs": [
				{
					"id": 730410501,
					"content": "Hahahahahaha ! Aralila est vraiment nul !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410502
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410502,
					"content": "#{M#Le nara doré}{F#La nara dorée} est vraiment {M#impressionnant}{F#impressionnante}, comment a-t-{M#il}{F#elle} pu me voir si rapidement... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410503,
					"content": "#{M#Le nara doré}{F#La nara dorée} est certes {M#impressionnant}{F#impressionnante}, mais c'est surtout Aralila qui est trop nul. Aranishat ne se ferait jamais trouver aussi rapidement. Hmph, regarde un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranishat"
				}
			]
		},
