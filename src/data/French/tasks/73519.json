			"dialogs": [
				{
					"id": 735190101,
					"content": "C'est à n'y rien comprendre... C'est pourtant elle qui a proposé d'aller au café pour écrire le rapport...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Qu'est-ce que vous faites ici tout seul ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "*soupir* Ne m'en parlez pas, elle est partie rédiger le rapport toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "On devait se retrouver au café hier, mais elle est arrivée très en retard. Elle n'avait même pas apporté de quoi écrire pour le rapport !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Je lui ai fait remarquer qu'elle nous faisait perdre du temps pour la rédaction du rapport, et elle s'est mise en colère ! Elle a dit qu'elle écrirait le rapport elle-même et m'a demandé de partir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "C'est ridicule, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Enfin bon, j'ai l'habitude de son tempérament fougueux. Elle finira par se calmer d'ici quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Si seulement il était aussi facile de contrôler ses émotions qu'en enclenchant un mécanisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Bonne chance à vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Hein ? Même vous, vous êtes bizarre, maintenant... Peu importe. Il y a encore quelques Wenuts ici, mais ils se calmeront si on les laisse tranquilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Mais pour éviter qu'ils ne représentent une menace pour les personnes qui passent par ici, aidez-nous à les repousser si vous en avez le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Au passage, l'énergie élémentaire environnante et les chargeurs ont retrouvé leur état normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "C'est le meilleur moment pour essayer le canon anti-Wenut à pleine puissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Je vous souhaite de trouver une solution.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Où est Shriya ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
