			},
			"dialogs": [
				{
					"id": 726550101,
					"content": "Eh bien, on dirait qu'on a enfin trouvé notre cible ! Super ! Je vais enfin pouvoir retourner sur le bateau pour me reposer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "Quoi ? Vous allez partir comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "Bien sûr que non, on est tellement près du but ! Allons-y tout de suite et capturons cette machine des ruines !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "Euh... Je pensais que vous alliez retourner sur le bateau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "*soupir* Bon, peu importe. Suivons-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7265502,
			"completionStepIds": [
				7265503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
