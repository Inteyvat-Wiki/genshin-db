			"trigger": {
				"objectNames": [
					"Muzhen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550201,
					"content": "Haha, nous y voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550202,
					"content": "Difficile de croire qu'il y ait des ruines souterraines ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550203,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "N—Non, ce n'est rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550206,
					"content": "Vous n'avez pas l'air bien. Quelque chose ne va pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550207,
					"content": "Haha. C'est juste que je n'ai pas l'habitude de descendre du bateau, alors cette entrée de ruines... C'est plutôt impressionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550208,
					"content": "Vous trouvez ? Je ne me rends pas compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550209,
					"content": "#M—Mais, on doit suivre les ordres de la capitaine. Je suis sûre que tu es {M#curieux}{F#curieuse} de connaître les trésors qui se cachent à l'intérieur, pas vrai, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550210,
					"content": "#Est-ce que je peux te demander, vu que tu es si {M#expérimenté}{F#expérimentée}, de passer devant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550211,
					"content": "Vous êtes un peu un cas désespéré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "Ça, tu peux le dire ! Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550204,
					"content": "Vous avez trouvé quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
		{
			"id": 7265503,
			"completionStepIds": [],
