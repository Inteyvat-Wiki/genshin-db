				"objectNames": [
					"Muzhen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550301,
					"content": "Hmm ? Vous avez besoin de vous échauffer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550302,
					"content": "Pouvez-vous me dire quelque chose sur ces ruines ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Eh bien, je suis une technicienne sur le bateau, alors je ne suis pas très familière avec ce qu'il se passe sur le continent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "Néanmoins, je crois que ces ruines ont un rapport avec la grande catastrophe qui a eu lieu il y a cinq cents ans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "J'ai grandi en écoutant les vieux marins raconter cette histoire, tu sais ? Ils disaient que ni la terre ni la mer ne pouvaient échapper à l'Abîme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "Mais pour moi, c'était comme les histoires de fantômes qu'on raconte pour effrayer les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "Je veux dire... Seules les choses qu'on peut voir font vraiment peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550303,
					"content": "Savez-vous quelque chose sur ces machines mystérieuses ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
	]
