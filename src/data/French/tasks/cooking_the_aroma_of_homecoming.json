			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "Ouah, qu'est-ce qu'il y a dans cette marmite ? Ça sent si bon ! J'en ai l'eau à la bouche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210102,
					"content": "On dirait une sorte de soupe. Hmm... Difficile de dire à partir de quoi elle a été faite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210103,
					"content": "#Oh là là, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210104,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "La personne qui a fait la soupe n'est pas là, et elle sent si bon, pourquoi ne pas en prendre discrètement une cuillerée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210106,
					"content": "OK, prenons une cuillerée discrètement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210112,
					"content": "La marmite est plus petite qu'elle n'en a l'air.\\nLa soupe qui se trouvait à l'intérieur disparaît en un rien de temps.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "Pouah... Hein ? Même si elle sent bon, cette soupe n'a aucun goût...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210114,
					"content": "Par le grand Aramuhukunda ! Qu'êtes-vous en train de faire, les naras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210115,
					"content": "Un aranara ? D'où est-ce que tu es arrivé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210116,
					"content": "Du sol ! Oubliez ça, pourquoi vous buvez ma soupe ? Moi, Arapas, j'ai travaillé dur pour la préparer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210117,
					"content": "Pardon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "Désolée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210119,
					"content": "Hmph ! Vous avez volé ma soupe ! Vous excuser ne suffira pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210123,
					"content": "Vous savez à quel point c'est difficile de faire de la soupe ici ? Tantôt il pleut, tantôt il fait beau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210124,
					"content": "Je me suis donné du mal pour préparer cette soupe, mais il a fallu qu'Arapas parte cueillir des fruits harras frais pour que vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210125,
					"content": "Ça sentait bon, donc on a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210126,
					"content": "Attends, pourquoi tu fais de la soupe ici si c'est si difficile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210127,
					"content": "Hmph ! L'essentiel en cuisine est d'aller chercher tous les jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210128,
					"content": "C'est ta fierté de chef qui parle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "De l'eau ! L'eau a une influence énorme sur l'arôme de la soupe. Il faut donc utiliser la meilleure eau possible pour la préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210131,
					"content": "Sur le chemin, j'ai invoqué la pluie à divers endroits des Bois d'Apam pour collecter de l'eau qui me sert à préparer ma soupe. Il m'a fallu de très nombreux échantillons d'eau, aussi nombreux que les feuilles des arbres, avant de trouver la meilleure source vivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210132,
					"content": "#C'est la seule source d'eau qui puisse être à la hauteur de la suprême délicatesse du Festival Utsava ! Enfin, ça ne sert à rien de vous expliquer tout ça, vous ne devez pas comprendre... Il n'y a que {M#la}{F#le} nara d'avant qui comprenait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210133,
					"content": "#Au fait, c'est Arapacati qui nous a {M#envoyés}{F#envoyées} ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210134,
					"content": "Vous racontez à Arapas ce qui s'est passé.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "#Ah, alors vous êtes des {M#amis nariens}{F#amies nariennes} de ma sœur ! Et il y a le Festival Utsava qui approche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210136,
					"content": "Tout va bien, j'ai déjà obtenu la source vivante et ma suprême délicatesse est finie. Elle est dans cette marmite... Ou plutôt, était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210138,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "Héhéhé... Ne sois pas triste, au moins, ta soupe sentait vraiment bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210140,
					"content": "Ah ! Ma précieuse source vivante ! Elle était habitée par les apshvaanas. Arapas a attendu si longtemps leur départ et n'en a récupéré qu'une marmite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210141,
					"content": "Ça ne va pas. Vous devez m'apporter une autre marmite de source vivante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210142,
					"content": "C'est quoi, les apshvaanas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210143,
					"content": "Hmph ! Vous, les naras, vous ne connaissez vraiment rien à la forêt. Ils ont quatre pattes et une queue, ils vivent dans l'eau et mordent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210144,
					"content": "... Des chiens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210145,
					"content": "Les chiens ne vivent pas dans l'eau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "Ah, je suis bête. Bon alors, c'est quoi au final, ces apshvaanas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210148,
					"content": "Oubliez ça ! Je veux de l'eau ! Et Arapas veut la source vivante de là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210149,
					"content": "#OK, OK... {NICKNAME}, on n'a pas le choix. Allons-y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210150,
					"content": "Oh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "Il me faut absolument la source vivante, et rien d'autre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210151,
					"content": "Partons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "Peut-être des chiens Mimiqueurs Hydro ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "C'est un engagement que tu t'es juré de tenir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "C—C'est Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#Hé ! {NICKNAME}, comment peux-tu me trahir comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210122,
					"content": "Je me fiche de qui l'a bu, tout ce qui m'importe, c'est que ma soupe a disparu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210108,
					"content": "On ne devrait pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "Je suis vraiment curieuse de savoir quel goût ça a ! Allez, j'en prends une cuillerée, juste une !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210110,
					"content": "Qu'est-ce qu'on va faire si ça te donne mal au ventre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "Hmph ! Ne me sous-estime pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
