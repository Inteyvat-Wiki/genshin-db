			"dialogs": [
				{
					"id": 250330101,
					"content": "C'est bien ! Tu as beaucoup mangé aujourd'hui ? Tu as la force de t'entraîner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330102,
					"content": "Raouh, raouh raouh, raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330103,
					"content": "Bravo ! Tu es en forme aujourd'hui. C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330104,
					"content": "Allez !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "Oh ? Bonjour ! On s'entraîne à escalader la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330107,
					"content": "Raouh raouh ! Raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330108,
					"content": "Raouh raouh, raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330109,
					"content": "Comment se passe votre entraînement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Eh bien... On fait des progrès. Qica a grimpé beaucoup plus haut que la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330111,
					"content": "C'est juste qu'il ne s'est pas encore familiarisé avec les mouvements d'escalade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330116,
					"content": "#{NICKNAME}, pouvez-vous nous faire une démonstration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330117,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "Merci ! Cette fois, je verrai bien tous vos mouvements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330119,
					"content": "Qica, regarde bien toi aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330120,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330123,
					"content": "#C'est à vous de jouer, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330124,
					"content": "On restera ici pour voir combien de temps ça vous prend pour atteindre le sommet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330125,
					"content": "Raouh, raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330121,
					"content": "Ne me quittez pas des yeux, d'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
