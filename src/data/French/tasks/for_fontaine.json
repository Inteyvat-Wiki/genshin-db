				]
			},
			"dialogs": [
				{
					"id": 742490101,
					"content": "Je me sens vraiment mal de vous laisser encore tout le travail, mademoiselle Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Ce n'est rien du tout. C'est bien le moins que je puisse faire après votre soutien lors du Festival cinématographique de Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490103,
					"content": "Oh, je vous en prie ! Les vrais artistes, ce sont les acteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "Ne comptez-vous pas faire un retour sur scène vous-même, mademoiselle Furina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490105,
					"content": "Eh bien... il ne faut jamais dire jamais... Mais pour le moment, je préfère travailler dans l'ombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Pour être honnête, quand je vivais encore à Fontaine, même moi je savais que vous étiez une grande vedette très appréciée, Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490107,
					"content": "Ah, pitié, non ! Quoi que vous fassiez, ne me dites pas que vous « avez grandi en regardant mes spectacles »... Ça me met tellement mal à l'aise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Oh, ce n'est pas ça. Je voulais juste dire que lorsque j'ai quitté Fontaine, j'ai eu la chance de vous voir telle que vous étiez à l'époque, mademoiselle Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490109,
					"content": "Mais en vous revoyant aujourd'hui, je trouve que vous êtes encore mieux comme vous êtes maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490110,
					"content": "Hein...? Comme je suis maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Oui. Sur scène, vous sembliez toujours un peu tendue, alors qu'aujourd'hui, vous paraissez bien plus naturelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490112,
					"content": "Ha, merci de dire ça. En réalité, je préfère aussi ma vie actuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "Et vous, mademoiselle Guillotin ? Êtes-vous satisfaite de votre mode de vie actuel ? Comparé à l'époque où vous avez quitté Fontaine, je veux dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Tout se passe bien, même si je suppose que c'est surtout dû au fait que j'ai mis de l'ordre dans mes idées. J'ai toujours considéré Fontaine comme mon foyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490115,
					"content": "Je ne dis pas que c'est mieux que les autres nations, mais j'ai tant de souvenirs ici. La vie peut y être aussi paisible qu'une eau calme, mais elle peut aussi être pleine de changements inattendus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490116,
					"content": "J'ai récemment appris à voir le bon côté de la vie. Je suppose que les gens ailleurs voient leur terre natale de la même manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490117,
					"content": "Vous l'exprimez si bien, mademoiselle Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "C'est peut-être un petit écart par rapport aux règles de l'étiquette du thé, mais... je propose de trinquer. À Fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Haha... À notre terre natale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
