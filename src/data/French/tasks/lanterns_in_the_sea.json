				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "Vous êtes avec les Pilleurs de trésors ? J'avais clairement indiqué que je serais déguisé dans ma lettre et je les avais invités à en faire de même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "Je vois que l'un d'entre vous n'a même pas pris la peine de le faire. J'admire votre courage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Hmpf ! Contrairement à vous, nous n'avons pas besoin de porter ces déguisements ridicules, parce qu'au contraire de vous, nous ne faisons rien de répréhensible qui nécessite de se cacher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "Hé, fais quelque chose toi ! J'étais en train de lui faire mon discours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "Peut-être qu'il aime bien se déguiser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Vous ne faites pas partie des Pilleurs de trésors ! Qui êtes-vous donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "J'aime bien leur costume, moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
			"completionStepIds": [
				4000504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
