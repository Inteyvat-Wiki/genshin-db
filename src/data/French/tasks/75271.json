			},
			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi, tu es venue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki, c'est toi ? C'est quoi cette tenue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "C'est celle de ton Nanassien préféré. J'ai loué le costume juste pour l'occasion. C'est génial, non ? Oh, et regarde ces ballons ! Je les ai préparés rien que pour toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "En fait, il y a quelque chose que je veux te demander depuis longtemps... Est-ce que tu veux bien sortir avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "... Tu n'es pas sérieux là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Je suis on ne peut plus sérieux ! Ma douce Yopoyi, je t'en prie, sors avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Tu t'es cogné la tête en enfilant ce costume ou quoi ? C'est notre troisième anniversaire de MARIAGE !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Je sais ! Mais... tu m'as toujours dit que je n'étais pas assez romantique, que nous n'avons même pas eu de véritable déclaration d'amour avant notre mariage... Alors, même si c'est un peu tard, je te fais ma déclaration !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Haha... C'est donc ça ? D'accord. J'accepte de sortir avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Pour de vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Oui, pour de vrai, espèce d'idiot désespérément romantique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Un coup de vent souffle et les amoureux s'enlacent.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
