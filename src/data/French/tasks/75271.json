			},
			"dialogs": [
				{
					"id": 752710501,
					"content": "Merci du fond du cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710502,
					"content": "Ziki a dû vous en faire voir de toutes les couleurs. Sa façon de voir les choses est parfois peu conventionnelle, mais c'est ce que j'aime chez lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yopoyi"
				}
			]
		},
		{
