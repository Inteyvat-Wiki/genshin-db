					"content": "Je vais vous aider à les peindre en rouge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710402
					]
				},
				{
					"id": 752710402,
					"content": "#Vraiment ? Merci énormément ! Vous êtes un {M#ami}{F#amie} au grand cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
