			},
			"dialogs": [
				{
					"id": 752710201,
					"content": "#Quelle chance de vous avoir {M#rencontré, mon ami}{F#rencontrée, mon amie}. Aidez-moi à peindre ces ballons en un rouge passion.",
					"roleType": "TALK_ROLE_NPC",
