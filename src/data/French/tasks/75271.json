			"trigger": {
				"objectNames": [
					"Ziki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Des ballons rouges et romantiques... Je suis sûre que tant de beauté fera vibrer le cœur de ma bien-aimée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "#Pas vrai, {M#mon ami}{F#mon amie} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "#Je... ne suis pas {M#le mieux placé}{F#la mieux placée} pour répondre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "#Peu importe ce qu'il se passera, merci beaucoup, {M#mon ami}{F#mon amie}. Ne partez pas tout de suite, j'aimerais vous présenter Yopoyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Vu l'heure qu'il est... Elle devrait être là d'un moment à l'autre. Nous nous sommes donné rendez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Je suis sûre qu'elle sera époustouflée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
		{
			"id": 7527104,
