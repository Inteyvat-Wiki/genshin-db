					"speakerTitle": "Ziki"
				}
			]
		},
		{
			"id": 7527103,
			"completionStepIds": [
				7527103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
