			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "#Vous m'avez l'air {M#intéressé}{F#intéressée} par le travail de détective, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "#Je peux devenir {M#un}{F#une} détective ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "#Vous aimeriez en devenir {M#un}{F#une} ? Ce n'est pas aussi simple qu'il n'y paraît. Ne vous laissez pas berner par les romans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "Quand les détectives font leur travail, il n'y a pas de course-poursuite palpitante, ni de décisions de vie ou de mort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Un bureau rempli de paperasse, des routes de montagne boueuses et des suspects qui ne montrent jamais leur vrai visage... Voici à quoi ressemble notre quotidien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Enfin, je ne pense pas que vous puissiez comprendre dit comme ça. Mais ça tombe bien : j'ai un petit boulot pour vous si vous souhaitez vivre l'expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Mon assistant s'appelle Ryuuji. Il est parti chercher des pistes tout à l'heure, mais il n'est pas encore revenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "Vu l'heure qu'il est, il doit avoir sans doute terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "J'aimerais que vous le rameniez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "Vous croyez qu'il s'est retrouvé dans une situation dangereuse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Je lui ai déjà tout expliqué. Avec son habileté, il devrait s'en sortir même s'il se retrouvait dans une situation délicate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "La chose qui m'inquiète davantage, c'est qu'il n'ait pas trouvé ce que je cherchais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Bref, je compte sur vous. Je vous récompenserai pour le dérangement... et vous vous ferez une idée du travail de détective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "Peut-être qu'il a eu un imprévu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Impossible, il sait déjà ce qu'il doit faire. Je lui ai tout expliqué en détail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "Et s'il lui était arrivé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "Avec son habileté, il devrait s'en sortir s'il se retrouvait dans une situation délicate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "La chose qui m'inquiète davantage, c'est qu'il n'ait pas trouvé ce que je cherchais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "J'ai l'impression que ça ne va pas être de tout repos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Évidemment. Notre métier consiste à résoudre les problèmes des gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "Les courses-poursuites et les décisions de vie ou de mort comme dans les romans sont des inventions pures et simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "Un bureau rempli de paperasse, des routes de montagne boueuses et des suspects qui ne montrent jamais leur vrai visage... Voici à quoi ressemble notre quotidien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "Mais nous travaillons sur toutes sortes d'affaires, et c'est bien la seule chose vraie dans ces récits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "Vous avez un assistant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "De toute évidence. Il est occupé pour le moment, mais j'ai besoin d'une autre personne pour aider à l'instant précis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "Vous pourriez le faire si cela ne vous dérange pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				}
			]
		},
