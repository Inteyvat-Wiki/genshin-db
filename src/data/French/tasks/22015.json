					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "Je ne connais que les conseillers juridiques...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "Ah, j'en ai entendu parler. Ce sont des gens avec qui il est difficile de traiter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "La seule chose qu'ils savent faire à la perfection, c'est bien de compliquer les choses simples en les formalisant, puis en les incorporant à un contrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
					"content": "J'espère ne jamais avoir affaire à ces gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
