				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "Je n'ai jamais vu ça à Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "Les Liyuéens n'ont pas besoin de détectives. J'ai entendu parler de l'importance qu'ils accordent aux contrats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150603,
					"content": "De plus, les Millelithes sont toujours déployés rapidement sur le terrain en cas de problème, peu importe son ampleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150604,
					"content": "Même s'il y avait des agences de détectives, elles auraient très vite mis la clé sous la porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201507,
