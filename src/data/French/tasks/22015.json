			"dialogs": [
				{
					"id": 220150501,
					"content": "Je n'ai jamais vu ça à Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Mondstadt ? Vous parlez bien de la Cité de Mondstadt ? J'ai entendu certaines choses à son sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "Ses deux produits les plus renommés sont le vin et la liberté, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Hahaha, ils sont complémentaires, en plus ! S'il y avait des détectives là-bas, leurs affaires seraient florissantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
