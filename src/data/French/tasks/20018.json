			"dialogs": [
				{
					"id": 200180601,
					"content": "Merci beaucoup ! Ça fera l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180602
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180602,
					"content": "Je peux poursuivre mon chemin jusqu'à Deauclaire comme ça. Une fois que j'aurais déposé la marchandise, j'expliquerai ce qu'il s'est passé quand je reviendrai au Domaine de l'Aurore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180603
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180603,
					"content": "J'espère qu'Elzer ne va pas me virer en voyant l'état de la charrette.",
