				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "Merci. Je vous promets que je vais arranger les choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180102,
					"content": "À quoi je sers si je ne peux même pas livrer une cargaison de vin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180103,
					"content": "Je vais être renvoyé du Domaine si je ne me reprends pas... À moins que monsieur Connor ait déjà décidé que je n'étais d'aucune utilité. Gloups... Si ça se trouve monsieur Elzer est déjà en train de rédiger la lettre de licenciement au moment où je vous parle... Mon dieu, tout espoir est perdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180104,
					"content": "Calmez-vous un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "*soupir* Ma situation est irrécupérable, mais je livrerai ce vin à tout prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180106,
					"content": "Mon véhicule est endommagé... Pourriez-vous me chercher de quoi le réparer ? Une <color=#00E1FFFF>planche solide</color> sera amplement suffisante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar"
				}
			]
		},
