			"dialogs": [
				{
					"id": 200180401,
					"content": "Merci beaucoup ! Heureusement que vous étiez là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180402,
					"content": "Par contre, ça va être difficile de réparer mon véhicule maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180403,
					"content": "Il est cassé de partout... Bon, je suppose qu'il n'y a rien à faire à part essayer de le réparer de façon temporaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180404,
					"content": "Ça me va, du moment qu'elle tient jusqu'à ce que j'atteigne la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180405,
					"content": "J'avais des cordes, mais je crois que les monstres se sont fait la malle avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Magar"
				},
				{
					"id": 200180406,
					"content": "Peut-être qu'elles sont <color=#00E1FFFF>dans la forêt</color> ? Vous pourriez aller y jeter un coup d'œil pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar"
				}
