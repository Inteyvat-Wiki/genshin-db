					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "*tousse* Ça ne va pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830102,
					"content": "Si je traîne encore, je vais rater la date limite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830103,
					"content": "Bonjour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830106,
					"content": "Pardon ! Je suis désolée ! Je vais rendre mon travail aujourd'hui, promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830107,
					"content": "Ouah ! Du calme, on est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830108,
					"content": "Mademoiselle Moriko ! S'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830109,
					"content": "Oh ? Ce n'est pas elle... Quel soulagement... Ahem ! *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830110,
					"content": "Qui est mademoiselle Moriko ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "C'est mon éditrice exécutive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830112,
					"content": "Je m'appelle Asagiri, je suis... Euh, une illustratrice indépendante. Mademoiselle Moriko est en charge d'éditer mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830113,
					"content": "Illustratrice ? Qu'est-ce que c'est comme métier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830114,
					"content": "Vous avez sûrement déjà lu des romans légers de la Chambre Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830115,
					"content": "Et vous avez dû remarquer qu'il y a plusieurs pages avec uniquement des dessins, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830116,
					"content": "Ce sont des illustrations, et les illustrateurs sont ceux qui les dessinent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830117,
					"content": "Un auteur choisit souvent une illustration pour accompagner une scène importante de l'histoire ou marquer l'apparition du protagoniste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830118,
					"content": "C'est une façon de donner davantage d'attrait au roman, mais aussi d'enrichir son contenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830119,
					"content": "Oh... C'est compliqué de faire paraître son roman en réalité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830120,
					"content": "Je peux vous en recommander quelques-uns ! Comme... Ahem ! *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830121,
					"content": "Est-ce que ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "Tout va bien, je n'ai jamais été très en forme. Mon travail me garde éveillée jusqu'en pleine nuit et j'en oublie même de manger parfois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830123,
					"content": "*tousse* ... Ma santé se dégrade à cause de ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830124,
					"content": "Si vous vous sentez aussi mal, pourquoi dessinez-vous ici ? Vous ne pouvez pas le faire chez vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830125,
					"content": "Je suis ici à la recherche d'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830126,
					"content": "Je suis à sec ces derniers temps, et ça m'a fait rater les échéances de certaines illustrations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830127,
					"content": "Mademoiselle Moriko a repoussé l'échéance plusieurs fois pour m'arranger, mais elle sera contrariée si je continue de traîner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830128,
					"content": "Je me suis dit qu'un petit voyage pouvait peut-être stimuler mon inspiration, alors j'ai décidé de me lancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830129,
					"content": "Haha... Résultat ? Je me retrouve dans cet état lamentable à peine sortie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830130,
					"content": "*soupir* Je ferais mieux de déposer un ordre de mission à la Guilde des aventuriers pour demander l'aide d'un aventurier équipé d'un Daguerréotype.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830131,
					"content": "Oh ? En parlant de Daguerréotype...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830132,
					"content": "J'en ai un...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "Oh ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830135,
					"content": "Je... Je voulais qu'un aventurier m'aide à prendre des photos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830136,
					"content": "J'ai entendu dire qu'il y avait des endroits splendides à l'étranger ! Par exemple, les grandes montagnes enneigées près de Mondstadt ou encore la forêt de pierre à Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830137,
					"content": "Puis il y a aussi ce lieu nommé « Karst Jueyun » ! On raconte que c'est là que les Adeptes vivent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830138,
					"content": "Ah, ça me donne des frissons rien que d'y penser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830139,
					"content": "Malheureusement, ma santé fragile ne me permet pas de m'y rendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830140,
					"content": "Par contre, si vous pouviez me le prendre en photo avec le Daguerréotype, je... *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830141,
					"content": "Waouh, calmez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830142,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "Vraiment ?! Super ! J—J'aimerais voir plein d'endroits ! Attendez, je vous sors la liste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830145,
					"content": "Ah, et ne vous en faites pas pour la récompense. J'ai encore de l'argent de côté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830146,
					"content": "Mon carnet... Où est-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830143,
					"content": "Je vais trouver un moyen de le faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "Mais que voulez-vous faire avec ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "Excusez-moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}