			"dialogs": [
				{
					"id": 250350801,
					"content": "Deux... Trois... Le compte est bon ! Excellent boulot, vous les avez bien tous retrouvés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "... Hé, mais Tunduma était censé livrer celui-ci, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "Voici votre rémunération. Merci du coup de main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350804,
					"content": "Je vais devoir aller remonter les bretelles de Tunduma...",
					"roleType": "TALK_ROLE_NPC",
