			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Quels imbéciles, ma parole... Comment ont-ils pu encore perdre des colis ? Je leur ai dit de ne pas faire n'importe quoi pendant les livraisons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "Il s'est passé quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Quelques-uns de nos coursiers ont une fois de plus ignoré les instructions. Résultat ? Plusieurs colis ont été perdus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "*soupir* Ils ne se rendent pas compte qu'une telle négligence nuit à l'image des Êtres des canopées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Il faut rester concentré pendant le travail ! Pour descendre une pente, il suffit de continuer d'avancer normalement et ne pas faire de la glisse dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Je n'arrête pas de rabâcher la même chose, mais les jeunes n'écoutent rien. Tout ce qui les intéresse, c'est les sensations fortes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "*soupir* Maintenant, je vais devoir demander à quelqu'un de récupérer ces colis. Voyons voir, qui serait libre en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Vous voulez bien ? Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Cela me prendrait un certain temps pour trouver quelqu'un, et si j'y allais moi-même, personne ne veillerait sur la Maison longue des coursiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "Évidemment, je ne vais pas vous envoyer chercher une aiguille dans une botte de foin. Je connais les itinéraires que les gamins empruntent d'habitude, alors je peux vous dire approximativement où les colis ont été perdus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "Je vais marquer ces emplacements sur votre carte. Merci d'avance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Ces colis sont-ils grands ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Non, et c'est ce qui les rend si difficiles à trouver. *soupir* Ces petits vauriens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "... Si vous êtes libres, pourriez-vous les retrouver pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "La Maison longue des coursiers est à court de personnel en ce moment. Si j'y allais moi-même, personne ne pourrait me remplacer ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Pas de problème, je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Formidable ! Merci infiniment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
