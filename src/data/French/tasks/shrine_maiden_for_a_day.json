			"dialogs": [
				{
					"id": 191451601,
					"content": "Je prie pour que l'Archon Électro bénisse cette vieille dame et sa petite-fille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "La dame a des problèmes de vue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Vous avez remarqué ? C'est exact, elle ne voit plus très bien. Nous nous inquiétons à chaque fois qu'elle vient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Mais elle refuse toujours notre aide, car elle connaît le chemin par cœur à force de l'emprunter seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Heureusement qu'il y a des prêtresses qui peuvent garder un œil sur elle dans le coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Que l'Archon Électro veille sur cette dame et sa petite fille et éloigne le danger sur leurs routes respectives...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
