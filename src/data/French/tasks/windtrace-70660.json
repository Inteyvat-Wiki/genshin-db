				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "Bonjour, ça vous dit d'essayer la « Poursuite du vent » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600202,
					"content": "C'est quoi la « Poursuite du vent » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "Je suis content que vous demandiez ! La Poursuite du vent, c'est un jeu basé sur l'histoire de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600204,
					"content": "Vous devez avoir entendu parler des aristocrates qui vivaient autrefois dans la Cité de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600205,
					"content": "C'étaient des tyrans et leur règne était brutal. On ne peut même pas décrire la façon dont le peuple a souffert sous leur joug...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600206,
					"content": "Pour lutter contre leur oppression, un groupe de braves citoyens s'est réuni pour former une résistance clandestine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600207,
					"content": "Ces vaillants rebelles ont mené des opérations dans toute la cité, mettant de sérieux bâtons dans les roues des aristocrates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600208,
					"content": "Mais les aristocrates ont riposté, formant rapidement leur propre équipe d'hommes de main pour réprimer les rebelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600209,
					"content": "Et ainsi, les rebelles se sont battus lutte après lutte avec les laquais des aristocrates dans tout Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600210,
					"content": "La Poursuite du vent s'inspire de ce chapitre passionnant de l'histoire de Mondstadt ! C'était un jeu très apprécié avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600211,
					"content": "« Avant » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "Malheureusement, oui. Les jeunes n'ont pas l'air très intéressés par ce jeu de nos jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600213,
					"content": "Je ne peux pas me résoudre à laisser la Poursuite du vent tomber dans l'oubli. Alors, j'ai modifié un peu les règles pour que ce soit plus accessible et plus amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600214,
					"content": "J'ai également ajouté un tas de nouvelles cartes. J'espère que ça aidera à attirer plus de monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600217,
					"content": "Alors, qu'est-ce qu'il se passe avec la « Poursuite du vent » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "J'ai fait faire des tests à un groupe de personnes. Il y en a qui étaient vraiment bons. À vrai dire, j'étais impressionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600219,
					"content": "Mais il y en a aussi beaucoup qui ont dit que c'était difficile comme jeu. Soit les rebelles se plaignaient qu'ils n'avaient pas assez d'options pour s'enfuir, soit le chasseur se plaignait de ne pouvoir trouver personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600220,
					"content": "Il y en a même qui ont critiqué le fait qu'il faille bien connaître chaque carte pour pouvoir jouer correctement et qui ont demandé à ce que je simplifie les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600221,
					"content": "*soupir* Je ne sais plus qui écouter, alors j'ai décidé d'inviter d'autres gens pour tester à nouveau et voir ce qu'ils en disent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
		{
			"id": 7066004,
