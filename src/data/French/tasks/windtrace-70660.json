				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590301,
					"content": "Mais vous n'avez pas besoin de me croire sur parole. Vous n'avez qu'à essayer par vous-même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590302,
					"content": "Jouer à la « Poursuite du vent »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Partir",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "Très bien. Si jamais vous voulez essayer, vous savez où me trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
