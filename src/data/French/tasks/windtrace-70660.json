					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "Bienvenue. Comment se déroulent tes aventures jusqu'à présent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600102,
					"content": "Tout va bien, je pense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "#Parfait. Tu es en voie de devenir {M#un grand aventurier}{F#une grande aventurière}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600104,
					"content": "Ah oui, c'est vrai, si ça t'intéresse, tu peux toujours aller voir Gygax pour essayer la nouvelle version de la « Poursuite du vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600108,
					"content": "Est-ce que ça a quelque chose à voir avec la Guilde des aventuriers ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Eh bien, en fait, Gygax nous a chargés de l'aider à trouver des gens pour tester la « Poursuite du vent »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600110,
					"content": "Donc on peut considérer que les deux sont liés d'une certaine façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600111,
					"content": "Dans tous les cas, tu peux toujours essayer pour voir. D'après les aventuriers qui y ont joué, c'est plutôt amusant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600105,
					"content": "#Est-ce qu'il y a de nouvelles missions{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "Pas pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 706600107,
					"content": "Mais si ça t'intéresse, tu peux toujours aller voir Gygax pour essayer la nouvelle version de la « Poursuite du vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Catherine"
				}
			]
		},
		{
			"id": 7066002,
			"completionStepIds": [
				7066002,
				7066005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
