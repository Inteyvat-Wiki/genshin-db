			"dialogs": [
				{
					"id": 400400101,
					"content": "Messieurs-dames, approchez ! Vous ne le regretterez pas ! Voici la « lanterne à ombres » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400102
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400102,
					"content": "Oooh ? Qu'est-ce que c'est ? Je n'en ai jamais vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400400103,
					"content": "#Vous avez l'air de bien profiter du festival, {M#tous les deux}{F#toutes les deux} ! Ça vous intéresse de voir la « lanterne à ombres » ? C'est ma dernière invention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400104
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400104,
					"content": "Elle est simple d'utilisation : vous n'avez qu'à tourner les objets à l'intérieur pour que leurs ombres fusionnent d'une certaine façon et qu'elles constituent des images incroyables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400106
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400106,
					"content": "Si ma petite présentation a éveillé votre curiosité, essayez-la ! Elle est juste là, à votre disposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400107
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400107,
					"content": "J'espère que vous y verrez quelque chose de formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400108
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400108,
					"content": "Je suis vraiment curieuse de voir ce que ça donne, faisons joujou avec !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
