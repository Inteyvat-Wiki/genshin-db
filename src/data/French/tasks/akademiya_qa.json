					"Ziryab",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Je me demande si ces questions ne sont pas trop difficiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "#Oh ? {M#Voyageur}{F#Voyageuse} ! Attendez un peu, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "C'est à moi que vous parlez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Oui ! Haha, j'aimerais vous demander un petit service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Avez-vous perdu quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "Ah ? Pourquoi cette question ? Vous semblez vous y connaître. Hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Mais non. Je n'ai rien perdu, et je ne manque pas de données pour mes recherches. Et en ce qui concerne l'inspiration... Eh bien, sachez que j'en ai bien assez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Ahem. À vrai dire, je suis en train d'écrire une brochure de questions-réponses pour aider les nouveaux étudiants à maîtriser rapidement les termes couramment utilisés à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "En un mot, il s'agit d'expliquer des noms compliqués sous forme de questions et de réponses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "De cette façon, l'apprentissage sera plus efficace et intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Cependant, je ne suis pas sûr du niveau de difficulté de ces questions... Alors, j'aimerais solliciter votre avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Je ne connais pas très bien l'Académie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Haha, ce n'est pas grave. Vous la connaîtrez un peu mieux après avoir répondu à mes questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Ne vous inquiétez pas. Ce ne sont pas des questions difficiles, elles portent... sur des connaissances communes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Bon, je me lance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Pourquoi ai-je une sensation de déjà-vu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Tu parles des questions que Swann t'a posées à Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Mais Swann nous a donné les réponses à l'avance ! Je ne crois pas que ce chercheur fera la même chose pour nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Êtes-vous à court de matériaux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Vous cherchez l'inspiration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
