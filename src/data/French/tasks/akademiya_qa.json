			"dialogs": [
				{
					"id": 230260301,
					"content": "Peut-être que vous avez rencontré des chercheurs itinérants qui se qualifient de driyoshs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "À vrai dire, il y a beaucoup de driyoshs dans un certain darshan de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Faisant des éléments le noyau de sa théorie, ce darshan se concentre sur l'étude des choses étroitement liées aux pouvoirs élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Ma question est : quel est le nom de ce darshan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Le Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Bingo. Le Spantamad est là où se regroupent les chercheurs de l'élémentalisme qui considèrent les sept éléments comme l'essence de toute substance et de toute vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "L'Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Haha, c'est faux. Les chercheurs de l'Haravatat se concentrent sur les recherches en matière de langage, sémiotique et logique... Croyez-moi, leurs études sont très complexes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Le Rtawahist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Malheureusement, c'est faux. Le Rtawahist est le centre de l'illuminationnisme, dont les recherches se focalisent sur le ciel étoilé au-dessus de nous... Héhé, c'est intéressant, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
