					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080204,
					"content": "Vous êtes en avance, mais pas trop en retard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080205,
					"content": "Qu'est-ce qu'elle raconte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080206,
					"content": "Pardon ? Je ne comprends pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "Ah. Vous ne l'avez pas encore remarqué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080208,
					"content": "Ce n'est pas plus mal en fin de compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080209,
					"content": "Rebroussez chemin et attendez son réveil. Vous comprendrez alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiu"
