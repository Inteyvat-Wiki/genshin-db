				},
				{
					"id": 718080302,
					"content": "Voilà ce que j'ai constaté à Nantianmen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Des tremblements de terre, des monstres et une petite fille ? Était-elle portée disparue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Elle nous a dit quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "Quoi ? La résurrection de qui ? Ce sont des salades...",
					"roleType": "TALK_ROLE_NPC",
