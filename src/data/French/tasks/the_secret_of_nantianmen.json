						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Cette petite a dû lire trop d'histoires... Passons. Je vais demander à des collègues de la ramener en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "J'espère qu'elle n'est pas blessée au moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Merci beaucoup. Prenez cette récompense pour votre travail.",
