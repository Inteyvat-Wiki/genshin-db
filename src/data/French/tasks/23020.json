			},
			"dialogs": [
				{
					"id": 230200501,
					"content": "#Oh ! Merci, {M#voyageur}{F#voyageuse}. Voilà, une récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Franchement, je ne m'attendais pas à ce que ces matériaux soient aussi lourds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Je vais démarrer la construction dès que possible. C'est un petit bateau, donc ça ne me prendra pas longtemps. Il sera sans doute vite prêt pour effectuer des essais en mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "... Il faudra bien enfiler vos gilets de sauvetage le moment venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Oh, il n'y aura pas de problème, absolument pas, fais-moi confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
