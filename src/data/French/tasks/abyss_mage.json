			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "L'Ordre de l'Abîme... Très peu de renseignements circulent sur l'Ordre de l'Abîme et ses serviteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "Ça n'aura pas été facile, mais j'ai tout de même mis la main sur quelques indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "Vraiment ? Aussi rapidement ? Votre réseau est très performant, maître Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "J'y pense, ô Archon Barbatos... Pourquoi solliciter l'aide de simples humains ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "Haha, par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "Le vrai nom de ceux que l'on appelle les Sept Archons est « les Sept patriarches ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Chacun d'entre eux veille sur l'un des sept territoires en Teyvat. C'est ce qui, à nos yeux, est la responsabilité d'une divinité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Ce n'est qu'en répondant à l'appel du devoir qu'on détient cette puissance... Mais de là à diriger... Mondstadt se débrouille très bien comme elle est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "« Bâtissez une cité libre, que nul ne dominera »... Ainsi parlait Barbatos. N'oublions pas ses mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "Quelle piété, Grande Maîtresse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Peut-être que quelqu'un a pris un peu trop de temps libre ou est trop paresseux pour s'en soucier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "Héhé... Enfin, comme vous pouvez le voir, cela fait un moment que je n'ai pas remis les pieds à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "Ce qui fait sûrement de moi à l'heure actuelle le plus faible des Sept !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "On dirait que tu en es fier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Haha, on me flatte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "Un dieu si humble... Est-ce une bénédiction ou une malédiction ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Bref, revenons à notre sujet, aux Sept Nations et aux Sept Archons – et à l'ennemi de l'humanité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "Les premières <color=#00E1FFFF>traces du Mage de l'Abîme</color> ont été retrouvées près du <color=#00E1FFFF>Domaine de l'Aurore</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Nous devons l'attraper coûte que coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "La chasse est ouverte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Rien de surprenant à ce que tu sois l'Archon de la cité de la liberté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "Hein ? Mais qu'est-ce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970402,
					"content": "Une espèce d'énergie se dégage du corps du Mage après sa défaite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970403,
					"content": "On dirait qu'elle a été conçue pour me garder à l'écart de Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}, tu as entendu parler de l'<color=#00E1FFFF>Antre de Stormterror</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970406,
					"content": "Pas du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "Mais Jean et maître Diluc doivent connaître son emplacement, eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970410,
					"content": "Dvalin a établi son repaire dans ces ruines après son réveil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970411,
					"content": "Leur entrée est protégée par une barrière spéciale qui est similaire à celle qui coupait Mondstadt du monde extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970412,
					"content": "Mais j'arrive à présent à reconnaître dans la dispersion d'énergie du Mage de l'Abîme la mélodie de la magie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970413,
					"content": "C'est pire qu'un chœur de Brutocollinus, mais bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970414,
					"content": "Ça sera assez pour débloquer l'entrée de l'<color=#00E1FFFF>Antre de Stormterror</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970415,
					"content": "Nous allons donc confronter directement Dvalin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970416,
					"content": "Personnellement, ça me va. C'est Jean qui souhaite l'éviter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970417,
					"content": "Non. En l'absence de meilleure solution, la responsabilité du changement de cap me revient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970418,
					"content": "Si affronter le dragon Anémo est la seule solution, alors que je sois le chevalier qui mène la charge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970419,
					"content": "Nous en sommes encore loin, j'ai peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970420,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970421,
					"content": "Venti, vous voulez dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970422,
					"content": "La lyre sacrée n'était pas notre botte secrète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970423,
					"content": "#C'est {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME} ? Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970425,
					"content": "Parce que j'ai réussi à purifier les cristaux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "C'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970430,
					"content": "Les impuretés présentes dans les cristaux et la malédiction qui touche Dvalin sont faites de la même énergie maléfique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970431,
					"content": "Donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970432,
					"content": "Non ! C'est trop dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970433,
					"content": "#Et les grandes babines de Dvalin ?! {NICKNAME} va se faire dévorer avant d'avoir pu bouger son petit doigt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970434,
					"content": "#On n'était pas en train de dire comme je suis {M#doué}{F#douée} ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "Hé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970437,
					"content": "Un plan intéressant. Ça se tente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970438,
					"content": "#Je suis avec toi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970439,
					"content": "Nos ennemis sont des monstres de l'Abîme, et... un dragon ! Pas de quoi se mettre la pression.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970440,
					"content": "Les hommes aussi ont leur valeur cachée... Bien, en route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970441,
					"content": "Dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970442,
					"content": "Ainsi donc débute enfin le combat de l'héroïque épopée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970435,
					"content": "Nous devons tout donner si nous voulons gagner cette fois-ci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "#Parce que je suis {M#super puissant ?}{F#super puissante ?}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "#Hum... Bien sûr, tu es une force de la nature, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970429,
					"content": "Mais tu as un atout encore bien plus précieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970408,
					"content": "Je crois en avoir entendu parler dans les rues de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
					"id": 3970409,
					"content": "Oui, venant de Mondstadt, il est normal d'être au courant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}