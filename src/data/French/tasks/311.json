					"content": "Pfiou, on a enfin terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "Les flux élémentaires et les lignes énergétiques de Mondstadt devraient être retournés à la normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "On devrait aller voir comment les <color=#00E1FFFF>chevaliers</color> se débrouillent, qu'en penses-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Si tu as d'autres choses à faire avant, je veux bien t'accompagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "On pourrait aller faire les courses ou faire une offrande à une <color=#00E1FFFF>Statue des Sept</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "Il me semble que nous avions trouvé comme du... vent solidifié dans les temples que nous avons visités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "On appelle ça des Anémoculus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "On peut placer ces orbes dans les yeux des statues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "Une légende raconte qu'une hirondelle les aurait arrachés pour les disperser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "En réalité, les Anémoculus n'ont jamais eu de forme physique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Les détenteurs d'un œil divin les récupèrent et les offrent aux <color=#00E1FFFF>Statues des Sept</color> en échange de bénédictions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "Tu n'as pas d'œil divin... Mais comme tu viens d'un autre monde, j'imagine que tu fais exception à la règle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "On peut essayer tout de suite si tu veux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "La statue qui se trouve à Ventlevé doit être la plus proche d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "J'ai hâte de voir comment les Archons répondront à tes prières !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
