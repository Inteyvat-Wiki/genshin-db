			"dialogs": [
				{
					"id": 191735301,
					"content": "Un « système d'irrigation automatique. »... Vous n'avez pas choisi le sujet le plus facile, madame Faruzan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735302
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735302,
					"content": "Maître, est-ce que je peux faire quelque chose pour vous aider ? Je peux aller faire des courses, ou vous préparer de quoi écrire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735303
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735303,
					"content": "Hmm... Si je me souviens bien, tu as beaucoup de devoirs à faire aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735304,
					"content": "Ah ! Euh... Oui, c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735305
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735305,
					"content": "Alors, fais vite tes devoirs et couche-toi tôt. La meilleure chose que tu puisses faire pour aider, c'est de ne pas laisser madame Faruzan s'inquiéter pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735306
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735306,
					"content": "Oh... D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735307
					],
					"speakerTitle": "Collei"
				},
				{
