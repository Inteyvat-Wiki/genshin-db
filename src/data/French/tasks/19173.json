					"nextDialogs": [
						191737102
					],
					"speakerTitle": "Note jaunie"
				},
				{
					"id": 191737102,
					"content": "« Quand je le modifiais, je n'arrêtais pas de me dire que tu t'en tirerais encore mieux que moi si tu étais à ma place. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Note jaunie"
				},
				{
					"id": 191737103,
					"content": "« Il faut dire que tu es l'élève la plus brillante qu'il m'ait été donné de voir. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Note jaunie"
				}
			]
		},
