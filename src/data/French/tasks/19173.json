					"nextDialogs": [
						191730602
					],
					"speakerTitle": "Villageois curieux"
				},
				{
					"id": 191730602,
					"content": "#On dit que ce serait le fait {M#d'un seul voyageur}{F#d'une seule voyageuse}. Est-ce que c'est seulement humainement possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Villageois curieux"
				}
