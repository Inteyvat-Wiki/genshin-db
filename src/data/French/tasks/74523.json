				"points": []
			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "Dans cette brise... je sens l'odeur salée des marées, le parfum boisé des navires marchands au loin, et aussi... les nouvelles d'une vieille connaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}, j'espère que vous vous portez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Kazuha, ça faisait longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "La Flotte du Crux fait escale à Inazuma pour se ravitailler. Comme j'ai rarement l'occasion de revoir ma terre natale, j'ai souhaité me promener un peu, contempler une fois de plus les paysages et écouter le murmure du vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "Les vents de Ritou sont toujours plus bruyants qu'ailleurs, mêlant adieux et retrouvailles, espoirs et incertitudes... C'est un endroit où l'on peut entendre de nombreuses histoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Puis-je vous prendre en photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Héhé, toute chose en ce monde a une forme, y compris le vent. Mais sa silhouette ne se dévoile qu'à travers les feuilles qui tombent, les vagues qui s'élèvent, ou dans l'envol fugace des habits d'un voyageur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "#J'espère qu'à travers ma silhouette, vous pourrez saisir cette « forme du vent{NON_BREAK_SPACE}» éphémère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Très bien, je me lance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "Dans ce cas, je vous invite à composer le poème célébrant cet instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Comme tout à l'heure, contentez-vous de ressentir le vent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Je souhaite aussi capturer le vent en cet instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
