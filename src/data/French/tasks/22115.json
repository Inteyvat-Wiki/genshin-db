			"dialogs": [
				{
					"id": 221150601,
					"content": "*soupir* Ah, petit Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150602,
					"content": "Chang le Neuvième est de retour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Oui, j'ai vu ! Merci, mes enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Il a toujours été comme ça, depuis tout jeune... À chercher les problèmes dès qu'il peut. Il a beau dire qu'il a mûri, il reste toujours le même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150605,
					"content": "Enfin, rien à y faire. Petit Chang sera toujours petit Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150606,
					"content": "Merci à vous deux, mes enfants. Tenez, prenez ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150607,
					"content": "Tu as sûrement à faire, je ne vous dérange pas plus longtemps. Mais... Ne finissez pas comme petit Chang. Il accorde tellement d'importance au regard des autres, qu'il n'a jamais pris le temps de se regarder lui-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150608,
					"content": "*soupir* Les hommes ne sont pas les Adeptes... Et la vie n'est que souffrance avant la libération de la mort... Ah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
