			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Ces monstres sont une vraie plaie, ah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150202,
					"content": "Non seulement je n'ai pas trouvé l'inspiration, mais il faut en plus que je tombe sur ces sales bêtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150203,
					"content": "Merci à vous deux. Je ne sais pas ce que je serais devenu sans votre intervention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150204,
					"content": "Grand-mère Ruoxin se fait un sang d'encre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Ah ? À quoi bon ? Je ne suis plus tout jeune, je sais prendre soin de moi... J'aurais pu m'occuper de ça, s'il avait fallu, mais ça m'aurait demandé pas mal d'énergie, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150206,
					"content": "Enfin, merci de m'avoir aidé. Je ferais mieux de rentrer, ou alors j'en connais une qui ne va pas arrêter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
