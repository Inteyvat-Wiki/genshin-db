				},
				{
					"id": 221150702,
					"content": "Qu'est-ce qu'il est parti faire à la Pente Wuwang ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150703
					]
				},
				{
					"id": 221150703,
					"content": "Il a dit qu'il voulait faire des recherches pour son nouveau roman, comme quoi le silence l'aide à trouver l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150704
