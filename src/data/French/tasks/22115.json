					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "Tsss... Mais où est donc passé le petit Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150102,
					"content": "« Le petit Chang »...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Le petit Chang ? Celui que tout le monde appelle Chang le Neuvième.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150104,
					"content": "Je l'ai toujours appelé comme ça, et l'habitude est restée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Il est parti hier soir après avoir dit qu'il allait faire des recherches pour son nouveau roman. Je lui ai juste dit de ne pas rentrer trop tard, comme d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Mais il n'est toujours pas rentré... J'ai peur qu'il ne lui soit arrivé quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Mais que puis-je faire, je ne suis qu'une vieille dame... Tu irais le chercher pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150108,
					"content": "On s'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Ah, merci, merci mes enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150110,
					"content": "Vous savez où il s'est rendu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "*soupir* Il ne peut qu'être allé à la Pente Wuwang, au nord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Allez voir si vous pouvez le retrouver. J'espère qu'il ne lui est rien arrivé, ça fait un moment déjà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
