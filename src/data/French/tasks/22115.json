				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "... Et voilà, il est parti. Autant rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150302,
					"content": "Tiens ? C'est quoi ça, par terre ? Chang a perdu quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150303,
					"content": "Hum... Jetons un œil, juste au cas où.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "*soupir* Il faut que je réussisse ce roman... Mais comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150502,
					"content": "C'est vous qui avez perdu ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Hein ? Ah, ahem... En effet, c'est à moi. Mais ce sont des brouillons dont je ne suis pas satisfait. Je les avais balancés dans la rivière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150504,
					"content": "#Et vous êtes {M#allés}{F#allées} les récupérer... Bah, on n'y voit plus grand-chose de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150505,
					"content": "Qu'est-ce qu'il y a écrit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Ah, c'est une histoire que j'écris pour une fille que je connais depuis tout jeune... Ah, vous n'avez pas idée, à l'époque... Elle passait son temps à me demander de lui raconter des histoires. C'est mes brouillons que vous avez ramassés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150507,
					"content": "*soupir* Je lui avais envoyé le début pour la faire patienter, en me disant que j'écrirai la suite au fur et à mesure ; mais j'ai été trop pris dernièrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150508,
					"content": "Et puis un jour elle a disparu, plus de nouvelles, rien, impossible de la retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150509,
					"content": "Je suis sûr que c'est à cause de sa famille. Ils ne veulent pas qu'elle ait quoi que ce soit à faire avec moi... Ils ont dû attendre l'occasion de partir du Village de Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150510,
					"content": "Mais ils verront ! Une fois que je me serai fait un nom, ils ne me regarderont plus du même œil ! Dès que j'ai fini ce roman, je le ferai paraître dans le monde entier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150511,
					"content": "Et ils ne pourront pas faire autrement que d'entendre parler de moi, et devront bien réaliser que le Chang qu'ils ont connu n'est plus le même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150512,
					"content": "Et ensuite... Je pourrai la revoir. Mais pour que tout cela marche, il faut d'abord que j'écrive ce satané roman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221150513,
					"content": "Ah, je m'excuse, à vous embêter avec mes histoires comme ça. Enfin... Je devrais retourner à mon livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
		{
