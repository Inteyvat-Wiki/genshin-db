				]
			},
			"dialogs": [
				{
					"id": 761230101,
					"content": "Oh, ça sent délicieusement bon ! On arrive encore pile à l'heure du repas de Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Tiens. Ces kuuhenkis... font la queue ? Pour la soupe de Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230104,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Waouh, c'est vraiment bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Une soupe aux fruits rafraîchissante et délicieuse. Je n'ai jamais rien goûté de pareil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Vous en voulez encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230108,
					"content": "Deux bols, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Vous apprenez à cuisiner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Oui. J'ai demandé à Ineffa quelques recettes de base, et j'ai fait plusieurs tentatives. Les kuuhenkis et les animaux ont réagi très positivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230112,
					"content": "Avez-vous des soucis en cuisine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Eh bien... Mes manches sont trop larges. Elles touchent la marmite si je ne fais pas attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230114,
					"content": "(Ce n'est pas la cuisine en elle-même qui lui pose problème.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "J'ai quand même du mal avec la pâtisserie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230116,
					"content": "Il faut que la température et les proportions soient parfaitement exactes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230117,
					"content": "(Elle n'a pas dû beaucoup cuisiner pour elle-même par le passé.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(C'est particulièrement difficile de réussir des desserts et des encas quand on les fait seul...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Vous voulez que je vous aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "D'accord. Commençons par les knieperties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230121,
					"content": "Quelque temps plus tard...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Voulez-vous en goûter un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230123,
					"content": "(Prendre une bouchée.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230126,
					"content": "(La première bouchée était tellement acide, mon visage s'est crispé...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Mais après avoir avalé, la douceur refait surface... Peut-être que ça devient meilleur quand on s'y habitue...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230129,
					"content": "C'est passable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Est-ce que j'ai raté quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Goûte pour voir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Beurk, c'est super acide ! M—Mais qu'est-ce que vous essayez de me faire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230136,
					"content": "Ça a un bon arrière-goût, cela dit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "#C'est la première bouchée qui compte ! L'{M#un}{F#une} d'entre vous n'aurait pas pu me prévenir d'en prendre une plus petite ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Si tu n'avais rien dit, j'aurais cru que c'était une blague ! Du genre, regarder les gens faire la grimace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "D'accord. Je vais réessayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230140,
					"content": "Du temps passe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Tenez, goûtez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230142,
					"content": "(Waouh ! C'est carrément mieux !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "C'est délicieux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Vraiment ? J'en veux aussi ! ... Mmmh ! C'est ça ! Trop bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "C'est assez bien pour en faire un cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230147,
					"content": "Complètement ! Attendez, vous avez appris à cuisiner et à faire des knieperties parce que vous vouliez faire un cadeau à quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Oui... Pour mes amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230149,
					"content": "C'est une excellente idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "#Vous vous souvenez de la première fois où vous êtes {M#venus}{F#venues} ici ensemble ? Vous m'aviez préparé à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230151,
					"content": "Bien que la nourriture n'ait pas pu vraiment restaurer l'énergie que j'avais perdue, la manger m'a tout de même permis de me détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230152,
					"content": "Je n'y avais pas trop réfléchi à l'époque, mais je comprends maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230153,
					"content": "C'est le temps et l'effort consacrés à la préparation minutieuse des plats qui leur donnent une âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230154,
					"content": "Je n'ai pas seulement apprécié la nourriture en elle-même, mais aussi la chaleur et la gentillesse des petites mains qui l'ont préparée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230155,
					"content": "Et moins ces mains cherchent la réciprocité, et plus il faut faire preuve de chaleur et de bienveillance pour rendre la pareille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230156,
					"content": "Ohhh, je vais rougir si vous continuez comme ça... Pour être honnête, on espérait au moins un peu gagner votre confiance à ce moment-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "C'est différent maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "En effet. Maintenant que j'ai compris tout ça, j'aimerais en faire un peu plus... C'est une sensation merveilleuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230160,
					"content": "Iriez-vous rendre visite à nos amis avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230161,
					"content": "J'ai préparé quelques autres cadeaux en plus des knieperties. Ah, mais il faut les offrir en secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230162,
					"content": "Pourquoi « en secret », si je peux vous demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Vous m'avez tous toujours fait de « belles surprises ». J'aimerais voir comment mes amis réagiront lorsque les rôles seront inversés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230164,
					"content": "Pfiou, on a vraiment couru partout ! Mais c'est enfin terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Leurs réactions étaient plutôt surprenantes, cependant. Certains n'ont même pas réalisé que c'étaient des cadeaux de votre part, Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino s'est mise directement à grignoter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Ce n'est pas grave. Je m'y attendais. L'essentiel, c'est qu'ils aient été heureux de recevoir les cadeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230168,
					"content": "Dans ce cas, Lauma savait parfaitement que les knieperties et la couronne de fleurs sur son bureau venaient de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Je peux comprendre qu'elle hésite à porter la couronne de fleurs, mais franchement, elle a fixé les knieperties pendant une bonne dizaine de minutes sans oser en manger un seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "Je commençais à craindre qu'elle ne les transforme en reliques sacrées...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "On dirait que Jahoda a eu une belle frayeur quand même... On n'aurait peut-être pas dû glisser les cadeaux juste derrière elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230172,
					"content": "Elle a failli faire une crise cardiaque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Peut-être qu'elle est naturellement plus sur ses gardes ? Cela dit, elle s'est calmée quand Ashru est venu gratter le griffoir que vous lui avez offert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Je compte sur vous pour apporter leurs cadeaux à nos autres amis qui ne sont pas à Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
