					"nextDialogs": [
						761230185
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230185,
					"content": "C'est... un planeur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "On dit que les cieux appartiennent aux oiseaux, et la terre aux bêtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230187,
					"content": "Le vaste espace entre les deux est réservé aux aventuriers équipés de planeurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230188,
					"content": "Que votre chemin soit illuminé par le clair de lune quand vous l'utiliserez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230189,
					"content": "J'aime beaucoup, merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "Merci pour votre compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230182,
					"content": "Ils sont meilleurs que ceux de la Nuit de la prière lunaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Si vous avez envie de manger quelque chose, vous n'avez qu'à me le dire.",
