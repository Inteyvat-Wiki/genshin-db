					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Je suis ravie de l'entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230184,
					"content": "J'ai encore un cadeau. Tenez, c'est pour vous.",
