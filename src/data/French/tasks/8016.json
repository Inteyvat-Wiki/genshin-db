				{
					"id": 80161001,
					"content": "#Ne vous inquiétez pas, vous serez toujours notre {M#héros}{F#héroïne}. Je ne vous tiens pas responsable des actes de votre {M#sœur}{F#frère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80161002
