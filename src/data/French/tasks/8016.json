			"dialogs": [
				{
					"id": 80160301,
					"content": "Mavuika !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160302,
					"content": "#Oh ? Vous tombez à pic. J'allais justement envoyer quelqu'un te chercher, Iansan. {NICKNAME} est là aussi, super.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160303,
					"content": "Comment s'annonce la situation ? Que rapportent les messagers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160304,
					"content": "L'Ordre de l'Abîme a été repéré à proximité de plusieurs tribus au même moment. Il est évident que c'était prémédité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160305,
					"content": "Ils sont venus en nombre aussi. S'ils ne nous avaient pas attaqués de front, on n'aurait jamais su que cette organisation s'était développée à ce point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160306,
					"content": "Ils sont venus avec toutes leurs troupes, non ? Quel est leur but ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160307,
					"content": "J'aimerais bien le savoir aussi. L'Ordre de l'Abîme n'a jamais vraiment été très actif à Natlan, et nous n'avons jamais eu de conflit avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160308,
					"content": "Ce ne serait pas une histoire de vengeance pour notre triomphe récent sur l'Abîme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160309,
					"content": "C'est un peu exagéré, mais ça ne m'étonnerait pas d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160310,
					"content": "Il est trop tôt pour tirer une conclusion. Pour l'instant, restons attentifs à la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160311,
					"content": "Comment se passe la bataille ? Pas trop de pertes, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160312,
					"content": "L'Ordre de l'Abîme a mobilisé toutes ses forces, mais nos braves guerriers viennent de gagner une bataille acharnée contre l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160313,
					"content": "Et ils viennent de toutes les tribus de la nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160314,
					"content": "Par rapport à l'Abîme en lui-même, l'Ordre de l'Abîme représente une menace moindre. Déjà, ils ne peuvent pas régénérer leurs troupes à l'infini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160315,
					"content": "En revanche, ça reste une guerre. Nous devons tout faire pour éviter les pertes et les blessés de notre côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160316,
					"content": "#Les tribus organisent activement leur défense. {NICKNAME}, c'est une affaire qui ne concerne que Natlan, alors vous pouvez rester au Stade avec moi, et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160317,
					"content": "Non, ça me concerne aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "Ah bon ? Comment ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160319,
					"content": "La personne à la tête de l'Ordre de l'Abîme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "Oui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160322,
					"content": "Je vois. Je n'aurais jamais deviné que cela vous concernait à ce point...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160323,
					"content": "Dans ce cas, quel serait son objectif ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160324,
					"content": "Je voudrais bien le savoir aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "Disons qu'ils ne sont pas vraiment en de « bons termes » en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160326,
					"content": "#{NICKNAME} fait de son mieux pour retrouver sa trace et découvrir ce qui lui est arrivé, mais {M#elle}{F#il} l'évite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160327,
					"content": "Je vois, c'est une dispute entre frère et sœur... Ça arrive souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160328,
					"content": "C'est vrai... mais ça reste grave pour tout le monde quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160329,
					"content": "Ça ne m'étonne pas de vous. Ce n'est pas tous les jours qu'une dispute familiale peut changer le destin du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160330,
					"content": "#Si je comprends bien, vous êtes toujours de notre côté et vous n'avez aucune idée de ce que veut votre {M#sœur}{F#frère}. C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160331,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "#Hahaha ! Je suis ravie de l'entendre. Quand vous avez parlé de votre {M#sœur}{F#frère}, j'ai eu peur qu'on se retrouve dans une situation délicate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160334,
					"content": "Nos renseignements disent que l'Ordre de l'Abîme a envoyé le plus gros de ses forces chez les Maîtres du vent nocturne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160335,
					"content": "Si vous ne voulez pas rester ici avec moi, vous feriez mieux d'aller leur donner un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160336,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "Je vous accompagnerai. Le Collectif de l'abondance se débrouille pas mal, alors nous pouvons prêter main-forte aux autres tribus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160338,
					"content": "Merci beaucoup à vous deux. Si vous avez besoin d'aide, faites-le-moi savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160332,
					"content": "J'ai plus de comptes à régler avec l'Ordre de l'Abîme que vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "#... Est {M#ma sœur}{F#mon frère}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
