			"dialogs": [
				{
					"id": 80160401,
					"content": "Pfiou... C'est beaucoup mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160402,
					"content": "C'est du grand-mère Itztli tout craché. Si j'avais su que vous étiez là, peut-être que j'aurais revu le besoin de renforts à la baisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160403,
					"content": "Hmph, c'est l'Ordre de l'Abîme qui aurait dû revoir sa cible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160404,
					"content": "Mon expérience me dit qu'ils doivent avoir une base dans la direction par laquelle ils ont envoyé leurs troupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160405,
					"content": "Et si on en profitait pour la détruire ? Ça les empêcherait de lancer d'autres offensives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160406,
					"content": "Un combat vient d'avoir lieu ? Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Sutura"
				},
				{
					"id": 80160407,
					"content": "Ah, les guerriers des Maîtres du vent nocturne sont arrivés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160408,
					"content": "La guerre contre l'Abîme vient à peine de se terminer, alors nous sommes tous encore très coordonnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160409,
					"content": "Puisque tout le monde est là et que le moral est bon, allons-y ! Prenons leur base !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		},
		{
			"id": 801605,
			"completionStepIds": [
				801605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
