				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brutocollinus"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "Hé, il y a un Brutocollinus là ! Il est en train de... dormir ? Il n'a pas l'air agressif non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "Qu'est-ce qu'il fait caché là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "Ah, tu l'as réveillé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "Hein ? Il s'est enfui ? Notre réputation à Natlan est aussi intimidante que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "Il y a quelque chose par terre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "Tu veux parler de ce truc brillant ? Il a dû tomber pendant sa fuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "Hmm... Peut-être qu'il a cru trouver un trésor et qu'il voulait le cacher ici, mais qu'il ne s'attendait pas à tomber sur nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "Je vais regarder de plus près ! Les Brutocollinus ne sont pas très intelligents, alors ça ne vaudra sans doute pas grand-chose, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#Quoi ? Pourquoi tu fais cette tête tout à coup, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "C'est une clé banale, non ? Bon, son apparence reste assez particulière pour Natlan... D'où pourrait-elle venir, si ce n'est pas d'ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "C'est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "La salle d'hibernation du vaisseau spatial...? Quelle salle ? Quel vaisseau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "#Attends ! Ce vaisseau-là ? Celui avec lequel tu es {M#arrivé}{F#arrivée} en Teyvat{NON_BREAK_SPACE}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "#Comment cette clé aurait pu apparaître ici ? Tu as perdue la tienne, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "Non, je l'ai toujours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "Oh, mais elles sont identiques ! Si ce n'est pas la tienne, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "Il n'en existe que deux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "#Comme je le pensais... Tu es {M#un extraterrestre, après tout... Non, un descendeur}{F#une extraterrestre, après tout... Non, une descendeuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "Dans ce cas, ça voudrait dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "#{M#Ta sœur}{F#Ton frère} a laissé tomber cette clé dans les environs, et ce Brutocollinus l'a ramassée pour la cacher quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "#Du coup, {M#ta sœur est venue}{F#ton frère est venu} ici, il n'y a pas très longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "Ce qui veut aussi dire que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#Oui... Qui aurait cru qu'on ferait une découverte qui pourrait nous mener à {M#ta sœur}{F#ton frère} en patrouillant dans les environs pour Iansan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "Est-ce qu'on continue de chercher des pistes dans le coin ? Ou tu préfères qu'on en parle à Iansan d'abord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "Ah, vous voilà. Vous vous êtes donné la peine de bien faire la patrouille, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160232,
					"content": "Oh, Iansan ! Que faites-vous ici ? Je pensais qu'on se retrouvait à la tribu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "#On allait justement venir vous voir, parce qu'on a fait une grande découverte{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "Et je suis venue vous dire que vous n'avez plus besoin de patrouiller. Le tournoi de fitness a été annulé et une patrouille professionnelle prendra bientôt le relais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160235,
					"content": "Il a été annulé ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "L'Ordre de l'Abîme nous attaque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160237,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "Je ne pensais pas que nos soupçons seraient confirmés aussi vite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#({M#Lumine}{F#Aether} a décidé d'agir à nouveau.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "(Je trouverai un moyen de lui parler en personne cette fois-ci.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "J'ai déjà entendu parler de l'Ordre de l'Abîme, mais c'est la première fois que je les vois être derrière une attaque d'une telle ampleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160242,
					"content": "C'est comme s'ils... préparaient une guerre contre notre nation entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160243,
					"content": "Comment un simple « ordre » pourrait-il vouloir un conflit contre la « nation de la guerre » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "De ce que j'ai remarqué, ils aiment bien agir dans l'ombre. Ils ne sont jamais apparus devant nous jusqu'à aujourd'hui... Que cherchent-ils ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "Aucune idée, on n'a jamais pu le déterminer rien qu'avec les attaques sur notre tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160246,
					"content": "Nos défenses tiennent encore bon, alors je vais me rendre au Stade du sanctifeu pour parler à Mavuika. Après tout, ce sera la mieux informée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160247,
					"content": "#Vous voulez m'accompagner, {NICKNAME}? Je suis certaine que tout le monde sera soulagé d'avoir {M#le héros}{F#l'héroïne} de Natlan à leurs côtés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160248,
					"content": "J'aimerais bien en savoir plus aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "Très bien, alors allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160249,
					"content": "Je peux aussi vous faire part de ce que je sais de l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "L'Ordre de l'Abîme était sans doute là également.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#L'une m'appartient, et l'autre est à {M#ma sœur}{F#mon frère}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "Je la garde tout le temps sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "La clé de la salle d'hibernation du vaisseau spatial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
