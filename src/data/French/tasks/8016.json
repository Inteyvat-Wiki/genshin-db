						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "Regardez, c'est Citlali !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160502,
					"content": "#Vous êtes {M#venus}{F#venues} en renfort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160503,
					"content": "Comment ça se passe ? Mavuika nous a dit de venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160504,
					"content": "Comme vous n'êtes pas restée chez vous, j'imagine que la situation n'est pas géniale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160505,
					"content": "Ce n'est pas si grave, mais ça reste bien embêtant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160506,
					"content": "J'ai entendu dire qu'ils s'acharnaient sur notre tribu en particulier. Pour qui nous prennent-ils ? Une bande de bons à rien ou de chiffes molles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160507,
					"content": "Plus j'y pensais et plus ça m'énervait, alors j'ai arrêté de lire pour venir me battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160508,
					"content": "C'est donc comme ça qu'ils ont provoqué votre colère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160509,
					"content": "L'« Ordre de l'Abîme », hein ? Quel nom de mauvais goût. C'est exactement le genre de nom qu'un auteur raté donnerait à sa faction d'antagonistes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160510,
					"content": "#Elle est en train de dire que {M#ta sœur}{F#ton frère} a mauvais goût.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160511,
					"content": "Je l'ai toujours pensé aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "#Pardon ? Ai-je bien entendu ? {M#Sa sœur}{F#Son frère} fait partie de l'Ordre de l'Abîme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160514,
					"content": "(J'ai dit ça sur le coup de la colère, mais peut-être que j'ai exagéré ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160515,
					"content": "Reparlons-en plus tard. Des ennemis approchent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160516,
					"content": "Pour goûter à ma frustration, je parie ! Voilà que nos ennemis me sortent d'une situation délicate sans que je doive réfléchir à quoi dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160517,
					"content": "Vous auriez pu garder la fin pour vous, Citlali... Bref, mettez-leur une raclée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160512,
					"content": "À sa place, ça fait longtemps que j'aurais changé ce nom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
