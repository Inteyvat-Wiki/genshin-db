						"position": [
							-2649.083,
							279.082,
							10084.27
						],
						"pointId": 351500003
					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "Quelle coïncidence, Tum{RUBY#[D]Espoir}aini et Paimon. Je ne pensais pas vous croiser ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160102,
					"content": "C'est vous, Iansan ! Que faites-vous toute seule ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160103,
					"content": "Que ce soit clair, je ne suis pas venue exprès pour vous voir ! Les cours de musculation et les régimes ne m'intéressent toujours pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160104,
					"content": "Hahaha... D'accord, mais je ne suis pas une entraîneuse qui force les gens. J'ai toujours respecté l'avis de mes élèves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160105,
					"content": "En revanche, quelques exercices d'aérobic devraient vous faire du bien. Par exemple, vous pourriez patrouiller cette zone à ma place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160106,
					"content": "Plutôt que des exercices...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "Je plaisantais. Mais vous avez raison, je cherche des gens pour me donner un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160109,
					"content": "Prochainement, le Collectif de l'abondance organisera un tournoi de fitness. Mais il y a tellement de participants qu'il ne reste plus personne dans les effectifs des patrouilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160110,
					"content": "Du coup, vous patrouillez à leur place ? Vous n'avez pas besoin de vous préparer pour ce tournoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160111,
					"content": "Ça m'est égal. J'estime que ça ne sert à rien de s'entraîner à la dernière minute. Ce n'est qu'en s'entraînant régulièrement qu'on atteint une forme physique optimale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160112,
					"content": "De plus, comme vous pouvez le voir, je ne peux pas participer à un tournoi en raison de mon physique. Il n'y aurait personne dans ma catégorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160113,
					"content": "C'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160114,
					"content": "Pourquoi vous me regardez ?! Je ne fais pas du tout partie de la même catégorie que vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160115,
					"content": "#{NICKNAME}, aidons-la à patrouiller. J'ai peur qu'Iansan ne m'attrape pour m'inscrire de force au tournoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160116,
					"content": "Hahaha... Génial, il a suffi d'un regard pour que vous acceptiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160117,
					"content": "D'accord. Je vais le faire pour toi, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "Merci à vous deux. Ce ne sera pas trop difficile, assurez-vous juste que rien d'anormal ne se passe dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160120,
					"content": "Je vais patrouiller de l'autre côté. Retrouvons-nous à la tribu plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160121,
					"content": "#Pas de problème ! Comptez sur nous. On est des {M#experts}{F#expertes} en patrouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160118,
					"content": "D'accord, on va vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "... Il s'agit plutôt de vous aider, là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
			"id": 801602,
			"completionStepIds": [
				801602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
