			"dialogs": [
				{
					"id": 80160701,
					"content": "La base a été détruite. Beau travail, tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160702
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160702,
					"content": "Héhé ! Ils étaient bien nuls !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160703,
					"content": "C'était plutôt décevant. J'espérais qu'ils me présentent personnellement des excuses avant de reconnaître la puissance des Maîtres du vent nocturne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160704
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160704,
					"content": "Tant pis, je compenserai avec du bon vin lors du banquet de la victoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160705
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160705,
					"content": "Maintenant que la base a été détruite, cette zone devrait être sans danger pendant un moment, mais restons quand même sur nos gardes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160706
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160706,
					"content": "Vous l'avez aussi remarqué ? En général, il y a beaucoup plus de résistance quand on s'approche d'un emplacement crucial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160707
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160707,
					"content": "À l'exception de ceux qui se sont battus contre nous jusqu'au bout, la plupart des ennemis ont juste abandonné avant de battre en retraite. Comme s'ils avaient senti quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160708
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160708,
					"content": "Oh ? Qu'y a-t-il de mal à ça ? Les retraites stratégiques sont assez fréquentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160709,
					"content": "Quelque chose cloche. On parle d'une faction qui a décidé de déclarer la guerre à une nation entière, là. Ce n'est pas le genre d'ennemis à abandonner une base aux premiers signes d'une confrontation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160710
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160710,
					"content": "Tu penses qu'ils maniganceraient autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160711
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160711,
					"content": "On n'a toujours aucune information qui pourrait nous aider, alors contentons-nous de rester sur nos gardes pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160712
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160712,
					"content": "(On ne connaît toujours pas leur objectif. Il nous faut des pistes...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160713
					]
				},
				{
					"id": 80160713,
					"content": "#(Je pourrais rapidement résoudre la situation... si j'arrive à obtenir une audience avec {M#Lumine}{F#Aether}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160714,
						80160715
					]
				},
				{
					"id": 80160714,
					"content": "Je vais retourner au Collectif de l'abondance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				},
				{
					"id": 80160716,
					"content": "Ah, tu penses encore à cette clé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160717,
					"content": "#C'est vrai. Si elle peut nous permettre de retrouver {M#ta sœur}{F#ton frère}, tu pourras lui parler et peut-être même mettre un terme à ce conflit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160718,
					"content": "Vous partez déjà ? Je pensais vous inviter à notre banquet de victoire, en plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160719
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160719,
					"content": "Allez-y. Rien ne se passera avec nous deux ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160715,
					"content": "La clé est notre seul indice pour le moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				}
			]
		},
