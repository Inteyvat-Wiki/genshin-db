			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tommy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "#Ouf... Ça va beaucoup mieux maintenant. Merci, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "Ma foi, tout ça pour une mission ! ... Et une pas facile, en plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Je ne voulais pas rester à rien faire alors j'ai cherché à me rendre utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "Harris, le chef cuisinier du campement, m'a dit qu'il avait besoin d'aide pour trouver de la viande congelée dans la région.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Des sangliers congelés, pas la peine de monter trop haut dans la montagne d'après lui, comme quoi c'était sans danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Je pensais que c'était facile, alors j'ai accepté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Je veux m'entraîner pour me familiariser avec le coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "Et puis comme ça, je pourrai enfin finir la mission que m'a confiée cette alchimiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "#Mais je me suis perdu après quelques minutes passées dans la montagne, et j'ai presque fini en glaçon... Heureusement que vous êtes {M#arrivé}{F#arrivée}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Mon seul regret, c'est... de n'avoir pas pu terminer ma mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "#{M#Voyageur}{F#Voyageuse}... Vous semblez bien connaître ces montagnes. Pourrais-je vous demander une autre faveur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Si vous pouviez m'aider à trouver une portion de viande congelée... Juste une seule fera l'affaire... Je pourrai terminer cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Merci ! Dans ce cas, laissez-moi vous montrer sur la carte où Harris pense pouvoir trouver des sangliers gelés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Bon, je vais redescendre au campement au pied de la montagne et j'attendrai de vos nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
