						205200202
					]
				},
				{
					"id": 205200202,
					"content": "Ç—Ça va aussi. Mais, pitié... D—Dépêchez-vous... Je ne sens presque plus m—mes doigts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
