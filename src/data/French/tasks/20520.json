					"Tommy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200101,
					"content": "#V—{M#Voyageur}{F#Voyageuse}... V—V—Vous pouvez m—m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200102,
					"content": "Qu'est-ce qui vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "S—S'il vous plaît, aidez-moi d'abord à me réchauffer... J—J'ai trop froid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "O—O—Ou vous pouvez m'aider à trouver quelque chose de chaud à manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "J—Je vous en prie. J'ai vraiment t—trop froid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
