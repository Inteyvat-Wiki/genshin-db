			},
			"dialogs": [
				{
					"id": 790750101,
					"content": "À quoi pense Chauvigne ? *soupir* Il ne veut même pas me parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "À propos de Chauvigne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "#Bonjour les {M#amis}{F#amies}. Je suis désolé, mais Chauvigne est toujours en colère contre moi. Il refuse de sortir et ne veut pas me parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "*soupir* Mais il n'y a pas de vent ni de soleil où il est. Et s'il se flétrissait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Eh bien, si c'est juste une fleur dans un pot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Nous pourrons simplement la dépoter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "J'ai déjà essayé, mais il boude tellement que je ne peux pas m'en approcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "Il soufflait tellement fort de colère que j'ai failli être emporté par le vent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Attendez, comment quelqu'un en colère peut-il souffler aussi fort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Il doit vraiment être très en colère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "C'est peut-être parce que j'ai dit que je ne voulais pas voyager avec lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "#Je vous en prie, {M#chers invités}{F#chères invitées}, puis-je vous demander d'aller voir Chauvigne ? Vous pourriez peut-être même réussir à le raisonner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "D'accord, nous allons essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "#Nous avons voyagé dans tellement d'endroits et rencontré tellement de personnes différentes que nous sommes {M#sûrs}{F#sûres}... Euh, que nous pensons pouvoir le convaincre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "C'est merveilleux ! Vous le trouverez dans la caverne sous cette île. C'est par là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Je... dois ranger ici et trouver un bon endroit pour que Chauvigne puisse prendre un bain de soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "Ça va être difficile de s'en approcher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
