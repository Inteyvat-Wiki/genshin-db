			"dialogs": [
				{
					"id": 790750201,
					"content": "Je... dois ranger ici et trouver un bon endroit pour que Chauvigne puisse prendre un bain de soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "Je compte sur vous pour convaincre Chauvigne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "S'il me voit, il va me trouver trop collant et se mettre encore plus en colère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
