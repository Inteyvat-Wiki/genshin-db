			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne ! T—Tu es venu. Écoute-moi, s'il te plaît. Je n'ai jamais été en colère contre toi et je n'ai jamais voulu qu'on se sépare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "J'avais simplement peur que tu ne veuilles plus être mon ami... Je sais que certains aventureux changent, et j'avais peur que tu changes aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "J'ai prié la déesse, mais... Je n'ai pas trouvé de cadeau assez beau à lui offrir, et elle n'a donc pas exaucé mon souhait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "Ça n'arrivera jamais, Panuelle. Je serai ton ami pour la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Je te dois des excuses ! J'étais tellement concentré sur mes propres pensées que je ne t'ai même pas écouté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "Je pensais... que tu ne voudrais plus jamais me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Heureusement, nous avons dissipé ce malentendu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Oui ! Je pensais qu'il y avait un vrai problème entre vous, et que vous étiez tellement fâchés l'un contre l'autre que vous ne vouliez même pas essayer de vous comprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Ce n'était pas un petit problème...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "Merci beaucoup à vous deux. Sans vous, je n'aurais jamais pu sortir de là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Mais grâce à vous, je peux enfin lui dire ce que j'ai sur le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Je suis toujours prêt à écouter ce que tu as à dire, Chauvigne. Que tu veuilles parler d'aventures ou de pots de fleurs... Tout me va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "Ah oui, veuillez accepter ceci en guise de remerciement. J'ai préparé ce cadeau spécialement pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Que la déesse vous bénisse, puissiez-vous ne jamais vous disputer avec vos amis. Je vous souhaite d'avoir toujours à vos côtés quelqu'un de prêt à écouter vos pensées les plus personnelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "#Mais je suis {M#content}{F#contente} que tout soit réglé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				}
			]
		}
