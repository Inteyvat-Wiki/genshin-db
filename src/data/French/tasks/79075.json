				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Ouf... Le vent s'est enfin calmé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Écoutez-nous, s'il vous plaît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "D'accord, j'écouterai ce que vous avez à dire. Mais d'abord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "#Regardez vos têtes à {M#tous}{F#toutes} les deux ! Je suis sûr que vous vous demandez comment une fleur peut parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "Ou alors, comment je suis devenu une fleur en pot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "On vous a déjà beaucoup posé la question ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "À l'extérieur, oui. Mais depuis mon retour à la maison... Non, personne ne m'a posé de questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "Quand vous dites « à l'extérieur », vous voulez dire en dehors de ce monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Il paraît que vous êtes devenu comme ça après un long voyage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "Eh bien, on dirait que vous savez déjà tout ! Je suppose que c'est Panuelle qui vous a tout raconté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "C'est exact. Je suis devenu comme ça au cours d'un de mes voyages. Héhé, pour emprunter une phrase à ce Rozel... C'est le « changement » que j'ai choisi de faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Je comprends l'envie de changement... Mais pourquoi une fleur en pot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "C'est parce que vous adorez les plantes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "Non, je voulais juste... trouver ma place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "J'ai rencontré beaucoup de gens en dehors de ce monde. Il y avait des chefs cuisiniers, des fleuristes, des enseignants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Ils avaient pratiquement tous trouvé leur place, leur zone de confort. C'est comme ça qu'ils ont pu s'établir dans la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "Et moi ? Je passais mon temps à partir à l'aventure. Je n'avais jamais pensé à trouver un endroit où me poser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "#Alors, ce pot de fleurs est votre «{NON_BREAK_SPACE}place ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "C'est exact, vous comprenez vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "En étant une fleur en pot, j'aurai toujours un endroit où me sentir à l'aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Mais... *soupir* Puisque j'ai déjà un pot et un petit endroit qui m'appartient, pourquoi ai-je encore envie de partir à l'aventure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "C'est dans ma nature après tout, je suis un aventureux. Qu'y a-t-il d'intéressant à faire à part partir à l'aventure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Je ne comprends pas. Plus je parcours le monde extérieur, moins je comprends... Qu'est-ce qui compte le plus, avoir un chez-soi ou partir à l'aventure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Plus j'y pense, plus j'ai mal à la tête... Et quand je discute avec Panuelle, j'esquive toujours ses questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "J'ai peur de l'induire en erreur. S'il aimait l'aventure, est-ce qu'il commencerait à détester ça après m'avoir vu de la sorte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "C'est mon ami et il le sera toujours. Je me dois d'être honnête avec lui, j'ai répondu à toutes ses questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Y compris... le fait que je sois devenu une fleur pour pouvoir avoir un endroit où je me sens à l'aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Peut-être que ma réponse l'a bouleversé... Ou alors, c'est parce qu'il n'aime pas ce que je suis devenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Une distance se crée entre nous, mais je ne suis qu'une fleur en pot, je ne sais pas remonter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "C'est peut-être mieux ainsi, je suis sûr que Panuelle ne veut pas me voir de toute façon. Il doit être en colère contre moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Oh... C'est donc ça ! Ils pensent tous les deux que c'est l'autre qui est en colère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "Et du coup, ils refusent de se voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "Quoi ? V—Vous voulez dire que Panuelle n'est pas en colère contre moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "Vous pensez tous les deux exactement la même chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Vous dites à Chauvigne tout ce que pense Panuelle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Par les cieux, comment pourrais-je penser une telle chose ? Je n'ai jamais voulu le rendre triste. Rien que le fait de voir qu'il ne sourit plus me brise le cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "#{M#Chers invités}{F#Chères invitées} ! Il faut que vous me fassiez remonter, je vous en supplie ! Il faut que je le voie au plus vite ! Je ne peux pas attendre une minute de plus, non, pas même une seconde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750341,
					"content": "J'attendais que vous disiez ça, mon cher ami en pot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Héhé, moi aussi ! C'est parti, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750337,
					"content": "Il pense que c'est vous qui êtes en colère contre lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "Vous rêvez de devenir botaniste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "Panuelle a quelque chose à vous dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
