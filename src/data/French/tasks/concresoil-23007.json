			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "Est-ce que je ne pourrais pas utiliser un meilleur matériau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "De quel matériau parlez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Désolé, je me parlais à moi-même. Le temps est devenu tellement imprévisible, j'ai beaucoup de problèmes de construction, je suis un peu débordé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "N'êtes-vous pas potier ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Si, mais je suis aussi un maçon. Dans les deux cas, je travaille avec de la terre donc ce n'est pas très différent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "Est-ce que vous avez déjà entendu cette expression ? « Apprendre, c'est comme construire une maison. Pour pouvoir s'élever haut, il faut de bonnes fondations. ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "« Pour améliorer ses connaissances, c'est la même chose. Des fondations instables ne peuvent que s'effondrer... ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "C'est ce que n'arrêtent pas de dire les hauts dignitaires. Je ne comprends pas tout, mais j'imagine qu'ils considèrent que construire des maisons est aussi important que d'apprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "C'est juste une métaphore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Quoi qu'il en soit, quand il est question de fondations de maison, on pense immédiatement aux matériaux de construction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "La terre est le matériau de liaison et de soutien. Si l'on pouvait renforcer sa stabilité et son adaptabilité, les maisons seraient plus solides, et je n'aurais pas autant de travail à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "Je ne pense pas que ce soit comme ça qu'il faille l'interpréter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
