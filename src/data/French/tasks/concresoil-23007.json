			"dialogs": [
				{
					"id": 230070201,
					"content": "J'ai quelques idées sur le sujet. Aujourd'hui... je prévoyais de trouver de la terre gorgée de bave de Blob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "#J'ai trouvé un endroit où se rassemblent les Blobs. {M#Voyageur}{F#Voyageuse}, pouvez-vous y aller pour m'aider à récupérer de la terre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Je vous laisse vous en occuper. Ça n'a pas d'importance si vous éliminez les Blobs, il faut juste que vous rameniez un peu de terre près de l'endroit où ils se rassemblent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070205,
					"content": "Je vais vous marquer l'emplacement sur la carte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070206,
					"content": "Vous ne venez pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "J'aimerais y aller moi-même, mais j'ai encore des travaux de maçonnerie à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070208,
					"content": "Rassurez-vous, je vous préparerai une belle récompense, alors je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070209,
					"content": "Je vais vous marquer l'endroit sur la carte, allez voir là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
