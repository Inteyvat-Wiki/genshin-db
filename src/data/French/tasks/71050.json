			"dialogs": [
				{
					"id": 710500401,
					"content": "Parlez-moi de ce champignon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "#Pas étonnant qu'on dise que vous êtes {M#un aventurier chevronné}{F#une aventurière chevronnée}. Il ne vous a pas fallu longtemps avant de faire de nouvelles découvertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500403,
					"content": "#Tiens ? Vous êtes {M#sûr}{F#sûre} de l'avoir ramassé ici ? C'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500404,
					"content": "C'est étrange qu'un champignon puisse pousser sous terre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Ce n'est pas ce que je veux dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500406,
					"content": "C'est juste qu'il ressemble beaucoup à un champignon que l'on trouve à Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500407,
					"content": "Impossible d'en être sûr avec seulement ce type de spécimen. Avec assez d'échantillons, je pourrai peut-être parvenir à une conclusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500408,
					"content": "En parlant d'échantillons... Puisque c'est vous qui avez rapporté ces champignons, vous devez sûrement savoir où vous en procurer d'autres... Pourriez-vous aller m'en chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500409,
					"content": "Apportez-moi suffisamment de champignons et je vous paierai généreusement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500410,
					"content": "#Combien de champignons voulez-vous{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Hmm... Je réfléchis... Commencez par m'en apporter huit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500412,
					"content": "Ne vous faites pas de souci. Si vous me les rapportez, je vous paierai sans lésiner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105007,
