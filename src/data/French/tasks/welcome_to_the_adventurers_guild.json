				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "Bienvenue à la <color=#00E1FFFF>Guilde des aventuriers</color> ! Ça fait un moment que je garde un œil sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300102,
					"content": "#Comment ça ? Est-ce que {NICKNAME} a fait quelque chose de mal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300103,
					"content": "Pas du tout ! C'est mon boulot de repérer les aventuriers prometteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300104,
					"content": "#Je peux voir que tu as tout ce qu'il faut pour être {M#un aventurier}{F#une aventurière} légendaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300105,
					"content": "Héhé, moi aussi, je le vois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300106,
					"content": "#Je me suis toujours sentie en sécurité avec {NICKNAME} depuis qu'on a commencé à voyager ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300107,
					"content": "Je n'en doute pas ! Mais l'expérience est encore plus utile que le potentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300108,
					"content": "Ce n'est qu'en faisant le plein d'<color=#00E1FFFF>expérience</color> que le <color=#00E1FFFF>Niv. d'aventure</color> augmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300109,
					"content": "Il n'est jamais trop tard pour se lancer. Laissez-moi vous présenter notre Guilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300110,
					"content": "#Attendez ! Vous voulez dire qu'on est des {M#vrais aventuriers}{F#vraies aventurières} à partir de maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300111,
					"content": "L'adhésion à la Guilde est gratuite et nous n'imposons pas de responsabilités à nos membres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300112,
					"content": "En gros, il n'y a que des avantages à nous rejoindre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300113,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "C'est simple : la Guilde te récompense dès que ton Niv. d'aventure augmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300117,
					"content": "Prends ce cadeau de bienvenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300118,
					"content": "Récompenses de Niv. d'aventure",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "Je veux les avantages tout de suite !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Haha, les nouvelles recrues n'ont pas la langue dans leur poche de nos jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Catherine"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
