			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "Nous te souhaitons à présent la bienvenue à la Guilde des aventuriers !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300202,
					"content": "Je te prie d'accepter ton <color=#00E1FFFF>Guide de l'aventurier</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300203,
					"content": "On a aussi droit à un guide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "C'est pas tous les jours qu'on a des nouveaux membres ! On se doit de fêter ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300207,
					"content": "Tu pourras retrouver les quêtes que tu auras accomplies pour nous et les récompenses obtenues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300208,
					"content": "Bien évidemment, c'est aussi une preuve d'appartenance à la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300209,
					"content": "Ah, une dernière chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300210,
					"content": "#Il t'arrivera certainement d'être {M#coincé}{F#coincée} à un certain Niv. d'aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300211,
					"content": "Quand ça sera le cas, il faudra accomplir des prouesses pour se forger une réputation auprès de la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300212,
					"content": "Des prouesses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Ça veut juste dire qu'il faut accomplir des quêtes spéciales pour passer au niveau supérieur. On les appelle les « quêtes d'élévation ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300214,
					"content": "Enfin, ça viendra plus tard au fur et mesure que tu gagneras de l'expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300215,
					"content": "C'est tout pour aujourd'hui. On aura tout le temps de discuter une autre fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300216,
					"content": "Vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200300205,
					"content": "C'est une brochure ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "En quelque sorte, mais ça te sera aussi utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Catherine"
				}
			]
		}
	]
