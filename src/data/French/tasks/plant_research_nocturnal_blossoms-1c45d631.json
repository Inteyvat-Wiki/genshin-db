				]
			},
			"dialogs": [
				{
					"id": 762010201,
					"content": "C'est pas sympa, Metta ! Je voulais juste que tu t'amuses pendant ton aventure... Pourquoi tu dis des choses comme ça, hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Si tu n'arrêtes pas d'agir sur des coups de tête, les autres finiront eux aussi par perdre patience avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Je n'ai pas agi sur un coup de tête ! Moi aussi, j'ai mes propres projets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Ouah, des projets ? Vraiment, hm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Pff... Encore une fois, tu refuses de m'écouter. Je ne te parlerai plus jamais ! Même si tu le regrettes plus tard, ce sera trop tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "... Ah, Linnea ! Metta était en train de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Alors que Vesa raconte tant bien que mal ce qui s'est passé, il devient évident qu'il s'agissait simplement d'une petite dispute ordinaire entre enfants...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Pense ce que tu veux, mais ce n'est pas de ma faute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Alors... Ce n'est pas de la mienne non plus ! Linnea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Hmm... Parfois, ce genre de choses arrive, tout simplement. Personne n'est vraiment responsable, mais tout ne se passe pas comme on le voudrait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Oh, c'est comme l'histoire des deux sœurs des Descendants de givrelune qui sont représentées par la fleur nocturne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Hein ? L'histoire des deux sœurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Oui. J'ai entendu dire qu'il y avait autrefois deux sœurs chez les Descendants de givrelune. Elles avaient des personnalités très différentes, comme la fleur nocturne. L'une rouge, l'autre bleue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "Les deux sœurs firent ce qu'elles estimaient être juste, mais cela les conduisit à suivre des chemins différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "On raconte que la cadette ne pardonna jamais à son aînée de l'avoir abandonnée, même si celle-ci avait sauvé d'innombrables vies... Finalement, les deux sœurs ne se revirent jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Oh... Je ne savais pas que les Descendants de givrelune avaient des histoires comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Moi non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Hmm... Je l'ai entendue d'un barde itinérant. Il a peut-être un peu enjolivé le récit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Ah, donc c'est une invention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Eh bien, même si cette histoire n'est pas totalement vraie, la leçon qu'elle nous enseigne reste la même, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "Aucune des deux n'estimait avoir tort. Toutes deux étaient convaincues que leur choix était le bon, mais leurs décisions respectives les ont amenées à ne plus jamais se revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Prouver qu'on a raison, mais perdre un ami... Que choisiriez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Ah... Finalement, ce n'est pas si mal de faire quelques petits détours spontanés lors d'une aventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "... Oui ! Maintenant que j'y pense, le temps que Metta passe à m'accompagner dans mes aventures est très précieux. Si je continue à changer d'avis, nous risquons de ne plus pouvoir en profiter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "Je... Je préparerai un meilleur plan la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Héhé, je suis contente de voir que vous vous entendez à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "La prochaine fois que Vesa et moi partirons à l'aventure, on ramènera toutes les pierres inhabituelles qu'on trouvera au Speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Ça me va ! Merci d'avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
