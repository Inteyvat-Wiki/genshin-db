			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "*tousse* Ah... Attendez, arrêtez ! Qui êtes-vous ? Pourquoi êtes-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "Et... pourquoi m'attaquez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "C'est nous qui devrions vous poser cette question ! Qu'est-ce que c'est que ce comportement suspect que vous aviez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "C'est vous la méchante, à vous de vous expliquer en premier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "... Katarina. Je m'appelle Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "Mon nom est l'information la moins sensible que je puisse vous révéler. Je ne peux donc vous dire que ça. Désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Euh... On voulait juste vous demander ce qu'il se passe, ce n'est pas un interrogatoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "Toutes mes excuses, mais c'est tout ce que je peux vous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "Que font les Fatui ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "C'est confidentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "Quoi ?! Il n'y a que des malfaiteurs pour faire des cachotteries comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Oui, vous avez raison. On est des malfaiteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "#Bon, je crois que c'est terminé les questions pour l'instant, les {M#petits curieux}{F#petites curieuses}... On a un problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Merci... Quoi qu'il en soit, je suis très contente que vous ne m'ayez pas poignardée dans le dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Ce serait plutôt à moi de dire ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Tss... Je ne sais pas quels sont les préjugés que vous avez sur les Fatui, en tout cas, vous auriez pu choisir un endroit plus romantique pour m'accoster... Si vous avez quelque chose à me dire, venez à ma cachette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina s'en va.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "Euh ? C'est une Fatui, on peut vraiment la laisser partir comme ça sans la remettre aux Millelithes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Hmph... Je vois, oublie ça. Elle ne nous a pas fait de mal, alors on peut lui épargner la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Est-ce que les Fatui sont tous aussi méfiants envers les autres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "#Vous êtes {M#venus}{F#venues}, comme prévu. Installez-vous, je vous prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Laissez-moi voir ce qu'il reste... J'ai fini le thé noir... Plus de sucre non plus... Le lait... Beurk, il a tourné, je le jetterai tout à l'heure. Je suis vraiment désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Par contre, je ne manque pas d'eau de feu. Il y a aussi des biscuits durs et de la confiture acide... C'est suffisant pour un goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Ouah ! Vous servez de l'eau de feu pour le goûter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Oui, vous trouvez ça bizarre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Euh... Je passe mon tour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "Qu'est-ce qu'il y a ? Il n'y a personne ici pour vous juger parce que vous buvez. Détendez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "Qu'est-ce que vous êtes en train de faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "« En partageant de la nourriture et des informations de manière appropriée, il vous sera possible de faire taire les curieux. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "C'est ce qu'il y a écrit dans notre manuel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Très bien, où sont vos informations alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Hmm ? Je viens de vous les donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Hein ? Qu'est-ce que vous venez de dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "« Manuel des équipes avancées des Fatui - annexe 4-4, paragraphe 32 : En partageant de la nourriture et des informations de manière appropriée, il vous sera possible de faire taire les curieux. » Voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "#Pour vous remercier de m'avoir sauvé la vie, je suis allée jusqu'à vous révéler le contenu de notre manuel de formation secret, vous voyez à quel point je suis sincère{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "En quoi ça nous est utile ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Héhé, j'arrête de plaisanter avec vous... Pour être honnête, je vous suis très reconnaissante de votre aide, mais ne surinterprétez pas ces bons sentiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "Euh... Compte tenu des méfaits que vous autres avez commis, je ne suis pas sûre de croire aux « bons sentiments » des Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "Qu'est-ce que vous tramez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "#Je ne suis pas surprise de voir que la philosophie des Fatui puisse échapper à des {M#étrangers}{F#étrangères}. Mais à part ça, on est des gens comme les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "Et puis, peu importe nos objectifs, nous ne faisons que nous préparer pour la bataille finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "La bataille finale ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Oui. À la fin, nous serons tous confrontés à un ennemi commun et à une longue nuit à laquelle nous ne pourrons échapper... Tous les citoyens de Snezhnaya ont reçu cet avertissement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Ainsi, toutes les larmes et le sang que l'humanité verse pour ce monde cruel... ont une raison d'être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Santé ! Pff... Bon, d'accord, je vais boire toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "Vous ne seriez pas en train de chercher à justifier ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Peut-être que vous avez raison... Enfin bon, je m'en fiche. Vous vouliez une explication, et je vous en ai donné une... C'est mon point de vue et cela peut ne pas vous satisfaire. C'est aussi simple que ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Euh... Pourquoi vous vous mettez à parler sérieusement tout à coup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580535,
					"content": "Au passage, je me suis déjà présentée, mais je ne connais pas encore vos noms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "Je suis Paimon ! Vous avez déjà entendu mon nom, c'est sûr et certain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580539,
					"content": "Ah ! Vos noms...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580540,
					"content": "Héhé, alors ? Ils sont connus aux quatre coins de Teyvat, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580541,
					"content": "Désolée, je ne les ai jamais entendus, ni l'un ni l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580542,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580543,
					"content": "Ne le prenez pas mal, ça fait longtemps qu'on m'a envoyée ici. Hormis les informations qui nous parviennent des lignes d'approvisionnement, on ne sait rien de ce qui se passe à la surface...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580544,
					"content": "Ah ! Ça veut dire que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580545,
					"content": "Vos lignes d'approvisionnement ont été coupées il y a longtemps ?",
