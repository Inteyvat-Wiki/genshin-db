			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "À propos de la mission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "#Vous êtes {M#venu}{F#venue} à cause de mon annonce ? Eh bien, j'ai besoin de votre aide pour quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "Plus précisément, j'aimerais que vous preniez des clichés de deux endroits à Dosdragon. Je vais indiquer les emplacements exacts sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "Et pour votre paiement, je vous assure une compensation suivant les règles de la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "Alors ? Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "Pourquoi avez-vous besoin de clichés de ces deux endroits ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Eh bien... C'est en rapport avec Cyrus, pour tout vous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "Il m'a demandé de lui procurer certaines des spécialités de Dosdragon. Il a dit qu'il voulait les utiliser dans le cadre d'une campagne de recrutement pendant la Fête des alizées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "La fête a commencé, mais il ne m'a pas contactée. Il doit être occupé, je suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Oh... Mais c'est vrai ça, à son âge, il doit être occupé à célébrer la fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "Il devrait avoir passé l'âge...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Vraiment ? Je n'en ai pas vraiment l'impression. Je pense plutôt que... Hmm, tant pis. Pas la peine de s'étendre là-dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "J'ai déjà collecté des minerais et assemblé des cartes topographiques et des informations sur les monstres. Maintenant, j'aimerais bien ajouter des photos des lieux emblématiques de Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pouvez m'aider et aller aux Monts Dosdragon trouver deux endroits à prendre en photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "Comptez sur moi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Parfait, je vous laisse faire, alors. J'ai indiqué les deux endroits sur votre carte. Vous pouvez revenir me voir une fois que vous avez terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "Vous ne rentrez pas en ville pour profiter de l'ambiance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "C'est un peu trop animé pour moi. Je préfère rester ici, j'y suis mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "Et puis, j'ai encore pas mal de choses à faire, donc je ne compte pas rentrer pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "J'ai indiqué les meilleurs endroits sur votre carte. Vous pouvez revenir me voir une fois que vous avez terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
