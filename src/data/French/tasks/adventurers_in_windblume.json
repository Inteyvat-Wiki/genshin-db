				"points": []
			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "Alors ? Vous êtes-vous fait une idée de l'intérêt qu'ont les gens pour la Guilde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100602,
					"content": "En effet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Alors vous comprenez ce que je voulais dire... C'est toujours comme ça en plus. Je m'y suis habitué depuis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100604,
					"content": "*soupir* Quelle que soit la méthode, tout ce qui importe, c'est qu'elle produise des résultats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100605,
					"content": "Je suppose que vous allez retourner à Dosdragon pour faire votre rapport à Iris, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100606,
					"content": "Pouvez-vous au passage lui remettre cette lettre ? Elle sera certainement intéressée par ce qui se passe dernièrement à la Guilde. Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100607,
					"content": "*soupir* J'espère qu'on pourra trouver de nouvelles recrues cette fois-ci... Mais est-ce qu'on peut vraiment faire confiance à ceux que ce genre de méthode attire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
