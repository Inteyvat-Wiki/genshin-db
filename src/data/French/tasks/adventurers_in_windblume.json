				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"José aux six doigts"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#Mon {M#ami}{F#amie}, bien le bonjour ! Souhaitez-vous vous régaler de ma dernière composition ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100402,
					"content": "À propos du recrutement de la Guilde des aventuriers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "La Guilde des aventuriers recrute ? Désolé, je ne suis pas intéressé par de telles choses. Crapahuter partout n'est d'aucune utilité pour un barde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100404,
					"content": "Et puis, à Mondstadt, les chevaliers de Favonius font une inspiration bien mieux adaptée à une épopée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100405,
					"content": "Je n'ai pas l'intention de rentrer dans la Guilde des aventuriers. Sauver des chats perdus... Ce n'est pas matière à chansons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100406,
					"content": "Voici quelques informations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "Est-ce que c'est... Dosdragon ? Quelle vue magnifique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100408,
					"content": "Peut-être que contempler un tel endroit me donnerait de nouvelles inspirations. Et ça n'a pas l'air dangereux en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100409,
					"content": "Hmm... Je passerai à la Guilde plus tard pour me renseigner. Même si je ne m'inscris pas, je pourrais toujours engager un aventurier pour m'accompagner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "José aux six doigts"
				},
				{
					"id": 700100410,
					"content": "Une visite de Dosdragon... J'ai hâte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "José aux six doigts"
				}
			]
		},
		{
