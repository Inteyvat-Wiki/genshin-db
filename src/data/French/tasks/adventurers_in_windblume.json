					"nextDialogs": [
						700100702
					]
				},
				{
					"id": 700100702,
					"content": "Vous revoilà ! Qu'est-ce qui vous a pris autant de temps ? C'est Cyrus qui vous a encore demandé de l'aide, je parie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100703,
					"content": "Je l'ai aidé à se renseigner à droite et à gauche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "Mais qu'est-ce qu'il mijote encore... Oh ? Une lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100705,
					"content": "Cette lettre parle de la situation actuelle de la Guilde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Eh bien, c'est bien long tout ça... On dirait qu'il a été bien occupé après tout, même si c'est la Fête des alizées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100707,
					"content": "Quand même, il travaille si dur... Il est grand temps que la Guilde des aventuriers de Mondstadt recrute de nouveaux membres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100708,
					"content": "Quand on aura assez de membres, il pourra déléguer les affaires les moins importantes et repartir à l'aventure avec moi... Ah, ce serait quand même bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100709,
					"content": "#Bon, je vais lire attentivement tout ça. Et puis, vu que Cyrus vous a {M#retenu}{F#retenue} avec ses affaires, je m'en voudrais de ne pas vous ajouter une prime supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100710,
					"content": "Et voilà, et merci pour tous vos efforts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
