				"objectNames": [
					"Hélène"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "Oh ! Qu'y a-t-il ? J'étais sur le point de composer un morceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100502,
					"content": "À propos du recrutement de la Guilde des aventuriers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Oh, ça... J'avais vu l'annonce, mais ça ne m'intéresse pas. Et puis, je peux protéger Mondstadt avec mes chansons, je n'ai pas besoin de rejoindre la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100504,
					"content": "Sans compter que j'ai entendu dire que la plupart des missions de la Guilde ne sont que des corvées. Je ne vois pas en quoi ça m'aiderait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100505,
					"content": "Désolée, je me dois de refuser, mais merci quand même d'avoir pensé à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100506,
					"content": "Voici quelques informations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "Hein ? On dirait Dosdragon, non ? Une Statue des Sept entourée de neige... Quel spectacle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100508,
					"content": "Mais ça doit être sacrément haut, non ? Les gens disent qu'on peut voir à des lieues à la ronde... Je parie que ma voix pourrait porter beaucoup plus loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100509,
					"content": "J'irai me renseigner à la Guilde tout à l'heure. Si mes souvenirs sont bons, on peut engager des aventuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Hélène"
				},
				{
					"id": 700100510,
					"content": "Quand même... Je ne savais pas que les aventuriers allaient dans de tels endroits... C'est fascinant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hélène"
				}
			]
		},
