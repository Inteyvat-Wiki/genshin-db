			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "À propos de la mission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "Oh, vous avez déjà fini ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Mission accomplie !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Merci pour vos efforts. J'ai fini de préparer le paquet pour Cyrus pendant ce temps. Pouvez-vous le lui remettre ? J'aurai votre paiement prêt une fois que vous aurez terminé, alors n'oubliez pas de revenir me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "Je ne sais pas vraiment si ça lui suffira... Mais bon, s'il veut recruter des gens, les détails sur les monstres et les minerais devraient faire leur petit effet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "*soupir* Ce programme de recrutement n'a pas l'air bien efficace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Un paquet de la part d'Iris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Hmm, elle a quelque chose pour moi ? Ah oui... Je lui avais demandé de venir la dernière fois, j'avais presque oublié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "Vous n'êtes pas censé profiter de la Fête des alizées ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "La Fête des alizées ? Je n'ai pas le temps pour ça. Notre précédent programme de recrutement est obsolète, je suis en train d'en concevoir un nouveau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Voyons voir ce qu'Iris m'a envoyé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "Des minerais... Non, ça ne sert à rien... Les jeunes de nos jours se fichent plutôt pas mal de ces trucs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Des cartes topographiques ? *soupir* Hmm, ce sera utile pour les membres de la Guilde, c'est vrai, mais je pense que ça ne servira à rien pour le recrutement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Des informations sur les monstres ? Eh bien, nous pouvons en faire des copies pour nos aventuriers. Par contre, on ne peut pas les utiliser pour attirer de nouveaux membres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "Oh, et ça, qu'est-ce que c'est ? Ces deux clichés sont plutôt bien. Beaux paysages, et il n'y a rien de dangereux en plus. Ah, ça va attirer l'attention, c'est sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "Pourquoi choisissez-vous ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "On dirait qu'il a jeté tout ce qui concerne l'aventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Vous n'êtes pas au courant de la situation actuelle de la Guilde... Les jeunes d'aujourd'hui se moquent bien des monstres, des minéraux et des cartes topographiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "C'est ça qu'il faut pour attirer l'attention de nos jours. Il faut quelque chose... Quelque chose de plus terre-à-terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "Et puis, c'est la Fête des alizées en plus. Les jeunes veulent trouver des façons uniques de faire preuve de charme, mais sans pour autant vouloir se mettre trop en danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "S'aventurer à Dosdragon est un bon moyen pour eux de le faire. Si des gens trouvent ces clichés intéressants, ils viendront à la Guilde demander plus de précisions. Et peut-être même qu'ils décideront de nous rejoindre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "Et puis... Même s'ils ne rejoignent pas, eh bien... S'ils nous confient quelques missions en plus, c'est déjà ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "Et puis, vous voyez où ont été prises ces photos ? Juste au bord de la route ! Tant qu'on fait un peu attention, il n'y a aucun danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "Ça fait un peu désespéré, tout ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Eh bien, c'est la vie. Je ne ferais pas ça si on avait d'autres idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "Si vous ne me croyez pas, pourquoi ne pas prendre ces deux clichés et les montrer à quelques personnes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "Parlez-leur d'abord de la campagne de recrutement de la Guilde, puis utilisez ces deux clichés comme matériaux de recrutement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100324,
					"content": "Comme ça, vous comprendrez pourquoi j'en suis arrivé à cette méthode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7001004,
			"completionStepIds": [
				7001011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001011",
