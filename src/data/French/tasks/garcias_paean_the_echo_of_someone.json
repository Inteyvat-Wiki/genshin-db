			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "Bonjour ? Eh bien... Qu'est-ce que vous voulez savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Comment avez-vous fait la connaissance de Garcia ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "#On peut dire que vous êtes {M#direct}{F#directe}, vous, hein ? Ah oui, c'est vrai que c'est le style des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Ma première rencontre avec Garcia... C'est quand il a été embauché par le chef de ma troupe pour gérer les comptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Hahaha, pour être honnête, je n'avais jamais vu quelqu'un d'aussi peu à sa place dans une troupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Nous jouions de la musique, dansions, buvions et chantions, tandis que lui et Lutong faisaient des calculs en silence dans leur coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Un jour, je l'ai vu porter des vêtements étranges qui avaient une sorte de dessin dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "J'étais curieuse alors je lui ai demandé ce que c'était que ce dessin et il m'a répondu que c'était un plan pour une machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Il avait dessiné sur ses vêtements parce qu'il n'avait pas trouvé de quoi écrire pendant qu'il discutait de la machine avec quelqu'un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Alors il avait dessiné le plan au charbon sur le vêtement qu'il portait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Puis on a parlé de vêtements tachés et de sa machine... Bien sûr, c'est lui qui parlait et moi qui écoutais la plupart du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Haha, il est vraiment bizarre, mais... c'est un grand charmeur aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
