			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "Très bien, ces badges devraient faire l'affaire pour mes expériences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "Voici votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourquoi vous me regardez comme ça ? Vous me faites peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170304,
					"content": "Ahem ! Bon, je vais retourner à mon travail, moi, j'y retourne de ce pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
