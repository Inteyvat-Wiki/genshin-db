	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "#Voy... {M#Voyageur}{F#Voyageuse} ! Vous arrivez juste à temps, je finissais mon café avec Kaia et je me préparais à retourner au travail. Laissez-moi faire les présentations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "C'est la personne dont tu m'as parlé plus tôt ? C'est un honneur de vous rencontrer, je suis Kaia, une... Euh... Danseuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Bonjour. J'ai entendu Garcia parler de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Haha, vraiment ? J'en suis ravie, je pensais que Garcia ne s'intéressait qu'à sa machine, et à Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Vous pouvez me sortir de l'équation, mademoiselle, je suis sûr que monsieur Garcia approuvera également.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Pas question, sans vous, Garcia aurait dépensé jusqu'à son dernier centime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Je ne suis pas d'accord, mademoiselle. Je suis sûr que monsieur Garcia aurait mis de l'argent de côté pour deux cafés quoi qu'il arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Pour trois cafés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Votre générosité m'étonnera toujours, monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "#Revenons-en au sujet ! {M#Voyageur}{F#Voyageuse}, je suis toujours à la recherche des badges que portent les Pilleurs de trésors. Si vous en avez, vous pouvez me les vendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "J'ai... gagné un peu d'argent ces derniers temps, vous n'avez pas à vous inquiéter du paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301702,
