			"trigger": {
				"objectNames": [
					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "*soupir* Encore un arrivage de marchandises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330202,
					"content": "Je viens pour les marchandises de Raef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "Vous voulez parler de ce que Raef a commandé chez moi ? Je viens de recevoir une livraison qui contient justement ce dont il a besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330204,
					"content": "Par contre, il a acheté beaucoup de choses... Vous venez chercher sa commande à sa place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330205,
					"content": "C—C'est lourd ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "En plus de ce pot de fleur, il y a plusieurs types de graines, de l'engrais, des outils de jardinage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330208,
					"content": "#Ça pèse son poids. Vous... Vous pensez pouvoir porter tout ça {M#tout seul}{F#toute seule} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330209,
					"content": "J'ai mes propres méthodes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "#Ah bon... Eh bien, je vais vous emballer sa commande. Merci de vous être {M#déplacé}{F#déplacée}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330210,
					"content": "J'ai dit à Raef que je le ferais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "#C—Combien de choses a-t-il achetées{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
