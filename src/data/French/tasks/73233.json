			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous voilà de retour. Merci pour tout ce que vous avez fait... Comment Nermin a réagi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Elle a peur de ne pas être capable de faire pousser les fleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Eh bien... Je vais l'aider à se renseigner. Si on n'y arrive vraiment pas, on trouvera quelqu'un pour nous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "Et si après ça, ça ne marche toujours pas... J'irai... J'irai trouver quelque chose de plus facile à faire pousser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "#Bref... Merci beaucoup, {M#voyageur}{F#voyageuse}. Veuillez accepter ceci comme récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "J'apporterai le reste à Nermin tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Une minute, ces outils de jardinage n'ont pas de mode d'emploi ? Je ne sais pas du tout comment les utiliser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "C'est la première fois que vous lui offrez des fleurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Non... Mais les fleurs que je demandais aux gens d'acheter pour moi avaient déjà fini de pousser. Une fois arrivées au village, elles étaient déjà presque desséchées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "Donc cette fois, j'ai décidé d'offrir à Nermin des fleurs en pot fraîchement plantées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
