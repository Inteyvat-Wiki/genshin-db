			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330301,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Vous avez rapporté ce dont j'ai besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
		{
			"id": 7323304,
			"completionStepIds": [
				7323307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323307",
							"2"
						],
						"stepId": 7323307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "#Oui, c'est bien ça. Merci beaucoup, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "Vous comptez ouvrir un magasin de fleurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Ah, eh bien, c'est que... Je préfère acheter beaucoup de choses à la fois pour ne pas devoir sortir à plusieurs reprises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "Pourquoi ne pas vous reposer un peu ? Je dois d'abord planter les graines et mettre de l'engrais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef commence à s'occuper des fleurs...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "Et voilà ! Maintenant, Nermin n'aura plus qu'à arroser ces fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que... je peux vous demander une autre faveur ? Apportez ces fleurs à Nermin, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "Pourquoi vous n'y allez pas vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Je dois surveiller cette route. Si de la nourriture ou des provisions arrivent, je dois aller l'annoncer aux gens du village pour qu'ils viennent les chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "Vous savez, avec cette chaleur... On ne peut pas laisser les marchandises ici trop longtemps, sinon elle vont finir par être endommagées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "#Je compte sur vous, {F#voyageuse}{M#voyageur} ! Nermin habite tout près d'ici. Je ne vous demanderai que de lui apporter ces fleurs. Pour le reste, je trouverai un moyen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "Pourquoi acheter autant de choses ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323305",
							"2"
						],
