						240140204
					]
				},
				{
					"id": 240140204,
					"content": "Bonjour, je m'appelle Linorea. Ravie de vous rencontrer. Je suis journaliste et je me spécialise dans les problèmes environnementaux. J'étais en train... de mettre des alevins dans ces eaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140205
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140205,
					"content": "Hmm... Vous n'étiez pas avec Semaine la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140206,
					"content": "Oh, vous êtes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140207
					]
				},
				{
					"id": 240140207,
					"content": "Vous connaissez Semaine ? C'est vous qui avez aidé Semaine à apporter les cadeaux ? Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140208
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140208,
					"content": "Semaine ne m'a parlé de ça qu'à mon retour à la maison après l'opéra. Depuis, je me suis dit que je devrais vous inviter à manger chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140209
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140209,
					"content": "Je ne m'attendais pas à vous voir ici... Mais vous tombez mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140210
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140210,
					"content": "Vous avez dit être venue ici pour mettre des alevins à l'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140211
					],
					"speakerTitle": "Paimon"
				},
				{
