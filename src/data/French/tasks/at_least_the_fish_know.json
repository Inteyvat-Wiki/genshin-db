						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linorea"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140801,
					"content": "Quelle plaie, ces mékapoissons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140802,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "Je l'ai réparée, mais j'ai rapidement eu de nouveaux soucis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140805,
					"content": "Pour des raisons inconnues, les mékapoissons dans cette zone semblent être enragés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140806,
					"content": "Quand j'ai introduit les alevins, ils se sont précipités vers eux pour les dévorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140807,
					"content": "Quelques alevins sont restés accrochés sur ma combinaison, et les mékapoissons n'ont pas hésité à se jeter sur moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140808,
					"content": "Je sais qu'ils ne m'attaqueront pas. Mais... J'ai quand même eu très peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140809,
					"content": "Ensuite, je me suis débattue dans l'eau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140810,
					"content": "Je ne sais pas comment, mais je me suis retrouvée avec un gros trou dans ma combinaison... Heureusement, je n'étais pas trop loin du rivage et suis parvenue à sortir de l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140811,
					"content": "Mais vu l'état de ma combinaison, je ne peux pas continuer à travailler pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140812,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à mettre des alevins à l'eau ? La profondeur importe peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140803,
					"content": "Avez-vous réparé votre combinaison ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}