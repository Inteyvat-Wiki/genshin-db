			},
			"dialogs": [
				{
					"id": 240140101,
					"content": "... Il y a encore moins de poissons ici. Serait-ce la faute des mékapoissons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Il faut mettre les alevins dans des eaux plus profondes... Argh, pourquoi fallait-il que ma combinaison de plongée me lâche maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Bonjour, je m'appelle Linorea. Ravie de vous rencontrer. Je suis journaliste et je me spécialise dans les problèmes environnementaux. J'étais en train... de mettre des alevins dans ces eaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Une journaliste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "C'est exact. Mais je ne suis pas du genre à publier des rumeurs sur les personnalités publiques ni à répéter des nouvelles ennuyeuses toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Je m'intéresse actuellement à une question très sérieuse qui est en train de menacer la sécurité du public de la Cour de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "Et c'est la raison pour laquelle je suis venue ici pour mettre des alevins à l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "... Vous avez entendu parler des mékapoissons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Est-ce un poisson typique de la Cour de Fontaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "Pour quelle raison ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
