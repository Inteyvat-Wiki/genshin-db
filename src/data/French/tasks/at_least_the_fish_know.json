			"dialogs": [
				{
					"id": 240140601,
					"content": "Avez-vous mis les alevins à l'eau pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140602
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140602,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Merci beaucoup. Je pourrai continuer dès que j'aurai réparé ma combinaison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "J'espère que ces poissons grandiront bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "Ne vous inquiétez pas. Nous avons préparé de nombreuses espèces d'alevins pour les différents écosystèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "Les alevins que vous avez mis à l'eau ont été spécialement sélectionnés pour cet environnement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "Je vais encore mettre quelques bancs, puis les aventuriers que nous avons engagés viendront nettoyer les mékapoissons de cette zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Je suis sûre que ces alevins grandiront et restaureront l'écosystème dans la zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Une fois que l'écosystème sera restauré, j'écrirai un long rapport pour que tout le monde sache ce que l'Institut de recherche de Fontaine a fait à l'environnement naturel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Tu vas voir ce que tu vas voir, Damestier ! Cette fois, tu ne m'arrêteras pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
