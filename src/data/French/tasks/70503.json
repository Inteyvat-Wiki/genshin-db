			"dialogs": [
				{
					"id": 705030101,
					"content": "Une petite tasse de récif mousseux, s'il vous plaît... Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030102,
						705030103
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030102,
					"content": "Eula ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				},
				{
					"id": 705030104,
					"content": "Oui, ça va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030105
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030105,
					"content": "Hum... Quelque chose cloche avec Eula. Est-ce qu'elle a bu avant de venir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030106,
					"content": "Il y a du café dans le récif mousseux. Elle aura mal au ventre si elle en prend après avoir bu de l'alcool, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030107,
					"content": "Tu pourrais ajouter un peu plus d'eau à la boisson avant de la servir pour lui éviter ce désagrément !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030103,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				}
			]
		},
		{
			"id": 7050302,
			"completionStepIds": [
				7050303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050303",
							"2"
						],
						"stepId": 7050303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705030238,
					"content": "Vous ajoutez un peu plus d'eau dans le café comme vous l'a suggéré Paimon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705030201,
					"content": "C'est pas mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030202
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030202,
					"content": "Ouah, Eula n'a même pas remarqué toute l'eau qu'on a ajoutée. Elle doit être bien éméchée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030203,
					"content": "Un autre, barman... Hé, mais attendez, c'est vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030204,
						705030205
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030204,
					"content": "#On apprend à devenir des {M#barmans}{F#bardmaids}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030205,
					"content": "Ce n'est que maintenant que vous le remarquez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030207
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030207,
					"content": "Désolée, je viens de La Queue de Chat. J'ai peut-être un peu trop bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030208,
						705030209
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030208,
					"content": "Vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030209,
					"content": "Je suis là si vous avez envie de parler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030210,
					"content": "Oui, c'est triste de boire toute seule. Dites-nous ce qui vous tracasse, vous vous sentirez mieux après !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030212
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030212,
					"content": "C'est vrai que je bois toujours seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030213
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030213,
					"content": "Les gens n'aiment pas me voir à Mondstadt, quelle que soit la taverne. J'étais de bonne humeur aujourd'hui et je voulais simplement boire quelques coups, mais tout le monde me pointait encore du doigt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030214,
					"content": "#{NICKNAME}, comment faites-vous pour avoir autant d'amis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030215
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030215,
					"content": "Quand les gens parlent de vous, ils ont toujours ce ton heureux et ce sourire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030216
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030216,
					"content": "Alors que la seule mention de mon nom suffit à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030217
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030217,
					"content": "Ne dites pas ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030218
					]
				},
				{
					"id": 705030218,
					"content": "Vous n'avez pas choisi de naître dans le Clan Lawrence, Eula. Puis, on s'en fiche, nous ! On sait que vous êtes une chouette personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030219,
					"content": "Par contre, vous n'êtes pas honnête avec vos sentiments. Vous faites toujours mine de vous offusquer des « affronts » subis pour ne pas montrer votre côté sympathique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030220,
					"content": "Hé, mais je ne fais pas semblant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030221,
						705030222
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030221,
					"content": "D'autres gens vous accepteront, Eula...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030222,
					"content": "Comme nous l'avons fait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030223,
					"content": "Vous pensez ? Je n'arrive pas à l'imaginer, même saoule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030224
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030224,
					"content": "Depuis tout ce temps, et même après avoir rejoint l'Ordre de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030225,
					"content": "« Le vent finit toujours par changer de direction. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030226
					]
				},
				{
					"id": 705030226,
					"content": "Oh ! C'est ce que le barde de pacotille disait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030227,
					"content": "Eula, continuez d'être vous-même et persévérez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030228,
					"content": "Un jour viendra où vous changerez la perception qu'ont les gens du Clan Lawrence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030229,
					"content": "Oui, tenez bon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030230
					]
				},
				{
					"id": 705030230,
					"content": "Oui... Merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030231
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030231,
					"content": "Ah, euh... Je—Je vais y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030232
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030232,
					"content": "Je vous ramène ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030233
					]
				},
				{
					"id": 705030233,
					"content": "Ne vous embêtez pas. Je ne peux pas penser à autre chose, au risque d'oublier vos paroles. Il faut que je m'en souvienne, et que je les note sur papier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030234
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030234,
					"content": "Eula est bien plus ouverte à la conversation lorsqu'elle est saoule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030235,
					"content": "#C'est bizarre de ne pas l'entendre qualifier tout et n'importe quoi d'« affront{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030236,
					"content": "Oh ! Mais tu penses qu'elle viendra nous menacer de tout oublier demain quand elle s'en sera remise ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030237,
					"content": "Peut-être.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}