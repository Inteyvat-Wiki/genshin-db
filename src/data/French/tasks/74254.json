			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour ! Ça fait longtemps ! Et Mamère aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Haha, Seymour n'arrêtait pas de me dire à quel point vous lui manquiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540503,
					"content": "Affirmatif. Je n'ai jamais cessé de penser à mademoiselle Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "Et merci, mademoiselle Sandrone, d'avoir organisé ce goûter. C'est si agréable de se retrouver pour discuter de nos voyages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Je vous en prie. J'ai l'impression que nous formons tous une famille d'une certaine manière, avec une longue histoire commune. Hum... Du moins, c'est comme ça que je le vois. Il n'y a aucun mal à se réunir quand tout le monde est libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540506,
					"content": "Une famille ? Je ne sais pas pourquoi, mais vous entendre dire cela me remplit de joie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Mademoiselle Sandrone, vous seriez donc un peu comme notre... petite sœur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Euh... On pourrait peut-être éviter cette histoire de « petit » et « grand » pour l'instant...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540509,
					"content": "Affirmatif. En tant que prototype créé par monsieur Alain, mademoiselle Sandrone devrait m'appeler « grand frère ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Tsk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540511,
					"content": "C'est vraiment charmant. Est-ce que je peux aussi faire partie de votre famille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540512,
					"content": "Bien sûr ! Ce n'est déjà pas vraiment une famille conventionnelle au départ. Je ne vois pas d'inconvénient au fait d'y ajouter une mélusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540513,
					"content": "Affirmatif. Mademoiselle Mamère fait déjà partie de ma famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Héhé. Ça me rend tellement heureuse ! Et si je nous peignais un portrait de famille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540515,
					"content": "Un portrait de famille ? Ça fait une éternité que je n'ai pas posé pour ce genre de chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Mais il faut que j'aie l'air un peu plus impressionnante ! Comme la grande sœur de la famille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540518,
					"content": "Ha... Pourquoi pas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
