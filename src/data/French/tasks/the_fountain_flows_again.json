			"dialogs": [
				{
					"id": 740370701,
					"content": "Ça devrait faire l'affaire ! Attendez, ça ne va prendre qu'un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle se met directement au boulot de façon acharnée...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Voilà, c'est terminé. La vanne, la buse et tous les composants dont on aura besoin, tout est prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "#Edel, {M#voyageur}{F#voyageuse}, dirigeons-nous vers l'Île d'Erinnyes. Si je vous accompagne, la fontaine sera réparée en un rien de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "#Merci... Je vais prendre ces objets. Allons-y vite, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
