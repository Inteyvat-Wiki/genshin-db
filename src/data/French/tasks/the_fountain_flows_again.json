				]
			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "C'est ici, mettons-nous au travail. Cette fontaine est à l'arrêt depuis trop longtemps. Il est temps de la remettre en marche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "Les deux se mettent sérieusement au travail...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "La valve est en place. J'ai aussi fait une révision complète, rien d'important à signaler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Bien, reculons un peu. La dernière chose à faire est d'ouvrir les vannes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Voyons voir... La vanne principale est là, et la vanne secondaire devra également être ajustée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Veuillez m'attendre ici, je vais ouvrir les vannes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Qui a conçu ce système, franchement ? Pourquoi mettre les vannes aussi loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel sprinte vers les vannes et revient après un moment...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Pff, les vannes n'étaient vraiment pas faciles à ouvrir, je suis épuisé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Attendons un instant. L'eau devrait bientôt arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Après une série de grondements étouffés, la fontaine recommence à fonctionner normalement...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Génial ! La fontaine fonctionne à nouveau... Même si Keratry mentionne ce qui s'est passé cette nuit-là, je peux prétendre ne pas savoir de quoi elle parle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370813,
					"content": "Tu sais maintenant qu'il faut être prudent avec les performances de magie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Ce problème n'avait rien à voir avec la magie... Mais merci quand même. Veuillez accepter ceci en guise de remerciements !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370816,
					"content": "Le paiement que je vous ai promis est là aussi. Merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370817,
					"content": "Et merci à vous aussi, Edel et mademoiselle Estelle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370818,
					"content": "Je ne faisais que mon travail, pas besoin de me remercier. La prochaine fois, ne laissez pas votre petite sœur sortir si tard le soir... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Frangin ! Que fais-tu ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry ?! Qu'est-ce que tu fais ici ? Tu n'étais pas... Tu n'étais pas censée faire une promenade avec maman et papa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370821,
					"content": "Haha... Je me suis enfuie pendant qu'ils ne regardaient pas. Je voulais voir si la fontaine fonctionnait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Tu n'avais pas utilisé la magie pour arrêter cette fontaine ? Je pensais qu'elle ne fonctionnerait toujours pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Haha... Hmm... Haha... La magie a ses limites. Je suis sûr que tu le sais, non ? Ça ne fonctionne que pendant un certain temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370824,
					"content": "Oh... Alors je veux voir plus de magie ! Tu pourrais encore une fois arrêter la fontaine ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Euh... Ahem. Keratry, il y a un peu trop de monde pour ça là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370826,
					"content": "Si je l'arrête, je vais contrarier tous ceux qui veulent la regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370827,
					"content": "Eh bien... Nous pouvons revenir plus tard ! Et amenons maman et papa aussi. Je suis sûre qu'ils voudront aussi te voir faire de la magie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Hein ?! Non, c'est... Non, non, Keratry, je n'ai pas vraiment... entièrement maîtrisé cette magie de fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370829,
					"content": "Je suis sûr que nos parents n'ont pas envie de voir de la magie à moitié foirée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370830,
					"content": "C'est pourquoi tu ne peux pas encore leur parler de ma « fontaine magique ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370831,
					"content": "Je veux être sûr de bien la maîtriser avant de les surprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370832,
					"content": "D'accord ! Je suis sûre qu'ils vont adorer une fois que tu seras prêt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Oui, je pense aussi. Mais rentrons d'abord à la maison, d'accord ? Je... Je pourrai te montrer un nouveau tour quand on y sera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370814,
					"content": "La magie et les miracles ont toujours un prix.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
}