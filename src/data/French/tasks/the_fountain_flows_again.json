			"dialogs": [
				{
					"id": 740370101,
					"content": "*soupir* Pourquoi Edel n'a pas encore réparé cette fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370102,
					"content": "Si elle n'est pas rapidement réparée, on peut être sûr que tout Teyvat sera au courant avec Keratry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370103,
					"content": "Cette fontaine est-elle cassée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "*soupir* Elle fonctionnait très bien il y a quelques jours, mais les jets d'eau se sont soudainement arrêtés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370105,
					"content": "Pire, elle est tombée en panne juste au moment où je faisais des tours de magie pour Keratry !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370106,
					"content": "Mes parents étaient à l'Opéra quand c'est arrivé, ils m'avaient demandé d'occuper ma sœur avec des jeux ou des livres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370107,
					"content": "Mais Keratry n'arrêtait pas de demander pour sortir. Et comme je n'ai pas réussi à la convaincre de rester à l'intérieur, j'ai fini par sortir avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370108,
					"content": "Quand nous sommes arrivés à la fontaine, Keratry a soudainement dit qu'elle voulait attendre que maman et papa sortent de l'opéra pour rentrer à la maison avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370109,
					"content": "Ce ne devrait pas être un problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Ouais. Je pense que puisque tu as déjà parcouru tout ce chemin, si tu avais attendu que tes parents sortent, peut-être qu'ils t'auraient offert quelque chose de délicieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Il était déjà très tard à ce moment-là... Maman et papa me tueraient s'ils découvraient que j'ai laissé sortir ma sœur en douce, et que nous flânions si tard dans la nuit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370112,
					"content": "Alors, j'ai dit un petit mensonge à Keratry. Je lui ai dit que je connaissais un certain type de magie qui pouvait arrêter les jets d'eau de la fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370113,
					"content": "En réalité, je chronométrais juste les intervalles entre les jets d'eau pour l'amuser et la faire rentrer à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370114,
					"content": "La fontaine s'est arrêtée à temps avec mes estimations, et ma sœur a cru à ma « magie ». Elle n'arrêtait pas de me harceler pour lui apprendre à faire ce « tour » jusqu'à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370115,
					"content": "Alors, je l'ai ramenée à la maison, j'ai fait quelques tours pour satisfaire sa curiosité, et je l'ai mise au lit avant de retourner dans ma chambre. Maman et papa sont rentrés un peu plus tard, et tout semblait normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370116,
					"content": "Mais le lendemain, quand je suis sorti chercher le journal pour papa, je me suis rendu compte que la fontaine ne fonctionnait toujours pas... Elle était cassée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370117,
					"content": "Ta magie est assez puissante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "Ce n'est pas marrant ! Si Keratry en parle à maman et papa, je vais avoir des problèmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370120,
					"content": "« Hein ? La fontaine de la place s'est soudainement cassée ? Qu'est-ce qui a pu se passer, mon chéri ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370121,
					"content": "« C'est vraiment étrange. Elle fonctionnait très bien avant qu'on n'aille à l'opéra. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370122,
					"content": "« Je sais pourquoi ! C'est parce que Remaudière l'a arrêtée ! N'est-ce pas ? N'est-ce pas ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370123,
					"content": "C'est une très bonne imitation !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "En plus, ils découvriront que ma sœur et moi étions sortis la nuit, ils crieront tellement après moi, et je serai dans le pétrin pendant deux mois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370126,
					"content": "Mais... Il doit bien y avoir quelqu'un responsable de la réparation de cette fontaine lorsqu'elle tombe en panne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "C'est Edel qui est responsable de cette fontaine. Je lui en ai déjà parlé. Il m'a promis qu'il le réparerait dès que possible, mais... Ce n'est pas encore fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370128,
					"content": "Je ne peux plus le cacher plus longtemps, je suis foutu, complètement foutu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370129,
					"content": "Je vais aller lui demander pour toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "#Vraiment ? Vous seriez {M#prêt}{F#prête} à m'aider ? Dans ce cas, je vous donnerai l'argent de poche qu'il me reste, l'entièreté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370132,
					"content": "Edel est là-bas. Dépêchez-vous d'aller lui demander ce qui se passe, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370130,
					"content": "Ah. Ce n'est pas grave. Je vais te donner un coup de main.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Grâce à cette performance, je comprends maintenant totalement la situation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Comme on pourrait s'y attendre de la part d'un puissant magicien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Alors que vous observez la fontaine, quelqu'un d'autre arrive...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
