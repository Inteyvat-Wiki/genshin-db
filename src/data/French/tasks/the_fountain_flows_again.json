				]
			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "Bonjour, en quoi puis-je... Oh, Edel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "Je suis ici pour la valve et la buse. Si la fontaine n'est pas réparée bientôt, Remaudière va perdre la raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "L—La valve, dites-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "Euh, pourquoi vous bégayez ? Estelle... Vous n'avez pas oublié ma commande, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "Non ! C'était prêt. Mais... Une cliente précédente a dû faire des réparations urgentes sur autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "E—Eh bien je, euh, je lui ai donné quelques pièces génériques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "Ne vous inquiétez pas ! Je suis en train d'en faire de nouvelles en ce moment ! Ce sera bientôt prêt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Mademoiselle Estelle, j'ai fait cette commande il y a un moment déjà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "Je sais ! Mais ma cliente était pressée. Elle a affirmé qu'elle avait besoin de réparer une vanne d'égout, et sa supplication a eu raison de moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "Il n'y a pas de problème ! Une fois... Une fois que les morceaux de fer que j'ai achetés arriveront, je pourrai fabriquer cette valve ! Ils devraient bientôt arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "Quand avez-vous passé cette commande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "C—Ce matin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Laissez-moi m'occuper des morceaux de fer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "#Vraiment ? Je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "Je suis vraiment désolée ! Trois morceaux de fer suffiront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "#Eh bien, nous comptons sur vous, {M#voyageur}{F#voyageuse}. Ne vous souciez pas de la rémunération, tout travail mérite salaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "Je vais vous chercher ces morceaux de fer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
