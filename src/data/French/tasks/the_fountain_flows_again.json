			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Ce tuyau doit être changé... Et les vannes... Il faudrait aussi nettoyer l'ensemble... *soupir* Problèmes sur problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Hein ? Avez-vous besoin de quelque chose ? Vous n'avez pas l'air d'être les personnes qu'Estelle a envoyées pour réparer cette fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "À propos de Remaudière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Ah, lui ? Haha, sa magie est vraiment puissante. Il a réussi à faire rouiller une vanne dans la tuyauterie la plus basse de la fontaine et a également complètement cassé la buse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Haha, je plaisante. En fait, c'est la valve déformée qui s'est coincée et a bloqué tout le système. Pour des raisons de sécurité, nous fermons temporairement toute la fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Mais pourquoi la buse s'est-elle cassée ? Je ne sais vraiment pas... C'est vraiment étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudière n'arrête pas de dire que si la fontaine n'est pas bientôt réparée, il va se faire punir... Mais je ne peux pas tout faire en même temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "J'ai enfin eu le temps de commander une nouvelle valve et une nouvelle buse chez Estelle aujourd'hui, et je suis sur le point d'aller en ville pour les récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "Vous pouvez venir avec moi si vous voulez. J'ai pas mal de choses à récupérer, et je ne suis pas sûr de pouvoir me débrouiller tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
		{
			"id": 7403704,
			"completionStepIds": [],
