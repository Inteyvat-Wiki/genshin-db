				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Alors, vous avez jeté la bouteille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Petit Meng va-t-il vraiment pouvoir la récupérer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Euh, ça me semble compliqué. En général, ces bouteilles ne sont jamais repêchées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "On a donc fait tout ça pour rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Hé, ne vous en faites pas. Je vous l'ai déjà dit, un adulte de confiance sera là pour l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Connaissez-vous Sumeru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "J'ai quelques collègues marchands qui projettent de faire du commerce de champignons là-bas. Ces derniers temps, ils se préparent à y aller pour faire quelques recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Hahaha, mais vous savez aussi bien que moi qu'ils ont beau dire qu'ils vont à Sumeru pour faire des recherches, c'est en réalité pour aller s'amuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Puisque ce Petit Meng souhaite partir en voyage, alors je pourrais les contacter pour leur demander s'ils peuvent emmener une personne supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Ne vous faites pas de souci, je m'occupe d'organiser ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "J'ai recopié la lettre à d'autres fins. Quant à cette bouteille... Elle finira là où elle doit finir. Je ne pense pas qu'elle sera récupérée par qui que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Merci de votre aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "C'est plutôt normal que les adultes aident les enfants à réaliser leurs rêves, non ? Laissez-moi m'occuper de tout ça, ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Ah, et il faut que je demande aux autres de s'habiller un peu plus sérieusement. Il ne faudrait pas qu'ils effrayent les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Pourquoi souhaitez-vous aider Petit Meng ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
