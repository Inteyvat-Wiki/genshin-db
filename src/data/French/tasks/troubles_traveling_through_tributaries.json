			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "On dirait l'écriture d'un enfant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260102,
					"content": "« Petit Meng » ? Qui ça peut bien être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260103,
					"content": "Hé ? Cette bouteille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "#{M#Voyageur}{F#Voyageuse} ? À en juger par votre ton, on dirait que vous connaissez la personne qui a rédigé cette lettre, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260105,
					"content": "On peut dire ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "Ah, c'est donc ça. Cet enfant a beaucoup de choses qui lui passent par la tête... Il aimerait devenir mûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260108,
					"content": "S'il pouvait voyager, voir le monde et découvrir de nouvelles choses, cela pourrait contribuer à résoudre son problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260109,
					"content": "Maintenant que vous le dites, Petit Meng disait qu'il voulait sortir du Port de Liyue pour voir ce qu'il y a à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260110,
					"content": "Dans ce cas, pourquoi n'a-t-il pas accepté quand on lui a proposé de l'accompagner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260111,
					"content": "Hahaha, peut-être que ce petit gars est un peu têtu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260112,
					"content": "Vu que ses problèmes ne concernent que lui, il est normal qu'il veuille les régler tout seul. Il ne veut pas avoir à s'aider des autres à chaque fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260113,
					"content": "Mais jeter une bouteille dans une rivière n'est pas vraiment une solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260114,
					"content": "C'est pour ça qu'il a besoin qu'un adulte de confiance lui vienne en aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260115,
					"content": "#{M#Voyageur}{F#Voyageuse}, écrivons ensemble une lettre à ce petit garçon, si vous le voulez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260116,
					"content": "On peut se servir de cette lettre pour lui dire qu'il y a plein de choses nouvelles et extraordinaires qui l'attendent à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260117,
					"content": "#Cependant... Héhé... Je n'ai pas visité beaucoup d'endroits, alors je vous laisse décider des lieux et des choses à décrire dans la lettre, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260118,
					"content": "Sur les hautes tours et les ruines prises dans la tempête...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "Moins vite, moins vite. Je n'arrive pas à tout écrire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260122,
					"content": "Hmm... Ici, on devrait écrire ça comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260123,
					"content": "Voilà ! J'ai fini. J'ai beaucoup écrit sans m'en rendre compte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260124,
					"content": "Hahaha, à force de vous entendre parler de ces endroits, j'ai moi aussi envie de partir en voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260125,
					"content": "Voyager n'est pas désagréable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "Je ne suis plus tout jeune, puis j'ai beaucoup de choses à faire. Je ne peux plus me permettre de partir en voyage comme je veux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260127,
					"content": "J'ai mis la lettre dans la bouteille. Allez vite la jeter dans la rivière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260119,
					"content": "Sur l'archipel lointain enveloppé par l'orage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "Sur l'île coupée en deux par l'Archon Électro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "C'est un enfant du Port de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
