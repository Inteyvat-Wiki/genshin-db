				]
			},
			"dialogs": [
				{
					"id": 240190301,
					"content": "Qu'en pensez-vous ? Comme je l'ai dit, ces goélands sont très bien élevés. Ce n'est pas comme ceux à côté du Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "C'est vrai qu'ils sont bien élevés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Pas vrai ? J'ai l'impression de vraiment me détendre quand je suis ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Imaginez-vous, vous êtes un goéland. Puisque les gens viennent vous nourrir, vous n'avez qu'à prendre le soleil et à réfléchir au sens de la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "*soupir* Pourquoi suis-je un gestionnaire, et non pas un goéland ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
