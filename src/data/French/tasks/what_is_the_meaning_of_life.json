				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "Comment... Comment avez-vous pu faire ça ? Ce ne sont pas ces voyous du Palais Mermonia !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "#{M#Désolé}{F#Désolée}, c'était un accident...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "*soupir* Je n'ai même pas eu le temps de vous arrêter. Pourquoi vous avez fait ça... Est-ce que l'un d'eux vous a attaqué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Ça n'a pas d'importance, ils sont déjà partis. Je vais devoir leur apporter quelque chose dans quelques jours pour leur présenter mes excuses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
