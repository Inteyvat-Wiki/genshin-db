			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "C'est tout ce que j'avais. J'espère que ça suffit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Je nourris ces goélands. Regardez, ils ont presque terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Waouh... Comment se fait-il que vous soyez si proche de ces goélands ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Ils n'ont pas volé vos frites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Non. Apparemment, les gens viennent ici pour les nourrir. Du coup, mes frites ne les intéressent pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Mais vous n'aviez pas dit la dernière fois que vous pourriez rater quelque chose d'important si vous vous éloigniez trop du travail ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Haha, je peux me le permettre, c'est mon rare jour de repos aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Pas de collègues pour m'entraîner dans des discussions de travail, et pas de goélands qui essayent de me voler mes frites... L'endroit est idéal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "De plus, les goélands ici sont très amicaux. Ils ne m'ont pas volé mes frites et ne m'attaquent pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Ils semblent me reconnaître depuis que je les ai nourris plusieurs fois. Même si je les touche, ils ne font rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "En comparaison avec ceux du Palais Mermonia, ils sont bien plus gentils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "S'ils apprenaient à utiliser leurs serres pour taper à la dactylographeuse, ils pourraient presque faire notre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Les goélands ne peuvent pas aider les gens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Au moins, les goélands ne feront pas pire. Et tout le monde sait qu'il y en a des choses trop difficiles pour eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Ne parlons plus de ça. Vous voulez essayer de vous lier d'amitié avec eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Waouh, à vos yeux, ce sont presque de vraies personnes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Est-ce que ce serait impoli d'aller vers eux directement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Non, ils sont très tolérants. Tant que vous ne froissez pas leurs plumes, tout se passera bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Tenez, c'est un poisson que j'ai spécialement préparé. Vous pouvez le mettre dans ce bol là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Détendez-vous. Les goélands sont très tolérants. Ils apprécient tous ceux qui les nourrissent, et ne posent jamais de questions sur l'origine ni la préparation des poissons que vous leur donnez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Y a-t-il une astuce pour devenir ami avec des goélands ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Non, pas vraiment. Il suffit de ne pas froisser leurs plumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Les goélands ne comprennent pas le langage des humains.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Je n'en suis pas si sûr. Peut-être qu'ils font semblant de ne pas comprendre les gens pour pouvoir avoir la paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
