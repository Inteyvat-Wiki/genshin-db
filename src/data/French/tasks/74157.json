			"dialogs": [
				{
					"id": 741570301,
					"content": "Cette maison est à vendre. Prix abordable. Achetez-la dès maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Avis de maison à vendre"
				},
				{
					"id": 741570302,
					"content": "#{NICKNAME}, et Paimon ! Vous êtes {M#venus}{F#venues} voir monsieur Leroy ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Est-ce que Benoît est ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Il n'est pas là, mon père a dit que monsieur Leroy ne viendra plus jamais habiter dans le coin. Il vit maintenant sous terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "Dans le Fleuve cendré ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "#Le même Fleuve cendré où on était {M#allés}{F#allées} auparavant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "Non, mon père parlait d'un endroit encore plus profond sous terre que le Fleuve cendré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "L'Oiseau de vapeur a rapporté que monsieur Leroy est tombé de très haut lorsqu'il escaladait une montagne. Il a fait une énorme chute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "En fait, je ne comprends pas très bien le lien entre sa chute et son déménagement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "Ah, avant de revenir, j'ai rencontré le beau-fils de monsieur Leroy, ainsi qu'une dame qui était très gentille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "La dame m'aimait beaucoup, elle avait les mêmes yeux que moi. Ils étaient violets aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "Elle m'a également demandé où j'habitais et m'a dit qu'elle me rendrait visite quand elle en aurait l'occasion et deviendrait mon amie. Je savais bien que monsieur Leroy et sa famille étaient de très bonnes personnes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "*soupir* J'avais prévu de donner des fruits bullés à monsieur Leroy, mais vu qu'il ne reviendra plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "Est-ce que vous en voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Merci, Molli !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "De rien ! Mon père et ma mère m'ont dit de toujours être généreuse avec mes amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "J'ai fait encore une bonne action aujourd'hui. Je l'écrirai dans mon journal à mon retour. Je suis contente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "Vous regardez Molli, plus joyeuse que jamais, disparaître de la rue, et l'histoire de la famille Leroy se termine ainsi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Nous ne faisions que passer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Je me demandais justement s'il fallait vous dire que monsieur Leroy avait déménagé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Mon père a dit que monsieur Leroy ne viendra plus jamais habiter dans le coin. Il vit maintenant sous terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
