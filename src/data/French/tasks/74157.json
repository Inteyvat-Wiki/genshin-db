			"dialogs": [
				{
					"id": 741570201,
					"content": "Cette maison est à vendre. Prix abordable. Achetez-la dès maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Avis de maison à vendre"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}, et Paimon ! On dirait que monsieur Leroy n'habite plus ici. Est-ce que vous l'avez vu récemment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570203,
					"content": "(Hé, est-ce qu'il faut lui dire la vérité ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "Nous l'avons revu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "Vous l'avez vraiment revu ! Est-ce que vous lui avez dit que ses friandises étaient délicieuses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570206,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#Je savais que vous tiendriez parole, {NICKNAME} ! Vous êtes vraiment {M#gentils}{F#gentilles} ! J'ai ramené quelques fruits bullés, vous pouvez en manger avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570214,
					"content": "Molli soupire, elle vous salue de la main, et alors qu'elle s'apprête à s'en aller...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "La porte s'ouvre. C'est Automne et Athos qui sortent de la maison.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "C'est vous que l'on entendait à l'extérieur ? En quoi puis-je vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Nous ne faisons juste que passer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "Vraiment ? Le monde est petit, Automne et moi allions justement quitter les lieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570219,
					"content": "Et Benoît ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "Oh, Benoît est déjà parti ailleurs. Dans un endroit que nous ne visiterons que dans plusieurs dizaines d'années. Je ne pense pas que vous le verrez avant longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570221,
					"content": "#Mais c'est difficile à dire. Un « accident » arrivera-t-il avant demain ? Qui sait{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570225,
					"content": "Tiens, ce ne serait pas la gamine qui venait souvent voir Benoît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "Bonjour madame !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570228,
					"content": "... Tu lui ressembles tellement. Et tu as aussi les yeux violets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "M—Madame, je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570230,
					"content": "Quel âge as-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "J'ai neuf ans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570232,
					"content": "Comment s'appellent tes parents ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Euh... Vous êtes sûre que ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570234,
					"content": "Cette expression sur ton visage... Qu'est-ce qu'il y a avec cette gamine ? ... Ça ne peut quand même pas être une coïncidence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570235,
					"content": "Est-ce que tu es adoptée ? Dis-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#{NICKNAME}, est-ce que vous connaissez cette dame ? Qu'est-ce qu'elle me veut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570237,
					"content": "Pourquoi tu poses des questions de cette manière ? Laisse-moi faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570238,
					"content": "Bonjour ma petite. Je me souviens que tu es très proche de notre père, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570239,
					"content": "Oui, je m'entends très bien avec monsieur Leroy. Mais il n'habite plus ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570240,
					"content": "C'est exact, il est parti vivre dans un endroit très éloigné d'ici et ne reviendra plus jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570241,
					"content": "De quoi parlais-tu en temps normal avec notre père ? Est-ce que tu peux me le dire ? Quand je partirai, j'irai le voir pour lui dire qu'il te manque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570242,
					"content": "Monsieur Leroy me donnait des friandises, me laissait caresser Nana et il disait même que mes yeux étaient magnifiques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570243,
					"content": "Et quoi d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570244,
					"content": "Il me demandait toujours de passer le bonjour à mes parents, même s'ils ne l'aimaient pas vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570245,
					"content": "Mon père se met en colère à cause de ça, il me dit que monsieur Leroy n'est pas une bonne personne, qu'il leur a « fait du chantage ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570246,
					"content": "Même si mes parents ne veulent pas que j'aille le voir, je le fais toujours le plus discrètement possible. Mais ne le leur dites pas, monsieur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570247,
					"content": "Il savait comment s'y prendre. Aucune chance qu'il lâche le morceau tant qu'il ne les aura pas ruinés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "... Le chacal... Pardon. Nous parlions d'autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570249,
					"content": "M—Monsieur, madame, est-ce que vous avez autre chose à me dire ? Sinon, je... Je vais rentrer chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570250,
					"content": "... Est-ce que tes parents t'aiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Ce sont les meilleurs parents de l'univers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Tant mieux, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "Je dois rentrer. Au revoir monsieur, au revoir madame !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570255,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "Vous en restez là ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "J'ai imaginé cette scène des tas de fois... Mais rien ne me comble plus que de savoir qu'elle est heureuse. Ça me suffit amplement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Je... Je ne suis pas comme mon père. Je ne veux pas causer de problèmes à sa famille actuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "Je ne veux pas plomber l'ambiance, mais tu ne lui avais pas acheté une boîte à musique ? Pourquoi ne pas la lui donner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "Ce n'est pas nécessaire. Elle... n'a pas l'air d'avoir besoin de ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Je trouverai un moyen de lui rendre visite fréquemment. Je lui offrirai tout ce qu'elle souhaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "... Je vais donner cette boîte à musique à quelqu'un d'autre. Après tout, j'ai mis du temps à la choisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Excusez-moi, petite demoiselle aux cheveux blancs, est-ce que vous aimez les cadeaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "Moi ? Vous voulez me l'offrir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Oui, je vous l'offre. J'espère qu'elle aura encore un peu de valeur pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Désolée, Athos, il va falloir que nous restions à la Cour de Fontaine pendant un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "Ça ne fait rien. Peu importe où nous allons, ça m'est égal. Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570270,
					"content": "Vous les regardez s'éloigner tous les deux. C'est ainsi que se termine l'histoire de la famille Leroy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "Vous n'allez rien lui dire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "Comment va Benoît ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "Ce monde est rempli d'inégalités, de pauvreté extrême, et en même temps de cupidité excessive. Les sanctions qui ne sont pas prévues par les lois de Fontaine ne peuvent qu'être exécutées par nous-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570224,
					"content": "Ce que je veux dire, c'est qu'il est parti là où il devait aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570208,
					"content": "Nous avons oublié.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "Ah d'accord. C'est dommage. On dirait que je n'aurai plus jamais l'occasion de le dire à monsieur Leroy. Autant que je vous donne... les fruits bullés que je lui avais apportés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570210,
					"content": "Nous ne l'avons pas vu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Ah, c'est vraiment dommage. Je pense que je ne le reverrai plus jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570212,
					"content": "J'ai apporté avec moi des fruits bullés, en espérant trouver monsieur Leroy. Comme il n'habite plus ici, je peux vous les donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570213,
					"content": "Quoi qu'il en soit, je me souviendrai toujours de monsieur Leroy. Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				}
			]
		},
