			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#Bonjour, {NICKNAME} et Paimon. Avez-vous mangé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa ? Qu'est-ce que tu fais sur le toit ? Tu observes la forme des nuages pour déduire la probabilité d'averses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "J'effectue une tâche qui... a dévié de son déroulement initial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "Initialement, je devais acheter un « engrenage de haute précision » et une « vis hexagonale spéciale » comme indiqué sur la liste d'Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Mais j'ai rencontré un... incident imprévisible d'interdiction d'approvisionnement sur le chemin du retour. Un faucon, volant à grande vitesse, m'a arraché la vis spéciale des mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "Du coup, tu es venue chercher le faucon sur le toit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "C'est exact. Cette espèce de faucon a pour habitude de s'arrêter temporairement sur les toits. Analyse : Balayage visuel et sonore complet. Objectif : Localiser la cible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "#Cependant, je n'ai trouvé aucune trace de ma cible pour l'instant. Déduction initiale : La cible s'est échappée du périmètre de détection ou a apporté sa «{NON_BREAK_SPACE}proie » dans un nid plus discret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Déclenchement du plan de secours : Revenir chez le fournisseur désigné pour acheter une vis du même modèle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "Bref, êtes-vous également à la poursuite d'un animal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Oui ! Au début, on voulait trouver un endroit avec une belle vue pour prendre des photos panoramiques du Village de Nasha dans toute sa splendeur et son agitation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "On ne s'attendait pas à tomber sur toi pendant que tu pourchassais un faucon voleur. J'imagine que c'est une « déviation inattendue » très rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Eh bien, puisque l'occasion se présente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Oui, veuillez m'indiquer la position, l'orientation corporelle et l'expression faciale recommandée pour cela. Je ferai de mon mieux pour les respecter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "Estimation : La probabilité que je monte sur le toit, que je vous rencontre et que vous me preniez en photo est plus faible que celle que le faucon me rende la vis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Il s'agit donc bien d'une « agréable surprise » très rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "C'est bon pour une photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "On cherche de l'inspiration pour des photos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
