			"dialogs": [
				{
					"id": 765040701,
					"content": "#Bonjour, {NICKNAME} et Paimon. Avez-vous mangé ? Avez-vous des choses spéciales à faire aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "On se promène juste dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Très bien. Se promener et prendre en photo ce que l'on voit est un bon moyen de se détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "Cependant, je n'ai pas détecté de Daguerréotype sur vous. L'avez-vous laissé chez vous en sortant précipitamment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "Ah oui, on cherche de l'inspiration pour des photos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
