				{
					"id": 3740401,
					"content": "Que Barbatos vous bénisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740402,
					"content": "Bonjour ma sœur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "Ah, vous êtes la nouvelle recrue de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740406,
					"content": "Qu'est-ce qui vous amène par ici ? Jean vous aurait-elle confié une mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740411,
					"content": "En effet, nous devons réquisitionner Himmel la lyre sacrée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740413,
					"content": "Loin de moi l'idée de douter de vous, mais un jeune barde suspect est venu me demander la même chose juste à l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740414,
					"content": "Il a même eu l'audace d'essayer de se faire passer pour Barbatos. À mon avis, il trame quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740415,
					"content": "La lyre sacrée n'est utilisée que lors du Ludi Harpastum, les règlements sont stricts à ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740416,
					"content": "Il vous faut l'autorisation signée du Grand Maître de l'Ordre de Favonius, du sénéchal et du représentant des citoyens pour pouvoir l'emprunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740417,
					"content": "Puis-je voir l'autorisation de l'Ordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740418,
					"content": "La Grande Maîtresse n'en a pas fait mention...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "Je ne peux rien faire pour vous sans ce document.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740423,
					"content": "Si vous voulez bien m'excuser à présent, je suis très occupée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740419,
					"content": "Pardon, je crois bien que je l'ai oubliée au quartier général.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Paimon l'a mangée en route.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Je suis {NICKNAME}, chevalier honoraire de l'Ordre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "Je vous connais. C'est vous qui avez sauvé Mondstadt avec Amber l'autre jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				}
			]
		},
