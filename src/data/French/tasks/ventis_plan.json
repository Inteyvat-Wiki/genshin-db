			"dialogs": [
				{
					"id": 3740301,
					"content": "Hmph, elle ne s'est même pas retournée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Ce n'est pas grave, j'ai appris ce que je voulais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "La lyre sacrée est donc bien entreposée dans la cathédrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#{NICKNAME}, toi qui fais maintenant partie de l'Ordre de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "Si tu essayais pour voir ?",
					"roleType": "TALK_ROLE_NPC",
