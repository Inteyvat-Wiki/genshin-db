			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "Regarde et prends exemple !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740202,
					"content": "Bonjour ma sœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740203,
					"content": "Que Barbatos vous bénisse, jeune barde. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740204,
					"content": "Je détiens un secret qui pourrait sauver Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740205,
					"content": "Oh ? Béni soit Barbatos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740206,
					"content": "Vous devriez en parler à l'Ordre de Favonius, et non à une simple religieuse comme moi. Ils seront plus à même de vous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740207,
					"content": "Haha, c'est bien à vous que je souhaite m'adresser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740208,
					"content": "J'aimerais vous emprunter la... lyre sacrée. Je pourrais m'en servir pour aider Stormterror et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740209,
					"content": "Veuillez quitter ce lieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740210,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740211,
					"content": "Il ne fait aucun doute que ce dragon est vicieux, mais nul besoin de céder à la panique. Rien ne pourra se mettre en travers du chemin de la Grande Maîtresse une fois qu'elle aura pris sa décision, j'en suis sûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740212,
					"content": "Mais on ne peut pas laisser Stormterror mourir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740213,
					"content": "Cette vile créature a trahi Mondstadt. Barbatos lui-même ne saurait lui pardonner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740214,
					"content": "Hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740215,
					"content": "S'il vous plaît, laissez-moi l'emprunter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740216,
					"content": "Je ne peux rien faire pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740217,
					"content": "(Étrange. Je me sens coupable de refuser la demande de cet enfant si gentil...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740218,
					"content": "Bon, je vois que je n'ai plus le choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740219,
					"content": "Je ne me cacherai pas plus longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740220,
					"content": "Réjouissez-vous, mes disciples ! Le grand <color=#00E1FFFF>Barbatos</color> est de retour parmi vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740221,
					"content": "Vous devez être surprise, n'est-ce pas ? Émue, même, peut-être ? Qu'est-ce que ça fait de rencontrer l'Archon que vous vénérez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740222,
					"content": "Si vous n'avez rien d'autre à me demander, j'aimerais retourner à ma paperasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740223,
					"content": "Hé, attendez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
