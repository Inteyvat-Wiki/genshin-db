			"dialogs": [
				{
					"id": 711140901,
					"content": "*soupir* Peut-être que nous aurions dû filmer au Village de Qiaoying avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140902,
					"content": "Tout va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#Ah, {NICKNAME} et Paimon ! Nous avons pu tout récupérer grâce à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140905,
					"content": "Par contre, nous devrions peut-être engager des aventuriers pour nous accompagner la prochaine fois si nous revenons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140906,
					"content": "Hum, comment se passe votre tournage ? Vous savez, de votre documentaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Pour l'instant, nous avons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140908,
					"content": "... un bon début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "Et une super vision artistique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Vous n'avez donc rien filmé encore ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "*soupir* Nous sommes à court d'argent. Les cours de monsieur Geisert sont onéreux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140912,
					"content": "Même si nous avons tourné quelques courts-métrages qui nous ont rapporté un peu de moras, ce long-métrage épuisera notre budget en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140913,
					"content": "Surtout parce que la patronne a rejeté les offres de potentiels sponsors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "... ainsi que d'autres propositions de collaboration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Qu'est-ce que vous y comprenez de toute façon ? J'ai fait ça pour nous permettre de réaliser un film fidèle à notre vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140916,
					"content": "Mais patronne... Notre objectif de départ était de gagner de l'argent en tournant des films...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Je... Arrêtez de vous inquiéter pour l'instant ! Dépêchez-vous d'aller installer l'équipement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, voici votre récompense. Merci de toujours m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140919,
					"content": "Dès que j'aurais tourné mon film, je vous inviterai à son avant-première et à boire le thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng et Xingye, assurez-vous de trouver le meilleur angle pour l'éclairage ! On va faire ça en une prise, c'est compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140921,
					"content": "Mais patronne, nous n'avons encore aucun acteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "N'est-ce pas la chance qui décide si une scène peut-être tournée en une seule prise...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "Allez, dépêchez-vous d'installer le matériel et attendez ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140903,
					"content": "On dirait que vous n'avez pas perdu d'équipement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
