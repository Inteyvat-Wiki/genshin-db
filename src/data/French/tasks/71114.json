			"dialogs": [
				{
					"id": 711149940,
					"content": "Après avoir chassé les Pilleurs de trésors, vous amenez les personnes qu'ils avaient piégées dans un pavillon à proximité pour qu'elles reprennent leur souffle.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Merci du fond du cœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140802,
					"content": "Madame Qiu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#Ah... C'est vous, {NICKNAME} ! Quelle coïncidence ! C'est la deuxième fois que vous me rendez un grand service !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140804,
					"content": "Vous n'étiez pas en train d'apprendre à tourner des films à Fontaine ? Comment se fait-ce que vous soyez déjà rentrés à Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "Vous savez comment réaliser des films maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Hum, disons plutôt que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "... Nous avons eu besoin de renflouer un peu nos caisses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140809,
					"content": "Monsieur Geisert est un maître de la réalisation et nous avons énormément appris de lui, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "Les films sur lesquels il nous a apporté son aide se focalisaient sur de grandes idées. Le scénario et le cadre ont été, comment dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "« Passés au second plan », comme dirait monsieur Geisert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Nous nous étions lancés dans la réalisation de films pour promouvoir les thés d'exception du Vallon Chenyu. Continuer notre apprentissage auprès de monsieur Geisert nous aurait menés nulle part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Du coup ! J'ai pris la décision d'interrompre cet apprentissage pour revenir ici tourner un documentaire. Ce sera l'occasion de mettre en application nos connaissances !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140814,
					"content": "... Nos finances ne sont aussi pas au beau fixe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "Je vous ai déjà expliqué mon plan, non ? Si ce documentaire fait un carton, notre investissement sera rentabilisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140816,
					"content": "#On s'est aussi retrouvés piégés par des Pilleurs de trésors sur le pont suspendu, mais heureusement que {NICKNAME} a volé à notre rescousse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "Nous sommes un peu loin du Village de Qiaoying, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "*soupir* Je voulais capturer de splendides paysages pour rendre le documentaire plus impressionnant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140820,
					"content": "Malheureusement, nous avons été un peu trop distraits par le tournage et attiré l'attention de ces Pilleurs de trésors. Nous nous sommes enfuis jusqu'ici, mais ils nous ont rattrapés malgré tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140821,
					"content": "Attendez, ça veut dire que les « photographes professionnels » dont mademoiselle Woliu nous a parlé tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Oui, il s'agissait de madame Qiu et de ses assistants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "D'où est-ce que vous sortez, mademoiselle Woliu ? Je ne vous ai même pas vue venir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140824,
					"content": "Je m'étais juste très bien cachée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Vous vous connaissez donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Mademoiselle Woliu est une hydrologiste experte. Personne ne connaît mieux la topographie des environs qu'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140827,
					"content": "Nous l'avons consultée plusieurs fois pour qu'elle nous recommande des lieux où tourner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140828,
					"content": "Nous avons même essayé de la persuader de rejoindre notre groupe ! Mais elle a dit qu'elle y réfléchirait plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140829,
					"content": "Patronne, quand nous nous sommes enfuis tout à l'heure... Nous avons laissé la boîte qui contient tout notre équipement là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "Et je crois que tous nos travaux s'y trouvent aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140832,
					"content": "#Mademoiselle Woliu ! {NICKNAME} ! Paimon ! Merci pour tout et venez me voir au Village de Qiaoying quand vous le pourrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140833,
					"content": "Vous nous avez sauvé la vie après tout. Je vous préparerai une récompense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140834,
					"content": "Mais pour l'instant, nous devons y aller ! Dépêchons-nous ! Où avons-nous laissé cette boîte ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 711140835,
					"content": "Madame Qiu et ses assistants partent précipitamment...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Cette boîte a dû traverser beaucoup d'épreuves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Ils voient enfin la lumière au bout du tunnel. Je suis certaine que le film de madame Qiu sera une réussite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "En tout cas, voici votre récompense. Je vais installer le dernier instrument tout de suite, avant d'aller voir madame Qiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Je vais devoir la retrouver vite, sinon qui sait où elle ira pour son tournage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Mais bon, elle a bien dit qu'elle serait au Village de Qiaoying. J'irai voir ça plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
