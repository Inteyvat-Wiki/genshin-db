				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "... Ces réglages devraient convenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "Vous avez installé tous les instruments ? Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Je vous remettrai votre récompense une fois que j'aurai terminé l'installation de celui-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Vous auriez pu me le donner avec les autres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "C'est gentil, mais malheureusement celui-ci est spécial. Il faut procéder à des ajustements supplémentaires et je ne voulais pas vous embêter avec ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Allons sur la falaise là-bas pour le placer et je vous donnerai votre récompense ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "J'ai l'impression que c'est compliqué... Vous avez toujours travaillé comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Haha, je n'ai qu'à installer mes instruments au sol. Lors d'un précédent déplacement, j'ai dû réfléchir à une solution pour en mettre un au milieu d'une rivière déchaînée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Vous ne pouviez pas emprunter un bateau pour le faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Je l'aurais fait s'il n'y avait qu'à le laisser tomber dans l'eau et partir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Mais mon objectif était de mesurer l'intensité du flux d'eau. Il fallait donc maintenir l'instrument en place au cœur du flux pour éviter qu'il ne remonte à la surface ou qu'il ne coule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Heureusement, il y avait un pont suspendu au-dessus de la rivière. Sans lui, j'aurais dû demander à des gens de bien vouloir m'aider à installer des cordes entre les deux montagnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Pour ensuite accrocher l'instrument sur l'une d'entre elles, le faire bouger jusqu'au centre la rivière avec une autre et le descendre dans l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Bref, n'en parlons plus. On n'aura pas affaire à ce genre de situation de toute façon... Ceci dit, il faudra quand même traverser un pont suspendu pour arriver à notre destination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Par ici, il n'est pas très loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
