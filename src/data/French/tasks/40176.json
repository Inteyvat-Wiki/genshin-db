			"dialogs": [
				{
					"id": 401730501,
					"content": "#Hm ? Tu me cherchais, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730502,
					"content": "Je dois bientôt rendre l'épée de cérémonie au chef. Mais je vais laisser tout le reste tel quel dans le camp pour l'instant. N'hésite pas à t'en servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730503,
					"content": "#Euh... J'ai le dernier volume des «{NON_BREAK_SPACE}Guerriers du mirage »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730505,
					"content": "... Avec une édition spéciale dérivée de « L'affaire de mademoiselle Orith ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730507,
					"content": "Vous voulez qu'on les lise ensemble ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730509,
					"content": "#(Que se passe-t-il ? Comment sait-{M#il}{F#elle} que j'adore ces livres ? Ne me dis pas... qu'{M#il}{F#elle} s'est {M#renseigné}{F#renseignée} sur mes centres d'intérêt ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730510,
					"content": "(Non, c'est ridicule, ne sois pas bête... Je parie que c'est Ororon qui lui a dit, ce garnement...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730511,
					"content": "#(Mais... {M#Il}{F#Elle} s'en est {M#souvenu}{F#souvenue} ? En fait, ça n'a pas vraiment d'importance, ce n'est pas ce qui me définit après tout...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730512,
					"content": "#(Ce sur quoi je devrais me concentrer, c'est qu'{M#il}{F#elle} vient de m'inviter à passer du temps ensemble ! Que dois-je faire ? Comment dois-je répondre ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730513,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730514,
					"content": "Bien sûr, pourquoi pas. Je devrais avoir un peu de temps libre plus tard. Je te dirai quand ça m'arrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
}