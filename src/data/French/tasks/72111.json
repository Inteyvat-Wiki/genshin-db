			},
			"dialogs": [
				{
					"id": 721110601,
					"content": "Qu'est-ce que c'est ? Je ne peux pas le lire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110602
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110602,
					"content": "#N'essayez pas de m'avoir, jeune {M#homme}{F#fille} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110603
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110603,
					"content": "Voilà ce qu'on a trouvé près des restes d'un chariot...",
					"roleType": "TALK_ROLE_PLAYER",
