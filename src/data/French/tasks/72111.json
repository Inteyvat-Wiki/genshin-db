			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "Une bourse de moras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110202,
					"content": "C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110203,
					"content": "... Elle appartient à ma famille. Il n'y a rien d'étrange à cela. C'est vrai, c'est tout à fait normal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110204,
					"content": "Il est tellement méfiant ! Quelque chose ne colle pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110205,
					"content": "D'accord, alors dessinez la marque qui était dessus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110211,
					"content": "Très bien. Ce n'est pas ma bourse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110212,
					"content": "Avec tous les gens qui vont et viennent dans mon jardin, il n'est pas rare que quelqu'un laisse quelque chose derrière lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110213,
					"content": "C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110214,
					"content": "Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "*soupir* Très bien, vous m'avez eu. J'étais simplement tenté de garder la bourse pour moi, vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110216,
					"content": "Oh Densuke, comment un vieillard comme toi peut-il avoir de telles pensées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110217,
					"content": "Quelque chose me paraît bizarre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "Je—J'ai déjà avoué avoir essayé de voler les moras. Qu'est-ce qu'il pourrait y avoir d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110220,
					"content": "Allons, je vais remettre cette bourse au Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110221,
					"content": "Il y a quelque chose qui cloche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110222,
					"content": "La bourse a été délibérément abandonnée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "Qu—Quelle preuve vous avez pour avancer une chose pareille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110228,
					"content": "La bourse n'est qu'une partie du mystère. On a également trouvé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110229,
					"content": "#... Trouvé quoi ? Allez, c'est à vous, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME}, qu'est-ce qu'on a trouvé dans le ravin plus tôt...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110231,
					"content": "Voilà ce qui a été laissé intentionnellement un soir de pluie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "Tu réfléchis trop, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(C'est pas vrai ! {NICKNAME}, est-ce que tu penses vraiment que grand-père Densuke n'en avait qu'après les moras ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110225,
					"content": "(Je pense qu'il cache autre chose, non ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110226,
					"content": "La bourse a été délibérément abandonnée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "Vous cachez quelque chose d'autre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "Pouvez-vous m'indiquer le nombre de moras qu'elle contient ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "Haha, c'est quoi cette question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110208,
					"content": "Vous n'avez aucun moyen de savoir combien de moras il y avait dedans sans l'ouvrir, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110209,
					"content": "D'accord, alors dessinez la marque qui était dessus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
