			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "#Que puis-je faire pour vous, jeune {M#homme}{F#fille} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110102,
					"content": "On a trouvé la preuve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Une preuve ? Quelle preuve ? Je ne comprends pas de quoi vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110104,
					"content": "La preuve qu'il se passe des choses étranges au village. Arrêtez de faire semblant de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110105,
					"content": "Vous vous moquez de moi ! Quel genre de choses étranges pourraient bien se passer dans notre village ? Bon, montrez-moi ce que vous avez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110106,
					"content": "#(Hé, {NICKNAME}, commence par ce qu'on a trouvé près du puits. Je te laisse faire !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110107,
					"content": "Voilà ce qu'on a trouvé dans le puits asséché au fond de votre jardin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
