			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "C'est... C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "Je ne peux pas croire que j'ai été aussi négligent quand j'ai détruit la charrette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "Ah, enfin, vous admettez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "Vous avez déjà tellement avancé dans votre enquête que je ne peux pas le cacher plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "Vous devriez avoir une assez bonne idée de ce qui s'est passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "Une très bonne idée en effet ! Grand-père Densuke, vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Vous avez essayé de voler un chariot du Shogunat, n'est-ce pas ? Et au cours de la lutte, vous avez détruit le chariot d'un seul coup de poing, en envoyant voler les sacs de marchandises dans le ravin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "Les hommes du Shogunat ont tenté de sauver leur vie en jetant leurs bourses de monnaie dans le puits pour vous distraire ! Et vous avez verrouillé le puits pour empêcher d'autres personnes de voler les moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Hein ? Non, ce n'est pas du tout ce qui s'est passé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Vraiment ? J'allais vous demander la clé pour récupérer ces moras au fond du puits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "... Et les rendre au Shogunat ! Oui, bien sûr ! Les rendre au Shogunat, évidemment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "*soupir* Eh bien, voilà ce qui s'est réellement passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "Il y avait un groupe de jeunes au village qui est devenu un peu trop échauffé après avoir bu et a volé l'un des chariots de chargement du Shogunat. Ces marchandises et les sacs appartiennent au Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "Je ne voulais pas que d'autres soient au courant de cet incident honteux. C'est pourquoi j'ai essayé de le couvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "Qu'en est-il de votre aveu concernant la bourse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "Il l'a fait pour cacher la vérité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "C'est exact. Je pensais que vous arrêteriez l'enquête une fois que j'aurais avoué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "Tant que personne d'autre n'était affecté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "S'il vous plaît, s'il vous plaît, ne dites rien au Shogunat. Il ne s'agit pas pour moi de sauver la face. J'ai peur que notre village tout entier soit impliqué dans cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "Je n'ai aucun intérêt à vous dénoncer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "#Ouais, on n'est pas {M#venus}{F#venues} ici pour vous dénoncer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "C'est bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "Je n'avais pas la conscience tranquille, alors j'ai tout noté dans un journal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "J'ai jeté les notes sur le toit. Si vous voulez vraiment les lire, vous pouvez aller les chercher, mais faites attention à ma toiture, je viens de la rénover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "À propos du verrou sur le puits...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Oui, c'est moi qui ai verrouillé le puits. J'ai aussi noté l'endroit où j'ai caché la clé dans mes notes. Vous pourrez voir par vous-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Grand-père Densuke, est-ce que vous savez quelque chose à propos de la barrière du Village de Konda ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "La barrière ? Oh, il y a donc encore des gens qui connaissent cette vieille légende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "On raconte que dans les temps anciens, il y avait une racine de cerisier tonnerre sous le sol-même où nous nous trouvons. C'était l'une des cinq racines qui préservaient la paix sur l'Île de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "Et la garder, ainsi que sa barrière, est la responsabilité qui a été confiée par la Kitsune Saiguu au Clan Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "Mais ça fait tellement longtemps que je me souviens à peine des détails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "J'essaye juste de découvrir la vérité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "#Ouais, on n'est pas {M#venus}{F#venues} ici pour vous dénoncer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "La vérité ? Héhé... Vous, les jeunes d'aujourd'hui, vous êtes vraiment spéciaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
