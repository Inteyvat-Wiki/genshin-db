					"content": "#N'essayez pas de m'avoir, jeune {M#homme}{F#fille} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110503,
					"content": "Voilà ce qui a été laissé intentionnellement un soir de pluie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211106,
