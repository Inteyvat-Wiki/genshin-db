					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "Je suis Izzard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630312,
					"content": "Je me dois de vous remercier au nom des Pilleurs de trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630313,
					"content": "Oh non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630314,
					"content": "Comment ça se fait ? On a rien dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630315,
					"content": "Pourquoi ça ne m'étonne pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "Grr ! Il va falloir nous passer sur le corps si vous voulez ce trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630317,
					"content": "Vous ne devriez pas nous sous-estimer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630318,
					"content": "Un ordre de ma part et mes acolytes débarquent pour vous refaire le portrait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630319,
					"content": "Malheureusement pour vous, j'ai bien peur qu'ils ne soient pas aussi sympas que moi, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630320,
					"content": "(Kaeya et ses hommes entrent en scène)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630321,
					"content": "Désolé de casser l'ambiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630322,
					"content": "C'étaient tes amis à l'extérieur ? Quel dommage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630323,
					"content": "Tu pourras leur rendre visite... à la prison de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630324,
					"content": "Tu pourras même partager une cellule avec eux. Pas mal, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630325,
					"content": "Les Chevaliers ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630326,
					"content": "C'est Kaeya !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630327,
					"content": "Cet individu veut voler votre trésor ! Attrapez-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630328,
					"content": "Tsss, j'y étais presque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630329,
					"content": "Tu veux parler du trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630330,
					"content": "Rassure-toi, il n'existe pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630331,
					"content": "Mes pauvres, vous avez fait tout ce chemin pour rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630332,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630333,
					"content": "Pas de trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630334,
					"content": "Quoi ? Pas de trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630335,
					"content": "Haha, vous m'avez bien eu. Je ne pensais pas que l'Ordre de Favonius utiliserait ce genre de méthode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630336,
					"content": "C'est l'hôpital qui se moque de la charité... Hé, mais qu'est-ce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630337,
					"content": "Comme si j'allais me laisser faire aussi facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630338,
					"content": "Quoi ?! Qu'est-ce que... J—Je ne voulais pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630308,
					"content": "... Quelqu'un du marché noir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630309
					]
				},
				{
					"id": 4630309,
					"content": "Haha, je faisais affaire avec eux, il fut un temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630310
