							4735.029
						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Ça te revient, Qiqi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Oh... Euh... Je suis désolée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Pas besoin de t'excuser, ce n'est rien. Il reste encore un peu de chemin jusqu'au Palais Mermonia, allons-y. Peut-être que tu te souviendras où tu habites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME}, regarde, c'est Qiqi ! Et il y a aussi une mélusine. C'est rare de voir ça{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Ah ! {NICKNAME} et... Pa... Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Vous connaissez Qiqi ? Formidable ! Je l'ai croisée lors de mon enquête près du Port de Lumidouce... À en juger par sa taille, j'ai pensé que c'était une enfant humaine... C'est bien une enfant, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "J—Je suis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "Notre bonne amie !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "#Oui, oui ! On se connaît depuis longtemps. Nous sommes les {M#meilleurs amis}{F#meilleures amies} du monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Héhé ! Bonne réaction ! Si Qiqi avait dit qu'elle était un zombie, ça aurait pu faire une peur bleue à cette mélusine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "#Oui... Les {M#meilleurs amis}{F#meilleures amies}... C'est ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Eh bien, c'est vraiment une heureuse coïncidence. Pour être honnête, c'est la première fois que je me retrouve complètement désemparée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Je suppose que vous êtes au courant de ses problèmes de mémoire ? Elle semble à peine capable de se souvenir de quoi que ce soit à part son propre nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "Qiqi est comme ça parfois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Pauvre petite. J'avais l'intention de la ramener à la Maréchaussée fantôme et de la laisser y séjourner un moment, mais j'espérais qu'elle pourrait retrouver une partie de sa mémoire en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "#Puisque vous êtes de si {M#bons amis}{F#bonnes amies}, je suppose que vous savez où elle habite ? Cela m'éviterait bien des complications si je pouvais la ramener directement chez elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "On sait... Mais c'est, euh, très loin d'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Très... loin...? J'ai suivi une Fée jusqu'au Port de Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Hein ? Tu te souviens de quelque chose ? Qu'est-ce qui s'est passé avant ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Avant... ça... Monsieur Baizhu m'a emmenée faire sa tournée au Port Yi... Euh, Yi-quelque chose... Je suis allée cueillir des herbes, et ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Oh ! Baizhu t'a emmenée au Port Yilong, c'est ça ? La détective Paimon pense savoir ce qui s'est passé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu a emmené Qiqi rendre visite à des patients au Port Yilong. Elle s'est perdue en cueillant des herbes, a aperçu une Fée et l'a suivie jusqu'au Port de Lumidouce !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Heureusement que {NICKNAME} et moi avons lu «{NON_BREAK_SPACE}Robben contre Chesterton{NON_BREAK_SPACE}» ensemble. C'est un jeu d'enfant pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Tu sais que l'histoire était complètement fictive, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Aha ! Eh bien, c'est logique ! Je vais ramener Qiqi au Port Yilong immédiatement. Ce monsieur Baizhu est le tuteur de Qiqi, c'est ça ? Il doit être mort d'inquiétude !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Attendez... Ces personnes dans la prophétie de Barbeloth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Oh, tu as raison ! J'ai failli l'oublier. Barbeloth, vous êtes là ? Vous nous entendez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Inutile de crier. J'ai toujours été là. Je ne voulais simplement pas interrompre votre conversation. Écouter est l'état naturel de toute bonne divinatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "#La direction de cette Fée peut également être considérée comme l'orientation du destin. Héhéhé... Puisque tu es là, Qiqi, que dirais-tu si je lisais ton avenir{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Mon... avenir...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Oh là là, Barbie, permets-moi d'intervenir. Tu n'es vraiment pas douée pour parler aux enfants, tu sais... tu fais peur à cette pauvre petite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Laisse-moi m'en occuper. Maintenant, écoute bien. Voici comment on offre un petit cadeau surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "Ahem, petite Qiqi, membre du Petit Hexenzirkel, je suis la mère de ton alliée Klee, tatie Alice, la plus grande sorcière du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Enchantée, tatie Alice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Quelle enfant adorable et polie. Viens maintenant, laisse l'amie de tatie, une autre grande sorcière, t'offrir une merveilleuse fête-surprise de divination !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Une fête-surprise... de divination ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "C'est exact ! Regarde les cartes devant toi. Elles sont jolies, non ? Tu les aimes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Je... les aime bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "C'est merveilleux ! Tu peux en choisir une pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Euh... Celle-ci, ça ira ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Bien sûr. Et comme tu t'es montrée si sage, cette carte est à toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "... M—Merci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Bon, Barbie, la pause est terminée. Viens lire la carte de la petite Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Pas besoin de me secouer pour me réveiller. J'écoutais depuis le début... Ah, la carte « Le Pendu » à l'endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Très peu de gens tirent cette carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Cela signifie que tu es très spéciale, Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Il symbolise la transcendance et l'attente, ainsi que le détachement du monde quotidien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Il y a des chaînes qui te retiennent, mais tu n'as toi-même aucun désir de t'en libérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Des chaînes... Vous voulez dire... mes ordres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Au moins en surface, tu n'aurais pas tort de comprendre les choses de cette manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Quant à ton avenir, il te suffit d'attendre. Bien sûr, ce n'est pas comme si le temps te manquait... Mais... Oh là là, comme c'est étrange, vraiment très étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Attends un peu ! Tu en dis trop d'un coup... Laisse cette pauvre enfant respirer un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Laisse d'abord Qiqi savourer son petit cadeau. Il faut faire preuve d'un peu plus de patience avec les enfants, leur laisser plus de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "Qu'en penses-tu, Qiqi ? Ta surprise te plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Cette carte est très jolie... Merci, tatie Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Oh, tu es gentille. Tu as bien retenu le nom de ta tatie. J'aurais aimé discuter encore avec toi, mais il est temps pour toi de rentrer à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Si tatie Barbie a encore des choses à dire, alors la prochaine fois que le Petit Hexenzirkel se réunira, elle pourra dire une prophétie pour chaque petite sorcière présente ! Ce serait merveilleux, non ?",
