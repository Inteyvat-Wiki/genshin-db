						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "Pfiou... C'est enfin terminé ? Ces deux voix venaient bien de cette poupée ? Quel genre de jouet c'est ? Elle est trop mignonne, où est-ce que je peux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Non ! Ce n'est pas le moment de penser à ça. Qiqi, allons voir ce monsieur Baizhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#... Oui, je dois rentrer. À la prochaine... Au revoir, {NICKNAME} et Paimon.",
