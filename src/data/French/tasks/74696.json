					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "... Tu pourrais éviter de me rajouter du travail sans me demander mon avis d'abord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "Alors c'est décidé ! À la prochaine, Qiqi et tous les témoins.",
