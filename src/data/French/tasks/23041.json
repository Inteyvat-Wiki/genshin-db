			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "*sniff* Des feuilles ont encore été mangées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "#Regardez, {M#voyageur}{F#voyageuse} ! Encore ce chaton qui vient manger mes fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Regardez cette feuille, celle-ci... et celle-là ! Elles ont toute été mangées par ce chaton !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "Il a faim ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Raef dit ça, lui aussi. Il se balade partout avec des croquettes sur lui pour donner à manger aux chats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "Mais même après avoir été nourri, ce chaton revient le lendemain pour manger mes fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "Pour l'instant, il ne fait que manger les feuilles, mais j'ai peur qu'un jour, il ne se mette à manger les tiges... Ça sera une catastrophe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "Mais bon, je n'ai pas le cœur à le chasser. Il n'y a que du désert en dehors du village, et il n'a nulle part où aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "#{M#Voyageur}{F#Voyageuse}, pouvez-vous m'aider à le nourrir ? J'espère qu'en ayant le ventre plein, il n'aura plus pour idée de manger mes fleurs. En plus, les feuilles des fleurs n'ont rien de très savoureux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "#Je vous laisse vous en occuper alors, {M#voyageur}{F#voyageuse}. Donnez-moi votre carte, je vais vous indiquer les endroits où il aime aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Quant à moi, je vais rester ici pour surveiller ce pot avant qu'un autre chaton ne vienne manger mes fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "Je sais très bien m'y prendre avec les chats.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Tant mieux ! Quand je vois les pattes de ce chaton, j'ai peur qu'il se jette soudainement sur moi et qu'il me griffe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Ce chaton... Il aime manger les fleurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Je ne comprends pas ce qui l'amuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304103,
