			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "Pfiou... La terre devrait être bien ameublie maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410102,
					"content": "Vous êtes encore en train de vous occuper de ce pot de fleur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Oui, mamie Kulsoom m'a appris beaucoup de choses sur la culture des fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410104,
					"content": "Par exemple, on doit ameublir la terre, tailler régulièrement les feuilles, éliminer les insectes de diverses manières...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410105,
					"content": "Mais il ne faut pas les arroser trop souvent, sinon les racines seront noyées dans l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410106,
					"content": "Et moi qui pensais que l'on devait arroser les fleurs tous les jours pour que la terre soit toujours humide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410107,
					"content": "Au moins, ça m'épargne la peine d'aller chercher de l'eau tous les jours. Le puits est très loin d'ici, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410108,
					"content": "#Je dois continuer à les tailler. {M#Voyageur}{F#Voyageuse}, pourriez-vous aller me chercher un peu d'eau dans un pot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410109,
					"content": "J'en ai parlé à Kazan. Il m'a autorisée à prendre de l'eau pour arroser les fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410110,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "L'arrosoir est là. Faites attention à ne pas ramasser trop de boue quand vous puisez l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410111,
					"content": "C'est mamie Kulsoom qui vous a appris tout ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Eh bien... Presque. Mamie Kulsoom sait beaucoup de choses et je lui demande souvent des conseils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410113,
					"content": "#Je compte sur vous, {M#voyageur}{F#voyageuse}. Un petit pot d'eau suffira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304102,
