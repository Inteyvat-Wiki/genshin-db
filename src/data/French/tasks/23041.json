				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous tombez à pic ! Goûtez un peu ça, c'est une soupe de pois-menthe que j'ai préparée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "D'où viennent les ingrédients ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "J'ai demandé à quelqu'un de me les procurer. Quant à la menthe... Je l'ai cultivée moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Raef m'a donné un kit d'outils de jardinage et un tas d'engrais, vous vous souvenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "J'ai pensé que ce serait du gaspillage de ne planter que des fleurs dans un pot... Alors j'ai demandé à Azalai de m'acheter des graines de menthe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Je les ai plantées, puis les ai entretenues de la même manière que je l'ai fait pour ces fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "Je m'en suis bien occupée, et elles ont poussé doucement, jusqu'à devenir mûres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "Donc, j'en ai cueilli pour faire une soupe de pois-menthe. Alors ? C'est pas mal, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Alors... Puisque vous avez goûté ma soupe de pois-menthe, vous me devez une faveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Mais je n'ai même pas fini de la manger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Non, attendez ! Je plaisantais, je vous récompenserai comme il se doit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "Je voudrais que vous m'aidiez à collecter trois pêches zaytuns. C'est le fruit préféré de Raef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410315,
					"content": "Je veux les préparer avec ma soupe de pois-menthe et l'offrir à Raef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410316,
					"content": "Je sais déjà comment cuisiner une soupe de pois-menthe, il ne me manque que les pêches zaytuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410317,
					"content": "J'ai compris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Merci beaucoup. Je vous offrirai un autre bol de soupe de pois-menthe à votre retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410321,
					"content": "#Je compte sur vous, {M#voyageur}{F#voyageuse}. Revenez me voir une fois que vous aurez trouvé les pêches zaytuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410319,
					"content": "Il peut manger de la soupe pendant son travail ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Ça ira, c'est juste un peu de soupe, il n'est pas toujours occupé à son travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410312,
					"content": "Je vous la rends tout de suite !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
