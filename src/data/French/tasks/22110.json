				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "Vous en avez fini avec ce Chasseur des ruines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Propre et efficace. Si j'avais le moindre doute sur vos capacités, ils se sont envolés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "... Toujours rien sur l'épée ? *soupir* Je déteste le dire, mais je m'y attendais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "#Ne vous inquiétez pas. Je vous ai {M#envoyé}{F#envoyée} sur toutes sortes de missions et à chaque fois, vous revenez en les ayant accomplies. Alors merci pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "Où est-ce que cette épée peut-elle bien être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Nous la trouverons un jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "C'est gentil d'essayer de me consoler, mais ne vous en faites pas. Il en faut plus pour me décourager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Je trouverai cette épée un jour, peu importe quand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Il faut que je continue d'élargir mon périmètre de recherche. Bien sûr, je compterai sur vous pour m'aider de nouveau avec une récompense à la clé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Voici votre paiement. Je file, j'ai une nouvelle liste de missions à vérifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "... Cette épée ne pourra pas m'échapper éternellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Ces missions n'ont vraiment rien à voir avec cette épée de toute façon, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "C'est parce que j'ai déjà terminé toutes les missions en rapport direct avec une épée, mais sans succès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Puis j'ai pensé... Pour que mon frère en arrive à être séparé de son épée, il a dû être confronté à des circonstances particulièrement dangereuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "C'est pour cette raison que j'ai commencé à accepter des missions dangereuses dans l'espoir qu'elles me mènent à l'épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "Cependant, il y en a trop pour que je puisse toutes les faire moi-même. C'est pourquoi j'ai besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
}