				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100201,
					"content": "Vous en avez fini avec ce Chasseur des ruines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Prenez votre temps. Il faut être bien préparé avant d'affronter un Chasseur des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
