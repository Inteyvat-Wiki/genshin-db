			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Tout ça n'a pas de sens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "... Vous n'avez vraiment rien à faire, n'est-ce pas ? Soit vous êtes trop efficace dans ce que vous faites, soit au contraire vous ne l'êtes pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Non, vous ne pouvez pas être faible si vous avez réussi mes deux précédentes missions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "J'en ai une autre à vous confier si vous avez un peu de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "#Cette fois, j'aimerais que vous éliminiez un Chasseur des ruines. {M#Tenté}{F#Tentée} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "Quelle confiance en vous ! Vous me rappelez mon frère... Qui sait quel genre d'exploits vous accomplirez plus tard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "Bien. La cible se trouve dans les Plaines Guili. Préparez-vous et venez à bout de ce Chasseur des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Une fois que vous l'avez eu, n'oubliez pas de chercher des indices liés à l'épée, quoi que ce soit, ramenez-le-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "... Et s'il n'y a rien, contentez-vous de revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Bonne chance avec cette mission et... J'espère que cette fois, les recherches s'avéreront plus fructueuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Il faudra encore garder l'œil ouvert pour une éventuelle trace de l'épée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Oui, s'il vous plaît. Lorsque vous aurez vaincu le Chasseur des ruines, recherchez une épée ou tout objet s'y rapportant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Je dois vous avertir que les Chasseurs des ruines sont des adversaires coriaces. Vous devez les garder à l'œil en permanence si vous souhaitez les vaincre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "#Et en ce qui concerne l'épée, ce serait merveilleux si vous trouviez quelque chose, mais ne vous inquiétez pas si vous ne trouvez rien. Vous serez {M#rémunéré}{F#rémunérée} si vous vainquez le Chasseur des ruines de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2211002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
