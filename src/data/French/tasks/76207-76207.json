			"dialogs": [
				{
					"id": 762070201,
					"content": "#Ah... J'étais autrefois le langage, mais je suis désormais devenu l'hôte d'une illusion brisée, retournant à ce «{NON_BREAK_SPACE}symbole{NON_BREAK_SPACE}» imparfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "#Ouah{NON_BREAK_SPACE}! Un type étrange vient de surgir d'un livre bizarre en disant des trucs incompréhensibles{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "#«{NON_BREAK_SPACE}Bizarre{NON_BREAK_SPACE}» est une expression imprécise. Elle implique une entité unique qui ne peut être décrite, ni écrite ou représentée, et je ne corresponds manifestement pas à cette définition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "#J'ai simplement tenté de fouiller dans les pages pour trouver l'entrée vers le «{NON_BREAK_SPACE}réel{NON_BREAK_SPACE}», mais j'ai glissé par inadvertance dans une métaphore infiniment différée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Je suis devenu le résidu qui ne peut être symbolisé, mais grâce à votre intervention, j'ai pu être arraché à la tyrannie du langage et recommencer à me méconnaître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Parlez normalement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "... Je suis tombé accidentellement dans les pages du livre et je n'arrivais plus à en sortir, merci de m'avoir tiré de là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
