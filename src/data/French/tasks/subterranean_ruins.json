				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(En traversant le mur de lumière, j'ai eu l'impression que tout mon corps était gelé.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Je suppose que la protection du seigneur de la nuit ne peut pas atteindre cet endroit. Le froid et l'obscurité sont étouffants. Tout ce que j'entends, ce sont des cris d'épuisement et de douleur.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Depuis combien de temps ces âmes sont-elles tourmentées ? Et combien de temps cela va-t-il encore durer...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Hein ? Cette personne...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Même si notre patrie n'est plus qu'un lointain souvenir, les flammes de la guerre continuent de faire rage. Nous avons depuis longtemps versé notre dernière goutte de sang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "Capitano"
				},
				{
					"id": 50220706,
					"content": "Restez forts, soldats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "Capitano"
				},
				{
					"id": 50220707,
					"content": "(Qu'est-ce que Capitano fait ici ? Et qu'est-il en train de dire...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Un jour, je vous amènerai là où je vous ai promis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capitano"
				}
			]
		},
