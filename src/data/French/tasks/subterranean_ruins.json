			"dialogs": [
				{
					"id": 50220801,
					"content": "Bonjour ! Tu as fait un cauchemar la nuit dernière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "#Je t'entendais gigoter et te retourner sans cesse dans ton sommeil. Tu es peut-être {M#nerveux}{F#nerveuse} à cause de la bataille finale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(C'était donc un rêve ? Je m'en souviens à peine.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Tout ce qui s'est passé semble si confus. Quand j'essaye de m'en souvenir, je commence à avoir mal de tête...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "#Ressaisis-toi, {NICKNAME} ! Nous sommes {M#censés}{F#censées} retrouver Mavuika aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
