			"dialogs": [
				{
					"id": 50220401,
					"content": "(Où suis-je ? Serait-ce... le Fief nocturne ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "#(Comment suis-je {M#arrivé}{F#arrivée} ici ? J'étais simplement... Argh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(J'ai la tête qui tourne et je n'arrive pas à penser clairement. Je vais essayer d'explorer les lieux...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
