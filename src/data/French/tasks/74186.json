				]
			},
			"dialogs": [
				{
					"id": 741860301,
					"content": "Dominus Cassiodor, dominus Cassiodor... C'est vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "Mais oui, c'est bien vous ! Vous êtes enfin de retour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860304,
					"content": "On m'a ordonné de garder cette forteresse, mais l'offensive de ces cruels Élémentosaures et de ces barbares était vraiment violente... Je n'ai donc pas eu d'autre choix que de me réfugier ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860305,
					"content": "On dirait que d'innombrables années se soient écoulées depuis... Quelle est la situation à l'extérieur ? Avons-nous gagné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "... Ah, cela signifie que nous avons perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860308,
					"content": "Je suis désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Ne dites pas ça, cher dominus. J'avais déjà imaginé ce jour lorsque j'ai rejoint les légions de Sa Majesté le sébaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860310,
					"content": "Le sébaste a dit un jour qu'il nous amènerait à briser les chaînes de la Fortuna, mais est-ce vraiment aussi simple ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860311,
					"content": "Après tout, c'est le destin contre lequel nous nous battons. Même les grandes divinités ne peuvent pas y échapper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860312,
					"content": "Et en fin de compte, tous nos efforts ont été vains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Non, dominus. Nous avons brandi nos épées contre le destin et nos actions ont défié les lois célestes. Nous nous sommes battus contre cette prophétie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860314,
					"content": "Même si nous avons échoué... Quelqu'un a dû nous trahir et nous conduire sur la mauvaise voie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860315,
					"content": "Mais le résultat n'a plus d'importance. Quoi qu'il en soit, nos actions seront gravées dans l'« histoire » de ce monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Golem anonyme"
				},
				{
					"id": 741860316,
					"content": "Hé ! Il est tombé ? Les gens pétrifiés peuvent-ils s'évanouir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Je ne connais même pas son nom... On dirait que son « histoire » touche à sa fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "C'est vraiment trop triste ! Est-ce qu'il est ici à combattre depuis des millénaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Mais maintenant, il a finalement trouvé la paix. Continuons d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}