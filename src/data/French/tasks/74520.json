					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#Ah, {NICKNAME}, je ne m'attendais pas à vous croiser dans un endroit pareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Ça faisait longtemps, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Ce n'est qu'une patrouille de routine. Mais pour moi, c'est avant tout une nécessité pour rester en condition de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "Ces derniers temps, Mondstadt est relativement paisible, il n'y a pratiquement aucune menace qui nécessite la mobilisation complète de l'unité de reconnaissance. Le mental de l'équipe... s'est visiblement relâché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "L'équilibre travail-vie, c'est aussi une bonne chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Certes, mais en tant que capitaine, je me dois d'entretenir mes capacités de combat en permanence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Après tout, les lames de nos ennemis ne s'émoussent pas en temps de paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "C'est pourquoi j'ai pris l'habitude, entre mes rondes, de trouver un endroit tranquille pour m'entraîner à l'épée et m'assurer de ne pas perdre la main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "C'est le moment parfait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "Oh ? Voilà une demande intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "#Mais je suis rapide dans mes mouvements, votre Daguerréotype pourra suivre{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "Allez-y à votre rythme habituel !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "#Bien. Puisque vous êtes si {M#confiant}{F#confiante}, je donnerai aussi le meilleur de moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Regardez bien, l'instant où les vagues s'élèvent est aussi fugace qu'éphémère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Je ferai de mon mieux pour suivre avec mon Daguerréotype !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Laissez-moi vous prendre en photo !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Vous êtes de service ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
