			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "#Hé, mon {M#ami}{F#amie} ! Bienvenue à Paititi, et à l'Île Tete, le lieu de vos rêves !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "Vous trouverez là-bas nos deux bars, Osez rosée et La gouttelette. Je suis Tecuhtli, c'est mon travail d'accueillir les visiteurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "#{M#Mon cher ami}{F#Ma chère amie}, puisque vous avez goûté mon jus de bienvenue, laissez-moi vous donner un conseil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "Si vous êtes une personne ordinaire qui profite de ses vacances, évitez la partie la plus au nord de l'Île Tete. Il n'y a rien là-bas qui pourra vous aider à vous détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "Bon d'accord, qu'est-il arrivé à vos yeux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Héhé... C'est l'œuvre d'un chauve. Il m'a laissé cette marque, et je sais qu'il est quelque part sur l'île... Je vais devoir le « remercier » pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "Après avoir entendu mon histoire, je suis sûr que vous souhaitez vous venger en mon nom, pas vrai ? Merci, mais ça ira !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "#{M#Cher ami}{F#Chère amie}, personne ne devrait être triste en une si belle journée d'été !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Je vous invite à déguster le jus de bienvenue que je prépare pour chacun des visiteurs, puis à profiter de vos vacances pour vous détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "Vos boissons sont sur l'étagère là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525404,
