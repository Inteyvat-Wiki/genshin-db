			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Oh ? Mon œil ? Eh bien, il y a trois choses que tout homme doit entraîner correctement dans sa vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Tout d'abord, un corps usé par le temps doit porter au moins une cicatrice. Sinon, on ne peut pas savoir à quelles épreuves l'homme a été confronté, et sa vie n'a pas de sens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Ensuite, les cicatrices doivent être couvertes par des vêtements ou des accessoires, mais seulement en partie. Sinon, personne ne pourra dire que l'homme est spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "Et enfin...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Je n'ai pas mentionné vos yeux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Exactement ! Enfin, si les autres ne le remarquent pas, l'homme doit faire en sorte qu'ils le remarquent en abordant le sujet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
