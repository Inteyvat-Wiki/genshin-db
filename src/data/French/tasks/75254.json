			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Est-ce qu'on ne se serait pas déjà vus quelque part ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "#Mon {F#amie}{M#ami}, c'est la marque du destin sur l'extraordinaire : notre première rencontre ressemble à des retrouvailles à travers les vies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "En voyant ce cache-œil de loup, vous avez sûrement réalisé que je suis assez extraordinaire, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
