	"talks": [
		{
			"id": 202003,
			"completionStepIds": [
				202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202003",
							"2"
						],
						"stepId": 202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Dis-moi. Comment se fait-il que je te retrouve à nouveau en face de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200302,
					"content": "Tu espères que ta témérité protégera ces gens ? Ou... est-ce que c'était simplement un moyen d'obtenir une audience avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200303,
					"content": "Les Fatui ont manipulé la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Oh ? Tu ne m'as quand même pas réveillée de mon état de méditation éternelle simplement pour me dire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200306,
					"content": "Ou alors tu me sous-estimes. Je suis tout à fait au courant du décret de saisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200307,
					"content": "Vous savez tout ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Non. Que ce qui est en rapport avec l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200309,
					"content": "Le décret de saisie a mon approbation tacite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200310,
					"content": "Les actions des Fatui jusqu'à présent ne constituent pas une menace à l'éternité, sinon... elles auraient été arrêtées depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200311,
					"content": "Mais le décret de saisie est un préjudice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Les ambitions individuelles sont intrinsèquement incompatibles avec l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200314,
					"content": "Ce que tu ne réalises peut-être pas, c'est que trop souvent... les gens ont bien plus à perdre à poursuivre leurs rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200315,
					"content": "Par exemple : personne ne perdrait la vie à cause de la perte de son œil divin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200316,
					"content": "Ce sont plutôt ceux qui ont perdu la vie qui ont insisté pour poursuivre leurs propres aspirations, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "#{M#Voyageur}{F#Voyageuse}, ton existence est unique à mes yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200319,
					"content": "Il semble y avoir une multitude d'incertitudes en toi. Pour dire les choses autrement, tu es ce qu'il y a de plus éloigné de l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200320,
					"content": "Je n'insisterai donc pas pour que tu comprennes le sens de mes actions. Tout ce qui compte, c'est que je marche sur la voie de l'éternité au nom de mon peuple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200321,
					"content": "C'est votre plan euthymique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Il est créé par votre conscience, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "C'est exact. Je suis surprise que tu le comprennes aussi bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200324,
					"content": "Dans tous les cas. Tu cherches un moyen d'ébranler ma volonté... pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200325,
					"content": "Je ne suis pas là pour débattre de vos idées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Je suis là pour les détruire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200328,
					"content": "Qu'il en soit ainsi. Eh bien, toi qui veux défier l'éternité... il est temps pour toi de m'éclairer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200312,
					"content": "Les habitants d'Inazuma en paient le prix fort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Le décret de saisie n'aurait jamais dû voir le jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Tu as perdu, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200503,
					"content": "... Oui, j'ai perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200504,
					"content": "Pourquoi ne peux-tu pas faire confiance à ton peuple et à la force de ses ambitions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Ces ambitions ont transcendé l'espace et le temps. Personne ne peut les étouffer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Lorsqu'un peuple avance avec toute sa force...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Est-ce la leçon que tu as tirée de ton voyage à Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Il existe des nations où les humains rejettent leur dieu et avancent sans eux...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Est-ce qu'on peut abandonner la notion de progrès... au nom d'une utopie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "... Toi et moi avons été témoins des grandes pertes que le progrès pouvait engendrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200514,
					"content": "L'éternité... L'éternité est la seule voie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200515,
					"content": "L'ordre divin... C'est un non-sens sans importance à mes yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Au final, tout ce que tu veux, c'est protéger ta bien-aimée Inazuma, pour toujours et à jamais. N'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "C'est trop simpliste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200518,
					"content": "Mais cette nation vaut-elle la peine d'exister pour l'éternité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Dénuée de toute ambition, de toute possibilité de changement, pour le simple fait... d'exister. Ce n'est qu'une coquille vide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Hein. Je me demande quel genre de perte cela pourrait vraiment être si une telle nation venait à être détruite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, retire tes paroles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200522,
					"content": "L'éternité immuable est la promesse que j'ai faite à mon peuple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200523,
					"content": "Mais ce dont ton peuple a besoin, ce n'est pas de tes promesses. Il recherche ton attention... ton regard divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "... Tu veux dire des yeux divins ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200525,
					"content": "Les humains ont une durée de vie d'à peine cent ans. Ils ne peuvent pas se permettre de subir la moindre perte supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200526,
					"content": "Mais je les ai vécues pour eux. C'est pourquoi j'ai choisi de les guider sur la voie de l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200527,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Mais l'éternité est un destin bien trop cruel pour toi, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200530,
					"content": "Non seulement tu as cessé de prêter attention au monde, mais tu as également cessé de prêter attention à toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Tu as dû te sentir terriblement seule ici, seule pendant des siècles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "C'est nécessaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200533,
					"content": "Tu vas passer à côté de beaucoup de choses en refusant le progrès... Tu cherches à éviter les pertes, mais as-tu pensé à tout ce que tu perds en restant ici en stase pour l'éternité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Tu te sens manifestement seule et pourtant, au nom de l'éternité, tu choisis d'étendre ta solitude à l'infini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Dis-moi. Pourquoi le ciel ici qui était autrefois si sombre brille-t-il à nouveau ? Pourquoi maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Ceci est ton plan euthymique. C'est ton monde intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Ça ne peut signifier qu'une chose... que tu es heureuse de me revoir. Tu as trouvé la solitude ici insupportable depuis longtemps, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Je... n'ai rien à dire à ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200539,
					"content": "Héhéhé, oh mais j'ai tellement de choses à te dire, moi. Laisse-moi te raconter tout ce qu'il s'est passé au cours des derniers siècles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Combien de temps cela prendra-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200541,
					"content": "En tant que Kitsune, j'ai une excellente mémoire. Je me souviens parfaitement du moindre détail de ce qui s'est passé au cours des derniers siècles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Il me faudra donc probablement encore plusieurs siècles pour tout te raconter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Hé... héhé... Miko, je n'aurais jamais pensé que j'aurais la chance de te retrouver ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200544,
					"content": "*soupir* Te revoir est un changement pour l'éternité... et une agréable surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200545,
					"content": "Héhé, puisque tu es prête à l'admettre, je suppose que cela signifie qu'on peut toujours être amies ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Comme c'est enfantin de dire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200547,
					"content": "Quoi qu'il en soit. Maintenant que tu as réussi à me vaincre avec ton plan, j'honorerai ton souhait d'abolir le décret de saisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200548,
					"content": "Mais pour ce qui est de l'éternité et de la question de savoir si cette nation doit aller de l'avant, j'ai besoin de temps pour y réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200549,
					"content": "Héhé, c'est toi qui as agi comme une enfant depuis le début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Il peut surpasser les dieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "Il peut s'assumer pleinement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
