			"dialogs": [
				{
					"id": 20210101,
					"content": "Alors, qu'est-ce que tu as fait dans le plan euthymique de la Shogun Raiden ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210102,
					"content": "Est-ce que le décret de saisie est aboli ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210103,
					"content": "C'est grâce à Yae Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "Oh, je comprends... J'étais tellement inquiète, tu sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210106,
					"content": "Alors peut-être que la raison pour laquelle Yae Miko nous cherche à présent, c'est qu'elle veut nous remercier ? Allons la voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210104,
					"content": "On a transmis les souhaits du peuple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
	]
