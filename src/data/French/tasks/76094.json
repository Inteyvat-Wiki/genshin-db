			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "Oh, ce doit être le compagnon du marchand étranger qui s'était perdu dans la grotte, non ? Vous avez réussi à le faire sortir finalement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "On sait tous que le mouton-paresseux vous suit pour disperser les graines qu'il transporte plus loin, mais ce monsieur ne voulait pas nous croire, peu importe nos explications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "#Franchement, je ne savais pas trop comment réagir. Heureusement que je suis tombé sur {M#un aventurier}{F#une aventurière} serviable comme vous, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Voici un petit quelque chose pour vous témoigner notre gratitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
