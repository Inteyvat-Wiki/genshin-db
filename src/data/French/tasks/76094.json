					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "Merveilleux ! Je savais que vous trouveriez une solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "Les moutons-paresseux ne peuvent pas vivre dans les régions où il n'y a pas de kuuvahki, mais cela pourrait au moins offrir à ce monsieur un peu de réconfort pendant son séjour à Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Je vais vous laisser à présent. Voici un petit quelque chose pour vous témoigner notre gratitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
