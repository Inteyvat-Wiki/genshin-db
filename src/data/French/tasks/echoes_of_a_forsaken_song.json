			"dialogs": [
				{
					"id": 760740101,
					"content": "C'est vraiment un drôle d'instrument... J'ai beau pincer les cordes, aucun son n'en sort ! Il est cassé ou quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740102,
					"content": "Suivons d'abord ces Fées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "#Hein ? Mais je suis {M#sûr}{F#sûre} d'avoir entendu de la musique à l'instant, et un chant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "D'accord, oublions l'instrument pour l'instant. En suivant les Fées, on trouvera sûrement le trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740105,
					"content": "V—Vraiment ? Moi, je n'ai entendu que le vent... Attends, serait-ce l'un de ces instruments dont seule la personne qui en joue peut entendre la musique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740106,
					"content": "D'accord, je vais essayer aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740107,
					"content": "Paimon pince fermement les cordes...\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#Aaah, toujours aucun son ! {NICKNAME}, tu es vraiment {M#sûr}{F#sûre} d'avoir entendu quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740111,
					"content": "Bon, laissons l'instrument de côté pour l'instant. Suivons plutôt les Fées vers le haut, on trouvera sûrement le trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
