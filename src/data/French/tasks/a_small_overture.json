			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860103,
					"content": "... Comment vont les Descendants de givrelune ces derniers temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860104,
					"content": "Très bien. Le retour de la Déesse de la lune a renforcé notre détermination à suivre la voie qui nous a été tracée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Vraiment ? C'est une bonne nouvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Ah... Je suppose que nous n'avons vraiment rien à nous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860109,
					"content": "J'ai peur que... ce soit parce qu'il y a beaucoup trop d'histoires entre les Descendants de givrelune et les Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Pour ma part, je vous suis reconnaissante pour vos efforts visant à protéger Nod-Krai et à accueillir de nouveau la Déesse de la lune, mademoiselle Sandrone. Mais en ce qui concerne vos associés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Je comprends. Pour diverses raisons, nous n'avons pas réussi à établir de relations amicales... ni même mutuellement bénéfiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860112,
					"content": "Mais les Fatui ne cherchent plus à prendre quoi que ce soit aux Descendants de givrelune, et j'ai rappelé à mes subordonnés de ne pas vous causer des problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860113,
					"content": "De mon point de vue, puisque nous sommes voisins, même si nous ne pouvons pas coexister en parfaite harmonie, ce serait bien que nous puissions nous traiter avec un respect mutuel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860114,
					"content": "J'ai bien peur que cela prenne du temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Sans aucun doute. Mais nous pouvons commencer par faire un petit pas à la fois. Voudriez-vous essayer cette tisane que j'ai préparée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860116,
					"content": "Une tisane ? Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Hmm... L'arôme est si riche... L'avez-vous préparé à la manière des Descendants de givrelune ? La plupart des étrangers que j'ai rencontrés n'aiment pas notre thé. Comment avez-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Par apprentissage. Et par respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860119,
					"content": "Ah... Ce n'est pas mal comme premier pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "J'espère que cela vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860121,
					"content": "J'aime beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Les échanges autour du thé ont toujours été un excellent point de départ pour de bonnes relations entre voisins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Je pense que cette fois ne fera pas exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
