			"dialogs": [
				{
					"id": 761860201,
					"content": "Cette tisane est vraiment délicieuse, mademoiselle Sandrone. C'est comme si je pouvais goûter votre sincérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860204,
					"content": "Très bien. La prochaine fois, ce sera à mon tour de vous inviter chez les Descendants de givrelune pour prendre le thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "L'heure du thé est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
