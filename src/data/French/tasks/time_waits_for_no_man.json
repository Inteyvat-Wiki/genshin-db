			"dialogs": [
				{
					"id": 206030501,
					"content": "Eh bien, vous n'avez pas mis longtemps à revenir. J'imagine qu'il n'y a pas de gros problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Il reste encore pas mal de monstres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Comment ? Il y a encore plus de monstres qu'avant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Étrange, l'ennemi a été repoussé... Pourquoi continuent-ils à traîner à Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "À moins qu'ils ne trament quelque chose d'autre... Bon, je dois rassembler les aventuriers et préparer de nouvelles missions. Ces monstres ne sont pas à prendre à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Enquêter sur les mouvements ennemis à l'extérieur de la cité est exactement du ressort de la Guilde... L'heure est venue de montrer ce qu'on vaut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Ah, oui, tenez. Pour vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
