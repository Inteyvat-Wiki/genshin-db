			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "#Ouah ! On était à la pièce d'échecs à l'instant, et en un éclair, on s'est {M#retrouvés}{F#retrouvées} ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050602,
					"content": "Qu'est-ce qu'il vient de se passer ? C'est impressionnant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050603,
					"content": "Héhé, vous voulez recommencer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050604,
					"content": "Oui ! Encore, encore !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "Hé, calme-toi un peu ! Tu as quel âge ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050608,
					"content": "C'est normal, les coordonnées ont été déviées. C'est peut-être parce que j'ai vieilli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050609,
					"content": "#Hé... Ce ne serait pas la même vallée par laquelle on est {M#passés}{F#passées} la première fois qu'on est {M#venus}{F#venues} ? Il y a quelque chose d'intéressant à voir ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050610,
					"content": "Tu poses trop de questions, petite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050611,
					"content": "C'est étrange... Ça devrait être ici... Ah, c'est ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050606,
					"content": "Il ne vaut mieux pas, j'ai un peu la tête qui tourne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "Maintenant que tu le dis, moi aussi, j'ai le tournis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "Vous sentez une partie de votre pouvoir vous être retiré quand les éclats de lumière fusionnent avec la lampe magique de Liloupar...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "« Shiruyeh n'est autre que Khorramdin »\\nDit une personne portant un masque de cuivre.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "« Tu n'auras pas d'héritiers. Je ferai disparaître de nombreuses idoles du temple de ta divinité. Je t'enverrai dans ta tombe, car tu es méprisable. »\\nDit la personne portant un masque de cuivre.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "À travers les yeux hébétés d'une djinn, vous êtes témoin de la manière dont Gurabad a été engloutie par les ténèbres...\\nLa cité de Gurabad a longtemps été tel un réservoir où l'eau s'accumule, or, à ce moment, son peuple fuit de toute part comme le ferait un torrent.\\nLes djinns de la ville dénués de raison surgissent des machines froides et des armes des soldats... Suite à quoi du vin écarlate et du jus de grenade jaillissent et se répandent...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "Les grenades roulent, se fêlent, et se font piétiner jusqu'à devenir une masse boueuse... Dodus ou flétris, riches ou humbles... Les fruits écarlates appellent à la venue de Khorramdin... La joie de vivre accompagne une vengeance satisfaisante.\\nLe jus a un goût aussi doux et moelleux que le vin doux, et il coule à travers la ville, la transformant en une vaste mer rouge...\\nCette mer noie les esclaves, tandis que leurs maîtres hurlent alors qu'ils flottent sur l'océan au milieu de la nuit.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "Enfin, vous voyez le roi au masque de cuivre. Il pénètre dans l'ombre et se blottit dans les bras de Shirin...\\nLe visage âgé de Shirin est sombre, toute trace de vitalité et de raison ont disparu d'elle telles des poussières emportées par le vent de la nuit.\\nIl y a aussi le roi Kisra, qui s'est transformé en monstre ténébreux... Ils sont votre sang, et pourtant, cela vous réjouit. Vous vous réjouissez de ce juste retour des choses.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "Gurabad, tes plaies ne peuvent être guéries, et ta honte est visible par tous...\\nCeux qui entendront cette nouvelle applaudiront et crieront de joie...\\nCar y a-t-il quelqu'un qui n'ait pas souffert de ta tyrannie sans fin ?",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "#« Gurabad, tes plaies ne peuvent être guéries, et ta honte est visible par tous...{NON_BREAK_SPACE}»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050909,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "Ormazd était quelqu'un qui m'était cher. Grâce à l'amour des djinns, lui, qui n'était qu'un simple berger, devint roi de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050912,
					"content": "Je pensais qu'il serait un compagnon qui surpasserait les mortels. J'ai bêtement craqué pour ses yeux... Mais la vanité et l'égoïsme du roi ont fini par le rattraper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050913,
					"content": "Il s'est avéré qu'il n'était pas différent de ces éphémères rois mortels, qui errent dans des rêves de conquête et de persécution, ou qui construisent des palais sur des sables mouvants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050914,
					"content": "Et donc, tu as causé sa chute...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "Comme je l'ai dit, je l'ai puni. Sur trois générations, de père en fils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050916,
					"content": "Kisra Parvezravan et Shirin sont mon sang... J'ai fait usage de complots sanglants et de châtiments mielleux, et, avec une ambition furieuse, je les ai tous punis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050917,
					"content": "Mais ce n'est pas tout... Non, ce n'est pas tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050918,
					"content": "Dis-m'en plus à propos de cette « punition »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "Parvezravan, cet homme vaniteux, mon enfant bien-aimé... Il voulait un pouvoir illimité, alors je le lui ai donné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050921,
					"content": "J'ai conçu pour lui des machines animées par les restes d'esprits des djinns, et dans un rêve sombre, je lui ai inspiré la construction d'un mécanisme colossal capable de régurgiter toutes les choses créées par les hommes comme si c'était de l'eau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050922,
					"content": "Ces créations lui ont apporté des richesses incalculables, mais elles ont aussi ôté la vie aux ouvriers et dépossédé les agriculteurs de leur propriété.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050923,
					"content": "Les aristocrates et les hommes riches en versaient des larmes. C'était le triomphe des mortels, la fin de l'esclavage. Mais je savais bien que j'étais la seule à comprendre quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050924,
					"content": "#L'abolition de l'esclavage a marqué le début d'une servitude sans fin et cruelle{NON_BREAK_SPACE}: les propriétaires d'esclaves ont été libérés de l'obligation de s'occuper de leurs serviteurs, et les esclaves ont été privés de la bénédiction qui les empêchait de souffrir de la famine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050925,
					"content": "Je... Je commence à avoir du mal à comprendre... Qu'est-ce que tu es en train de dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050926,
					"content": "La pauvreté s'accompagne de haine, et la haine engendre l'ambition... La richesse entraîne la cupidité, et la cupidité engendre aussi l'ambition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050927,
					"content": "L'ambition l'a poussé à forcer sa reine, Shirin, qui était aussi sa sœur biologique, à donner naissance à un djinn déformé et sans esprit... Sa souffrance me procurait du plaisir et me rendait plus forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050928,
					"content": "Et c'est comme cela que j'ai pu faire pousser leurs os et leur chair, et de les faire grandir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050929,
					"content": "Tu es en train de parler de Shiruyeh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "Shiruyeh n'est autre que Khorramdin, le masque de cuivre. Les roturiers et les esclaves le considéraient comme un émissaire de leur maîtresse, un sauveur apparu au milieu du malheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050931,
					"content": "Et c'est comme ça qu'il les a conduits à embrasser la justice... À embrasser la mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050935,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050936,
					"content": "Hmm ? Alors tu es encore ici, petite... Pourquoi tu ne dis rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050937,
					"content": "Euh... Bah, j'ai rien compris... Et puis, ce que tu as dit a l'air vraiment terrifiant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050938,
					"content": "Allons, ce n'est rien... Ce que je viens de raconter n'est autre que mon passé et mon destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050939,
					"content": "Oh... Je... Je ne sais pas quoi dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050940,
					"content": "Grâce à votre compagnie, j'ai pu retourner dans le jardin de ma maîtresse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050941,
					"content": "Hein ? Pourquoi tu dis ça, soudainement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050942,
					"content": "Gurabad est là où ma destinée se trouve. Je dois retourner dans cette ville. J'ai une mission à accomplir là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050943,
					"content": "Euh... Tu as commis beaucoup d'erreurs dans le passé, tu veux revenir en arrière et te racheter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050944,
					"content": "Des erreurs ? Ha, je n'ai fait aucune erreur. Mais mes enfants se trouvent encore là-bas. Shiruyeh et elle... Ils doivent se sentir seuls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050945,
					"content": "Tu veux dire que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "Le pouvoir des ténèbres est de plus en plus fort... Seul le pouvoir d'une mère est capable de s'y opposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050947,
					"content": "Je pensais pouvoir utiliser l'abîme ténébreux pour punir tout ce que je détestais... Mais on récolte ce que l'on sème... Mon destin sera d'entrer dans Gurabad et de faire face à son châtiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050948,
					"content": "#{M#Mon maître}{F#Ma maîtresse}... Je suis désolée de ne pas avoir passé plus de temps avec vous, et de ne pas avoir fait plus amplement connaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050949,
					"content": "Mais je sais que le destin nous fera nous rencontrer à nouveau. Vous possédez des qualités incorruptibles. J'ai la foi... que mon choix se révélera être le bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050950,
					"content": "Ton choix...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "En général, un maître ne choisit pas son djinn, c'est le djinn qui choisit son maître. Même si nous nous séparons, je ne pense pas que notre lien sera facilement rompu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050953,
					"content": "Et donc... Veuillez accepter ce dernier cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050954,
					"content": "Placez-moi à côté de votre oreille... une nouvelle fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050955,
					"content": "Vous placez la lampe magique près de votre oreille...\\nVous entendez un gloussement, suivi de paroles à voix basse d'une personne à la voix infiniment douce et délicate...\\nToutes les choses qu'elle vous raconte sont aussi insondables qu'une source d'eau, pourtant, vous comprenez chaque mot de son récit.\\nEnfin, la voix s'efface, ne laissant qu'un frisson persistant au creux de votre oreille...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "Grâce à ses conseils, vous vous familiarisez avec les vers anciens...\\nPourtant, elle ne prononce pas un mot.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "Hé, regarde ! La lumière dans la lampe s'est assombrie... Liloupar, ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050958,
					"content": "Liloupar ? Liloupar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050959,
					"content": "(La lumière dans la lampe s'éteint peu à peu, puis celle-ci se remet à scintiller graduellement. Malgré cela, Liloupar ne parle plus.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050960,
					"content": "Elle est partie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "Ah oui...? Donc, c'était vraiment des adieux... Est-ce qu'on va la revoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050963,
					"content": "Euh... On... On rentre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050961,
					"content": "Gurabad l'attend...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "Tu vas partir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "Le masque de cuivre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "Ah... Khorramdin est le roi Shiruyeh au masque de cuivre. Il est l'« émissaire de la maîtresse », le « sauveur des roturiers et des esclaves »... Haha, ce n'est qu'un escroc rusé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050934,
					"content": "Et à la fin, il a conduit ceux qui l'ont suivi à leur perte... Tout comme la ville de Gurabad, la terre les a avalés et fait tomber dans un gouffre sombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050919,
					"content": "Parle-moi de la chute de Gurabad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "Donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
