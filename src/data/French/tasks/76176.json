						],
						"pointId": 344
					}
				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "... Aria, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Ce n'est plus... ce qu'on pourrait appeler une « punition ». Et ce n'est pas la première fois, d'ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Que ce soit la cité des dragons que notre roi nous a confiée, ou les maisons fragiles mais magnifiques construites par ces minuscules humains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "Combien d'autres vies innocentes devrez-vous encore voir disparaître avant de cesser de rester les bras croisés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Si notre roi était encore là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "Il n'est pas là, Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "Si ce souverain, loin d'être tout-puissant, considère ce destin sinistre et effroyable comme « l'ordre des choses », si c'est là le seul moyen de sauver ce monde condamné de la destruction, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "Quel que soit le prix à payer... et quelle que soit la douleur que ce prix m'inflige, c'est infiniment mieux que le silence le plus total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "#Si le monde est voué à la destruction... À quoi bon lutter contre les ténèbres{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "... Sonnet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "R—Rien, Aria ! Je n'ai rien dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Je pense simplement qu'on ne devrait pas rester les bras croisés à regarder ce tyran massacrer les êtres vivants qui nous font confiance... qu'il s'agisse des dragons ou de ces petits humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Ne devrions-nous pas... les sauver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "... Je comprends la colère de Sonnet, Aria. À mon avis, ce que ce souverain a fait était bien trop cruel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "Même si les chances sont infimes... je veux faire tout ce qui est en mon pouvoir pour sauver ceux qui peuvent l'être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "Mais... et ceux qui ne peuvent pas être sauvés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Ceux pour qui le salut ne vient pas, ceux qui ont perdu la vie... Leur sang, leurs larmes et leurs cris de douleur sont-ils donc destinés à disparaître sans laisser de trace ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "Non... Ce n'est pas ainsi que les choses devraient être. Je souhaite que tout le monde soit sauvé et que personne ne périsse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Si seulement son « ordre » pouvait périr avec lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "... Sonnet. N'oublions pas la raison première de notre existence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "Notre mission consiste uniquement à préserver ce monde jusqu'à ce que notre roi, qui nous a donné la vie, revienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "Nous savions dès le départ ce que cet ordre allait coûter... mais nous ne pouvions pas laisser ce monde courir à sa perte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "... Non, ce n'est même pas une question d'ordre, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, pour nous... pour moi, tu es notre petite sœur chérie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "Alors... s'il te plaît, ne fais rien qui puisse nous blesser, Aria et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "Ne défie pas directement cet ordre céleste. Du moins... pas maintenant, tant que le monde est encore si fragile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Canon... Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth m'a parlé d'un mot que seuls les humains peuvent revendiquer... « Espoir ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "Tant qu'il y a de la vie, il y a de l'espoir... Il y aura toujours de l'espoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}