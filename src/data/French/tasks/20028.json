			"dialogs": [
				{
					"id": 200280101,
					"content": "#Merci, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280102,
					"content": "J'ai beau être un sacré bon chasseur, je ne ferai pas long feu face à ces Blobs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280103,
					"content": "À cause d'eux, je vais repartir chez moi bredouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280104,
					"content": "J'espère que les autres chasseurs auront plus de bol que moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280105,
					"content": "En parlant de ça, pourrais-tu aller me confirmer quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280106,
					"content": "Je ne sais pas si c'est moi qui délire, mais j'ai l'impression que leur nombre a vachement augmenté dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280107,
					"content": "Fais donc un peu de reconnaissance pour moi, s'il te plaît. Si jamais tu vois un Blob sur le chemin, extermine-le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280108,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "#Tu me rends un grand service, {M#petit}{F#petite}. Je vais aller faire mon rapport à Draff de ce pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280111,
					"content": "Je croise les doigts pour qu'il ne soit pas trop bourré, sinon je vais perdre mon temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morro"
				},
				{
					"id": 200280109,
					"content": "#Je suis {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Allez quoi, fais-le pour les habitants de Deauclaire si tu ne veux pas le faire pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morro"
				}
			]
		}
