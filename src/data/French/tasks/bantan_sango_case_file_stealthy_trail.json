			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "Vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320102,
					"content": "Vous avez trouvé des indices ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "Oui, grâce à Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320104,
					"content": "On a pu confirmer plusieurs emplacements grâce à ses déductions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320105,
					"content": "Pour le moment, il semble que l'un des camps soit gardé par le « Chien en chef ». Il faudra faire plus attention à cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320106,
					"content": "Ça, c'est un surnom digne de Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "Hé, ça va ! Je ne lui donnerais jamais un surnom aussi nul ! Si je devais lui trouver un nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320108,
					"content": "Je dirais un « chien qui a du chien » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320110,
					"content": "J'ai placé plusieurs appareils similaires à cet emplacement. J'espère qu'ils auront le même effet qu'avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320111,
					"content": "Hé ! Arrêtez de m'ignorer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320112,
					"content": "Je vous laisse vous occuper du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320113,
					"content": "Vous avez d'autres questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320114,
					"content": "Est-ce que ces informations sont fiables ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "Absolument. J'ai moi-même inspecté ces zones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320116,
					"content": "Pourquoi ne venez-vous pas avec nous cette fois, Ryuuji ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320117,
					"content": "Je l'aurais fait si je n'avais pas une autre tâche que m'a confiée Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320118,
					"content": "Elle a une idée d'où pourrait venir notre « Chien en chef » et m'a demandé d'enquêter sur le sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320119,
					"content": "« Chien qui a du chien ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320120,
					"content": "« Chien en chef ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320121,
					"content": "« Chien en chef qui a du chien ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "Ça ne veut rien dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320123,
					"content": "C'est quoi ce surnom !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320125,
					"content": "Peut-être qu'on devrait juste l'appeler l'« ombre noire », comme avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320126,
					"content": "Enfin, quoi qu'il en soit, je vous laisse vous occuper des animaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320124,
					"content": "Bon, arrêtez de vous chamailler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "Merci beaucoup. Hmm... Ils ne sont pas tous là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320302,
					"content": "Il y a tant d'animaux que ça qui ont disparu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320303,
					"content": "Malheureusement, oui. En comparaison avec le nombre de missions qu'on a reçues, on a dû en trouver la moitié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320304,
					"content": "Et malheureusement, nous n'avons plus de pistes à présent. Par contre, c'est quand même plus facile d'enquêter sur des animaux vivants que des objets inanimés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320305,
					"content": "On a reçu une requête de ce type de la part d'une famille importante dernièrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320306,
					"content": "On n'avait pas la moindre piste. Sans l'aide de Sango, on n'aurait jamais rien retrouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320307,
					"content": "Vous pouvez nous en dire plus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "Oh, oui, oui, oui ! Ça l'air super intéressant ! Allez, dites-nous tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320309,
					"content": "#Je ne savais pas que vous étiez autant {M#interessés}{F#intéressées} par le travail de détective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320310,
					"content": "En fait, on avait déjà notre suspect. Le problème, c'est qu'on n'avait pas la moindre preuve incriminante, ni le moindre indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320311,
					"content": "Plus tard, j'ai entendu par pur hasard que notre suspect avait vendu des herbes à sanglots le jour précédent. Je suis allé voir l'acheteur pour inspecter le produit et j'ai découvert qu'il était encore frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320312,
					"content": "Quand elle a entendu ça, Sango m'a fait aller enquêter au pied du Mont Yougou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320313,
					"content": "Hein ? Pourquoi le Mont Yougou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320314,
					"content": "« Notre suspect vit sur l'Île de Narukami. C'est vrai que l'herbe à sanglots pousse un peu partout à Inazuma, mais la plupart des gens ont besoin d'un bateau pour aller dans les autres îles et nous n'en avons pas trouvé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320315,
					"content": "« D'autre part, la Commission administrative est très à cheval sur l'utilisation des bateaux depuis le décret de confinement. Si notre suspect avait l'intention de commettre un crime, il a dû faire en sorte de ne pas attirer l'attention de la Commission. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320316,
					"content": "« Ce qui élimine les autres îles. » Voilà ce qu'elle a dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320317,
					"content": "Mais il y a aussi de l'herbe à sanglots au Sanctuaire de Narukami, non ? Pourquoi n'inspecter que le pied du Mont Yougou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320318,
					"content": "Sango en a parlé aussi. « C'est vrai qu'il y a des herbes à sanglots à proximité du Sanctuaire de Narukami, mais il y a les prêtresses là-bas et beaucoup de passage dans la zone. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320319,
					"content": "« S'il s'était produit quelque chose d'inhabituel, il est probable qu'on en aurait entendu parler. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320320,
					"content": "Oh, alors c'est ça ! Je vois pourquoi elle est le cerveau de l'équipe, maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320321,
					"content": "Il se trouve qu'on a trouvé un tas de terre au pied de la montagne qui semblait avoir été remué récemment. Notre suspect y avait enterré les objets volés. Il attendait que la situation se calme pour pouvoir les revendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320322,
					"content": "Mais il pensait qu'il éveillerait les soupçons s'il revenait sans rien, alors il a cueilli des herbes à sanglots en chemin et les a vendues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320323,
					"content": "Haha, et pourtant, ce sont les herbes à sanglots qui l'ont démasqué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320324,
					"content": "En effet. C'est la raison pour laquelle je pense qu'il y a des indices dans le coin. C'est juste qu'on ne les a pas encore trouvés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320327,
					"content": "Je trouve notre collaboration parfaite. Après tout, ma spécialité, ce sont les petits boulots, pas le combat ni la furtivité. Vous laisser cette partie me convient à merveille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320328,
					"content": "Tout ça pour dire, est-ce que vous voudriez venir travailler à Bantan Sango ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320329,
					"content": "C'est vrai que ça peut être un peu compliqué de parler avec Sango et qu'elle dit des choses bizarres comme « la conscience est un frein à la sagesse », mais c'est quelqu'un de gentil qui a bon cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320330,
					"content": "Non merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "Ah. Dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320333,
					"content": "Eh bien, maintenant que j'y pense, c'est probablement pour le mieux. Si Sango avait quelqu'un comme vous, je n'aurais plus de boulot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320334,
					"content": "Je vais continuer mon enquête. Si vous avez d'autres choses à faire, n'hésitez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320335,
					"content": "Nous nous retrouverons à l'agence le moment venu. Merci pour tous vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320331,
