						],
						"stepId": 4007609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Ouah ! C'est... C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "Encore une maison de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "Hé, mais c'est chez moi ! Pourquoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "C'est chez vous ? Ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "Oh, c'est vraiment inattendu... J'ai entendu dire que dame Megistus menait une vie relativement modeste, mais cette demeure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Ces livres au sol ont des étiquettes... « Article unique, au prix de 990 000 moras... » Hein ?! Pourquoi c'est si cher ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "Il y a aussi beaucoup de livres à couverture rigide qui ont l'air de coûter une petite fortune... C'est donc à ça que ressemble la chambre d'une astromancienne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "Les pièces sont très bien agencées... Cette maison doit être onéreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Mona, tu es riche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Eh bien, ce n'est pas parce que je n'ai pas d'argent liquide sur moi parfois que je suis pauvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "Quoi ? Ce n'était pas le cas ? Je t'ai payé des repas et je suis même allée jusqu'à t'inviter chez moi pour manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Mademoiselle, vous vous emportez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "Oh, ahem ! Vous avez eu l'honneur de me suivre et de rencontrer le Kaiser et la Kaiserin du châtiment à l'Empire de la nuit éternelle. Comment osez-vous avoir oublié un si grand événement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "Ah oui, les ragoûts et la charcuterie de ta mère sont délicieux ! Hmm, j'ai soudainement envie d'en manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Dame Megistus, ce n'est pas le moment pour de tels propos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "Ce sont des plats de Mondstadt ? Moi aussi, je veux en manger ! Les mets de Mondstadt sont réputés comme délicieux, en particulier les plats de viande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Hmph, je vous ferai également le grand honneur de venir avec moi à la rencontre de mes parents la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#Pour de vrai ? Hé, {NICKNAME} on devrait y aller nous aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Cela fait longtemps que je n'ai pas rendu visite à des amis, j'irai avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Ne faudrait-il pas préparer des cadeaux à l'avance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Les parents de mademoiselle sont des gens aimables et chaleureux. Rassurez-vous, ils ne se soucient guère de ces formalités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "Si vous y allez, vous devez absolument goûter à la charcuterie, j'ai entendu dire que c'est la spécialité de sa famille ! C'est vraiment délicieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Ceci dit, ne devrions-nous pas d'abord résoudre l'énigme qui se trouve devant nous ? Je vous avoue que cet ornement me préoccupe depuis que nous sommes entrés dans la maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "Ah, c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "Je n'en avais aucune idée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Nous sommes de retour à cet endroit. Ça veut dire qu'on a complètement quitté l'illusion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "C'est bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "Il n'y avait aucun indice sur les Fatui ou l'appareil dans mon illusion... Se pourrait-il que ces illusions n'aient rien à voir avec eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "Ou bien, ces illusions qui nous concernent ne feraient pas partie du processus, mais ne seraient qu'une conséquence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Euh... Qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "Ça signifie que ces illusions ne sont pas des indices qui sont censés nous aider à élucider ce mystère, mais de simples résultats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Quelqu'un a donné naissance à ces illusions. C'est un produit passif, et il ne peut donc rien nous indiquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "En d'autres termes, ces illusions ne sont liées qu'à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "Une manifestation pure et spontanée de nous-même... Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Dites, vous ne pensez pas qu'on devrait peut-être retourner là où tout a commencé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#Le jour où {NICKNAME} et moi avons débarqué pour la première fois sur l'île, nous avons enquêté ensemble sur le camp des Fatui. Il y avait un étrange appareil là-bas et un Fatui qui délirait à proximité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "Le chercheur à qui nous avons parlé a affirmé que cet appareil n'était qu'une invention des Fatui et nous a promis qu'il ne nous dérangerait pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "C'est vrai. Le gros monsieur au chapeau n'avait pas l'air très réveillé et n'arrêtait pas de tenir des propos absurdes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "Je me demande si cet appareil est à la fois responsable de la folie de cet homme et des illusions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "Même si tout cela a un rapport avec cet appareil endommagé, la différence est dans la façon dont cela affecte les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "En effet, c'est vraiment difficile de distinguer les rêves des illusions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "Vous voulez dire que nous sommes affectés d'une autre manière, parce que nous sommes différents ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Exact. Et d'après mes observations de ces derniers jours, je pense que... notre volonté est inébranlable, et c'est ce qui nous différencie des Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "... Ma foi, c'est logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "Les personnes déterminées ne sombrent pas dans la folie, mais donnent naissance à des illusions. Néanmoins, celles qui se laissent facilement abattre ne peuvent pas engendrer d'illusions stables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "Autrement dit, nous devrions immédiatement retourner au camp des Fatui et détruire cet appareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "Non, il devrait être réparé plutôt que détruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "Ce que mademoiselle veut dire, c'est que la destruction inconsidérée de cet appareil inconnu pourrait entraîner des conséquences plus graves, il est donc préférable de trouver un moyen de le réparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Oui, mieux vaut prévenir que guérir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "Si j'ai bien compris, cet appareil est susceptible d'avoir un effet sur le cerveau, nous ferions mieux de le manipuler avec précaution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "Allons-y maintenant ! Dépêchons-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "Un paysage si magnifique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "C'est digne d'une astromancienne de génie. Dame Megistus, vous êtes vraiment la meilleure archimage que l'Empire de la nuit éternelle n'ait jamais connue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Merci, mais l'histoire de l'Empire de la nuit éternelle n'est pas vraiment longue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "... Les étoiles ressemblent à des diamants et la lune me rappelle une perle. C'est le ciel étoilé le plus magnifique qu'il m'ait été donné de voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "C'est beau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "Pour avoir une telle illusion, Mona doit sans doute cacher une vaste mer d'étoiles dans son cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "... Je pense que nous voyons nos aspirations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "Ce ciel étoilé est très beau, on peut même dire qu'il est plus splendide que celui que je vois habituellement lors de mes séances de divination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "Chacune de ces étoiles est à sa place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "... C'est définitivement mon illusion, il n'y a qu'ici que je peux voir un tel spectacle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "Un spectacle ? Pourquoi dis-tu cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "Vous savez, le ciel étoilé de Teyvat est si merveilleux qu'on pourrait croire que les réponses à toutes les questions du monde y sont cachées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "« Quand mon fils disparu reviendra-t-il ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "« Est-ce que cette personne m'aime ou pas ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "« Pourrais-je guérir ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "Tout est écrit dans la trajectoire de votre étoile de la destinée. Certaines personnes dans ce monde en dévient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "Avoir son étoile en orbite est synonyme de santé, bonheur et tranquillité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Mais à l'inverse, si l'étoile s'en éloigne, le malheur s'abattra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "De ce fait, le ciel étoilé lors de mes séances de divination ne sera jamais comme celui-ci. Parfois, des étoiles se perdent, d'autres tombent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "... Je souhaite que tout le monde puisse être heureux et rester sur la bonne voie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "C'est à cette fin que je donne des conseils et que je choisis de dire la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "Bien sûr, je sais déjà que c'est inutile. Le destin des gens se manifeste dans le ciel nocturne, et puisque je ne suis que l'une de ces étoiles, je n'ai pas le pouvoir de changer quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Quand bien même... Au-delà de l'astromancie et de mes paroles de vérité, il reste encore une once de fantaisie irrationnelle en moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "Les gens doivent marcher sur le chemin de la réalité, mais... il arrive que je surestime mes talents, alors j'espère et je crois encore aux « miracles ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "Dans cette vaste mer céleste, il y a une étoile pour vous, pour moi, pour lui et pour tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "Quelle coïncidence faudrait-il pour que ces étoiles se rencontrent ? Et ces rencontres, ne seraient-elles pas les plus merveilleux « miracles » du destin ? Je n'en ai aucune idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "Mais le ciel étoilé de Teyvat aura toujours une place pour vous et pour moi. Même si l'astromancie est absolument rationnelle... Le destin est capricieux, cruel et romantique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, il semble que tu y aies déjà réfléchi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "As-tu ta réponse maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "... Je pense savoir ce qui est caché dans ces étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "« À présent, je vais m'emparer de mon propre destin. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
