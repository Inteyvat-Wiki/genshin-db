			"dialogs": [
				{
					"id": 740820401,
					"content": "(La plupart des mots ont été effacés, seuls quelques-uns sont à peine reconnaissables : « ... rosée claire... trois... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Autel mystérieux"
				},
				{
					"id": 740820402,
					"content": "Bon sang, le texte a été effacé ici aussi ! Quelqu'un a voulu cacher un secret !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "Rosée claire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "Qu'est-ce que veut bien dire « rosée claire » ? Il y a de l'eau partout ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Quant à « trois »... Ça voudrait dire « trois gouttes d'eau » ? Ça me donne mal à la tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Allez, fais marcher ton flair absolu pour les trésors !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Je lui ai déjà demandé ! Bref...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "En bref, il m'a dit qu'il y avait un rapport avec le chiffre trois et de l'eau. Nous devrions chercher aux alentours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Trois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Ça veut dire trois « choses », hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "Quant à « rosée claire », qu'est-ce que ça veut dire ? Il y a de l'eau partout ici... Tout ça me donne mal au crâne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
