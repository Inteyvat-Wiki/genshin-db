			},
			"dialogs": [
				{
					"id": 740820101,
					"content": "(La plupart des caractères ont été effacés, seuls quelques-uns sont à peine reconnaissables : « ... rosée claire... chantant sur le Chemin forestier brumeux... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Stèle gravée"
				},
				{
					"id": 740820102,
					"content": "Oh ! Beaucoup de mots ont été effacés ! Ça devait être des présentations de sites touristiques, non ? Certains touristes sont vraiment mal élevés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Les touristes écrivent d'habitude, ils n'effacent pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Hmm, tu as raison. Par exemple « {NICKNAME} et Paimon étaient en voyage ici{NON_BREAK_SPACE}»... Non ! On est des gens civilisés qui ne feraient jamais ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "C'est étrange, pourquoi les mots ont-ils été effacés ? Il ne reste que ce bout de phrase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Et il y a de nombreuses éraflures dessus quand même. La personne qui a fait ça n'a probablement pas eu le temps de tout effacer. Seuls les mots « Chemin forestier brumeux » ont eu de la chance d'être épargnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Le Chemin forestier brumeux ? Quel est cet endroit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Hmm... Peut-être qu'ils voulaient dire que le chemin de la forêt est enveloppé dans un brouillard épais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "J'ai envie d'aller voir. Peut-être que ça nous mènera à un trésor caché ! Comme dans les livres, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "Où as-tu acheté ces livres dont tu parles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Je ne suis pas qu'un estomac sur pattes ! Quelque chose me dit que ce Chemin cache un trésor. C'est sans doute pour ça que quelqu'un a voulu effacer le texte sur la stèle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}, il est temps de partir à la recherche de ce trésor ! Ne t'inquiète pas, je possède un flair absolu pour ce genre de chose, on le trouvera !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "Dans quelle bibliothèque as-tu lu ces livres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
