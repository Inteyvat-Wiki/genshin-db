			"dialogs": [
				{
					"id": 250340101,
					"content": "Il ne vous aime pas, alors partez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Sale gosse... Tu connais ce saurien ? C'est quoi votre relation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340103,
					"content": "Raouh... Raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Regarde, ce saurien commence à s'agiter. Va-t'en, morveux. On ne frappe pas les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340105,
					"content": "Les gars, apportez-moi le sac. Le saurien devrait nous rapporter gros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340106,
					"content": "N'approchez pas ! Sinon, je vais vous faire mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "Nous faire mal ? Toi ? Hahahahahaha ! Vous avez entendu les gars ? Ce petit veut nous faire mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340108,
					"content": "Oh, tu me fais tellement peur. Comme tu nous cherches des noises, ne t'étonnes pas si on te met une bonne raclée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340109,
					"content": "Raouh ! Raouh raouh ! Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Zut, ce saurien est féroce... Sale gosse, il est temps de faire dodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340111,
					"content": "C'est vous qui allez faire un bon gros somme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{NICKNAME} ! C'est des méchants ! Ils veulent enlever Qica !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "Raouh raouh ! Raouh raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "... Hé, toi. Si tu fermes les yeux, je te donnerai une partie de l'argent. Qu'est-ce que t'en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340116,
					"content": "Ne faites pas de mal à Qica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Bon, les négociations ont échoué. Maintenant, on va voir qui est le plus fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340119,
					"content": "Allez, les gars ! Attrapez-les !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Voleur impatient"
				},
				{
					"id": 250340117,
					"content": "Qui voudrait de votre argent sale ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Ne vous étonnez pas de prendre des coups.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
