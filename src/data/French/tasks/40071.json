			"dialogs": [
				{
					"id": 400711401,
					"content": "Ah ? On a changé d'endroit, mais ce n'est pas la plage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711402,
					"content": "On dirait une maison de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711403,
					"content": "Mes plus humbles salutations, Votre Altesse la Kaiserin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711404,
					"content": "Amy, ma chérie, j'ai fait des côtelettes de porc frites et des toasts du pêcheur. Viens manger avant que ça ne refroidisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "Mère de Fischl"
				},
				{
					"id": 400711405,
					"content": "*tousse* Mère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711406,
					"content": "Oups, j'oubliais. Ahem... Chère Princesse du châtiment, vous savez qu'il est l'heure du déjeuner, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "Mère de Fischl"
				},
				{
					"id": 400711407,
					"content": "Bien sûr, mère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711408,
					"content": "Oh ! La vue par la fenêtre est magnifique. Prinzessin, Kaiserin, auriez-vous l'amabilité de vous joindre au Kaiser pour un pique-nique ? Allons admirer le paysage et profiter du beau temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "Père de Fischl"
				},
				{
					"id": 400711409,
					"content": "Oui, avec plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
