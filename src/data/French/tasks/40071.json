			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "Au secours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711002,
					"content": "Hé, ce n'est pas une statue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711003,
					"content": "S'il vous plaît, ne dites pas ça ! Je suis Leon, un chevalier de l'Empire de la nuit éternelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711004,
					"content": "Un chevalier ? Ça ne se voit pas du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711005,
					"content": "Ah bon ? Quand bien même, n'accablez pas le seigneur Ozvaldo, qui a conçu et fourni ces armures pour nous autres, chevaliers des corbeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711006,
					"content": "Le seigneur Ozvaldo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}, tu dois le savoir, non ? Le nom complet d'Oz est Ozvaldo von Hrafnavines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711008,
					"content": "Je le savais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Megistus était donc un nom facile à prononcer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711011,
					"content": "Oui, je me suis dit la même chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711012,
					"content": "Hahaha, on dirait bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711013,
					"content": "Chers amis, je ne souhaite pas interrompre votre agréable conversation. Cependant, vous ignorez certainement que la porte d'entrée est fermée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711014,
					"content": "Nous ne savions pas, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711015,
					"content": "Auriez-vous la gentillesse de me secourir ? En retour, je me ferai un plaisir de vous montrer comment ouvrir cette porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711016,
					"content": "Bon, si vous le dites... D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711009,
					"content": "Je le sais maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
