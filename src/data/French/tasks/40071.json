			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "Oh, nous sommes revenus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Oh non ! Pourquoi on est revenus maintenant ?! L'histoire n'est pas encore terminée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "Cette sensation... Ça craint, c'est comme acheter une méthode d'astromancie de bas étage ou être à la moitié du dîner et se rendre compte qu'on a oublié son portefeuille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "Argh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "Argh ! C'est insupportable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "Elles ont toutes les deux l'air frustrées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "Pour être honnête, je n'aime pas non plus lire des livres qui terminent sur un suspense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Haha, qui aimerait ça ? Allez les amis, entrons dans l'illusion une fois de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "Excellente idée ! Allons-y tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "Pas de réaction, ni de changement d'endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "C'est bizarre. Nous avons réussi à entrer tout à l'heure, mais plus maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "Pourquoi ?! Pourquoi nous empêcher de finir le livre ?! C'est pas sympa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Hum... Serait-ce parce que ce livre a été « lu jusqu'au bout » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "Avant de sortir de l'illusion, le livre que nous avons vu était ouvert à sa dernière page. Je pense qu'il doit y avoir d'autres tomes de « L'hymne de la Terre sainte ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "C'est toujours le cas pour les romans légers... Vous voulez savoir ce qui se passe ensuite ? Achetez le deuxième volume, le troisième, etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "Et zut ! Je dois absolument savoir comment ça se termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Oh oui, comment ça se termine. Qui n'aime pas connaître la fin d'un livre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "Quoi ? Qui est là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Oh, elle m'a vu ! Je dois me tenir droit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "Vous êtes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "Je suis Arnold « Je connais le chemin ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "Plus évident comme nom, tu meurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "Arnold, je vous demande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "Ce n'est pas Arnold, mais Arnold « Je connais le chemin » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "Arnold « Je connais le chemin », je souhaite vous demander quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "Oui, madame !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "Existe-t-il d'autres tomes de « L'hymne de la Terre sainte » ? Où sont-ils ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "Hé, vous avez demandé à la bonne personne. « L'hymne de la Terre sainte » est l'œuvre sacrée de l'Empire de la nuit éternelle, il y a trois tomes au total. Les deux autres sont cachés dans deux hauts lieux de la cité impériale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "Si vous voulez trouver le deuxième volume de ce livre, vous devrez aller au sommet de la tour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "Celle-là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "Absolument, c'est la tour où est conservée l'œuvre sacrée. Il y a un passage secret qui vous y mènera rapidement. Vous pourrez le trouver dans la grotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "D'accord, merci, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "Ce n'est pas Arnold, mais Arnold « Je connais le chemin » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "Belle dame, vous n'avez pas autre chose à me demander ? Par exemple, si j'ai une petite amie ou combien je gagne par mois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "Rien du tout, au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "Ignorez-le. Il y a un passage secret dans la grotte plus loin qui mène au sommet de la tour, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "Oh, belle demoiselle ! Vous n'êtes pas sous mon charme ? Pour votre beauté, je suis prêt à vous révéler tous les secrets de l'Empire de la nuit éternelle ! Mademoiselle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}