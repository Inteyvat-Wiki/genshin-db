				"objectNames": [
					"Narrateur",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "« Les gens d'aujourd'hui n'ont aucun moyen de s'en souvenir, mais les chercheurs savent que Sa Prinzessin a régné sur le monde pendant une période chaotique, quelque six cents ans avant l'époque sainte. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Narrateur"
				},
				{
					"id": 400710302,
					"content": "Non ? Un narrateur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "Il y a un narrateur pour nous raconter l'histoire ! C'est digne d'un univers inspiré d'un livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "La route est coupée, impossible de continuer devant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "Il y a un appareil là-bas, c'est comme s'il attendait qu'on s'en approche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "J'ai l'impression que la structure entière de cet endroit est... délibérée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "C'est la Terre sainte, c'est bien normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Oui, c'est tellement évident que ça ne peut être que remarqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "C'est du Fischl tout craché. Cet endroit est d'une franchise effrayante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007110,
