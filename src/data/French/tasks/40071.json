						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "Et après ? Je veux entendre la suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "Pour cela, il faut continuer l'exploration. Quant à ceci, il vaut mieux refermer un livre après l'avoir lu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
