			"dialogs": [
				{
					"id": 400711301,
					"content": "Il semble qu'il n'y ait pas de route à suivre devant, mais juste un livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "Je crois que nous venons d'entendre l'histoire de ce livre, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "Ainsi, la Terre sainte dans le titre du livre fait référence à l'Empire de la nuit éternelle. Ce livre est justement un hommage du peuple envers Sa Prinzessin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "C'est aussi une sorte d'autobiographie...",
