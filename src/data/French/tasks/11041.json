	"talks": [
		{
			"id": 1104104,
			"completionStepIds": [
				1104104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104104",
							"2"
						],
						"stepId": 1104104,
						"stateName": "QUEST_STATE_UNFINISHED"
