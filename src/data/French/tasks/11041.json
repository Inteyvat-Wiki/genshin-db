				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "C'est Albedo ? Pourquoi traînerait-il dans un endroit comme celui-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "On raconte qu'il adore dessiner. Il peut traîner n'importe où pour trouver un bon paysage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410403,
					"content": "Les vues et les paysages ici sont très beaux, des œuvres d'art partout où vous regardez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410404,
					"content": "Mais... Il n'a pas vu ces Brutocollinus ? Il est en danger, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "Hiii !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Qui êtes-vous ? Pourquoi les avoir dérangés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "Heureusement que j'avais terminé mon esquisse, ça aurait été dommage de rester avec des Brutocollinus inachevés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "Vous dessiniez des Brutocollinus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "Et pourquoi dessiner ces Brutocollinus en particulier ? Ils ne se ressemblent pas tous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "Hum... Je crains que la réponse ne soit pas si évidente... Jetez un œil à mon dessin, ça pourrait vous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "Euh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Waouh, regardez tous ces détails ! Alors qu'une partie semble avoir été faite à la hâte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "Vous pouvez trouver ces Brutocollinus n'importe où, ils sont assez banals en fait... Pas la peine de s'y attarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "Mais regardez donc ce spécimen ! Sa carrure, son pelage... C'est le fait d'une force bien particulière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "Dans la vie cyclique de ces communautés primitives, ces attributs uniques sont une indication de l'évolution à l'œuvre. L'évolution, le passage du néant à l'existence, du connu à l'in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "Attendez. Mon petit doigt me dit qu'on en a encore pour longtemps et je n'ai pas l'énergie pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410614,
					"content": "Nous avons trouvé votre bonhomme, alors je rentre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410615,
					"content": "Quoi !? Vous n'avez pas de questions pour lui ? Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "Ah, qu'elle est bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "#Alors c'est sœur Rosalia qui vous a {M#amenés}{F#amenées} ? Surprenant... Et je n'ai pas eu le temps de la remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "Mais revenons-en à nos Brutocollinus... D'après elle, il semble que vous me cherchiez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "Oui, c'est ça. On a rencontré une fille à Mondstadt, Sucrose ! Elle a dit que vous étiez coincé dans vos recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "#Je vois... Alors Sucrose vous a {M#envoyés}{F#envoyées} ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "Donc, si je ne me trompe pas, vous devez être le chevalier honoraire. Tout Mondstadt parle de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "J'ai entendu un peu de tout à votre sujet — l'attaque de Stormterror, votre contrôle élémentaire, et bien d'autres choses tout aussi intrigantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "#Mais passons directement à la conclusion : il n'y a qu'une seule possibilité, en fin de compte. Vous êtes {M#venu}{F#venue} de loin... D'un autre monde. Correct ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "Exactement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "Excellent ! Si je pouvais obtenir votre aide, je pense que mes recherches en bénéficieraient énormément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "Vos recherches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "Ah ! Pardonnez-moi, ça doit vous dérouter. Par où devrais-je commencer ? Hum... L'essence de la vie, peut-être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "Oh là, vous voulez commencer par ça !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "Hum... Vous avez raison. Faire une démonstration vaut mille mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "Par exemple, éveiller la vie... Insuffler une nouvelle vie aux feuilles mortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "Vous pouvez faire ça !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "L'alchimie est vraiment un art miraculeux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "Hum... J'ai en ma possession une graine spéciale, mais cette méthode ne marchera pas dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "Elle est à votre image : tout comme vous, elle vient d'un autre monde. L'aider à grandir, à fleurir... C'est le problème auquel se heurtent mes recherches. Et c'est là que j'aurais besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "Si vous-même vous avez du mal, je doute que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "Bien sûr que vous pouvez aider. Vous savez, les formes de vie en dehors du monde connu défient mon imagination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410642,
					"content": "Et les résultats de mes recherches sont clairs : vous ne venez pas du monde connu. En vous étudiant, peut-être pourrai-je trouver un moyen de faire germer cette graine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410643,
					"content": "Donc je suis un... hum... cobaye ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#Euh... On devrait peut-être y aller, {NICKNAME} ? Ça a l'air un peu bizarre tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410645,
					"content": "Est-ce que c'est dangereux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "C'est une possibilité. Mais je ferai tout ce qui est en mon pouvoir pour assurer votre sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410649,
					"content": "L'heure est venue de partir, allons-y. Partons, nous avons des recherches à faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410651,
					"content": "#Albedo et {M#ce voyageur}{F#cette voyageuse} semblent bien s'entendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410652,
					"content": "Des larrons en foire ; voilà ce qu'ils sont. Je me demande... Est-ce que c'est un risque pour Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 110410647,
					"content": "Qu'est-ce que j'y gagne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "Je vous propose moras et connaissance... Et la réponse à la question que vous vous posez. Il se trouve que c'est une réponse que je peux vous fournir. Est-ce que ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410636,
					"content": "L'alchimie est vraiment utile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "#Je ne suis pas {M#sûr}{F#sûre} de comprendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "Votre réputation d'érudit vous précède.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "Très... Avant-gardiste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410604,
					"content": "Je pensais que vous dessiniez le paysage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				}
			]
		}
	]
}