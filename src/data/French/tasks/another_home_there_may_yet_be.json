			"dialogs": [
				{
					"id": 130280201,
					"content": "Après leur arrivée au camp, les deux Fongus reçoivent un accueil chaleureux...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "#Les Fongus d'ici ont l'air de se souvenir de nous. Ils sont vraiment accueillants{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280203,
					"content": "Cette entité élémentaire a dû être tenue en haute estime par tous ceux qui vivent ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280204,
					"content": "Hé, qu'est-ce que vous faites ? Vous voulez jouer avec moi, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280205,
					"content": "♩ ~ ♩ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Fongus Anémo flottant"
				},
				{
					"id": 130280206,
					"content": "#Bon, ça va, j'ai compris. {NICKNAME}, je vais aller jouer avec eux un moment, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280207,
					"content": "File donc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Je te dois des excuses. Quand la graine de feu s'est brisée alors que nous étions à l'intérieur d'Apep... J'avais prévu de sacrifier mon pouvoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280210,
					"content": "Est-ce que Paimon t'en a déjà parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280211,
					"content": "#Oui, et ça m'a {M#inquiété}{F#inquiétée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Je n'ai pas fait assez preuve de sang-froid. J'aurais dû y réfléchir davantage et mieux juger la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280214,
					"content": "Quand j'ai réalisé que le Dragon Dendro était en danger et que la sécurité de Sumeru était menacée, je me suis sentie anxieuse et effrayée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280215,
					"content": "Si j'avais décidé de ne pas agir alors qu'il était encore possible de le faire, ou si le temps s'était écoulé avant que j'aie épuisé toute mon énergie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280216,
					"content": "Utiliser mes pouvoirs était peut-être la solution la plus directe, mais c'était aussi la plus difficile à mettre en œuvre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280217,
					"content": "Vous avez encore de la marge pour de la « croissance ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Oui. Ils m'ont beaucoup appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280219,
					"content": "Je comprends ce que cela signifie de voir leur souhait se réaliser, mais je suis toujours incapable de l'accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280220,
					"content": "Comment pouvait-il sembler si serein et satisfait alors qu'il faisait quelque chose qui donnait simplement envie de pleurer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280221,
					"content": "On dirait que je n'ai pas encore totalement saisi le concept d'« empathie »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280222,
					"content": "Ce n'est pas votre faute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Merci de me réconforter ainsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280225,
					"content": "Les émotions sont des choses vraiment complexes, et j'ai encore beaucoup à apprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280226,
					"content": "Tiens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280227,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Fongus Hydro flottant"
				},
				{
					"id": 130280228,
					"content": "♪ ~ ♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Fongus Hydro flottant"
				},
				{
					"id": 130280229,
					"content": "Ils s'occupent même des cultures... Peut-être qu'ils ont appris à imiter les comportements des entités élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280230,
					"content": "Mais puisque ce Fongus a appris à parler, c'est peut-être en raison des effets à long terme de l'énergie élémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280231,
					"content": "Le temps est une force puissante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "C'est exact. Et maintenant, nous n'avons plus à nous soucier de la sécurité de ces deux Fongus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280233,
					"content": "À partir de maintenant, je continuerai à garder un œil sur ce camp de Fongus et je viendrai les voir de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280234,
					"content": "Je veux préserver les traces qu'ils ont laissées derrière eux afin de créer une possibilité pour qu'ils se retrouvent dans le futur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280235,
					"content": "Ce Fongus s'est souvenu du nom « Nur ». Cela signifie qu'il a retrouvé la mémoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280236,
					"content": "Je crois au pouvoir des liens familiaux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Oui. Considérons cela comme un souhait merveilleux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280239,
					"content": "Nahida, le Fongus a apporté des fruits ! Venez les manger avec nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280240,
					"content": "Oui, j'arrive !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280237,
					"content": "Je crois aux miracles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Je ressens la même chose que vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "#Oui, et ça m'a {M#énervé}{F#énervée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
					"content": "Amuse-toi bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				}
			]
		}
	]
}