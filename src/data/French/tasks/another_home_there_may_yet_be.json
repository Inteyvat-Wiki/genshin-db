			"dialogs": [
				{
					"id": 130280113,
					"content": "Ça fait déjà longtemps qu'ils sont là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280101
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280101,
					"content": "Je veux vraiment faire quelque chose pour qu'ils aient une chance de se retrouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280102,
					"content": "Je ne m'inquiète pas seulement pour ces deux Fongus. La situation du camp de Fongus Anémo flottant me préoccupe aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280103,
					"content": "Oui, j'ai le même pressentiment que toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280104,
					"content": "J'ai une idée. Pourquoi ne pas les amener vivre avec les autres Fongus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280105,
					"content": "Puisqu'ils vivent avec des formes de vie élémentaires, leurs habitudes devraient donc être similaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280106,
					"content": "Oui, comme ça, ils pourront veiller les uns sur les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280107,
					"content": "Voulez-vous venir avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280108,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
