					"Yun Jin"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "Quitte à choisir le plus fort, je pense que c'est Sonde-Brises. Après tout, c'est lui qui a créé la divination qimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870302,
					"content": "Je vote pour lui aussi ! C'est mon ancêtre, après tout. Ah, mais il y a l'Hirondelle argentée aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870303,
					"content": "Dans ce cas, je propose les deux sages de Lianshan. Ce sont toujours ceux qui vivent à l'écart des autres et qui ne révèlent jamais l'étendue de leur force qui sont les plus puissants. Enfin, dans les bouquins. Qu'est-ce que vous en dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870304,
					"content": "J'aurais été d'accord avec toi si on était dans un roman d'arts martiaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870305,
					"content": "Mais malheureusement, après avoir lu « Forêt de bambou au clair de lune », je suis convaincu que le Cheval blanc des trois immortels de Tao Dou est la plus forte. Je suis sûr qu'elle a une botte secrète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870306,
					"content": "Personne ne choisit le Pêcheur Yunlai ? C'est de son maniement de la canne à pêche dont vient la technique à l'épée de dame Alioth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870307,
					"content": "D'accord... Mais la pêche, c'est un peu hors sujet là, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870308,
					"content": "Hmm... Même si les pêcheurs ne sont jamais que de simples pêcheurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870309,
					"content": "Vous vous plantez sur toute la ligne ! Les plus forts étaient évidemment le Vieux Wuwang et le Papillon solitaire ! Le Funérarium Wangsheng n'existerait pas sans eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870310,
					"content": "C'est aussi logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870311,
					"content": "Oh, vous êtes déjà tous là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}, Paimon, vous êtes enfin {M#arrivés}{F#arrivées} ! Bienvenue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870313,
					"content": "Ah ! Hu Tao, votre chapeau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870314,
					"content": "Bien vu, Paimon. J'ai ajouté une autre branche de prunier dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870315,
					"content": "#Oh ! {NICKNAME} et vous avez {M#tous}{F#toutes} les deux des branches de prunier assorties maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870316,
					"content": "De quoi parliez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870317,
					"content": "On était en train de débattre sur le meilleur des huit adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870318,
					"content": "Hahaha ! Enfin, c'était plus un échange d'idées qu'autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870319,
					"content": "Oui, le seul moyen de vraiment savoir serait d'utiliser ces lunettes spéciales dans les romans légers qui permettent de jauger la puissance d'une personne rien qu'en la regardant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870320,
					"content": "Xingqiu t'encourage à lire des romans légers maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870321,
					"content": "#Bienvenue, {NICKNAME}. Ma famille m'a raconté que Hu Tao et toi aviez organisé un rituel très risqué et que ça a permis de guérir mon arrière-grand-père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870322,
					"content": "Je ne pourrais jamais vous remercier assez pour vos efforts. Si vous vous retrouvez dans le pétrin à l'avenir, la Guilde des marchands de Feiyun vous proposera toujours son aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870323,
					"content": "C'était un travail d'équipe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "Oui, je sais. Mon père et mon frère remercieront tout le monde individuellement dans les prochains jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870325,
					"content": "Pourquoi vous embêter avec toutes ces formalités, Xingqiu ? Tu n'as qu'à admettre que les plus forts des huit adeptes sont le Papillon solitaire et le Vieux Wuwang et ce sera réglé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870326,
					"content": "Allez, ça suffit ! Mangeons maintenant que tout le monde est là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870327,
					"content": "Paimon, c'est à toi ! Partage ta philosophie de vie avec tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870328,
					"content": "Euh... Oui, c'est... Régale-toi pour ne pas laisser... tes baguettes dans le... quoi déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870329,
					"content": "Dans le désarroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "Ah oui ! Voilà, c'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870331,
					"content": "Paimon, vous ne pouvez pas buter sur les mots quand c'est votre philosophie de vie ! Ça porte malheur ! Votre vie sera semée d'embûches. Allez, recommencez depuis le début !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870332,
					"content": "Régale-toi ! Pour ne pas laisser tes baguettes dans le désarroi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870333,
					"content": "Voilà !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "On mange, du coup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870335,
					"content": "Paimon, tu as oublié notre invitée spéciale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870336,
					"content": "Ah oui, j'avais oublié. Personnellement, je sais déjà qui c'est, mais je ne le dirai pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870337,
					"content": "Ah bon ? Tu n'as pas l'air sûre de toi... Je parie que tu ne sais pas qui c'est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870338,
					"content": "#Mais si ! C'est tellement évident. Ça ne peut qu'être... cette personne. {NICKNAME}, aide-moi un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870339,
					"content": "Yun Jin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "Eh oui ! C'est bien notre Yun Jin. Vous n'avez pas oublié ce qu'elle a dit la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870341,
					"content": "Regardez, elle est montée sur scène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870342,
					"content": "Ouah ! C'est la directrice de la troupe Yun-Han, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "Lixing"
				},
				{
					"id": 401870343,
					"content": "Génial ! Je ne m'attendais pas à la voir au Port Yilong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "Jiewu"
				},
				{
					"id": 401870344,
					"content": "Salutations à tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870345,
					"content": "Je vais chanter la « Sanctification de Tao Dou » pour mes amis qui n'ont pas pu assister à la célébration du Festival des lanternes. Désolée de ne pas avoir pu trouver une véritable scène pour ce soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870346,
					"content": "Oh, c'est tellement gentil de sa part ! Elle fait une représentation pour tous ceux qui l'ont ratée la première fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870347,
					"content": "Chut ! Ça va commencer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870356,
					"content": "Rappelons-nous les affirmations audacieuses sur Tao Dou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870348,
					"content": "À travers sonorités discordantes et destins tragiques, entendez mon appel, âmes des deux mondes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870349,
					"content": "Quelle folie vous pousse à mettre le royaume à feu et à sang ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870350,
					"content": "Les ombres de la guerre s'estomperont avec le temps, seuls les récits du salut seront importants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870351,
					"content": "Les péchés sont à expier une fois le sang versé, telle est la loi de la vie et de la mort que personne ne peut défier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870352,
					"content": "Les voies du ciel sont impénétrables, les désirs égoïstes mènent à l'impardonnable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870353,
					"content": "Vaincre le mal fut leur serment, les huit adeptes levèrent leurs lames contre Tao Dou le puissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870354,
					"content": "Corps usé ou âme emportée, les rêves continueront d'exister pour l'éternité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870355,
					"content": "Les hirondelles reviendront faire leur nid, les larmes et les branches commémoreront ce jour béni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yun Jin"
				}
			]
		},
