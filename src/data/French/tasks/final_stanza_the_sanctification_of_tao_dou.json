			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#Vous auriez dû accompagner {NICKNAME} à la frontière ce jour-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870402,
					"content": "#Je comprends que vous vous faisiez du souci pour {NICKNAME}, mais je ne lui aurais pas été d'une grande aide si les choses avaient mal tourné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870403,
					"content": "De plus, c'est Ningguang qui a changé le plan à la dernière minute. Elle m'a envoyée au Gouffre et je ne peux pas être à deux endroits différents en même temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870404,
					"content": "Si vous n'êtes pas content, allez vous plaindre à la Terrasse Yujing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870405,
					"content": "Hmph, et me plaindre de la Megrez à la Megrez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870406,
					"content": "Je pense plutôt que vous devriez le faire auprès de l'Alioth. Elle n'a pas peur de confronter qui que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870407,
					"content": "... Oublions cela. L'important, c'est que tout se soit bien passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870408,
					"content": "L'Auberge Wangshu est un endroit superbe, dites donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870409,
					"content": "Tout Liyue l'est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870410,
					"content": "Haha, vous avez raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870411,
					"content": "Patron, un autre plat de crevettes à la rosée avec du piment, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870413,
					"content": "... Et un tofu aux amandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
