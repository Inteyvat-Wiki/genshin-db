					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870602,
					"content": "#Oh ? Mais ce n'est rien, Keqing. J'ai l'habitude. {NICKNAME} et la directrice Hu sont {M#ceux}{F#celles} qui méritent vraiment des remerciements.",
					"roleType": "TALK_ROLE_NPC",
