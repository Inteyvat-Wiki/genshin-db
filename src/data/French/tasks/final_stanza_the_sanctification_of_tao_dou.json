					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#Hé ! {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870102,
					"content": "Coucou, Xiangling ! Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870103,
					"content": "Haha, tu sais ce qu'il y a ! On devait se retrouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870104,
					"content": "Ah, c'est enfin l'heure de ce fameux repas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "#Oui ! Vous êtes libres, hein ? Vous ne vous en sortirez pas sans une très bonne raison {NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870106,
					"content": "Ce n'est pas nous qui l'avons repoussé ! C'est Hu Tao !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870107,
					"content": "Elle croit que son poste de directrice lui donne une excuse pour se défiler ! C'est comme si elle n'allait pas venir s'il n'y a pas assez de monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870108,
					"content": "Enfin, ne vous inquiétez pas ! On a convenu que cette fois-ci, on accepterait plus d'excuses de sa part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870109,
					"content": "C'est qui, « on » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870110,
					"content": "Xingqiu et moi ! Il m'a dit qu'il voulait tous nous retrouver depuis un bout de temps, mais qu'il n'avait pas eu le temps à cause de la situation avec son arrière-grand-père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870111,
					"content": "Pendant la nuit du Festival des lanternes, son arrière-grand-père s'est miraculeusement réveillé ! Xingqiu était ravi, et puis il pouvait enfin sortir de chez lui. On s'est retrouvés tout de suite pour établir un plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870112,
					"content": "Ouah ! Son arrière-grand-père va s'en remettre alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870113,
					"content": "Oui ! Ils ont demandé à un médecin de l'examiner. Tout va bien pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870114,
					"content": "Xingqiu dit que son arrière-grand-père mange comme Paimon depuis qu'il a repris connaissance... La famille s'inquiète qu'il ne fasse une indigestion maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870115,
					"content": "Hmm... C'est une bonne nouvelle, mais ce n'est pas très flatteur pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870116,
					"content": "Mais si ! Ton appétit représente une vision optimiste de la vie : régale-toi pour ne pas laisser tes baguettes dans le désarroi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870117,
					"content": "Bien dit, Xiangling ! C'est exactement cette attitude qui m'a permis d'arriver là où j'en suis aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870118,
					"content": "Vraiment ? C'est la première fois que je l'entends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "Oui, vraiment ! Comme Xiangling l'a dit : régale-toi pour ne pas laisser tes baguettes dans le... Dans le quoi déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870120,
					"content": "Haha ! Ne t'inquiète pas. Garde ça pour le dîner, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870121,
					"content": "D'accord ! Mais où va-t-on manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870122,
					"content": "Au Port Yilong, plus tard dans la soirée ! Xingqiu et les autres sont encore là-bas. Ah, et Hu Tao a dit qu'un invité spécial nous rejoindrait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870123,
					"content": "Qui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "Tu verras quand on arrivera !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870125,
					"content": "Ah ! J'ai une idée, mais je vais le garder pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870126,
					"content": "J'ai une idée aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "Qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870128,
					"content": "Je le garde pour moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "Hmph ! On verra qui a raison tout à l'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
