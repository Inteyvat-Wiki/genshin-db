						],
						"stepId": 4018708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xianyun"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1145.934,
							349.309,
							1570.267
						],
						"pointId": 10625
					}
				]
			},
			"dialogs": [
				{
					"id": 401870701,
					"content": "Cette jeune fille du Funérarium Wangsheng est plutôt impressionnante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870702,
					"content": "J'ai été intriguée lorsque le Souverain de la Roche a choisi d'être son consultant, mais je viens seulement de comprendre son intention derrière cette décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870703,
					"content": "Je suis d'accord, mais c'est un plaisir rare d'entendre de tels éloges de ta part à propos de quelqu'un, Souffle-Nuages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 401870704,
					"content": "Comment ça, « rare » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870705,
					"content": "Par le passé, si je ne m'abuse, tu aurais peut-être dit : Cette jeune fille est talentueuse, mais Shenhe ou Ganyu auraient pu en faire tout autant dans les mêmes circonstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "Taille-Monts"
				},
				{
					"id": 401870706,
					"content": "Hmph ! Je n'aurais jamais rabaissé les autres pour complimenter mes enfants. Cette jeune fille a fait preuve d'une détermination et de courage. Ne mérite-t-elle pas d'éloges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870707,
					"content": "Hahaha ! Bien sûr que oui, et ce n'est pas la première. Je vis au Port de Liyue depuis longtemps, et je peux vous dire que le Funérarium Wangsheng a vu passer des générations de directeurs exceptionnels à sa tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 401870708,
					"content": "Flâne-Sentier a raison. Tao Dou n'était pas notre ami, ni notre ennemi. S'il ne s'était pas soucié de tous les êtres vivants et accepté de se sanctifier pour apporter la paix à l'au-delà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 401870709,
					"content": "Nous huit n'aurions pas pu l'emporter sur lui, et encore moins les huit adeptes. Lorsqu'il est devenu la frontière, il ne s'était sans doute jamais imaginé que les mortels préserveraient et maintiendraient sa nouvelle forme aussi longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 401870710,
					"content": "Cela dit, je me rends compte que je ne connais toujours pas le nom de la jeune fille du Funérarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "Taille-Monts"
				},
				{
					"id": 401870711,
					"content": "Le nom de famille de la directrice est Hu et son prénom est Tao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870712,
					"content": "Hu... Comme « papillon » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 401870713,
					"content": "Non, comme dans « espiègle ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870714,
					"content": "C'est le même Tao que dans « malice » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 401870715,
					"content": "Non, c'est le même que dans Tao Dou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870716,
					"content": "Oh, Hu comme le papillon et Tao comme dans Tao Dou. Cela lui va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "Taille-Monts"
				},
				{
					"id": 401870717,
					"content": "Non, Hu comme dans « espiègle », « harcèlement insistant » et « gloutonnerie sans limites » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870718,
					"content": "J'essayais simplement d'égayer l'ambiance. Pourquoi Hu Tao est-elle autorisée à être espiègle et pas moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "Taille-Monts"
				},
				{
					"id": 401870719,
					"content": "Hah ! Parce que c'est son nom. Tu n'as qu'à changer le tien et t'appeler Clame-sottises au lieu de Taille-Monts si tu y tiens tant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870720,
					"content": "Haha, que diriez-vous d'une tasse de thé ? C'est le très rare « Pousse spirituelle » que le Souverain de la Roche a ramené du Village de Qingce. Ce serait dommage de ne pas le boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 401870721,
					"content": "J'espère que nous aurons l'occasion de boire de bons thés ensemble pendant l'année à venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 401870722,
					"content": "Je suis certain que ce sera le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}