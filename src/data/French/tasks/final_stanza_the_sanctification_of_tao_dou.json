				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "Tout est bien qui finit bien, alors pourquoi faites-vous la tête, chère Megrez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870502,
					"content": "#Nous avons évité le pire grâce à la directrice Hu et à {NICKNAME}, mais nous ignorons encore ce qui a causé cette situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870503,
					"content": "Je sais que vous êtes toujours bien informée, capitaine. Vous devez sans doute savoir que Natlan a traversé un incident majeur en rapport avec les lignes énergétiques ainsi qu'avec la vie et la mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870504,
					"content": "Je me demande si ces deux événements sont intrinsèquement liés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870505,
					"content": "Si c'est le cas, ça ne concernera pas seulement Liyue et Natlan. Je vais demander à mes partenaires commerciaux de m'informer si d'autres incidents similaires se produisent ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870506,
					"content": "Pour le moment, mettons ces inquiétudes de côté pour profiter de cette vue merveilleuse avant qu'elle ne disparaisse jusqu'à l'an prochain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870507,
					"content": "Et comment ! Contrairement à Keqing, je sais quand travailler et quand me reposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870508,
					"content": "Vraiment ? Alors pourquoi portez-vous encore cette épingle à cheveux ? Je vous avais dit de vous en acheter une nouvelle avec ma part de la rémunération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870509,
					"content": "Je n'oserai jamais toucher à vos moras sans avoir eu votre véritable accord, capitaine Beidou. Et si vous ne faisiez que plaisanter pour vous moquer de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870510,
					"content": "Hahaha ! Je suppose qu'il va vraiment falloir que j'en choisisse une pour vous. Ça me va, faisons un tour ensemble à la foire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870511,
					"content": "Oh, je vois que vous avez appris à cerner ce que les gens veulent vraiment, capitaine Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870512,
					"content": "Haha ! Allez, vous venez ou non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870513,
					"content": "Pourquoi pas ? Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
