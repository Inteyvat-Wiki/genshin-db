			"dialogs": [
				{
					"id": 207432001,
					"content": "Vous en avez déjà fini avec les routes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432002,
					"content": "C'est fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Excellent ! Les affaires vont pouvoir reprendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Il faudrait d'abord en parler à maître Diluc, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "J'ignore où il se trouve. J'ai demandé à tout le monde au Domaine, et personne ne sait où il s'est fourré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Adelinde a bien dit qu'il était « parti s'occuper d'affaires personnelles », mais n'a rien voulu me dire de plus. En tout cas elle n'avait pas l'air particulièrement inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "*soupir* Enfin, tant pis. Il faudra que j'attende son retour pour lui faire mon rapport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
