			"dialogs": [
				{
					"id": 716663101,
					"content": "Pfiou... C'était moins une...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "J'ai failli avoir une crise cardiaque ! Cette petite était féroce, elle m'aurait donné du fil à retordre ! Oui, même à moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Comment tu fais pour être aussi forte sans avoir été formée ? Les Liyuéens sont tous des génies ou quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "C'est comme ça que les scarabutos jouent ensemble ? Je comprends maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Renoncule effroyable"
				},
				{
					"id": 716663105,
					"content": "Vous avez le temps de jouer encore avec moi ? Je veux aussi vous voir vous affronter pour apprendre des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Renoncule effroyable"
				},
				{
					"id": 716663106,
					"content": "La renoncule effroyable a un talent inné pour ça. J'en ai des frissons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Hé, le vacheron. Si tu étais aussi talentueux, tu saurais déjà comment communiquer avec les créatures à carapace juste en écoutant Gooba parler à Tornade cristalline.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Ha... Hahaha... Moi aussi, j'aimerais bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
