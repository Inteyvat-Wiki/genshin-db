			"dialogs": [
				{
					"id": 716663001,
					"content": "Les scarabutos sont nos amis ! Comme les chiens et les chats !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Renoncule effroyable"
				},
				{
					"id": 716663002,
					"content": "Une gamine ? Encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Le Grand Maître Hanakado est aussi un enfant. Les autres de la dernière fois étaient bons aussi ! L'âge ne veut rien dire en matière de combats de scarabées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "La renoncule effroyable n'a jamais fait de combats de scarabées de sa vie, mais le scarabuto qu'elle a choisi a l'air d'un formidable guerrier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716663005,
					"content": "Je ne comprends pas de quoi vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Renoncule effroyable"
				},
				{
					"id": 716663006,
					"content": "C'est mon papa qui m'a offert ce scarabuto. Il l'a eu d'un ami qu'il s'est fait lors de son dernier voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Renoncule effroyable"
				},
				{
					"id": 716663007,
					"content": "Hoho, ton père a l'air de savoir ce qui est bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Allez, je vais envoyer Melon lavande de fer blanc cette fois-ci ! Je n'ai pas envie qu'on m'accuse de malmener une enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Hmph, on dirait que je suis la plus faible du groupe quand tu dis ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Enfin, je suis quand même le meilleur choix dans ce cas. Aucun de vous ne sait mesurer sa force pendant les combats de scarabées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Ne t'inquiète pas, petite ! Ce n'est qu'un jeu, on va s'amuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
