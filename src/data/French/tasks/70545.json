			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "Miaou, miaou miaou... Miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Miaou ! Miaou miaou miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Lapinou"
				},
				{
					"id": 705450103,
					"content": "Hmm... Lapinou et Amber ont raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Ah, alors c'est donc ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Très bonne observation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "En réalité, je ne comprends pas tout non plus, mais je vois qu'Amber et Lapinou ont trouvé un terrain d'entente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, Paimon ! Vous êtes là ! J'étais justement sur le point d'aller vous chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "J'ai entendu dire que vous aidiez Valerina au Château cotonnoux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#Je te reconnais bien là, {NICKNAME}, à peine de retour à Mondstadt que tu es déjà d'une grande aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "Moi, le chevalier honoraire, je remplirai ma mission, quelle qu'en soit la nature.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "D'ailleurs, de quoi parlais-tu avec Lapinou ? Ça avait l'air de bien se passer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Miaou, miaou miaou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Lapinou"
				},
				{
					"id": 705450115,
					"content": "Hmm... Je viens de demander à Lapinou quel temps il va faire aujourd'hui, et s'il fallait s'attendre à des averses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Hein ? Les chats sont capables de savoir ce genre de choses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Haha, c'est Lisa qui me l'a dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Elle a lu dans un livre que les chatons sont très sensibles à l'humidité et n'aiment pas trop être mouillés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Ainsi, lorsqu'ils ressentent une augmentation soudaine de l'humidité, ils s'agitent et commencent à se frotter le visage et à lécher leur fourrure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Dès qu'un chaton agit de la sorte, on peut s'attendre à une grosse averse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Je n'en avais pas la moindre idée... On dirait qu'on vient d'apprendre quelque chose complètement par hasard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, à l'avenir, nous devrions garder un œil sur les chats lorsque nous voyageons. Ça nous évitera peut-être de toujours être {M#surpris}{F#surprises} et de finir {M#trempés}{F#trempées} par ces nuages sombres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Nous devrions vraiment y prêter davantage attention à l'avenir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "En fait, je suis venue demander quelque chose à Valerina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "J'étais en train de discuter avec elle quand cette adorable petite bête s'est approchée et s'est allongée à côté de moi en bâillant de bon cœur. C'était trop mignon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Maintenant qu'elle est si proche de moi... Je suppose que je vais devoir aussi me montrer amicale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "C'est alors que je me suis souvenue de ce que Lisa m'avait dit, et j'ai décidé de demander les prévisions météo à Lapinou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Il a alors commencé à se nettoyer le visage, à remuer la queue et à se blottir contre ma main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*soupir* Je me demande s'il va pleuvoir dans les prochains jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "J'ai toujours fait attention aux chats sur le bord de la route !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "C'est mon devoir de protéger les chatons de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "#Attends une minute, je suis un peu {M#perdu}{F#perdue}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}