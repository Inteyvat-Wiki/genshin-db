				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "#Hé {M#Voyageur}{F#Voyageuse} ! L'enquête vous donne du fil à retordre ? Vous avez raison de m'interroger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Parlez-moi de Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Ouh là ! Cette Sango... Le Clan Takatsukasa a vraiment engagé une grande détective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "De temps en temps, elle vient soumettre une demande pour réexaminer l'affaire Ryuuji. Mais à chaque fois, monsieur Heizou refuse. Je ne m'attendais pas à ce qu'elle écrive une lettre de plainte cette fois-ci. Impressionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "Quant à savoir pourquoi monsieur Heizou a refusé ses demandes, c'est probablement parce qu'il avait peur que Sango se mette en danger. Après tout, c'est le meurtre d'une personne importante dont on parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Sango a beau être la directrice d'une agence de détectives, elle n'est qu'une personne ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Sont-ils proches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Hélas, pas tant que ça. Ils se disputent à chaque fois. Monsieur Heizou doit encore la considérer comme une vieille amie, j'ai entendu dire qu'il avait travaillé avec Sango par le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "Il me demande parfois de laisser l'agence de détectives s'occuper des cas moins importants. Je suppose que l'idée est de faire marcher leurs affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603010,
