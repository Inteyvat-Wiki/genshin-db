				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906002",
							"2"
						],
						"stepId": 1906002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "#{M#Voyageur}{F#Voyageuse}, je suis sûr que vous serez capable de découvrir la vérité. C'est l'œuvre de Shikanoin, ça ne fait aucun doute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190602902,
					"content": "Hein... Madame la directrice et monsieur Hiruzo sont tous deux des gens bien. Comment se fait-il que les choses tournent au vinaigre quand ils sont réunis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190602903,
					"content": "Ryuuji, s'il te plaît, grandis un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1906030,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
