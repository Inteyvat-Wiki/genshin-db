			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "De retour, déjà ? Eh bien, quelle efficacité... Je crois que je comprends pourquoi « ce monsieur » vous apprécie autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180202,
					"content": "La récompense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "Quelle froideur. Les moras sont ici. Mais vous pourriez avoir un peu de considération pour les sentiments de la messagère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 205180204,
					"content": "C'est un honneur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "#Oh, l'honneur est mien, soyez-en {M#assuré}{F#assurée}. Tenez, votre récompense... Un plaisir de faire affaire avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Cachez-vous, Pilleurs, cachez-vous bien même. Je trouverai bien où vous vous terrez un jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 205180302,
					"content": "Hum. Je sais où ils se trouvent, moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Vous ? Comment... Par les Archons, cette carte est détaillée dites donc. Comment l'avez-vous obtenue ? Val ? Surprenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 205180304,
					"content": "... Ils sont bien plus loins que ce qu'on avait déterminé. Je me demande bien quel est le but de ces crapules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 205180305,
					"content": "Attendez que je note tout ça... C'est bon. J'envoie tout de suite des hommes en reconnaissance. Si ce que vous dites est vrai, alors nous devons les repousser sans plus attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 205180306,
					"content": "#Merci, {M#voyageur}{F#voyageuse}, merci de la part de Mondstadt. Ces Pilleurs de trésors sont cuits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "De retour, déjà ? Eh bien, quelle efficacité... Je crois que je comprends pourquoi « ce monsieur » aime s'en remettre à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180402,
					"content": "J'ai laissé l'Ordre de Favonius s'en occuper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Mais... Ne vous avais-je pas dit que cela pourrait créer des problèmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180404,
					"content": "On ne peut guère compter sur vous... Enfin, « ce monsieur » avait heureusement prévu cette éventualité ; j'avais un plan de rechange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180405,
					"content": "Vous n'aurez pas à vous en faire pour la suite. *soupir* Ne me reste qu'à repartir au plus vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180406,
					"content": "Ah, mais sachez que d'après « ce monsieur », vos actions pourraient mener vers d'intéressants nouveaux développements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180407,
					"content": "Après tout, j'aurais été bien à mal d'aller moi-même en informer les chevaliers de l'Ordre, et « ce monsieur » de même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180408,
					"content": "Tenez, cela vous revient. Prenez-les. Qu'a-t-il dit déjà ? Ah oui : « un geste pour avoir changé le cours du vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051802",
							"2"
						],
						"stepId": 2051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051803",
							"2"
						],
						"stepId": 2051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "#Encore dans les préparatifs ? Oui, mieux vaut y aller quand vous serez {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180502,
					"content": "Vous allez me dire qui est « ce monsieur »...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "Vous pouvez continuer à poser la question, je ne vous répondrai pas. Après tout, c'est la base dans mon métier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180504,
					"content": "Toute information n'est révélée que lorsque nous n'avons pas d'autre choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180505,
					"content": "D'ailleurs, vous pourriez vous poser la question : de tout ce que je viens de dire, qu'est-ce qui rentre dans cette catégorie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 205180506,
					"content": "Quel est le but de votre organisation ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "Notre but... Je serais bien incapable de deviner quel est le but de « ce monsieur », mais je crois qu'il a aussi les intérêts de Mondstadt à cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180508
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180508,
					"content": "Ou peut-être devrais-je plutôt dire qu'il n'agit pas pour son simple plaisir dans ce genre d'affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180509
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180509,
