	"talks": [
		{
			"id": 2051801,
			"completionStepIds": [
				2051801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051801",
							"2"
						],
						"stepId": 2051801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180101,
					"content": "Tiens, encore vous ? Ça faisait un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180102
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180102,
					"content": "Ah, oui, j'y pense. Gillianna ne s'en est jusqu'à maintenant pas trop mal sortie. La bonne nouvelle, c'est qu'elle n'a pas encore quitté Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180103
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180103,
					"content": "La mauvaise, c'est qu'elle a déjà avoué la vérité à sœur Victoria – qui pour l'instant n'a pas fait grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180104
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180104,
					"content": "Il n'y a guère qu'à attendre et voir comment tout ça va se terminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180105
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180105,
					"content": "... Qu'est-ce que vous mijotez encore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180106
					]
				},
				{
					"id": 205180106,
					"content": "Allons, pas la peine de me regarder comme ça, je ne suis pas votre ennemie. Et puis, ne suis-je pas en train de vous indiquer comment sauver Gillianna ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180107
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180107,
					"content": "Bien, parlons affaires, voulez-vous. Je suis ici en raison de notre dernière... collaboration, et de quelques derniers détails à régler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180108
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180108,
					"content": "#Pour faire simple, vous êtes {M#venu}{F#venue} à bout des Pilleurs de trésors, certes. Mais malheureusement, vous avez ce faisant aussi révélé la couverture de Gillianna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180109
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180109,
					"content": "Les Pilleurs ne font pas de cadeaux aux membres qui décident de quitter l'organisation. D'après mes informations, plusieurs Pilleurs ont été repérés aux environs de Mondstadt, du genre qu'on n'a jamais vu avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180110
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180110,
					"content": "#Il est fort probable qu'ils soient là pour Gillianna, et pour en profiter pour extorquer autant qu'ils peuvent. Si je peux me permettre, l'heure est assez grave, et vous êtes tout {M#indiqué}{F#indiquée} pour la tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180111,
						205180113,
						205180115
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180111,
					"content": "Tout ça n'est pas de votre faute ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180112
					]
				},
				{
					"id": 205180112,
					"content": "Tsss... Moi aussi, j'ai mes ordres. Si « ce monsieur » n'avait pas insisté pour que vous vous en occupiez, je ne serais pas venue vous chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180121,
					"content": "Ne vous inquiétez pas pour la récompense ; je me suis assurée que vos services seront payés à leur juste valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180122
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180122,
					"content": "Contrairement à la fois précédente, « ce monsieur » m'a confié suffisamment de moras... Ah, et laissez-moi indiquer l'endroit où les Pilleurs se terrent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180123
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180123,
					"content": "Bien. À vous de protéger Gillianna, Rudolph, Lili et Mondstadt, ne serait-ce que pour les moras. Je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 205180113,
					"content": "#Vous voulez que je m'en charge {M#tout seul}{F#toute seule}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180114
					]
				},
				{
					"id": 205180114,
					"content": "Allons. Vous savez bien que je n'ai pas vos... talents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180115,
					"content": "C'est un problème pour les chevaliers de l'Ordre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180116
					]
				},
				{
					"id": 205180116,
					"content": "Vous n'avez pas entièrement tort, mais « ce monsieur » estime que dans les circonstances présentes, moins de gens sont en courant de la situation de Gillianna, et mieux ça vaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180117
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180117,
					"content": "Et puis, « ce monsieur » préférerait éviter d'impliquer l'Ordre de Favonius. Après tout, les chevaliers agissent en plein jour, et ont parfois tendance à... manquer de tact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180118
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180118,
					"content": "Prenez Hoffman, par exemple, un homme sur qui on peut compter n'est-ce pas ? S'il venait à apprendre que des Pilleurs se trouvent près de Mondstadt, l'alarme serait donnée en une heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180119
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180119,
					"content": "Et nul doute que si les chevaliers de l'Ordre venaient à donner la charge à cor et à cri, les Pilleurs s'évanouiraient dans la nature ; et avec eux, notre plan de nous en débarrasser une bonne fois pour toutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180120
					],
					"speakerTitle": "Val"
				},
				{
					"id": 205180120,
					"content": "Si nous vous demandons d'y allez en solo, c'est que nous n'avons pas d'autre choix, j'en ai bien peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Val"
				}
			]
		},
		{
			"id": 2051802,
			"completionStepIds": [
				2051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
