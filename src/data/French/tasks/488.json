			"dialogs": [
				{
					"id": 4880001,
					"content": "Lisa ? Vous venez pour le formulaire des impôts ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Bonjour petit chou ! Oui, je me suis dit qu'il fallait que je mette la main à la pâte pour Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "On y va si vous n'avez plus besoin de nous ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Attendez ! Charles se demandait si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Laissez-moi vous expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Je viens d'accepter une commande assez importante, mais nous n'avons plus de stock à la taverne, et la livraison du Domaine de l'Aurore est en retard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Ça vous dérangerait de vérifier <color=#00E1FFFF>l'état de cette livraison</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "Qu'est-ce qu'il y a d'urgent à propos de cette commande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "*soupir* On vient tout juste de la passer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Charles dit la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "OK, je vais voir ce que je peux faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "J'y vais, mais vous me payez un verre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Maître Diluc se fera une joie de vous payer une tournée de jus quand vous aurez résolu le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
