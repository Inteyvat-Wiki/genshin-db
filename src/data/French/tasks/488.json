					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "Faites attention : <color=#00E1FFFF>la marchandise doit rester intacte</color> ! Je n'ai pas les moyens de la rembourser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
