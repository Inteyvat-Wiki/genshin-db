					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "#Je ne sais pas comment j'aurais fait si vous étiez {M#arrivés}{F#arrivées} encore plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Pas de panique ! {NICKNAME} va botter les fesses de ces Brutocollinus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Très bien alors... Merci d'escorter ce <color=#00E1FFFF>ballon</color> dans ce cas.",
