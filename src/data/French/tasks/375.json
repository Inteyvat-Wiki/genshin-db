			"dialogs": [
				{
					"id": 3750202,
					"content": "Pfff, quel ennui... Rester debout à ne rien faire d'autre <color=#00E1FFFF>toute la journée</color> que garder cette entrée...\\nHé, vous ! Arrêtez ! Vous n'avez pas le droit de pénétrer ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3750203,
					"content": "On dirait bien qu'il serait plus judicieux d'attendre la <color=#00E1FFFF>tombée de la nuit</color> pour s'introduire dans les lieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
