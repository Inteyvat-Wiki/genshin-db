			"dialogs": [
				{
					"id": 701120101,
					"content": "Bon alors, Dexter. Les temps ont changé. Je suppose qu'il est temps pour toi de laisser l'enfance derrière toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120102,
					"content": "Toi aussi, tu dois te soumettre à ce baptême que nous appelons le passage à l'âge adulte, et apprendre des choses que seuls les adultes connaissent. Regarde bien, je ne te le montrerai qu'une seule fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120103,
					"content": "Pourquoi ça sonne comme les dernières paroles de quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120104,
					"content": "Voici ta dernière leçon. Lis avec moi : la classification élémentaire. Allez, essaie un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Josephus"
				}
			]
		},
