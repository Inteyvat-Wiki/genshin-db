						701120202
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120202,
					"content": "Une minute. Qui est-ce que vous félicitiez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120203,
					"content": "Bon, passons maintenant à l'étape suivante : examiner comment les choses s'influencent mutuellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120204,
					"content": "Observe les réactions élémentaires, les forces à longue portée et les forces à courte portée. Et n'oublie pas d'éviter les perturbations inutiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120205,
					"content": "De quoi parlez-vous ?",
