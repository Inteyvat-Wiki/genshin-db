			"dialogs": [
				{
					"id": 4530701,
					"content": "Des traces de griffes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530702,
					"content": "Grâce à elles, nous pouvons avoir une première idée du nombre et de la taille des loups...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530703,
					"content": "Il y avait au moins deux loups et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530704,
					"content": "Et quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "Oui, oui ! Ils mesuraient au moins deux mètres de haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530706,
					"content": "Paimon, tu as déjà vu un loup ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "Hé ! On n'en voit pas tous les jours. Ce sont des animaux mystérieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
