						4530802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530802,
					"content": "Il a dû se planter là quand les loups ont essayé de défoncer la porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530803,
					"content": "Peut-être que ce loup manquait juste de calcium.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530804
					]
				},
				{
					"id": 4530804,
					"content": "En tout cas, heureusement qu'aucun villageois n'a été blessé.",
