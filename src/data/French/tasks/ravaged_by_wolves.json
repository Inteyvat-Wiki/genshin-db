			"dialogs": [
				{
					"id": 4530101,
					"content": "Pauvre de lui, il ne peut même plus tenir debout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530102,
					"content": "C'est terrible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530103,
					"content": "Il n'est même pas blessé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530104,
					"content": "Les loups l'ont tellement effrayé qu'il est paralysé de peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530105,
					"content": "Horrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530106,
					"content": "Vous rappelez-vous de quoi que ce soit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530107,
					"content": "Je n'avais jamais vu de loup de ma vie jusqu'à aujourd'hui. Ils sont terrifiants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530108,
					"content": "Je crois qu'on repassera pour les détails...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530109,
					"content": "Inspectons de nouveau les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
