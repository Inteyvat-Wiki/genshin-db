					"Hopkins le Merveilleux"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "Alors, comment avance votre enquête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530602,
					"content": "Youpi ! Vous vous êtes relevé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Je revis... J'ai réussi à me sortir de cet enfer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530604,
					"content": "Du coup, où en êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530605,
					"content": "Les poils qu'on a trouvés sur la scène du crime nous font croire que les loups viendraient de Mondstadt. C'est tout ce que nous savons pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Mais ne vous en faites pas, je me rends tout de suite sur le Territoire des Loups pour en avoir le cœur net.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "L'Ordre de Favonius mettra un terme à ce danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Mieux vaut tard que jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530609,
					"content": "Hé, c'est pas très sympa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Nous voulons régler ce problème une bonne fois pour toutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530611,
					"content": "Ne faites rien d'insensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Ici, on fait les choses différemment. Ces loups paieront pour ce qu'ils nous ont fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530613,
					"content": "Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Hopkins le Merveilleux"
				},
				{
					"id": 4530614,
					"content": "C'est terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "De quoi parlez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "De la tournure que prennent les choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Je suis d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Les jeunes peuvent être si impulsifs. Je vous en prie, gardez un œil sur eux pour éviter qu'ils ne commettent l'irréparable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Évidemment ! Nous sommes là pour ça... même si ce jeune homme n'était pas vraiment sympa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Comptez sur nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "En route vers le Territoire des Loups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
