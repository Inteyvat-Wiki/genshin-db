			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "Des poils de loup... On fabrique des pinceaux de calligraphie avec ça à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530502,
					"content": "Cette couleur n'est pas la couleur habituelle des loups des environs de Mondstadt. Peut-être qu'ils viennent d'ailleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530503,
					"content": "Les poils sont différents selon la partie du corps, et les loups en ont plein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530504,
					"content": "Mais regarde ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530505,
					"content": "D'autres poils ? Oh, quelque chose y est accroché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530506,
					"content": "Une graine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "C'est une graine de baie à crochet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530509,
					"content": "Ce fruit pousse uniquement sur le Territoire des Loups ou dans le Canyon de Brillecouronne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530510,
					"content": "Ces loups viennent donc bien de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530511,
					"content": "Oui, mais il se pourrait que ce soit une meute qui empiète sur un territoire qui n'est pas le sien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530512,
					"content": "Nous ne pouvons pas encore tirer de conclusions définitives pour l'instant, mais nous avons des pistes solides pour commencer notre enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530513,
					"content": "Je vais aller poser quelques questions aux villageois avant de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530507,
					"content": "Quelque chose de spécial ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
