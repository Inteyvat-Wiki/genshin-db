	"talks": [
		{
			"id": 100396,
			"completionStepIds": [
				101801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tartaglia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Vous êtes enfin de retour. Alors ? Comment se sont passées les choses au Karst Jueyun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031802,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031806,
					"content": "Je n'ai pas rencontré tous les Adeptes, mais comme ils le disent si bien... c'est le destin qui décide, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031807,
					"content": "Dommage pour cette fois ! Vous pourrez retenter votre chance à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031808,
					"content": "Toute information que j'obtiens sur le Dompteur de démons est précieuse, alors je vous en offre d'autres en échange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031809,
					"content": "La réaction des Sept Étoiles face à la mort du Souverain de la Roche m'a paru suspecte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031810,
					"content": "Le groupe a fait savoir que tant que le coupable n'était pas arrêté, personne n'aurait le droit de payer ses respects à l'Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031811,
					"content": "Ils ont même essayé de limiter la circulation de l'information... Mais avec le rituel de la descente, trop de monde en parle, et même les Sept Étoiles ne peuvent pas contrôler ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031812,
					"content": "... « L'Exuvia » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "Ici, tout le monde sait que le Souverain de la Roche est lui-même un Adepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031814,
					"content": "L'Archon Géo est aussi le Dieu des contrats ; on lui donne aussi le nom de « Père des Adeptes ». Basé sur cette même étymologie, « Exuvia » désigne sa dépouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031815,
					"content": "Les Adeptes puissants et éclairés d'aujourd'hui ont tous rempli un contrat à l'époque, visant à protéger Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031816,
					"content": "Ça explique pourquoi ils sont tous très impliqués dans la protection de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Exact. C'est leur responsabilité, mais ils sont également les plus aptes à mener à bien cette tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031818,
					"content": "Les Adeptes ont le droit d'intervenir si les Sept Étoiles venaient à manquer à leurs devoirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031820,
					"content": "Ça rend les choses compliquées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Il y a quelque chose qui cloche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Pourquoi les Sept Étoiles cacheraient le corps de l'Archon Géo si son esprit s'est élevé dans l'au-delà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031822,
					"content": "Bien sûr ! C'est pour lui que nous avons fait tout ce chemin jusqu'ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Si les Sept Étoiles ont caché l'Exuvia et ne laissent personne s'en approcher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#Alors la quête menée par {NICKNAME} pour retrouver les Sept ne sert plus à rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "Cela ne vous regarde pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Je ne vais rien dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Ah ? Vous cherchez les Sept ? Dans quel but ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031828,
					"content": "Oh ? Très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031829,
					"content": "Un chevalier qui se laisse amadouer par un Fatui, ce n'est pas très pro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031830,
					"content": "Ceci dit, je peux vous aider avec ça également. Ma bonté me perdra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031831,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Laissez-moi un peu de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031833,
					"content": "Je dois contacter quelqu'un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031834,
					"content": "Cette personne pourra vous aider à sortir de cette impasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031835,
					"content": "Hum... Fascinant. Plus ils essayent de contenir la situation, et plus grand est le chaos qui en résulte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 10031836,
					"content": "Tâchez de rester en vie jusqu'à notre prochaine rencontre si vous tenez à assister à la suite des événements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tartaglia"
				}
			]
		},
