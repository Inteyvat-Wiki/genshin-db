					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "Allez les gars, bougez-vous ! C'est l'heure de voler à la rescousse de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "En avant ! Faites preuve de bravoure en cette situation de crise, aventuriers !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "La Guilde des aventuriers peut enfin montrer sa valeur ! Finis les petits boulots ! Notre heure de gloire est arrivée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "C'est maintenant ou jamais pour nous rejoindre, les jeunes ! Nous allons sauver Mondstadt de la ruine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Euh, je ne voudrais pas casser l'ambiance, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "Comment ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "Le problème a déjà été réglé ? J'aurais donc raté le discours de Jean ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "Stormterror ne pouvait pas nous attendre un peu ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
