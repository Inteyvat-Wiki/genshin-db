				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "#Ah, vous êtes de retour ! Notre chevalier honoraire revient {M#victorieux}{F#victorieuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Héhé, {NICKNAME} a montré à Dvalin de quel bois {M#il}{F#elle} se chauffait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "#Vous êtes donc {M#rentrés}{F#rentrées} hier ? Jean est revenue à Mondstadt avant vous, et nous a déjà raconté ce qu'il s'était passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "*soupir* Quand aurais-je une occasion pareille pour briller à mon tour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "Sans toi, on n'en serait pas là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Mais non ! C'est surtout grâce à vous que tout est revenu dans l'ordre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "#Je n'ai fait que mon devoir d'Éclaireuse quand je vous ai {M#accompagnés}{F#accompagnées} à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "Je t'en prie ! Ah, au fait, tu nous attendais ici depuis tout ce temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Je ne pars plus en mission, mais je ne suis pas aussi désœuvrée que vous le croyez ! Voyez, je suis en train d'apporter mon aide à la reconstruction de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "Des reconstructions ? Que s'est-il passé en ville ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Des monstres ont profité de l'absence de Jean pour attaquer Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Lors de mes missions de reconnaissance, j'avais déjà remarqué que des camps de Brutocollinus s'étaient établis un peu trop près de la cité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Je m'en souviens ! Lors de notre première rencontre, tu étais en train de démanteler un de ces camps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "C'est exact. Mondstadt aurait été plongée dans un chaos total si nous n'avions pas anticipé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "#Je suis {M#content}{F#contente} que tu aies pu régler ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Moi aussi. Par contre, quelque chose m'a paru étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Les Brutocollinus n'ont pas la capacité d'organiser des attaques élaborées comme celle-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "Je pense que c'est un Mage de l'Abîme qui était sans doute derrière l'opération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "Ils auraient manipulé ces Brutocollinus ? Si nous n'avions pas ramené Dvalin à la raison, lui aussi aurait été utilisé comme un vulgaire pantin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Oui. Ma prochaine mission d'Éclaireuse sera de surveiller les moindres faits et gestes de l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Ah, je vous prie de m'excuser ! Je vous embête avec ça alors que vous venez tout juste de livrer un rude combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Ça me revient ! Je vous avais promis un délice de viande et carottes au miel avant qu'on se retrouve embarqués dans l'affaire Stormterror...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "Maintenant que c'est terminé, allons manger ! Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "Youpi ! Allons-y ! Je m'en serais souvenue au cas où tu aurais eu un trou de mémoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Génial ! Ça fait une éternité que je n'ai pas mangé de délice de viande et carottes au miel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Allez m'attendre au <color=#00E1FFFF>Bon Chasseur</color> ; je vous y rejoindrai quand j'en aurai fini ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Comment ont-ils fait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "C'est bizarre, ils ne devraient pas être assez intelligents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "J'espère que ce genre d'occasions n'arrivera pas souvent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Tu as raison. Les temps de paix sont précieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "Cette fois, c'est vraiment grâce à vous que nous avons pu nous en sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
