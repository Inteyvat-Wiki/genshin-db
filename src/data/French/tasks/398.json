			"dialogs": [
				{
					"id": 3980901,
					"content": "Qu'est-ce que vous allez faire maintenant qu'on en a terminé avec Stormterror ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980902,
					"content": "#Quitter Mondstadt et continuer d'explorer Teyvat pour trouver des pistes sur {M#la sœur}{F#le frère} de {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980903,
					"content": "Je vois. Nous ne nous reverrons pas pendant un moment alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980904,
					"content": "Mondstadt va me manquer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "Tu seras toujours notre chevalier honoraire où que tu sois, tant que le vent soufflera !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980907,
					"content": "Que le vent nous guide !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "#Tu seras toujours {M#le bienvenu}{F#la bienvenue} ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980910,
					"content": "On devrait se dépêcher de manger avant que la viande ne refroidisse... Mangez, mangez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980911,
					"content": "C'est délicieux. Tu ne me déçois pas, Amber !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980912,
					"content": "Et comment ! Je ne suis pas un cordon-bleu, mais je possède un fin palais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980913,
					"content": "Oh, j'ai failli oublier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980914,
					"content": "Jean t'attend à la <color=#00E1FFFF>cathédrale</color>, je crois que c'est en rapport avec la lyre sacrée... Je serais toi, j'irai dès que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980908,
					"content": "Je promets de revenir vous voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "L'Ordre de Favonius va me manquer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				}
			]
		},
