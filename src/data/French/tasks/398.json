				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Bonjour, puis-je prendre votre commande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "Tiens, regardez qui voilà... On ne dit plus bonjour à ses amis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Oh, pardon, je ne vous avais pas vu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "#Hahaha ! Tu es non seulement {M#revenu plus fort}{F#revenue plus forte} de ton combat contre Stormterror, mais ton sens de l'humour chevaleresque s'est aussi développé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "#Quel honneur d'être en présence {M#du héros}{F#de l'héroïne} de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "Kaeya le beau parleur est de retour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "Mes paroles sont on ne peut plus sincères, chère Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "Que faisiez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Je cherchais un endroit calme pour réfléchir à certaines choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "Pendant que les autres chevaliers se tuent à la tâche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Ce n'est pas facile de faire du travail de réflexion. Je préférerais ramasser les poubelles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "Et à quoi pensiez-vous donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "Aux agissements de l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "La Grande Maîtresse de l'Ordre de Favonius est partie combattre Stormterror, laissant Mondstadt vulnérable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "Si vous étiez un Mage de l'Abîme, laisseriez-vous une opportunité pareille aux mains de simples Brutocollinus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "Vous avez raison, c'est étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "J'ai décidé de les observer pendant un moment pour en avoir le cœur net...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Pendant que vous étiez à l'Antre de Stormterror, on pouvait entendre les cris de guerre des Brutocollinus aux portes de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "C'est alors que j'ai remarqué des activités suspectes à l'intérieur de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "À l'intérieur de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Tous les chevaliers défendaient la cité à l'extérieur, alors ces petits malins en ont profité pour se faufiler à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "Comme je suis resté pour assurer nos arrières, j'ai pu croiser le fer avec un de ces scélérats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "J'ai réussi à lui soutirer des informations avec un peu de « persuasion ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "Apparemment, quelqu'un d'autre tirerait les ficelles de l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "Ils auraient un... dirigeant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "C'est lui qui aurait eu l'idée d'utiliser Dvalin comme arme de guerre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "Qu'est-ce que vous lui avez fait pour qu'il crache le morceau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Héhéhé... C'est connu pourtant : je suis doué avec les mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "Les Mages de l'Abîme se réfèrent à leur dirigeant par « Votre Altesse ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "« Votre Altesse » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Je crois que je vous en ai assez dit pour l'instant. Amber se dirige vers nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "Elle doit être énervée. Je lui ai posé un lapin quand il fallait défendre la cité. Permets-moi de m'éclipser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "Kaeya ! Argh, il s'est encore enfui ! Quel culot !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "Il travaille dur aussi de son côté...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "#Ah bon ? Tu es {M#sûr}{F#sûre} qu'il ne t'a pas {M#embobiné}{F#embobinée} à coups de belles paroles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "Tant pis, laissons-le. Je suis crevée et je meurs de faim... Commandons à manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "Un délice de viande et carottes au miel, s'il vous plaît, Sara !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "Incroyable celui-là !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "Pas vrai ? Quel mauvais exemple pour ses subordonnés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "Mais alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "Qu'est-ce que vous tramez encore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Moi ? Rien. D'autres individus ont par contre eux l'intention de faire des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "Je cherchais un endroit calme pour réfléchir à certaines choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "Ah, mon cher Kaeya !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Oh, heureux de constater que mes efforts n'ont pas été vains. Quel charmeur je suis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
