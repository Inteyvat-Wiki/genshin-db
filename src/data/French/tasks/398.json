			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Merci à vous ! On peut mettre toute cette histoire derrière nous désormais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Nombreuses sont les routes commerciales à avoir été endommagées par cette calamité... Tant pis pour les céréales et les fruits, mais – les Archons nous gardent –, si le vin venait à manquer, ça serait la fin du monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Je ne peux pas imaginer un jour sans ma gnôle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "*soupir* J'espère qu'elles seront vite de nouveau opérationnelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
