			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Il s'agissait donc de Dvalin des Quatre Vents... Les Mondstadtois n'ont jamais oublié son sacrifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "J'ose espérer que nous pourrons réparer notre lien avec lui. Heureusement qu'il ne s'est pas brisé avec cette crise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Tout cela grâce à des jeunes gens dignes de foi comme Jean et vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Grâce aux efforts de l'Ordre de Favonius, Mondstadt retrouvera sa paix d'antan en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
