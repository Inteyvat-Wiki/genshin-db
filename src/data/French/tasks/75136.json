			"dialogs": [
				{
					"id": 751360401,
					"content": "Qui aurait cru qu'on allait devoir chercher des pierres partout dans le Tonatiuh ? Je pensais que l'aventure aurait été plus palpitante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "En tout cas, je m'en remets à vous pour trouver ces pierres de feu. Appelez-moi si vous avez besoin de quoi que ce soit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
