			"dialogs": [
				{
					"id": 751360201,
					"content": "Qu'est-ce que c'est ? On dirait de la pyrophosphorite, mais elle brille et émet des flammes. Ce morceau a l'air plus puissant que celui de Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360202,
					"content": "La pyrophosphorite est censée ressembler à ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360203,
					"content": "Aïe ! Ça brûle !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#Ne touche pas à n'importe quoi, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360205,
					"content": "Je ne m'en suis pas rendu compte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "C'est l'hôpital qui se fiche de la charité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Qu'est-ce qu'il y a, {REALNAME[ID(2)|SHOWHOST(true)]} ? Tu sais quelque chose à ce sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360209,
					"content": "#Ouah, {REALNAME[ID(2)|SHOWHOST(true)]} ! Tu pourras enfin montrer de quoi tu es capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360210,
					"content": "Je suppose qu'on te laissera t'occuper des trésors brûlants dorénavant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360211,
					"content": "Hi, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "Hé ! Par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360213,
					"content": "Regardez, c'est Bona !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360214,
					"content": "Comment est-elle arrivée là ? A-t-elle atterri... Bref, allons la rejoindre d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
