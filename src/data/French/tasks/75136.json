			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "Youhou, on a réussi ! Hmm, cette inscription irisée m'a l'air assez familière. C'est donc ça le fameux jade rétrograde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Hé, mais c'est la supplication dorée, non ? Elle est identique à celle qu'on a eue sur la stèle en pierre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Raouh yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Ouah, c'est vraiment le cas !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Un trésor capable de purifier la corrosion abyssale et un objet capable d'empêcher les malédictions et les désastres... Ça se ressemble un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "Tu ne t'en rends compte que maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "#Mais quoi ? Pourquoi tu ne m'as rien dit si tu le savais déjà ? En plus, comment tu l'as su ? C'est encore ton expérience d'{M#aventurier}{F#aventurière} qui te l'a dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Un trésor capable de purifier la corrosion abyssale et un objet capable d'empêcher les malédictions et les désastres... Ça se ressemble un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Mais cette chose peut-elle vraiment purifier Ochkanatlan ? Personne de l'Association des reliques sauriennes n'en a parlé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Hmm... Puisque le jade rétrograde n'est qu'une supplication dorée, c'est peut-être la raison pour laquelle le dragon maléfique nous a pris pour cible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Ce n'était donc pas parce qu'il avait des vues sur le ragoût enflammé que j'ai mangé ce matin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Les indices commencent à s'accumuler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "C'était vraiment un présage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
					"content": "Hmm, mais Bona n'est probablement pas encore au courant pour la supplication dorée... Bona ?",
