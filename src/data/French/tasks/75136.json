					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Pfiou... On est vivants ! Ça fait du bien de marcher à nouveau sur la terre ferme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "Mais tu flottes dans les airs, toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Il y a une grande différence entre voler près du sol et être projetée dans le ciel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "Le sol n'a pas l'air très solide non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Ne me fais pas peur comme ça ! Si on tombe, je ne pourrai pas vous remonter, toi et {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "Couiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751360107,
					"content": "C'est le Tonatiuh ? Génial, on a réussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Ça ressemble plus à une énorme pelote de laine qu'à un vaisseau ! Ou même à un serpent, vu la façon dont c'est emmêlé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Trouvons un moyen de monter... Au moins, ça n'a pas l'air dangereux. Hum, attends. Où est passée Bona ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Elle a dit avoir beaucoup d'expérience en matière de vol, mais je reste encore un peu inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Tant que la direction du vent est la bonne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Tu as raison. Si c'est le cas, elle a probablement atterri quelque part dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "De toute façon, on n'en saura pas plus en restant ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "Tu as raison, on doit y aller. Peut-être qu'elle nous attend à bord du vaisseau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
