			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hoffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "Hoffman !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650102,
					"content": "Ah, c'est vous. Merci d'avoir fait le déplacement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650103,
					"content": "Avez-vous du nouveau pour moi à propos du Héros de la Nuit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650104,
					"content": "Je peux vous demander de m'expliquer ce qu'il se passe d'abord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Ah bien sûr, toutes mes excuses. Où sont passées mes bonnes manières ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650108,
					"content": "La situation est... Tiens, regardez-moi ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650109,
					"content": "Quelle horrible écriture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650110,
					"content": "Laissez-moi voir de plus près... Hum, certaines parties sont illisibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650111,
					"content": "En effet, la majorité de la lettre est écrite en langue commune, mais certains passages sont codés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650112,
					"content": "De toute façon, le message est facilement compréhensible même sans ces passages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650119,
					"content": "C'est une déclaration de guerre de la part de l'Ordre de l'Abîme destinée au Héros de la Nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650113,
					"content": "Ça veut dire qu'ils veulent se débarrasser de lui pour toujours ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650114,
					"content": "C'est une façon de le dire. Nous cherchons donc à contacter le Héros de la Nuit pour coordonner une action contre l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650115,
					"content": "La Cité de Mondstadt toute entière est désormais concernée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650116,
					"content": "Merci pour ces informations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "Je vous en prie. Vous savez où me trouver si besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoffman"
				},
				{
					"id": 4650117,
					"content": "Je tâcherai de m'en rappeler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "#{M#Navré}{F#Navrée}, mais je n'ai rien de nouveau à vous raconter sur le Héros de la Nuit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "Oh, c'est dommage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Hoffman"
				}
			]
		},
		{
