			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "Maître Diluc ! On vient d'apprendre une terrible nouvelle par un chevalier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650202,
					"content": "Vous parlez de la déclaration de guerre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650203,
					"content": "Si c'est le cas, je suis déjà au courant, mais merci quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650204,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650205,
					"content": "Mon réseau de renseignement s'étend au-delà de l'industrie du vin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650206,
					"content": "Tant mieux alors ! Qu'allez-vous faire maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650207,
					"content": "Je suis ouvert aux suggestions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650208,
					"content": "Vous devriez collaborer avec les chevaliers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "Non, c'est exactement ce que veut l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650210,
					"content": "Ces petits malins savent très bien que je n'aime pas les chevaliers. Ils comptent sur ça pour que l'Ordre de Favonius me force à dévoiler mon identité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650211,
					"content": "Si ça venait à arriver, je ne pourrais plus mener mes activités en paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650212,
					"content": "Les grandes organisations ne veulent jamais se faire supplanter par un tiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650217,
					"content": "Ouh, l'Ordre de l'Abîme vous donne du fil à retordre cette fois. Quelle bande de sournois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650218,
					"content": "J'ai un plan, mais j'aurais besoin de certaines informations pour que ça marche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650219,
					"content": "Il faudrait déchiffrer les parties codées de la lettre, plus précisément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650220,
					"content": "Le charabia qui a fait mal à mes petits yeux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650221,
					"content": "Ça doit être un langage codé utilisé pour communiquer entre eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650222,
					"content": "Dans ce cas, pourquoi envoyer une lettre que personne d'autre ne peut lire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "Ce document n'est pas seulement une déclaration de guerre, mais ça doit aussi être un ordre de mobilisation pour leurs troupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650225,
					"content": "Lorsqu'on défend une cause, on a des amis et des ennemis. Peu importe le camp qu'on choisit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650226,
					"content": "Or je suis l'ennemi de l'Ordre de l'Abîme depuis un certain temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650227,
					"content": "Ils ont fait de moi une cible autour de laquelle leurs troupes se rassemblent et unissent leurs forces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650228,
					"content": "Trop fort... Tous les héros sont-ils aussi intelligents que vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650229,
					"content": "Je ne comprends mon ennemi que trop bien. Après tout, les héros et leurs ennemis ne sont-ils pas les deux revers de la même médaille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650230,
					"content": "Qu'allez-vous faire pour déchiffrer le charabia ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650231,
					"content": "Rien de plus simple : quand on ne sait pas, on demande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650232,
					"content": "J'ai réussi à trouver une de leurs <color=#00E1FFFF>bases d'opérations</color>. Vous pouvez m'accompagner si ça vous dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650223,
					"content": "Mais alors, pourquoi l'avoir écrite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Restez au Domaine jusqu'à ce que la situation se calme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "Cela équivaudrait à laisser les chevaliers s'occuper de cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650215,
					"content": "S'ils étaient à la hauteur en premier lieu, nous n'en serions pas là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650216,
					"content": "Pour le moment, je n'ai ni besoin de fuir, ni besoin de laisser l'Ordre de Favonius gérer les choses.",
