				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "... Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Vous êtes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Je m'appelle Kamei Munehisa. Je ne fais que passer par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Waouh... Il est habillé comme un samouraï.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "Un s—samouraï ? Vous pensez que c'est un samouraï du Shogunat... J'ai entendu dire que l'attitude du Shogunat envers les étrangers était tout du moins... subtile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Ne vous inquiétez pas. J'ai déjà quitté le Shogunat, je ne suis plus un samouraï.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Je viens souvent ici pour chercher à manger, mais quand je suis venu aujourd'hui, j'ai découvert qu'il y avait des monstres par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Ils ont pris toute la nourriture. Donc je n'avais pas le choix que de les tuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Vous venez ici souvent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Généralement, il y a peu de monstres par ici, je viens souvent ici pour cueillir des fruits ou chasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Eh bien, c'est tout ce que j'avais à dire. Maintenant que j'ai tué ces monstres, les autres n'oseront plus venir ici pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Si vous cherchez également de la nourriture, vous pouvez regarder autour de vous. Je n'ai pris que ce dont j'avais besoin. Il devrait rester quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Très bien, je vous laisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Il est parti juste comme ça ? Son comportement est exactement comme celui du samouraï dont j'ai entendu parler avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "Mais que veut-il dire par avoir quitté le Shogunat ? Les samouraïs qui ont quitté le Shogunat sont...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Ils sont comme les ennemis que nous avons rencontrés avant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Oui, j'ai entendu dire que certains samouraïs qui avaient quitté le Shogunat erraient et volaient les gens dans les rues pour gagner leur vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Même s'il n'a pas l'air méchant, on ferait mieux de rester vigilants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Bon. Nous sommes ici pour chercher des ingrédients, non ? Mais à en juger par la situation actuelle, nous ferions mieux de ne pas aller plus loin, au cas où nous serions en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "#{M#Ce}{F#Cette} {M#voyageur}{F#voyageuse} nous escorte depuis si longtemps. {M#Il}{F#Elle} doit être {M#fatigué}{F#fatiguée}. Cuisinons quelque chose ici, faisons une petite pause, puis retournons en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "Le samouraï nous a également dit qu'il y avait encore des ingrédients restant ici, non ? Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Tout comme les « Oni des mers ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Vous avez tué tous ces monstres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Oui, ce sont des monstres ordinaires, très faciles à tuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Pourquoi allez-vous chercher votre nourriture dans la nature ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "J'ai mes raisons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
