				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Je voulais trouver des ingrédients frais... Mais bon, cela devrait suffire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Désolé, je voulais vous faire quelque chose de bon, mais maintenant, on devra manger ce que je peux faire avec tout cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Ça va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Vous avez fait beaucoup d'efforts pour nous escorter. « Ça va. » n'est pas une réponse acceptable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Je m'en souviendrai et je vous inviterai à un bon repas la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, la soupe est prête ? N'oublie pas de ne pas laisser Parvaneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "Non, non, laisse juste la soupe mijoter tranquillement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "C'est bon. J'assaisonne cette soupe selon ma recette améliorée. J'ajoute juste un peu d'assaisonnement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "Je ne comprends pas ta recette améliorée. Arrête ! Xudong, Xudong, viens vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh ! Hé ! Quel assaisonnement étrange rajoutes-tu là-dedans !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Un assaisonnement étrange ? C'est ma sauce spéciale ! C'est le résultat de mes recherches !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "Non, merci ! Mangeons quelque chose d'ordinaire aujourd'hui ! Julie, arrête-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Tu ne comprends rien... Bon, laisse-moi perfectionner ça. Je vais créer l'assaisonnement suprême qui rendra n'importe quel plat délicieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "L'assaisonnement suprême... Je doute que ça existe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Personne ne l'a jamais fait, c'est pourquoi je vais le faire ! Je vais montrer à ces coincés de l'Académie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Haha... D'accord. J'ai hâte de voir ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "#Merci encore pour votre aide précieuse cette fois-ci, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "Je vais vous préparer un plat à emporter. Il faut avoir de quoi manger quand on part à l'aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "La prochaine fois que nous nous rencontrerons, je vous inviterai à un bon repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "Je vous retrouverai pour me préparer ce bon repas la prochaine fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Hahaha. D'accord, j'en prends note. Je vous inviterai pour un bon repas la prochaine fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}