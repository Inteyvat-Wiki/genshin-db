			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Petit Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#Hé ! {M#Grand frère}{F#Grande sœur}, j'ai de bonnes choses ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760102,
					"content": "Merci, mais ça ne m'intéresse pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Pauvre enfant, être obligé de faire des choses suspectes à un si jeune âge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "Non ! Je veux jouer au Temari avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760105,
					"content": "Au « Temari » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "Laissez-moi vous expliquer d'une manière simple, je vais d'abord cacher le temari à un endroit par ici, si vous arrivez à le trouver, alors vous gagnez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760107,
					"content": "C'est comme ça qu'on joue au Temari ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Hé ? C'est une aventurière très forte qui m'a appris à jouer au Temari. Elle m'a également dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760109,
					"content": "« Kujirai, n'oublie pas de dire : si vous gagnez, vous pourrez obtenir de bonnes choses. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760110,
					"content": "#Donc, {M#grand frère}{F#grande sœur}, si vous gagnez, vous pourrez obtenir de bonnes choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760111,
					"content": "#De bonnes choses ! {NICKNAME}, je pense que c'est notre rôle d'adulte de jouer avec cet enfant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Mais je ne pense toujours pas que le Temari se joue comme ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Peut-être que c'est une variante locale, ne nous attardons pas sur les détails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Tu es Petit Kujirai, c'est ça ? On va jouer avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760115,
					"content": "Oh... D'accord, alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
