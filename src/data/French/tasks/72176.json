			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#Waouh ! {M#Grand frère}{F#Grande sœur}, vous êtes trop {M#fort}{F#forte}, vous l'avez trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Haha, {NICKNAME} est {M#un voyageur expérimenté}{F#une voyageuse expérimentée} qui a visité de nombreux pays !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Waouh ! Y compris Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760705,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Super ! L'aventurière m'a dit qu'il y avait plein d'endroits magnifiques à Mondstadt, comme des ruines avec une tour super haute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760707,
					"content": "C'est l'Antre de Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Hmm, je me demande si cette tour est plus haute, ou si le Tenshukaku de la Shogun toute-puissante est plus grand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760710,
					"content": "Petit Kujirai, pourquoi tu es seul dans la nature ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Parce que ma sœur est en train de pêcher... Elle pense que je vais faire fuir les poissons, alors elle me laisse jouer tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760712,
					"content": "J'ai rencontré cette aventurière une fois. Elle a vu que je m'ennuyais, du coup elle m'a offert plein de temaris, et m'a ensuite dit d'aller trouver des gens « cupides » pour aller jouer avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760713,
					"content": "Des gens cupides...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "#On n'est pas cupides ! On est {M#inquiets}{F#inquiètes} ! On est {M#inquiets}{F#inquiètes} que Petit Kujirai s'ennuie seul !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "#Je trouve que {M#grand frère}{F#grande sœur} est vraiment {M#gentil}{F#gentille}, je suis tellement content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760716,
					"content": "Seul dans la nature...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Tu es un enfant, tu n'as pas peur de rencontrer des gens méchants ici ? En plus, tu as de bonnes choses sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "#{M#Grand frère}{F#Grande sœur}, vous êtes {M#gentil}{F#gentille}, mais ne vous inquiétez pas, l'aventurière m'a appris à transformer le temari en bombe. C'est très facile à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760719,
					"content": "Mais c'est dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Pas du tout ! Des Brutocollinus, des Blobs, des méchants, j'en ai chassé tellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760721,
					"content": "C'est toi qui es dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "#Ah oui, {M#grand frère}{F#grande sœur}, si vous voulez jouer au Temari avec vos amis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760723,
					"content": "Je vous donne un temari ! Et voici les règles : ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760724,
					"content": "Il faut cacher le temari pendant le temps de la chanson du Temari. Et il faut également le trouver dans le temps imparti. C'est comme ça que ça marche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760725,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "C'est effrayant de penser qu'on joue avec des bombes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "#Pas la peine d'avoir peur, {M#grand frère}{F#grande sœur} ! Elle m'a également dit que « les bombes ne touchaient que les méchants, probablement ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760728,
					"content": "« Probablement » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "#Bon, je vais aller jouer ailleurs ! Au revoir, {M#grand frère}{F#grande sœur} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Kujirai"
				},
				{
					"id": 721760708,
					"content": "C'est vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}