					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "Merci ! Maintenant, il faut écrire un souhait, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430302,
					"content": "Hmm... Voyons voir... Qu'est-ce qu'on pourrait bien écrire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430303,
					"content": "Ça ira comme ça... Maintenant que j'y pense, des lanternes qui s'élèvent dans les cieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430304,
					"content": "Ça me rappelle Mondstadt, on avait parlé aux pissenlits avant de les lancer dans le vent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430305,
					"content": "En parlant de ça, Mondstadt me manque un peu. Ça fait un moment que je n'ai pas vu de pissenlit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430306,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que je peux vous demander de m'apporter des graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430307,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Merci beaucoup ! Venez me voir quand vous l'aurez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
