			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "#Bonjour {M#voyageur}{F#voyageuse} ! Vous avez fait voler les graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430702,
					"content": "Ça y est.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "Excellent ! J'espère qu'elle arrivera jusqu'à Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430704,
					"content": "« À Liyue, fais comme les Liyuéens »... mais il ne faut pas oublier d'où on vient. Et si on allait chercher des plats de Mondstadt aujourd'hui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430709,
					"content": "Oh, surtout pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430710,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430705,
					"content": "Ne pas oublier nos traditions et se fondre dans la culture locale sont deux choses différentes... Allez, lâchons donc cette lanterne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430706,
					"content": "Tu as fini d'écrire ton souhait ? Une fois la lanterne lâchée, on ira goûter quelques spécialités du festival !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430707,
					"content": "Je l'ai écrit, mais... tu veux encore manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430708,
					"content": "Héhé, bien sûr ! On ne peut pas passer à côté des spécialités du festival quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		}
	]
}