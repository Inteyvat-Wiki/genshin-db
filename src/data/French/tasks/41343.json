					"content": "Quand est-ce qu'on rentrera à Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430602
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430602,
					"content": "Hmm... Bientôt. On vient de partir, tu sais...",
					"roleType": "TALK_ROLE_NPC",
