			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "Comment elles sont faites, ces lanternes célestes ? Tu sais toi, Freki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430102,
					"content": "J'en sais rien... On peut peut-être demander à quelqu'un de nous aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430103,
					"content": "Vous aussi, vous voulez lâcher des lanternes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "#Ah, c'est vous, {M#voyageur}{F#voyageuse} ! Oui, ça a l'air intéressant, on aimerait bien essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430105,
					"content": "On avait prévu de venir au Festival des lanternes pour les spécialités culinaires, mais Geri dit qu'il voulait d'abord lâcher une lanterne céleste... Pour ressentir l'ambiance, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430106,
					"content": "On se fond dans l'ambiance du festival, et puis on déguste ! Comme ça, on en fait l'expérience complète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430107,
					"content": "Et puis... J'ai entendu dire qu'il fallait faire un vœu en lâchant une lanterne, mais... on ne sait pas comment faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430108,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous nous aideriez à fabriquer une de ces lanternes célestes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430109,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Alors, on compte sur vous ! On vous attendra ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
