		{
			"id": 4134305,
			"completionStepIds": [
				4134305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134305",
							"2"
						],
						"stepId": 4134305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "Je vous remercie... On n'a pas quitté Mondstadt depuis si longtemps, mais je me sens déjà nostalgique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430502,
					"content": "Je me demande comment va tout le monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430503,
					"content": "Ne laissons pas passer cette opportunité... Alors, tu as un souhait à faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430504,
					"content": "Moi ? Euh, je réfléchis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430505,
					"content": "#Voilà, ça devrait aller. {M#Voyageur}{F#Voyageuse}, j'ai autre chose à vous demander...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430506,
					"content": "Il faut faire voler ces graines de pissenlit à partir d'un endroit en hauteur, mais l'architecture d'ici n'est pas la même qu'à Mondstadt. Et ni moi ni Geri n'avons une idée d'où aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430507,
					"content": "Est-ce que vous pourriez nous aider à faire voler ces graines à partir d'un endroit suffisamment en hauteur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430508,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
