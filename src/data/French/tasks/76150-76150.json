			"dialogs": [
				{
					"id": 761500101,
					"content": "*tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500102,
					"content": "#Est-ce que ça va{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "... Je vais bien. J'ai juste fait un très, très long cauchemar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500104,
					"content": "... Laissez tomber. Faites comme si je n'avais rien dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500105,
					"content": "#Je n'en peux plus. Pourquoi est-ce que ça m'arrive toujours à moi{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500106,
					"content": "Pourquoi est-ce toujours moi... D'abord maman et papa... Et maintenant ma sœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500107,
					"content": "Tout va bien. Je suis là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "... Oui. Je ne suis pas en colère contre vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500109,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500110,
					"content": "Qu'est-ce que Dex a récupéré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500111,
					"content": "J'appelle ça un fragment de nécromuse. C'est peut-être notre moyen de passer de la mort à la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500112,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500114,
					"content": "Maintenant que Zeitlind a été retrouvée, essayons de trouver un moyen de sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500115,
					"content": "On peut vraiment sortir d'ici par nous-mêmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761500116,
					"content": "Melanta et Nihilita peuvent se déplacer librement dans cet endroit. Ils amènent généralement des personnes avec eux. Dex devrait pouvoir faire de même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500117,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500118,
					"content": "Ça fait trois fragments de nécromuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500119,
					"content": "Ah, mais je dois préciser qu'il s'agit d'un nom provisoire, car je n'ai aucune idée de l'usage que Dex en fera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500120,
					"content": "Et ensuite, Dex ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500121,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500122,
					"content": "Suivons les directions qu'il nous indique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
