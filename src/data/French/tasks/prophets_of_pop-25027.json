			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Monsieur Milu a sorti un nouveau disque. Hmm, j'hésite à l'acheter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "À propos des disques de Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Hmm ? Ils sont très bien, Haloa et nos saurienneaux les adorent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Chaque fois qu'ils font des bêtises et qu'ils refusent de dormir, je leur passe « Chanson du printemps » de monsieur Milu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Ça les endort à coup sûr, et ils font un bon gros dodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Ah... Mais Haloa dit qu'elle préfère les chansons un peu plus rythmées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Si seulement monsieur Milou pouvait composer des musiques un peu plus entraînantes... Je suis sûre qu'elle s'amuserait encore plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
			],
