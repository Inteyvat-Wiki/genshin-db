			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Ouah, encore un nouveau disque ! Les saurienneaux vont être contents !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "À propos des disques de Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "J'aime beaucoup les musiques de tonton Milou, et les saurienneaux de notre famille les adorent encore plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Maman passe des chansons de lui chaque fois que l'un d'entre eux s'agite. Ça les calme toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Hmm, mais ces chansons sont beaucoup trop longues et je n'arrive pas à retenir les paroles... Alors je ne peux pas les chanter aux saurienneaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Hihi, j'aimerais bien que les paroles des chansons tonton Milou soient plus courtes, comme ça je pourrais les chanter tout le temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
