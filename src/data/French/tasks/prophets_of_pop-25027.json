					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "Je n'arrive vraiment pas à communiquer avec Pakaa ! Il ne comprend rien à mon rêve musical !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "#Ah, vous êtes {M#un voyageur}{F#une voyageuse} ? Bonjour, je me présente, je m'appelle Milu Nui et je suis musicien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "#Si vous êtes {M#allé}{F#allée} au Disquaire Xochicuicatl, vous avez certainement dû voir mes disques au rayon pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "Mes disques reflètent ma compréhension de la pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Mais Pakaa n'y comprend rien et ne peut pas s'empêcher de dire que ma musique ressemble plus à des chansons pour enfants qu'à de la pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "J'ai beau insister, il ne cesse de mettre mes disques dans le rayon de musique pour enfants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "C'est vrai... que mon public est jeune et que certains parents achètent mes disques pour leurs enfants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "M—Mais les enfants ont l'oreille très fine ! Et il y en a beaucoup dans la tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Puisque mes disques ont autant de succès auprès des petits... Je trouve qu'ils méritent amplement d'être dans la section pop !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Ça... se tient...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "Pas vrai ? Hmph, je le savais ! Pakaa n'y connaît rien. Attendez voir que je finisse cette nouvelle chanson, j'arriverai à coup sûr à le convaincre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "#Même si je n'ai plus aucune confiance en ses goûts musicaux... {M#Voyageur}{F#Voyageuse}, comment vous appelez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "Hum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "Vous savez jouer d'un instrument ? Ça compte aussi si vous chantez ou fredonnez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Je me débrouille plutôt bien en musique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "Formidable ! Vous comprendrez sans doute ma vision musicale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "J'avais justement besoin de quelqu'un comme vous pour m'aider à mettre au point une toute nouvelle chanson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "#Ne vous en faites pas, je vous récompenserai comme il se doit, vous ne serez pas {M#déçu}{F#déçue}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "Du coup, dites-moi par où dois-je commencer pour écrire un bon morceau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Je n'y connais rien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "#Ce n'est pas grave ! Les gens comme vous écoutent véritablement la musique avec leur cœur. Vous êtes certainement encore plus {M#objectif et impartial}{F#objective et impartiale} lorsque vous jugez un morceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "On peut dire que c'est de la pop pour enfants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "Quel est ce rêve musical ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
