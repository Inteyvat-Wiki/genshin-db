			"dialogs": [
				{
					"id": 250270901,
					"content": "On devrait peut-être faire des enregistrements sonores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "Des enregistrements sonores ? Hmm... Vous voulez dire que je devrais directement utiliser les sons de la nature dans mes chansons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Oh... Ce n'est pas du tout une mauvaise idée. Super ! Je savais que vous étiez quelqu'un d'intelligent et de clairvoyant. Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Attendez, vous y allez les mains vides ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Bien sûr ! Vous ne voulez tout de même pas que je me balade dans la nature avec un gramophone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Ne vous inquiétez pas, ce coup-ci on va juste y aller pour voir quels sons enregistrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Par exemple, le bruit que font les canards en battant des ailes, celui que font les vagues quand un koholasaure plonge dans l'eau, ou encore celui des pas d'un tepetlisaure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Une fois qu'on aura décidé, je préparerai tout pour procéder officiellement aux enregistrements... Mais ça viendra plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Pour le moment, dépêchons-nous d'y aller ! Le temps n'attend pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
