			"dialogs": [
				{
					"id": 250270401,
					"content": "Regardez ces oiseaux ! Leurs chants pourraient me servir pour mes prochains travaux musicaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Mais ce serait un peu monotone si je n'en enregistre que quelques-uns. Il faudrait pouvoir tomber sur tout un groupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Un instant, c'est un koholasaure devant. Vous entendez ses griffes gratter la pierre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Les koholasaures sont sensibles, alors ne nous approchons pas trop. Je vais demander à des professionnels de ma tribu de récupérer ce dont j'ai besoin plus tard. Ils sauront comment faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Oh... Des guerriers tribaux s'affrontent. Pas mal... Les bruits qui en résultent sont excellents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Eh ! Qui êtes-vous ? Qu'est-ce que vous voulez ? Vous cherchez des coups, c'est ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Guerrier tribal énervé"
				},
				{
					"id": 250270407,
					"content": "On cherche juste... à récupérer de l'inspiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
					"content": "Récupérer de l'inspiration ? Je vais vous inspirer, moi !",
					"roleType": "TALK_ROLE_NPC",
