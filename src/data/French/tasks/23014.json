				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Monsieur, encore une fois, je suggère fortement de trouver un moyen de payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Ces marchands, c'est du vol ! Pourquoi ces badges sont-ils aussi chers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Peut-être parce qu'ils ont remarqué que vous aviez les yeux qui brillent dès que vous les voyiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Qu'avez-vous l'intention de faire avec ces badges ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Vous arrivez toujours à pic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Grâce à votre aide, je vais pouvoir bientôt enfin créer un lubrifiant utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Je me suis heurté à un nouveau problème. Je l'ai découvert lorsque j'ai fabriqué certaines pièces... Si je les fabriquais dans un matériau trop dur, elles avaient tendance à endommager d'autres composants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "De plus, les pièces trop dures se fissuraient de manière plus ou moins importante, même avec un léger impact...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Alors, j'ai commencé à chercher des matériaux qui pouvaient être à la fois durs et souples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Après de longues recherches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "... Et le harcèlement constant de monsieur Ahangar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "... J'ai finalement découvert que les badges que portent les Pilleurs de trésors pouvaient contenir le matériau que je recherchais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Mais... Ces marchands sont comme les Pilleurs de trésors, de véritables voleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "À mon tour de jouer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Je devrais vraiment faire graver votre nom sur le palier principal de l'Arithmétrice ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Je vais vous en trouver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
