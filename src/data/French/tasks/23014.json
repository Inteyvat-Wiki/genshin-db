				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "Argh... Lutong, venez me soutenir un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Monsieur, vous feriez mieux de rentrer et de dormir un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous tombez à pic ! Venez, j'aurais besoin que vous me donniez un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "Que lui est-il arrivé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Pour faire simple... Monsieur Garcia a bu trop de café et ne dort pas assez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Encore heureux, ce n'est pas de l'alcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, euh... Nous... Nous devons encore chercher quelques badges... Ceux que portent les Pilleurs de trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Désolé, je ne vous avais pas {M#vu}{F#vue}. Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Vous voulez bien aller me chercher ces badges ? Quelques-uns suffiront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "Rentrez donc vous reposer un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Ne vous en faites pas, je vais bien. J'ai les idées très claires... Ce sont juste mes mains qui ont du mal à suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145514,
					"content": "Bref, ramenez-nous quelques badges, s'il vous plaît. Je vous offrirai une récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Une fois que vous les aurez, ramenez... Ramenez-les-moi directement. Je veux regarder ça de plus près. Cette fois-ci, je vais pour que ce roulement soit parfait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145512,
					"content": "Regardez dans quel état tout ce café vous a mis !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "Le café n'y est pour rien. Monsieur Garcia refuse de dormir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
		},
