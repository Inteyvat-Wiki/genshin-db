				"points": []
			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "Nous devons trouver un moyen de gagner de l'argent, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "J'ai entendu dire qu'il y avait un théâtre dans la Ville de Sumeru et que de nombreuses troupes là-bas avaient besoin de quelqu'un pour faire des calculs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "En plus, ces acteurs de troupe... Vous savez, ils gagnent beaucoup d'argent, mais ils ne savent pas comment gérer leurs comptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "C'est notre chance, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Votre talent pour la comptabilité et les affaires est stupéfiant, cher Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Attendez, laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
