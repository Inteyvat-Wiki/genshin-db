					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000401,
					"content": "Je peux vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Ce n'est pas une mauvaise idée... Et puis, vous avez de l'expérience en la matière à présent. Vous m'avez certainement impressionnée la dernière fois, haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000403,
					"content": "Il se trouve qu'il me reste justement certains ingrédients. J'irai m'installer dans la cuisine du chef Mao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Allez d'abord me cueillir trois plants de menthe, et faites-en de l'huile essentielle à la table de synthèse. Vous devez savoir comment faire, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000405,
					"content": "Donnez-moi ensuite l'huile, et je m'occuperai du parfum de Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
