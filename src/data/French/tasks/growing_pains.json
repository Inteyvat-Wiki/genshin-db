			"dialogs": [
				{
					"id": 225000601,
					"content": "Alors, tu as mon parfum ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000602,
					"content": "Tiens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "Ah, merci ! Ying'er fait vraiment les meilleurs parfums !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000604,
					"content": "Je me demande quelle sera la réaction de Fei et Petit Meng quand ils le sentiront...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000605,
					"content": "Mais ça devraît être rigolo dans tous les cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "Lulu"
				},
				{
