			},
			"dialogs": [
				{
					"id": 225000501,
					"content": "Voilà, le parfum est prêt. C'est un parfum à base d'huile essentielle de menthe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000502,
					"content": "Tenez, prenez-le et donnez-le à Lulu pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000503,
					"content": "OK.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Pourquoi utiliser de l'huile essentielle de menthe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Cela permet de contrer certains effets hum... stimulants de ce genre de senteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000506,
					"content": "Pour tout vous dire, j'ai été assez surprise que Lulu me passe commande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000507,
					"content": "Ça me remémore mes jeunes années... Le premier amour, un jeune cœur épris... Ah, si seulement j'en avais plus profité alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000508,
					"content": "Hum. Mais je m'égare. Tenez, vous pouvez donner ça à Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
