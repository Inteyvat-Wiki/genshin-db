				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "Ça devrait être prêt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000102,
					"content": "Alors, tu ne joues pas aujourd'hui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "#{NICKNAME} ? Tiens, salut. Non, on joue pas beaucoup en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000104,
					"content": "Petit Meng est de mauvaise humeur et préfère rester tout seul, et Fei arrête pas de disparaître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000105,
					"content": "J'ai demandé pourquoi à Petit Meng, et il m'a rien dit... Ils sont bizarres en ce moment tous les deux, je sais pas ce qu'ils ont.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000106,
					"content": "C'est comme ça quand on grandit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "On arrête d'être heureux quand on devient adulte ? Mais Petit Meng et Fei sont pressés de grandir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000108,
					"content": "Si c'est comme ça, alors je veux jamais grandir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000109,
					"content": "Enfin, je veux plus en parler. J'aurais besoin de ton aide, en fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000112,
					"content": "Est-ce que tu peux aller récupérer quelque chose chez Ying'er ? Elle est au courant, et elle a dû laisser quelque chose pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000113,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "#Super ! Alors je compte sur toi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000115,
					"content": "Chez Ying'er, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "Oh, je sais pas à quoi tu penses, mais tu te trompes ! J'ai juste demandé à Ying'er de faire quelque chose pour moi, et elle a dit oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000117,
					"content": "Je te demande juste d'aller chercher ça pour moi, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000110,
					"content": "Toi aussi, tu n'es pas contente ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Moi ? Oh, ça va, mais... j'aurais quand même besoin de ton aide pour quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Lulu"
				}
			]
		},
