				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "3 000 moras, ça fera l'affaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Eh bien, quelle impatience... D'accord, je vais m'occuper du parfum de Lulu, au nom de notre amitié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "Mais il faudra attendre le soir : je suis occupée au magasin pendant la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Revenez me voir ce soir, ce sera prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
			"id": 2250004,
