			"trigger": {
				"objectNames": [
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "Ah tiens, vous revoilà. Qu'est-ce qui vous amène cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Je viens de la part de Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Ah oui, c'est vrai. Elle m'a demandé de lui préparer un parfum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "#Mais vous arrivez au mauvais moment, j'ai peur. J'ignore bien pourquoi, mais depuis que vous êtes {M#venus}{F#venues} la dernière fois, les gens se disputent pour acheter mes produits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Je croule sous les commandes, et je dois en plus m'occuper du magasin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "Et puis Lulu n'est qu'une petite fille, je ne peux pas lui donner le même genre de parfum que je vends aux adultes, ça serait assez malvenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "J'ai dû trouver une recette qui ferait l'affaire, mais je n'ai malheureusement pas encore eu le temps de m'y mettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Si c'est pressé, ce n'est pas impossible, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
