			"dialogs": [
				{
					"id": 727310701,
					"content": "Je vois... Eh bien, affrontons-nous à nouveau. Cette fois, je percerai toutes tes tactiques à jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310702,
					"content": "La victoire ou la défaite m'importent peu désormais, c'est l'amusement que j'en tire qui compte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310703,
					"content": "Ce n'est pas tous les jours que je trouve un adversaire à ma taille. Il serait dommage de ne pas continuer, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310704,
					"content": "Amène-toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310705,
					"content": "Mais tu te mets le doigt dans l'œil si tu crois pouvoir percer à jour mes tactiques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310706,
					"content": "Si tu admets que je suis le meilleur expert en combats de scarabées, je t'affronterai autant que tu voudras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310707,
					"content": "Hum, le vacheron et le Grand Maître Hanakado n'ont pas terminé... Laissons-les s'affronter autant qu'ils le veulent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
