			"dialogs": [
				{
					"id": 727310201,
					"content": "Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310202,
					"content": "Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310203,
					"content": "Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "Formidable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Ton style de combat est complètement différent du mien, mais la même passion nous anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310206,
					"content": "Avec un peu de temps, tu deviendras un véritable champion du milieu des combats de scarabées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310207,
					"content": "Tu t'en sors plutôt bien aussi ! Après tout, ça te fait 570 victoires sur 1 141 combats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "De tous les marathons de combats auxquels j'ai participé, celui-ci a été le plus long ! T'es pas mal comme adversaire, je l'admets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "J'ai gagné 571 fois, alors c'est moi qui suis devant. En plus, tu avais l'avantage de jouer à domicile, alors je suis clairement le meilleur de nous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310210,
					"content": "Pourquoi tu chipotes comme ça ? Je me souviens bien du score et Mamoru en est témoin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "Pas vrai, Mamoru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Patron... Je n'en peux plus... Laissez-moi dormir un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "Ils ont enchaîné tous ces combats sans faire aucune pause ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "Ils ont tout enchaîné sans faire une seule pause ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "L'arène doit être sur le point de s'écrouler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "Bon, d'accord ! Dans ma grande mansuétude, je te cède une manche. Je n'aurais qu'à te battre lors de la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "Et on peut même aller s'affronter chez toi ! Je te prouverai que c'est une question de talent et pas de lieu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "Cela me convient. Suis-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727310220,
					"content": "#Oh, mon {M#ami}{F#amie} et le petit melon lavande volant ! Vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "Hein ? Je suis redevenue « le petit melon lavande volant » ? Il n'y a que quand je me bats pour toi que j'ai droit à un joli surnom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "On en reparle plus tard ! Voici les bons pour deux mois de bols de ramen gratuits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "Des bons ? Ah, mais bien sûr ! Les ramen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "Là, je te reconnais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "C'est l'heure de faire la fête !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "Pas du tout ! Ce n'était que l'échauffement, l'événement n'a pas encore commencé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "Il n'y a pas d'ambiance sans public ! On ne peut pas laisser les choses se terminer comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "En tout cas, le Grand Maître Hanakado a admis que j'étais un expert de combats de scarabées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Par contre, je n'en ai pas fini avec lui. J'irai l'affronter seul à domicile, c'est là que je vais le battre une bonne fois pour toutes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "Le moment venu, il devra obéir à mes ordres et m'aider à faire de « L'extraordinaire et exaltante bagarre extrême de scarabées du sublime Arataki » l'événement le plus grandiose de tous les temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "#Merci encore à {M#tous}{F#toutes} les deux. Attendez que je revienne avec de bonnes nouvelles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "Héhé, le vacheron a l'air de s'éclater comme un petit fou et nous avons deux mois de bols de ramen gratuits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "Tout le monde est gagnant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "Patron ! Une lettre de Shinobu ! Lisez-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "Hein ? Où est-il passé ? Il était là tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "C'est urgent ? Le vacheron vient de partir avec le Grand Maître Hanakado. Ils vont continuer les combats autre part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Non, mais c'est assez inattendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "Vous pouvez lire cette lettre si vous le voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "Quoi ? Le Grand Maître Hanakado fait partie du gang Arataki ? Pourtant, on aurait dit qu'il était l'ennemi ultime du vacheron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Et comme Shinobu l'avait prévu, il passe son temps à faire des combats de scarabées sans prendre le temps de se reposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "Il nous a demandé d'organiser l'événement, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "Je n'appelle pas ça du repos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "Tu sais, je trouve que Shinobu mérite les bons de ramen plus que nous ! On devrait l'inviter à en manger quand elle reviendra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Hum, attends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "#Le vacheron ne nous a pas dit à quel restaurant nous sommes {M#censés}{F#censées} les utiliser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "... Ne me dis pas qu'on doit le trouver nous-mêmes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "Tout le monde est content...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "L'événement se termine en beauté !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "Les pauvres scarabutos doivent être épuisés...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
