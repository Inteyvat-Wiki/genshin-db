			"dialogs": [
				{
					"id": 750280101,
					"content": "Tss, tu es... plus tenace que tu n'en as l'air...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Souris"
				},
				{
					"id": 750280102,
					"content": "*soupir* Qui avons-nous offensé, qui enverrait quelqu'un nous donner une leçon, un jour comme aujourd'hui en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Oiseau de nuit"
				},
				{
					"id": 750280103,
					"content": "En quoi vous avons-nous offensé ? Dites-nous, s'il vous plaît, et nous ne le ferons plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Oiseau de nuit"
				},
				{
					"id": 750280104,
					"content": "Espèce de canaille ! Tu vas vraiment t'écraser devant ce genre de personne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Souris"
				},
				{
					"id": 750280105,
					"content": "Quoi, tu crois vraiment que faire le dur va nous permettre d'être épargnés ? Ne commence pas, je te préviens. Nous vivons comme des voleurs et des escrocs. Il n'y a rien de spécial dans le trafic de sauriens, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Oiseau de nuit"
				},
				{
					"id": 750280106,
					"content": "Plutôt que de nous faire voler par un escroc plus fort, pourquoi ne pas plutôt les rejoindre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Oiseau de nuit"
				},
				{
					"id": 750280107,
					"content": "#{M#Monsieur}{F#Madame}, ce n'est pas pour me vanter, mais je suis sûr que je vous serais bien plus utile que ces deux-là. Dites-moi si vous avez besoin de quelque chose et je m'occuperai de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Oiseau de nuit"
				},
				{
					"id": 750280108,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Il se trouve que je cherche quelqu'un pour m'aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "J'espère que tu plaisantes ?! J'y suis formellement opposée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "De plus, nous sommes les gentils ici. Il est hors de question que nous fassions équipe avec vous, des trafiquants de sauriens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Oui, il n'y a pas de meilleure personne que moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Bref ! Quels que soient les projets que vous avez pour les sauriens, je vous conseille d'arrêter sur le champ, ou nous... Eh bien, {NICKNAME} vous montrera de quel bois on se chauffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Les deux trafiquants repartent dans un nuage de ressentiment...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Je me demande comment va ce qucusaure. Devrions-nous y aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Eh bien, il y a toujours de la place pour une personne supplémentaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Hé, tu vas avoir une mauvaise influence sur {REALNAME[ID(2)|SHOWHOST(true)]} ! Ne t'inquiète pas, petit gars, il n'est pas possible que nous fassions équipe avec cette bande !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Ouh... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Merci pour votre gentillesse, mais ce n'est pas nécessaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
