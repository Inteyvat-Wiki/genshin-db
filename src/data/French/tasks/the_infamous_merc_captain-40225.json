			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "Une minute, c'est...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "L'Alcor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "En fait, c'est le deuxième navire de notre flotte. L'Alcor est resté au pays, il patrouille dans la Forêt de pierre de Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Beidou ! La célèbre capitaine mercenaire qui sillonne les mers !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Euh, oui, haha. On se connaît, tu as oublié ? Pas besoin de tout ce cérémonial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "C'est une longue histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "#Bon, ça ne sert à rien de rester {M#plantés}{F#plantées} là. Asseyez-vous et racontez-moi tout ça. Je vais demander à mes gars de vous accueillir comme il se doit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ah, je vois. Alors comme ça, vous connaissez la grande patronne du Curatorium, hein... Votre réseau de contacts, c'est vraiment quelque chose, ça c'est sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "À propos de l'inscription...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Ah oui ! Nous devons enregistrer les participants à l'exposition et ce qu'ils comptent vendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Eh bien, inscrivez-moi ainsi que quelques membres de mon équipage comme participants... Les autres resteront sur le navire. Quant à ce que nous vendons... Jetez un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Il y a quelque temps, Ningguang a modernisé la baliste de Guizhong. La beauté que vous voyez ici est l'un de ses nouveaux modèles améliorés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "Sa puissance de feu est démentielle, et elle est équipée d'un système de guidage à distance pour des frappes précises même à longue portée. Je suis sûre que les gens vont se battre pour mettre la main dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Vous êtes sûre que vous avez le droit de vendre ce genre de trucs ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Haha, ne t'inquiète pas. Comparé au modèle utilisé par les Millelithes, celui-ci est pratiquement une antiquité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "... Nefer ne plaisantait pas quand elle a dit « sans restrictions », hein...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Mais qui voudrait acheter un truc pareil ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Oh, je suis sûre que quelqu'un mordra à l'hameçon. Après tout, des acheteurs de tout Teyvat seront présents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "... Yelan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, désolée. J'étais tellement occupée avec la cargaison que j'ai oublié de mentionner que Yelan était à bord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "Pas de souci. Vous êtes aussi là pour l'exposition, Yelan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "Non, je suis simplement là pour le travail. La capitaine Beidou a eu la gentillesse de m'emmener ici. Inutile de m'inscrire à l'exposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Quoi qu'il en soit, ça faisait un moment, {NICKNAME}. Si vous en avez l'occasion, n'oubliez pas de transmettre mes salutations à la patronne du Curatorium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "Quel genre de travail ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "Le genre de travail... sensible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "On dirait que c'est le signal pour arrêter de poser des questions, non...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "À cent pour cent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Bon, j'y vais alors. Une fois que j'en aurai fini avec ça, j'inviterai tout le monde à boire un verre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Il était temps ! J'avais hâte de découvrir Nod-Krai à travers ses boissons, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Bien, l'inscription est terminée. Suivez-nous, nous allons vous conduire sur le lieu de l'événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
