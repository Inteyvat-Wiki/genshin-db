			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou ordonne à son équipage de décharger la cargaison et vous suit jusqu'au lieu de l'événement.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Alors, c'est ici ? Pas mal comme endroit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Quand tu auras un moment, viens m'aider à tester le guidage à distance de cet engin. C'est un vrai plaisir... Tu vas adorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
