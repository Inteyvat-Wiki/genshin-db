			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "Bienvenue au Salon de thé Komore ! Je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010202,
					"content": "À propos de Ramsay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "Ah, cet homme d'affaires... Il est dans notre salon de thé. Mais il a l'air stressé ces derniers jours. Je ne sais pas ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010204,
					"content": "Si vous voulez le trouver, entrez et vous le verrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kozue"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "#Vous êtes... {M#un voyageur}{F#une voyageuse} ? Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010302,
					"content": "À propos de vos récits de voyage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "Ah, vous parlez des récits de voyage que j'ai écrits pour Midori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010304,
					"content": "J'ai été trop occupé ces derniers temps. Elle doit être anxieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010305,
					"content": "Est-ce que ces récits de voyage sont authentiques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Hahaha, qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010307,
					"content": "Je ne crois pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Hahaha, je peux voir que vous avez beaucoup voyagé. Ça se voit tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010311,
					"content": "C'est vrai. En fait, rien dans mes récits n'est réel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010312,
					"content": "Bien que certains lieux et personnages existent, la plupart du contenu est issu de ma propre imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010313,
					"content": "Bien sûr, certaines parties ne sont pas entièrement imaginaires. Par exemple, dans le récit de voyage que j'écris, quelqu'un a fabriqué un super ballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010314,
					"content": "Il a donc convoqué ses amis et a prévu de faire le tour de Teyvat en 80 jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010315,
					"content": "De plus, ce ballon ne nécessite pas d'œil divin pour fonctionner. Il suffit d'avoir quelques connaissances techniques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010316,
					"content": "Ces personnes voyagent autour du monde en ballon, et rencontrent en chemin diverses choses et phénomènes étranges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010317,
					"content": "Voilà ce que j'allais écrire pour Midori. Mais il se trouve que je n'ai même pas eu le temps de finir un seul paragraphe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010318,
					"content": "Pourquoi cela ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Vous voyez le type là-bas dans le hall ? Il s'appelle Heihachi. Je ne sais pas pourquoi, mais il fixe son regard sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010320,
					"content": "J'allais sortir et chercher de l'inspiration pour mon récit, mais il me suivait tout le temps. Je ne sais pas ce qu'il veut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010321,
					"content": "J'ai peur qu'il ait de mauvaises intentions. Je n'ose pas me promener à l'extérieur. C'est pourquoi le récit a été retardé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010322,
					"content": "#Mais, heureusement que vous êtes ici maintenant. {M#Voyageur}{F#Voyageuse}, voulez-vous m'accompagner pour chercher de l'inspiration à l'extérieur ? Avec vous, je ne pense pas qu'il ose faire quoi que ce soit contre moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010323,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010327,
					"content": "Comme on dit souvent, « Il faut se prémunir contre les autres ». S'il y a quelqu'un qui me regarde par-derrière, je dois me protéger contre lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010328,
					"content": "Alors pendant que je cherche de l'inspiration, protégez-moi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010329,
					"content": "En fait, j'ai trouvé quelques endroits, allons-y maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010330,
					"content": "Le premier endroit est la plage près d'ici. Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010325,
					"content": "Pourquoi fait-il ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Je ne sais pas... Mais les gens n'ont pas besoin d'une raison pour être malveillants envers quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010309,
					"content": "J'espère que c'est vrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Hahaha, j'aimerais que mes histoires puissent se réaliser aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				}
			]
		},
