			"dialogs": [
				{
					"id": 728011301,
					"content": "Vous pouvez voir presque toute l'Île de Narukami en vous mettant au sommet de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011302,
					"content": "Le vent au sommet est assez fort, et la hauteur est parfaite pour décoller. De plus, il n'y a pas d'obstacles ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011303,
					"content": "Et c'est loin de la Cité d'Inazuma, nous ne serons pas dérangés par le doushin... ou par des personnes non concernées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011304,
					"content": "C'est vraiment un endroit idéal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "En tout cas, c'est un endroit idéal pour décoller... Et aussi un bel endroit à décrire dans mon récit de voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011306,
					"content": "Ce type... Il nous suit toujours, il ne veut pas nous lâcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011307,
					"content": "Je vais me débarrasser de lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "Ce n'est pas grave, ne vous inquiétez pas pour lui. Il n'oserait pas vous faire quoi que ce soit par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011309,
					"content": "De plus, quand on a affaire à des gens comme ça... Si vous l'approchez, il continuera à vous harceler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011310
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011310,
					"content": "Bref, notre petit voyage est terminé. Retournons au Salon de thé Komore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
