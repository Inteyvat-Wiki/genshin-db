					"nextDialogs": [
						728011403
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011403,
					"content": "Lorsque j'aurai terminé toute l'histoire, je demanderai à quelqu'un de lui amener les récits de voyage complets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011404
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011404,
					"content": "Des récits de voyage... Hmpf, ça c'est ce qu'il dit. Comment savoir s'il cache quelque chose...",
