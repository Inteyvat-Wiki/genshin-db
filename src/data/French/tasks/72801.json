			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "La mer est cristalline, et la couleur du sable est si blanche. Elle est très différente de celle de la pleine mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Ce serait un bel endroit pour mettre les voiles... ou décoller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "*tousse* Les paysages sont plutôt beaux, laissez-moi prendre des notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "#{M#Voyageur}{F#Voyageuse}, veuillez attendre un moment. Je dois réfléchir à la manière d'écrire mon récit de voyage. Vous pouvez vous promener par ici et profiter du paysage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "Mais s'il vous plaît, ne vous éloignez pas trop de moi. Ce type, Heihachi, me suit. Il est juste là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
