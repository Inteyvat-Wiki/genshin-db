					"nextDialogs": [
						728011406
					]
				},
				{
					"id": 728011406,
					"content": "Moi, je dis que ce type doit avoir une idée derrière la tête pour écrire ces récits de voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011407
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011407,
					"content": "Qui penserait à des absurdités pareilles ? Voyager en Teyvat en montgolfière sans œil divin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011408
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011408,
					"content": "Il doit avoir de mauvaises intentions... Il me reste juste à découvrir de quoi il retourne...",
