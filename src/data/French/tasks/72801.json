					"nextDialogs": [
						728011506
					]
				},
				{
					"id": 728011506,
					"content": "Ah, vraiment ? J'attendrai qu'oncle Ramsay ait terminé pour le lire... J'aurai alors une nouvelle histoire à raconter à Kouichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011507
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011507,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Ceux-ci sont pour vous. Acceptez-les, s'il vous plaît.",
