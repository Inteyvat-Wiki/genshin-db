			"dialogs": [
				{
					"id": 402130101,
					"content": "C'est ma faute, capitaine ! Une personne extérieure qui s'est approprié un objet du Bureau d'études... Je ne peux pas croire qu'un tel affront ait eu lieu. Je ferai la lumière sur cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130102,
					"content": "C'est inutile. Reprends le bâtiment avec l'aide de tes troupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "Poruchik-kapitan"
				},
				{
					"id": 402130103,
					"content": "Pas d'enquête ? C'est un ordre de la hiérarchie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130104,
					"content": "Pas d'enquête. C'est compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "Poruchik-kapitan"
				},
				{
					"id": 402130105,
					"content": "Oui, capitaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130106,
					"content": "Hm ? Que faites-vous ici ? Ce lieu est la propriété du Bureau d'études expérimentales du kuuvahki. Les personnes extérieures ne sont pas autorisées à y accéder.",
					"roleType": "TALK_ROLE_NPC",
