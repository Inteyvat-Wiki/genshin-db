			"dialogs": [
				{
					"id": 752520701,
					"content": "Auriez-vous vu un type chauve dans le coin ? Je dois lui parler de quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Je le recherche aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Oh, il était là à l'instant ? Il a dû me voir arriver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Tu vas me le payer, Icahua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Comme on se connaît déjà, je vous conseille de vous tenir à l'écart de ce vaurien déficient en follicules capillaires. Sinon, votre joli visage risque de se retrouver couvert de peinture rouge et blanche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Voici les objets que j'ai trouvés dans son camp. Je suppose qu'il n'a pas eu le temps de les emporter avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "Tenez, c'est pour vous. Ne vous en faites pas, il n'a rien à dire sur le sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Tôt ou tard, il me le paiera de sa vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "#Je ne l'ai pas vu, {M#désolé}{F#désolée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Vous me dites la vérité ? Vous avez la tête de quelqu'un d'honnête, alors je vous fais confiance pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
		}
