					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650102,
					"content": "Columbina... Vous êtes là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "Hmm, et maintenant vous êtes là aussi. Alors je suppose qu'on est ici ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650104,
					"content": "On dirait que vous saviez que je viendrais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "Je ne savais pas quand, mais je savais que vous finiriez par venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650106,
					"content": "Tout comme la lune et Teyvat s'attirent inlassablement... Vous finissez toujours par me retrouver, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650107,
					"content": "Venez, asseyez-vous avec moi un moment. Je vous ai gardé une place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650108,
					"content": "#La dernière fois qu'on s'est assis{F#es} sur votre vaisseau, on a regardé Teyvat. Cette fois, regardons les étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650109,
					"content": "Ninnin et ceux qui l'ont précédée étaient attirés par ces étoiles. Il doit y avoir une gravité différente, là-bas. Je la sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650110,
					"content": "Ninnin et le message qu'elle a envoyé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Ne vous inquiétez pas. Elle n'est pas en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650112,
					"content": "Elle a voyagé très, très loin en toute sécurité... Si loin que je ne peux plus percevoir le pouvoir dont je me suis servi pour la guider sur son chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650113,
					"content": "Mais... je suis curieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650114,
					"content": "À propos de quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Toutes sortes de choses. Par exemple... Est-ce qu'un message envoyé par un Lunologue pourrait être reçu par quelqu'un d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650116,
					"content": "Celui qui le reçoit... Ou quoi que ce soit d'autre qui puisse le recevoir... Qui pourrait-il bien être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650117,
					"content": "Que penserait-il ? Connaîtrait-il l'amour et la haine, tout comme nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650118,
					"content": "Serait-il encore attiré par le ciel, si beau et pourtant si mystérieux, même avec l'abîme qui se referme autour de lui, tout comme nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650119,
					"content": "Est-ce qu'il voudrait aussi, comme nous, trouver d'autres êtres, leur faire signe et leur dire : « Bonjour, ami. Je suis heureux de te rencontrer » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650121,
					"content": "Là-bas, dans les profondeurs de ce ciel étoilé... Existe-t-il encore des civilisations épargnées par les ténèbres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650122,
					"content": "Je pense que oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650124,
					"content": "Notre vaisseau a reçu un message, un jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Quel genre de message ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650126,
					"content": "Le contenu utile a l'air d'avoir été perdu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Mais ça devait provenir d'une civilisation intelligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Perdu... Est-ce parce qu'il avait voyagé trop loin...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650129,
					"content": "Mais cela reste suffisamment encourageant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650130,
					"content": "#Au fait, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650131,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "#Là où vous êtes {M#né}{F#née}... Cet endroit est quelque part là-bas, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650133,
					"content": "Si vous souhaitez un jour revenir à l'endroit où vous avez commencé votre voyage, pour le nettoyer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650134,
					"content": "Je serais ravie de vous aider, tout comme vous m'avez aidée à nettoyer la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650135,
					"content": "Je n'oublierai pas de vous inviter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "Et on fera une autre fête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650137,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650139,
					"content": "Que diriez-vous de l'appeler « Nuit du retour » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650140,
					"content": "Et si c'était pendant la journée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "On s'amusera jusqu'au soir. On pourra inviter tous nos amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650142,
					"content": "Ça va être marrant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "J'espère que cette nuit arrivera par un temps agréable, en compagnie d'amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
}