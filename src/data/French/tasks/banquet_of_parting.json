							"1203102",
							"2"
						],
						"stepId": 1203102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "Descendre de la montagne ? Est-ce une directive de la Guuji Yae ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Oui. Miko s'inquiète pour votre sécurité physique en raison du rituel qui va bientôt avoir lieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Je vois... Je vais évacuer tout le monde immédiatement. Et vous, qu'allez-vous faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "On doit s'occuper de deux ou trois choses pour elle, puis on viendra ici pour effectuer le rituel avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "#Parce que nous voulons aussi être {M#sûrs}{F#sûres} qu'elle sera en sécurité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Il semblerait que la grande prêtresse ait grandement confiance en vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Jusqu'à maintenant, elle n'autorisait la présence de personne lors des rituels importants de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Bonne chance à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "#Ne vous inquiétez pas, on est bien plus {M#forts}{F#fortes} qu'on en a l'air !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Parce qu'on a envie de voir les démons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "#Vous êtes enfin {M#venus}{F#venues}, mes enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "#Miko... Vous n'avez même pas attendu qu'on soit là pour commencer à manger{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Effectivement. Parce que c'est vous qui régalez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "Rien que de penser au fait de pouvoir manger les plats les plus chers et boire les vins les plus fins, tout ça gratuitement... Je ne pouvais pas attendre une minute de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "Monsieur, vous voyez ces deux personnes ? Ce sont elles qui paieront la note tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "Aucun problème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Okazaki Rikuto"
				},
				{
					"id": 120310407,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310408,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Qu'est-ce que vous avez ? Allez, venez vous asseoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Goûtez-moi ça ! C'est un poisson qu'on ne trouve que dans les eaux environnantes de l'Île de Seirai. Il a été livré à la Cité d'Inazuma la nuit dernière, et il était encore vivant à l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "Ou alors peut-être que vous préférerez ça ? C'est un alcool très cher, je n'ose même pas en boire d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "#Mais vous n'êtes pas {M#obligés}{F#obligées} de boire de l'alcool. Il y a aussi une multitude de jus de fruits avec des prix plus ou moins élevés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "Grr... Miko, vous n'êtes pas correcte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "#La dernière fois qu'on est {M#venus}{F#venues} ici pour écrire le livre, vous nous avez juste commandé du kushikatsu de base !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "Ah oui ? Je ne me souviens plus d'une telle chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "Nous, on s'en souvient très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "#Bon, et alors ? C'est vous qui aviez promis de m'inviter au restaurant, n'est-ce pas ? Et puis, ne seriez-vous pas {M#gênés}{F#gênées} de traiter votre invitée d'honneur aussi mal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "Miko, ce repas va coûter excessivement cher. Ça ne vous est pas venu à l'esprit que nous pourrions ne pas avoir assez d'argent pour payer l'addition ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "#Héhé, ne vous en faites pas, vous aurez largement les moyens de vous le permettre. Le roman que nous avons écrit ensemble a été réimprimé. Vous allez être grassement {M#payés}{F#payées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "Q—Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#Aaaah, c'est trop ! {NICKNAME}, Miko nous a {M#piégés}{F#piégées} ! Elle cherche à croquer dans notre part du gâteau depuis le début !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "On s'est fait avoir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Hahahaha, vous devriez voir vos têtes, c'est magnifique ! Hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "Au fait, aucun des vœux formulés par les gens ne s'est réalisé pendant la nuit sans lune, alors les romans avec des incantations ne sont plus du tout en vogue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "#Il va donc falloir que vous trouviez de nouvelles idées pour le prochain chapitre des « Extraordinaires aventures {M#du voyageur}{F#de la voyageuse} ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "#La date limite approche, alors... Je compte sur vous, {M#monsieur l'aventurier}{F#madame l'aventurière}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "#Elle nous a bien {M#eus}{F#eues}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Il n'y avait que du kushikatsu et du tofu frit, c'est tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
