				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "#Bonjour mes enfants. Vous êtes finalement {M#venus}{F#venues}, et à l'heure, en plus. Merveilleux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Hmph, pas le choix, il a bien fallu venir pour notre paie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Miko, que doit-on faire exactement pour que ce « Hyakkiyakou » ait lieu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "D'ailleurs, on n'a aucune idée de ce que c'est, le Hyakkiyakou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Le terme « Hyakkiyakou », ou « défilé nocturne des esprits » peut faire un peu peur, certes. Mais pour résumer, c'est tout simplement une fête pendant laquelle les démons se rassemblent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Autrefois, les démons avaient l'habitude de se retrouver tous ensemble pour faire la fête. Une fois qu'ils avaient bien bu, ils s'envolaient grâce à leurs pouvoirs. Ils étaient si nombreux dans le ciel que leurs silhouettes recouvraient la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Cependant, les souvenirs de démons qui surgissent des lignes énergétiques n'ont que peu de force, et ils sont incapables de voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Mon plan serait donc d'effectuer un rituel d'invocation pour qu'ils puissent tous être réunis en un même lieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Le moment venu, ils se retrouveront dans le ciel au-dessus du Sanctuaire de Narukami. Puis, quand ils auront épuisé leur énergie, ils pourront retourner d'où ils sont venus, le cœur satisfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "J'ai préparé à l'avance tous les éléments nécessaires à ce rituel. Vous vous souvenez de l'incantation et de la mention de la nuit sans lune que j'ai ajoutée à notre roman ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Oui, le roman parlait de réciter les sorts secrets de dame Kitsune lors d'une nuit sans lune, quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Voilà. En vérité, ce n'est pas une incantation qui permet de réaliser des vœux. C'est un sortilège utilisé pour apaiser les souvenirs des lignes énergétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "#Lorsque le moment sera venu, nous mettrons {M#tous}{F#toutes} la main à la pâte pour les raccompagner sur leur chemin du retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "Que dois-je faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Je vais bientôt commencer les préparatifs du rituel. De ton côté, j'ai besoin que tu fasses deux choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Tout d'abord, il faut aller dire aux prêtresses du sanctuaire de quitter la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Il y aura une foule de souvenirs de démons qui flotteront dans les airs aux alentours du Sanctuaire de Narukami pendant le Hyakkiyakou. Il serait un peu gênant que quelqu'un se fasse posséder par inadvertance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Après, je commencerai le rituel et les souvenirs commenceront à se rassembler. Ça va prendre un certain temps et j'ai besoin que vous gardiez un œil sur l'activité des monstres au pied du Mont Yougou pendant cette phase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "D'ordinaire, les souvenirs sont dispersés et ne représentent aucun risque. Mais étant donné que leur énergie sera concentrée en un même endroit, elle risque de perturber les monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Leur instinct va sûrement les pousser à se diriger vers le sommet de la montagne. Votre travail sera de les repousser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "D'accord, c'est compris. Et ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Ensuite ? Hmm... Eh bien, vous pourrez toujours venir au sanctuaire pour donner un coup de main, et ça vous permettra de voir ces démons de près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#D'accord. {NICKNAME}, mettons-nous en route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
