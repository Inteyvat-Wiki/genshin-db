			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, te revoilà enfin ! Les choses deviennent vraiment tendues dans la tribu. As-tu avancé dans ton enquête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Certaines personnes pensent même que nous avons arrêté les marchands uniquement pour soutenir la brigade volante et nous débarrasser des ailes phlogistiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Si les choses continuent à dégénérer même en ayant arrêté les marchands...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Nous avons trouvé des pistes prometteuses, mais il y a un obstacle majeur entre nous et les preuves irréfutables dont nous avons besoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca explique ce que vous avez découvert sur Tepal et votre théorie sur l'atelier aéroporté...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Une relique de la Cité de braise ? Argh... Och-Kan arrive donc encore à semer la discorde, même après toutes ces années...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Un atelier aéroporté... Un ballon au-dessus de l'arène d'épreuve... Et c'est là que vous voulez aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Vous avez une idée de comment y arriver ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "Ni les ailes phlogistiques ni les qucusaures ne peuvent vous emmener aussi haut. Vous pensez vraiment que c'est là que se cache Tepal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Hmm... Il y a peut-être un moyen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Vraiment ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Vous vous souvenez des buses dans l'arène ? Lorsqu'elles étaient toutes bouchées, le phlogistique gazeux s'est retrouvé piégé et ne pouvait plus se répandre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Maintenant, il se disperse librement. Mais si nous les bouchions à nouveau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Vous voulez dire... Toute les boucher, sauf celle tout en haut de l'arène ? Pour y augmenter la pression ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Précisément. Si tout le phlogistique gazeux émane d'une seule buse, ça créerait un courant d'air à haute pression...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "Et nous pourrions l'utiliser pour prendre de l'altitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Oui. C'est risqué, mais avec les compétences de Chasca, je pense qu'elle pourrait y arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "C'est une approche extrêmement risquée... Mais je conviens que c'est réalisable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Si vous voulez essayer, renseignez-vous auprès d'Inkanak sur le lieu de l'épreuve. Elle peut vous expliquer comment boucher les buses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca... Si quelqu'un a une chance d'aller chercher cette preuve du haut des cieux, c'est bien toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "Peut-être qu'ils ne sont pas les seuls à créer des problèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
