	"talks": [
		{
			"id": 1502201,
			"completionStepIds": [
				1502201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502201",
							"2"
						],
						"stepId": 1502201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "D'après ce qu'Allpa nous a dit, Tepal fait partie des Enfants des échos. Mais comment le retrouver ? Simplement... en demandant autour de nous jusqu'à ce que nous le trouvions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Commençons par parler à quelqu'un que nous connaissons. Ce sera plus rapide comme ça. Et là, tout de suite, je parie que la personne la plus facile à trouver est :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Xilonen, on se réveille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*bâille* Ah, c'est vous... Un petit moment, je descends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*bâille* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "On dirait que vous aimez toutes les deux grimper aux arbres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Je grimpe aux arbres pour voler et voir plus loin. Je ne m'arrête généralement pas pour y faire une sieste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "Eh bien, tout le monde n'est pas comme toi. Tu es toujours pleine d'énergie, même après avoir volé toute la journée... Bon, vous avez fait tout ce chemin et interrompu ma précieuse sieste. Puis-je vous demander ce qui vous amène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Je suis désolée, Xilonen, mais ça ne pouvait pas attendre. Le nom Tepal te dit-il quelque chose ? Ce serait un artisan de ta tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal ? Oui, ça me dit quelque chose... Je pense que c'est l'enfant de Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Est-il dans la tribu en ce moment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Non, j'ai bien peur que vous arriviez quelques années trop tard... Pourquoi le cherchez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "C'est une longue histoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Vous essayez d'expliquer brièvement la situation...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "Des ailes phlogistiques ? Waouh, d'accord. Ce gamin y est vraiment parvenu... Eh bien, on dirait que je ne me reposerai plus aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "Il y est parvenu ? Vous voulez dire qu'il n'en était pas à son coup d'essai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Oui, il a commencé à essayer de construire une machine volante dès son retour du Clan des fleurplumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Juste après être devenu un sans-ailes, alors... Cette machine volante était-elle semblable au pistolet que tu m'as fabriqué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Ton arme qui est plus difficile à maîtriser que d'apprivoiser le plus fier des qucusaures ? Non, il voulait construire quelque chose qui permette à quiconque de voler librement, même sans talent naturel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Mais ça n'avait jamais vraiment donné de résultats à l'époque. Il a fait exploser son atelier à plusieurs reprises et s'en est à peine sorti vivant. Je ne lui ai plus trop prêté attention après ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Ses parents ont beaucoup voyagé dans leur jeunesse et ne sont revenus dans la tribu qu'après sa naissance. Mais ils se sont installés dans une région reculée et n'interagissaient pas beaucoup avec les autres membres de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "La plupart des gens ne les connaissaient pas très bien... Le mieux serait de discuter avec sa famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Je vais chercher Puma. Attendez-moi devant mon atelier, ce ne sera pas long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 1502202,
