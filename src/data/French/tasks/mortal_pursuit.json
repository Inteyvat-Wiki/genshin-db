				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Peu de temps après, à l'atelier de Xilonen...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Me revoilà. Permettez-moi de vous présenter la mère de Tepal, Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Bonjour ! Nous sommes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Allons droit au but. Je ne veux pas parler de ce garçon plus longtemps que nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "Hein...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "Je l'ai renié il y a longtemps... Ce n'est plus mon enfant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Tout ce qui l'intéressait, c'était son rêve d'atteindre le ciel... Nous avons essayé de lui faire entendre raison, mais c'était une véritable obsession !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hmph... Puis, quand il nous a quittés, il a débité des bêtises sur la construction d'un atelier aérien pour éviter d'être constamment critiqué par nous, les gens d'en bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Il a laissé ces notes. Quelles que soient vos questions, vous pouvez y chercher vos réponses. Je ne veux plus parler de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Ce n'est pas mon fils... Il ne m'a jamais appelé « maman » de toute façon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Waouh, ils se sont vraiment brouillés... Je ne m'attendais certainement pas à ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Son mari, le père de Tepal... est décédé récemment. Tepal ne s'est même pas donné la peine d'assister aux funérailles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Si vous voulez mon avis, c'était probablement la goutte de trop pour Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Je vais lui tenir compagnie. Venez me trouver si vous avez besoin d'autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Ces notes sont donc la seule piste que nous avons pour le moment. Qu'y a-t-il d'écrit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hmm... Ses premières idées pour les ailes phlogistiques... et quelques théories sur un atelier aéroporté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, la Cité de braise... On dirait que c'est de là qu'il a puisé son inspiration technologique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Alors, il était sérieux à propos de l'atelier aérien ? Mais c'est un projet monumental pour une seule personne... Tu penses vraiment qu'il y est parvenu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Eh bien, ce dessin de ballon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "... Oh, mais oui ! C'est celui qui était au-dessus de l'arène de l'épreuve de vol et qui était super haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Ce ballon est là depuis un moment et tout le monde se demande comment il est arrivé aussi haut. Mais... Et si nous ne nous posions pas la bonne question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Et s'il était encore plus haut avant, au-dessus des nuages et hors de vue ? Et qu'il n'était descendu à sa hauteur actuelle qu'en raison d'une sorte de dysfonctionnement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "En d'autres termes, ce pourrait être...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "... Une partie de l'atelier de Tepal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "C'est possible. Si la base de Tepal était cachée au-dessus des nuages pendant tout ce temps, ça expliquerait certainement pourquoi Isidore n'a pas pu la localiser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Je le savais depuis le début... Mais, euh, comment pourrions-nous y accéder ? Tu pourrais voler aussi haut, Chasca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "#Seule... Peut-être. Mais avec {NICKNAME} comme {M#passager}{F#passagère}, aucune chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Je doute que même les ailes phlogistiques permettent de voler aussi haut... Du moins, pas sans cette « relique » que Tepal mentionne dans son journal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Et il y a de grandes chances pour qu'il la garde précieusement... Il va falloir trouver un autre moyen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Et toi, Paimon, peux-tu voler aussi haut ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Non, c'est bien au-delà de mes compétences ! Et puis, tu voudrais vraiment que j'aille là-haut et que j'affronte Tepal seule ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Ce n'est pas grave. Ce n'est pas parce que nous ne trouvons pas de solution que personne ne le peut. Je ne suis pas la seule experte en vol de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Tu as raison. Nous devrions aller demander à l'aînée Allpa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "Et à Mutota. Il était aussi un véritable as du vol à l'époque. Retournons à la tribu et voyons ce qu'ils suggèrent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Est-ce que nous n'aurions pas déjà vu ça quelque part ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
