			"dialogs": [
				{
					"id": 150221101,
					"content": "Vous vous précipitez vers l'arène de l'épreuve et expliquez la situation à Inkanak...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Bon sang... C'est une idée très audacieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "Peut-être, mais nous devons agir vite. Quel est le moyen le plus rapide de boucher les buses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "D'un point de vue technique, je devrais vous conseiller de commencer par prendre quelques mesures et de minutieusement planifier tout ça... Mais je suppose que ce n'est pas ce que vous voulez entendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "... Alors, nous devrons adopter une approche un peu brute, mais efficace. Vous voyez le phlogistique solide là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "Nos inspections précédentes ont révélé qu'une sorte de structure stable s'est formée à l'intérieur, ce qui la rend très résistante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Il y a des points faibles. Mais à moins de les attaquer tous en même temps, l'intégrité structurelle ne sera pas menacée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Et... Que se passera-t-il si nous les frappons tous en même temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Ça va s'effondrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "... D'accord, je vois où tu veux en venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "C'est ça ! Tant que vous attaquez tous les points faibles en même temps sous le bon angle, le phlogistique solide tombera juste au-dessus de la buse et la bouchera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "Tu avais raison à propos de l'aspect « brut mais efficace »... C'est le genre de plan qui me plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
