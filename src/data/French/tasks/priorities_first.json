			"dialogs": [
				{
					"id": 760000201,
					"content": "Hmm... On dirait que cette porte ne veut pas s'ouvrir, mais je suis curieuse de savoir ce qui se cache derrière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000202,
						760000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000202,
					"content": "Ce n'est probablement rien d'important...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "Étant donné son emplacement, tu as sans doute raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000206,
					"content": "Bref, on doit trouver un moyen d'entrer pour voir ! Sinon, je ne vais pas arrêter d'y penser, comme si j'avais le ventre plein de hot-dogs de Nod-Krai que je ne pouvais pas digérer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000207,
					"content": "La porte est verrouillée, mais il y a peut-être une autre solution ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000204,
					"content": "Peut-être qu'il y a une expérience machiavélique qui se déroule à l'intérieur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000205
					]
				},
				{
					"id": 760000205,
					"content": "Une expérience machiavélique... Si c'est le cas, la sécurité est nulle ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				}
			]
