			"trigger": {
				"objectNames": [
					"Verut",
					"Lovi",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "C'est mon tour d'être le loup. Je suis sûr que je vais t'attraper, Lovi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Je n'en suis pas si sûre. Il y a des endroits où même toi tu ne peux pas grimper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Ça... C'est parce que je n'ai pas les bonnes chaussures. Sinon, je pourrais t'attraper, c'est sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "Retirons tous les deux nos chaussures alors, comme ça, ce sera équitable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "C'est hors de question ! Vous n'allez pas courir pieds nus. Le sol est jonché de choses et d'autres, vous pourriez vous couper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060106,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Frangin, tu avais l'air distrait tout à l'heure, je suis passé à côté de toi, et tu n'as même pas réagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Ah bon ? Je n'avais pas remarqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060110,
					"content": "Oui, j'ai fait tout un tour tout à l'heure, mais c'est comme si tu ne m'avais même pas vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "Hein ? C'est vous ! Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060112,
					"content": "Qu'est-ce que Lovi fait ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Mes deux parents sont occupés à cause de leur travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Aurèle est passé pour rapporter un livre, alors mon père lui a demandé de s'occuper de moi, et je suis venue ici pour jouer avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Bref, continuons à jouer. C'est à qui d'être le loup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060119,
					"content": "Je pensais que tu n'aimais pas jouer à cache-cache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Hmm... *tousse* C'est parce que j'ai commencé à essayer d'écrire une revue de presse, et je dois réfléchir à quelques points.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060122,
					"content": "Je me suis rendu compte que... mon esprit fonctionnait mieux lorsque je fais de l'exercice, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060123,
					"content": "Mais il se laisse facilement distraire, et parle même parfois tout seul. Quoi qu'il se passe autour, il ne réagit pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "#Pouvez-vous jouer avec nous ? Vous êtes beaucoup plus {M#fort}{F#forte} que mon frère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Haha, on va voir ça. Lovi et moi sommes des experts à cache-cache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "Dans ce cas, commençons. Viens, Lovi, on doit trouver une cachette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi et Verut courent comme le vent, tandis qu'Aurèle s'en va lentement, pensif...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Je ne vais pas vous laisser gagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Qu'est-ce qui t'a fait changer d'avis ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Vous jouez encore à cache-cache ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Oui. Monsieur Delerue est en voyage d'affaires, et madame Dumay doit aussi travailler, alors ils m'ont demandé de m'occuper de Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060117,
					"content": "C'est pour ça que Lovi est venue ici pour jouer avec nous. J'espère que sa robe ne sera pas trop sale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
