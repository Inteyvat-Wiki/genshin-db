					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "Non... Cette partie n'est pas logique, il faut adopter une autre approche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060302,
					"content": "Ou alors... Non, non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060303,
					"content": "Hein ? Vous m'avez trouvé. Je vais retourner au point de rassemblement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060304,
					"content": "Est-ce que ce point de vue est correct ? Non, il... Est-ce que c'est correct ou pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400604,
			"completionStepIds": [
				2400604
