				"objectNames": [
					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#Vous m'avez encore trouvé ! Je suppose que vous êtes vraiment {M#meilleur}{F#meilleure} que moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Je vais retourner au point de rassemblement. J'espère que mon frère va faire mieux que moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Pourquoi ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Comme mon frère l'a dit, il travaille mieux après avoir joué à cache-cache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "Trop d'idées se bousculent dans sa tête, et il a parfois du mal à s'en souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi m'a dit que ces idées étaient très précieuses, et qu'il valait mieux ne pas le déranger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "C'est pour ça que quand nous jouons à cache-cache avec lui, si on est sur le point de le trouver, nous faisons exprès de ralentir pour le laisser réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "Si c'est à son tour d'être le loup, on doit vraiment attendre longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
