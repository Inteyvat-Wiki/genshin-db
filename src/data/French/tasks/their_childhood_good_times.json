			"dialogs": [
				{
					"id": 240060601,
					"content": "Non, ça ne va pas... L'argumentation n'est pas assez rigoureuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060602,
					"content": "On dirait qu'Aurèle est de nouveau dans son monde... Merci d'avoir joué avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "Est-ce qu'il va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Tant qu'il ne commence pas à boire autant de café que mon père, tout ira bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060606,
					"content": "Ça, je m'en occupe. Je ne laisserai pas mon frère boire trop de café. S'il le faut, je cacherai tout le café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060607
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060607,
					"content": "*soupir* J'avais l'intention de cacher le café de mon père ici... J'imagine que c'est raté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060608
					],
					"speakerTitle": "Lovi"
				},
