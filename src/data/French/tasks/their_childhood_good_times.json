					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Je me demande si Aurèle va pouvoir organiser ses pensées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "Hein ? Vous m'avez encore trouvée ? Combien de fois avez-vous joué à cache-cache ? Ce n'est pas possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Bon, je vais retourner au point de rassemblement. Je me cacherai mieux la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
