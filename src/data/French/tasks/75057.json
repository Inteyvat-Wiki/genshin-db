			"dialogs": [
				{
					"id": 750013201,
					"content": "Incroyable, vous avez vraiment réussi... Je croyais que ça n'arrivait que dans les récits. C'est formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "Le brouhaha cesse... L'épinglette d'ombre est revenue dans son état initial et retombe sur le sol de tout son poids...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "#Vous y êtes vraiment {M#arrivés}{F#arrivées}... Dites-moi que je rêve ! Vous existez pour de vrai ? Ce n'est pas mon imagination ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "Réveillez-vous... C'est à vous de trouver une solution !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Ne dis pas des choses aussi cruelles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#Enfin, je vous l'avais bien dit, {NICKNAME} est trop {M#fort}{F#forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Héhé ! T'es d'accord aussi, hein, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#{NICKNAME}, remarquable {M#héros venu}{F#héroïne} d'ailleurs, l'Abîme ne vous fait rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "Non, l'Abîme n'a pas d'effet sur moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Même le plus vaillant des guerriers tribaux doit redoubler de prudence face à l'Abîme. {NICKNAME}, vous n'êtes décidément pas quelqu'un d'ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Oh, un récit qui se base sur ce thème sera encore plus passionnant que ceux de Sanhaj !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "Mmmh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Je ne sais pas qui est Sanhaj, mais c'est quelqu'un d'exceptionnel apparemment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Haha, tous les « conteurs tribaux » vénèrent Sanhaj des Maîtres du vent nocturne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Mais on en reparlera plus tard quand on aura le temps. On a une urgence à régler d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Très bien, dirigeons-nous vers la prochaine épinglette d'ombre en suspension. Si nous réglons ce problème rapidement, je pourrai commencer à écrire dès ce soir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Je me sens bien pour l'instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "J'ai entendu des bruits effrayants tout à l'heure, alors je suis venu voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "En venant ici, je me disais pour me rassurer : « N'angoisse pas, Titu, c'est sans doute pas grand-chose. » Mais il s'est passé un truc énorme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "#Et voilà même un petit tepetlisaure... C'est toi qui as amené ces deux {M#étrangers}{F#étrangères} ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "C'est vous qui avez planté cette épingle d'ombre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "Hein ? Il ne fallait pas le faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Hein ? Euh, {NICKNAME}, je crois qu'on a fait une grosse bêtise... Il n'y a qu'un seul témoin, et si on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Haha ! Vous en dites des choses effrayantes ! Ce n'est pas si grave. On pourrait même dire que vous avez fait quelque chose de bien ? {M#Ce jeune homme}{F#Cette jeune fille} s'appelle donc {NICKNAME}. Et vous, quel est votre nom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#Et voici {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Eh bien, je m'appelle Titu. Je suis celui qui raconte {RUBY#[D]Conteur}des histoires au sein de la tribu. Je suis aussi chargé de m'occuper ces piliers dans la vallée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "Ce pilier que vous avez planté est l'une des trois épinglettes d'ombre dont j'ai la responsabilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "Votre responsabilité... Je vois, maintenant que nous avons replanté cette colonne dans le sol, les Natlanois vont nous demander de les dédommager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Si j'avais su, je ne vous aurais pas donné mon vrai nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Un dédommagement... « Titu eut une idée brillante : il pouvait utiliser cette méthode pour faire chanter ces gens et atteindre ses objectifs... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "C'est le genre de narration qu'il faudrait inclure avec ce genre de scénario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Mmh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ah, pardon, j'étais en train d'imaginer des contes. Je suis chargé de raconter {RUBY#[D]Conteur}des histoires au sein de la tribu. Je le fais depuis des années, mais il est temps pour moi de commencer à inventer les miennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "Ça me préoccupe beaucoup ces jours-ci. Et maintenant, il y a aussi un souci avec l'épingle d'ombre... Comme le dit le proverbe : quand les humains ont la poisse, les sauriens l'ont aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Ahem, je ne vais pas vous faire du chantage. Après tout, si je voulais vraiment le faire, je ne l'aurais pas dit à voix haute, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Regardez, nous avons échangé nos noms et pas des coups, cela fait de nous des amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "Du coup, pourriez-vous écouter ma demande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Du moment que ce n'est pas une demande de dédommagement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "Bien sûr que non ! Comment dire... Ah oui, quand vous vous promeniez dans la vallée, avez-vous vu un énorme bloc de phlogistique solide avec des motifs dorés gravés dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "Il se trouve au centre de cette zone et devrait être très facile à repérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Il me semble l'avoir vu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "En fait, je voulais vous parler de ce grand pilier. On appelle ça une épingle d'ombre au sein de la tribu. Cependant, nous avons quelques soucis avec lui ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "Avant de vous voir, je voulais tout laisser tomber. J'avais même pensé à écrire l'histoire de l'extinction de la tribu suite au désastre qui aura lieu si on ne résout pas ces problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Ce n'est qu'un pilier en pierre, il ne pourrait pas détruire toute une tribu entière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "L'épingle d'ombre dont vous venez de parler et l'épinglette d'ombre qu'on a plantée avant ne sont rien d'autre que de grands piliers en pierre. Pourquoi les appeler ainsi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Mmh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#Oh, c'est vrai que {NICKNAME} et Paimon sont des {F#étrangères}{M#étrangers}, il est donc nécessaire d'expliquer plus en détail. C'est en fait lié à une légende du clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "D'après la légende, la Wayob a planté l'épingle d'ombre ici pour retenir l'ombre du seigneur du volcan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Mais la vérité, c'est que l'Abîme se trouve sous ces piliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "À Natlan, les histoires sont embellies, pleines de rhétorique et de métaphores, mais elles sont à prendre en compte comme des avertissements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Attendez ! L'Abîme est scellé en dessous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Oui. Récemment, deux des trois petites épingles d'ombre se sont décrochées. Peut-être que lorsque la troisième se décrochera, tout ce qui se trouve de mauvais en dessous en jaillira comme un geyser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "C'est pour cette raison que j'ai été agréablement surpris quand je vous ai vu planter un de ces piliers, alors je ne vais pas vous demander de dédommagement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "En revanche, j'aimerais vous demander de replanter une autre épinglette d'ombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Ah, qu'est-ce qu'on fait, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "... Quand il s'agit de l'Abîme, on ne peut pas rester les bras croisés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Oh, même {REALNAME[ID(2)|SHOWHOST(true)]} est d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Ah, vous êtes comme une lueur qui apparaît dans les ténèbres les plus profondes. Héhé, en temps de crise, il y a toujours des héros qui émergent. C'est à ce moment-là que le potentiel humain brille le plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Ça pourrait servir de base à une superbe histoire, {NICKNAME}. Vous avez des qualités que même les héros des histoires qu'on raconte ne possèdent pas. C'est prometteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "#En route, {M#héros}{F#héroïnes} ! Allons examiner cette dernière épingle d'ombre en suspension.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Je suppose qu'on peut vous donner un coup de main.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Je ne crois pas l'avoir vu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Vraiment ? Il est pourtant assez voyant, mais tant pis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "C'est Paimon, je l'ai juste un peu aidée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Hé, tu dis toujours ça quand on se fait prendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "#Haha, ne soyez pas si {M#nerveux}{F#nerveuse}. Cette petite demoiselle s'appelle donc Paimon. Et vous, quel est votre nom, {M#jeune homme}{F#jeune demoiselle} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Je m'appelle {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}