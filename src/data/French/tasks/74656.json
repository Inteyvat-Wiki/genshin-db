				{
					"id": 746560107,
					"content": "Vous vous promenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560101
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560101,
					"content": "À propos des fruits bullés...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560102
					]
				},
				{
					"id": 746560102,
					"content": "#Ah, jeune {M#ami}{F#amie}, avez-vous des fruits bullés ? Partagez-en avec moi, nous pourrions les manger en discutant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560103
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560103,
					"content": "Les statues sont des poèmes dénués de mots. Il faut les admirer avec un estomac rempli. C'est ce qu'un duelliste m'a dit lors du dernier duel de sa vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560106,
					"content": "Et voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "#Je ne suis pas encore {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "J'ai mis des moras de côté, comme on m'a dit de faire pour vous remercier. Mais j'imagine que je vous les donnerai quand vous m'aurez apporté les fruits bullés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ismenor"
				}
			]
		},
