			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "Superbe ! Les six morceaux du cadre mécanique perpétuel sont là ! Il ne nous reste plus qu'à les assembler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150102,
					"content": "Toutes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "Bien sûr ! Ils peuvent former un tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150104,
					"content": "Une fois assemblés, cela donnera naissance à un splendide... gigantesque cadre mécanique perpétuel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150105,
					"content": "Allez, il faut maintenant les combiner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150106,
					"content": "Pas besoin d'utiliser des pièces moulées ou autre chose du genre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "Non, non, non, absolument pas. Ma machine n'est pas un vulgaire bout de ferraille bricolé à la va-vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150109,
					"content": "Tous les composants s'emboîtent proprement et harmonieusement, tout comme... Euh... Comme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150110,
					"content": "Peu importe, les métaphores n'ont jamais été mon point fort, c'est Xavier qui a le talent pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150111,
					"content": "Quoi qu'il en soit, essayez par vous-même. Croyez-moi, ça va être intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150107,
					"content": "Une compétence particulière est-elle requise ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051503",
							"2"
						],
						"stepId": 7051503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "Parfait, c'est tellement beau ! Votre capacité de compréhension et votre dextérité ont dépassé mes attentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "Ha, L'Oiseau de vapeur avait publié plusieurs articles absurdes vous décrivant comme... Comme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "Comme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "#Ha... Haha... {M#Un homme courageux}{F#Une femme courageuse} qui... Qui est {M#prêt}{F#prête} à convaincre les gens avec son épée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "#Ridicule ! Tout ce que ces stupides journalistes savent faire, c'est de provoquer des scandales ! Vous êtes pourtant {M#un héros}{F#une héroïne} perspicace, {M#intelligent}{F#intelligente}, humble et {M#franc}{F#franche} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "Quand j'aurai du temps, j'écrirai une lettre pour les dénoncer sévèrement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "À propos, veuillez accepter ce mécanisme. Peut-être qu'il vous permettra de vous divertir lorsque vous vous ennuyez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "Quant à moi... Eh bien... Je dois collecter des fonds pour mon voyage à Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Continuez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
