			"dialogs": [
				{
					"id": 747020101,
					"content": "Oh, vous avez ramené beaucoup de poissons ces derniers temps. Les aquariums commencent à ressembler à de véritables habitats océaniques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020102,
					"content": "Héhé, on est déjà de véritables pros de la pêche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "#Vous semblez très {M#fiers}{F#fières} de votre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020104,
					"content": "Eh bien, oui ! Mais derrière ce sentiment d'accomplissement, il y a autre chose... Quelque chose qui ressemble plutôt à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Des regrets ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Oui, oui, c'est à peu près ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Pourquoi donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020109,
					"content": "Je ne sais pas non plus... J'ai juste l'impression qu'il manque quelque chose ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Peut-être un restaurant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Hé ! Ne dis pas des choses pareilles ! Comment pourrait-on manger d'aussi beaux petits poissons ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Il nous manque des visiteurs pour venir admirer notre incroyable travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Vous voulez dire... que vous voulez ouvrir cet Océanarium aux visiteurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020116,
					"content": "Ce ne serait pas possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Vous avez peur que ce soit trop bruyant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Si c'est le cas, laissez-nous tout gérer ! On s'occupera de la publicité et de toutes les tâches quotidiennes. Vous n'aurez qu'à vous concentrer sur votre propre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Si vous le dites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020121,
					"content": "On partage les bénéfices à 30 % et 70 % respectivement !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Hein...? On n'en garde que 70 % ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "Non, Sandrone prend 70 %.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Oh, c'est vrai, bien sûr... C'est Sandrone qui loue ce bateau, après tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Ça suffit. Vous me faites passer pour une propriétaire sans scrupule. C'est vous qui faites tout le travail, alors prenez la plus grosse part. Je ne suis pas pingre comme Pantalone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020126,
					"content": "Donc ça veut dire... que vous nous donnez le feu vert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Bien sûr, vous avez ma bénédiction. Assurez-vous simplement que ça n'interfère pas avec mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020128,
					"content": "Youhou ! L'Océanarium-plouf du Wingalet est officiellement ouvert !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "Vous avez bien évidemment déjà trouvé un nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020118,
					"content": "Ou que ça cause des problèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Des visiteurs, peut-être ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Oh ! C'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "De la solitude ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}