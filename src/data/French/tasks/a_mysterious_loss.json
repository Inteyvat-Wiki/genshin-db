					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270201,
					"content": "Quoi ? Il te faut quelque chose d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270202,
					"content": "C'est difficile de chercher quelque chose sans aucun indice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Tu as raison. Laisse-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270204,
					"content": "Malheureusement, je ne me souviens de rien qui puisse t'aider et la boîte est d'apparence banale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270205,
					"content": "Laisse-moi te poser une question...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "Oui ? Je t'écoute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
