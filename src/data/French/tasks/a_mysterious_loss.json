					"nextDialogs": [
						411271303
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411271303,
					"content": "Sur le chemin du retour, un groupe d'Électroblobs m'est tombé dessus et m'a attaqué. C'est là que j'ai fait tomber ma boîte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271304
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411271304,
					"content": "J'ai pu la ramasser, mais je l'ai perdue de nouveau dans le feu de l'action...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271305
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411271305,
					"content": "Mais comme elle a été touchée par ces Électroblobs, il y a de grandes chances qu'ils aient laissé des traces élémentaires dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271306
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411271306,
					"content": "Tu peux suivre ces traces et voir où elles te mènent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271307
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411271307,
					"content": "Ramène-moi la boîte dès que tu l'auras retrouvée.",
