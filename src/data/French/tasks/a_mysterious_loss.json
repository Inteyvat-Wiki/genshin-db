					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "Que s'est-il passé quand tu es revenu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "Tu veux dire quand j'ai couru pour rentrer ? Aucune idée, je ne me rappelle de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270503,
					"content": "Attends, si ! J'ai vu un groupe d'Électroblobs près du <color=#00E1FFFF>Temple des Mille Vents</color>. Ils m'ont attaqué et c'est là que j'ai fait tomber ma boîte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270504,
					"content": "J'ai pu la ramasser, mais je l'ai perdue de nouveau dans le feu de l'action...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270505,
					"content": "Mais comme elle a été touchée par ces Électroblobs, il y a de grandes chances qu'ils aient laissé des <color=#00E1FFFF>traces élémentaires</color> dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270506
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270506,
					"content": "Tu peux suivre ces traces et voir où elles te mènent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270507
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270507,
					"content": "Ramène-moi la boîte dès que tu l'auras retrouvée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
