			},
			"dialogs": [
				{
					"id": 411270401,
					"content": "Qu'y a-t-il dans cette boîte ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Hum, rien qui te concerne. Des bidules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270403,
					"content": "Allons, ne me regarde pas comme ça ! Je t'assure que ce n'est rien de suspect !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270404,
					"content": "Je te rappelle que tu es un Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Il faut arrêter de tous nous mettre dans le même sac, pardi ! C'est ridicule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270406,
					"content": "Allez, je t'en prie, va la chercher. <color=#00E1FFFF>Reviens me voir si tu ne la retrouves pas</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270407,
					"content": "Je vais continuer de réfléchir, peut-être que je finirai par me souvenir de quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
