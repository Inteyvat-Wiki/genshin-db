			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "Je suis fichu de chez fichu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270102,
					"content": "Qu'est-ce qu'il t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "Je n'en pouvais plus de rester là sans rien faire, avec les religieuses qui n'arrêtent pas de me fusiller du regard. J'ai donc décidé d'aller prendre l'air...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270104,
					"content": "Mais des météorites se sont écrasées dès que j'ai mis un pied hors de la cité pour me promener du côté du Temple des Mille Vents !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270105,
					"content": "Bien évidemment que je n'allais pas rester planté là, alors j'ai fait demi-tour... puis je me suis rendu compte que j'ai fait tomber une boîte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270106,
					"content": "Je n'ai pas osé partir à sa recherche avec les conditions météorologiques actuelles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270107,
					"content": "De plus, je suis un Fatui. On va me soupçonner d'un coup fourré si on me voit fouiner dehors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270108,
					"content": "Bref, assez parlé. Tu pourrais m'aider à retrouver cette boîte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270109,
					"content": "Nos marchés se sont toujours bien déroulés, et je ne compte pas te décevoir cette fois-ci non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270110,
					"content": "Arrête de parler comme ça, c'est suspect.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "Suspect ? Il n'y a rien de suspect dans ce que je t'ai dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270112,
					"content": "Allez, tu m'aides ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
