					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "Que faisais-tu à l'extérieur de la cité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Mais arrête de me regarder avec cet air méfiant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270303,
					"content": "Je suis juste parti faire un tour, pour de vrai ! J'ai littéralement pris mes jambes à mon cou quand les météorites ont commencé à pleuvoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270304,
					"content": "Allez, je t'en prie, va la chercher. <color=#00E1FFFF>Reviens me voir si tu ne la retrouves pas</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 411270305,
					"content": "Je vais continuer de réfléchir, peut-être que je finirai par me souvenir de quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
