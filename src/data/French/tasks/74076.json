			"dialogs": [
				{
					"id": 740760101,
					"content": "Il ne reste plus que cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760102,
					"content": "L'entrée est encore scellée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760103,
					"content": "On dirait que Jakob n'a pas résolu l'énigme d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760104,
					"content": "Ou peut-être qu'il a résolu l'énigme, mais qu'il n'a pas pu donner la réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760105,
					"content": "#Voyons voir, les réponses précédentes étaient respectivement l'« ombre », la « vie » et l'«{NON_BREAK_SPACE}amour ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "En suivant la logique précédente, j'en déduis que l'inscription sur la stèle est la suivante :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "« Toujours unis »... « Né en un instant, souvent contradictoire, auprès de vous dans un sommeil éternel »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "Et enfin, le dernier morceau dit : « la goutte primordiale ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Caterpillar, Seymour, savez-vous quelle est la réponse à cette énigme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
