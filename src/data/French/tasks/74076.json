					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "J'ai une idée sur la « goutte primordiale ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760402,
					"content": "On dirait une référence à la première pluie après la création du monde. C'est une idée qui plaisait bien à l'ancienne Fontaine et à l'Ordo Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760403,
					"content": "Mais c'est impossible à trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Cette goutte de pluie ne fait plus qu'un avec les eaux de Teyvat. Chaque goutte d'eau est donc une « goutte primordiale ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760405,
					"content": "C'est comme si la divinité originelle avait répandu un potentiel de puissance. Nous possédons chacun une part sacrée en nous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760406,
					"content": "Mais si la réponse était si simple, la personne qui nous a devancés aurait dû être en mesure de la trouver facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "C'est vrai. Je dois sûrement me tromper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760408,
					"content": "Même si ce n'est pas la bonne réponse, elle était quand même bien trouvée. Je trouve que la personne qui a inventé l'énigme n'est pas très imaginative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760409,
					"content": "Et c'est lui qui te taquine en disant que tu ne comprends rien à la sécurité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Je ne peux pas répondre. Il y a 1 200 résultats de recherche pour « goutte primordiale ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "« La légende raconte que la première goutte de vin était de l'Archon Anémo... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Arrête-toi là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "À ce propos, j'ai des choses à vous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "Une légende raconte que les Océanides sont nées des premières larmes de l'ancien Archon Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "La première larme sur la terre a été versée après que les Océanides ont compris les êtres humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "#Les premières larmes au monde ne devraient-elles pas être celles d'un bébé humain{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Les larmes des animaux servent à éliminer le sel de leur organisme, tandis que dans cette époque paisible, les êtres humains naissent en riant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "C'est ce que dit la légende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "En fait, je considère les pleurs des bébés et l'élimination du sel chez les animaux comme des comportements non émotionnels similaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "Les bébés pleurent pour deux raisons : la stimulation externe et le besoin de remplir rapidement leurs poumons. C'est ce que les livres de l'Amurta de l'Académie de Sumeru disent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Donc la réponse, c'est « les Océanides » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Dans ce cas, c'est possible que la personne avant nous n'ait pas pu trouver la bonne réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Ne prends pas tes rêves pour des réalités.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Je pense qu'on est sur la bonne voie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "D'après ce que je sais sur l'Ordo Narzissenkreuz, ce serait logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760431,
					"content": "L'impératrice rouge qui rêve dans un endroit inconnu, le personnage des rêves qui ne dit jamais vraiment ce qu'il pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760432,
					"content": "Ce que tu dis est encore plus difficile à comprendre que l'énigme elle-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Quelle importance ? Nous sommes arrivés à la toute fin. Une fois que ce sera fini, la réponse à l'énigme sera révélée de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760434,
					"content": "Ann, s'il vous plaît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "D'accord, laissez-moi essayer. Réfléchissez rapidement à une autre réponse si j'échoue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Ça s'ouvre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Il faut obtenir ce dernier bloc, sinon, la sainte lame tombera dans les mains de l'Ordo Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760428,
					"content": "Je pense qu'on est sur la bonne voie !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "C'est toujours mieux que d'essayer de trouver le vin de l'Archon Anémo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Et si on allait à Mondstadt ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Si tu veux tenter une solution désespérée, tu devrais envisager une approche plus solide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
