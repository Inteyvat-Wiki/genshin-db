				},
				{
					"id": 740760204,
					"content": "On dirait que notre concurrent n'a pas résolu l'énigme ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760205,
					"content": "Les inscriptions sur cette stèle disent : « Toujours unis »... « Né en un instant, souvent contradictoire, auprès de vous dans un sommeil éternel »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760206,
					"content": "Et enfin, le dernier morceau dit : « la goutte primordiale ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760207,
					"content": "Il y avait aussi ce genre d'énigme dans les autres endroits. Vous vous souvenez encore des réponses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760208,
					"content": "« L'ombre ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "« La vie ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "« L'amour ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "Argh, les réponses deviennent de plus en plus abstraites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "Paimon"
				},
				{
