						],
						"pointId": 7025
					}
				]
			},
			"dialogs": [
				{
					"id": 740760501,
					"content": "C'est le bloc de la « personnalité » devant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Impossible d'analyser la substance par sa densité devant nous. Il semble que son poids soit... nul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "On dirait que nous avons pris la dernière partie. Au moins, ça nous laisse la possibilité de négocier avec l'autre partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "Le bon côté des choses, c'est que nous pourrons empêcher l'Ordo Narzissenkreuz de forger la sainte lame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Pas vraiment, Paimon. Notre but ultime est de forger la sainte lame et de l'utiliser pour contrecarrer leurs plans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Et bien sûr, je n'ai pas oublié ce que cette épée représente pour vous, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "La sainte lame, qui est capable de couper la volonté, est la clé qui vous permettra de percer le mystère. À vrai dire, elle est tout aussi importante pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "C'est juste que nous avons des choses plus importantes et plus urgentes à faire. Nous nous occuperons de ces mystères plus tard. Ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760510,
					"content": "#Allez-y, {NICKNAME}. Prenez la « personnalité ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		}
