			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							984.35,
							298.017,
							14628.56
						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "T'es peut-être un barde de pacotille, mais tu t'y connais en beaux paysages...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Haha, je suis content que tu aimes. Certaines histoires ne sont pas faites pour les oiseaux, mais seulement pour les étoiles là-haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "C'est l'heure d'une histoire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Haha... Il est « Temps », oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "Il y a très longtemps, le « Tem{RUBY#[D]Istaroth}ps » commença à écrire l'histoire de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Elle traitait tous les êtres vivants de la même manière, car ils étaient tous égaux dans leur valeur et leur insignifiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Tel un vieux parchemin, elle grava dans sa mémoire tous les gens, les événements, les rencontres et les adieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "À l'époque, quand je n'étais qu'un esprit Anémo, je l'ai rencontrée par hasard au Temple des Mille Vents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "En entendant mes souhaits, elle m'a confié des fragments de son pouvoir et de son autorité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Des graines amenées par le vent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "On dirait que tu connais l'histoire du temps et du vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Charmante, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "À travers les souvenirs gravés dans les rituels, les poèmes, les ruines et les textes anciens, ces êtres qu'elle considérait insignifiants l'ont « rencontrée »... maintes fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "C'est cette histoire que tu souhaitais raconter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Mmm... Son prologue, plutôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "La corruption de la Mare Jivari est liée au temps en soi. En d'autres termes, il s'agit d'une calamité présente à chaque instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "Contrairement au « Temps » elle-même, j'ai toujours eu de nombreux souhaits dans mon cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Il y a cinq cents ans, pour empêcher la corruption de la Mare Jivari de s'étendre au-delà de Tenochtzitoc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "... Je l'ai fait disparaître de la chronologie, en la transformant en lieu sans vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "C'est ça, la vérité derrière la disparition de la Mare Jivari ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "#Oups, je crois t'avoir {M#embrouillé}{F#embrouillée}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Si tu veux savoir comment la Mare Jivari a disparu de Tenochtzitoc il y a deux ou trois décennies, quelqu'un d'autre que moi serait mieux placé pour raconter cette histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "La Mare Jivari a été l'objet de trop d'histoires qui n'étaient pas censées être les siennes... Je n'ai fait que jouer un rôle dans un de ces chapitres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "Le choix que j'ai fait il y a cinq cents ans a eu un prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Certaines âmes n'ont pas pu retourner à Mondstadt... tandis que d'autres sont restées pour s'installer sur ces terres. Elles ont fusionné avec les monetoos pour devenir les ashas que nous connaissons aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Tu es venu à Tenochtzitoc pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "C'est exact. Je suis là pour coopérer avec Mavuika, l'actuel Archon Pyro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Quand on a allumé cette bougie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Eh oui, la flamme a été notre signal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "Ce n'est qu'en demandant à Mavuika d'ouvrir une brèche entre cet endroit et la véritable Mare Jivari que j'ai pu m'y faufiler. C'était le seul moyen de ramener toutes les âmes qui le souhaitaient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "Quant à mon petit tour de passe-passe avec les souvenirs... Comme tu le sais, ce n'est pas la première fois que je le fais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "Mavuika a aussi voulu te recommander pour m'aider... Elle ne s'attendait pas à ce que je la devance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "J'ai été ravi de découvrir qu'elle partageait mon amour de la bonne liqueur et de la liberté. On s'est tout de suite très bien entendus, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "Tu t'es vraiment surpassé cette fois-ci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "J'ai été fatigué pendant des jours... À un tel point que j'ai failli sombrer à nouveau dans un sommeil profond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450738,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450739,
					"content": "Mais penser à tout cet hydromiel et ce vin de dent-de-lion que je n'ai pas bu m'a convaincu de tenir bon encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450740,
					"content": "Je ne te trouve pas si fatigué que ça, alors ne crois pas que tu vas arriver à nous faire payer tes verres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450741,
					"content": "Tu ne trouves pas que tu es dure avec moi quand même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450742,
					"content": "Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450743
