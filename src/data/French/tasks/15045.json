			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#Bonjour {NICKNAME}, bonjour Paimon ! J'ai ramené mes bouées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Bonjour, Mualani ! Comment ça se fait que vous soyez pleine d'énergie à cette heure-ci ? Vous avez pourtant fait la fête hier soir, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "C'était hier soir ! Tout ce dont j'ai besoin, c'est d'une bonne nuit de sommeil pour être en forme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Tenez, prenez ça. C'est la récompense pour avoir complété l'album. J'ai pris la vôtre aussi, pour vous épargner le trajet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "C'est si gentil de votre part, Mualani !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Un bon guide anticipe et aide dès qu'il peut, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Je déteste dire ça, mais nos vacances sont presque terminées... D'ailleurs, si je ne rentre pas bientôt, j'ai peur que mon chien ne me reconnaisse plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Les autres ont l'air d'avoir chacun des raisons de rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Certains ont dit que leur famille leur manquait, pour d'autres, c'était le goût du vin de dent-de-lion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Même Chasca semblait touchée. Elle ne l'a pas dit, mais on la retrouve perchée sur un arbre, le regard rivé vers le Clan des fleurplumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Je comprends complètement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Mais l'été n'est pas encore terminé ! On peut encore vivre quelques moments inoubliables pendant le temps qui nous reste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Comme... une autre photo de groupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Et si on en prenait une ici ? Je me suis attachée à cet endroit à force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Excellente idée ! Vous pourriez décorer ce mur pendant que je vais chercher les autres. On se retrouve sur la place !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
