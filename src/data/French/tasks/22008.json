			"dialogs": [
				{
					"id": 220080401,
					"content": "Non ! Je veux pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080402
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080402,
					"content": "J'ai du tofu aux amandes pour toi, mais tu dois d'abord prendre tes médicaments.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080403
					]
				},
				{
					"id": 220080403,
					"content": "Du tofu ? Vraiment ? Mais je dois prendre les médicaments quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080404,
					"content": "Doudou sois gentille, si tu ne prends pas tes médicaments, tu n'iras pas mieux. Et puis... tu adores le tofu aux amandes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080405,
					"content": "Monsieur Baizhu est tellement fort, pourquoi il peut pas faire des médicaments qui ont un bon goût...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongdou"
				}
