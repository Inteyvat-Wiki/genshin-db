				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Allez Doudou, sois gentille, tu te sentiras mieux après avoir pris les médicaments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "Non, non et non ! C'est pas bon, je déteste les médicaments !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "#Ah, {M#le voyageur}{F#la voyageuse}... Doudou est malade. Elle doit prendre des médicaments prescrits par monsieur Baizhu, du Cottage Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Mais elle trouve que les médicaments du Cottage Bubu sont trop amers, et refuse de les prendre... *soupir* Toutes les médecines du monde sont amères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Alors pour qu'elle les prenne, j'ai dû lui promettre qu'à chaque fois elle aurait droit à une part de tofu aux amandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Si ce n'est pas trop vous demander, pourriez-vous m'aider et aller chercher du tofu aux amandes ? Je reste ici, il faut que je la convainque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Ah, merci beaucoup ! Une part suffira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "De quoi est-elle malade ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "*soupir* Difficile à dire... D'après monsieur Baizhu, c'est impossible à guérir ; on ne peut que se contenter d'atténuer les symptômes, et même cela requiert beaucoup de médicaments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Qui sait... Doudou va peut-être devoir passer sa vie entière à prendre des médicaments. Et elle est si jeune... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Si seulement je pouvais être malade à sa place. Mais... Tout ce que je peux faire, c'est m'assurer que les choses n'empirent pas pour la pauvre petite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "#Je m'en remets à vous, {F#voyageuse}{M#voyageur}. Rapportez-moi une part de tofu aux amandes, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Coucou Doudou, alors comme ça on n'aime pas les médicaments ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "C'est trop amer, c'est dégoûtant ! Même les médicaments de Lulu ne sont pas aussi beurk !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou, c'est pour jouer... C'est le jus du tofu aux amandes que Lulu t'a fait goûter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Je peux pas être guérie avec le tofu ? Pourquoi je dois manger des médicaments dégoûtants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Sois une gentille fille. Tu pourras manger ce que tu veux quand tu iras mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Pourquoi les médicaments ne sont pas sucrés comme le tofu aux amandes, c'est vraiment pas juste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "*soupir* Rien n'y fait... Je compte sur vous pour me ramener une part de tofu aux amandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
