				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745260401,
					"content": "#Ah, {NICKNAME}, c'est toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Tu t'entraînes, Nilou ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Non, pas du tout. J'étais en train d'imaginer une nouvelle danse, inspirée par les padisachidées après la pluie, quand les pétales sont encore recouverts de gouttes de rosée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Mais pour l'instant ce n'est qu'une ébauche, beaucoup de mouvements manquent encore de grâce. J'ai l'impression qu'il manque quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Rien qu'à t'entendre la décrire, ça a l'air magnifique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Tu veux me prendre en photo ? Mais, comme je viens de le dire, je ne maîtrise pas encore très bien cette chorégraphie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Les répétitions avant que la danse ne prenne forme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Ah, je comprends ! J'insufflerai mes sentiments dans chacun de mes pas... Tu dois immortaliser l'instant où la fleur s'épanouit avec ton objectif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "Ça fait aussi partie de l'art.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Est-ce que je peux te prendre en photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "J'espère que je ne te dérange pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
	]
