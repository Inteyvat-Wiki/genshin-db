				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "#Hé ! Je vous ai déjà {M#enguirlandés}{F#enguirlandées} tout à l'heure, non ? Vous avez les oreilles bouchées ou quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "Oh, un fantôme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "Ahhh !! Un fantôme ?! Où ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Bah, là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "Ahhhh !! Esprit maléfique, disparaissez !! Moi, Abe, vous ordonne de quitter ce lieu !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "... Quoi ?! M—Mais c'est impossible ! Je n'ai jamais rencontré d'esprit aussi coriace de toute ma vie !! Pourquoi ne disparaissez-vous pas ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Je viens d'une contrée lointaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Un esprit maléfique qui vient d'au-delà de la mer de brouillard ?! Je... Je n'ai pas peur de vous ! Vous ne perdez rien pour attendre, l'Oiselle du tonnerre vous exorcisera !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "L'Oiselle du tonnerre a disparu depuis longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "Q—Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Il n'y a plus personne sur cette île.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "Quoi ? De quoi parlez-vous ? N'essayez pas de m'effrayer ! Ahhh, j'ai les chocottes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "C'est vrai qu'il y a de moins en moins de monde dans le coin ces derniers temps. Kina m'a dit que tout le monde embarquait sur ce bateau... *soupir* D'ailleurs, qui sait où cette enfant est passée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Attendez, esprit maléfique venu de l'extérieur... Pourquoi ne partez-vous pas sur ce bateau argenté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "Je ne le vois pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Hmpf. Je savais que les étrangers ne pouvaient pas voir ce bateau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Merci d'avoir pris la peine de me dire d'embarquer sur le bateau... J'ai vécu si longtemps ici, mais il y a beaucoup d'endroits que je n'ai pas encore vus. Je ne peux pas partir comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "De quoi avez-vous besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "Besoin ? Je n'ai pas vraiment besoin de quoi que ce soit... J'aimerais juste voir quelque chose de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Quand j'étais jeune, j'ai fait un pari avec Una. Je lui ai affirmé qu'il existait différents types de champignons dans d'autres endroits que notre île, mais elle refusait de me croire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Un jour, son mari a pris la mer pour tenter de se rendre où les étrangers habitaient. Il n'est jamais revenu, et on raconte d'ailleurs qu'il est devenu un esprit errant... Le pauvre homme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "Una a toujours vécu seule après cet événement... Quand j'y pense, je... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "Ne vous en faites pas pour elle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "J'ai même supplié le prêtre, vous savez... Il méritait quand même d'avoir un endroit où reposer en paix... Ah oui ! Les champignons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "*tousse* Je vais bientôt monter sur ce bateau et je n'ai pas vraiment de regrets... J'aurais seulement aimé voir ce qu'il y a au-delà de cette île, mais les champignons dont je m'occupe tous les jours restent ma première préoccupation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "Ramenez-moi donc des champignons des terres se trouvant au-delà de la mer de brouillard. J'aimerais voir à quoi ils ressemblent de mes propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "S'il vous plaît, esprit maléfique venu de loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "À propos de ces champignons...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Il n'est pas là pour moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Le moment est venu pour vous de partir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "La mer de brouillard est une relique du passé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "Le fantôme, c'est moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
		{
