				{
					"id": 722060401,
					"content": "#Alors ? Vous êtes {M#prêt}{F#prête} à élargir mes horizons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060402,
					"content": "Comment trouvez-vous ces champignons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
