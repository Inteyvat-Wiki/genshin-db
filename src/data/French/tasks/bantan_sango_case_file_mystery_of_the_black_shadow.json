			},
			"dialogs": [
				{
					"id": 400310501,
					"content": "Très impressionnant ! Vous avez vraiment du talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310502,
					"content": "#Héhéhé ! C'était du gâteau pour notre {NICKNAME}, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310503,
					"content": "Eh bien, alors passons à la prochaine cible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310504,
					"content": "Attendez. Il y en a d'autres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310505,
					"content": "Bien sûr. Si le nombre de missions reçues par Sango n'est pas exagéré, c'est la plus grande disparition de petits animaux de toute l'histoire d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310506,
					"content": "Cela dit, il n'y a généralement pas tant de disparitions que ça. Ce que je veux dire, c'est qu'un tel nombre est anormal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310507,
					"content": "J'ai suivi les pistes que j'avais trouvées dans d'autres zones, et j'ai également trouvé des animaux capturés là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310508,
					"content": "Il y a besoin de furtivité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "Pas cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310510,
					"content": "Les ennemis ne devraient pas être de taille contre vous. Vous verrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 4003108,
			"completionStepIds": [
				4003108
			],
			"beginWay": "TALK_BEGIN_AUTO",
