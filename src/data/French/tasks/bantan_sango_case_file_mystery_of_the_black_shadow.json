	"talks": [
		{
			"id": 4003101,
			"completionStepIds": [
				4003101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003101",
							"2"
						],
						"stepId": 4003101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "#Bonjour {M#voyageur}{F#voyageuse}. Tu n'aurais pas pu mieux tomber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310102,
					"content": "Oh, je sais ce qu'il va se passer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310103,
					"content": "Oui, laisse-moi deviner la suite. Tu vas me dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "#Mmm, comme je m'y attendais de la part d'{M#un aventurier aussi expérimenté}{F#une aventurière aussi expérimentée} que toi. Comme tu l'as dit, on a une nouvelle mission qui pourrait t'intéresser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310106,
					"content": "#Bantan Sango a besoin de main-d'œuvre et ils ont spécifiquement demandé à ce que tu sois {M#impliqué}{F#impliquée} pour enquêter dans une affaire de, je cite, « disparition à grande échelle de petits animaux ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310107,
					"content": "Hein ? Il ne s'agit que de quelques petits animaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310108,
					"content": "#Allons, voyons. Tu es sûre d'avoir besoin de l'aide de notre {M#cher}{F#chère} {NICKNAME} pour ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310109,
					"content": "Tu sais, je fais même les livraisons à emporter, alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "Bantan Sango, c'est pas cette agence de détective par hasard ? Pourquoi auraient-ils besoin d'embaucher des aventuriers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310114,
					"content": "Eh bien, voilà : Sango a demandé à ce qu'un aventurier expérimenté accompagne Ryuuji sur une enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310115,
					"content": "Et puis... Hmm, voyons voir. Sango a demandé à ce que je dise ceci :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310116,
					"content": "« Beaucoup de gens ont perdu leur animal de compagnie, ce qui a généré une recrudescence de missions pour nous. Si le problème peut être résolu, il y a une généreuse récompense à la clé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310117,
					"content": "#« Une généreuse récompense », elle a dit... Hmm, tu sais quoi, {NICKNAME} ? Je pense que ces pauvres petits animaux méritent qu'on s'occupe d'eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310118,
					"content": "Et puis de toute façon, les missions, qu'elles soient grandes ou petites, sont toutes une opportunité de s'améliorer, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310119,
					"content": "Tu te fais avoir facilement, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "Peu importe... Allons voir Sango !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310110,
					"content": "Pas de problème. Je répare bien les charrettes cassées, alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "Hé, j'ai bien vaincu Stormterror à l'époque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "Tu considères le fait de vaincre Stormterror comme une petite affaire ? C'est... plutôt impressionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 400310104,
					"content": "Quelque chose à propos d'une nouvelle mission pour moi, pas vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "#Bien. Tu es {M#arrivé}{F#arrivée} plus vite que prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310203,
					"content": "#Évidemment ! On est {M#venus}{F#venues} en courant dès qu'on a entendu parler de la réc... euh, je veux dire des animaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310204,
					"content": "#Alors, c'est quoi le problème ? Pas de panique, Paimon et {NICKNAME} sont là pour vous aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310205,
					"content": "On sait bien qui va encore faire tout le travail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "Moi, je t'encourage ! Ça compte, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310207,
					"content": "Toujours aussi dynamiques. Très bien, voilà le problème. On a reçu des tonnes de missions dernièrement à propos d'animaux perdus. Dans le but de les retrouver, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310208,
					"content": "Ce sont pour la plupart des animaux de compagnie, ce qui signifie qu'ils n'ont pas dû s'enfuir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310209,
					"content": "Inazuma est une terre empreinte de mystères. Mais tout arrive pour une raison, et il n'y a rien qui puisse résister à la logique. Notre enquête de terrain nous l'a confirmé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310210,
					"content": "Attendez, vous voulez dire « mon enquête de terrain », n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310211,
					"content": "Haha, on dirait que Paimon va devoir vous encourager vous aussi, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "Quoi !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310213,
					"content": "Merci mais ça va aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310214,
					"content": "J'étais sur la piste des animaux disparus ces derniers jours et j'ai fini par découvrir des campements dans la nature. Certains étaient gardés par des monstres, rien de bien méchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310215,
					"content": "Cependant, quand j'étais sur le point de libérer certains des animaux emprisonnés dans l'un des camps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310216,
					"content": "... J'ai été assommé par « une ombre noire apparue soudainement ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310217,
					"content": "Quand je me suis réveillé, le camp était complètement désert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310218,
					"content": "Tss, notre Ryuuji a connu des jours meilleurs, hein ? *soupir* Qu'est-il arrivé au Ryuuji qui rugissait comme s'il était l'Oni Torachiyo en personne après son triomphe face à l'auteur de l'incident « Sanbongatana Kinpachi » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310219,
					"content": "Je me rappelle que tu me tenais fermement alors que je feignais la mort, criant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310220,
					"content": "Attendez, arrêtez ! Arrêtez, je vous en supplie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310221,
					"content": "Oh, allez ! Qu'est-ce qui s'est passé après ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310222,
					"content": "Occupons-nous déjà du problème actuel, vous voulez-bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "#En bref, on a besoin de l'aide d'{M#un aventurier expérimenté}{F#une aventurière expérimentée} comme vous pour nous aider à sauver ces animaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310228,
					"content": "Tant que vous serez là, on aura un témoin, même si Ryuuji est à nouveau assommé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310229,
					"content": "Euh, Sango, pourquoi vous n'y allez pas vous-même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310230,
					"content": "Haha, n'oublie pas que c'est moi le cerveau de l'équipe. Donc je dois rester en une pièce. Ma chair n'est qu'un accessoire nécessaire à mon esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310231,
					"content": "(Waouh, elle a vraiment décidé de ne pas en faire une !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310232,
					"content": "#Bien sûr, votre travail sera rémunéré. Vous serez {M#payés}{F#payées} comme convenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310233,
					"content": "C'est tout ce que je voulais entendre ! Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310234,
					"content": "Euh, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "Attendez une seconde, si vous voulez bien. Prenez ça avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310237,
					"content": "Oh... Euh, pardon, mais c'est quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310238,
					"content": "C'est un <color=#00E1FFFF>Filet d'ubiquité</color>. J'ai une amie qui l'a fait fabriquer d'après les registres de Kamuna Onmyoudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310239,
					"content": "Il n'est pas assez résistant pour capturer des criminels mais en visant bien, vous ne devriez pas avoir de problème à capturer de petits animaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310240,
					"content": "Avec ça, vous ne devriez pas avoir de mal à les ramener !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310241,
					"content": "Waouuuh ! Super facile ! Merci, Sango, vous êtes la meilleure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310242,
					"content": "Ce n'est pas vraiment ce que j'appellerais « être la meilleure ». Considère ça plutôt comme « une assurance contre l'échec ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310243,
					"content": "#Ryuuji, va avec {M#eux}{F#elles}, tu veux bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310244,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310245,
					"content": "Je sais où trouver d'autres traces d'animaux. Suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310246,
					"content": "Très bien, on y va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310247,
					"content": "Merci, Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "Quelle motivation !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "Oui, qu'est-ce qui s'est passé après ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "Oh, vous vous intéressez aux affaires passées ? Eh bien, à l'époque, l'officier de police toujours tellement aimable Kinpachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310225,
					"content": "S—S'il vous plaît, revenons au sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310226,
					"content": "... Tu sais quoi ? Entendu. Pardon, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003103,
			"completionStepIds": [
				4003103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003103",
							"2"
						],
						"stepId": 4003103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "D'après mes observations, ça devrait être ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310302,
					"content": "Hein, il y a vraiment des tonnes de petites créatures ici. Ce sont tous des animaux disparus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310303,
					"content": "Et ça, c'est un... chien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310304,
					"content": "Il y a un chien qui garde cet endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310305,
					"content": "Oh, alors c'était donc ça. Mmm... C'est un peu embarrassant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310306,
					"content": "Hein ? Qu'est-ce qui vous embarrasse, Ryuuji ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310307,
					"content": "... Ce chien, c'est « l'ombre noire » qui m'a eu en un coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310308,
					"content": "Ne vous inquiétez pas. C'est juste un chien très fort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "Pas besoin... d'essayer de me réconforter. Je n'ai vraiment pas été à la hauteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310312,
					"content": "Pourtant, cette posture droite, cette allure fière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310313,
					"content": "Euh, ça ne vous rappelle pas quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310314,
					"content": "Ah oui. Au Salon de thé Komore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "Exactement ! Il me rappelle Taroumaru, moi aussi ! On pensait même qu'il pouvait parler au début. C'est vraiment dommage qu'il ne puisse pas le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310317,
					"content": "Vous parlez du propriétaire du Salon de thé Komore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310318,
					"content": "Vous le connaissez, Ryuuji ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310319,
					"content": "Un peu. C'est vrai qu'ils se ressemblent. Il ne faut pas qu'on baisse notre garde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310320,
					"content": "Taroumaru est connu pour être amical puisqu'il a souvent affaire à des humains mais pour ce qui est de ce chien, on ne sait rien. Il vaut mieux rester prudents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310321,
					"content": "Mmm, vous avez un point, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310322,
					"content": "C'est juste l'expérience qui parle, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310323,
					"content": "Mais, pourquoi ce chien rassemblerait tous ces animaux et garderait cet endroit ? Je ne comprends pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310324,
					"content": "On aura sûrement besoin de plus d'indices pour le découvrir. Mais pour le moment, essayons de sauver ces animaux. Leurs propriétaires commencent à s'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310325,
					"content": "#C'est là que vous entrez en action, {NICKNAME}. Je m'occuperai de la suite quand vous aurez trouvé les animaux. Je les ramènerai chez eux aussi vite que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310326,
					"content": "On n'attaque pas ensemble ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "On ne sait même pas si cet ennemi peut être vaincu si on attaque « ensemble » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310328,
					"content": "... À vrai dire, est-ce que vous avez de l'expérience dans le domaine de la « furtivité » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310329,
					"content": "Eh bien, quand on a essayé de voler la lyre sacrée, Himmel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "... Ça a dû être... une expérience intéressante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310333,
					"content": "Quoi qu'il en soit, on devrait pouvoir sauver les animaux en évitant le garde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310334,
					"content": "J'ai disséminé certains objets qui peuvent attirer son attention. J'espère que ça vous sera utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310335,
					"content": "Très bien. Allez-y. Je monterai la garde ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310330,
					"content": "#On a évité d'être {M#capturés}{F#capturées} lors du rituel de la descente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "On a suivi un certain officiel du gouvernement à Ritou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "Taroumaru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Euh, vous n'êtes vraiment pas doué, Ryuuji, hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "Hé ! Le chien était juste super fort, c'est tout ! Moi aussi, il m'aurait eue, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003105,
			"completionStepIds": [
				4003105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
