					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310801,
					"content": "Merci beaucoup. Vous m'avez beaucoup aidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310802,
					"content": "#C'est vrai, hein ? {NICKNAME} est {M#le meilleur}{F#la meilleure} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310803,
					"content": "Est-ce qu'on a récupéré suffisamment d'animaux maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310804,
					"content": "Attendez... Il en reste encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310805,
					"content": "Hein ? Mais comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310806,
					"content": "Je pense qu'on est sur la bonne voie. On n'a pas eu de problème avec notre ombre noire et on a réussi à récupérer un certain nombre d'animaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310807,
					"content": "De ce point de vue, notre enquête a progressé. C'est juste qu'on manque d'indices pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310808,
					"content": "Je vais continuer d'enquêter de mon côté. Et vous, reprenez vos activités habituelles... On se retrouvera à l'Agence de détectives Bantan Sango quand il y aura du nouveau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310809,
					"content": "Eh bien, ce n'est pas comme si on avait le choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
