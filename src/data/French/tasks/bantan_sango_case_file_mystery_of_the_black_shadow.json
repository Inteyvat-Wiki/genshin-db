				"points": []
			},
			"dialogs": [
				{
					"id": 400315101,
					"content": "#Vous avez besoin de quelque chose, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315102,
					"content": "Parlez-moi du Filet d'ubiquité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "Ah, ça. Eh bien, au départ, je voulais que Ryuuji l'utilise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315104,
					"content": "Ce n'est pas comme si notre travail était sans danger, vous savez ? Ryuuji a été blessé à de nombreuses reprises par le passé. Alors je me suis dit : comment augmenter la portée à laquelle on peut capturer les criminels ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315105,
					"content": "J'ai lu beaucoup de vieux livres et j'ai fini par concevoir ce filet et par demander à un ami de le fabriquer pour moi. Mais tout ce qu'on a pu faire, c'était de « capturer des petits animaux » avec...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315106,
					"content": "Mais quoi qu'il en soit, il est utile entre vos mains, c'est tout ce qui compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315107,
					"content": "#Je suis {M#curieux}{F#curieuse} de savoir ce qui est arrivé à Sanbongatana Kinpachi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "Oh, alors ça vous intéresse, hein ? Eh bien, voilà ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315109,
					"content": "... En fait, vous savez quoi ? Laissons ça de côté. Si Ryuuji est tellement opposé au fait que j'en parle, je ne vais pas le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315110,
					"content": "Il faut que j'y aille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "Allez-y. Faites attention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003152,
