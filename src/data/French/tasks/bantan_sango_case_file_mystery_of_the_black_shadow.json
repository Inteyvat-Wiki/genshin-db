				"points": []
			},
			"dialogs": [
				{
					"id": 400315201,
					"content": "Laissez-moi m'occuper de la suite une fois les animaux trouvés. Je les ramènerai chez eux aussi vite que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315202,
						400315207,
						400315210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315202,
					"content": "Que pouvez-vous me dire à propos de cette ombre noire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315203
					]
				},
				{
					"id": 400315203,
					"content": "J'ai entendu parler d'une organisation secrète qui entraîne des ninken, des chiens ninjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315204,
					"content": "Il paraît qu'un de ces chiens, du nom d'Inujin, a détruit de nombreux monstres qui menaçaient Inazuma depuis les ombres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315205,
					"content": "... Bien sûr, il ne s'agit que d'une légende. Et pourtant, je me demande si cette ombre noire ne pourrait pas être ce ninken légendaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315206,
					"content": "Quoi qu'il en soit. Je ne devrais pas essayer de chercher des excuses à ma défaite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315207,
					"content": "Parlez-moi de ces distractions que vous avez mises en place...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315208
					]
				},
				{
					"id": 400315208,
					"content": "Je n'ai pas réussi à sauver les animaux pendant cette enquête mais j'ai quand même eu le temps de placer quelques dispositifs à fumée dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315209
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315209,
					"content": "Si vous activez ces mécanismes, vous devriez pouvoir attirer son attention temporairement. J'espère qu'ils vous seront utiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315210,
					"content": "Je reviens bientôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315211
					]
				},
				{
					"id": 400315211,
					"content": "Parfait, merci. Je monterai la garde ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		}
	]
