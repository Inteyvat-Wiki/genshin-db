				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Qui aurait cru qu'on se retrouverait coincés dans un tel endroit. On n'est pas sortis d'affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Avec toutes les études que j'ai faites, tout ce que je sais faire, c'est mettre les gens en prison. On ne m'a jamais appris à m'en échapper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "#Quelle idée de m'être engagée envers mon vieux père à « vivre une vie heureuse{NON_BREAK_SPACE}»... Quoi qu'il arrive, je ne peux pas me laisser abattre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "#Voyons les choses de manière positive : j'ai pu découvrir un nouvel endroit et élargir mes horizons. Et puis j'ai même été réunie avec de {M#vieux amis}{F#vieilles amies}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Hmm, oui. C'est plutôt bien. Je suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
