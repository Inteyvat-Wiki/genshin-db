			"dialogs": [
				{
					"id": 10280801,
					"content": "Bon, ça suffit. Je vais y jeter un autre coup d'œil. Vous allez voir ce dont l'exceptionnel Arataki Itto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280802,
					"content": "Patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280803,
					"content": "Quoi ? Qu'est-ce que t'as, à être si sérieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280804,
					"content": "C'est l'heure des melons lavandes grillés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280805,
					"content": "Hein ? Avec ce qui s'est passé, tu me demandes de faire griller des melons lavandes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280806,
					"content": "Meuh ! Meuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "Tu as entendu ? Ushi dit que tu as raison... Une minute ! Ushi, tu n'es pas de mon côté ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280808,
					"content": "Meuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "C'est important de se ravitailler. Ce n'est qu'en conservant suffisamment d'énergie physique et mentale qu'on sera capables d'affronter l'inconnu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Et ça, même Ushi le sait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "Bon, d'accord. Je vous en fais deux chacun... Hé, vous avez déjà commencé à manger ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280812,
					"content": "Attendez, c'est déjà cuit ? En tout cas, ça sent bon... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280813,
					"content": "Bon, on réfléchira à une solution après avoir pris un goûter. Hé, ne mangez pas tout ! Laissez-m'en au moins deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
