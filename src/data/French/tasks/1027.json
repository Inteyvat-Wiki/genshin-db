			"dialogs": [
				{
					"id": 10280701,
					"content": "La situation est grave. On n'a toujours pas trouvé de sortie. Préparez-vous à rester ici pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Heureusement, on ne manque pas de provisions. Notre équipe est hétéroclite, mais au moins, on a quelqu'un qui sait gérer les crises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Occupez-vous de vous-mêmes. Je me charge du reste.",
