				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}, regarde là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "Elle... Elle est toute seule, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "Parce qu'on dirait bien qu'elle parle comme si quelqu'un d'autre était là... Regarde, la voilà qui rigole ! Brrrr... Pas rassurant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "Moi aussi, quand j'étais plus jeune j'avais un ami imaginaire, tu sais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#Ah ? Toi aussi, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Hum, alors... Cet ami existe juste dans ton imagination, ou bien...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "L'imagination est ta meilleure amie, Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Un ami imaginaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "... Oh, tu veux dire « ami imaginé », c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "À quoi il ressemble ? Montre-le moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "Il ne se montre plus beaucoup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Ah bon ? Donc les amis imaginaires disparaissent tout simplement quand on grandit ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Hé oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Dommage, j'aurais bien aimé le voir... D'ailleurs, {M#ta sœur}{F#ton frère} aussi a un ami imaginaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "#Ah ! {M#Elle}{F#Lui} aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "#Tu as déjà entendu parler d'un jeu de cartes de Liyue ? Ça se joue à quatre, {M#ta sœur}{F#ton frère} et toi pouvez y jouer du coup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "#Tiens, {M#voyageur}{F#voyageuse}, te voilà. Quoi de neuf ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "Le barde de pacotille ! Qu'est-ce que tu fais là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Haha, je suis ici car Lisa a mis au point un appareil assez intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Hum, si Lisa trouve ça intéressant, ça n'augure rien de bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "Allons ! Ce n'est pas une façon de parler de notre élégante Lisa, voyons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "Pour cet objet particulier, Lisa a dû importer de dangereux matériaux de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "Ah ! « Dangereux » ! Je le savais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "C'est un monocle équipé d'une sorte de détecteur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "En effet ! Ça ressemble un peu à un monocle, mais il s'agit en réalité d'un appareil de détection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Hélas, Lisa ne peut pas l'utiliser, donc je lui ai emprunté pour un moment... J'en profite pour le tester, et voir s'il fonctionne ou pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "Ah ? Lisa ne peut pas l'utiliser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Hmm... Peut-être manque-t-elle de la capacité à s'émerveiller qu'ont les enfants, ou d'un peu d'imagination ? À moins qu'il n'existe une autre raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "Pourquoi ne pas lui demander la prochaine fois que vous la verrez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "Alors tu peux voir les amis imaginaires ? Dis-nous à quoi ressemble son ami invisible alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Haha, ça, je le garde pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "#Enfin, l'appareil est tout à toi maintenant, {M#voyageur}{F#voyageuse}. Tiens, essaye de voir si tu peux détecter l'ami imaginaire de Nora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "Alors ?! Tu vois quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Oh ! C'est vrai, il y a quelqu'un !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Ainsi donc, toi aussi, tu es capable de l'utiliser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "Hé, moi aussi, je veux voir ! Pfff, mais ce truc est bien trop gros pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#{NICKNAME}, à toi de jouer alors ! Allons voir si on peut détecter d'<color=#00E1FFFF>autres amis imaginaires</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "C'est un enfant avec qui elle a l'air de bien s'entendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "On dirait vraiment un monocle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "Oui, n'est-ce pas ? Je suis bien d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "C'est triste, mais c'est comme ça, en effet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Il n'existe plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "Les amis imaginaires sont le fruit d'une hallucination.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "L'imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "Regarde, voilà l'ami en question... Une plante, évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Parce qu'un ami imaginaire peut être une plante maintenant ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "#Bonjour {M#voyageur}{F#voyageuse}, bonjour le barde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Bonjour ! On peut te poser quelques questions ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Bien sûr ! Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "C'est euh... hum... quoi qui est à côté de toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Oh ? Vous pouvez voir monsieur Pompon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100211,
					"content": "C'est mon meilleur ami, on a grandi ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100216,
					"content": "(*grommelle* J'ai horreur d'être laissée à l'écart...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100217,
					"content": "Flora, dites-moi... Pourquoi votre ami est-il un fruit pompon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100218,
					"content": "Et pourquoi pas ? J'ai toujours voulu être l'amie d'une plante qui peut voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100219,
					"content": "Amie avec une plante qui peut voler ? Pourquoi donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100220,
					"content": "Héhé, parce que quand il y a du vent je peux m'envoler avec ! C'est quand même sympa, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100221,
					"content": "Euh, tu ne veux pas plutôt dire que le vent t'emporte quand il souffle fort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100222,
					"content": "Héhé, c'est ce que pensent certaines personnes, en effet...",
