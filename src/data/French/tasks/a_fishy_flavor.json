			"dialogs": [
				{
					"id": 220420301,
					"content": "Vous revoilà. Avez-vous nourri ces petits chenapans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Très bien, je vous en remercie beaucoup. Sans vous, ils seraient affamés à force de jouer dehors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
