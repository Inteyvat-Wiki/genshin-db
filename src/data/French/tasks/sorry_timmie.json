			"dialogs": [
				{
					"id": 200680401,
					"content": "Ça devrait suffire, merci. Attendez un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "Voilà qui devrait faire l'affaire. Allez vite donner cette galette de pomme de terre à Timmy !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "Et s'il vous plaît... Ne recommencez pas à l'avenir. Ça n'en vaut vraiment pas la peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "J'espère que vous m'écouterez ; ne décevez pas Timmy... ou moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "*soupir* Si seulement les gens écoutaient les conseils qu'on leur donne, sœur Victoria ne serait pas aussi débordée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
