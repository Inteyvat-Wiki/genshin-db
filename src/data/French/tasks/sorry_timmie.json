			"dialogs": [
				{
					"id": 200680501,
					"content": "Allez vite donner cette galette à Timmy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680502,
					"content": "Cette « maman » dont parle sans cesse Timmy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "C'est moi. J'ai toujours pris soin des enfants qui en avaient besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680504,
					"content": "Timmy est celui dont j'ai pris soin le plus longtemps ; il a fini par m'appeler « maman » avec le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680505,
					"content": "Mais... Je ne suis pas sa vraie famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680506,
					"content": "Pourquoi Timmy boude comme ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "Vous... Vous ne savez donc pas ? Vous ne manquez pas d'air !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680508,
					"content": "Le pauvre enfant n'a pas beaucoup d'amis par ici, sans parler de famille. À part Nora et Gloria, il n'y a guère que les animaux pour lui tenir compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680509,
					"content": "D'ailleurs, ces pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680510,
					"content": "... Peu importe. Allez vite lui donner la galette, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
