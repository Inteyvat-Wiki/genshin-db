					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "*soupir* Qu'est-ce que je vais bien pouvoir faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "Ah, c'est vous. Vous arrivez au bon moment. Timmy m'a dit ce que vous avez fait avec les canards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "Vous... Vous... Comment dire... Je sais ce que vous avez fait pour la cité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "Mais fallait-il vraiment utiliser votre courage et votre force de cette manière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "J'avais trop faim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Vous... Si vous aviez si faim que ça, vous auriez pu aller travailler pour gagner de quoi vous payer un repas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "Avec vos talents, vous avez certainement une place à la Guilde des aventuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Enfin, ce qui est arrivé est arrivé, on n'y changera rien. Mais Timmy a le moral à zéro depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "Le... Père de Timmy m'a appris autrefois comment cuisiner un plat ; une combinaison de galette de pomme de terre mondstadtoise et de champignons anémophiles ; c'est le plat préféré du petit Timmy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Allez me chercher trois de ces champignons, et on le fera pour Timmy. Ça devrait lui faire remonter le moral, et ça servira d'excuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Bien, alors je vous laisse y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "Vous devriez pouvoir en trouver au sud de la ville, sous les corniches des maisons, si mes souvenirs sont bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Revenez vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "Autant de champignons que vous voulez !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Trois suffiront. À quoi vous serviront autant de champignons ? Vous ne comptez quand même pas amadouer le pauvre Timmy à chaque fois que vous faites quelque chose qui lui déplaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "C'était un accident, je vous jure !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "Vous avez frappé ces pigeons et ces canards par accident ? Et les ennemis que vous avez vaincus, c'était aussi par accident peut-être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "C'était justement l'occasion de s'entraîner. Sans pratique, pas de force.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "Vous... Tant pis, oubliez ça. On dirait bien que votre « force » s'applique vraiment à tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
