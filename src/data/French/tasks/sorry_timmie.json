				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "... Mangez, mangez... Mangez et partez vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680302,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "Encore vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680308,
					"content": "Qu'est-ce que vous voulez ? Vous ne voudriez quand même pas encore faire du mal aux canards et aux pigeons ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680309,
					"content": "Tiens, cette galette est pour toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "Une galette de pomme de terre ? Tu sais les faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680312,
					"content": "Je sais ! Vous avez dû demander à maman Grace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680313,
					"content": "C'est une ruse, j'en suis sûr ! Pour que j'oublie ce que vous avez faits aux oiseaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680314,
					"content": "... Mais... Si c'est maman qui vous envoie, alors ça doit être sa façon de me dire d'arrêter de bouder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680315,
					"content": "Elle doit aussi s'occuper de Nora et de Gloria... Alors je dois faire des efforts, je crois, c'est déjà assez difficile pour elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680316,
					"content": "Mais attention ! Ça ne veut pas dire que je vous ai pardonné ! J'accepte juste à cause de maman, compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680317,
					"content": "Hmph... Et puis de toute façon, je suis qu'un gamin, vous tiendrez sûrement pas vos promesses, comme les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680318,
					"content": "Je dirai tout à mon papa quand il reviendra ! Na !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680310,
					"content": "Accepte cette galette, d'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "Hé, Timmy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "Laissez-moi tranquille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200680304,
					"content": "Qu'est-ce qui t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "Vous osez me demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmy"
				}
			]
		},
