					"Arakanta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730420601,
					"content": "#Qu'est-ce qu'on s'est amusés ! Arakanta est vraiment super content de jouer avec {M#le nara doré}{F#la nara dorée} ! {M#Le}{F#La} nara est rapide et {M#fort}{F#forte} comme un vrai tigre rishboland !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "#C'est amusant de jouer avec les autres aranaras et un vrai tigre rishboland, mais c'est encore plus amusant de jouer avec {M#un nouvel ami, un ami narien}{F#une nouvelle amie, une amie narienne} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Pourquoi le tigre rishboland pourchasse les aranaras ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Les tigres rishbolands et les aranaras sont amis, et les amis jouent ensemble. Mais Arakanta a remarqué que les naras avaient peur des tigres rishbolands. Alors il a inventé un nouveau jeu pour le Festival Utsava !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "#Nara, merci. Voilà une fleur aranarienne pour {M#le nara doré}{F#la nara dorée} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
