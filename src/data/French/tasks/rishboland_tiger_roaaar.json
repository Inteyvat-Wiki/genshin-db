			"dialogs": [
				{
					"id": 730420101,
					"content": "#{M#Nara doré}{F#Nara dorée}, Arakanta a beaucoup entendu parler de toi. Tu es {M#un gentil}{F#une gentille} nara. Tu veux jouer avec Arakanta ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "Le jeu d'Arakanta est simple et amusant ! Je t'explique les règles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "#Arakanta invoque des particules Dendro, qui sont les aranaras qui se cachent dans le cercle, et {M#le}{F#la} nara est un grand et puissant tigre rishboland qui pourchasse les aranaras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "#Si le tigre attrape tous les aranaras très vite, {M#le}{F#la} nara gagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "Alors ? Tu veux jouer avec Arakanta maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
