			"dialogs": [
				{
					"id": 761060101,
					"content": "#Hmm ? Ta tête me dit quelque chose. Tu es {M#nouveau}{F#nouvelle}, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
