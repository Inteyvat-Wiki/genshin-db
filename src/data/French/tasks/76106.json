				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "... Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "#Je dis ça pour ton bien : ne fouine pas ici, surtout pas au deuxième étage ! Une trop longue exposition au kuuvahki peut te donner des maux de tête, voire des nausées. Je t'aurais {M#prévenu}{F#prévenue} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Bien sûr ! Tout le personnel qui travaille ici a droit à une portion supplémentaire de cidre de pomme. Si ce n'était pas mauvais pour la santé, pourquoi serait-on soudoyés avec quelque chose d'aussi bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "En plus, j'ai vu de mes propres yeux que les Descendants de givrelune ont des cornes qui leur poussent sur la tête ! Tu crois que c'est normal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Je vois... Merci de me l'avoir dit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "C'est horrible ! Est-ce qu'on va se transformer en monstres aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "*soupir* Ils envoient toujours les nouveaux faire le sale boulot... Fais attention et ne reste pas trop longtemps là-dedans, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
