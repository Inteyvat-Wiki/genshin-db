			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "C'est tout ce dont les Fatui sont capables ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "Tss... Depuis quand l'insolence fait partie des critères de recrutement ? Attends, mais tu n'es pas une nouvelle recrue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "#Tu as cru pouvoir t'infiltrer, hein ? Dommage, mais c'est raté ! Attrapez-{M#le}{F#la} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
