			"dialogs": [
				{
					"id": 761060501,
					"content": "#Je suis votre pire {M#ennemi}{F#ennemie} de longue date ! {M#Enchanté}{F#Enchantée} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060502
					]
				},
				{
					"id": 761060502,
					"content": "C'est une attaque ennemie... Toutes les unités à l'assaut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
