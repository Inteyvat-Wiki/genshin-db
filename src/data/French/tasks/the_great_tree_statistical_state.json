			"dialogs": [
				{
					"id": 230300201,
					"content": "Oh ! Regardez cette boîte. Je pense que les potions sont dedans. Yasmin a dû passer par là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "Hein ? Le bouchon de ces potions n'a pas encore été ouvert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "Il ne faut pas l'ouvrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300204,
					"content": "Ouah...! Regarde derrière, il y a des Fongus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "Quoi ?! Il n'y avait rien tout à l'heure ! Qu'est-ce qui se passe exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#{NICKNAME}, on n'a pas le temps de les écouter discuter. On doit faire quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
