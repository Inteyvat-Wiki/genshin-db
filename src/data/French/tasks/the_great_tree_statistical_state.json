			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Heureusement que la jarre n'est pas cassée, sinon on aurait vomi notre petit déjeuner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Tu n'es pas encore habitué à l'odeur ? Mais c'est toi qui fais ces potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Combien de fois il faut que je te l'explique... J'ajoute un vomitif physiologique à la potion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Ça n'a rien à voir avec l'accoutumance. Dès qu'on sent l'odeur, le corps réagit par des vomissements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Pourquoi je me répète, de toute façon, tu ne comprends jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Au fait, où est passée Yasmin ? Elle n'a même pas répandu cette potion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Elle a dû trouver une plante rare et aller récolter des échantillons. Tu sais comment sont les étudiants de l'Amurta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "#Bon, d'accord. Alors, on va garder un œil sur cette potion pour le moment. Merci pour votre aide, {M#voyageur}{F#voyageuse}, voilà pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Ces étudiants de l'Amurta... Vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
