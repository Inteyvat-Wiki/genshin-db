			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*tousse* ... Ça devrait aller ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Oh... Beurk... C'est toi qui as fabriqué cette potion ! Et même toi, ça te fait vomir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "*tousse* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Combien de fois il faut que je... Euh... Je t'explique... J'ajoute du vomitif à la potion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Ça n'a rien à voir avec l'accoutumance. Dès qu'on sent l'odeur, le corps réagit par des vomissements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Pourquoi je me répète, de toute façon, tu ne comprends jamais... Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "#Hein ? Ladep, Pharez, et {M#le voyageur}{F#la voyageuse} ? Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "Et... La jarre de potion est cassée en plus... Vous avez été attaqués par des monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "On dirait bien... Tu n'as pas vu de monstres en venant ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "Non, j'ai même pris le temps d'aller récolter quelques spécimens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "C'est vraiment bizarre... très bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300512,
					"content": "Ça n'a rien de bizarre ! Ces monstres ont été attirés par la potion que tu as faite !",
					"roleType": "TALK_ROLE_NPC",
