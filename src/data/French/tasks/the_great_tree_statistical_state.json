				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Il nous faut plus de données !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Comment tes appareils peuvent-ils fonctionner sans données ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Tu ne commenceras pas à travailler tant que tu n'auras pas toutes les données, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "A-t-on besoin de scruter la moindre vague pour attraper un poisson ? Non ! Il suffit de se concentrer sur celle qui amène le poisson !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "Et c'est pour ça que tu n'attraperas jamais de poisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Allez, tu n'as pas étudié à l'Hara{RUBY#[S]Sémiotique}vatat ! Alors arrête de pinailler, d'accord ? Il faut vraiment qu'on se mette au travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Si on continue à tarder, notre papier avec Yasmin ne sera même plus d'actualité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "Pourquoi vous vous disputez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Qui êtes-vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "#Vous devez être {M#le voyageur}{F#la voyageuse} dont Yasmin a parlé. Vous nous avez beaucoup aidés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "#Enchanté ! {M#Voyageur}{F#Voyageuse}, c'est un plaisir de vous rencontrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Je m'appelle Pharez et j'étudie actuellement au Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Je m'appelle Ladep, j'étudie au Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pourriez nous rendre un petit service, à nous aussi{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Vous devez savoir que Yasmin a répandu des potions autour des racines de l'arbre divin dernièrement, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Eh bien... Euh... Il semble y avoir des problèmes avec la potion de Yasmin ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "Il y a toutes sortes de monstres qui sont apparus autour de la zone où elle a versé la potion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Je t'assure, je n'ai modifié aucun ingrédient ni aucune proportion dans la formule. Ça doit être... Euh... Un phénomène inattendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "#Tu peux dire ce que tu veux... Quoi qu'il en soit, {M#voyageur}{F#voyageuse}, est-ce que vous pouvez venir avec nous à l'endroit où Yasmin a répandu la potion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Il y a peut-être encore des monstres là-bas, on n'ose pas y aller seuls... Il nous faut quelqu'un de fort pour nous accompagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "En plus, même si ces Fongus ne sont pas trop dangereux, si le tuteur apprend que notre potion peut causer de tels problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "On est sûrs de se faire recaler à notre thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "En particulier, au Spantamad, si les données soumises sont erronées, on est durement réprimandés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Comment vous faites d'habitude ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "D'habitude, on embauche des aventuriers, ou on va voir nos tuteurs et on leur demande de nous aider à trouver quelqu'un de confiance chez les Érémites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Mais notre tuteur a une patience limitée et vu les circonstances, on n'ose pas retourner le voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "#Alors, {M#voyageur}{F#voyageuse}, s'il vous plaît, donnez-nous un coup de main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
