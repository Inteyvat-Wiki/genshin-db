				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "Albedo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110102,
					"content": "#Vous êtes {F#revenues}{M#revenus}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110103,
					"content": "On s'est donné du mal pour votre épée ! Regardez-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110104,
					"content": "Oui, regardez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110106,
					"content": "Comme je le pensais, l'épée se renforce après chaque combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110107,
					"content": "Je pensais que cela ne s'appliquait qu'aux gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110108,
					"content": "C'est ce qui la rend spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110109,
					"content": "Ah oui, j'avais quelque chose d'important à vous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110110,
					"content": "J'ai découvert des traces dans la neige en me promenant dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110111,
					"content": "Ce ne sont quand même pas d'autres voleurs, j'espère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110112,
					"content": "Mais c'est nous les voleurs, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "C'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110115,
					"content": "Ces traces auraient besoin d'être examinées de plus près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110116,
					"content": "On saura alors si elles appartiennent à des voleurs ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110113,
					"content": "Voyons ce que les Pilleurs de trésors en pensent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
