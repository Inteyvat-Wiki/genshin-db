				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "Les Fatui ? De tous les lieux, ils choisissent de nous attaquer ici... On nous aurait suivis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110202,
					"content": "Mais pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110203,
					"content": "Vous les avez provoqués dans notre dos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110204,
					"content": "Et vous, alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110205,
					"content": "Comme si c'était possible !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "Peut-être qu'on l'a tous un peu fait sans le vouloir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110208,
					"content": "Les Fatui en ont après l'épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110209,
					"content": "Mais elle n'était pas censé être top secrète ? Comment connaissent-ils son existence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110210,
					"content": "Ils ont pu vous voir l'utiliser sur le chemin de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110211,
					"content": "S'ils ont l'œil, la particularité de cette épée ne leur a certainement pas échappé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110212,
					"content": "Les Fatui veulent toujours s'emparer de tout ce qu'ils peuvent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110213,
					"content": "Pas exactement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110214,
					"content": "J'ai entendu qu'ils manigançaient quelque chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "Les Fatui sont à la recherche d'objets ayant attrait aux Archons. Je pense que vous le savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110216,
					"content": "Ah, maître Diluc nous l'avait mentionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110217,
					"content": "Durin était l'ennemi de l'Archon Anémo et son pouvoir rivalisait même avec le sien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110218,
					"content": "On peut dire qu'ils ont été « liés » en quelque sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110219,
					"content": "Pas étonnant qu'ils aient jeté leur dévolu sur cette épée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110221,
					"content": "J'ai fait une découverte pendant une séance de croquis dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110222,
					"content": "Il y a une zone un peu plus loin où les lignes énergétiques ont un flux particulier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110223,
					"content": "Les monstres à proximité sont attirés par cette énergie et tombent sous son emprise. Résultat : leur puissance surpasse celle de leurs congénères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110224,
					"content": "Eh ben dites donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110225,
					"content": "Nous devons renforcer cette épée de toute façon. Allons nous frotter à ces monstres, tant qu'à faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110226,
					"content": "C'est ce que j'avais en tête. N'oubliez pas d'observer les différentes façons dont les monstres réagissent à l'épée aussi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110206,
					"content": "Nous ne ferions jamais ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "Alors, comment ça s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110302,
					"content": "L'épée est devenue plus puissante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "J'ai ma petite idée là-dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110305,
					"content": "À chaque fois que l'épée absorbe de l'énergie d'un ennemi vaincu, elle résonne avec les restes de Durin qui sont éparpillés dans la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110306,
					"content": "Waouh, incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110307,
					"content": "Si mon hypothèse est fondée, cela voudrait dire que tous les monstres du coin entreraient en résonance avec Durin aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110308,
					"content": "Pourquoi cela ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "Je crains que ça ait un lien avec la source du pouvoir de ces monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110310,
					"content": "Durin n'était pas une créature ordinaire. Même mort, la montagne est encore sous l'influence de son pouvoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110311,
					"content": "Un peu comme une malédiction en quelque sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110312,
					"content": "Il me faudra plus de données, car nous en savons encore très peu sur le sujet... C'est là que vous intervenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110313
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110313,
					"content": "On dirait qu'on va encore se retrouver à faire des heures supplémentaires pour vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110314,
					"content": "J'ai quelques recherches à terminer de mon côté, alors nous devrons travailler séparément pour l'instant. Retrouvons-nous plus tard près du pont endommagé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
