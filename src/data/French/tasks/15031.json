				]
			},
			"dialogs": [
				{
					"id": 150310201,
					"content": "J'ai l'habitude d'emprunter ce chemin. On aperçoit régulièrement des Avatars de lave qui se reposent sur le bord de la route...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310202,
					"content": "Leurs noyaux sont extrêmement chauds. C'est peut-être ce qu'il nous faut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310203,
					"content": "Je ne m'attendais pas à ce que tout le monde s'empresse de nous aider... On dirait qu'ils se méfiaient de ce champignon depuis un moment déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310204,
					"content": "Oui, et c'est grâce à vous ! De nombreuses personnes ont consommé ces champignons sans qu'une voix bizarre parle dans leur tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310205,
					"content": "C'est vrai... Même si vous vouliez enquêter, vous ne saviez pas par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310206,
					"content": "C'est donc une occasion en or ! L'arrogance du Seigneur-sage a très certainement éveillé l'esprit de compétition de ma tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310207,
					"content": "Vous aimez vraiment les compétitions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "On ne remarque pas ta compétitivité la plupart du temps, Varesa. En dehors des entraînements et des combats contre les monstres, en tout cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310209,
					"content": "En fait... Je n'aime pas particulièrement me battre ni concourir. Ce qui m'importe, c'est d'être heureuse au quotidien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310210,
					"content": "Mais madame Iansan m'a beaucoup appris. Elle m'a enseigné que la force est un moyen plutôt qu'une fin en soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310211,
					"content": "Nous devenons plus forts pour pouvoir utiliser notre robustesse quand c'est nécessaire, comme lors de l'invasion de l'Abîme. En m'entraînant à maîtriser mon œil divin, j'ai pu faire quelque chose pour l'arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310212,
					"content": "Qu'importe si je suis effrayée, je dois prendre mon courage à deux mains, car les gens comptent sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310213,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "Merci, j'y travaille. Un jour, je serai aussi courageuse que Fietena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310216,
					"content": "Allons-y. Continuons à chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310214,
					"content": "Je perçois de la force en toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
