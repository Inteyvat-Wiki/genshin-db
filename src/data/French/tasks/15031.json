			"dialogs": [
				{
					"id": 150310101,
					"content": "Le chef Acatl réunit toute la tribu pour écouter le rapport de Varesa sur les champignons.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310105,
					"content": "Ça ne m'avait pas marquée sur le coup, mais en l'entendant raconté comme ça, ça sonne un peu... ridicule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310106,
					"content": "Le silence en dit long...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "Les champignons du verger auraient donc une conscience. C'est une découverte incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310108,
					"content": "Il a raison. Sans votre enquête, qui sait ce qui aurait pu arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310109,
					"content": "#Merci de vous y être {M#intéressés}{F#intéressées} et d'avoir rassemblé autant d'informations !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "Xoctli"
				},
				{
					"id": 150310110,
					"content": "Quel soulagement. J'ai eu peur que vous pensiez que j'avais perdu la tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310111,
					"content": "Haha, il faut bien admettre que c'est un peu tiré par les cheveux. Après tout, personne d'autre que vous n'a jamais parlé à un champignon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310112,
					"content": "Mais nous savons tous que tu n'es pas une menteuse, Varesa. En plus, l'origine des champignons verts a toujours été un véritable mystère pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310113,
					"content": "Maintenant que nous savons que quelque chose se trame, nous sommes tous prêts à vous aider dans votre enquête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310114,
					"content": "N'hésitez pas à nous dire ce que nous pouvons faire pour aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310115,
					"content": "Vous n'avez pas hésité une seule seconde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310116,
					"content": "Merci beaucoup, tout le monde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "Vous avez dit que les champignons devaient être cuits à très haute température, c'est bien ça ? Je peux le faire rapidement, attendez un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310118,
					"content": "Voilà, je suis de retour ! J'ai utilisé de la fonte, ça devrait donc être suffisamment chaud !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310119,
					"content": "Waouh, ça sent tellement bon ! J'ai retrouvé l'appétit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310120,
					"content": "Dans ce cas, ne nous faisons pas prier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310121,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310122,
					"content": "Vous avez entendu ? C'est sa voix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310123,
					"content": "Haha. On dirait que vous avez appris quelque chose, mais cette température ne démontre même pas une fraction de la sincérité que j'exige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310124,
					"content": "Vous pensiez réellement qu'une source de chaleur et des outils ordinaires allaient vous permettre d'obtenir la reconnaissance du Seigneur-sage des Fongus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310125,
					"content": "Les humains sont tellement désespérants. Vous ne parvenez à résoudre mes énigmes que lorsqu'on vous apporte les réponses sur un plateau d'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310126,
					"content": "Mais dès qu'il n'y a plus d'indices... Il n'y a plus une once d'intelligence en vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310127,
					"content": "Réessayez en vous creusant les méninges cette fois, héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310128,
					"content": "Alors ? Vous avez entendu sa voix ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310129,
					"content": "Grr, ce champignon est vraiment agaçant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310130,
					"content": "Il a dit que la température n'était pas assez élevée pour répondre à ses exigences. Il est impossible à satisfaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310131,
					"content": "Le seul moyen de connaître ses intentions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "La température n'était pas assez élevée... Ça veut dire que nous allons avoir besoin d'une source de chaleur plus puissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310134,
					"content": "Votre attention, tout le monde. Il nous faut quelque chose capable de générer une source de chaleur intense. Tout ce que vous pourrez trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310135,
					"content": "Je vais voir ce que je peux faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310136,
					"content": "Je m'en occupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310137,
					"content": "Nous devrions aussi chercher, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310138,
					"content": "D'accord, mais on ne connaît pas encore bien les environs. Est-ce que tu as des idées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310139,
					"content": "Hmm... Pas encore, mais nous pourrions aller regarder près du volcan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310140,
					"content": "Il crache toutes sortes de choses. Nous y trouverons peut-être quelque chose d'intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310141,
					"content": "Très bien, allons-y ! J'espère trouver quelque chose de brûlant à jeter au visage de ce champignon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310132,
					"content": "Est de continuer à jouer le jeu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
