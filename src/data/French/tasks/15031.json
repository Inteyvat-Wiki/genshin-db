					{
						"sceneId": 3,
						"position": [
							-3047.629,
							233.936,
							9909.162
						],
						"pointId": 10931
					}
				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "Quelle belle récolte ! Nous avons ramassé des yeux lucides et cette chose qui crache du feu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "C'est son armure dorsale. Elle peut projeter du phlogistique et c'est ce qui lui permet d'être aussi agile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Mon père m'a dit un jour que ces créatures vivent généralement dans le volcan, nous avons vraiment eu de la chance d'en croiser une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "J'ai l'impression que cette armure pourrait produire encore plus de chaleur que les yeux lucides. Enfin, ça devrait suffire pour ces champignons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Tu t'es bien débrouillée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Oui... Même si je n'aime pas me battre, c'est parfois inévitable. J'ai donc réfléchi à la façon de passer en mode combat le plus rapidement possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Par exemple, j'ai lu beaucoup d'histoires de héros. Mon héroïne préférée est celle dont je vous ai déjà parlé, Fietena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Sa caractéristique la plus emblématique était son masque. J'ai donc aussi confectionné un masque d'après les descriptions dans les histoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "Lorsque je porte mon masque, c'est comme si je devenais Fietena en personne. Je dois donc mettre toutes mes peurs de côté afin de ne pas ternir son nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "Mais on pourrait penser que je me cache derrière sa force...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Mais ça fonctionne, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Vraiment ? Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "J'ai l'impression que... je devrais l'enlever un jour et affronter les choses par moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Mais plus j'attends, plus je deviens dépendante de mon masque, et... ça m'inquiète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "C'est pourtant bien toi qui as décidé de mener cette enquête.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Oui, c'est toi qui as eu le courage de prendre cette décision, et c'est ça, l'esprit de l'aventure ! Les combats n'en sont qu'une petite partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Tu as déjà fait beaucoup de progrès, ne t'inquiète pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "#Merci à {M#tous}{F#toutes} les deux. Vous m'encouragez et j'ai beaucoup appris grâce à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "Je vais continuer à m'améliorer jusqu'à ce que je puisse affronter les choses par moi-même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Maintenant que je me sens mieux, j'ai soudainement très faim !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "Quoi, tu as déjà faim ? Je n'ai même pas encore fini de digérer le repas précédent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Rentrons à la tribu. Cette fois, nous obtiendrons la reconnaissance du Seigneur-sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Et non pas ton masque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "Il n'y a pas lieu d'en avoir honte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
}