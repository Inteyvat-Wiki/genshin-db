			},
			"dialogs": [
				{
					"id": 150310301,
					"content": "Et voilà ! Ce noyau m'a l'air très bien. Regardez, le phlogistique qu'il contient est encore actif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Laisse-moi voir ! Waouh, ça brûle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Quelques morceaux comme celui-ci devraient suffire. Allons voir plus haut.",
					"roleType": "TALK_ROLE_NPC",
