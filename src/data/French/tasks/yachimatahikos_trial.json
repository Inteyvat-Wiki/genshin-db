			"dialogs": [
				{
					"id": 722680301,
					"content": "Moi, Uda des jibashiri, reconnais votre bravoure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680302
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680302,
					"content": "#Votre sagesse vous rend digne d'être {M#qualifié}{F#qualifiée} de personne méticuleuse et prévoyante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680303
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680303,
					"content": "Comment faites-vous pour déterminer le caractère d'une personne à partir de ce genre d'épreuve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722680304,
					"content": "Ces mots sont en réalité les mêmes que les prêtresses divines avaient l'habitude d'utiliser pour complimenter les jeunes personnes talentueuses. Ils ont ensuite été inscrits sur les fanions des quartiers généraux des jibashiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
