				"points": []
			},
			"dialogs": [
				{
					"id": 722680101,
					"content": "#Je suis Uda des jibashiri. {M#Héros}{F#Héroïne} de Sangonomiya, je vous considère comme digne de relever ce défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "Je serai responsable de l'épreuve de « sagesse ». Avancez-vous, et résolvez toutes les énigmes pour remettre les flammes de la grande porte à leur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "Avancer sans sagesse ne peut être considéré comme du courage. Ce n'est que de l'imprudence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "Je vous attendrai à la Tour des Trois Royaumes située un peu plus loin le temps que vous terminiez l'épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
