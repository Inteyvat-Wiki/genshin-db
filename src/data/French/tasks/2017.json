			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "Ah ! Ce petit Tanuki vient de se transformer en humaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "Mais qu'est-ce que c'est ? Je n'ai jamais rien vu de tel auparavant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "Pas un Tanuki... Je suis une mujina... *bâille* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "Je suis tellement fatiguée... Si je ne dors pas assez... Ça va ralentir ma croissance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Euh, c'est ça la « professionnelle » dont vous parliez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Euh... Elle n'a pas l'air professionnelle du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "Héhé... Elle est membre du Shuumatsuban, c'est une authentique ninja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "Waouh, une ninja ! Alors, c'était l'une de leurs légendaires techniques de transformation, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "Au fait, c'est quoi le Shuumatsuban ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Cela fait partie de la Commission culturelle. C'est une unité secrète sous les ordres de Kamisato Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Maintenant, Kamisato Ayato et la Commission culturelle sont des parties neutres. Je n'ai donc pas autorité pour donner des ordres au Shuumatsuban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Cependant, convaincre leur membre la plus paresseuse de nous aider est tout à fait dans mes cordes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Voilà ce que j'ai besoin que vous fassiez, tous : allez en ville et trouvez des preuves de la trahison de la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "Il serait malvenu pour moi de me montrer là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Ça paraît simple comme ça, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "Je n'ai aucune idée de ce que je cherche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Hmm ? Oh, je pensais que tu l'aurais compris maintenant. Bon, je vais te donner un peu plus d'informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Pour quelqu'un de l'extérieur, comprendre le fonctionnement interne de la Commission administrative est presque impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Mais comme les Trois Commissions travaillent ensemble pour servir la Shogun, elles entretiennent des relations étroites. Quelqu'un venant de l'une des autres Commissions pourrait donc avoir plus de facilité à déterminer ce qu'ils préparent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "La Commission culturelle !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Héhé... Maintenant tu me suis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "L'armée du Shogunat n'a pas encore abandonné ses recherches à ton encontre, mais avec l'aide de cette ninja du Shuumatsuban, je suis sûre que tu pourras retrouver tes amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "Mais n'oublie pas que le temps presse. Assure-toi de rapporter la preuve à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "De quelle preuve parlez-vous, exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
