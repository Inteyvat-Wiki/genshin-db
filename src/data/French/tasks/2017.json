			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170701,
					"content": "Hmm... C'est bien ce que je me disais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170702,
					"content": "Il y a vraiment plein de gens... Si l'un d'eux me repère, je vais me faire prendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "On doit s'en débarrasser, ou je ne pourrai pas me faufiler à l'intérieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "On va devoir faire confiance à Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Une fois que j'ai récupéré le document, rendez-vous au <color=#00E1FFFF>Salon de thé Komore</color>, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Et puis, si je me fais prendre... Viens me sauver, s'il te plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "C'est vraiment une bonne idée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "Euh... Bon, de toute façon, dirigeons-nous vers la <color=#00E1FFFF>Statue de la divinité omniprésente</color> ! Attention aux gardes... Et il ne faut pas se faire prendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201709,
			"completionStepIds": [
				201709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201709",
							"2"
						],
						"stepId": 201709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#Eh bien, {NICKNAME} ? Comment ça s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170902,
					"content": "#Je ne suis pas {M#sûr}{F#sûre}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Bien joué. Attendons Sayu maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170905,
					"content": "Un peu plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170906,
					"content": "*halète* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170907,
					"content": "Je sais que l'exercice aide à grandir, mais c'était un peu trop d'exercice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170908,
					"content": "J'ai le vertige... Tout le monde tourne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170909,
					"content": "Non, je ne peux pas encore dormir ! Il y avait quelque chose d'important que je devais faire en premier... Oh, oui. Je sais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170910,
					"content": "Je ne savais pas comment trouver le document dont vous parliez, alors j'ai juste pris tout un tas de trucs qui avaient l'air suspects.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170911,
					"content": "Et voilà... Bon, je vais faire une sieste maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170912,
					"content": "Mademoiselle, qu'est-ce que tout ceci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170913,
					"content": "Cette enveloppe cachetée doit être un rapport officiel que la Commission administrative s'apprête à présenter à la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170914,
					"content": "De plus, nous avons... une correspondance avec les Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170915,
					"content": "Il semble que la Guuji Yae avait raison. Ils ont fomenté en coulisses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, cela devrait être une preuve suffisante. Veuillez apporter ces documents à la <color=#00E1FFFF>Guuji Yae</color>. J'espère qu'elle aura un plan pour la prochaine étape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170917,
					"content": "Je vais de mon côté rassembler des personnes pour essayer de chasser ce qu'il reste des Fatui à Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170918,
					"content": "Faites attention quand vous affronterez la Shogun. Rien que de l'imaginer dégainer sa lame, j'en ai encore froid dans le dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170919,
					"content": "Nous allons devoir faire confiance à la Guuji Yae une fois de plus. Elle est proche de la Shogun. Elle aura peut-être un moyen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170920,
					"content": "Si je ne dis pas de bêtises, il devrait être bientôt l'heure de notre rencontre avec Yae Miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170921,
					"content": "Prenons nos affaires et allons au <color=#00E1FFFF>Sanctuaire de Narukami</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170903,
					"content": "#On a allumé le feu d'artifice et on s'est {M#enfuis}{F#enfuies}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
