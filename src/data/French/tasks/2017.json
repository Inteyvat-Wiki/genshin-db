			},
			"dialogs": [
				{
					"id": 20171000,
					"content": "Yoimiya, on a besoin d'un feu d'artifice super gros ! Du genre qui fait un giga méga boum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171001
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171001,
					"content": "Un feu d'artifice super gros ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171002
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171002,
					"content": "Héhé, vous vous adressez à la bonne personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171003
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171003,
					"content": "Il se trouve que j'en ai justement préparé un gonflé à bloc il y a quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171004
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171004,
					"content": "Mais il est tellement puissant que je n'ai trouvé nulle part où le tester... Autant vous le donner. Et puis, vous me direz comment ça s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171005,
					"content": "N'oubliez pas : éloignez-vous bien après avoir allumé la mèche et essayez d'éviter de brûler vos vêtements. Et puis, il vaut mieux que vous vous bouchiez les oreilles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171006,
					"content": "Euh, je ne me sens pas super rassurée d'un coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171007,
					"content": "Hahaha, ne vous inquiétez pas, c'est juste un feu d'artifice. Voyons, quel est le pire qui puisse arriver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171008,
					"content": "On va l'essayer... Merci, Yoimiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
