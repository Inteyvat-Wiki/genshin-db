					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thomas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170404,
					"content": "Avez-vous rencontré la Résistance ? Comment se passe la bataille ? Est-ce que je peux sortir sans danger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170405,
					"content": "Pas encore... On a vu des patrouilles en venant ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "#Alors ce n'est toujours pas fini... Je suppose que vous êtes {M#venus}{F#venues} pour discuter de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170407,
					"content": "Je vais demander à quelqu'un d'appeler mademoiselle Kamisato. Attendez un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170408,
					"content": "Vous informez Ayaka et Thomas de la situation actuelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Je vois. Il est arrivé beaucoup de choses depuis notre dernière rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Je comprends. Vous avez besoin d'une preuve de la trahison de la Commission administrative. Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Maintenant que vous le mentionnez, il y a une chose qui m'a toujours préoccupée. L'armée du Shogunat est en guerre contre la Résistance depuis longtemps maintenant, mais pas une seule fois la Shogun n'a posé de questions à ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "J'avais l'habitude de penser qu'elle s'en fichait tout simplement, mais en y réfléchissant maintenant... Peut-être que le problème depuis le début est dans les <color=#00E1FFFF>rapports de la Commission administrative</color> à la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "Qu'est-ce que vous voulez dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "La Commission administrative contrôle les affaires militaires du royaume. Si jamais ils avaient l'intention de dissimuler des informations dans leurs rapports, nous n'aurions aucun moyen de le savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Pendant ce temps, la Shogun conclurait à tort que le décret de saisie ne représente aucune menace et s'en tiendrait à sa décision. Si nous avions accès à leurs rapports, cela confirmerait tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Mais si je me souviens bien, la seule personne autorisée à consulter ce genre de documents officiels est Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170417,
					"content": "L'endroit est également bien gardé. Même avec l'aide de Sayu, dérober un document sous leur nez n'est pas chose aisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170418,
					"content": "Si seulement il y avait un moyen de distraire les gardes suffisamment longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "Une distraction, vous dites...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "Les feux d'artifice de Yoimiya !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170423,
					"content": "Une idée typique de Thomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Mais raisonnable... La Statue de la divinité omniprésente est juste à côté de la Commission administrative. Si quelqu'un allumait un feu d'artifice près de la statue, ils ne pourraient pas l'ignorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Pendant qu'ils s'en occupent, Sayu pourrait infiltrer la Commission administrative et prendre le rapport, ainsi que toute autre preuve qu'elle pourrait trouver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "Parfait ! J'ai l'impression que je serai bientôt un homme libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170427,
					"content": "Ah... J'ai l'impression que ça fait une éternité depuis la dernière fois qu'on s'est assis pour discuter comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170428,
					"content": "Ça ne fait pas si longtemps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Eh bien, c'est mon impression en tout cas... Pas un jour n'est passé sans que j'espère vous revoir depuis que je suis ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170430,
					"content": "C'était ma cachette préférée ici, mais maintenant... Honnêtement, je ne sais plus depuis combien de temps je n'ai pas mis les pieds dehors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170431,
					"content": "Ah, j'ai tellement envie d'aller aux sources chaudes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170432,
					"content": "Pauvre Thomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Concentrons-nous déjà sur le problème que nous avons. Plus vite le décret de saisie sera aboli, plus vite Thomas sera libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Il est vrai qu'il s'agit de retrouvailles, mais nous n'avons pas le temps de discuter. Nous célébrerons comme il se doit quand tout sera fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "Oh, on se refera un défi de la marmite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 20170436,
					"content": "Vous y pensez encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "#La Commission administrative est bien gardée. Soyez {M#prudents}{F#prudentes} lorsque vous vous approcherez. Retrouvons-nous ensuite ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Bon, {NICKNAME}, allons d'abord à <color=#00E1FFFF>Hanamizaka</color> pour voir <color=#00E1FFFF>Yoimiya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Ce ne serait pas notre première fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
		{
			"id": 201707,
			"completionStepIds": [
				201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
