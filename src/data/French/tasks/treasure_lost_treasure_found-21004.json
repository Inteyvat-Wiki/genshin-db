						210040902
					]
				},
				{
					"id": 210040902,
					"content": "Tu y vas ? Reviens me voir si tu trouves du nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Personne n'échappe à son destin, même les Archons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "J'ai trouvé quatre indices dans quatre ruines.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Quatre ruines, quatre indices... Encore le nombre quatre, comme les Commandements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Mais... Chacun de ces indices semble expliquer l'un des Quatre Commandements, on dirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Une chose est sûre : pour déchiffrer l'énigme, la bonne interprétation des Commandements est la clé. Ces quatre passages aident, mais ne contiennent pas la réponse directement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "Tout ça est lié, mais comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "« Et que ces quatre préceptes soient réunis »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Comme s'il fallait trouver le moyen de lier les Commandements ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Attends... Je me souviens maintenant. Chacun des Quatre Commandements se trouve dans des ruines spécifiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Hum... J'aurais bien une hypothèse, mais peut-être que les quatre <color=#00E1FFFF>ruines</color> permettent de déchiffrer le vrai sens derrière ces Commandements...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "De quelle manière, je n'en ai pour l'instant aucune idée. Il faut que je réfléchisse... Ou mieux, il faudrait s'y rendre et enquêter sur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "Je ne suis qu'une chercheuse qui s'écroule au bout de quelques pas... Ah, j'aimerais être aussi endurante que toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Bien. Je vais rester ici à réfléchir au problème ; si tu as d'autres idées, ou que tu trouves d'autres informations, reviens me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100422",
							"2"
						],
						"stepId": 2100422,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042201,
					"content": "Tout ça n'est que spéculation, mais... Je pense que chacune des ruines correspond à l'un des Commandements, et pourrait aider à mieux comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "Mais de quelle manière, je l'ignore encore. Et puis... Je ne suis pas costaude pour tester ma théorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "Enfin, ce genre de pensée ne me mènera nulle part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100430,
