				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Tu as trouvé le trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "En effet ! Il fallait bien trouver où convergent les quatre passages.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Intéressant... Comme le disait le texte, le trésor était où sont « réunis » les « quatre préceptes » alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Celui qui a rédigé cette énigme devait être un vrai fidèle de Guizhong, j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Il aura pensé à transmettre les commandements, même lorsque sa terre natale a été détruite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "Quant à cette Guizhong, nul doute qu'elle chérissait son peuple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Visiblement, les Quatre Commandements peuvent se comprendre ainsi : elle souhaitait que son peuple s'appuie sur la sagesse et gouverne avec droiture, soit sain de corps et d'esprit, et soit uni... Uni dans la défense de leur terre, l'Agora Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Mais elle a échoué.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Échoué ? Tu n'as pas complètement tort, elle en est morte après tout... L'Agora Guili a été détruite, et son peuple s'est dispersé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Mais regarde, ne sommes-nous pas en train de faire revivre ses commandements ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Ces textes ont autrefois été rédigés par la déesse en personne à l'intention de ses disciples, et ont été transmis comme une bénédiction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Il fut un temps autrefois où elle guida son peuple jusqu'à ces terres, en s'appuyant sur ces préceptes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Elle n'est peut-être plus de ce monde, mais ses idéaux eux demeurent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Et ses fidèles n'étaient pas idiots : ils ont utilisé le prétexte d'un trésor pour s'assurer que les Quatre Commandements de Guizhong continuent d'être transmis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Mais je me demande... Pour ces gens, qu'est-ce qu'un trésor ? Des pierres précieuses, des richesses, ou... juste les commandements ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Enfin, pour moi, ces textes ont bien plus de valeur que n'importe quel trésor, haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "... Mais combien de personnes, si elles ont le choix, choisiront les commandements plutôt que la richesse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "C'était une déesse d'un naturel aimable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Hum, pas sûr que ces termes lui rendent justice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Enfin, peut-être qu'autrefois, il y a très longtemps, vivaient des Archons « d'un naturel aimable », comme tu dis, guidant les peuplades du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Ceux qui protégeaient leurs fidèles, marchaient parmi eux, et restèrent à leurs côtés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "... Mais le « naturel aimable » ne suffit pas à protéger les hommes. Regarde, il aura même fallu prévoir une chasse au trésor élaborée juste pour préserver ses enseignements...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "J'aurais bien aimé la rencontrer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Tu voudrais rencontrer un Archon ? Tu n'es décidément pas quelqu'un d'ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Mais... Admettons que tu rencontres la déesse ; qu'est-ce que tu ferais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "Tu lui dirais « merci », de ne pas s'en faire ? Tu la consolerais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Moi, je crois que je lui réciterais les Quatre Commandements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "Et puis je lui dirais que ses idéaux sont toujours présents, et que les hommes de ces terres se rappellent encore de ses enseignements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Je pense que pour quelqu'un comme Guizhong, qui a tout perdu... Oui, voilà ce qu'elle aimerait entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
