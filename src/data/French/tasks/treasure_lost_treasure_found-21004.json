			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "« Les Quatre Commandements de Guizhong »... Qu'est-ce que ça signifie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "Hahaha, tu ne manques pas de motivation. Bien, voyons si on arrive à déchiffrer ces « Quatre Commandements ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "« Enseignez avec sagesse, dirigez avec vertu, faites preuve de force d'âme, soyez uni dans l'ambition ; et que ces quatre préceptes soient réunis en un lieu nommé « Agora Guili ». »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "Si on se fie à ce qui est écrit, on dirait bien un ensemble de règles à appliquer dans la vie quotidienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Mais... Si cette phrase contient un indice sur la position d'un trésor, où peut-il bien être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "... Hum, je ne vois pas, non. Je crois bien qu'il va falloir y aller à l'ancienne, comme on dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Résumons. Les sept passages que nous avons découverts étaient tous situés dans des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Peut-être serait-il plus avisé, en l'absence d'autres indications, de continuer d'explorer des ruines pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "Mais où chercher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Hum... Pour l'instant, mieux vaut se limiter aux Plaines Guili, je pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Mais... Je ne suis qu'une chercheuse, et je serai bien incapable de marcher à ton rythme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "#Je te laisse chercher {M#seul}{F#seule} ; reviens me voir si tu trouves quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "D'ailleurs, j'y pense... J'ai découvert des ruines par ici autrefois... Et il y avait des drôles de disques, si mes souvenirs sont bons, avec des inscriptions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Mais je n'ai pas creusé à l'époque, mes recherches portant sur autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Mais au vu de ce qu'on a appris... Il n'est pas impossible que les disques en question aient un rapport avec ces « Quatre Commandements ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Laisse-moi t'indiquer les emplacements sur ta carte ; tu pourrais aller y faire un tour. Qui sait, il y aura peut-être quelque chose d'intéressant à découvrir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "Euh... Il faut que je visite TOUT ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Haha, bien sûr que non ! Même à deux, on serait bien incapables de couvrir toutes les ruines de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Mieux vaut réduire la zone de recherche. Puisque le texte mentionne l'Agora Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Limitons-nous aux Plaines du même nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Ah, et... Je ne suis qu'une chercheuse, je crains bien de ne pas être de taille à t'accompagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "#Je te laisse chercher {M#seul}{F#seule} ; reviens me voir si tu trouves quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "Compris ! Je m'en vais visiter toutes les ruines de Liyue !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Attends ! Bravo pour l'énergie, mais... Liyue ! C'est bien trop grand !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Quelle enthousiasme dès qu'on parle de trésor... Mais, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Puisque le trésor est apparemment sans l'Agora Guili, mieux vaut limiter les recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Je suggère de chercher d'abord dans les Plaines Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "Attends ! Encore une chose ! Cherche les ruines avec soin, et reviens me voir si tu trouves quelque chose d'intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Rappelle-toi : cherche dans les Plaines Guili, pas la peine d'aller courir à l'autre bout du monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Direction le trésor !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Décidément, tu aimes les trésors... Bien, commençons à déchiffrer ces « Quatre Commandements ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
