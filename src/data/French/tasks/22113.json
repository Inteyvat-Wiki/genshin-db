					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Super ! Ces monstres étaient d'une nuisance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
