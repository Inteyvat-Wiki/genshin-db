			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "En ce moment, il ne m'arrive que des bricoles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "Vous êtes encore en train de réparer l'escalier ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Ah, vous tombez à pic. Je vous remercie encore pour la dernière fois, mais je vais devoir vous embêter de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Cette fois-ci, la fissure est plus grande et j'ai commandé des planches supplémentaires. Le porteur était censé me les ramener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "Mais je n'aurais jamais pensé qu'il se ferait attaquer par un monstre sur le chemin. Bien sûr, il est revenu sans les planches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Le pauvre est complètement traumatisé. Il m'a indiqué où il avait laissé les planches, mais pas moyen qu'il aille les chercher lui-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "Après avoir réfléchi, je pense qu'il n'y a que vous qui pourriez m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Très bien alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Merci beaucoup. Je vous attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "Cette fissure est sacrément impressionnante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "N'ayez pas cet air terrifié... Ce n'est pas un monstre qui a fait ça ! Ce serait un monstre gigantesque si c'était le cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Non, non... Voilà ce qui s'est passé. Deux clients sont arrivés ici l'un après l'autre ; ils ont passé le plus clair de leur temps à s'éviter, le premier cherchant le second, et le second se cachant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Jusqu'au moment où ils ont tous les deux décidé de dormir ici pour la nuit... Résultat : ils se sont retrouvés nez à nez l'un avec l'autre dans les escaliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "Les coups ont commencé à partir immédiatement... et les escaliers ont été endommagés pendant leur bagarre. J'ai mis du temps à les séparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "J'étais furieux... alors je leur ai fait payer l'équivalent de trois nuits en supplément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Bref, restons-en là pour les ragots. Allez me chercher des planches pour que je répare ça, fissa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Si ça recommence un jour, je leur dirais de réparer tout par eux-mêmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
