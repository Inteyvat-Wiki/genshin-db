			"dialogs": [
				{
					"id": 221130501,
					"content": "C'est terminé ! Je me débrouille en bricolage, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "Nos hôtes pourront descendre ces escaliers sans danger désormais, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
