			"dialogs": [
				{
					"id": 230280501,
					"content": "Yasmin ! Waouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "Je... J'arrive plus à respirer ! Partons d'ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "Qu'est-ce que c'est que... cette odeur ! *tousse* ... Ahem !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "On dirait que Ladep a fait du bon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280505,
					"content": "Je crois que c'est bon. Allons répandre la potion au prochain endroit. Ce n'est pas loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
