			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awan",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmin ? Qu'est-ce que tu fais là ? Tu es revenue répandre ta potion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280402,
					"content": "Ces racines se portent très bien, nul besoin de ta potion ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280403,
					"content": "Oui, mais il faut tout de même les entretenir en continu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280404,
					"content": "Attendre que les problèmes arrivent pour y penser, c'est comme si on roulait la pâte d'un rouleau au poisson pour finalement se rendre compte que le poisson n'est pas encore cuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280405,
					"content": "Qu'il s'agisse de refaire ou de dérouler la pâte, c'est compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280406,
					"content": "Je sais que je n'arriverai pas à te convaincre... Mais je t'ai aussi parlé de l'odeur de cette potion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280407,
					"content": "J'habite dans le coin et je ne veux pas m'endormir en sentant cette odeur bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280408,
					"content": "Rassure-toi, j'ai demandé à Ladep d'ajuster la formule de la potion, son odeur ne sera pas aussi prononcée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280409,
					"content": "Bon, je vais y aller. Ne va surtout pas répandre ta potion dans ma cour, je ne la supporte pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280410,
					"content": "#D'accord, j'ai compris. {M#Voyageur}{F#Voyageuse}, passez-moi la potion dans ce coffre, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280411,
					"content": "Vous répandez la potion avec Yasmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "Cette potion sent vraiment mauvais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "Vous avez l'air de ne rien sentir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "Si vous parlez de l'odeur... J'ai été exposée à beaucoup de choses bien pires que cette potion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280415,
					"content": "Ça fera l'affaire. En plus, j'ai collecté plein de données. Pharez sera content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280416,
					"content": "#{M#Voyageur}{F#Voyageuse}, voici pour vous. Merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280417,
					"content": "Je me demande comment ça se passe pour Ladep et Pharez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
