			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "La force du dragon pourrait aussi ressusciter des végétaux morts et leur conférer une certaine puissance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130602,
					"content": "Incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130603,
					"content": "Comment un tronc d'arbre mort a-t-il pu se transformer en un ennemi aussi redoutable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130604,
					"content": "J'ai failli me faire manger toute crue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130605,
					"content": "C'est la première fois qu'une telle chose arrive, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130606,
					"content": "Cet arbre a été revigoré, car l'épée est tombée au sol. Une once de son pouvoir s'en est sûrement échappée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130607,
					"content": "Pardon ! C'est totalement de ma faute, mais ne me laissez pas tomber, par pitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130608,
					"content": "Je ne bougerai plus, promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130609,
					"content": "Pallad, tu n'as pas besoin de te rouler en boule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130610,
					"content": "*soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130611,
					"content": "Cet Arbre congelé est mort à cet endroit. Est-ce parce qu'il n'a pas été capable d'absorber le pouvoir corrompu de Durin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130612,
					"content": "L'énergie que vous avez purifiée l'a ressuscité, et même revigoré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130613,
					"content": "Elle lui permet de se régénérer sans arrêt... On dirait qu'elle lui confère aussi une certaine combativité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130614,
					"content": "La situation est pire que ce qu'on pensait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "C'est aussi la première fois que j'assiste à un tel phénomène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130617,
					"content": "Bien qu'il ne soit pas commun, cela n'enlève rien à sa valeur dans le cadre de mes recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130618,
					"content": "Sucrose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130619,
					"content": "O—Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130620,
					"content": "Garde un œil sur cet aventurier et ramène-le au campement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130621,
					"content": "Compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130622,
					"content": "#En ce qui nous concerne, il semble que j'aie encore besoin de votre assistance, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130623,
					"content": "Je ferai de mon mieux pour vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "Des problèmes inattendus, mais nous seuls pouvons les résoudre. Parce qu'on se surpasse toujours plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130615,
					"content": "#Je ne m'attendais pas à ça. Est-ce que je suis trop... {M#fort}{F#forte} ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
}