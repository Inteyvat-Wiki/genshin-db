					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130501,
					"content": "J'ai accouru dès que j'ai entendu tout ce bruit. C'était donc vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130502,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130503,
					"content": "A—Albedo... Je ne voulais pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130504,
					"content": "Tu n'étais pas censée être en train d'organiser des documents ? Comment t'es-tu retrouvée ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130505,
					"content": "Tu t'es même retrouvée mêlée à un combat contre des ennemis dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130506,
					"content": "Toutes mes excuses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "Pourquoi je me sens coupable, moi aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130508,
					"content": "Euh, ah... J'étais seulement... Pardon, je passais seulement dans le coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130509,
					"content": "Je suppose que quelque chose a piqué ta curiosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130510,
					"content": "#Je lui ai parlé de l'épée, {M#désolé}{F#désolée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "Vous lui avez tout raconté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130512,
					"content": "Nous avons seulement évoqué ses origines et ses propriétés, en faisant bien gaffe à ce qu'elle ne la touche pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130513,
					"content": "Soit. Ce n'est pas comme si nous pouvions le lui cacher encore longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130514,
					"content": "Sucrose s'interroge naturellement sur les secrets et les mystères. C'est essentiel pour un bon alchimiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130515,
					"content": "Ah, euh... Je vous promets que je ne causerai plus de problèmes ! Je le jure sur les fleurs sucrantes tétrataniques que je viens de découvrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130516,
					"content": "Je m'inquiète pour ta sécurité. Sois plus prudente à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130517,
					"content": "D'ailleurs, qu'est-il arrivé à cet aventurier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130518,
					"content": "J'ai fait de mon mieux pour le protéger pendant le combat. Tout devrait aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130519,
					"content": "Brrr... Q—Qu'il fait f—froid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130520,
					"content": "Il a l'air d'avoir attrapé froid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130521,
					"content": "Ahhh, je n'y avais pas pensé ! Toutes mes excuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130522,
					"content": "Je m'occupe de lui, monsieur Albedo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130523,
					"content": "Fais donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130524,
					"content": "Sucrose est peut-être réservée, mais c'est une enfant au grand cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130525,
					"content": "Tu es mal placée pour la qualifier d'« enfant »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "Pas faux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130527,
					"content": "Elle se retrouve dans des endroits étranges dès qu'on la quitte des yeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130528,
					"content": "C'est ce qu'il se passe quand on est jeune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "C'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130530,
					"content": "Ne soyez pas trop dur avec Sucrose, elle ne voulait pas vous causer d'ennuis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "Ne vous en faites pas, je ne suis pas fâché contre elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130532,
					"content": "Hé ? On dirait qu'il y a un truc qui brille sur l'épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130533,
					"content": "Oh ? Un changement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130534,
					"content": "L'épée est devenue encore plus puissante qu'avant. Comment avez-vous fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130535,
					"content": "#On s'est {M#battus}{F#battues} avec les Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "Certains d'entre eux étaient plus coriaces que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130537,
					"content": "Pourrait-il s'agir d'une énergie qui lui est inconnue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130538,
					"content": "Et qui l'a rendue encore plus forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121306,
			"completionStepIds": [
				4121314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121314",
