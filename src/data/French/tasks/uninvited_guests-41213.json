						],
						"stepId": 4121305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Extraordinaire... Cette arme n'est vraiment pas comme les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130202,
					"content": "#Tu es aussi {M#exceptionnel}{F#exceptionnelle}. Ta posture de combat et tes mouvements d'épée sont impeccables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130203,
					"content": "Tu me flattes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Je ne voulais pas me plonger dans de nouvelles recherches, mais cette épée attire mon regard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130205,
					"content": "Ce n'est pas la faute de l'épée. C'est dans ta nature, Sucrose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "Une épée dangereuse, mais captivante... Oui, ça ne fait aucun doute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130207,
					"content": "Albedo doit vraiment vous accorder une grande confiance pour vous confier un objet pareil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130208,
					"content": "#Ça m'a aussi {M#surpris}{F#surprise}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Héhé, tes prouesses l'ont convaincu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "Paimon a raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130212,
					"content": "L'épée ne semble pas avoir absorbé beaucoup d'énergie avant d'être en ta possession... Comment Albedo a-t-il fait pour la repérer parmi tant d'autres objets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130213,
					"content": "Il y a des éclairs de génie qui ne s'expliquent pas, tout comme mon envie de délice de viande et carottes au miel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "Ah, ça me rappelle que je n'ai pas vraiment mangé aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130215,
					"content": "Je suis partie à votre recherche juste après le travail. Sur la route, j'ai aidé un aventurier coincé dans la neige et ça m'a pris du temps pour le sortir de là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130216,
					"content": "*gargl* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130217,
					"content": "C'est ton estomac qui vient de gargouiller ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Ahhhh !! N—Non, c'est pas ce que tu crois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130219,
					"content": "Ne sois pas timide ! Tu peux dire ce que tu penses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Hum, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130221,
					"content": "Je vais t'aider : « Je meurs de faim ! On devrait aller chercher quelque chose à manger ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "J'ai faim aussi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "Je... J'ai faim. Euh, je voudrais manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130225,
					"content": "Ouah, c'est quand même la honte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130226,
					"content": "Il n'y a rien de honteux ! C'est naturel d'avoir faim et la nourriture n'en est que plus bonne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130228,
					"content": "Bien sûr que oui ! Allez, en route pour le camp où on pourra cuisiner un bon repas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "Un bon petit délice de viande et carottes au miel sera idéal pour nous réchauffer par cette météo glaciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "Je veux manger !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "#Je suis {M#reconnaissant}{F#reconnaissante} qu'il me fasse confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
