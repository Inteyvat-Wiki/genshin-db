			"dialogs": [
				{
					"id": 412130301,
					"content": "Brrrr... Glaglagla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130302,
					"content": "Pallad ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130303,
					"content": "Tu n'es pas encore parti ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130304,
					"content": "Tiens, mais c'est cet aventurier de Mondstadt... Il est venu explorer la zone avec Cyrus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "F—F—Froid... ATCHOUM !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130306,
					"content": "Ne me dis pas que tu es resté ici depuis que je t'ai sorti de la neige ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130307,
					"content": "J—Je voulais m—m'en aller, m—mais je me suis perdu ! Désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130308,
					"content": "Ah, j'ai si fr—fr—froid... Je p—peux à p—peine b—bouger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Pallad"
				},
				{
					"id": 412130309,
					"content": "S'aventurer dans la montagne nécessite de la préparation. Tu n'aurais pas dû prendre ça à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130310,
					"content": "On va l'accompagner jusqu'en bas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "J'apprécie ton offre mais j'ai bien peur que dans son état, il ne puisse pas marcher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130312,
					"content": "On ne peut pas le laisser ici de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "Tu as raison... Toutes mes excuses. D'ailleurs, je pense que lui aussi est désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130314,
					"content": "Vous devriez penser à votre propre peau au lieu de vous inquiéter pour celle des autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "Encore les Fatui ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "Vous connaissez sûrement la raison de notre présence ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "On ne vous laissera pas partir tant qu'on n'aura pas mis la main sur cette épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "Non ! Ne leur donne pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130319,
					"content": "Vous pouvez toujours rêver !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "Bien dit ! Profitons-en pour les mettre hors d'état de nuire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Viens, Pallad ! Je vais t'emmener en sécurité, vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130323,
					"content": "Si vous croyez qu'on vous laissera filer, vous vous mettez le doigt dans l'œil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "Cette épée fera un excellent cadeau pour Son Excellence Signora !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "Comme si j'allais me laisser faire !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
