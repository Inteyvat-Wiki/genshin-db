			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "Albedo ! Nous revoilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "Hé, mais il n'est pas là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "Peut-être qu'il est parti faire un tour ou en train de dessiner quelque part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "Oh, mais c'est vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130105,
					"content": "Sucrose ! Mais qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "J'ai terminé mes recherches pour l'instant, alors je m'accorde cinq heures et vingt-six minutes de pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130107,
					"content": "Et je suis donc venue pour vous demander comment vous vous en sortiez avec la mission que je vous ai confiée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130108,
					"content": "Tu es très précise, dis donc. On dirait une horloge humaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "N—Non, pas du tout ! Tu es trop gentille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130110,
					"content": "Ce n'était pas un compliment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "Je... Je peux te poser une question ? Euh, à propos du secret d'Albedo... Tu as du nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130112,
					"content": "Dis-moi si je me trompe, mais ça fait une semaine qu'on en a parlé, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "Je pensais que tu avais oublié.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130115,
					"content": "U—Une semaine ?! J—Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130116,
					"content": "J'étais tellement absorbée par mon travail que j'ai carrément oublié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130117,
					"content": "Comment tu fais pour avoir une notion du temps aussi aléatoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "D—Du coup ! Vous savez ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130119,
					"content": "Oui, en quelque sorte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Bien ! Vous pouvez me le dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130122,
					"content": "Est-ce qu'on devrait, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Hum, je pense qu'on peut lui raconter. Ça change pas grand-chose qu'elle le sache, à mon avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "On peut même lui montrer, mais interdiction de toucher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Euh, mais de quoi vous parlez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130126,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130127,
					"content": "Le secret d'Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "C'est une épée super puissante ! Ne la touche pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130131,
					"content": "Oh, mais !! C'est du jamais-vu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130132,
					"content": "Tu peux la regarder autant que tu veux ! Étrangement, j'en ressens une certaine satisfaction !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "Fascinant ! C'est la première fois que j'entends parler d'une telle arme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130134,
					"content": "Je peux sentir son pouvoir... comme si elle vivait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130135,
					"content": "C'est si évident que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "J'y arrive peut-être grâce à ma formation d'alchimiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130137,
					"content": "Ce n'est pas tout à fait exact, mais disons que le « flux » de pouvoir est très perceptible. Je n'ai pas l'habitude de définir ce genre de phénomène...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130138,
					"content": "Croyez-moi, je n'utilise pas ce genre de termes ambigus d'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130139,
					"content": "D'accord, on comprend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "#{M#Voyageur}{F#Voyageuse}, dis-moi... Tu peux combattre avec cette épée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130141,
					"content": "J'aimerais en savoir davantage à son sujet, mais je ne peux pas la manier. Je m'en remets donc à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130142,
					"content": "En secret, alors. Albedo ne doit pas savoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Partons à la recherche d'un endroit adéquat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "Trouvons un endroit plus discret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "La réponse à ta question.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Mission accomplie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
