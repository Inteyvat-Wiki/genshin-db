			"dialogs": [
				{
					"id": 721402301,
					"content": "#Oh, {NICKNAME}. Je ne pensais pas vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Ça fait longtemps qu'on ne s'est pas vus ! Comment tu trouves le monde en dehors de l'Île de Yashiori ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "Ils sont beaucoup plus riches que dans ma ville natale ici... Il y a plein de plats délicieux et de choses amusantes à faire. Mais... Je n'aime pas vraiment ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "Les gens ici semblent tous manquer de quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Quand on vivait sur l'Île de Yashiori, Son Excellence était une présence lointaine mais apaisante pour nous... On ne se préoccupait pas de l'endroit où elle se trouvait, mais on pensait qu'elle était juste là, à nous observer, nous protéger et décider de la façon dont on devait vivre et du genre de personnes qu'on devait devenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Mais ici, Son Excellence recouvre tout et opprime tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "Enfin, je ne sais pas vraiment comment expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "On cherche toujours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Au fait, avez-vous trouvé quelque chose à propos de ma maman ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402311,
					"content": "D'accord. Dites-le-moi quand vous avez des nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
