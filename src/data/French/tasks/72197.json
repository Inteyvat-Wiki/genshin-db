			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chouji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "Ces cristaux devraient suffire. Eh bien, je vais commencer mon aventure maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401903,
					"content": "Prends soin de toi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "On reste en contact !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "Je suis quand même inquiète pour ce gamin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401905,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401906,
					"content": "#Hé, Chouji, tu ferais mieux d'arrêter de parler à tort et à travers ! Tu devrais t'estimer chanceux de nous avoir {M#rencontrés}{F#rencontrées}... Sinon, tu te serais fait rosser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401907,
					"content": "Et puis si des méchants veulent te soutirer des informations, ne leur dis pas la vérité ! Invente une histoire, hein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401909,
					"content": "Paimon, tu es devenue une vraie mère poule, dis donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "Et aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401911,
					"content": "J'ai confiance en lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "Un si petit enfant qui part à l'aventure tout seul... Bien sûr que ça m'inquiète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401912,
					"content": "... Bien sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401913,
					"content": "Hahahaha ! Merci à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401914,
					"content": "J'espère qu'on se reverra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401915,
					"content": "Promets-moi de rester en sécurité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401916,
					"content": "Tout ira bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401917,
					"content": "Ensuite, j'irai à Tatarasuna, où ma maman travaillait. Peut-être que quelqu'un pourra me dire si elle y est passée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401918,
					"content": "Et puis... J'essayerai d'aller sur l'Île de Narukami et de me rendre à Snezhnaya en bateau marchand... Après ça, j'improvise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401920,
					"content": "Est-ce que tu sais vraiment de quoi tu parles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "Tu comprends vraiment les risques qui t'attendent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401922,
					"content": "Si les gens décidaient de ne pas partir à l'aventure parce qu'ils ne connaissent pas tous les risques... Il n'y aurait pas d'aventuriers dans ce monde, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401924,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "Sois prudent alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "Oh, ce gamin m'énerve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401926,
					"content": "Hahaha, ne vous inquiétez pas pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401927,
					"content": "#Faites un bon voyage ! Au fait, {NICKNAME}, j'espère que vous retrouverez bientôt votre famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401928,
					"content": "Ouais ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
