						721402003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402005,
					"content": "C'est ce que tu vas dire, hein !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "« J'en ai besoin d'urgence, ouin ouin... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402007,
					"content": "Comment se passe ton voyage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Hahaha, bien sûr que non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402008,
					"content": "Ça va... Mais je n'ai toujours pas retrouvé la trace de ma maman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402009
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402010,
					"content": "On va faire de notre mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#Pas de souci ! On va t'aider. Hein, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
