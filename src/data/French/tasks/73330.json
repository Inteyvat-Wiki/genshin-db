						],
						"stepId": 7333007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Hé, vous, humains aux intentions douteuses ! Je vous suggère de quitter cet endroit immédiatement ! Les secrets et l'héritage des paris ne sont pas à votre portée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "#Les paris ? Alors, tu es une pari ! Oh, c'est incroyable{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#Oh ! Et il y a {M#ce jeune homme robuste}{F#cette petite demoiselle} et son... animal de compagnie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "Hé, c'est quoi, ce manque de politesse ? Je suis sa meilleure amie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "Une amie... Ah, oui, bien sûr ! Une meilleure amie, en voilà un joli titre ! J'ai toujours voulu avoir un meilleur ami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#{M#Jeune homme robuste}{F#Petite demoiselle}, je me doute que vous n'avez pas besoin de deux meilleurs amis, ai-je raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "Que voulez-vous dire ? ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Ce que je veux dire, c'est que... Ce serait un peu injuste d'avoir deux meilleurs amis, même si c'était vous, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Je ne peux tolérer ce type d'injustice... Alors s'il vous plaît, donnez-moi la pari. Et si vous vous inquiétez pour elle... N'ayez crainte. Je m'assurerai de m'en servir à son plein potentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Insolent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Non, c'est n'importe quoi... On ne peut pas discuter avec lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "On peut sûrement lui faire entendre raison avec autre chose que des paroles... Avec votre sagesse, vous voyez certainement ce que je veux dire, mon yasnapati, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Je pense que Sorush veut dire qu'il faudrait lui en faire voir de toutes les couleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Hmph, épargne-nous tes commentaires, Blanche flottante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "Ça ne me dérangerait pas d'avoir plus de compagnons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "Comment ça ?! Non ! Il n'y a que moi qui suis ta meilleure amie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}