			},
			"dialogs": [
				{
					"id": 766670301,
					"content": "Je vais aller en cueillir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "Vous... Vous voulez m'aider ?! Merci beaucoup ! Du fond du cœur ! Dans ce cas, veuillez m'apporter <color=#00E1FFFF>cinq lakkabaies</color>. Ça devrait être assez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Une fois que vous reviendrez avec, je vous préparerai le plus délicieux festin de la lune que vous ayez jamais eu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
		{
