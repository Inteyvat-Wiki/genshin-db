			"dialogs": [
				{
					"id": 766670401,
					"content": "Ça suffira. Merci beaucoup ! Une minute, je vais préparer le plus délicieux Festin de la lune que vous ayez jamais vu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki se précipite vers la cuisine et commence à préparer le Festin de la lune...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "C'est prêt. Goûtez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Merci encore pour votre aide. Si vous avez faim, n'hésitez pas à venir me voir. Je préparerai un repas rien que pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
