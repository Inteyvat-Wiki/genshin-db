			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "J'aurais dû acheter plus de lakkabaies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(Quand Lauma était ici la dernière fois...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Bonjour, {NICKNAME}. Vous êtes là pour un festin de la lune ? Désolée, mais vous devrez patienter encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "Le Festin de la lune ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "Hein ? Vous n'en avez pas eu un la dernière fois ? Oh, c'est vrai, c'est dame Lauma qui l'a organisé... et j'imagine qu'elle ne vous a pas dit comment le repas s'appelait officiellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "Pour faire simple, le Festin de la lune est un repas gratuit que les Descendants de givrelune distribuent à ceux dans le besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Aider ces personnes fait partie de nos traditions depuis toujours, même si c'est limité à l'Île de Hiisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "Mais sous la direction de dame Lauma et avec la contribution de tout le monde, on a réussi à élargir progressivement notre champ d'action.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Dame Lauma dit que c'était pour répandre la faveur de la Déesse de la lune à tous. On dit... euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "« Le premier fruit de la récolte doit être placé sur l'autel du clair de lune. Non pas comme une offrande aux divinités, mais comme une étincelle... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "« Comme une étincelle pour... » Hmm, qu'est-ce que c'était déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "Ahem ! Bref, notre boutique est l'un des points de distributions principaux de ces repas. Et c'est moi qui gère presque tout toute seule ! Pas mal, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "On a eu des soucis pour distribuer les repas au Village de Nasha, mais comme dame Lauma l'a dit, on pourra vraiment aider plus de gens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "Mais quand j'ai préparé les ingrédients hier, j'ai oublié de bien fermer la boîte. Ce matin, j'ai vu que de nombreux fruits avaient été picorés par des oiseaux. Ils sont complètement inutilisables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "J'ai à peine de quoi faire des festins de la lune avec ce qu'il me reste... *soupir* Qu'est-ce que je vais faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(Il y avait une distribution de repas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
