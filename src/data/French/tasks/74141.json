					"id": 741410804,
					"content": "Ah, c'est vous. Je me souviens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410805,
					"content": "Qu'est-ce qui t'amène ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "Vous m'avez devancé. J'avais aussi l'intention de vous poser cette question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410807,
					"content": "Ce n'est rien, je me disais juste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410808,
					"content": "#Vous êtes {NICKNAME}, n'est-ce pas ? Cette petite chose blanche qui vous accompagne toujours... Comment s'appelle-t-elle déjà ? Pourquoi n'est-elle pas avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410809,
					"content": "Paimon m'attend dehors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "C'était Paimon ? Peu importe, ça n'a pas d'importance. Vous êtes une bonne personne, tout comme Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410812,
					"content": "Je suis venu ici pour trouver quelque chose de très important. Savez-vous ce que je cherche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410813,
					"content": "Bref, pourquoi êtes-vous ici ? Vous devriez partir vite, c'est très dangereux ici. Autrefois, des gens sont venus pour passer une épreuve ici et ont fini par perdre la tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410814,
					"content": "Je me souviens maintenant. Vous et moi, nous avons accompli des choses incroyables ensemble. C'est la seule chose dont je suis fier dans ma vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410815,
					"content": "Tu parles de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "Battre Narzissenkreuz ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "Que s'est-il passé avec le maître ? Êtes-vous aussi membre de l'Ordo Narzissenkreuz ? Ou bien, vous êtes avec Guillotin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410820,
					"content": "Ah, les papillons dorés. Ils brillent comme le soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410821,
					"content": "Tant que nous avons cette lumière, tout ira... Tout ira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410818,
					"content": "Sauver Lanoire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "Je me souviens maintenant. Nous avons fait sortir Lanoire de la prison sous-marine. Les enfants ne devraient pas vivre dans un endroit comme celui-là. Elle mérite de vivre sous le soleil, parmi les fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410811,
					"content": "Tu vas bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
		},
