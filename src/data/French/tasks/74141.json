						741411110
					]
				},
				{
					"id": 741411110,
					"content": "#Oh, vraiment ? Allons chercher quelque chose à manger. J'ai faim à force de m'inquiéter pour toi{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
