			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "Vraiment ? Dans ce cas, c'est plus simple. Comment vous appelez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411002,
					"content": "Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}, je ne m'attendais pas à vous rencontrer ici. Paimon n'est pas avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "Attendez, vous ne seriez pas une sorte de monstre qui a pris l'apparence de quelqu'un que je connais pour me manipuler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "Nous nous sommes vus récemment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "Ça fait longtemps depuis notre dernière rencontre. J'ai du mal à me souvenir de plus en plus de choses, peut-être à cause de mon âge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "#Vous êtes {M#sûr}{F#sûre} que vous n'êtes pas un monstre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "Est-ce que tu te rappelles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "L'histoire du jardin du géant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Je me souviens, oui. C'est vraiment vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Je suis désolé. J'ai vu tellement de choses impensables, dont de nombreux combats que je ne pouvais pas remporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "Mais finalement, les choses ont changé ici. Une lumière dorée s'est levée, les tournesols ont fleuri. Peut-être même que l'univers imaginé par nos ancêtres n'est pas immuable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Peut-être que tout ira mieux et que je pourrai comprendre et laisser aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Viens avec moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "#Haha, je suppose que c'est vraiment vous. Je me souviens de vous. Vous n'avez pas changé. Vous aimez toujours autant vous mêler des affaires des autres, mais c'est parce que vous êtes {M#bienveillant}{F#bienveillante}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "Ne vous inquiétez pas pour moi, je n'ai pas besoin d'aide. Vous avez vu ce dont je suis capable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "En fait, j'en sais même peut-être plus sur ce qui se passe ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "#Brutocollinus, dis à {M#ce jeune homme}{F#cette jeune fille} de partir immédiatement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Tu veux me parler ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "... Tu peux comprendre ce que je dis ? Eh bien, je te demande : qui suis-je pour toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Un chien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Oh, je vois... Il y a encore de l'espoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#Quitte cet endroit, {M#jeune homme}{F#jeune fille}. C'est pour ton bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Je suis d'accord. {NICKNAME}. Vous appartenez à un monde plus lumineux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "J'ai encore des questions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "Tu ne dois pas en avoir. Au revoir et ne reviens plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "L'histoire de l'apprenti et du petit poisson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
