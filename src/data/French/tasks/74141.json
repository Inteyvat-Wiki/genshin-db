			},
			"dialogs": [
				{
					"id": 741410101,
					"content": "(Ces pages sont remplies de symboles, lettres, langues anciennes et figures géométriques incompréhensibles, mais vous arrivez progressivement à en saisir le sens après un certain temps de concentration.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 741410102,
					"content": "#Canotila n'a pas l'air d'être là. Elle est peut-être encore partie dans cet endroit mystérieux ! Tu veux «{NON_BREAK_SPACE}méditer » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Après avoir entendu ce qu'elle a dit la dernière fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "#Je suis un peu {M#curieux}{F#curieuse}. Je vais y jeter un coup d'œil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Hmm... Ça m'inquiète un peu, mais nous devrions y aller ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon, tu peux m'attendre dehors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "Le monde du livre des révélations...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "Ça pourrait être plus dangereux que ce que l'on imagine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "C'est pourquoi je ne veux pas que tu prennes de risques.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "Mais... mais nous avons toujours été ensemble dans nos aventures, n'est-ce pas ? Tant que nous sommes ensemble, il n'y a aucun obstacle que nous ne puissions surmonter, aucun ennemi que nous ne puissions vaincre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "Les dangers à l'intérieur pourraient ne pas être résolus par la force.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "#D'accord ! Hmph, tu es plus {M#intelligent}{F#intelligente} que moi, je te fais confiance. Ne m'abandonne pas ! J'attendrai ton retour ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Peut-être qu'il y a quelque chose qu'on ne sait pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
