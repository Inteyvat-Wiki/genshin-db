			},
			"dialogs": [
				{
					"id": 721520101,
					"content": "« ... C'était l'endroit où le grand pirate Rinzou entreposait son trésor. Les gars ont sorti les derniers coffres... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Notes des Pilleurs de trésors"
				},
				{
					"id": 721520102,
					"content": "« ... Rinzou était un homme rusé dans la vie, cependant, il a laissé toutes sortes de symboles spéciaux sur l'île... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Notes des Pilleurs de trésors"
				},
				{
					"id": 721520103,
					"content": "« ... C'est peut-être un piège ou alors il y a vraiment un trésor. On ne le saura que si on y va et qu'on le découvre par nous-mêmes... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Notes des Pilleurs de trésors"
				},
				{
					"id": 721520104,
					"content": "« ... On a trouvé certains de ces symboles. Eh bien, le temps n'attend pas. Mieux vaut aller déterrer le trésor de Rinzou ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Notes des Pilleurs de trésors"
				},
				{
					"id": 721520105,
					"content": "Waouh, c'est... vraiment long... Je ne vais pas m'ennuyer à lire ce qui ne parle pas du trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Attends... Trésor !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "#Allez, {M#voyageur}{F#voyageuse}, il y a un trésor à la clé ! On ne peut pas laisser les Pilleurs de trésors nous devancer quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
