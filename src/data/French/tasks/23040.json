			"dialogs": [
				{
					"id": 230401002,
					"content": "#*halète* Merci beaucoup, {M#voyageur}{F#voyageuse}. Si vous n'étiez pas {M#intervenu}{F#intervenue}, ces marchandises n'auraient certainement pas pu être sauvées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401003,
					"content": "Vous êtes très doué.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "Héhé, merci pour le compliment. Mais il m'est encore un peu difficile de faire face à tant de Pilleurs de trésors tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401007,
					"content": "*soupir* Je ne suis pas très doué pour le combat. Si mademoiselle Candace était là, ces Pilleurs de trésors seraient tous en train de ramper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401008,
					"content": "Désolé, je divague. Bon, il faut que j'aille rapporter ces marchandises au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401009,
					"content": "#{M#Voyageur}{F#Voyageuse}, cet endroit n'est pas très sûr. Vous feriez mieux de retourner au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401010,
					"content": "Comment se fait-il que ce groupe de Pilleurs de trésors ait été si bien informé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401005,
					"content": "Vous êtes venu tout seul ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "J'étais avec d'autres gardes, mais on s'est séparés pour chercher les marchandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				}
