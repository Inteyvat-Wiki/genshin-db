			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "*soupir* Quand monsieur Habachi va-t-il pouvoir se reposer un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous tombez bien, rendez-nous un service s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "On vient de recevoir une livraison d'aliments séchés de l'extérieur, et monsieur Habachi était sur le point de transférer tout ça dans l'entrepôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "Mais un groupe de Vautours rouges, sentant l'odeur de la nourriture, s'est soudainement mis à l'attaquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Les autres gardes ont accouru pour chasser les Vautours rouges, mais les aliments séchés ont quand même été picorés par ces derniers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "#Les gardes sont déjà partis pour prévenir les autres équipes de livraison, et monsieur Habachi est occupé à récupérer les aliments qui sont encore en bon état... {M#Voyageur}{F#Voyageuse}, pouvez-vous nous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Merci beaucoup. Désolée, je dois réceptionner un nouveau lot de marchandises, alors je ne peux pas y aller moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "Est-ce que Habachi va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "*soupir* Je lui ai proposé de se reposer un moment, mais il a refusé. Il a dit qu'il irait inspecter une nouvelle fois l'entrepôt après avoir récupéré la nourriture. Si ça continue, je crains que son corps ne puisse plus tenir le coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "#Les marchandises devraient se trouver à proximité de l'élévateur blanc... {M#Voyageur}{F#Voyageuse}, aidez-nous à les récupérer, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
