			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "*soupir* ... Ces Vautours rouges, ça n'en finira donc jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Un problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#Vous êtes... {M#le voyageur}{F#la voyageuse}, n'est-ce pas ? J'ai entendu Ebeid parler de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "#Héhé, je ne m'attendais vraiment pas à ce que {M#le voyageur}{F#la voyageuse} vienne visiter notre village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Oh, vous avez rencontré Habachi ? Il a toujours été très sévère... Pardonnez-le s'il est un peu agressif quand il vous parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Il faut savoir qu'une grande partie des provisions de notre village est stockée dans cet entrepôt. Il y a non seulement de la nourriture, mais aussi des vêtements, des armes et même des trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Dans notre village, les jeunes sont peu nombreux, et en plus de protéger le village, ils aident aussi les villageois à résoudre divers problèmes... Il n'y a que Habachi pour garder l'entrepôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Moi, je ne suis pas d'une grande aide, sauf pour la comptabilité et l'inventaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "Vous avez parlé de Vautours rouges ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "*soupir* Ne m'en parlez pas. Il y a quelque temps, on a reçu une livraison de viande séchée à l'entrepôt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "On ne sait pas par où l'odeur s'échappe, mais de temps en temps, quelques Vautours rouges passent au-dessus de l'entrepôt et se posent sur la montagne d'à côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Ils ne peuvent bien sûr pas rentrer dans l'entrepôt pour prendre la viande séchée, mais si quelqu'un mangeait devant eux, ils se mettraient à piquer soudainement et à attaquer cette personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Les gardiens du village n'ont pas le temps de les éliminer, et monsieur Habachi n'est pas disponible non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous avez le temps, pouvez-vous nous aider à nous débarrasser de ces Vautours rouges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Alors on compte sur vous. Ces Vautours rouges sont très féroces, et il vaut mieux ne pas trop s'en approcher... Si vous savez manier l'arc, vous devriez pouvoir les éliminer en toute sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Qu'ont-ils attaqué jusqu'à présent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Les marchandises qui passent, la viande qui sèche à l'extérieur et la gamelle de monsieur Habachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Lorsque monsieur Habachi prend son déjeuner à son poste de garde, il a l'habitude de poser sa gamelle à côté de lui, et les Vautours rouges en profitent toujours pour lui voler toute sa viande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "Comme il doit monter la garde, il ne peut pas chasser les Vautours rouges. Il n'a pas d'autre choix que de les regarder s'envoler et de manger rapidement ce qui lui reste de nourriture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "#S'il vous plaît, {M#voyageur}{F#voyageuse}, allez vite éliminer ces Vautours rouges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
		{
			"id": 2304003,
