				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous tombez bien ! Allez vite aider monsieur Habachi, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400802,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "*soupir* Une de nos livraisons a été interceptée par les Pilleurs de trésors, et tous les gardes qui étaient disponibles sont déjà partis la récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400805,
					"content": "Mais monsieur Habachi a dit qu'il manquait d'hommes, alors il a pris son arme et est sorti du village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400806,
					"content": "J'ai entendu dire que les Pilleurs de trésors étaient trop nombreux cette fois-ci. Monsieur Habachi n'arrivera pas à les vaincre seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400807,
					"content": "#{M#Voyageur}{F#Voyageuse}, je vais marquer sur votre carte l'endroit vers lequel il s'est dirigé. S'il vous plaît, allez l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400808,
					"content": "J'y vais immédiatement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. J'espère que rien n'arrivera à monsieur Habachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400810,
					"content": "Il sait bien se battre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "S'occuper d'un ou deux Pilleurs de trésors ne devrait pas être un problème pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "Mais de ce que j'ai entendu dire, cette fois-ci, c'est tout un groupe de Pilleurs de trésors qui a tendu une embuscade à l'équipe de livraison. Si l'un des hommes n'était pas revenu rapidement au village pour nous prévenir, personne n'aurait su que l'équipe se faisait attaquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400813,
					"content": "*soupir* Si mademoiselle Candace n'était pas partie, les Pilleurs de trésors n'auraient jamais osé faire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400814,
					"content": "Ils ont dû profiter de ça pour attaquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400815,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, allez aider monsieur Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400803,
					"content": "Pourquoi êtes-vous aussi nerveuse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
