			"dialogs": [
				{
					"id": 708240201,
					"content": "Laissez-moi vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Vous savez vous débrouiller avec un balai ? Oh, et puis tant pis. Nous sommes en sous-effectif de toute façon, alors toute aide est la bienvenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Suivez-moi à l'intérieur. Il y a énormément à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
