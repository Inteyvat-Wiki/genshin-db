					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240402,
					"content": "Il n'y a pas une seule poussière qui traîne !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "Votre aide m'a été précieuse. Je n'imagine pas le temps que cela m'aurait pris toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "Puis Moco et Hillie auraient tout cassé là-dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "#Je vous remercie beaucoup. Veuillez accepter ceci pour la peine que vous vous êtes donnée. {M#Un invité}{F#Une invitée} n'aurait pas dû s'embêter avec ce travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "Le Domaine de l'Aurore sera impeccable lors de votre prochaine visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
