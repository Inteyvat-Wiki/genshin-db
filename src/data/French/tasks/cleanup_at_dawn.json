			"dialogs": [
				{
					"id": 708240101,
					"content": "Faites attention quand vous faites le ménage ! La propreté est la première chose que remarquent nos visiteurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Pardon, dame Adelinde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "On s'appliquera cette fois, promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "#Bonjour, cher {M#voyageur}{F#voyageuse} et bienvenue au Domaine de l'Aurore. La tempête est passée, mais nous avons encore du pain sur la planche pour tout remettre dans l'ordre ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "J'étais en train d'organiser le ménage que nous avons à faire, mais Moco et Hillie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Pardon, dame Adelinde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "On s'appliquera cette fois, promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Ce n'est pas la peine de vous répéter ! Utilisez votre énergie pour faire le ménage au lieu de gaspiller votre salive, et que ça saute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Ces deux-là sont vraiment négligentes. À ce rythme-là, on n'est pas prêtes d'en avoir terminé. Et il reste l'intérieur à nettoyer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082402,
			"completionStepIds": [
				7082401
