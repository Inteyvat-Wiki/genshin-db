			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#Hé, c'est {NICKNAME} ! Et Paimon aussi ! Quoi de neuf ? Vous avez besoin de mon génie pour une mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Je vous fais une réduction de 20 % sur mes tarifs ! Prix d'ami ! Vous n'aurez qu'à me ramener des friandises... et ne rien dire à Ineffa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "On se promène juste dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Vous êtes au bon endroit ! Mon atelier est rempli d'objets brillants. Vous ne retrouverez le même nulle part ailleurs, je vous le dis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Faites juste attention où vous mettez les pieds pour éviter de trébucher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Ce robot a l'air assez... unique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Héhé ! À ton avis ? C'est « Canard à torgnoles ». Il a été conçu pour trier les déchets et la ferraille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Mais je l'ai fait trop robuste, et ses bras articulés sont très agiles. Du coup, je me suis dit : « Pourquoi ne pas lui donner des fonctionnalités de défense superpuissantes qui iraient bien avec ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "Comme ça, il transformera tous les méchants qui tentent de se faufiler dans mon atelier en déchets non recyclables !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Tu as toujours des idées aussi folles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Eh bien, puisque l'occasion se présente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "Moi ? Et Canard à torgnoles ? Hum, les gens s'intéressent généralement à mes inventions. On ne me prend pas souvent en photo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Mais si tu veux immortaliser le quotidien d'une mécanicienne de génie et de son robot de combat invincible avec ton Daguerréotype... Tu peux carrément !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "C'est juste que... Je n'ai pas l'habitude de prendre des photos, alors je ne sais pas trop comment faire pour avoir l'air classe et tout... Je ne suis pas sûre que les photos seront réussies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Sois toi-même.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "Super ! Je te laisse faire, alors ! Assure-toi que Canard à torgnoles soit classe aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "J'appuierai sur le déclencheur quand tu seras sous ton meilleur jour !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Pourrait-on prendre une photo de toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "Il est à toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "Ah oui, on cherche de l'inspiration pour des photos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
