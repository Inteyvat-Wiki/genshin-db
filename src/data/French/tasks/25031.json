				]
			},
			"dialogs": [
				{
					"id": 250310501,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani est saine et sauve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "#Ouf... Je me faisais vraiment un sang d'encre. Si vous n'étiez pas {M#revenu}{F#revenue}, je serais allée les chercher moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310505,
					"content": "Cette idiote aurait pu choisir un sujet plus simple... Elle aurait réussi à avoir une assez bonne note pour être diplômée.",
