				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "Merci, merci pour votre aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Si j'avais pu me débarrasser du sac plus tôt, j'aurais pu m'occuper d'eux toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Surtout pas ! Sinon notre voyage à Natlan n'aurait servi à rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Attendez... Alrani, c'est vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Hein ? {NICKNAME} ? C'est vraiment vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "À côté de vous, ne me dites pas que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Narzam, Pilleuse de trésors. Ce n'est pas notre première rencontre. Vous avez oublié ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "Pfiou... Vous êtes vraiment mon ange gardien ! Combien de fois m'avez-vous secourue déjà ? Une, deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "J'espère que vous ne comptez pas la fois où vous étiez avec moi. Ça s'est produit parce que vous avez insisté pour rester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "Bien sûr que cette fois ne compte pas. Et comment ça, j'ai insisté ? Je vous avais déjà payée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "C'était juste assez pour quelques encas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Ne me dites pas que vous êtes encore là pour votre thèse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Héhé... Étant donné tout le temps que j'y ai consacré, je ne pouvais pas abandonner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "J'ai déposé un dossier de candidature pour un financement spécial par l'Académie, puis j'ai même réussi à trouver un sujet de recherche qui a fait l'unanimité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "De plus, Narzam m'accompagne comme garde du corps. Elle s'est débarrassée de tous les bandits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Ils nous laissent tranquilles quand ils s'aperçoivent qu'ils n'ont rien à nous voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "À la fin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "... Depuis que nous avons quitté les Enfants des échos, elle n'a pas arrêté de serrer ce sac avec ses documents dans ses bras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "Honnêtement, elle ressemble à une idiote qui ne peut pas se séparer d'un trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "Qui ne tenterait pas le coup en voyant une personne qui transporte un trésor dans une zone déserte de la nature avec qu'une seule garde pour la protéger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Vous avez raison sur un point... Mon sac est en effet un trésor ! Il contient non seulement toutes les transcriptions de mes entretiens sur le terrain, mais aussi des copies de divers documents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Grâce à ces ressources, je n'aurai aucun mal à rédiger ma thèse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "J'ai choisi le Pèlerinage de retour du sanctifeu comme sujet. Comme c'est un sujet d'une grande importance, je réussirai à obtenir mon diplôme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Bien sûr, je n'y serais pas arrivée sans Tahmures. C'est elle qui a eu l'idée en premier ! C'est vraiment une amie en or, héhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Merci encore une fois, {NICKNAME}. Sans vous, ces bandits auraient détruit mes livres et volé mon argent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Il y a quelque temps, j'avais réussi à me faire un peu d'argent en faisant du classement de livres et d'informations. Si on me l'avait volé, je n'aurais pas pu acheter de nouvelles ressources.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "C'est vrai, mais vous auriez quand même fini par dépenser tout cet argent en livres. Si je n'avais pas confisqué votre portefeuille, nous serions en train de mourir de faim à coup sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "Mais je n'achète pas autant de livres... Si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "Bref, assez bavardé. Nous devons encore nous rendre au Peuple des sources pour trouver de l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "Au revoir ! Ma thèse sera terminée lors de notre prochaine rencontre, je vous le promets ! Je vous offrirai un délicieux repas pour fêter ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "... Vous vous êtes quand même mise dans le pétrin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
