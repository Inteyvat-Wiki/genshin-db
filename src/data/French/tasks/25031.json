					}
				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "Quel pétrin... Comment vais-je faire pour m'en sortir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310102,
					"content": "Quelque chose ne va pas avec l'entraînement d'Alem ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME} ! Que les Archons soient loués, vous êtes là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310104,
					"content": "Je n'ai pas le temps de vous expliquer. Aidez-moi à la sauver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310105,
					"content": "C'est votre amie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "Je suppose qu'on peut dire ça. On a toutes les deux pété les plombs pendant nos thèses et pleuré ensemble à la bibliothèque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310108,
					"content": "Aaahhh, ce n'est pas le moment de raconter tout ça ! Elle ne voulait pas m'écouter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310109,
					"content": "Elle a dit qu'elle ferait n'importe quoi pour sa thèse et est partie avec sa garde du corps dans la nature !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310110,
					"content": "Ils ne sont toujours pas revenus ! La tribu ne peut pas se permettre d'envoyer quelqu'un les chercher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310111,
					"content": "#Je vous en prie, {NICKNAME}. Vous devez la sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310112,
					"content": "Je m'en occupe, ne vous en faites pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#Bref, aidez-moi s'il vous plaît ! Je compte sur vous, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310113,
					"content": "Vraiment, les gens de l'Académie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Celle-là, je vous jure... *soupir* Sa malchance est vraiment inouïe. Quand nous sommes arrivées à Natlan, elle a dit vouloir faire un dernier effort pour sa thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310106,
					"content": "C'est une de vos connaissances ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
