			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Désolée de t'avoir fait venir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050102,
					"content": "Aucun problème, on s'est bien occupé de moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Tant mieux, je suis soulagée. En gros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050106,
					"content": "Nous sommes vraiment reconnaissants de toutes les quêtes que tu as accomplies jusque-là. La réputation de la Guilde s'est améliorée grâce à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050107,
					"content": "En revanche, le nombre de missions est en train d'exploser et nous n'avons pas assez de membres pour répondre à la demande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050108,
					"content": "Tu veux qu'on aille recruter de nouveaux membres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "Euh, pas vraiment. Je doute que ça puisse résoudre notre problème dans l'immédiat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050110,
					"content": "Même si ça serait fantastique de voir de nouvelles têtes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050111,
					"content": "Je voulais te demander si tu avais des amis qui pourraient nous filer un coup de main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050112,
					"content": "Je peux leur en parler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Super ! Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050117,
					"content": "Nous manquons vraiment d'effectifs pour les <color=#00E1FFFF>expéditions</color> en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050118,
					"content": "Des expéditions ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Oui. Nous organisons souvent des expéditions pour explorer les environs de Mondstadt et la nature avoisinnante. Ça nous permet d'être au courant des dangers potentiels, des activités suspectes, etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050120,
					"content": "Comme ces expéditions sont commanditées par la Guilde, il n'y a pas de date limite pour les terminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050121,
					"content": "Ça ne veut pas dire qu'il faut les négliger non plus. Il vaut mieux prévenir que guérir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050122,
					"content": "On dirait que c'est sérieux comme affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "Mes amis comprendront certainement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Tu n'auras qu'à les convaincre de nous aider. Je m'occupe du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050127,
					"content": "Sans plus attendre, je vais te montrer les expéditions en cours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050128,
					"content": "Lancer une expédition",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "Et leur rémunération ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Ne t'en fais pas, nous ne prélevons pas de commission sur les explorations. Tout ce que vous trouverez vous appartiendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050114,
					"content": "Tu veux que tous mes amis rejoignent la Guilde ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "Non, pas du tout ! Ce n'est pas ce que je voulais dire. On ne peut pas se permettre de faire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050116,
					"content": "Disons que la Guilde aimerait qu'ils lui fassent une grande faveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050104,
					"content": "Il y a une nouvelle récompense ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "Bingo ! J'en déduis que ça t'intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Catherine"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Tu peux lancer une expédition quand tu veux. Les personnages envoyés sont toujours disponibles pour rejoindre tes aventures pendant cette période.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050202,
					"content": "Le temps requis dépend de l'expédition choisie. Une fois l'expédition terminée, reviens ici pour en confirmer les résultats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050203,
					"content": "Tu pourras débloquer des expéditions plus dangereuses au fur et à mesure que ton Niv. d'aventure augmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050204,
					"content": "Un grand pouvoir implique de grandes responsabilités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "Le niveau de risque doit correspondre au niveau d'expérience pour la sécurité de tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 205050206,
					"content": "Merci pour ton aide. J'espère que tes amis et toi pourront nous aider autant que possible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				}
			]
		}
	]
}