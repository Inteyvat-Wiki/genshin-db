			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Comment je vais faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Hein, qui va là ? Tous les individus cherchant à traverser le pont doivent répondre à un interrogatoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "#Enfin, vu tes vêtements, je doute que tu sois {M#suspect}{F#suspecte} de quoi que ce soit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Les sales types font tout pour ne pas se faire remarquer, tu vois la logique ? Donc quelqu'un qui s'habille comme toi n'a rien à cacher. CQFD.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "Qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Je suis le Millelithe en charge de cette zone. Tu te trouves sur une des voies principales du Marais Dihua, pour les marchands comme pour les autres. J'ai été affecté à la protection du coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Il y a quelques jours, j'ai découvert un groupe de monstres... Je crois qu'ils ont établi leur camp par ici. Ils n'ont rien fait pour l'instant, mais mieux vaut être prudent. Je garde un œil sur eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "J'aimerais m'en débarrasser une bonne fois pour toutes, mais je ne peux pas me permettre de quitter le coin, si jamais quelqu'un se fait attaquer par d'autres monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "#Je me suis {M#débarrassé}{F#débarrassée} des monstres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "C'est déjà fait ? C'est... c'est parfait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Merci à toi ! Et encore désolé, c'est moi qui devrais m'en charger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "Je ne sais pas ce que fait la hiérarchie ; aucun renfort n'a été envoyé, et je dois me débrouiller seul. Je fais de mon mieux, mais ça ne suffit pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "Il faudra vraiment que je fasse un rapport sur la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Merci beaucoup. Tiens, pour te remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
