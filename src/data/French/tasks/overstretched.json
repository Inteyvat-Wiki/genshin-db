					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "J'aimerais m'en débarrasser une bonne fois pour toutes, mais je ne peux pas me permettre de quitter le coin, si jamais quelqu'un se fait attaquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Tu pourrais t'en charger pour moi ? Ça me permettrait de me laisser les mains libres pour résoudre d'autres problèmes plus urgents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
