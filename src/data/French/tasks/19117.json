			"dialogs": [
				{
					"id": 191170106,
					"content": "Ouaf ! Ouaf ! *grogne* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170107,
					"content": "Tu es un petit chenapan, toi ? Tu as failli me mordre à nouveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170108,
					"content": "Regarde-toi, tu maigris à vue d'œil... Tu dois avoir envie de manger quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170109,
					"content": "Tu n'as pas à venir avec nous mais allez, tu dois manger, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170110,
					"content": "N'aie pas peur que ce soit empoisonné, d'accord ? Regarde, je vais prendre la première bouchée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170121,
					"content": "Tu vois ? C'est délicieux et sans poison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170111,
					"content": "Thomas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Allez, juste une bouchée. Une petite bouchée et je te laisse tranquille, ça te va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170114,
					"content": "Ouaf ! Ouaf, ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170115,
					"content": "On dirait qu'il n'a aucune intention de manger la nourriture qu'on lui a apportée... C'est moi ou il a l'air d'être sur la défensive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170116,
					"content": "Il y a quelque chose dans la mer ? Ou quelque chose à proximité qui le met en alerte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170117,
					"content": "Ces monstres, peut-être ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "Vous pensez qu'il a été attaqué par des monstres ? Hum, c'est possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170119,
					"content": "Les gens ont tendance à perdre l'appétit quand ils sont confrontés à des situations dangereuses. C'est peut-être la même chose pour les chiens. Nettoyons la zone pour notre compagnon canin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170120,
					"content": "#Merci pour votre aide. Cet endroit devrait être un peu plus tranquille maintenant, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thomas"
				},
				{
					"id": 191170112,
					"content": "Vous faites vraiment beaucoup d'efforts...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
