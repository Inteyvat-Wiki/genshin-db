			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Ah, mais c'est {NICKNAME} et Paimon que je vois ? Quelle coïncidence de vous croiser ici. C'est le destin, j'en suis sûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori ? Qu'est-ce que tu fais ici toute seule ? Tu prévois d'ouvrir un magasin ? ... Hmm, mais tu ne transportes pas de marchandises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Désolée, mais Dori la célèbre commerçante est en congé aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Disons que je fais comme les habitants de Nod-Krai : je profite d'une journée ordinaire dans ce paradis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Sérieusement ? Tu ne travailles pas ? C'est aussi rare que de la pluie dans le désert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Haha ! Même si je suis en congé, mes employés assidus et travailleurs continuent de gagner des moras pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Du coup, pas de quoi s'en faire. Enfin, du moment que mes revenus continuent d'augmenter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Est-ce que vous avez un problème ? Je suis en vacances, mais je ne vais pas refuser des affaires qui se présentent à ma porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "On se promène juste dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "#Ah, vous prenez des photos des paysages uniques de Nod-Krai ? Dans ce cas, vous êtes {M#tombés}{F#tombées} sur la bonne personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Je connais cet endroit comme ma poche. Moins bien que les locaux, mais si vous avez besoin de recommandations... Je peux vous en donner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "#Comme on est {M#amis}{F#amies}, je serai votre guide et vous bénéficierez d'un tarif préférentiel... 500 000 moras la journée. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Tu ne changeras jamais, Dori. Toujours en train de vouloir mettre la main sur nos moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "#Oh non, je le fais pour que mes {M#précieux clients}{F#précieuses clientes} passent un moment merveilleux et inoubliable à Nod-Krai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Si tu veux tant nous aider...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Hmm ? Intéressant, mais... ces photos ne doivent pas être utilisées à des fins publicitaires. Mon droit à l'image est inestimable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Ne t'inquiète pas, on voulait juste prendre une amie en photo pour les souvenirs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Allez, d'accord ! Je ferai une exception pour toi, {NICKNAME}. Par contre, je ne demande qu'une chose : fais en sorte que je sois magnifique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Laisse-moi réfléchir... « Dori le seigneur Sangemah Bay et ses vacances dans une destination paradisiaque » serait pas mal comme légende, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "On peut prendre une photo de toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "Ah oui, on cherche de l'inspiration pour des photos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
