	"talks": [
		{
			"id": 1302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302304",
							"2"
						],
						"stepId": 1302304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh",
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "Siraj ? Non, ça ne me dit rien. Il était dans ta classe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230102,
					"content": "C'est quelqu'un de discret, je ne m'attendais pas à ce que tu te souviennes de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230103,
					"content": "J'ai toujours eu du mal avec la pression que l'Académie met aux étudiants en les qualifiant de génies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230104,
					"content": "Mais je refuse de laisser l'Académie entre tes mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230105,
					"content": "Enfin, je devrais plutôt dire que je suis ravi que tu aies conscience de tes limites. Si les membres de l'Académie sont sains d'esprit, ils verront pertinemment que je suis plus qualifié que toi pour devenir un sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230106,
					"content": "Et que verraient-ils ? Que ta carrière est aussi bancale que ce tableau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230107,
					"content": "C'est culotté comme propos de la part de quelqu'un qui s'apprête à démissionner. Dans quelques jours, tu retourneras classer tes archives. Retour à la case départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230108,
					"content": "Mon salaire sera toujours le même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230109,
					"content": "Quoi ?! Pourquoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230110,
					"content": "Au moins, je ne suis pas un architecte qui se surmène pour décrocher ne serait-ce qu'un sourire de la part de son client...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230111,
					"content": "Tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230126,
					"content": "J'ai pris la peine de faire le ménage dans le salon aujourd'hui, malgré mon emploi du temps chargé. Et c'est comme ça que tu me remercies ?! J'ai encore des plans à terminer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230112,
					"content": "N'oublie pas de me rembourser le loyer que tu me dois. J'achèterai des meubles avec cet argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230113,
					"content": "Tu veux me faire mourir d'une crise cardiaque ou quoi ? Les objets de décoration que tu achètes sont tellement laids... Quel est l'intérêt d'avoir une vieille statue en bois chez soi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230114,
					"content": "Je suis au moins libre d'acheter ce que je veux, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230115,
					"content": "Soit, tu es à l'aise financièrement. Mais à part cela, y a-t-il quelque chose dont tu peux être réellement fier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230116,
					"content": "J'ai le choix, c'est assez difficile de n'en choisir qu'une seule. Et toi alors ? As-tu ne serait-ce qu'une qualité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230117,
					"content": "Mon sens de l'esthétique ! Tu n'y connais rien à la décoration intérieure, alors ne pars pas acheter n'importe quoi sans mon accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230118,
					"content": "Tu dis ça pour que je te paie un verre si tu m'accompagnes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230119,
					"content": "Bah oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230120,
					"content": "Et pourquoi ? Tu me devras encore de l'argent. Autant payer ton verre toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230121,
					"content": "Ça te tuerait d'être sympa pour une fois et de me l'offrir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230122,
					"content": "Prétendre que tu n'as pas de dettes ne les fera pas disparaître et cela ne change pas le fait que tu vis chez quelqu'un d'autre. Ce sont des choses qui se sauront tôt ou tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230123,
					"content": "#D'ailleurs, tes {M#amis}{F#amies} ne diront rien à ce propos, hein ? Dis-leur de garder le secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230124,
					"content": "Cela ne sert à rien de le cacher, tout le monde le sait déjà. Tu ne tiens tellement pas l'alcool que quelques gorgées à la taverne suffisent pour que tu déballes tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230125,
					"content": "Quoi ? Non, ce n'est pas vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		}
	]
}