				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708101601,
					"content": "(Donner le marque-page de Flora)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101602
					]
				},
				{
					"id": 708101602,
					"content": "Oh, un marque-page ? Pourquoi pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101603
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101603,
					"content": "Je savais que tu ne me décevrais pas. Que veux-tu savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101604
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101604,
					"content": "Tu vas bientôt rentrer chez toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101605
					]
				},
				{
					"id": 708101605,
					"content": "Moi ? Si ça ne tenait qu'à moi, je serais déjà parti. Je m'ennuie ici, car personne ne m'a donné de mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101606
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101606,
					"content": "Je ne peux que rester assis là toute la journée, à subir les regards noirs des religieuses. À croire que j'ai fait quelque chose pour mériter ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101607
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101607,
					"content": "Mes collègues au Grand Hôtel Goth n'en sont plus sortis depuis un moment et je n'ai aucune nouvelle d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101608
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101608,
					"content": "Bref, si Signora a terminé ses affaires ici, qu'on rentre chez nous le plus vite possible. Nous ne sommes plus les bienvenus ici de toute façon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101609
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101609,
					"content": "Malheureusement, je ne peux rien faire à part rester ici à me tourner les pouces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
