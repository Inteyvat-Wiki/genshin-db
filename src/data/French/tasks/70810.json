				{
					"id": 708100902,
					"content": "Un produit local à me conseiller ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100903
					]
				},
				{
					"id": 708100903,
					"content": "#Tu es {M#venu}{F#venue} acheter de l'alcool ? Pourtant, tu n'es pas en âge de boire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100904
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100904,
					"content": "Je voudrais en offrir à quelqu'un...",
