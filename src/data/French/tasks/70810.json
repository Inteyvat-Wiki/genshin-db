					"nextDialogs": [
						708101507
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101507,
					"content": "J'ai été envoyé à Mondstadt pour être à son service, mais jusque-là elle ne m'a pas du tout sollicité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101508
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101508,
					"content": "On raconte que Signora est venue faire un tour à Mondstadt, puis qu'elle avait l'air de bonne humeur lorsqu'elle est repartie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101509
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101509,
					"content": "*soupir* Je ne sais pas si elle a terminé ce qu'elle avait à faire ici, mais... Si c'est le cas, pourrai-je enfin rentrer chez moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101510
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101510,
					"content": "Je n'en peux plus de subir les regards méprisants des religieuses et des chevaliers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
