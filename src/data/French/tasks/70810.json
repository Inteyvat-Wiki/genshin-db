				{
					"id": 708101701,
					"content": "(Donner la boisson spéciale du Cadeau de l'Ange)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101702
					]
				},
				{
					"id": 708101702,
					"content": "Ah, mais c'est qu'elle m'a l'air pas mal cette boisson ! Je vais la goûter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101703
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101703,
					"content": "Il faut la consommer fraîche de préférence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101704
					]
				},
				{
					"id": 708101704,
					"content": "Ah bon ? Je vais attendre mon retour pour boire ça alors. La glace, ce n'est pas ce qui manque à Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101705
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101705,
					"content": "Comme je l'ai dit, les Fatui tiennent toujours leur parole. Nous rendons toujours la pareille lorsqu'on nous aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101706
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101706,
					"content": "Que veux-tu savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101707
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101707,
					"content": "Parle-moi des autres Exécuteurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101708
					]
				},
				{
					"id": 708101708,
					"content": "Comme je suis en bas de l'échelle hiérarchique, je ne connais que des bruits de couloir les concernant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101709
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101709,
					"content": "Je vais te dire ce que je sais, mais prends ça avec un grain de sel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101710
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101710,
					"content": "Scaramuccia occupe le sixième siège des Onze. Paraît-il qu'il n'est pas très apprécié au sein de l'organisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101711
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101711,
					"content": "Pour quelle raison ? Eh bien, apparemment il aurait un caractère difficile, et ne mâcherait pas ses mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101712
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101712,
					"content": "J'ai une connaissance qui travaille pour lui. Apparemment, Scaramuccia n'est guère apprécié par les autres Exécuteurs non plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101713
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708101713,
					"content": "On parle quand même d'un Exécuteur. Il fait déjà plus de choses pour l'organisation qu'un gars comme moi, en bas de l'échelle hiérarchique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
