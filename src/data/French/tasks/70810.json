						708100905
					]
				},
				{
					"id": 708100905,
					"content": "Pour ensuite lui demander de t'en faire goûter, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100906
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100906,
					"content": "Hors de question que je t'en vende, mais il y a une boisson qui pourrait remplir tes critères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100907
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100907,
					"content": "Par contre, j'attends toujours de me faire livrer une partie des ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100908
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100908,
					"content": "Ce n'est pas normal, j'aurais déjà dû les recevoir. J'espère qu'il n'est rien arrivé au convoi... Tu pourrais y jeter un œil pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100909,
						708100911
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100909,
					"content": "J'y vais de ce pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100910
					]
				},
				{
					"id": 708100910,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100913
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100913,
					"content": "Je ferai de mon mieux pour préparer ta boisson quoi qu'il en soit, ne t'en fais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100911,
					"content": "Et si quelque chose est arrivé au convoi ?",
