			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "Qu'y a-t-il encore ? Si tu as une question, n'y va pas par quatre chemins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708100122,
					"content": "Pourquoi solliciter mon aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "Bonne question, en effet. Eh bien, j'ai le sentiment que les Fatui sont à deux doigts de se faire lyncher à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708100124,
					"content": "Avant, j'attirais seulement les regards noirs des religieuses de la cathédrale... Mais maintenant, ce sont les chevaliers de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708100125,
					"content": "Avec ce genre d'ambiance, penses-tu vraiment que je puisse demander à un Mondstadtois de m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708100126,
					"content": "Je suis vraiment curieux de savoir ce que j'ai fait pour mériter un tel traitement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 708100127,
					"content": "Combien reste-t-il de Fatui à Mondstadt ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "Je ne sais pas vraiment, mais mes collègues ne sortent plus du Grand Hôtel Goth depuis un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 708100129,
					"content": "Aucune idée de ce qu'ils font de leurs journées. Ça n'a rien à voir avec du menu fretin comme moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
			"id": 7081003,
			"completionStepIds": [
				7081002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
