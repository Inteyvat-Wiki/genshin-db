			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "Un produit local à me conseiller ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "Tous nos plats pourraient être qualifiés de produits locaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100203,
					"content": "Mais ils ne peuvent pas être conservés bien longtemps. Les aliments risquent de se dégrader lors du voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100204,
					"content": "Nous pouvons les transformer pour prolonger leur durée de consommation, mais leur goût et leur texture ne seront pas les mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100205,
					"content": "Ce n'est pas grave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "Très bien, si vous insistez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100207,
					"content": "Les ingrédients que nous avons ici commencent à dater. Vous feriez mieux d'aller en chercher des nouveaux pour cuisiner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100208,
					"content": "Dites-moi, d'où vient votre ami ? Que je réfléchisse à un plat qui corresponde à ses goûts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100209,
					"content": "Il vient de Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "Snezhnaya ? C'est loin, dis donc ! Réfléchissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100213,
					"content": "Hum, je ne connais pas trop les goûts des Snezhnayiens, mais il existe un plat infaillible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100214,
					"content": "Préparez-moi une salade copieuse, et je m'occuperai du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100215,
					"content": "Je n'ai pas fait ce genre de transformation depuis longtemps. Il faut que j'aille chercher quelques outils...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100211,
					"content": "C'est un Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "Pardon ? Vous voulez parler de ces... gens de Snezhnaya ? Vous avez le bras long, à ce que je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				}
			]
		},
