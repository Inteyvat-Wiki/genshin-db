			"dialogs": [
				{
					"id": 761820101,
					"content": "C'est ici que tu vivais autrefois ? C'est très joli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820102,
					"content": "C'était encore plus beau avant. J'ai un vrai don pour le jardinage, tu sais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820103,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820104,
					"content": "Qu'est-ce qui te fait rire...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820105,
					"content": "Je m'imaginais juste en train de te voir accroupie à t'occuper des fleurs. C'est une image adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820106,
					"content": "Je peux jeter un œil à l'intérieur dans un moment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820107,
					"content": "Bien sûr. J'ai déjà tout nettoyé et dépoussiéré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820108,
					"content": "Qu'est-ce que tu comptes faire de cet endroit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820109,
					"content": "Hmm... Je pense que je veux quand même le garder. Je pourrai revenir faire le ménage quand j'aurai le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820110,
					"content": "Si tu es occupée, je peux m'en occuper pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820111,
					"content": "Ici, j'ai la même sensation que dans ton ancienne chambre. C'est réconfortant... Comme dans un endroit où on se sent bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820112,
					"content": "Ha... Comme tu veux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
