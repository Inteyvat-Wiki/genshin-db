				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "Hein ? Est-ce que Beidou est déjà partie ? Peut-être qu'elle est retournée au navire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Si vous cherchez la capitaine, elle a été convoquée par dame Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Il semble que le Clash du Crux ait dégénéré plus que de raison cette fois-ci, ce qui a suscité son attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "La capitaine Beidou marmonnait quelque chose à propos de Ningguang qui lui mettait des bâtons dans les roues pendant qu'elle se dirigeait vers le Port de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Haha, il n'est pas rare de voir ces deux-là se chamailler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Mais quand même, la capitaine Beidou était très déçue de ne pas pouvoir assister au sacrement du nouveau champion. Cela faisait longtemps qu'elle attendait ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "#Celui qui a volé l'œil divin était censé être l'adversaire de {M#ce héros}{F#cette héroïne} en finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Il savait qu'il n'avait aucune chance de gagner le match, c'est pourquoi la mauvaise idée de voler la récompense a germé dans son esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "Auquel cas, le Clash du Crux en arrive à une conclusion claire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "Hein ? Alors c'était donc ça !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "#Si tel est le cas, alors les règles stipulent qu'il est disqualifié... et notre {M#héros ici présent est le champion}{F#héroïne ici présente est la championne} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Je pensais bien qu'on gagnerait, mais pas de cette façon-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Ce n'est pas grave. Comme on dit par chez nous : « honneur donné est honneur mérité ». À présent, laissez-moi vous amener votre médaille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "On va pouvoir aller à Inazuma ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Oui, je pense. Bien que la capitaine Beidou ne soit plus présente, je suis sûr qu'elle aura vent de ce qu'il s'est passé. C'est une femme de parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "Mais le voyage vers Inazuma est semé d'embûches. Vous serez en proie à une perpétuelle tempête tout le long du voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "En réalité, la pluie et les vents incessants sont également l'incarnation de la volonté de la Shogun Raiden de fermer son pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Attendez une seconde, vous voulez dire qu'elle peut changer la météo par la seule force de son esprit !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "N'oubliez pas qu'il s'agit de l'un des Sept Archons. Si Morax de Liyue a pu former la Forêt de pierre de Guyun en y projetant sa lance de pierre, alors il n'y a rien d'étonnant à ce que la Shogun Raiden soit capable d'invoquer une tempête éternelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "#Il va sans dire que si vous souhaitez vous rendre à Inazuma, il y a des ajustements à faire sur l'Alcor. Vous serez {M#avertis}{F#averties} quand les préparatifs seront terminés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Pendant ce temps, j'ai l'intention d'entreprendre mon propre voyage et de parcourir les vastes terres de Liyue dans l'espoir de trouver un moyen d'éveiller l'œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Vous y arriverez, j'en suis sûre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Merci. J'espère que nos voyages respectifs porteront leurs fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Un dernier mot d'avertissement. Ce qui vous attend après la tempête pourrait bien s'avérer être la partie la plus difficile de votre voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
