			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Paimon",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020402,
					"content": "Il a disparu... L'œil divin n'est plus là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020403,
					"content": "Hein ! Quelqu'un l'a volé ? Qui oserait faire une telle chose à la vue de tout le monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020404,
					"content": "Nous ne savons pas quand il a été pris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020405,
					"content": "Hein ! Je n'aurais jamais pensé que quelqu'un aurait le cran de me doubler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020406,
					"content": "Ne vous inquiétez pas. Même la main la plus habile ne peut échapper au regard vigilant de la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020407,
					"content": "Hmm... Le coupable a agi récemment. Il n'a pas dû aller loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020408,
					"content": "L'œil divin était la récompense que j'avais offerte, et c'était ma responsabilité de veiller sur lui. Je m'assurerai de le récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020409,
					"content": "Eh bien, si tu insistes. Je te laisse t'en occuper alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020410,
					"content": "Je vais rester ici et essayer de trouver une explication à donner à tous les spectateurs qui sont venus voir le match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020411,
					"content": "#Si vous le permettez, pouvez-vous m'accompagner, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020412,
					"content": "Je ne peux rien faire de mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Hum, mais on est sur une île... Où est-ce qu'il a bien pu aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020415,
					"content": "Venez avec moi. Je peux sentir les vents arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020413,
					"content": "Mon adversaire n'est pas là de toute façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Vous avez réussi à me rattraper... Comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020902,
					"content": "J'avais même préparé un bateau pour être sûr de m'échapper rapidement, et pourtant, vous m'avez rattrapé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020903,
					"content": "Aucun bateau ne peut égaler la vitesse du vent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "Du vent ? De quoi parlez-vous ? Oh, je vois... Votre œil divin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020905,
					"content": "Bon sang ! Si seulement j'avais un œil divin... Ou si j'avais pu activer celui-ci, vous n'auriez jamais pu me rattraper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020906,
					"content": "Cela n'a rien à voir avec un œil divin. Vous êtes peut-être doué pour vous dissimuler de la foule, mais il semble que vous en sachiez bien peu sur la façon d'échapper au regard de la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "D'autre part, le chemin que vous avez choisi d'emprunter pour vous échapper présentait de nombreux désavantages que je n'ai pas le temps de vous expliquer. En plus de cela, je pouvais entendre vos rires et vos fanfaronnades portés par le vent pendant que je vous poursuivais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "En d'autres mots, vous avez échoué sur tous les critères de base d'un vol réussi : à savoir vitesse, discrétion et style.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Vous... Vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020910,
					"content": "Mais le plus décevant de tout est l'état de l'œil divin entre vos mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Il semble qu'un œil divin ne réponde pas à l'ambition d'un humain sans discernement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Très bien, très bien ! Je l'admets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020913,
					"content": "Je suis intéressé par cet œil divin depuis un moment déjà. J'ai décidé de m'inscrire après avoir entendu dire que ce tournoi n'était qu'un ramassis de combattants minables. J'ai réussi à arriver en finale et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020914,
					"content": "Haha, c'était donc vous notre adversaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "#J'avais l'intention de gagner ce tournoi par mes seules facultés de combat, puis vous êtes {M#arrivé}{F#arrivée} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020916,
					"content": "Après avoir assisté à la demi-finale, j'ai compris que je n'avais aucune chance. Mais je ne voulais pas abandonner si près du but.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020917,
					"content": "Puisqu'il ne servait à rien pour moi de vous affronter en combat singulier, j'ai décidé de mettre mes compétences à profit pendant que l'attention de tout le monde était rivée sur Beidou et vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020918,
					"content": "J'étais persuadé d'avoir bien préparé mon évasion... Mais d'une façon ou d'une autre, vous avez quand même réussi à me rattraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020919,
					"content": "Vous n'avez nulle part où vous enfuir à présent, laissez tomber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Argh... Mince... Les choses auraient pu... auraient dû se passer autrement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020923,
					"content": "Si vous continuez à résister, vous devrez en payer les conséquences.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Pfff ! Vos menaces ne m'impressionnent pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020928,
					"content": "Très bien... Mais vous avez intérêt à tenir parole ! Il ne s'est pas activé avec moi de toute façon, ce n'est rien d'autre qu'une enveloppe vide pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020929,
					"content": "Vous savez, d'après les lois de la mer, la punition pour vol est de casser les bras du coupable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Hein ! Vous n'êtes pas sérieux quand même !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020931,
					"content": "Sans compter que l'objet que vous avez volé était une récompense, et que vous ne vous êtes pas présenté pour la finale, et que vous avez fait perdre la face au capitaine de la Flotte du Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Il me semblerait juste de marquer le mot « voleur » au fer rouge sur votre front.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "Ouh là, ouh là, on n'a pas besoin d'aller aussi loin, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Argh, je n'aurais jamais pensé que vous puissiez être aussi cruels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020935,
					"content": "Si c'est là où mène la discussion, alors oubliez ça. J'aime autant me battre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020921,
					"content": "Rendez-nous l'œil divin à présent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Après tout ce que j'ai fait pour l'avoir ? Je ne crois pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020925,
					"content": "Faites ce qu'on vous dit et on vous laissera tranquille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "V... Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020927,
					"content": "Si vous rendez l'œil divin, on vous laisse partir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200211",
							"2"
						],
						"stepId": 200211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "A—Argh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021102,
					"content": "Non, non ! Faites ce que vous voulez, mais s'il vous plaît, ne marquez pas mon front au fer rouge !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021103,
					"content": "Hmm... Il a persévéré jusqu'à la fin, et à présent, la mort est proche... Pourtant, les dieux ne lui accordent toujours pas leur faveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021104,
					"content": "... Posez cet œil divin et partez. J'ai changé d'avis. Vous avez été assez puni comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021105,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021106,
					"content": "Qu'est-ce qu'il y a ? Vous en voulez encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021107,
					"content": "C'est vous qui choisissez. C'est tout à votre honneur et en adéquation avec mes préceptes de samouraï.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021108,
					"content": "Non, non, pas besoin. Merci de me laisser partir. C'est vraiment généreux de votre part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021110,
					"content": "Euh, je ne comprends pas... Vous vouliez juste lui faire peur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021111,
					"content": "Je n'ai aucun plaisir à effrayer les gens. Je testais simplement toutes les possibilités tant que l'œil divin était entre ses mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021112,
					"content": "Lorsque les gens sont poussés dans leurs derniers retranchements, c'est là qu'ils dévoilent leur plein potentiel. J'ai pensé que cela pouvait être l'opportunité pour lui d'éveiller l'œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021113,
					"content": "Mais malheureusement, rien ne s'est produit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021114,
					"content": "Vous aviez donc tout prévu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "Oui. Je voulais savoir s'il était possible d'éveiller un œil éteint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021116,
					"content": "À partir du moment où il a volé l'œil divin, j'ai décidé de l'utiliser pour cette expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021117,
					"content": "J'ai essayé de nombreuses autres méthodes par le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021190,
					"content": "Bien que peu d'histoires parlent du « réveil d'un œil divin sans porteur »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021191,
					"content": "Après vous avoir vu manier plusieurs éléments, je me suis dit que rien n'était impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021192,
					"content": "Approchez, pourquoi ne pas essayer ? Voyons si vous pouvez m'apporter la réponse que j'espère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021118,
					"content": "Je vais essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "Hmm, on dirait que l'œil divin n'a aucune réaction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021121,
					"content": "Je vois. Donc vous aussi, vous êtes incapable de raviver l'œil divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021122,
					"content": "Cela n'a pas d'importance, c'était quelque chose auquel je m'attendais. Je suppose que cet œil divin est toujours en ma possession pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021123,
					"content": "Pourquoi êtes-vous aussi attaché à cet œil divin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "Oui, qu'est-ce qu'il s'est passé avec cet œil divin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021126,
					"content": "L'histoire commence avec un vieil ami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021127,
					"content": "Peut-être qu'un jour, j'en viendrai à réaliser que tout ce que j'ai fait n'avait aucun sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021128,
					"content": "Mais en tant que samouraï errant, je trouve une signification non seulement dans le fait de voyager et dans la beauté que la nature déroule sur ma route, mais je porte également la « voie du guerrier » dans mon cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021129,
					"content": "Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021130,
					"content": "Héhé, c'est juste une autre façon de dire que je fais ce que je veux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021131,
					"content": "Très bien alors. Il est temps de rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021132,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "Permettez-moi de laisser les vents nous guider une fois de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021134,
					"content": "Si vous avez besoin de parler, je suis là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "... Ne laissez pas mes émotions vous troubler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021136,
					"content": "Mais je vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021124,
					"content": "Pourquoi vouloir absolument raviver cet œil divin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
		{
			"id": 200212,
