		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "Hein, pourquoi n'est-il toujours pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#Qu'à cela ne tienne, on peut commencer par te présenter en premier, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "Tout le monde, écoutez. Votre attention, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "Nous sommes enfin arrivés au moment tant attendu du Clash du Crux. Voici arrivée la finale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "Nous avons assisté à de nombreux combats passionnants aujourd'hui, et nous avons à présent deux finalistes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "#Tout d'abord, j'aimerais présenter notre {M#premier combattant}{F#première combattante}. Bien que peu d'entre vous l'aient déjà {M#vu}{F#vue}, sa réputation ne connaît pas de limite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#{M#Il}{F#Elle} a instillé la peur dans le cœur d'Ortell, et à la seule mention de son nom, les Exécuteurs des Fatui pâlissent... Je vous présente {M#le voyageur de Liyue}{F#la voyageuse de Liyue}, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "Waouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Participant"
				},
				{
					"id": 20020209,
					"content": "J'attends ce moment depuis longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Participante"
				},
				{
					"id": 20020210,
					"content": "Je suis sûre que vous avez vu son match à couper le souffle lors des demi-finales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "Et la finale d'aujourd'hui va sûrement encore faire monter le niveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "Quant à l'autre combattant... Euh, il n'est pas encore arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "Allons, qu'est-ce qui peut bien lui prendre tout ce temps ? On ne peut pas se désister en ne venant pas comme lors des tours précédents... C'est la finale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "Mes excuses ! Restez assis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "Il s'est peut-être trompé sur l'heure du match ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Nous n'avons pas d'autre choix... S'il ne se montre pas, nous allons devoir reporter le match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Attendez. Je sens que quelque chose n'est pas normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Capitaine Beidou, je suggère d'aller vérifier la récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, venez avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "Il a peut-être eu peur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
