			"dialogs": [
				{
					"id": 710331201,
					"content": "Oui ? Avez-vous besoin de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331202,
					"content": "À propos du duel entre Qingzhou et Vermeer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Oh, ces deux-là ? Ne t'inquiète pas pour eux. Tant mieux s'ils passent du temps avec les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331204,
					"content": "C'est les fêtes, après tout. Un peu d'animation ne fait pas de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331205,
					"content": "#Mais toi, mon enfant, à te démener comme ça dans tout le village, tu dois être {M#fatigué}{F#fatiguée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331206,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "Tu es vraiment aimable... Tiens, c'est pour toi. Et merci bien, j'espère que tu passeras un magnifique Festival des lanternes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331209,
					"content": "J'espère que l'année prochaine aussi, on s'amusera autant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331207,
					"content": "Vous êtes trop gentille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
			"id": 7103314,
			"completionStepIds": [
				7103314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103314",
