			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "Les enfants, regardez cette lanterne céleste. La réponse de l'énigme est en rapport avec le Festival des lanternes. Allez, à vous de jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331402,
					"content": "#Mon {M#ami}{F#amie} et moi avons quelque chose à faire. Je reviendrai jouer avec vous dès que j'aurai fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331403,
					"content": "Hé, monsieur Qinqzhou, vous allez faire quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 710331404,
					"content": "J'ai une sorte de... duel avec un peintre... J'écris mon meilleur poème, il peint sa meilleure toile, et nous verrons qui est le meilleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331405,
					"content": "Bah, bien sûr que c'est vous qui allez gagner, monsieur Qingzhou ! Vous avez fait tout plein d'énigmes, et elles sont toutes super méga top !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331406,
					"content": "Vraiment ? Eh bien, merci pour tes compliments, mon jeune ami. Allez, prenez cette lanterne et retournez tous y réfléchir au village. C'est dangereux de rester ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331407,
					"content": "Pas de problème, monsieur ! On connaît l'endroit comme notre poche, on peut rentrer tout seuls. Vous n'avez qu'à y aller et lui faire voir à ce peintre tout nul !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331408,
					"content": "Et... Monsieur Qingzhou, quand vous avez fini avec ce peintre, revenez vite, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "Petite You"
				},
				{
					"id": 710331409,
					"content": "Bien sûr ! Je reviendrai dès que c'est terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331410,
					"content": "Franchement, c'est un bon poème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "Ce poème pourrait gagner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Haha, un poème, vous dites ? Ce n'est rien de plus qu'une banale énigme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331413,
					"content": "Bon, allons voir le peintre... Il doit nous attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
