				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "#{M#Voyageur}{F#Voyageuse}, {M#voyageur}{F#voyageuse}, par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "Tu es le peintre qui a arrangé ce défi avec Qingzhou la dernière fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Oui, c'est moi ! Ce poète de bas étage et moi, on avait décidé de créer chacun de notre côté une œuvre qui résumerait le Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "Et tu m'as même aidé à récupérer du matériel, tu dois t'en souvenir j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Je m'en souviens...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "Ma peinture... Eh bien, ahem... J'ai déjà peint beaucoup de paysages, de personnages, et même des animaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "Je suis convaincu que mes toiles parlent d'elles-mêmes, mais... aucune n'arrive à rendre justice au Festival des lanternes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "*soupir* J'en ai même perdu le sommeil et l'appétit ! Et puis, je serai bientôt à court de pigments... Et je n'ai toujours pas terminé la toile que je voulais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "Je pensais donc aller voir le poète, et où il en était de son côté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que tu sais où il est allé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "Il est au Village de Qingce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "Au Village de Qingce ? Mais pourquoi est-il allé là-bas... Y aurait-il trouvé l'inspiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "#Allez, {M#voyageur}{F#voyageuse}, allons à Qingce pour le retrouver ! Et puis on ne sait jamais... Si ça se trouve, j'y trouverai un peu d'inspiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "Ahem, bon, allons-y vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "Et ta peinture, elle avance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "Alors c'est ça, le Village de Qingce... Bon, où est-il passé, ce poète ? Il est parti chercher l'inspiration quelque part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "La dernière fois qu'on s'est vus, il faisait des énigmes de lanterne avec les enfants...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "Euh... Des énigmes de lanterne ? Mais, à quoi ça rime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "Peut-être qu'il se prépare à reconnaître sa défaite par manque d'inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Ah, peu importe ! Le Festival des lanternes va bientôt se terminer, je n'ai pas de temps à perdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Allons voir où il se trouve. Je veux savoir ce qu'il en retourne de notre petite compétition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "#Oh, bien le bonjour, {M#voyageur}{F#voyageuse} ! Grâce à toi, la fête est revenue au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Oh, tu as amené un ami, je vois ? Qui es-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330403,
					"content": "C'est un peintre venu voir Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Oh, vous cherchez monsieur Qingzhou ? Hmm, ça tombe bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330405,
					"content": "Quand Wangya est partie il y a quelques jours, Qingzhou a dit qu'il souhaitait rester un peu plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330406,
					"content": "Il doit encore être à inventer des énigmes de lanterne pour les enfants. Voyons... Je me souviens qu'il les a amenés jouer à l'extérieur du village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330407,
					"content": "Si tu veux le voir, c'est là-bas que tu devras aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330408,
					"content": "#Il s'amuse vraiment à faire des énigmes... {M#Voyageur}{F#Voyageuse}, aide-moi à aller jeter un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "Va dire à ce soi-disant poète que je suis prêt à en découdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "Il nous faut décider d'un vainqueur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Haha, vous commencez à prendre le coup. Vous devinez de plus en plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer est arrivé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Vermeer... Oh, oui, ce peintre. Laissez-moi voir... C'est en effet bien la date convenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330505,
					"content": "Dommage que mon poème soit inachevé. Et puis, ces enfants n'ont pas non plus fini de s'amuser avec mes énigmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330506,
					"content": "Eh bien, peut-être est-ce là la limite de mon talent poétique, alors... Accepteriez-vous de m'accompagner dans ma quête d'inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330507,
					"content": "Hmm, ma quête d'inspiration... Je ne devrais peut-être pas dire ça... Allons simplement faire un tour ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330508,
					"content": "Monsieur Qingzhou ! Ça veut dire qu'on fait plus d'énigmes ? Je veux continuer, moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330509,
					"content": "Oui, moi aussi, je veux continuer les énigmes, monsieur Qingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 710330510,
					"content": "Hé, moi aussi, j'ai envie d'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "Petite You"
				},
				{
					"id": 710330511,
					"content": "#Haha, point de précipitation. Mon {M#ami}{F#amie} et moi allons faire un tour, et on reviendra avec de nouvelles énigmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330512,
					"content": "Retournez d'abord au village. Je viens vous voir quand je reviens, marché conclu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330513,
					"content": "Oui ! M'sieur Qingzhou est le meilleur, il invente toujours plein d'énigmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330514,
					"content": "Il a dû lire un tas de bouquins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 710330515,
					"content": "J'aimerais bien être comme vous plus tard...",
					"roleType": "TALK_ROLE_NPC",
