				"points": []
			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "Monsieur Qingzhou est revenu ! Monsieur Qingzhou, vous avez fini des nouvelles énigmes pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 710331002,
					"content": "Cette fois, c'est sûr ! Je vais trouver... Je crois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331003,
					"content": "Je vais bien réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "Petite You"
				},
				{
					"id": 710331004,
					"content": "Haha, j'ai déjà écrit une énigme de lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331005,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à accrocher cette lanterne céleste... Un peu plus en hauteur, si cela ne vous gêne pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7103311,
			"completionStepIds": [
				7103311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103311",
							"2"
						],
						"stepId": 7103311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "Vous voilà enfin ! Avez-vous terminé votre poème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331102,
					"content": "Je n'ai rien écrit qui fasse l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331103,
					"content": "V—Vous aussi... Ahem, et pourquoi n'avez-vous rien écrit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331104,
					"content": "Liyue est grandiose et ses merveilles sont nombreuses... J'ai longuement réfléchi à la question, mais rien d'approprié ne m'est venu. Et vous, avez-vous terminé votre peinture ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331105,
					"content": "Moi, euh... Moi non plus ! Liyue est bien trop grande ! Comment pourrais-je tout peindre ? À moins que le ciel lui-même ne me serve de toile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331106,
					"content": "Donc, aucun de nous n'a été en mesure de créer une œuvre pouvant résumer la beauté du Port de Liyue et de son Festival des lanternes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331107,
					"content": "Je suppose qu'on peut considérer qu'il s'agit d'un match nul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331108,
					"content": "Bon... Soit, dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331109,
					"content": "Monsieur Qingzhou, monsieur Qingzhou ! On a résolu l'énigme de lanterne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331110,
					"content": "Une énigme... de lanterne ? De quoi s'agit-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331111,
					"content": "Oh, rien de bien important. Je compose simplement quelques énigmes pour amuser les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331112,
					"content": "Ah bon ? Et c'est si dur que ça ? Dites-m'en une pour voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331113,
					"content": "« Les navires voguent sans s'arrêter, illuminant Guyun de leur lampes éclairées. Ils flottent au rythme des marées, jusqu'au jour où leurs os rejoignent ceux des noyés. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331114,
					"content": "Vous avez écrit ça pour des enfants ? C'est un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331115,
					"content": "Monsieur Qingzhou, c'est qui ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331116,
					"content": "C'est le peintre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "Mais, si vous ne voulez pas vous mesurer à moi, pourquoi avoir accepté mon duel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331119,
					"content": "Ce n'est qu'un quiproquo. Au début, je pensais écrire le chef-d'œuvre qui garantirait ma victoire. Je suis donc allé trouver l'inspiration, et j'ai vraiment mis toute ma passion dans quelques vers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331120,
					"content": "Mais, vous avez dû ressentir ça aussi... Quelques mots ne pourraient capturer la magnificence de Liyue et du festival. Alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331121,
					"content": "Alors, vous êtes venu ici pour jouer avec les enfants ? En leur donnant des énigmes, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331122,
					"content": "Précisément. Je suis venu leur présenter des énigmes en me disant que le reste attendrait que l'inspiration arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331123,
					"content": "Haha, mais l'inspiration m'échappe encore, alors que mes nombreuses énigmes, elles, ont un certain succès auprès des enfants du village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331124,
					"content": "Peut-être est-ce là que réside le « poème » que je cherchais... Je ne peux hélas pas l'écrire, et sans poème, je ne peux guère vous affronter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331125,
					"content": "Ah, les Liyuéens, vous êtes vraiment bizarres ! Comment se départager dans ce cas ? Qui perd et qui gagne ? Un match nul est inconcevable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331126,
					"content": "Il radote vraiment, ce vieux schnock ! Bien sûr que c'est monsieur Qingzhou qui gagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331127,
					"content": "C'est le plus fort ! Il a trouvé un tas d'énigmes, et je suis sûr que vous arrivez même pas à les deviner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331128,
					"content": "Ce poète... Attendez, j'ai une idée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331129,
					"content": "Oui, je sais ! Affrontons-nous autrement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331130,
					"content": "Oh ? De quel genre de défi parlez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331131,
					"content": "Vous avez écrit des énigmes pour ces enfants, non ? J'ai de mon côté vu pas mal de lanternes célestes en cherchant l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331132,
					"content": "Rédigez une énigme, et je peindrai la lanterne qui va avec. Les enfants seront nos juges et choisiront le gagnant. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331133,
					"content": "D'accord ! Ça me convient, et ça va tout à fait avec l'esprit du Festival des lanternes. Rien de plus approprié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331134,
					"content": "Alors c'est décidé. Dès que je récupère mes pinceaux, on se retrouve ici et que le défi commence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331135,
					"content": "Vous êtes vraiment à fond tous les deux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "Allez les enfants. Vous me montrez ce qu'a inventé ce poète, et je vous peins la lanterne qui va avec !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331138,
					"content": "Héhé, j'ai bien peur que votre pinceau ne soit bien plus lent que ma plume. Vous n'arriverez jamais à peindre aussi vite que j'imagine mes énigmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331136,
					"content": "Que le meilleur gagne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "C'est le rival de monsieur Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
		{
