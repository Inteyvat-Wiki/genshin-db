						710330517
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330517,
					"content": "#{M#Voyageur}{F#Voyageuse}, allons-y vite et finissons-en avec cette affaire. Ne faisons pas attendre ces enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
