				"points": []
			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Ah, c'est vous, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Escoffier, ça faisait longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Aujourd'hui, je ne suis pas aux fourneaux. Je suis juste là pour goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna souhaite lancer un nouveau plat et m'a demandé de l'aider. Mais là... c'est déjà la cinquième fois qu'elle le refait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "Soit il manque quelques secondes de cuisson, ce qui affecte la texture des ingrédients ; soit l'assaisonnement est trop relevé, et les épices dominent la saveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Vous êtes toujours aussi exigeante, Escoffier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Bien sûr que oui ! La cuisine est une science, je ne vais pas changer ma façon de faire parce que c'est une amie. Au contraire, c'est ma responsabilité envers elle et envers mes clients d'être encore plus stricte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "En vérité, j'ai un petit service à vous demander...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "... Maintenant ? Si c'est pour une exposition publique, il vaudrait mieux trouver un autre moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Il faut bien réfléchir au décor, ajuster soigneusement l'éclairage et les angles pour obtenir le meilleur rendu possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Je veux juste prendre une photo-souvenir avec mon amie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "... D'accord. De toute façon, il faut attendre qu'elle refasse le plat une sixième fois. On a encore un peu de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "Voyons donc qui s'en sort le mieux, votre nouvel objectif ou ce nouveau plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Et ça me permet aussi de tester les performances de mon nouvel objectif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Est-ce que je peux vous prendre en photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Vous travaillez sur une nouvelle recette ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
