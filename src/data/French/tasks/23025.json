				"points": []
			},
			"dialogs": [
				{
					"id": 230250801,
					"content": "#Oh ! {M#Voyageur}{F#Voyageuse}, vous êtes enfin là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Comment se passent vos recherches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Grâce à vous, j'ai beaucoup progressé ces derniers jours. Les balises devraient être en train de collecter des données.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Il ne me reste plus qu'à récupérer ces données pour vérifier mes dernières hypothèses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Vous avez passé ces derniers jours à faire des hypothèses ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Ahem, j'ai aussi amélioré mes formules de calcul, calibré mes instruments de mesure, etc. Après tout, vous voyez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "Avec mon physique, il m'est impossible de monter jusqu'à l'endroit où vous avez installé ces balises pour les récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "J'ai bien peur de devoir vous demander d'aller les récupérer pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "#S'il vous plaît, {M#Voyageur}{F#Voyageuse} ! Je vous récompenserai généreusement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "La prochaine fois, réfléchissez à un moyen de les récupérer vous-même...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Ce n'est pas que je n'y ai pas pensé. Par exemple, on peut ajouter un dispositif pour les récupérer ou élargir leur champ d'application...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Mais cela nécessiterait un budget plus important, et je ne suis pas sûr que la précision des données n'en pâtirait pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "#Quoi qu'il en soit, je compte aussi sur vous une fois de plus, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "#Je n'appelle pas du tout ça «{NON_BREAK_SPACE}progresser »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
