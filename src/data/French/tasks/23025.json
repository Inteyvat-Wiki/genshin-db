			},
			"dialogs": [
				{
					"id": 230250701,
					"content": "Hmm ? Avez-vous fini d'installer toutes les balises ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250702,
					"content": "Oui, c'est fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Merci beaucoup. Tenez, voici la rémunération promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250704,
					"content": "Il ne nous reste plus qu'à attendre qu'elles finissent de collecter des données pour confirmer mes déductions précédentes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250705,
					"content": "Mais maintenant, comment vais-je monter tout là-haut pour les récupérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
		{
