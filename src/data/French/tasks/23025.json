				"objectNames": [
					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "#Hé, mon {M#ami}{F#amie}, je peux vous parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250202,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "Avez-vous déjà pensé à la question suivante : que faire si le ciel tombe sur nos têtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250209,
					"content": "Je pense que vous vous posez trop de questions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Peut-être, mais pourquoi le ciel ne tomberait-il pas ? Et pourquoi la terre ne s'effondrerait-elle pas ? Sans prendre des mesures précises, on ne pourra jamais répondre à ces questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250213,
					"content": "J'ai en réalité créé un modèle parfait pour y répondre, j'ai juste besoin de plus de données d'observation sur lesquelles m'appuyer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250214,
					"content": "Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "#Donc vous êtes {M#prêt}{F#prête} à m'aider, n'est-ce pas ? Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250224,
					"content": "En fait, j'ai déjà sélectionné un excellent site d'observation, mais les monstres à proximité sont quelque peu actifs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250225,
					"content": "S'il vous plaît, chassez ces monstres, afin que je puisse prendre note de mes observations en toute tranquillité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250226,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Merci beaucoup, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250228,
					"content": "Vous venez aussi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Il faut bien que je vérifie certaines données moi-même pour savoir la cause des erreurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250230,
					"content": "Si on reste plongé dans ses calculs, on s'éloigne de plus en plus de la réponse que l'on cherche. Mettons-nous vite en route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250215,
					"content": "Je vous souhaite bonne chance. À bientôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Attendez, attendez un peu ! Réfléchissez-y, si je peux faire publier mon travail, ce sera une grande affaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250217,
					"content": "#Dès lors, vous serez {M#un contributeur}{F#une contributrice} à cette grande théorie et je pourrai mettre votre nom dans la liste des remerciements à la fin de mon article...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250218,
					"content": "#Oh... Si ça ne vous suffit pas, je peux envisager de faire de vous {M#mon co-auteur}{F# ma co-auteure}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250219,
					"content": "Vous êtes si pressé que ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Si je n'ai pas de résultats, j'ai peur de perdre le financement de mes recherches... Et ça, c'est bien pire que si le ciel tombait sur nos têtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250221,
					"content": "Pas besoin de me mentionner...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "Payez-moi bien, et ça m'ira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "Le ciel ne tombera pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "#Je suis très {M#occupé}{F#occupée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "Oh ! Ne dites pas ça, qu'est-ce qui pourrait être plus grave que l'effondrement imminent de son foyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250205,
					"content": "Votre maison... va s'effondrer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "Ahem... Bien sûr que non. Mais si vous vivez dans une maison que vous n'avez jamais pu inspecter intégralement, et que personne n'a jamais garanti la solidité structurelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250207,
					"content": "Vivre dans cette maison tous les jours vous mettra mal à l'aise, n'est-ce pas ? Eh bien, vous voyez, c'est la même chose de vivre dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Farghani"
				}
			]
		},
		{
			"id": 2302504,
