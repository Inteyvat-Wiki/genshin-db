			"dialogs": [
				{
					"id": 230250401,
					"content": "Hum... Alors c'est donc ça ? Si on réintroduit cette variable, l'erreur précédente s'explique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Mais dans ce cas, est-ce que cela modifie mes autres déductions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Alors, vous progressez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Ah, désolé, j'avais oublié que vous étiez encore là... Tenez, voici la rémunération promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "En ce qui concerne les progrès accomplis... Certains problèmes ont été résolus, mais il semble que beaucoup de nouveaux problèmes soient apparus... C'est ça, la recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "#Je vais peut-être devoir continuer à vous embêter, {M#voyageur}{F#voyageuse}, jusqu'à ce que j'arrive à une conclusion finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
