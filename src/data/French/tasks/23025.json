			"dialogs": [
				{
					"id": 230251001,
					"content": "Quoi ? Des monstres ? Ça n'a pas de sens, les paramètres environnementaux de cette zone sont clairement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251002,
					"content": "Se pourrait-il que les balises elles-mêmes soient une variable ? Par exemple, si elles vibrent légèrement lorsqu'elles sont en marche, ou que le son et la lumière qu'elles émettent attirent les monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251003,
					"content": "J'espère que cela n'affectera pas les données recueillies... Ah, excusez-moi, je suis encore en train de parler tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Je ne m'attendais pas à ce que cela vous cause des problèmes... Veuillez accepter ces récompenses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251005,
					"content": "Je devrai être plus consciencieux la prochaine fois que j'aurai besoin de prendre des mesures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
