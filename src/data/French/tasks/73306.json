			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bonifaz",
					"Nachtigal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Où sont Omid et Mirsad ? Ne me dites pas que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Ils vont bien tous les deux, ne vous inquiétez pas... C'est juste qu'ils... Ils ont d'autres plans et ne continueront plus à travailler pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Quoi ? Qu'est-ce qu'on va faire ? On ne s'en sortira pas à deux ! Il faut qu'on trouve des gens ! Mais qui voudrait venir au Village d'Aaru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Tant pis, on en rediscutera plus tard. Cyrus est revenu sain et sauf, c'est déjà ça. Je ne le laisserai plus aller dans un endroit aussi dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "Qu'est-ce que ça veut dire ? On est des marchands, et ces bêtes de somme sont indispensables à notre travail ! Si tu ne les laisses pas sortir, qu'est-ce qu'elles vont manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Ce n'est pas le vent qui va nous nourrir. En plus, essaye d'ouvrir la bouche ici, tu vas voir tout le sable qui va rentrer dans ta bouche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Même ainsi, on ne peut pas laisser Cyrus prendre ce risque. Regarde-toi, tu es assez costaud, pourquoi tu ne t'occuperais pas de transporter les marchandises ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nachtigal"
				}
			]
		}
	]
