			"trigger": {
				"objectNames": [
					"Tirzad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "Ah... C'est vous. Ça va ? Je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Parlons de Jebrael...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "J'ai douté de lui jusqu'au dernier moment, quel idiot j'ai été...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Maintenant, je n'éprouve que de la gratitude envers lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Je n'ai jamais eu de conviction solide, que ce soit dans les études ou dans la vie elle-même... Mais à partir de maintenant, je ne flancherai plus. Je suivrai ma voie d'un pas décisif, aussi ardue soit-elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Dans un sens, je fais ça aussi pour Jebrael...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Parlez-moi du roi Deshret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Je suis maintenant un peu sceptique quant à la crédibilité des articles que j'ai lus auparavant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "La prière m'a donné un sentiment indescriptiblement étrange. D'autre part, je dois étudier plus en profondeur ce que Samail nous a dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Bien sûr, ma priorité est de terminer la rédaction de ma thèse dans le délai que je m'étais fixé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Que pensez-vous de Jeht ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "*soupir* J'aimerais pouvoir faire quelque chose pour elle, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Il n'y a rien que je puisse faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Elle ne me dit jamais rien. Si elle me demandait quelque chose, je le ferais pour elle, peu importe ce que c'est tant que c'est dans mes capacités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
