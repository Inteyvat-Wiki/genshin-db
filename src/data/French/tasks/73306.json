			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Désolée... Je ne suis toujours pas très douée pour contrôler mes émotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552602,
					"content": "Ne t'excuse pas, ce n'est pas ta faute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Oui, Jeht. On sait tous que tu vis un moment difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Merci... Je vous souhaite que votre voyage se passe au mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552605,
					"content": "Hmm... J'espère que tout ira bien pour toi à l'avenir... Je suis sûre que ce sera le cas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305527,
			"completionStepIds": [],
