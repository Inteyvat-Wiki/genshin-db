					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501509,
					"content": "Je pense qu'il y a un malentendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501510,
					"content": "Je suis un prototype conçu pour aider le seigneur Xiuhcoatl à enregistrer des informations, je n'ai donc pas de nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
