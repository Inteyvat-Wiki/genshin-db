			"dialogs": [
				{
					"id": 751500901,
					"content": "Bonjour. Nouvelle catégorie de récupération de données détectée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500902,
					"content": "... Les entrées sur le noyau énergétique du mécanisme de source secrète ont été mises à jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500903,
					"content": "Le phlogistique est la principale source d'énergie des mécanismes de source secrète, bien que sous une forme concentrée qui ressemble davantage à la lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500904,
					"content": "La réaction contrôlée [DONNÉES PERDUES] permet de produire des unités phlogistiques stables qui permettent un contrôle encore plus précis de la libération d'énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500905,
					"content": "L'énergie nécessaire à un mécanisme de source secrète dépend de sa taille et de la complexité de sa logique de fonctionnement. La quantité d'unités phlogistiques requise par un serviteur de source secrète est [DONNÉES PERDUES]...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500906,
					"content": "En comparaison, les plus grandes idoles du dragon de source secrète nécessitent moins d'unités phlogistiques, trois exactement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500907,
					"content": "« L'information est de l'énergie et l'énergie est de l'information. » Le support de données que vous avez récupéré compte comme une Unité phlogistique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500908,
					"content": "Une Unité phlogistique est donc une boule de feu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Oui, vous pouvez le voir de cette façon. Vous avez restauré une Unité phlogistique contaminée par l'Abîme. Ce n'est qu'alors que je peux en tirer quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500910,
					"content": "Elles peuvent également être utilisées comme des sources d'énergie alternatives pour les mécanismes de source secrète contaminés par l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serviteur de source secrète"
				}
			]
		},
