					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501506,
					"content": "Des humains n'étaient pas arrivés aussi loin depuis... au moins cinq cents ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501507,
					"content": "Attendez, vous n'êtes pas Amaru... Ni Ehecatl, d'ailleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "... Il y a effectivement eu des individus portant ces noms, mais je ne suis ni l'un ni l'autre.",
