			"dialogs": [
				{
					"id": 751501301,
					"content": "Avez-vous des questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501302,
					"content": "Comment accéder au Cœur de la Montagne sacrée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "L'entrée du Cœur de la Montagne sacrée se trouve à l'entrée découverte récemment... Dirigez-vous vers la fissure la plus profonde du volcan, celle qui est gardée par une idole du dragon de source secrète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501304,
					"content": "De plus, toute personne souhaitant accéder au Cœur de la Montagne sacrée doit obtenir un permis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501305,
					"content": "Ce n'est qu'alors que vous recevrez la reconnaissance de l'idole du dragon de source secrète qui garde le Cœur de la Montagne sacrée, également connue sous le nom de Huitzilopochtli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501306,
					"content": "Où pouvons-nous obtenir ce permis...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Selon l'accord et le décret de Xiuhcoatl, l'accès au... Cœur de la Montagne sacrée, également connue sous le nom de Huitzilopochtli... est réservé aux descendants de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501308,
					"content": "Rendez-vous à la Chambre de délibération pour déposer une demande, puis attendez que le permis soit délivré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501309,
					"content": "Qu'en est-il de la source d'énergie des idoles du dragon de source secrète ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Recherche... Aucune catégorie correspondante d'entrées de données n'est disponible... Ou, comme tant d'autres, les données pertinentes ont été perdues à cause de la contamination de la ville par l'Abîme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501311,
					"content": "Si vous parvenez à éradiquer les effets de l'Abîme et à récupérer les données, vous trouverez peut-être les entrées que vous cherchez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501312,
					"content": "Je vous ai indiqué un emplacement où des données pourraient être entreposées. Veuillez vous débarrasser de la corrosion de l'Abîme qui y est présente pour restaurer la zone de conservation des données.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501313,
					"content": "Avez-vous des questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501314,
					"content": "Je n'ai plus d'autres questions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serviteur de source secrète"
				}
			]
