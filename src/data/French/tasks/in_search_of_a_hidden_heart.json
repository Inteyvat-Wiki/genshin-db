			"dialogs": [
				{
					"id": 751500401,
					"content": "Comment accéder au Cœur de la Montagne sacrée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "L'accès au Cœur de la Montagne sacrée est à proximité. En recréant le centre de la cité de Tollan, Xiuhcoatl a creusé pour créer un environnement de test stable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500403,
					"content": "C'est là qu'il a fabriqué l'arme ultime pour lutter contre l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500404,
					"content": "Cependant, à cause du sceau, cette arme a profondément été corrodée par l'Abîme. Et la ville fut prise d'assaut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751500405,
					"content": "L'entrée du Cœur de la Montagne sacrée se trouve sous les fissures de la cité sacrée... C'est précisément là où la contamination par notre sombre ennemi est la plus profonde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serviteur de source secrète"
				}
			]
		},
