						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Enfin, ce n'est pas que je n'ai pas de nom, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501513,
					"content": "Je suis le seul Serviteur de la source intelligent sans maître. Même après la chute de Xiuhcoatl, je me suis toujours occupé des tâches élémentaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501514,
					"content": "... Des travaux d'entretien de la cité et de l'enregistrement d'informations élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501515,
					"content": "... Mais à cause de l'invasion de l'ennemi des ténèbres, une partie des enregistrements a été perdue. Je n'ai donc aucune donnée sur mon propre nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501516,
					"content": "Hmm, ce n'est donc pas la bonne personne... Euh, le bon dragon-robot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "Ce n'est rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Serviteur de source secrète"
				},
				{
					"id": 751501518,
					"content": "Ce robot est grand, mais il n'a pas l'air très futé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}, ce n'est probablement pas la même personne qui nous parlait à travers ces machines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Mais il vient de dire qu'il était responsable des enregistrements... Euh, d'enregistrer les informations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Et si on lui demandait simplement ce qu'il sait, ou même... comment accéder au Cœur de la Montagne sacrée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
