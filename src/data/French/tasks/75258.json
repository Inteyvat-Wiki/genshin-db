			"dialogs": [
				{
					"id": 752580101,
					"content": "Hein ? Cette personne s'est évanouie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "Oh hé ! Vous m'entendez ? Est-ce que ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Vous aidez l'homme à se relever et il reprend doucement ses esprits...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Aïe, aïe, aïe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580105,
					"content": "Bonjour. Vous avez trop bu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "J'ai mal à la tête... Comment est-ce que... Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580108,
					"content": "Ah ! Je me souviens ! Je crois que j'ai été assommé par quelqu'un... Mais je n'ai pas vu qui c'était. Attendez, ce n'était pas vous quand même ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580109,
					"content": "Hé ! On est en train de vous aider, vous devriez nous remercier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Désolé... Euh... Je travaille à Osez rosée. Je devais livrer des marchandises au port situé au nord. Hmm... Puis ce marchand de Nod-Krai nous a acheté de l'hydromiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580111,
					"content": "Oh, non ! Mes marchandises ! Elles ne sont plus là ! Est-ce qu'on me les a volées ? Attendez, ce n'est pas vous quand même ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580112,
					"content": "Mais pourquoi vous nous suspectez encore ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Ah, oui. Pardon, je suis désolé... Je dois encore être un peu confus. Merci à vous deux. Je dois retourner au bar pour leur expliquer ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580114,
					"content": "S'il y a vraiment des bandits, vous devriez probablement rester à l'écart du port au nord. Cela pourrait être dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Employé inconscient"
				},
				{
					"id": 752580106,
					"content": "Vous voulez qu'on vous ramène chez vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
