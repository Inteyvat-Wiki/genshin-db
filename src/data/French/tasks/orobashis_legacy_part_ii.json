			"dialogs": [
				{
					"id": 721300101,
					"content": "La lanterne de pierre aux formes étranges semble émettre une énergie inquiétante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721300102,
					"content": "Cette lanterne de pierre est si effrayante... Elle m'a l'air un peu familière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Oh, quelqu'un a écrit quelque chose dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "« Soldats stationnés ici : si vous avez des questions à propos de cette protection, veuillez vous rendre aux Gorges de Musoujin et parler à monsieur Kaji. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721300105,
					"content": "L'écriture semble récente, mais érodée par la pluie. Il y a quelques lignes plus nettes et plus petites en dessous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721300106,
					"content": "« Ne croyez pas ces notes inconnues. Nous n'avons pas de temps à perdre ! C'est forcément une stratégie de l'ennemi pour nous ralentir. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721300107,
					"content": "« Quiconque quitte l'équipe sans permission sera sévèrement puni ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721300108,
					"content": "Ce monsieur Kaji semble assez préoccupé par ces lanternes de pierre. Pourquoi ne pas aller aux gorges de Musoujin et lui demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
