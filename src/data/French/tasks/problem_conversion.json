			"dialogs": [
				{
					"id": 230190401,
					"content": "Alors ? Vous avez fini d'examiner le bateau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Oui, c'est fini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Vous lui décrivez l'état du bateau...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Je vois. Il y a vraiment quelque chose qui ne va pas avec les structures sur lesquelles on a fait des économies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Mais ça va coûter une fortune pour la faire réparer, je me souviens que le propriétaire du bateau avait des difficultés financières...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "*soupir* Je ferais mieux d'aller lui parler... Sa vie est plus importante que quelques moras d'économisés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		}
