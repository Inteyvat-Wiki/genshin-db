			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Évidemment, ça coûte plus cher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "De quoi vous parlez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Ah, bonjour. Je travaille sur un problème de conception de bateaux. À vrai dire... Je suis confronté à une difficulté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "En bref, je voudrais augmenter la capacité du bateau sans dépenser plus d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Si la charge augmente, la structure devient plus fragile. Le bateau peut aussi avoir des problèmes d'équilibre si la charge est inégale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "L'idéal pour résoudre ces problèmes serait d'utiliser de meilleurs matériaux, mais cela ferait augmenter les coûts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "Pour être honnête, j'aimerais construire un bon bateau, mais je n'ai pas assez de moyens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Voilà pourquoi je n'ai pas d'autre choix que de réfléchir à une solution technique pour contourner les problèmes qui pourraient être résolus avec de l'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Vous pensez que ça va vraiment marcher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Hahaha ! Je sais que ça semble peu crédible, mais beaucoup de gens ici le font.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Après tout, les bateaux que nous construisons ne servent qu'à la pêche littorale. Ils n'affronteront pas de vents forts, ni de raz-de-marée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Tout le monde essaye d'économiser, de réparer autant que possible et de trouver des moyens de faire fonctionner le bateau correctement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "C'est grâce à cet esprit que nos activités de réparation navale marchent toujours aussi bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, pourriez-vous examiner le bateau là-bas qui vient de rentrer au port pour moi ? Il a souvent des problèmes comme il transporte des charges lourdes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Comme je fais des recherches à ce sujet, peut-être que ça pourra m'inspirer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Merci beaucoup ! Je vous laisse, il faut que je me dépêche de commencer les réparations d'un autre bateau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Pourquoi vous n'y allez pas vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Je voudrais bien, mais on me presse pour que je répare un bateau qui doit immédiatement partir en mer pour pêcher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "#Je n'ai donc pas d'autre choix que de vous demander un coup de main, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
