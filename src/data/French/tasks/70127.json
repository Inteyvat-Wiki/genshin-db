			"dialogs": [
				{
					"id": 701270201,
					"content": "« Si tu lis ce message, j'espère que tu es la personne que j'attends. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270202,
					"content": "« Nous pensions que la guerre n'était réservée qu'aux contes de fées et aux légendes... Mais maintenant, chacun de nous tremble sous la colère de Son Excellence. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270203,
					"content": "« La plage où nous avions l'habitude d'aller a été fermée, mais j'ai quand même réussi à envoyer cette lettre. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270204,
					"content": "« Ne t'en fais pas pour moi. Tout ceci est bien trivial pour quelqu'un qui a eu l'honneur de voyager à tes côtés ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270205,
					"content": "« J'attends ta réponse. Une phrase suffira. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bouteille abandonnée"
				}
			]
		}
	]
