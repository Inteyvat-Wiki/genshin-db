			"dialogs": [
				{
					"id": 701270101,
					"content": "« Si tu lis ce message, j'espère que tu es la personne que j'attends. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270102,
					"content": "« J'ai perdu le compte du nombre de lettres que j'ai écrites. Jusqu'où dérivera celle-là ? Où échouera-t-elle ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270103,
					"content": "« Si nous avons à nouveau l'occasion de nous revoir, tu me parleras encore des montagnes du Port de pierre, des tempêtes du grand nord, ou des pissenlits et du vin. Qu'en penses-tu ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701270104,
					"content": "« J'attendrai ta réponse, comme je l'ai toujours fait. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bouteille abandonnée"
				}
			]
		},
		{
