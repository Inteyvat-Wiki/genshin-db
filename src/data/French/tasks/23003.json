	"talks": [
		{
			"id": 2300302,
			"completionStepIds": [
				2300302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300302",
							"2"
						],
						"stepId": 2300302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Euh, non... {M#Fils}{F#Fille} de la fortune, vous, à qui la chance sourit ! Vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030202,
					"content": "La dernière fois que j'ai mangé le plat d'or que vous avez préparé, j'ai gagné le gros lot à la bourse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030203,
					"content": "Tous les contrats à terme que j'ai achetés ont généré d'énormes profits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030204,
					"content": "Allons à la Taverne de Lambad et commandez ce que vous voulez. Aujourd'hui, c'est moi qui paye pour vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "Tout ça, c'est grâce à votre aide, alors commandez tout ce que vous voulez à manger aujourd'hui ! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030402,
					"content": "On dirait que vous avez gagné beaucoup d'argent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030403,
					"content": "Pour une personne ordinaire, c'est plutôt pas mal. Mais comparé à tout ce que je possède, ce n'est pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030404,
					"content": "#Après tout, je suis un expert chevronné de la bourse. De ce fait, si vous êtes {M#intéressés}{F#intéressées} par les contrats à terme, je peux partager avec vous un peu de mon expérience personnelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030405,
					"content": "On avait convenu qu'il y aurait des avantages supplémentaires pour vous, alors vous pouvez me demander ce que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030406,
					"content": "Alors c'est ça, les fameux avantages supplémentaires. J'ai du mal à voir en quoi c'est mieux que de rien avoir du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030407,
					"content": "Oui, étant donné qu'on ne fait pas de contrats à terme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Ne dites pas n'importe quoi. Vous aurez bien sûr votre part de moras, mais ce n'est rien par rapport aux informations précieuses que je peux vous révéler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030409,
					"content": "Alors j'ai une question... Il y a vraiment des contrats à terme de bave de Blob ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030410,
					"content": "C—C'est pas pour gagner de l'argent ! Je suis juste un peu curieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030411,
					"content": "Seules les marchandises en circulation peuvent devenir des contrats à terme, c'est-à-dire que s'il y a autant de bave de Blob que de farine et de lait sur le marché, il est possible d'effectuer une transaction à terme de bave de Blob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030412,
					"content": "Comme j'ai dit avant, si vous cherchez à faire des transactions à terme de bave de Blob, les Blobs risquent de disparaître de la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030413,
					"content": "En outre, il se pourrait que des institutions ou des individus qui se spécialisent dans l'élevage de Blobs et la production continue de grandes quantités de bave de Blob se mettent à émerger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030414,
					"content": "Si cela arrivait, le prix de la bave de Blob augmenterait conséquemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030415,
					"content": "Ouah ! C'est juste un achat de bave de Blob, comment cela peut-il être si compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030416,
					"content": "#J—Je ferais mieux de laisser {NICKNAME} battre les Blobs pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030417,
					"content": "#Et vous, {M#fils}{F#fille} de la fortune, avez-vous des questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030418,
					"content": "D'où cette idée de plat d'or vous vient-elle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "#Ha ! Vous êtes digne du surnom de {M#fils}{F#fille} de la fortune, vous avez tout de suite trouvé la question à poser pour devenir riche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030420,
					"content": "On ne peut pas dire que c'est une idée qui m'est venue à l'esprit, seulement que... ces plats d'or sont la synthèse de ma longue carrière dans les transactions à terme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030421,
					"content": "Le marché à terme est traître... Mais tant qu'il y aura des plats d'or, je serai capable de saisir les meilleures occasions pour investir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030422,
					"content": "Il n'y a aucun fondement réel à tout ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Mettons ce sujet de côté. Allez ! À table ! Mangez à votre faim, je vais devoir encore vous demander de l'aide à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030425,
					"content": "Allez ! Goûtez ces shawarmas, c'est un incontournable de la cuisine sumérienne, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030426,
					"content": "Vous dégustez la nourriture avec Hatim...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "Est-ce que ce ne serait pas un moyen pour vous d'avoir l'esprit tranquille...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "Pourtant, j'ai bien mangé le plat d'or au point de richesses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030702,
					"content": "Alors pourquoi ça a chuté comme ça... C'est pas logique ! Est-ce qu'il y a encore des règles sur ce marché ? Ce n'est pas juste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030703,
					"content": "Hatim, ça fait une éternité que l'on vous cherche, ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030704,
					"content": "C'est vous... Je... Je... Ça va, je vais bien... Vous voyez, je n'ai pas perdu de bras ni de jambe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030705,
					"content": "C'est juste que j'ai perdu mes fonds de garantie... Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030706,
					"content": "#J—Je suis {M#désolé}{F#désolée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "Non ! Ce n'est pas votre faute, ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030708,
					"content": "Je sais bien que ce n'est pas ma faute. C'est à cause de ce marché, il est vraiment nul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030709,
					"content": "C'est pas logique ! Il ne suit aucune règle ! Il a chuté si rapidement et n'est jamais remonté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030710,
					"content": "Non mais vraiment ! Grrr... Vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030711,
					"content": "Non, je refuse toujours d'y croire... Hatim, l'extraordinaire fortune de Kalimi est toujours incapable de conquérir les transactions à terme ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030712,
					"content": "Mais vous avez tout perdu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "Hmph, ce n'est pas grave, j'ai encore plein de fonds de réserve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030714,
					"content": "Même si je suis à sec maintenant, j'ai toujours des fonds de roulement et des actifs ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030715,
					"content": "Attends un peu, Échange Kalimi, moi, Hatim, je reviendrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		}
	]
}