					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "Très bien ! Peu de joueurs comprennent qu'il faut miser gros pour remporter gros !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050503,
					"content": "Par ici, s'il vous plaît. Vous avez devant vous nos meilleures pierres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050504,
					"content": "#Je vous assure que vous ne serez pas {M#déçu}{F#déçue}. Prenez le temps de décider de celle que vous voudrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050505,
					"content": "Appelez-moi quand vous aurez choisi, et je m'occuperai du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
