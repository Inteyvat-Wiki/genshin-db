	"talks": [
		{
			"id": 2230501,
			"completionStepIds": [
				2230501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
