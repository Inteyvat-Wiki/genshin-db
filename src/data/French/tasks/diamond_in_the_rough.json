					"nextDialogs": [
						223050402
					]
				},
				{
					"id": 223050402,
					"content": "C'est la somme que je conseille à tous mes nouveaux clients, car elle est raisonnable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050403,
					"content": "Par ici, je vous en prie. Choisissez la pierre qui vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050404,
					"content": "Prenez votre temps. Faites-moi signe quand vous aurez décidé pour que je la casse.",
					"roleType": "TALK_ROLE_NPC",
