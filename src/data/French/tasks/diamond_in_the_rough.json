					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "Une décision prudente, à ce que je vois... Très bien, faites votre choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050303,
					"content": "Réfléchissez bien, c'est quand même 200 moras que vous misez dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050304,
					"content": "Faites-moi signe quand vous aurez choisi votre pierre pour que je l'ouvre.",
					"roleType": "TALK_ROLE_NPC",
