				{
					"id": 223050201,
					"content": "Nous proposons ici un vaste ensemble de pierres brutes, et quiconque souhaite participer n'a que l'embarras du choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050202,
					"content": "J'ai donc pris sur moi de sélectionner à votre attention les pierres susceptibles de correspondre à votre budget. Quel est-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
