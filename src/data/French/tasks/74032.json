			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "Nous sommes de retour, et le docteur nous a dit de vous donner ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320402,
					"content": "Lechlade prend l'eau pure et la boit.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "Je me sens mieux ! L'énergie me revient !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320404,
					"content": "C'est tout ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "C'était rapide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320408,
					"content": "Le docteur Arderne est un bon docteur. Les médicaments qu'il prescrit marchent toujours, contrairement à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320409,
					"content": "Les pierres jaune-vert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320410,
					"content": "Elles sont très suspectes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320411,
					"content": "Eh bien... On dirait que son mal de tête est guéri, mais pas la paranoïa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320412,
					"content": "Maintenant, je peux me remettre au travail ! Je vous remercie de m'avoir aidé à guérir. Prenez ces coupons en guise de cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320413,
					"content": "Restez en bonne santé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320406,
					"content": "Je ne pense pas que vous soyez malade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "Je suis vraiment malade, et le remède est vraiment efficace !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Lechlade"
				}
			]
		},
