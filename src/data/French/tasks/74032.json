				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arderne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "Vous vous sentez mal ? Ou quelqu'un d'autre se sent mal ? Vous avez l'air en bonne santé, alors j'imagine que ce n'est pas vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Effectivement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "Vous décrivez la situation de Lechlade...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Ah, c'est encore lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Y a-t-il un remède pour le guérir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "Vous parlez des maux de tête ou de sa paranoïa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Hein ? Vous voulez dire qu'il n'est pas si malade que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "À en juger par les résultats des examens précédents, je pense que non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "J'ai entendu dire qu'il avait mal diagnostiqué un patient à l'extérieur en ignorant les premiers symptômes de la maladie et... Bref, il est devenu un peu parano depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "Il a peur pour les autres, et encore plus pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "Et les pierres jaune-vert alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "Vous voyez, tout le monde est en pleine forme, sauf lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "Cela dit, je ne peux pas l'ignorer. Apportez-lui cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Mais ça... C'est de l'eau pure, n'est-ce pas ? Vous êtes sûr ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Oh, vous connaissez ce que c'est. Au moins, ce n'est pas mauvais pour la santé, et ça permettra de lui remonter le moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "Mais il ne sait pas ce que c'est ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "Pour autant que je sache, il ne touche pas à ces boissons. Je lui en ai déjà donné avant... en faisant passer ça pour une potion de santé et il se portait mieux après l'avoir bue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Bon, nous allons lui apporter ça d'abord. Si ça ne marche toujours pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "Emmenez-le à l'infirmerie pour qu'il puisse s'allonger. Dites-lui que c'est le docteur qui le dit et il obéira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#D'accord... {NICKNAME}, retournons le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Autant boire du fonta alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "Le problème, c'est que tout le monde ici connaît le goût du fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "Mais je crois qu'il n'a jamais bu d'eau pure. Après tout, elle n'est pas facile à trouver ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "Je lui en ai déjà donné avant... en faisant passer ça pour une potion de santé et il se portait mieux après l'avoir bue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
		{
			"id": 7403204,
			"completionStepIds": [
				7403204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
