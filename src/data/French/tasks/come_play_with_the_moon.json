					"nextDialogs": [
						761220403
					]
				},
				{
					"id": 761220403,
					"content": "Est-ce que je peux aller voir ça de plus près en volant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220404,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220405,
					"content": "Si cela vous fait plaisir, je pourrai vous amener à nouveau ici un autre jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220406,
					"content": "C'est ça, votre « agréable surprise » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220407,
					"content": "Oh ? C'est suffisant pour être considéré comme une « agréable surprise » à vos yeux ? Non, la vraie surprise n'est pas encore arrivée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220408
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220408,
					"content": "Ce n'est pas fini ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220409
					]
				},
				{
					"id": 761220409,
					"content": "Venez. Allons peindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220410
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220410,
					"content": "Ici ? Mais je ne vois ni toile, ni pinceaux, ni peinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220411,
					"content": "Oh, c'est simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220412
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220412,
					"content": "La surface de l'eau nous servira de toile, le clair de lune sera notre pinceau, et les chemins que nous empruntons, nos coups de pinceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220413
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220413,
					"content": "#{M#Guidés}{F#Guidées} par le reflet de la lune, la pensée pure coulera sous nos pas.",
					"roleType": "TALK_ROLE_NPC",
