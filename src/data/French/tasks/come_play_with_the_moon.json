			"dialogs": [
				{
					"id": 761220401,
					"content": "Waouh ! C'est bien l'endroit dont vous parliez, hein ? Je n'étais pas là la dernière fois, alors je n'ai pas pu le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220402
