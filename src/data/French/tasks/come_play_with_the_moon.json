			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Hein ? C'est bizarre. Je suis sûre d'avoir entendu la voix de Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "... Hyah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220104,
					"content": "Hiiii !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220106,
					"content": "Encore une frayeur ? C'est pas sympa ! Si vous étiez là, vous auriez pu le dire tout simplement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "Je me suis dit que comme vous connaissiez déjà si bien ce jeu, je devais augmenter la difficulté cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220108,
					"content": "Hmph ! Je vous attraperai la prochaine fois, vous verrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "J'ai hâte de voir ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220110,
					"content": "Que s'est-il passé avec votre masque, Columbina ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Oh. Je suppose que les kuuhenkis ont dû me le prendre pendant qu'on jouait tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220112,
					"content": "Je n'ai pas vraiment besoin d'utiliser mes yeux, alors le masque ne me dérange pas. Qu'elles s'amusent avec si elles le souhaitent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220113,
					"content": "Oh ! D'ailleurs, vous ne voudriez pas sortir plus souvent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Vous n'avez plus besoin de vous cacher de qui que ce soit, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Oui... J'ai tout le temps de le faire maintenant. Je peux aller où je veux, quand je veux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220116,
					"content": "C'est juste que je crains que vous ne vous inquiétiez si vous veniez me voir et que vous découvriez que j'étais partie sans dire au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220117,
					"content": "Dans ce genre de situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Oui ! On veut juste savoir si vous allez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Je comprends. J'y réfléchirai, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220121,
					"content": "Vous ne ferez qu'y réfléchir...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Ou peut-être que c'est simplement ici que vous voulez être.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Tout ce qui s'est passé ici... sont des souvenirs heureux pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220124,
					"content": "#Cela dit, j'ai une autre raison de vous avoir {M#attendus}{F#attendues} ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220125,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Pour vous faire une agréable surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220118,
					"content": "Vous pouvez tout simplement laisser un mot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
