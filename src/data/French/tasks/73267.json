					"Karima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Monsieur Atiyah ! Est-ce que vous recrutez encore, chez les Érémites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670602,
					"content": "Ayten ? Que fais-tu là ? Tu as prévenu ta maman ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670603,
					"content": "Oui, bien sûr ! Ma maman travaille, alors je joue avec Karima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670604,
					"content": "Bonjour monsieur Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670605,
					"content": "Monsieur Atiyah, avez-vous réfléchi à ce que je vous ai dit la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670606,
					"content": "Je m'entraîne tout le temps, parfois avec Karima... Je courrai bientôt plus vite qu'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670607,
					"content": "Tu cours plus vite que qui ? La dernière fois, c'était parce que je n'avais pas bien mangé, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670608,
					"content": "En tout cas, ça fait longtemps que je m'entraîne en suivant le programme que vous m'avez fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670609,
					"content": "Monsieur Atiyah, laissez-moi participer à l'épreuve pour rejoindre les Érémites !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670610,
					"content": "C'est d'elle dont vous parliez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Ahem... D'accord ! Ayten, en tant que membre des Érémites, je te permets de retenter ta chance à notre épreuve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670613,
					"content": "Génial ! Karima, toi aussi, participes-y ! On va donner tout ce qu'on a !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670614,
					"content": "Je n'ai pas d'envie de rejoindre les Érémites. Je veux seulement rester au village pour protéger tout le monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670615,
					"content": "Mais bon... Ça ne peut pas faire de mal si monsieur Atiyah teste mes compétences. J'ai quand même demandé à Candace de m'apprendre à m'entraîner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670616,
					"content": "Hein ? Quand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670617,
					"content": "Hahaha, vous êtes énergiques, c'est très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670618,
					"content": "Allez, Ayten, ne fais pas cette tête ! À l'occasion, je t'emmènerai voir Dehya pour qu'elle t'apprenne à t'entraîner, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670619,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670620,
					"content": "Les Érémites n'ont qu'une parole, tu sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670621,
					"content": "#Toutefois, avant de commencer notre épreuve aujourd'hui, demandons {M#au voyageur}{F#à la voyageuse} de nous faire une démonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670622,
					"content": "#Qu'est-ce que j'ai à voir avec tout ça{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "#Je n'ai jamais eu l'occasion de faire de démonstration auparavant. Je ne pouvais pas courir partout et laisser ces enfants seules ici, c'est trop dangereux... J'espère donc que vous pourrez m'aider, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670626,
					"content": "#Ahem. {M#Ce voyageur est un grand aventurier}{F#Cette voyageuse est une grande aventurière}. Il m'a fallu beaucoup d'efforts pour l'inviter à vous faire une démonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670627,
					"content": "Ayten, Karima, soyez attentives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670628,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670629,
					"content": "#{M#Un aventurier}{F#Une aventurière}... Comme ceux qui font partie de la Guilde des aventuriers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670630,
					"content": "Que l'on soit mercenaire ou garde du village, quand on part en mission, il y a toujours un moment où l'on se retrouve obligé de battre en retraite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670631,
					"content": "Dans ce genre de situation, il faut généralement... courir le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670632,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, commencez par nous montrer... Hmm... Comment rapidement battre en retraite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670633,
					"content": "Voilà le point de départ, c'est à vous de jouer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670624,
					"content": "Vous n'avez jamais fait de démonstration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "Il fallait que je surveille ces enfants, donc ce n'était pas possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670634,
					"content": "#... En tout cas, je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670611,
					"content": "La personne qui veut vous rejoindre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
		{
			"id": 7326708,
			"completionStepIds": [
				7326708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
