					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670802,
					"content": "Ouah... Quelle vitesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670803,
					"content": "Excellent ! Un pas de course à la fois rapide et stable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670804,
					"content": "Ayten, Karima, gardez bien ça en mémoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670805,
					"content": "En cas de danger, n'essayez jamais de jouer les héroïnes. Si c'est nécessaire, il faut absolument battre en retraite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670806,
					"content": "Surtout toi, Ayten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670807,
					"content": "Compris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670808,
					"content": "Bon, ensuite... On va aller à l'extérieur du village pour que vous puissiez voir comment se passe un combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670809,
					"content": "Trop cool ! Je vais prendre l'épée en bois que mon père m'a fabriquée. Et toi, Karima ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670810,
					"content": "Moi, j'ai un petit arc, mais... ma maman ne m'autorise qu'à utiliser des flèches sans pointe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670811,
					"content": "Hahaha ! Ce n'est pas grave, vous avez un arc, une épée et aussi un grand courage. Ça sera suffisant pour se lancer dans une aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670812,
					"content": "#Par contre, quand on sera à l'extérieur du village, vous ne devrez pas vous éloigner {M#du voyageur}{F#de la voyageuse} et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670813,
					"content": "Vous voulez vraiment les emmener hors du village ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "Ne vous inquiétez pas. Je suis déjà allé là-bas. Il n'y a que des scorpions malades. Ils savent à peine attaquer, tout ira bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670816,
					"content": "Et puis on sera présents, vous et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670817,
					"content": "Qu'est-ce qui vous fait croire que je vais venir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "#Au point où nous en sommes, soyez {M#gentil}{F#gentille} jusqu'au bout, {M#voyageur}{F#voyageuse}. Je vous offrirai une récompense comme le veut le code des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670820,
					"content": "Les enfants, préparez-vous ! On y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670821,
					"content": "Youhou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670822,
					"content": "Euh... Je suis stressée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670818,
					"content": "Vous ai-je promis quelque chose ?",
