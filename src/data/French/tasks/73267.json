			"dialogs": [
				{
					"id": 732671001,
					"content": "Bouhou... Ces scorpions... Ils sont énormes... J'ai peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Je les ai touchés avec mes flèches, alors pourquoi ça ne leur fait rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "Alors que vous... Comment vous avez fait pour les battre aussi facilement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "#Je me suis beaucoup {M#entraîné}{F#entraînée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Bouhou... Candace a pourtant dit que j'avais fait des progrès...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Karima, ne sois pas triste. Continue de bien t'entraîner, et un jour, toi aussi, tu deviendras très forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Toi aussi, Ayten, si tu continues à faire de l'exercice comme ça, tu pourras rejoindre les Érémites un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Hmm, si j'arrive à demander à Dehya de m'apprendre le combat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "La prochaine fois que je verrai Candace, je lui demanderai de m'apprendre de nouveaux trucs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "Ces deux petites... Elles ne manquent pas d'entrain, hahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "Au bout du compte, vous n'avez toujours recruté personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "Hum... Hum... Ne parlons pas de choses qui fâchent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "Oubliez mon travail... Et puis j'ai quand même obtenu des résultats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Beaucoup de jeunes hommes et femmes ont quitté le village pour voir le monde extérieur après m'avoir entendu faire de la publicité... Même s'ils ne voulaient pas vraiment se joindre à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Bon, n'en parlons plus. Je dois ramener ces deux enfants chez elles. Leurs parents doivent être inquiets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "#{M#Voyageur}{F#Voyageuse}, voici votre récompense pour m'avoir accompagné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "*soupir* Je vais retourner chez les Érémites pour faire un rapport sur ma mission tout à l'heure. Qu'est-ce que je vais pouvoir leur dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Au fait, monsieur Atiyah, on n'a toujours pas fait l'épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "Ah ? Oui... C'est vrai. Rentrons au village, on commencera l'épreuve là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "Comment allez-vous faire pour votre travail ?",
