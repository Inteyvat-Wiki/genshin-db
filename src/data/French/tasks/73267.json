				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sania",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "C'est un peu inquiétant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "Bonjour Sania ! Qu'êtes-vous en train d'acheter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Atiyah... Je vous ai déjà dit que Jabari n'était pas intéressé par les Érémites. Et puis je ne veux pas qu'il devienne mercenaire, alors n'essayez pas de me demander de le convaincre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Quel dommage, Jabari est un excellent cuisinier et il pourrait obtenir un bon poste chez les Érémites. Vous auriez un plus grand revenu pour votre famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "Et puis n'a-t-il pas dit lui-même qu'il voulait trouver du travail ? Si c'est vraiment ce qu'il veut, c'est idéal d'avoir quelqu'un comme moi qu'il connaît pour lui en recommander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "Il ne faut pas le croire. Il dit ça de temps en temps, mais il regrette toujours quelques jours plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "Au bout du compte, il ne veut pas me laisser seule au village... Et moi, je ne veux pas qu'il parte au loin pour gagner sa vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "Sans compter que les mercenaires sont tout le temps en train de risquer leurs vies ! Alors, laissez tomber. Même si Jabari veut y aller, je l'en empêcherai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Voilà, c'est tout ce que j'ai à vous dire. Je dois faire mes courses, alors allez voir quelqu'un d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "#Pff... D'accord. Vous voyez, {M#voyageur}{F#voyageuse}, c'est comme ça que se déroule mon travail au quotidien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Ensuite, allons voir Fodil... C'était un des nôtres autrefois, mais il nous a quittés par la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Ce serait génial d'arriver à le persuader de revenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fodil",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah, encore toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670502,
					"content": "Héhé, la persévérance est une qualité des Érémites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "Dans ce cas, tu devrais savoir que je m'en tiens toujours à mes principes quoi que je fasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670504,
					"content": "Fodil, mon frère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Ne m'appelle pas comme ça, je ne fais plus partie des Érémites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670506,
					"content": "*soupir* Monsieur Fodil. Tu ne veux vraiment pas revenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "C'est vrai que certains de nos frères sont... Euh... Un peu aventureux, mais il y en a tout de même beaucoup qui respectent les règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Atiyah, je t'ai déjà dit que je ne reviendrai pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670509,
					"content": "Tu n'as pas besoin de me dire tout ça, j'ai déjà pu constater ces choses-là de mes propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670510,
					"content": "Les Érémites ne négligent peut-être pas toutes les règles et peut-être bien qu'ils n'aiment pas tous tirer profit des malheurs d'autrui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670511,
					"content": "Mais Atiyah... Les mauvais comportements se transmettent. Si un membre ne respecte pas les règles, les personnes qui l'entourent seront influencées par ce dernier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670522,
					"content": "Une personne influence un groupe, et si ce groupe continue d'agir comme ça, il influence encore plus de personnes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670523,
					"content": "Atiyah, tu le sais mieux que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670512,
					"content": "Dans un tel environnement... Les mauvais comportements sont monnaie courante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Tu voudrais que je revienne, tandis que moi, je voudrais que tu les quittes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670515,
					"content": "Peut-être qu'à tes yeux, les Érémites ne sont pas détestables, même si leur morale laisse à désirer... Mais on ne peut vivre toute sa vie dans l'ambiguïté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670516,
					"content": "Je ne fais que te dire ce que j'en pense. C'est à toi de prendre tes propres décisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670517,
					"content": "Je sais, Fodil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "Bien. Si tu les quittes... Je pourrai t'aider à gagner ta vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "Est-ce que ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Hahaha, Fodil est impossible à convaincre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "Ensuite... Haha, rentrons donc nous reposer. Ma gorge me fait mal à force de trop parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326706,
			"completionStepIds": [
				7326706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
