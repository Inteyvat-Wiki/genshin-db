			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "#Rejoignez les Érémites et vivez la belle vie ! {M#Cher ami}{F#Chère amie}, aimeriez-vous en apprendre plus sur les Érémites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Euh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Hum, écoutez-moi. Les Érémites sont un groupe idéal dans lequel règne la liberté, la solidarité et l'amitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "En plus de ça, il est possible de rafler l'argent de ces gens perchés dans leur arbre. Les chercheurs de l'Académie sont très riches et sont de bons payeurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Je suis déjà membre de la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Euh... La Guilde des aventuriers... Alors... Ce n'est pas un problème ! De nos jours, qui n'a pas plusieurs boulots, hein ? Et puis être aventurier, c'est à peu près pareil qu'être mercenaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Non, pas du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "*soupir* On mange très bien en plus de ça, et on a même de la viande et du poisson de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "Et puis si vous avez de la chance, vous pourrez même parler à Dehya, la crinière ardente ! Je... *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Buvez un peu d'eau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "Eh bien... Euh... Désolé, je me suis un peu emballé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "C'est que ce n'est pas tous les jours que quelqu'un veut bien m'écouter... Alors, je me suis un peu laissé aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "Vous n'avez pas vraiment envie de rejoindre les Érémites, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "Non, pas pour le moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "Eh bien, si vous le dites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "Vous restez toujours ici pour recruter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Oui, c'est mon travail. On manque de gens partout de nos jours et les mercenaires ne font pas exception, bien au contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "Arf, entre nous... Les Érémites comptent beaucoup de membres, vous savez, mais le travail de mercenaire est vraiment dangereux. L'escorte de caravanes marchandes passe encore, c'est juste fatigant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Mais lorsqu'il s'agit de missions liées aux chercheurs... Il y a toujours une épée de Damoclès au-dessus de nos têtes, et on remercie les cieux chaque fois qu'on rentre en un seul morceau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "Après ce genre de mission, les gars doivent se reposer pendant au moins deux semaines. Pendant ce temps, il faut des gens pour les remplacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Dans un pays aussi grand que Sumeru, les chercheurs sont nombreux et il y a de nouvelles missions tous les jours. Alors, on n'a presque jamais fini de travailler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "On ne pourra pas tenir si on n'arrive pas à recruter de nouveaux effectifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "Avez-vous réussi à recruter quelqu'un ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "Dans ce village ? Haha... Non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Enfin... Pour être exact, les personnes que je veux recruter ne veulent pas nous rejoindre, et ceux qui veulent nous rejoindre ne correspondent pas à nos critères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "Si vous ne me croyez pas, baladez-vous avec moi un instant... Qui sait, vous aurez peut-être envie de nous rejoindre après cette balade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "Haha, je plaisante. Je ne vais pas insister, je sais que vous ne voulez pas. C'est juste que je n'ai pas envie de me promener seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "D'accord, je vous accompagne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Héhé, merci. Voyons voir... Allons d'abord chercher Sania, elle devrait être libre la journée. Le soir, elle est toujours en train d'avoir de grandes discussions sur la vie avec Jabari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "J'ai déjà suffisamment à faire avec la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Vous avez bien répété votre discours...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "J'ai déjà beaucoup de missions à faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
