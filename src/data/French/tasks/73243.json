			"dialogs": [
				{
					"id": 732431901,
					"content": "« ... Résultats de l'enquête sur Zandik... Dastur... Cause du décès... Meurtre possible... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431902,
					"content": "« ... Zandik... Suite à son expulsion... L'éléazar... Mais les preuves manquent... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431903,
					"content": "« ... Les archives ont soudainement disparu... Année inconnue... Début de la propagation de l'éléazar... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431904,
					"content": "« ... Avant sa disparition... La légende de Varuna... Obsédé par... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431905,
					"content": "[Le contenu suivant a été complètement raturé jusqu'à être totalement illisible.]",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
