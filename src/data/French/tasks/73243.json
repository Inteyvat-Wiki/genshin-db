					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "« Ce n'est qu'après avoir lu le journal des étoiles du grand sage Tabari que j'ai finalement réalisé : qu'il s'agisse de la guerre entre les Archons ou de la chute d'anciens empires, tout n'est que le reflet du mouvement des étoiles. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432002,
					"content": "« Le ciel étoilé au-dessus de nous est la seule chose qui soit éternelle. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432003,
					"content": "« Euh... Mettons de côté la composante émotionnelle que vous ajoutez à une étude supposément sérieuse, j'aimerais vous demander si tous les travaux du Rtawahist consistent à expliquer tous les événements anciens avec une conclusion unique ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432004,
					"content": "« Il serait bien que vous examiniez les choses du point de vue de l'histoire au lieu de regarder les étoiles en bredouillant. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432005,
					"content": "« Vous n'y connaissez rien ! Cela s'appelle explorer les lois de l'univers ! Pas étonnant qu'on dise que vous êtes tous des rats de bibliothèque, au Vahumana. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
				7324310
