			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "« J'ai beau vouer une confiance totale envers le jugement des sages et des tuteurs, je me demande si l'Académie ne se fie pas trop à l'Akasha de nos jours ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432202,
					"content": "« Il est évident que les capacités académiques des chercheurs itinérants que nous avons envoyés se sont dégradées une fois qu'ils se sont habitués à utiliser l'Akasha pour obtenir des connaissances. Je pense qu'il est nécessaire de restreindre l'accès à l'Akasha pour les nouveaux étudiants via des décrets. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432203,
					"content": "« Comment pouvez-vous dire une telle chose ? Ne savez-vous pas que les darshans qui se sont cachés dans le désert et n'ont pas pu recevoir les enseignements de l'Akasha sont tombés dans l'ignorance et le fanatisme, au point d'en avoir recours à l'ingestion de serpents venimeux et vivants pour acquérir la sagesse ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432204,
					"content": "« Les gens ne parviennent pas à reconnaître que c'est l'Akasha qui nous permet de nous assurer que nos connaissances sont pures. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
