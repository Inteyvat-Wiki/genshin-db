			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "« En tant qu'étudiant étranger, je ressens la grandeur de l'Archon Dendro un peu plus chaque jour où j'étudie à l'Académie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432102,
					"content": "« À Mondstadt, il fallait fouiller dans une dizaine de livres avant de pouvoir obtenir une multitude de réponses différentes à une simple question. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432103,
					"content": "« Mais avec le terminal akashien, on peut obtenir des informations pertinentes rien qu'en pensant à des choses spécifiques. Pour moi, il n'y a pas de meilleure création au monde que l'Akasha. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324322,
			"completionStepIds": [
				7324312
			],
