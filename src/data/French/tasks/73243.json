			"dialogs": [
				{
					"id": 732432401,
					"content": "« Ce tableau d'affichage est réservé pour la communication interne de l'Académie. Il est formellement interdit de répandre des informations fausses et non autorisées. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732432402,
