	"talks": [
		{
			"id": 7324301,
			"completionStepIds": [
				7324301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324301",
							"2"
						],
						"stepId": 7324301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Toutes les notifications de l'Académie et les décrets ont été déplacées dans l'Akasha. Ce tableau d'affichage est désormais réservé aux communications extrascolaires entre les professeurs et les étudiants. Il est interdit à toute personne extérieure à l'Académie d'y laisser un message !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "« Pour une atmosphère académique plus détendue, de meilleurs échanges académiques et pour que chacun puisse rédiger ses thèses avec le sourire ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430202,
					"content": "« Nous soutenons Vikram comme prochain grand archiviste ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430203,
					"content": "« Nous vous invitons à rejoindre l'Amicale de Vikram. Ensemble, nous assisterons à l'ascension d'un grand archiviste jeune, intéressant et proche de la population. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "« N'oubliez jamais les trois vertus et les six péchés de l'Académie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430302,
					"content": "« L'admonestation, l'ingénuité et l'usage. Ce sont trois vertus auxquelles tous les chercheurs doivent aspirer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430303,
					"content": "« Depuis des décennies, Rifaet pratique constamment ces trois vertus sans discontinuer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430304,
					"content": "« La Société des lecteurs de Fravashi vous accueille pour marcher aux côtés de la sagesse et du futur grand archiviste. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "« À tous les membres de la Société des lecteurs de Fravashi, je vous salue pour votre poursuite des vertus. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430402,
					"content": "« Mais j'ai entendu dire que plus de la moitié des thèses de Rifaet ont été rédigées par des prête-plume. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430403,
					"content": "« C'est pourquoi il reste si discret malgré ses nombreuses réalisations académiques. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430404,
					"content": "« Certes, à la différence des thèses, on n'a pas besoin de développer une argumentation détaillée sur un tableau d'affichage. Mais ce n'est pas non plus une raison pour lancer des attaques malveillantes sur autrui. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430405,
					"content": "« Je pense que ces messages ont tout simplement été laissés par des jaloux ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430406,
					"content": "« D'autre part, j'ai entendu dire que Vikram avait conquis le cœur de nombreuses filles grâce à son éloquence. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430407,
					"content": "« Ces filles ne savent même pas qu'il est marié. Alors ? Vous aussi, vous êtes jaloux de sa popularité ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430408,
					"content": "« Les attaques infondées et malveillantes contre les chercheurs de l'Académie sont interdites. Si cela se reproduit, les matras enquêteront sur la source de ces rumeurs. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "« Ce tableau d'affichage ne fait pas encore partie du système d'accès de l'Akasha et peut être directement consulté sans ce dernier. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430502,
					"content": "« Nous prions à tout le monde d'être davantage vigilant en ce qui concerne la sécurité des ressources intellectuelles. Tout échange de ressources intellectuelles en dehors du domaine de la communication publique est strictement interdit sur ce tableau d'affichage. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "« Nous tenons à rappeler aux étudiants qu'ils se doivent de respecter scrupuleusement le code de conduite de l'Académie même en dehors de l'établissement. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430602,
					"content": "« La gestion centralisée des connaissances est la pierre angulaire de la nation de la sagesse. Ne gâchez pas le privilège qu'est celui de pouvoir étudier à l'Académie en commettant une erreur par accident. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "« Plusieurs cas de contrebande de concentrés de connaissances ont eu lieu récemment. Des informations détaillées seront communiquées à travers l'Akash aux professeurs et aux étudiants des écoles concernées avant le prochain Jour de Jnagarbha une fois l'enquête terminée. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430702,
					"content": "« Les tuteurs sont encouragés à renforcer leur communication avec les étudiants afin de soulager le stress causé par la rédaction de thèses et d'éviter qu'ils ne prennent des risques. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "« Si vous voulez mon avis, L'Académie n'est pas assez radicale dans sa promotion de l'Akasha, elle est trop conservatrice. Le travail de la plupart des mahamatas est redondant et inefficace, et à certains égards, il est même pire qu'avant. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430802,
					"content": "« Imaginez un peu, si nous pouvions assigner des tâches directement à travers l'Akasha, et aussi le laisser gérer les transactions de l'Échange Kalimi... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430803,
					"content": "« Quand cela sera possible, nous pourrons remercier au moins la moitié des mahamatas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430804,
					"content": "« Vous avez raison. Je pense donc que c'est pour ça qu'on ne le fait pas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "« Comme nous le savons tous, c'est le devoir des chercheurs que d'explorer la connaissance en profondeur. Cependant, aujourd'hui, l'Académie est beaucoup trop impliquée dans l'administration. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430902,
					"content": "« De nos jours, après avoir terminé leurs études, de nombreux étudiants sont obligés d'interrompre leurs recherches à la hâte et sont envoyés en mission à l'extérieur pour travailler en tant que mahamatas. Ne croyez-vous pas que cela est une déviation du but initial de l'Académie ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430903,
					"content": "« N'a-t-on pas déjà depuis longtemps tiré de conclusions sur cette question dans l'Akasha ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732430904,
					"content": "« Alors que les gens se cloîtrent dans leurs superstitions, nous sommes les seuls à être les plus proches de la vérité. Comment pouvons-nous nous décharger du devoir d'éclairer le monde ? Si nous ne faisons rien, Sumeru sombrera dans le chaos ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "« En tant qu'étudiant étranger, je ressens la grandeur de la Molrani Rukkhadevata un peu plus chaque jour où j'étudie à l'Académie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431002,
					"content": "« À Mondstadt, il fallait fouiller dans une dizaine de livres avant de pouvoir obtenir une multitude de réponses différentes à une simple question. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431003,
					"content": "« Mais avec le terminal akashien, on peut obtenir des informations pertinentes rien qu'en pensant à des choses spécifiques. Pour moi, il n'y a pas de meilleure création au monde que l'Akasha. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "« Depuis l'époque de Pir Kavikavus, l'Académie n'a jamais augmenté les fonds annuels alloués au Kshahrewar. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431102,
					"content": "« Les gens d'en haut se contentent de dire qu'un contrôle strict du développement et de la promotion des technologies mécaniques est nécessaire pour assurer une vie stable et paisible. Si on suit cette logique, ils pourraient aussi bien fermer l'Akasha. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431103,
					"content": "« Si ce n'était pas grâce à l'investissement à long terme d'hommes d'affaires ingénieux comme le seigneur Sangemah Bay, le Kshahrewar aurait disparu depuis longtemps ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "« J'ai beau vouer une confiance totale envers le jugement des sages et des tuteurs, je me demande si l'Académie ne se fie pas trop à l'Akasha de nos jours ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431202,
					"content": "« Il est évident que les capacités académiques des chercheurs itinérants que nous avons envoyés se sont dégradées une fois qu'ils se sont habitués à utiliser l'Akasha pour obtenir des connaissances. Je pense qu'il est nécessaire de restreindre l'accès à l'Akasha pour les nouveaux étudiants via des décrets. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431203,
					"content": "« Comment pouvez-vous dire une telle chose ? Ne savez-vous pas que les darshans qui se sont cachés dans le désert et n'ont pas pu recevoir les enseignements de l'Akasha sont tombés dans l'ignorance et le fanatisme, au point d'en avoir recours à l'ingestion de serpents venimeux et vivants pour acquérir la sagesse ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431204,
					"content": "« Outre la Molrani Rukkhadevata, c'est précisément l'Akasha qui nous permet de nous assurer que nos connaissances sont pures. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "La conférence sur la botanique de cette semaine, présentée par le brigadier forestier Tighnari, aura lieu au Pardis Dhyai comme d'habitude. L'inscription est ouverte à tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431302,
					"content": "Tous ceux qui s'intéressent aux plantes sont les bienvenus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431303,
					"content": "Désolé, en raison d'un trop grand nombre d'inscriptions à cette conférence, l'Académie a décidé de limiter la participation aux étudiants de l'Amu{RUBY#[S]Biologie}rta et aux gardes forestiers afin de faciliter la gestion des connaissances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "« Quelqu'un a-t-il lu le dernier roman publié par la Chambre Yae ? C'est un auteur sumérien qui l'a écrit, il s'appelle... Pursina, quelque chose comme ça. C'est visiblement un membre de l'Amurta. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431402,
					"content": "« Si seulement je pouvais être de l'Amurta, je pourrais faire du tourisme tous les jours et j'aurais le temps d'écrire des romans. Mais non, je suis à l'Haravatat, où je passe mon temps à lire des documents et à écrire des thèses, sans avoir aucune occasion d'explorer le monde extérieur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431403,
					"content": "« Quoi ? Quelqu'un a publié un roman à la Chambre Yae avant moi ? Ma crédibilité en tant qu'auteur de romans légers va en prendre un coup... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "« Sans surprise, le commerce tel qu'il est décrit dans les livres n'a rien à voir avec la réalité. Si seulement j'étais resté au Grand bazar pour faire des affaires... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431502,
					"content": "« Voyez où ça m'a mené : je n'arrive pas à écrire ma thèse et je n'ai plus d'argent. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431503,
					"content": "« Si ça continue, je vais devoir abandonner mes études et rejoindre les Érémites. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "« Je n'ai rien contre les gens du désert, mais je pense que le poste de général mahamatra doit être occupé par un chercheur renommé et respecté. Les questions académiques ne peuvent être résolues par la force. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431602,
					"content": "« Euh... C'est toujours bien mieux que lorsque vous, le Rtawahist, étiez en fonction. Au moins, aucune école n'est favorisée. Vous pensez vraiment que personne ne connaît la vérité derrière les rapports que vous avez publiés ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431603,
					"content": "« Hé, toi, du Kshahrewar ! Tu ferais mieux d'avoir des preuves, ou je vais en parler aux matras. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "« Accepter l'inscription des étrangers à l'Académie, soit, mais maintenant même l'Akasha leur est accessible... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431702,
					"content": "« Est-on sûrs que les idées des étrangers ne vont pas affecter l'Akasha ? De plus, cela va inévitablement entraîner une fuite de connaissances et on ignore l'ampleur des conséquences que cela aura sur le commerce extérieur de Sumeru. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431703,
					"content": "« C'est rare de voir des chercheurs se préoccuper de l'économie... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431704,
					"content": "« C'est bien pour ça que les gens de l'Haravatat comme vous êtes connus pour ne pas savoir comment notre monde fonctionne. Si je ne voulais pas apprendre à fabriquer un meilleur enduit à peinture, je ne serais jamais venu à l'Académie ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "« Ça fait longtemps que je n'ai pas vu ce nabot du désert. On dirait qu'on peut se détendre un peu. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431802,
					"content": "« Je me demande ce qui est arrivé aux matras pour qu'ils m'aient empêché de réussir mon examen le semestre dernier. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431803,
					"content": "« Si je me souviens bien, il suffit juste de se présenter à l'examen pour réussir. Tu ne peux t'en prendre qu'à toi-même si tu n'es pas sérieux dans tes études. Et même si les matras manquent de gens ces derniers temps, fais attention à ce que tu dis, cela pourrait t'attirer des problèmes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431804,
					"content": "« Les matras ? Ne m'en parle pas, c'est simplement des gens d'en haut qui se prennent pour ce qu'ils ne sont pas. Tiens ? Je viens de recevoir un message de l'Akasha... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Tableau de messages"
				},
				{
					"id": 732431805,
					"content": "« On dirait qu'il va falloir faire attention à ce qu'on dit ici... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tableau de messages"
				}
			]
		},
