				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "Merci pour vos efforts. Bien que l'île soit toujours pleine de dangers, cela donnera un peu d'espoir à tous ceux qui sont partis et qui désirent revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Même si... Maintenant que la pluie s'est arrêtée, il est possible que la guerre pour conquérir l'île devienne plus féroce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Mais personne n'allait jamais aider à résoudre la situation sur l'île de toute façon. Ce que nous avons fait est au moins mieux que de laisser le problème s'envenimer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Tenez, le cadeau que je vous ai promis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Il s'agit de la célèbre lance utilisée autrefois par les préfets de Yashiori. Par contre, je ne sais pas si ce plan vous sera utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Mais si vous le donnez à un forgeron qualifié, il devrait être capable de recréer la gloire qu'elle avait autrefois entre les mains du seigneur Kitain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*soupir* Hélas, l'âge des héros est révolu, et Kitain, qui a autrefois détruit tant de maux, ne reviendra plus jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Pourtant, nous semblons aujourd'hui avoir fait un pas de plus vers les actes du seigneur Kitain, grâce à votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Je vais ensuite me rendre chez mes amis de l'armée du Shogunat pour voir si je peux aider. J'espère vous revoir un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
