					}
				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Quelle belle coïncidence. Vous ne trouvez pas, cher Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Où sont passées mes manières ? Je me présente : je suis Sonny, on me connaît aussi sous le nom de « Gant blanc ». Voici mon ami Luca le pêcheur. Il est connu dans certains cercles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "Bonjour ! Je m'appelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Je sais déjà. Vous êtes Paimon et {M#ce jeune homme blond}{F#cette jeune femme blonde} s'appelle {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Hein ? Vous nous connaissez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "Et comment ! Avant aujourd'hui, je vous connaissais comme le juge suprême de Fontaine. Enfin, je veux dire que je vous connaissais, mais que vous ne me connaissiez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "#Votre renommée et vos exploits vous précèdent. C'est naturel d'avoir entendu parler de vous dès que vous êtes {M#arrivés}{F#arrivées} à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "Je ne savais pas qu'on était si célèbres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Vous êtes si modestes ! Comment vous expliquer ça... Disons que votre arrivée ici a fait l'effet d'une bombe qui aurait explosé sur la scène de l'Opéra Épiclèse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "En positif, évidemment ! N'êtes-vous pas d'accord, cher Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Euh, mais votre métaphore de bombe est tout sauf positive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Hm, je ne suis pas très habile pour m'exprimer. Comment l'auriez-vous dit, Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Le spectacle de magie de Lyney et Lynette. Bombe, public qui prend les jambes à son cou, c'était une nouvelle foudroyante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "Exactement ! Vous voyez, je n'y aurais jamais pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "Si vous le dites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Pourquoi les gens vous appellent « Gant blanc » ? Vous n'avez pas l'air d'en avoir un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Oh, c'est une question difficile. Comment vous expliquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Imaginez que vous portez un gant blanc. Il serait taché si quelque chose de sale venait se déposer sur votre main. Mon devoir... est de trouver cette saleté et de l'éradiquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Euh, du coup, vous êtes un genre de nettoyeur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "C'est ça, chère Paimon ! Je n'ai jamais été capable de résumer la nature de mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "C'est grâce à vous que les rues de la Cour de Fontaine sont toujours aussi propres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Hahaha ! Je suis ravi de l'entendre ! Vous pouvez le voir comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "D'accord, j'ai compris... Mais pourquoi auriez-vous besoin d'un poignard pour travailler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Considérez-le comme un outil qui m'est utile quand il y a une tache particulièrement difficile à nettoyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Je vois, merci pour l'explication ! Et votre ami Luca est appelé « le pêcheur » parce qu'il attrape beaucoup de poissons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Hmm, c'est en partie vrai. Vous savez, il y a beaucoup de poissons différents à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "Luca est très doué pour enseigner aux gens comment passer des bons moments avec toutes les sortes de poissons. Pas vrai, cher Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "Hein ? Je ne comprends pas trop... Mais alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Ah là là, je dois dire que vous avez un talent pour poser les questions les plus difficiles à répondre. J'aimerais bien avoir une conversation avec vous et pouvoir tout vous dire en détail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, ce n'est pas grave de ne pas savoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Hein ? Bon, d'accord... Vous vouliez nous demander quelque chose, Sonny et Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Vous voyez, nous sommes extrêmement intrigués par la plongée sous-marine. Les eaux de Fontaine regorgent de trésors inestimables de la nature et de nos ancêtres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Nos amis d'ici nous ont dit que vous aviez rencontré quelqu'un et que vous avez même plongé avec lui. De plus, vous n'aviez même pas besoin d'équipement ! Pas vrai, Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Vous voulez nous parler de Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgil... Cet escroc ! Ahh, je suis en colère rien que de penser à lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Vous racontez votre expérience avec Virgil à Sonny le gant blanc et Luca le pêcheur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "... Je vois. Merci de nous avoir tout raconté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Je vous en prie ! Je n'oublierai jamais ce qu'il nous a fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "Bien entendu, nous sommes très reconnaissants que vous ayez partagé cette histoire avec nous. Cependant, en ce qui me concerne, je suis soulagé de constater que vous n'avez pas l'air de porter Virgil dans votre cœur. Si ce n'était pas le cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "#Hmm, disons que s'il avait été votre ami, les choses auraient été délicates entre nous. Pas vrai, cher Luca{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "Probablement... On n'aurait pas fait le poids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Je suis tout à fait d'accord. Que les Archons soient loués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Qu'est-ce que vous racontez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Ce sont les ennemis de Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Ahh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Vos paroles me blessent, {M#bon monsieur}{F#belle demoiselle}. Je n'ai pas un seul ennemi, que des amis. Virgil est l'un d'entre eux, et en parlant de lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#C'est l'heure d'aller le voir pour avoir une « discussion{NON_BREAK_SPACE}» sérieuse. Vous voyez sûrement de quoi je veux parler, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "#Bien sûr, nous lui ferons aussi payer pour ce qu'il vous a fait. C'est le moins que l'on puisse faire pour nos honorables {M#invités}{F#invitées}, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Euh, je suis un peu perdue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "C'est le gant blanc. Tu n'as pas besoin d'en savoir plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "D'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Nous avons trouvé le repaire de Virgil et de ses amis. Que diriez-vous d'aller le saluer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Pourquoi devrait-on vous accompagner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#Mon bon monsieur}{F#Ma belle dame} ! Avec tout le mal que Virgil vous a fait, il serait discourtois de... De ne pas vous informer de nos plans en amont.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "Vous voyez, Luca est du même avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Hmph, j'ai envie de parler à Virgil moi aussi ! Il nous doit des excuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Hahaha, vous êtes bien gentille. Retrouvons-nous là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "D'accord, allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Ce n'est pas grave si tu ne comprends pas, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#La vie peut devenir extrêmement ennuyeuse quand on sait tout dans ce monde. N'est-ce pas, {M#mon bon monsieur}{F#ma belle dame} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "On peut vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
