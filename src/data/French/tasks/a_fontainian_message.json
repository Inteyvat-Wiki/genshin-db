			"dialogs": [
				{
					"id": 740090201,
					"content": "#Chère Paimon et {M#mon bon}{F#ma belle} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090202,
					"content": "Virgil utilise cet endroit comme repaire ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Sérieux, pourquoi Virgil n'est pas encore revenu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Personne à l'allure douteuse"
				},
				{
					"id": 740090204,
					"content": "S'il nous fait encore attendre, je n'arriverai pas à résister... Je vais boire cette cargaison de sinthe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Personne à l'allure dangereuse"
				},
				{
					"id": 740090205,
					"content": "Arrête de faire n'importe quoi ! On a fait des pieds et des mains pour l'obtenir. Virgil n'aura aucune pitié pour toi si tu te sers sans son autorisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Personne à l'allure peu scrupuleuse"
				},
				{
					"id": 740090206,
					"content": "Quel dommage, on dirait que notre ami Virgil n'est pas encore de retour. Par contre, nous pouvons toujours discuter avec ces gars-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Euh, je ne sais pas s'ils auront envie de nous parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "#Nous pouvons les persuader. Qu'en pensez-vous, Luca{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "Hé ! Vous en êtes sûrs ? Je pense qu'ils vont vouloir vous taper, moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Oh, c'est gentil de penser à notre sécurité, chère Paimon. Ce serait malheureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "... Pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		},
