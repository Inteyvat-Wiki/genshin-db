				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740090401,
					"content": "#Bon, mon cher Virgil... Vous savez que vous nous avez mis dans de beaux draps. Qu'allons-nous faire de vous{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090402
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090402,
					"content": "D—Désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090403
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090403,
					"content": "Ah là là, je crains que cela ne fasse pas l'affaire. Vous savez très bien que le temps passe très vite, et qu'il est déjà trop tard pour regretter maintenant. Notre organisation possède sa propre loi dont l'une des plus importantes règles est de ne pas initier certaines entreprises commerciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090404
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090404,
					"content": "Mais monsieur Sonny, écoutez-moi, s'il vous plaît... La marge de bénéfices était si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090405
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090405,
					"content": "*soupir* Sérieusement. Vous n'avez que les moras à la bouche. Cela vous arrive-t-il de penser à autre chose ? Et votre fierté de Fontainois ? Éprouvez-vous du plaisir à regarder nos compatriotes devenir l'ombre d'eux-mêmes à cause de cette fichue boisson ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090406
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090406,
					"content": "Peuh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090407
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090407,
					"content": "Oh ? Quelle surprise, Luca montre une émotion intense envers vos paroles. C'est un véritable exploit que vous accomplissez là, cher Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090408
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090408,
					"content": "Monsieur Sonny, je... Par pitié, croyez-moi ! Tout est à cause de ces gars, ils m'ont menti. Je n'aurais rien fait s'ils ne m'avaient pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090409
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090409,
					"content": "Silence, vaurien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090410
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090410,
					"content": "Ah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090411
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090411,
					"content": "Vous êtes exactement le type de déchet qui gaspille mon temps précieux. Et vous osez encore me mentir ? Êtes-vous débile ou me prenez-vous pour un imbécile ? On ne vous entend plus, hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090412
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090412,
					"content": "#Vous avez même essayé de faire du mal à {NICKNAME}. Avez-vous la moindre idée de qui {M#il}{F#elle} est ? Dire qu'un incapable comme vous a été formé par lui... Je vais lui en toucher deux mots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090413
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090413,
					"content": "... Enfin, ce n'est pas quelque chose dont vous aurez à vous soucier, cher Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		}
	]
