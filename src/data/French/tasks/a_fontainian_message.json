			"dialogs": [
				{
					"id": 740090301,
					"content": "Laissez-moi vous expliquer... C'est un gros malentendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090302,
					"content": "Monsieur Sonny... Vous savez, nous nous sommes lancés dans cette activité parce qu'il paraît que c'est très lucratif et les supérieurs n'ont pas accepté, alors nous nous sommes dit que... Que nous pouvions faire des bénéfices d'abord avant de les remettre à l'organisation. Oui, voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090303,
					"content": "Il m'ignore complètement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "Je n'ai aucun reproche envers l'organisation... En plus, j'ai été dupé par ces escrocs ! C'est pour ça que j'ai commis ces actes débiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Impressionnant, ma foi. {NICKNAME}, vous êtes aussi {M#fort}{F#forte} que ce qu'on raconte. Vous ne trouvez pas, Luca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "#Très {M#fort}{F#forte}, incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090307,
					"content": "Souvenez-vous du bon vieux temps que nous avons passé ensemble... Monsieur Sonny... Monsieur Luca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090309,
					"content": "Aïe ! Non, je vous en prie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090310,
					"content": "#Luca, nos {M#invités}{F#invitées} sont encore {M#présents}{F#présentes}. Ne faites rien qui puisse les mettre mal à l'aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090312,
					"content": "Hmph ! Vous savez maintenant où vous vous êtes planté, Virgil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Ahh, c'était ma faute, tout était de ma faute... S'il vous plaît, ayez pitié...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090314,
					"content": "Au moins, vous reconnaissez vos torts. Qu'on ne vous y reprenne plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Mon cher Virgil ne refera plus jamais cette erreur. Je vous le garantis, Paimon et {NICKNAME}, sur mon honneur, Sonny le gant blanc, et celui de mon père et de mon fils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Allons-y, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "D'accord ! Merci beaucoup, Sonny et Luca. Les bonnes personnes sont plus nombreuses que les mauvaises à Fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Au revoir, chère Paimon et {M#mon bon monsieur}{F#ma belle dame}. J'espère que nous pourrons à nouveau unir nos forces un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Hiii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090317,
					"content": "Qu'est-ce que vous comptez faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#La vie peut devenir extrêmement ennuyeuse quand on sait tout dans ce monde. N'est-ce pas, {M#mon bon monsieur}{F#ma belle dame}{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "Si vous voulez savoir, nous allons avoir une longue et sérieuse discussion avec lui. Nous ne vous dérangerons pas plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
		},
