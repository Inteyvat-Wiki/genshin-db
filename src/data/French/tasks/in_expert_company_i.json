			"dialogs": [
				{
					"id": 740510301,
					"content": "Super ! Le kinétoscope est intact et le film n'a pas été endommagé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510328,
					"content": "Que les Archons soient loués, je pensais qu'on allait devoir recommencer le tournage de zéro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510302,
					"content": "Pourquoi vous tournez un film ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Vous n'avez pas non plus l'air d'être de Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "C'est une longue histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510304,
					"content": "Pour faire court, nous venons tous les trois du Village de Qiaoying à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510305,
					"content": "Les gens de notre village travaillent principalement dans le domaine du thé, mais ça ne nous intéresse pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510306,
					"content": "Nous avons donc changé de profession pour tourner des publicités et promouvoir les marchands de thé du village grâce à nos œuvres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510307,
					"content": "La concurrence est rude dans l'industrie du thé et nous ne faisions pas le poids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Les employés qualifiés de notre boutique sont partis les uns après les autres pour trouver du travail ailleurs. Si nous avions continué dans cette voie, nous serions morts de faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Vous deux... Arrêtez de raconter les choses de manière aussi déprimante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510310,
					"content": "On a gagné pas mal de moras en tournant ces publicités dans le village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510311,
					"content": "Mais récemment, d'autres villageois ont commencé à tourner leurs propres publicités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Il y en a même certains qui chantent de l'opéra dedans. Ça ne rigole pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "C'est pour cette raison que nous sommes venus à Fontaine pour obtenir les conseils de réalisateurs experts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510314,
					"content": "Du coup, vous êtes à Fontaine pour en apprendre plus sur le tournage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Tout à fait, nous avons découvert un spécialiste de l'éclairage qui s'appelle Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510316,
					"content": "C'est vraiment un génie pour ce qui est de manipuler la lumière pour... Pour quoi déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510317,
					"content": "La « narration ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Oui, voilà ! Manipuler la lumière pour des besoins de narration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510319,
					"content": "Grâce aux conseils de monsieur Geisert, nous pourrons tourner les meilleures publicités de tout le Village de Qiaoying !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510320,
					"content": "Patronne, le mois dernier vous avez dit qu'on allait tourner les meilleurs films de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Il faut se fixer des objectifs réalistes quand on fait des affaires... Pas comme si tu en savais quelque chose..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510322,
					"content": "#Bref, merci pour votre aide, {M#voyageur}{F#voyageuse}. Voici vos moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, dépêchez-vous de remballer ça ! Il faut qu'on termine vite de tourner notre échantillon avant de le montrer à monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510324,
					"content": "Attention à la lumière ! L'objectif doit faire face à la lumière... Nous devons capturer cette... lumière haute définition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510325,
					"content": "Vous avez tous lu le livre, pas vrai ? La lumière doit avoir une qualité, vous voyez ce que je veux dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Madame Qiu"
				},
				{
					"id": 740510326,
					"content": "Patronne, on a lu le livre de monsieur Geisert, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Avec le Kinétoscope qu'on a, il est impossible de capturer la qualité de lumière que vous voulez. Peu importe comment on se démène...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
