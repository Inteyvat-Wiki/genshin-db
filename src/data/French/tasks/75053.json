			"dialogs": [
				{
					"id": 750530301,
					"content": "Il n'y a plus de prix. Et sans prix, il n'y a plus de défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530302,
					"content": "D'autres questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530303,
					"content": "Pourriez-vous m'en dire plus sur « Les yeux rivés sur le prix plumé » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "C'est une tradition de la tribu depuis de nombreuses générations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530305,
					"content": "Une bonne vue est essentielle pour nous, le Clan des fleurplumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530306,
					"content": "Je suis responsable de cette génération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530307,
					"content": "Y a-t-il une raison pour laquelle vous parlez si lentement...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "C'est une ancienne blessure. Je suis tombé de très haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530309,
					"content": "La gorge et la poitrine ont été touchées... Et je ne peux plus parler comme avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530310,
					"content": "Mais je ne pense pas que ce soit... si grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530311,
					"content": "Aucun problème, je n'ai plus de questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "Bonne chance. Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
