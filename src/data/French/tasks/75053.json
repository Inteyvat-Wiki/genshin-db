			"dialogs": [
				{
					"id": 750530101,
					"content": "#Hé, {M#étranger}{F#étrangère}. Vous avez une bonne vue... Vous voulez essayer « Les yeux rivés sur le prix plumé » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530102,
					"content": "Entraînez votre vue pour gagner des récompenses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530103,
					"content": "On peut dire que c'est une explication concise. Un peu trop, peut-être. C'est comme si vous n'aviez rien dit du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530104,
					"content": "Je vous expliquerai les règles plus en détail plus tard... Vous voulez essayer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530105,
					"content": "Commençons par écouter les règles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "Trois qucusaures vont s'envoler. Ne perdez pas de vue celui du milieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530107,
					"content": "Quand ils reviennent, <color=#00E1FFFF>retrouvez... celui qui était au milieu</color>. Voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530108,
					"content": "Euh, donc ils vont changer de position en cours de vol, et nous devons identifier celui qui était au milieu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530109,
					"content": "C'est exact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530110,
					"content": "Pas étonnant que vous appeliez cela un entraînement de vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530111,
					"content": "Devrions-nous commencer par quelque chose de simple pour tâter le terrain ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530112,
					"content": "Et si tout se passe bien, nous pourrons jouer sérieusement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530113,
					"content": "En cas de réussite, les récompenses sont à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530114,
					"content": "J'ai autre chose à faire, je reviendrai plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "D'accord, vous savez où me trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530116,
					"content": "D'accord, j'imagine que je peux essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "#Lorsque vous êtes {M#prêt}{F#prête}, touchez la cible pour commencer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		},
