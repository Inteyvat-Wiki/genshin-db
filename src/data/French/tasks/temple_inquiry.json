			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "Encore un autre de ces esprits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480302,
					"content": "Mon nom est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480303,
					"content": "Aberaku, créateur d'Helios !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480304,
					"content": "Comment ai-je pu être vaincu par vos viles calomnies et emprisonné par ces enfants que vous avez manipulés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480305,
					"content": "Je... Euh, mais... J'ai été emprisonné pendant des mois... Des années peut-être même, j'ai perdu le compte... Je suis donc dans ma forme post-mortem ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480306,
					"content": "Forme post-mortem ? Vous voulez dire que vous ne faites plus partie de ce monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480307,
					"content": "Chapeau, les esprits ne s'en rendent pas compte en général.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480308,
					"content": "Cependant, j'ai honte de le dire mais je ne sais pas comment j'ai péri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480309,
					"content": "Je me souviens seulement avoir été emprisonné sur les ordres d'un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480310,
					"content": "Un enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480311,
					"content": "C'est exact. Malgré cela, je ne ressens aucune haine contre lui, même à ce jour... Seulement de la peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480312,
					"content": "Ce n'était guère sa faute. Les véritables responsables sont les crapules qui le manipulaient tel un pantin... Ah, oubliez. Certaines choses sont mieux lorsqu'elles sont tues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480313,
					"content": "J'ai été enfermé par la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480314,
					"content": "Emprisonné dans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480315,
					"content": "Dans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480316,
					"content": "Dans un endroit en hauteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480317,
					"content": "Malgré cette hauteur, le lieu était si froid et sombre, sans aucune lumière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480318,
					"content": "... Étrange. Pourquoi cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480319,
					"content": "Pourquoi ai-je eu le sentiment qu'un lieu élevé aurait dû apporter chaleur et confort à celui qui s'y trouve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480320,
					"content": "Pourquoi je ne me souviens plus de rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480321,
					"content": "Peut-être que vous avez faim ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480322,
					"content": "Moi aussi, je n'arrive plus à faire marcher mon cerveau, ni même à parler quand j'ai faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480323,
					"content": "Je ne crois pas que ce soit le cas pour lui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "Mais si ! Regarde-le, il n'arrive même pas à articuler correctement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480327,
					"content": "#Tiens, {NICKNAME}. Regarde s'il y a de la nourriture parmi les offrandes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480328,
					"content": "Ah oui, les offrandes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480329,
					"content": "Vous voulez les manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480330,
					"content": "Non, ça m'est revenu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480331,
					"content": "Lorsque j'ai péri dans ma geôle, mes vêtements et mon corps ont été conservés à différents endroits en raison de mon identité de créateur d'Helios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480332,
					"content": "Mon esprit s'est donc scindé en plusieurs parties, ce qui m'a rendu incapable de trouver le repos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480333,
					"content": "Cet endroit aurait dû être le lieu de repos de ma couronne sacrée, bien qu'elle se soit sûrement décomposée à présent. Cela doit sûrement être la raison pour laquelle mes pensées me hantent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480334,
					"content": "Si cela continue, je doute que je puisse demeurer dans ma forme actuelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480335,
					"content": "Fort heureusement, ces offrandes peuvent remplacer mes restes et ma couronne pour héberger mes fragments de pensée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480336,
					"content": "Prenez-les.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480337,
					"content": "Cependant, beaucoup de périls vous attendent sur le chemin. Bien que cela puisse paraître impoli de ma part, pourriez-vous d'abord accepter que je vous mette à l'épreuve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480338,
					"content": "Une épreuve ? Laquelle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480339,
					"content": "Vainquez les monstres dans les environs qui gardent mon esprit prisonnier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480340,
					"content": "#Cette entreprise est périlleuse. Faites-moi savoir lorsque vous êtes {M#prêt}{F#prête} avant de commencer, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480325,
					"content": "Ça tombe bien, il y a un casse-croûte d'urg...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
