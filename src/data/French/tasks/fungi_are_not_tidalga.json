					}
				]
			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "#Après un certain temps, vous et Paimon vous êtes {M#rendus}{F#rendues} devant le stand de la Fête fun-tastique des cham-p'tit-gnons.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "Ah oui ! Vive les Fongus lisses et souples ! Je veux continuer à jouer à ce jeu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "Et vous êtes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Je suis Enghiene, l'instructrice de Turenna avant qu'elle n'intègre la patrouille de surveillance spéciale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "Je ne suis pas comme Turenna. Votre titre de force meneuse ultra-zénith ne me fait pas peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "C'est difficile d'imaginer que cette mélusine arrogante soit l'ancienne instructrice de Turenna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "Ne stressez pas, Comète dorée et Compagnon argenté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Mademoiselle Turenna est retournée au siège de la patrouille de surveillance spéciale pour d'autres missions, il n'y a pas longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Elle a donc invité mademoiselle Enghiene à assurer la sécurité dans le lieu de l'événement à sa place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "Elle adore aussi la Fête fun-tastique des cham-p'tit-gnons, on joue toujours ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "Exactement, j'aime beaucoup le jeu de société et ces Fongus tout ronds !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "Ils sont lisses, souples et élastiques, comme les maréalgues... Héhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "Ne bavez pas !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "Je ne les mange pas ! Je suis quand même autorisée à les caresser alors ! Haniyyah m'a laissé caresser Pyrojoie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "#Vous n'avez que le droit de faire ça, de toute façon ! {M#Seuls}{F#Seules} {NICKNAME} et moi pouvons faire un câlin à Chapotoc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "#C'est injuste ! Moi aussi, je veux pouvoir le faire{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "#Haniyyah m'a dit que vous êtes des {M#experts}{F#expertes} de ce jeu. Et si vous m'affrontiez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "Si je gagne, j'aurai aussi le droit de caresser Chapotoc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "Grr, elle nous sous-estime !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}, allons-y, montrons-lui la force des {M#premiers joueurs}{F#premières joueuses} de la Fête fun-tastique des cham-p'tit-gnons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "#Et celle {M#du premier champion}{F#de la première championne} de la Coupe des nilotpalotus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "Exactement ! Nous sommes dignes de ces titres majestueux, et nous n'allons pas nous laisser vaincre facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "En plus de celle des étoiles jumelles de la sage bravoure !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "Ne mangez pas nos amis Fongus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}