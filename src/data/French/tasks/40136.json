			"dialogs": [
				{
					"id": 401360201,
					"content": "Je les ai emmenés jusqu'ici. Je vous les remets tous les trois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360202,
					"content": "Vous avez autre chose à faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360203,
					"content": "En quelque sorte, je suis attendue pour une célébration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360204,
					"content": "On n'entend pas ça tous les jours. Vous avez trouvé un nouveau passe-temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360205,
					"content": "Non, c'est juste une occasion spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360206,
					"content": "Chevreuse, Wriothesley !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360207,
					"content": "Les festivals rassemblent vraiment les gens. Ça faisait longtemps que je n'avais pas eu autant de visiteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360208,
					"content": "C'est normal, c'est le Festival Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360209,
					"content": "Vous avez raison. Même notre infirmière en chef a pris la peine de préparer un excellent milkshake nutritif... Une gorgée suffit pour satisfaire tous vos besoins nutritionnels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360210,
					"content": "Vous étiez en train de parler boulot ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360211,
					"content": "Nous avons terminé. Alors, Wriothesley, que pensez-vous de ce dont nous avons parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360212,
					"content": "Hmm. Je ne pense pas avoir promis ni garanti quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360213,
					"content": "Mais vous n'avez pas non plus fermé la porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360214,
					"content": "Que diriez-vous de distribuer le journal à tout le monde ? Avec un peu de chance, la une révélerait des événements d'il y a vingt ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360215,
					"content": "Je pense que la chance de quelqu'un pourrait bientôt tourner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360216,
					"content": "Et que deux personnes seront considérées comme des héros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360217,
					"content": "#En parlant de héros, vous aviez besoin de quelque chose, {M#tous}{F#toutes} les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360218,
					"content": "Oh, en fait, nous sommes là pour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360219,
					"content": "Vous êtes ici pour m'inviter à la cérémonie, n'est-ce pas ? Ne vous inquiétez pas, je n'ai pas oublié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360220,
					"content": "Alors, allons-y sans plus tarder !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360221,
					"content": "Au revoir, Wriothesley ! Joyeux Festival Fontinalia !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360222,
					"content": "À vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
