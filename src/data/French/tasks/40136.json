			"dialogs": [
				{
					"id": 401360101,
					"content": "Un peu de temps s'écoule...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier ! Ça fait longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "#Bonjour, {M#tous}{F#toutes} les deux ! Désolé si je me suis fait discret ces derniers temps. J'ai été très occupé avec la promotion et la préparation de la sortie du film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "C'est aujourd'hui la remise des prix, non ? Je me demande si nous allons gagner le prix Furina !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Je dirais que nous avons neuf chances sur dix de gagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina ! Je ne savais pas que vous étiez déjà là. Vous êtes là avant tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Je suis sûre que les autres seront là d'un moment à l'autre. Xavier, au cas où on nous appellerait sur scène... Vous avez pensé à un nom pour notre équipe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Mais nous ne savons même pas si nous allons gagner. Je préfère ne pas nous porter malheur en célébrant avant l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Ouvrez les yeux ! Vous avez vu comment le public a réagi au film ! Nous avons été acclamés par la critique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "#Vous étiez également en discussion avec le personnel de l'opéra, n'est-ce pas{NON_BREAK_SPACE}? N'ont-ils pas dit vouloir programmer plus de représentations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Avec les recettes que vous avez gagnées grâce à la vente de billets, vous pourrez créer votre propre société de production !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "M—Mais le mérite revient à notre fantastique équipe ! Tout le monde a contribué à ce que le film voit le jour. Je ne devrais pas être le seul à choisir le nom !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Pensez-y. L'équipe respectera certainement votre décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Très bien... Mais d'abord, je voudrais demander à {NICKNAME} et Paimon de se rendre rapidement à la Forteresse de Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Hein ? Mais nous devons rester ici pour la cérémonie de remise des prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Je voudrais vous demander d'inviter Chevreuse à la cérémonie. Après tout, elle a joué l'un de nos deux rôles principaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Je ne l'ai pas vue ces derniers temps, je n'ai donc pas eu l'occasion de l'inviter en personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Selon le journal, les prisonniers condamnés dans le cadre du procès pour meurtre au mousquet seront personnellement escortés aujourd'hui jusqu'à la Forteresse de Méropide par la capitaine de la patrouille de surveillance spéciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Oh, je comprends maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Absolument, aucun problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Oui ! Attendez ici, Xavier. Pendant que vous y êtes, pensez à un nom pour l'équipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "Très bien, je vous laisse vous en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
