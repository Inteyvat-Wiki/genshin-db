			"dialogs": [
				{
					"id": 741890501,
					"content": "Un instant, s'il vous plaît. Aimeriez-vous entendre un secret sur le trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Quel secret ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "#Un trésor et la clé qui ouvre la porte... Qu'en pensez-vous ? Êtes-vous {M#intéressé}{F#intéressée} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Ne me dites pas qu'il s'agit encore une fois de battre des monstres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Mais non, notre taverne n'envoie pas les clients en mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "Avez-vous remarqué le canon à côté de moi et les rochers qui sont en face ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Si vous parvenez à faire exploser les rochers avec ce canon, le trésor qui se trouve en dessous sera à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Qui a baptisé ce canon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "C'est le timonier. Je ne sais pas où il l'a trouvé, mais bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Soyez honnête, quelles pièces manquent sur ce canon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Vous avez mal compris, ce canon est pleinement chargé et sans aucune pièce manquante, je l'entretiens tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "Mais avant que vous l'activiez, je dois vous poser quelques « questions ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "... C'était une demande du timonier. Selon lui, ça occupe les clients de la taverne. Du coup, ils boivent plus lentement et restent plus longtemps au bistro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Je ne sais pas, mais allez-y, posez-moi vos questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Question 1 : combien de tables y a-t-il dans la taverne du Timon rubigineux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "#Question 2 : combien d'employés y a-t-il dans la taverne du Timon rubigineux{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Question 3 : quel objet n'est pas vendu au Timon rubigineux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "C'est tout. Il vous suffit de donner toutes les bonnes réponses, puis vous pourrez utiliser ce canon pour tenter d'obtenir le trésor sous les rochers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "Et après ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "... Après, je remettrai un trésor dans la grotte au moment opportun avant de la boucher avec des rochers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "Ensuite, j'attendrai le prochain client qui voudra jouer avec le canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "Ça ne doit pas être facile pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "Bon, prenez votre temps pour trouver les réponses. Je vous attends ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Votre patron est détestable !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "Je ne vais pas dire le contraire. Mais malheureusement, je n'ai pas encore trouvé de bon moyen de pointer le canon vers le timonier sans qu'il ne le remarque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "En plus, tirer un canon à la légère pourrait blesser les clients de la taverne, et c'est quelque chose que je refuse de faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Soyez honnête, comment ce canon est-il alimenté ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "Ne me dites pas qu'il s'agit encore une fois d'aller chercher quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
