			"dialogs": [
				{
					"id": 742500101,
					"content": "Maintenant que j'y pense, je n'ai pas été l'hôte la plus attentionnée lors de votre précédente visite à Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500102,
					"content": "Ne dites pas ça, mademoiselle Sandrone. Même si nous n'avons jamais pris le temps de discuter, vous nous avez toujours offert les meilleurs rafraîchissements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*soupir* Mes excuses. J'étais trop occupée à l'époque. Je veillerai à mieux m'occuper de vous lors de votre prochaine visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500104,
					"content": "Vous ne m'avez jamais laissé essayer vos inventions non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Il y avait des raisons différentes pour ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500106,
					"content": "Hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "En réalité, Père nous avait aussi dit de ne pas trop vous déranger, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500108,
					"content": "Ne t'inquiète pas pour ça, les visites occasionnelles ne me dérangent pas. Venez prendre le thé quand vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500109,
					"content": "Vraiment ? En fait... j'ai toujours voulu vous demander de jeter un œil à Pers. J'ai quelques idées d'amélioration que j'aimerais vous soumettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500110,
					"content": "Bien sûr, c'est mon domaine d'expertise, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500111,
					"content": "... Merci, mademoiselle Sandrone !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500112,
					"content": "Est-ce vraiment si difficile d'être Exécutrice ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Quand tu le formules comme ça... je suppose que c'est un peu le cas. Il y a beaucoup de choses à prendre en compte. Même si la plupart de mes frustrations viennent de mes collègues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500114,
					"content": "Donc ça veut dire que... bien s'entendre avec les autres est une compétence indispensable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500115,
					"content": "Je suppose que oui... Mais je doute que tu aies grand-chose à craindre à ce sujet. En tout cas, Lyney n'a certainement pas à s'en inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500116,
					"content": "Haha, vous me flattez, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Tu veux devenir un Exécuteur ? En fait, laisse tomber. Ce n'est pas à moi de te poser cette question. Fais comme si je n'avais rien dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500118,
					"content": "Hmm... Tout ça me semble encore un peu loin. Je ne suis certainement pas pressé d'y penser pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Si tu devenais Exécuteur, ça ne voudrait pas dire que tu n'aurais plus le temps de nous accompagner en mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "#Si c'est le cas... Est-ce que ça veut dire que... Lynette et moi devrons aussi devenir Exécuteurs{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500121,
					"content": "Je te l'ai déjà dit, c'est encore trop tôt pour envisager ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "De toute façon, où que j'aille, je ne vous abandonnerai jamais tous les deux. C'est promis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Ah... Parfois, j'envie vraiment votre petite famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
