			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#Jeune maître}{F#Noble demoiselle}, vous êtes vraiment agile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Héhé, évidemment{NON_BREAK_SPACE}! {NICKNAME} est super fort{M#}{F#e}{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#À présent, pourriez-vous me faire l'honneur de me montrer l'essence de la <color=#00E1FFFF>technique de la marche acrobatique</color>, {M#jeune maître}{F#noble demoiselle}{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "Selon les écrits, le maître fondateur du Clan Guhua franchissait murailles et remparts comme s'il marchait sur des terrains plats. Il possédait véritablement la capacité de courir sur les murs et les toits, c'est la technique de la marche acrobatique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "#C'est incroyable{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Euh... Et si on essayait{NON_BREAK_SPACE}? Après tout, {NICKNAME} a l'habitude de fouiller des coffres partout et d'escalader plein d'endroits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "On dirait un cambrioleur volant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Héhé, {M#jeune maître}{F#noble demoiselle}, réfléchissez-y{NON_BREAK_SPACE}: si un voleur peut franchir les murs, mais que nous, justiciers qui combattons le mal, ne le pouvons pas, ne risquons-nous pas de laisser ces scélérats s'échapper facilement{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
