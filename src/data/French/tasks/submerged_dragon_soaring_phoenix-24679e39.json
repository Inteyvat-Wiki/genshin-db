			"dialogs": [
				{
					"id": 762100617,
					"content": "D'un bond rapide, le personnage du tableau atterrit juste devant vous...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762100601
					]
				},
				{
					"id": 762100601,
					"content": "#Je me nomme Zhangsun Jijing, {M#jeune maître}{F#noble demoiselle}. Que puis-je pour vous{NON_BREAK_SPACE}? Y a-t-il une affaire importante dont vous souhaitez discuter{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100602
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100602,
					"content": "Euh, en fait, ce n'est rien d'important. C'est juste qu'on vous a vu sauter un peu partout dans le tableau, alors je me demandais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100603,
					"content": "Je vois. J'étais justement en train de perfectionner ma technique d'allègement corporel, mais ma maladresse a dû vous faire sourire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100604
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100604,
					"content": "#Une technique d'allègement corporel{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100605,
					"content": "#Exact. Il ne pleut jamais ici, ce qui m'empêche de pratiquer la technique de la «{NON_BREAK_SPACE}lame de pluie{NON_BREAK_SPACE}» que m'a transmise mon maître. C'est pourquoi, ne souhaitant pas négliger mes arts martiaux, je me vois contraint de m'entraîner de cette manière.",
					"roleType": "TALK_ROLE_NPC",
