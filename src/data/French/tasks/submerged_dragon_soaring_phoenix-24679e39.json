			"dialogs": [
				{
					"id": 762100201,
					"content": "Admirable. Je suis impressionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "#Puisqu'il en est ainsi... j'ai encore une humble requête à vous présenter. {M#Jeune maître}{F#Noble demoiselle}, auriez-vous entendu parler de la <color=#00E1FFFF>technique du nuage ascendant</color>{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Selon la légende, le maître du Clan Guhua serait parvenu à atteindre les cieux en s'élevant dans une lueur violette, marchant dans les airs comme sur la terre ferme... grâce à cette méthode secrète légendaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Ça semble un peu tiré par les cheveux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "#Ouais, ça a l'air complètement faux... Mais maintenant que j'y pense, si on pouvait utiliser un planeur, on pourrait peut-être obtenir le même genre d'effet, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "#Oh{NON_BREAK_SPACE}? Dans ce cas, {M#jeune maître}{F#noble demoiselle}, pourriez-vous nous faire une démonstration{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Si je pouvais utiliser mon planeur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
