			"dialogs": [
				{
					"id": 762100301,
					"content": "#Regardez. Voici la «{NON_BREAK_SPACE}Formation de la contemplation des pruniers{NON_BREAK_SPACE}» du Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "#Pourriez-vous, {M#jeune maître}{F#noble demoiselle}, me montrer votre agilité en sautant sur les pieux de pierre que je vais vous indiquer, dans l'ordre et dans le temps imparti{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "#Facile{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Même si en fait il y en a plein plein plein... Euh, rien du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Alors, {M#jeune maître}{F#noble demoiselle}, veuillez nous montrer votre talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "En fait, Paimon, le maître du Clan Paimon, pourrait aussi le faire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "#Impossible{NON_BREAK_SPACE}! Même en y réfléchissant bien, c'est... Attends{NON_BREAK_SPACE}? En fait, si je réfléchis bien, je pourrais peut-être y arriver... Mais bon, le faire en volant, ça compte comme de la triche, non{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
