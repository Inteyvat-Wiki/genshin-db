				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "Hmm... C'est pas mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "On dirait que vous vous êtes fait une fortune...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "#Ah, {M#voyageur}{F#voyageuse}. Grâce à vous, j'ai fait un petit profit cette fois-ci, il semble donc que le plat d'or fonctionne vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Cependant, je n'ai pas tellement gagné plus que lors d'une transaction normale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "Un plat d'or ne donnerait pas un tel résultat. Est-ce je ne me serais pas trompé de plat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "#{M#Voyageur}{F#Voyageuse}, recommençons, si vous le voulez bien. Aidez-moi à choisir encore une fois le plat d'or, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Comme la dernière fois, choisissez entre <color=#00E1FFFF>la viande-mora</color>, <color=#00E1FFFF>le poulet au beurre</color> et <color=#00E1FFFF>l'empil'tout</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
