			"dialogs": [
				{
					"id": 230050601,
					"content": "Est-ce le cidre de pomme de cet homme aisé ? Eh bien, il a un arôme extraordinaire qui éclaircit l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Très bien ! C'est certainement la chose qui fera changer les cours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "Je n'oublierai jamais votre aide ! À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
