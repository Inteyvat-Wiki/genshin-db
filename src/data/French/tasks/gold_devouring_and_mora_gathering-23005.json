				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "La dernière fois, j'ai fait un petit profit, mais cette fois, je vais toucher le jackpot. Alors ? Vous avez fait votre choix entre <color=#00E1FFFF>la viande-mora</color>, <color=#00E1FFFF>le poulet au beurre</color> et <color=#00E1FFFF>l'empil'tout</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
