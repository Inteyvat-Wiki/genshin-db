					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570302,
					"content": "J'ai tout trouvé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "Tout ? Tu as un don pour ça, on dirait. Beaucoup de gens n'arrivent même pas à faire pivoter les lanternes, tu sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570304,
					"content": "Bon, comme tu as trouvé tous les trésors... Tiens, prends ça comme récompense. Et joyeux Festival des lanternes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
