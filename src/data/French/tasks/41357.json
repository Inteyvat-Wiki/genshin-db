					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "Bienvenue, voici les kaléidolanternes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570102,
					"content": "Euh... Les kakékiko-quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "Les kaléidolanternes ! Tu veux essayer ? Tu verras, c'est pas compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570104,
					"content": "Tu vois cet écran là-bas ? Et ces trois lanternes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570105,
					"content": "J'ai fait fabriquer ces lanternes spécialement. Quand on les allume, elles projettent toutes sortes de motifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570106,
					"content": "Et quand tu fais pivoter les trois lanternes dans le bon sens, les motifs se combinent pour révéler une image complète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570107,
					"content": "Hmm, ce n'est peut-être pas si clair... Bon, essaye d'abord de faire pivoter les lanternes. Quand tu seras à l'aise, je t'explique plus en détail. D'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
