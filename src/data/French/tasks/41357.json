			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Ah, je vois que tu comprends vite... Bon, maintenant que tu connais les bases, tu peux commencer pour de vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570202,
					"content": "C'est difficile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "Pas du tout... Tu viens d'apprendre comment faire pivoter les lanternes, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570204,
					"content": "Tout ce que tu as à faire, c'est de faire pivoter les trois lanternes pour que les motifs projetés sur l'écran s'alignent pour former une image complète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570212,
					"content": "Je te dis quel motif trouver, mais c'est à toi de te débrouiller pour aligner les lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570205,
					"content": "Et après, qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "Tu as peut-être remarqué que l'écran derrière était recouvert d'une carte de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570207,
					"content": "Une fois l'image complète apposée sur la carte, elle indique l'emplacement de trésors spécialement préparés par la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570208,
					"content": "Installer tous ces trésors a requis pas mal de monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570213,
					"content": "Les coffres sont les mêmes que ceux exposés ici. Une fois connu leur emplacement, les trouver ne devrait pas être trop compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570209,
					"content": "J'ai déjà préparé l'image du jour. C'est un <color=#00E1FFFF>lys verni</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570210,
					"content": "Oh, autre chose... Les images des kaléidolanternes n'apparaissent que pendant la nuit. Donc, mieux vaut tenter sa chance le soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570211,
					"content": "Sache aussi que ces lanternes ont été mandatées à un spécialiste par la Guilde des aventuriers. Admire leur beauté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
