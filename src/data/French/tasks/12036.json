			"dialogs": [
				{
					"id": 120360201,
					"content": "L'annonce du mariage entre monsieur Kujou Kamaji et mademoiselle Hiiragi Chisato était une erreur de communication de la part de la Commission économique. Nous nous excusons sincèrement pour la gêne et les malentendus occasionnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120360202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 120360202,
					"content": "Les responsables de cet incident ont été sévèrement sanctionnés. Une communication fluide et une discipline implacable sont des valeurs que nous nous efforcerons de renforcer au sein du Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120360203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 120360203,
					"content": "Le mariage des deux parties est donc reporté ultérieurement. Un nouvel avis sera publié avec les détails de l'événement.",
