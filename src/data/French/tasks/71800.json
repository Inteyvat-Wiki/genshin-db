			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000302,
					"content": "Mes vêtements sont trempés...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "Ah, je suis bien confuse, mes enfants... Moi qui croyais qu'il ne restait presque plus d'eau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000304,
					"content": "Enfin, ma théière est à peu près propre à présent... Il ne reste plus que quelques coins à finir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000307,
					"content": "Dites... Vous avez versé toute l'eau de la Rivière Bishui à l'intérieur ou quoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718000308,
					"content": "Haha mon enfant, comment pourrais-je faire une chose pareille ? Les villageoins ont besoin de cette eau... J'ai juste mis la moitié de la rivière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000309,
					"content": "#Je vous remercie, vous êtes vraiment {M#gentils}{F#gentilles} mes enfants. Tenez, prenez ceci de la part d'une pauvre grand-mère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000310,
					"content": "Il faudra que je trouve le temps d'aller reverser l'eau qui reste dans la rivière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000305,
					"content": "Ça devrait être à peu près propre là-dedans.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "Hum, il reste encore un ou deux coins, il faudrait y rentrer pour nettoyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
