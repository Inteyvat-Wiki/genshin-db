			},
			"dialogs": [
				{
					"id": 747070101,
					"content": "... Très bien, c'était parfait ! Faisons encore une prise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Bien. Et... coupez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina ! Oh, Columbina et Chiori aussi ! Vous êtes encore là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Oui ! Nous venons juste de terminer le tournage de nos plans d'ambiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Oh ! Vous parlez de cette histoire de poissons acteurs ? Alors, comment ça s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Grâce à votre aide, nous avons trouvé un acteur parfait pour le rôle. Le tournage s'est très bien passé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "Vous avez vraiment un talent pour tout ce qui concerne les aquariums. Furina nous disait justement que vous l'avez même inspirée pour tourner un documentaire sous-marin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "C'est trop gentil !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "#Moi aussi, j'aime beaucoup. Je peux sentir à quel point les petits poissons sont heureux en nageant. Vous vous êtes vraiment bien {M#occupés}{F#occupées} d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747070111,
					"content": "J'aimerais tellement que cet Océanarium reste ici pour toujours. Comme ça, je pourrais venir le voir quand je veux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Si cet endroit va tant vous manquer, pourquoi ne pas ajouter quelques plans supplémentaires des aquariums au film ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Vous avez raison. Tournons-en encore quelques-uns !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Encore quelques poissons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747070115,
					"content": "Encore quelques plans ! Allez, éclairage, cadrage... Où est le script ? Tout le monde en place !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Je suis prête ! Mais donner le signal de tournage pour des acteurs-poissons... c'est vraiment une première, ça c'est sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "#Nous sommes {M#ravis}{F#ravies} que cela vous plaise !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}