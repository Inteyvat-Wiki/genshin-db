			"trigger": {
				"objectNames": [
					"Alan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "Ouh, j'ai bien cru que ça en était fini de moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 411111702,
					"content": "Espèce d'imbécile fini ! C'était bien le moment de filer à un moment pareil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111703,
					"content": "Pardon ! Je ne recommencerai plus jamais, je vous le promets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 411111704,
					"content": "Je m'excuse profondément pour tout le souci qu'Alan vous a causé. Je m'assurerai qu'il apprenne sa leçon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111705,
					"content": "Ne vous aventurez pas n'importe où la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111706,
					"content": "La météorite est là-bas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "Je vais aller voir... Oh ? Princesse, votre <color=#00E1FFFF>œil divin</color> <color=#00E1FFFF>brille</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111708,
					"content": "Oh ? Se pourrait-il qu'Edelstein der Dunkelheit ait ressenti l'énergie maléfique de cette malédiction venue du froid ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111709,
					"content": "Les yeux divins réagissent aussi à ce genre de chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111710,
					"content": "Les énigmes des profondeurs, les secrets murmurés par les astres... La malédiction des ossements démoniaques et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111711,
					"content": "Je ne comprends rien à votre charabia !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111712,
					"content": "Toutes mes excuses, ma maîtresse n'arrive pas à s'exprimer comme tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111713,
					"content": "Vous lui servez donc de traducteur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111714,
					"content": "Vous vous méprenez, je ne suis pas un traducteur. Je ne fais que transmettre la volonté de ma maîtresse, et je la rejoins sur le fait qu'il s'agisse simplement d'<color=#00E1FFFF>énergie élémentaire</color>. Cela expliquerait la réaction de son <color=#00E1FFFF>œil divin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111715,
					"content": "Merci bien, mon cher Oz. Ceux qui ont l'esprit embué par les futilités du monde ordinaire ne peuvent guère comprendre la signification de mes paroles comme tu le fais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111716,
					"content": "La météorite dégagerait de l'énergie élémentaire ? Et votre œil divin réagit à ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111717,
					"content": "Avec votre œil divin, vous pouvez retrouver la source d'une énergie élémentaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "J'ai bien l'impression. On pourrait essayer de trouver des <color=#00E1FFFF>fragments de météorite</color> grâce à l'<color=#00E1FFFF>œil divin</color> de Fischl et nettoyer les zones à danger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111718,
					"content": "La source d'énergie ne réagit-elle pas de la même manière ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
