						411111607
					]
				},
				{
					"id": 411111607,
					"content": "Ce pauvre individu a l'air profondément endormi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111608
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111608,
					"content": "Il ne s'agit point d'un rêve quelconque. Ce malheureux a été maudit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111609
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111609,
					"content": "Ne pouvez-vous pas juste le réveiller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111610,
					"content": "Croyez-moi, j'ai déjà essayé. Il s'est brièvement réveillé, mais il s'est tout de suite rendormi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111611
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111611,
					"content": "Vous a-t-il dit quelque chose lorsqu'il s'est réveillé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111612,
					"content": "Il m'a dit qu'il était au sommet d'une montagne et qu'il faisait très froid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111613
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111613,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111614,
					"content": "Ceci est une malédiction jetée par un cruel démon des montagnes sans scrupules ! Hélas, il semblerait qu'il convoite le fief de la fée de la source...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111615,
					"content": "Quelle affaire épineuse... Mais ne craignez rien, mon illustre personne saura punir le coupable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111616
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111616,
					"content": "Excusez-moi de vous déranger, mais vous auriez un moment à m'accorder ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111617,
					"content": "Oh, mais c'est Draff ! Qu'est-ce qu'on peut faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111618,
					"content": "Les mots me manquent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111619,
					"content": "Vous voyez, il y a une <color=#00E1FFFF>météorite</color> qui est tombée sur <color=#00E1FFFF>la montagne qui se trouve derrière le village</color>, et ce pauvre fou d'<color=#00E1FFFF>Alan</color> s'est précipité là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111620,
					"content": "Vous avez bien vu à quel point ces météorites sont dangereuses ! Et si quelque chose lui était arrivé par malheur ? Il faut qu'on le sorte de là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111621,
					"content": "Décidément, quel idiot cet Alan ! Des gros cailloux tombent du ciel et tout ce qu'il veut c'est être au cœur de l'action !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111622,
					"content": "Exactement ! Je vais lui passer un de ces savons à son retour, je vous le dis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111623
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111623,
					"content": "Bien dit ! Ramenons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111117,
