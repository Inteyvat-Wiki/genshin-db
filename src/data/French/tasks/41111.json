			"dialogs": [
				{
					"id": 411111601,
					"content": "Bonjour, je suis sœur Edna. Je suis là pour soigner les victimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111602
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111602,
					"content": "Déclarez votre nom sur-le-champ, vile créature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111603
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111603,
					"content": "Excusez ma maîtresse, elle ne s'adressait pas à vous. Cet homme par terre, a-t-il parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111604
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111604,
					"content": "Il me semble qu'il a dit devoir reprendre le travail...",
