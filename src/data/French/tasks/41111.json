			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "#{M#Voyageur}{F#Voyageuse}, tu tombes à pic !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110102,
					"content": "Il est arrivé quelque chose, Catherine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110103,
					"content": "Oui, quelque chose de grave. Je me retrouve obligée de solliciter l'aide de tous les aventuriers de la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110104,
					"content": "#J'ai une mission de la plus haute importance à te confier, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110105,
					"content": "Ouah, on dirait que c'est sérieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110106,
					"content": "Honnêtement, c'est la première fois que ce genre d'affaire nous arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110107,
					"content": "La Guilde des aventuriers est débordée. Nous comptons sur nos membres à travers tout le continent pour nous venir en aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110108,
					"content": "Je vous dois bien ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "Attends, encore une chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110111,
					"content": "Catherine, fidèle sujet de l'Empire de la nuit éternelle ! Entendais-je un appel en détresse de votre part, un instant plus tôt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110112,
					"content": "Ah, te voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110113,
					"content": "Toujours un plaisir de vous voir, chère Catherine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110114,
					"content": "Je rêve ou ce corbeau vient de parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110115,
					"content": "Nul besoin d'être surprise pour si peu, mon amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110116,
					"content": "Mes chers et loyaux sujets, je vois bien vos visages inquiets à l'idée que ces pécheurs menacent à nouveau la paix de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110117,
					"content": "#{M#Voyageur}{F#Voyageuse}, je vous présente Fischl. Elle fait partie de nos membres les plus expérimentés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110118,
					"content": "#Fischl, Oz, voici {M#le voyageur}{F#la voyageuse} dont je vous ai parlé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110119,
					"content": "Oh, c'est donc vous ? Hmm, j'aime l'intensité de votre regard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110120,
					"content": "Nous sommes honorés de faire votre connaissance, cher chevalier honoraire et chère Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110121,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous devez sûrement vous interroger sur ces cristaux sombres et damnés, je suppose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110122,
					"content": "Hein ? Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110123,
					"content": "C'est ce dont tu voulais nous parler, Catherine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "Ma maîtresse veut parler des <color=#00E1FFFF>météorites</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110126,
					"content": "Nous sommes pour le moment incapables de déterminer ni la cause de la pluie de météores, ni les effets que les météorites pourraient causer. C'est pour cette raison que nous conseillons aux aventuriers de voyager par deux comme mesure de sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110127,
					"content": "#{M#Voyageur}{F#Voyageuse}, Fischl, faites attention l'{M#un}{F#une} à l'autre pendant votre trajet et soyez {M#prudents}{F#prudentes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110128,
					"content": "Très bien, Catherine. Vous avez toujours été un de mes plus loyaux sujets, alors je ne peux refuser d'entendre votre cri à l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110129,
					"content": "#Réjouissez-vous ! C'est un honneur d'effectuer une mission en compagnie de la Princesse du châtiment, vous pouvez en être {M#fier}{F#fière} pour le restant de vos jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110130,
					"content": "Ma maîtresse est originaire d'un monde de l'au-delà connu sous le nom de l'Empire de la nuit éternelle. Je suis Oz, son fidèle serviteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110131,
					"content": "Impressionnant, dis donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110132,
					"content": "#Je m'appelle Paimon et {NICKNAME} est {M#un voyageur}{F#une voyageuse}. Nous avons hâte de travailler avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110133,
					"content": "Un monde de l'au-delà ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "Tu verras, plus tu passeras de temps en compagnie de Fischl et plus tu comprendras ce qu'elle raconte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 411110136,
					"content": "#Ne pas connaître l'Empire de la nuit éternelle ? Je ne pouvais guère en attendre davantage d'{M#un pauvre voyageur}{F#une pauvre voyageuse}... Il serait injuste de qualifier cette méconnaissance de blasphème, je dois donc faire preuve d'indulgence face à tant d'ignorance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110137,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110138,
					"content": "Ma maîtresse vous salue à sa façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110139,
					"content": "Ces deux-là sont les gens les plus bizarres que j'ai jamais vus ! La fille parle d'une manière super théâtrale et son oiseau de compagnie qui est obligé de traduire ce charabia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110140,
					"content": "Je suis persuadé que vous avez beaucoup de questions à nous poser. Nous pourrions en discuter en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110141,
					"content": "D'ailleurs, Catherine disait qu'on devait voyager par deux, mais dans notre cas, c'est plutôt par quatre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110134,
					"content": "L'Empire de la nuit éternelle ? ... Jamais entendu parler",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "Merci pour l'information, j'y vais de ce pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
			"id": 4111105,
			"completionStepIds": [
				4111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111105",
							"2"
						],
						"stepId": 4111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "Nous sommes arrivés à Deauclaire. D'après Catherine, il s'agit de la zone d'impact la plus proche de la Cité de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110502,
					"content": "La situation semble pire que ce que nous nous imaginions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110503,
					"content": "Il y a beaucoup de victimes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "Que les cloches saintes sonnent ! L'heure du jugement est proche ! Ne craignez rien, la Princesse du châtiment est là pour tous ceux qui désirent la repentance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110505,
