			"dialogs": [
				{
					"id": 411111401,
					"content": "Edna, nous nous sommes débarrassés de la météorite sur la colline derrière le village ! Les victimes vont mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111402,
					"content": "Merci infiniment ! Grâce à vous, deux d'entre elles se sont réveillées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111403
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111403,
					"content": "J'ai encore un coup de barre... *bâille* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111404
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111404,
					"content": "Super ! On dirait que ça marche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111405,
					"content": "J'espère que vous pourrez nous aider à nous débarrasser des <color=#00E1FFFF>autres météorites</color> à proximité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111406
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111406,
					"content": "Tout le monde se réveillerait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111407
					]
				},
				{
					"id": 411111407,
					"content": "C'est une nouvelle réjouissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111408
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111408,
					"content": "L'issue ne pouvait être que favorable grâce à l'intervention de mon illustre personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111409
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111409,
					"content": "Dites, quel genre de rêve avez-vous fait pendant votre long sommeil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111410,
					"content": "Je me souviens qu'il faisait très froid et que je marchais sur une route de montagne sans m'arrêter... Oui, <color=#00E1FFFF>une montagne enneigée</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111411
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111411,
					"content": "Vous marchiez sans destination en tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111412,
					"content": "Je n'en sais rien en réalité. Je n'avais pas l'impression d'être maître de mon corps dans mon rêve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111413
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111413,
					"content": "Il m'est avis qu'une malédiction s'est abattue sur votre personne ! Quel fléau tourmente donc ces terres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111414
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111414,
					"content": "(Une malédiction ? Vraiment ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111415
					]
				},
				{
					"id": 411111415,
					"content": "Dans tous les cas, nous savons que nous débarrasser des météorites aide les gens à se réveiller. Continuons le boulot !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
