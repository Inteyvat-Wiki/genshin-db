					"nextDialogs": [
						411111504,
						411111506
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111504,
					"content": "Est-ce qu'il a touché une météorite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111505
					]
				},
				{
					"id": 411111505,
					"content": "Exact. Il est tombé dans un profond sommeil et ça lui arrive de parler aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111508,
					"content": "Je suis épuisé... Je dois me reposer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111509
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111509,
					"content": "Que se passe-t-il ? Pourquoi dit-il cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111510,
					"content": "Ce rêve est tel un fruit défendu entre les dents d'une bête féroce dont le regard aussi sombre que menaçant pousse les plus faibles de mes sujets à être engloutis par l'abîme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111511
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111511,
					"content": "En gros, quelque chose est en train de l'attirer dans son rêve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111512,
					"content": "Nous n'avons aucune preuve à avancer, mais sachez que l'intuition de ma chère maîtresse est toujours correcte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111513
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111513,
					"content": "Hum, continuons notre enquête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111506,
					"content": "Est-ce que d'autres symptômes se sont manifestés à part le sommeil ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111507
					]
				},
				{
					"id": 411111507,
					"content": "Non, pas pour l'instant. Mais il parle parfois dans son sommeil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				}
			]
		},
