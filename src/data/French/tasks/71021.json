			"dialogs": [
				{
					"id": 710210101,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210102,
						710210106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210102,
					"content": "Utilisez un planeur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "Mieux vaut éviter. Depuis que j'ai rejoint l'Académie, je passe mon temps dans les bouquins, et je n'ai pas fait une once d'exercice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210104,
					"content": "Et puis on n'utilise guère de planeurs là-bas. Je ne saurais pas quoi en faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210105,
					"content": "Si je prenais le risque, je tomberais à l'eau avant même d'avoir parcouru quelques mètres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210106,
					"content": "Louez une embarcation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "J'y pensais aussi. Je me rappelle qu'on peut louer des navires au port de Dornman, mais c'est bien trop loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210108,
					"content": "Qui sait combien de temps le voyage prendrait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210109,
					"content": "Enfin, je ne vais tout de même pas construire moi-même un radeau... Ce n'est pas quelque chose qu'on enseigne à l'Académie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
}