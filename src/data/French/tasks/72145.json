			"dialogs": [
				{
					"id": 721450101,
					"content": "« L'envoyé divin de la Divinité des tréfonds avait trois yeux : un premier pour l'« âme », un deuxième pour la « réflexion » et le dernier pour la « vérité »... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Stèle ancienne"
				},
				{
					"id": 721450102,
					"content": "« Il remonta des profondeurs, du <color=#00E1FFFF>sud</color>, au <color=#00E1FFFF>nord</color>, jusqu'aux hauteurs à l'<color=#00E1FFFF>ouest</color>... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Stèle ancienne"
				},
				{
					"id": 721450103,
					"content": "« Les trois yeux brillèrent d'un éclat impitoyable pour repousser le vil héritier du dragon abyssal... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Stèle ancienne"
				},
				{
					"id": 721450104,
					"content": "Je connais tous ces mots... mais ils ne font aucun sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Je n'ai pas l'impression qu'il y ait plus d'indices... Essaye d'utiliser ta <color=#00E1FFFF>vue élémentaire</color> pour voir ?",
					"roleType": "TALK_ROLE_NPC",
