			"dialogs": [
				{
					"id": 741401101,
					"content": "Oh, on se retrouve à nouveau. Tiens, cette fois, Paimon est avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401102,
					"content": "#Hum, la dernière fois que nous avons fait de la «{NON_BREAK_SPACE}méditation » ici, j'étais là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401103,
					"content": "Vraiment ? J'ai dû oublier alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401104,
					"content": "Quoi qu'il en soit, grâce à votre aide, j'ai trouvé l'emplacement du miroir et l'endroit où les fleurs vont s'épanouir, et ma compréhension de cet endroit s'est également approfondie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401105,
					"content": "Mmm... Parler avec Canotila est toujours aussi déroutant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401106,
					"content": "Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "Hmm ? Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401108,
					"content": "Ouaf ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "D'accord, j'ai compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401110,
					"content": "(De quoi parle-t-elle avec le toutou ? Est-ce que toutes les mélusines savent parler aux chiens ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401111,
					"content": "(C'est incroyable.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Dans ce cas, alors à la prochaine. Hmph, même si tu dis ça, je reviendrai quand même te voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401113,
					"content": "#Allons-y, {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
