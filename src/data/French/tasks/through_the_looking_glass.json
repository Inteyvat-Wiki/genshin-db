				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "*soupir* Nous voilà de retour ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "Je me sens mal de dire ça, parce que tout le monde est très gentil avec moi, vous y compris. Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Ne trouvez-vous pas que le monde réel est terriblement ennuyeux ? Ne pensez-vous pas que le monde dans les livres est plus beau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "Je le pense aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Hein ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "Je trouve que le monde du livre des révélations est plus beau. Il y a des pétales de fleurs couverts de rosée partout, et j'ai enfin pu me lier d'amitié avec le toutou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "Le toutou... D'ailleurs, Canotila, pouvez-vous comprendre ce que disent les chiens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Hmm ? Bien sûr que non. C'est juste que... le toutou du livre des révélations est spécial. Ou peut-être que c'est moi qui suis spéciale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "Mais je médite constamment pour voyager dans les mondes des livres. Un jour, soudainement, les aboiements sont devenus des mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "Quant à ce dont nous avons parlé... Il m'encourageait à partir, à ne plus revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "*soupir* Mais je veux pouvoir voir les tournesols en pleine floraison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "Je... Je vois... Prenez soin de vous, Canotila ! On y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "Je ne le pense pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Je vois... Peut-être que c'est vrai, je suis anormale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "Ça m'est égal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#On dirait que {NICKNAME} est la personne la plus forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
