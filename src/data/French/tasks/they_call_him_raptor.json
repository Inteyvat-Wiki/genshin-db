			"dialogs": [
				{
					"id": 4842201,
					"content": "Oh, regardez où nous sommes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "Il n'y a plus aucune trace élémentaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "Le pouvoir élémentaire de l'artéfact a dû s'épuiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Le Rapace s'est rendu compte que les traces élémentaires n'avaient pas encore disparu, alors il a ordonné à ses acolytes de nous ralentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "Il avait besoin de temps pour que les traces s'estompent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "Hors de question de le laisser s'échapper ! Poursuivons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
