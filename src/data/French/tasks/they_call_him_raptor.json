			"dialogs": [
				{
					"id": 4840601,
					"content": "Hum, voilà un bout de tissu avec des traces d'Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840602,
					"content": "D'après la méthode de tissage, ça vient probablement d'un planeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Les Éclaireurs sont aussi experts en textile ? Trop fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "Ça voudrait dire que le planeur du Rapace s'est cassé, si le tissu provient bien du sien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "Les traces élémentaires mènent par là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841102,
					"content": "Tu penses qu'il s'est enfui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841103,
					"content": "#On ne le saura pas si on reste {M#plantés}{F#plantées} là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841104,
					"content": "#Suivons les traces, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841105,
					"content": "On dirait qu'il y a quelque chose devant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841106
					],
					"speakerTitle": "Paimon"
				},
				{
