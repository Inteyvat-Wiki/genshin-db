					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Ouf, des chevaliers de l'Ordre ! Les Brutocollinus n'oseront pas s'approcher davantage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843102,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "Ma voiture s'est fait attaquer par des Brutocollinus. Heureusement, j'ai réussi à leur échapper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843104,
					"content": "Une attaque de Brutocollinus ? Pourtant l'Ordre s'est débarrassé d'eux récemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "Il reste encore un petit camp pas trop loin du village, mais je prends toujours soin de le contourner quand j'achemine de la marchandise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843106,
					"content": "Mais aujourd'hui, une personne en planeur s'est écrasée sur ce camp !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843107,
					"content": "Hum... Pourquoi ça me rappelle quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Les Brutocollinus étaient furax ! Ils ont poursuivi le gars qui avait un drôle d'accoutrement, et c'est comme ça qu'ils se sont aventurés hors de leur camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843109,
					"content": "J'ai réussi à m'en sortir, mais on ne peut pas en dire autant des fruits que je transportais. Ils ont été écrasés sans merci ! Que vais-je bien pouvoir faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843110,
					"content": "À quoi ressemblait cet homme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Il portait un objet dans les bras. Ça devait être lourd, car son planeur n'arrêtait pas de tanguer ! C'est sans doute pour cette raison qu'il s'est écrasé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843112,
					"content": "Les individus comme lui sont un danger public dans le ciel. Tout le monde sait qu'il est dangereux de porter des objets lourds pendant qu'on plane. C'est pas sorcier ! Je vais m'assurer que le permis de cet imbécile soit révoqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843113,
					"content": "Hum, un objet lourd... Ça décrit bien l'artéfact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "Avez-vous vu où il allait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "J'ai cru voir qu'il partait dans cette direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farah"
				},
				{
					"id": 4843116,
					"content": "#Je crois qu'on le tient bientôt. C'est parti, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "Oh, et ne vous inquiétez pas. Je vais prévenir les chevaliers pour les Brutocollinus, ils s'en occuperont dès que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
