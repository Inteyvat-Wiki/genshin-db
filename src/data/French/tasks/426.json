			},
			"dialogs": [
				{
					"id": 4260101,
					"content": "Reposons-nous un peu pour le moment. Qu'allons-nous faire ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260102,
					"content": "Accomplir des quêtes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "C'est facile ! Clique sur le point d'exclamation en haut à gauche de l'écran pour voir toutes les quêtes que tu as acceptées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260104,
					"content": "Certaines quêtes sont très difficiles, et parfois il est impossible de les accomplir si tu n'as pas le niveau nécessaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260117,
					"content": "D'autres questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260105,
					"content": "Se promener dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "Certaines zones sont plus dangereuses que d'autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260107,
					"content": "Tu devrais d'abord t'entraîner dans des endroits pas trop dangereux pour éviter de te faire zigouiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260108,
					"content": "Alfry de la Guilde des aventuriers connaît Teyvat comme sa poche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260109,
					"content": "Elle habite dans une rue commerçante de Mondstadt, pas très loin de la porte de la ville. Tu devrais passer la voir pour qu'elle te conseille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260110,
					"content": "#Devenir plus {M#fort}{F#forte}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "#Si tu veux devenir plus {M#fort}{F#forte}, il faut te procurer des armes et des artéfacts rares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260112,
					"content": "Il y en a à la pelle dans les donjons, mais c'est des endroits dangereux. Tu risques de te faire blesser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260113,
					"content": "Si tu as peur de t'y aventurer, tu peux toujours les acheter à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260114,
					"content": "Les armes et les artéfacts peuvent aussi être améliorés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260115,
					"content": "Je te laisse deviner ce qu'il faut faire pour ça. Je ne vais pas te mâcher tout le boulot non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260116,
					"content": "Bien évidemment, il faut que tu fasses attention à avoir le niveau requis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260118,
					"content": "Non, tu peux aller te reposer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "Cool !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
