				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Columbina est absente ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Vous me cherchiez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350103,
					"content": "Aaaaah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Vous m'avez fait peur !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "En sentant votre présence, j'ai décidé de voir si je pouvais vous approcher dans votre dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350107,
					"content": "Vous avez l'air d'avoir beaucoup de temps libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Ah bon ? C'était pareil quand j'étais avec les Fatui... Je n'avais jamais rien de spécial à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350109,
					"content": "La Tsarine avait seulement besoin du pouvoir des Déesses de la lune. On ne m'a jamais demandé de ramener un Gnosis ou ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350110,
					"content": "Que faisiez-vous au quotidien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Je me promenais, je regardais la lune et parfois, je chantais. Enfin, je ne chante plus depuis que Sandrone me l'a interdit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350112,
					"content": "Ah ? Elle n'aimait pas ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "Non, Sandrone m'a dit que je chantais bien. Mais quand j'ai rejoint les Fatui, elle m'a dit que les autres seraient nerveux de m'entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350114,
					"content": "Ceux qui ne sont pas au courant pourraient avoir l'impression que je suis sur le point d'utiliser... une sorte de pouvoir sur eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350115,
					"content": "Ah, c'est plus ou moins logique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "Ah, il y avait une autre raison. Elle a dit qu'elle faisait des recherches la nuit, et que si je chantais le jour, elle ne pourrait pas rattraper son sommeil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350117,
					"content": "(Je parie que c'était la raison principale !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Je chantais donc devant sa porte la nuit, mais elle me chassait quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Vous vous entendiez bien avec les autres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "Hmm... Lors de notre première rencontre, Arlecchino avait l'air de vouloir bien « s'entendre » avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350122,
					"content": "Elle apparaissait souvent derrière moi, comme je l'ai fait tout à l'heure avec vous. C'était un « test » pour elle, je crois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350123,
					"content": "J'ai essayé de jouer à son jeu, mais elle se retournait toujours alors que j'étais encore loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350124,
					"content": "Cela a duré jusqu'à ce que je sois obligée d'utiliser le kuuvahki. J'ai pu lui faire une belle frayeur, mais elle n'a plus voulu jouer à ce jeu avec moi par la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350125,
					"content": "(Arlecchino n'a probablement jamais vu ça comme un jeu...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Dottore me demandait souvent de l'assister dans ses recherches sur le Royaume de la lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350127,
					"content": "Je l'ai fait quelques fois, mais c'était très ennuyeux. « Utilise le kuuvahki pour frapper ceci, utilise le kuuvahki pour contrôler cela »... J'ai arrêté d'y aller au bout d'un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350128,
					"content": "Vous avez l'air de bonne humeur aujourd'hui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Oui. J'ai beau avoir « fui mon foyer », j'en garde quand même de bons souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350131,
					"content": "Arlecchino et Sandrone ont été très gentilles avec moi, et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350133,
					"content": "(Son expression... Je me demande à qui elle pense...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Donnez-moi votre main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350135,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Je me souviens que Rosalyne m'a appris... à remercier les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350138,
					"content": "Merci de m'avoir écoutée aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350139,
					"content": "Je vous en prie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Est-ce... la faveur de la Déesse de la lune ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Ce sera tout pour aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350142,
					"content": "Hein ? Aussi soudainement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Chut... Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Oui, tu as sans doute raison. Ne la dérangeons pas plus, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Elle s'est peut-être souvenue d'événements de son passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "... Pourquoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Vous avez beaucoup parlé de votre passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Pourquoi êtes-vous arrivée par derrière ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}