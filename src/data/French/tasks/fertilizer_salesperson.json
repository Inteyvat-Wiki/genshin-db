			"dialogs": [
				{
					"id": 728130901,
					"content": "#Vous êtes {M#revenu, voyageur}{F#revenue, voyageuse}. Je me suis débarrassé de l'engrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130902,
					"content": "*soupir* Je crois que je vais devoir mener mes recherches ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130903,
					"content": "Oh ? À qui ai-je l'honneur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130904,
					"content": "C'est une assistante que Gorou vous envoie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Bonjour, je m'appelle Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "Euh, ce général Gorou m'a demandé de vous aider dans vos recherches sur l'engrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "Je suis ravie de pouvoir travailler avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "C'est vrai ? Mais c'est génial ! Si on arrive à faire de l'engrais, l'Île de Watatsumi pourra produire plus de récoltes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130912,
					"content": "N'oubliez pas de mettre les tas d'engrais un peu plus loin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "Ah ? Oui, je sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130914,
					"content": "En tout cas, bienvenue à bord ! Je serai très honoré d'apprendre de vous, mademoiselle Alrani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130915,
					"content": "Merci. Faisons de notre mieux ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
					"content": "Je dois persévérer pour ma thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130906,
					"content": "C'est une spécialiste de l'engrais de Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "Bonjour, je m'appelle Alrani... Quoi ? Une spécialiste de l'engrais ?",
