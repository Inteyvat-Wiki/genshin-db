			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281306",
							"2"
						],
						"stepId": 7281306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiroyuki",
					"Alrani",
					"Gorou",
					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "Restez là où vous êtes et ne bougez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130502,
					"content": "J—Je n'ai pas bougé d'un poil ! Vous m'avez demandé de m'expliquer. Eh bien, je suis vraiment une chercheuse de l'Académie de Sumeru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130503,
					"content": "Mais vous prétendiez vendre de l'engrais tout à l'heure, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130504,
					"content": "Je... Qui a dit qu'une chercheuse ne pouvait pas vendre de l'engrais ?! Écoutez-moi, je vous en prie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130505,
					"content": "C'est elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130506,
					"content": "Oui, général.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130507,
					"content": "Quand nous l'avons arrêtée, elle était en train d'écrire des choses furtivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130508,
					"content": "Général, je suis certain que c'est une espionne du Shogunat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130509,
					"content": "Mais pas du tout ! Je vous ai déjà dit maintes fois que j'étais une chercheuse et que j'étais en train de collecter des informations pour ma thèse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130510,
					"content": "Balivernes ! Qui croyez-vous berner avec cette histoire de thèse ? Vous êtes sans aucun doute là pour autre chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130511,
					"content": "... Et quoi d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130512,
					"content": "Vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Que les Archons soient loués, dites-leur que je ne suis pas une criminelle ! Je ne suis là que pour ma thèse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130515,
					"content": "Vous la connaissez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130516,
					"content": "On peut dire ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "Eh bien, les chercheurs de Sumeru s'aventurent vraiment jusqu'aux quatre coins du monde juste pour terminer leurs études...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130518,
					"content": "D'après ce que je vois, elle n'est qu'une connaissance pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130519,
					"content": "C'est elle qui vous a affirmé être une chercheuse de Sumeru, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130520,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "Hmm... J'ai bien peur qu'il n'y ait rien qui puisse prouver son identité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130522,
					"content": "Mais si vous lui faites confiance, je ne pense pas qu'il s'agisse d'une personne malhonnête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130523,
					"content": "Mon général, j'ai une idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130524,
					"content": "Vous vous souvenez de Kaushik ? C'est un chercheur qui étudie la culture et l'histoire de notre île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130525,
					"content": "Ça fait longtemps qu'il réside ici et son identité de chercheur est avérée... Pourquoi ne pas lui demander son avis sur cette femme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130526,
					"content": "#C'est pas mal comme idée. {M#Voyageur}{F#Voyageuse}, pourriez-vous amener Kaushik ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130527,
					"content": "Je reste ici pour garder un œil sur cette... vendeuse d'engrais, au cas où.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130528,
					"content": "Compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "Merci beaucoup, allez-y vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130513,
					"content": "Alrani ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
