					"Kaushik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "#La signification du totem... Oh, {M#voyageur}{F#voyageuse}. Je peux faire quelque chose pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "C'est au sujet d'Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Alrani est sur l'Île de Watatsumi ? Bizarre, pourquoi est-elle ici ? Je croyais qu'elle était retournée à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Elle s'est fait arrêter par des soldats...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Quoi ? *soupir* Évidemment, en venant ici dans un contexte aussi tendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Bref, allons l'aider immédiatement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
