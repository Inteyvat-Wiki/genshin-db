			"trigger": {
				"objectNames": [
					"Gui l'herboriste",
					"Petit Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Bienvenue. Vous êtes ici pour trouver un remède à base de plantes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280202,
					"content": "Oh ? Mais c'est toi, Petit Meng ? Qu'est-ce qui t'amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280203,
					"content": "... Oh, c'est vrai. Je me souviens maintenant. Tu es là pour les médicaments, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280204,
					"content": "Ne t'inquiète pas, c'est presque terminé. Je vais les envoyer par lot à ton père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280205,
					"content": "Cela dit, cette commande a épuisé toutes nos réserves d'herbes, donc il faudra un peu de temps pour certains des médicaments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280206,
					"content": "Voyons voir... Eh bien, ce qui nous manque le plus, c'est la menthe, c'est pourquoi on a dû arrêter les remèdes contre les coups de chaleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280207,
					"content": "Je veux dire, on prend aussi des commandes de médicaments autres que celles de ton père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280208,
					"content": "Alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280209,
					"content": "On dirait que c'est le moment pour moi d'entrer en scène.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Héhé, merci {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280213,
					"content": "Je compte sur toi pour ces herbes ! Je dois rester ici pour vérifier ces médicaments, comme papa me l'a demandé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280214,
					"content": "Haha, en voilà un bon garçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280215,
					"content": "Bon alors, par ici. On va passer en revue ce lot de médicaments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280216,
					"content": "Waouh, il y en a... beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280217,
					"content": "Jette déjà un œil à ceux-là pour commencer. Ensuite, je t'apporterai le prochain lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280218,
					"content": "Hein ? Il y en a d'autres ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280211,
					"content": "N'oublie pas que tu m'en dois une, par contre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#Héhé, pas de problème ! Merci {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Petit Meng"
				}
			]
		},
