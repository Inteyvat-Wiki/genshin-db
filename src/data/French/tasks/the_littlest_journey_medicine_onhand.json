				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#{NICKNAME}, tu arrives juste à temps ! Je voulais te demander quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280102,
					"content": "Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Papa a dit que le voyage serait long et qu'on aurait besoin de médicaments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280106,
					"content": "Des trucs pour les maux de tête, la diarrhée, les coups de chaleur, la gueule de bois, pour aider à la digestion aussi... Il y en a tellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280107,
					"content": "Pourquoi quelque chose pour la gueule de bois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "C'est sûrement pour les dîners d'affaires.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Hein ? Qu'est-ce qu'un médicament contre la gueule de bois a à voir avec le fait de parler business ? Ce n'est pas comme si plus on boit et mieux vont les affaires, si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "En tout cas, papa veut que j'aille au Cottage Bubu pour demander si les médicaments sont prêts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280111,
					"content": "Tu peux m'accompagner ? J'aimerais te demander de l'aide pour quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280112,
					"content": "Allons-y, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280113,
					"content": "Pourquoi as-tu besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Je te le dirai quand on sera arrivés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280103,
					"content": "Comment avancent les préparatifs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Eh bien, c'est surtout papa et ses amis qui font les préparatifs... Mais papa m'a aussi confié une tâche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Petit Meng"
				}
			]
		},
