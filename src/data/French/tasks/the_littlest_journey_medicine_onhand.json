			"dialogs": [
				{
					"id": 210280401,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280402,
					"content": "Oui, ça devrait suffire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280403,
					"content": "Je vais mettre le médicament contre les coups de chaleur dans le prochain lot et te les faire livrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280404,
					"content": "Merci beaucoup, monsieur Gui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280405,
					"content": "#Et voilà pour toi, {M#voyageur}{F#voyageuse}. Merci pour ton aide ! On devrait rentrer maintenant, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280406,
					"content": "Héhé, papa va être content, j'en suis sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280407,
					"content": "Une minute, Petit Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280408,
					"content": "Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280409,
					"content": "Tu n'étais pas censé vérifier les médicaments ? Tu n'as toujours pas consulté les listes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280410,
					"content": "Euh... Quoi ? Mais... Ça dure tellement longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210280411,
					"content": "Et il y a encore beaucoup à faire, Petit Meng. Allez, continuons la vérification...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Gui l'herboriste"
				},
				{
					"id": 210280412,
					"content": "Ouah... D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				}
			]
		},
