			"dialogs": [
				{
					"id": 220500601,
					"content": "Pfiou... Nous sommes enfin de retour. Mes poils se sont frisés, après tout ce temps passé à ce sanctuaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500602,
					"content": "#Merci beaucoup pour votre aide. Je n'aurais pas pu accorder ma confiance à {M#un meilleur humain}{F#une meilleure humaine}, miaou miaou.",
					"roleType": "TALK_ROLE_NPC",
