					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "La légende raconte que Mikoshi Nagamasa a travaillé pour le Shogunat et que son sens de la justice n'a d'égal que son entêtement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "Sa lignée existe encore aujourd'hui. Toutes les personnes qui portent le nom de « Mikoshi » sont ses descendants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "À propos de Kamuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "On n'en sait pas beaucoup sur lui, à part qu'il est revenu à Inazuma après avoir traversé la mer pour se former auprès des Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "Ensuite, il a créé ses propres « Onmyoudou » et « Shiki Taishou ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "Selon les annales, il a utilisé ses pouvoirs pour sceller le Bake-danuki Ioroi qui semait la pagaille, afin de faire revenir le calme à Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "Mais plus aucune trace de lui ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
