			"dialogs": [
				{
					"id": 220500501,
					"content": "Reposons-nous ici. Je suis fatiguée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500502,
					"content": "N'empêche que c'est comme ce que Hibiki avait dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500503,
					"content": "Les autres îles sont complètement différentes de la nôtre. Puis, je ne savais pas qu'un sanctuaire pouvait être construit sur une aussi grande montagne. Les humains n'ont-ils pas le vertige ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500504,
					"content": "Le Sanctuaire d'Asase reste quand même le meilleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500505,
					"content": "Où est-ce que Hibiki se trouve, au juste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500506,
					"content": "Voulez-vous continuer les recherches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Parlons-en une prochaine fois, je vais dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500508,
					"content": "Parce qu'il y aura une prochaine fois ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "Bien sûr. Hibiki m'a raconté beaucoup d'histoires à propos de la plage, de l'endroit avec plein d'arbres et de la « dame Kitsune ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500510,
					"content": "Je m'en souviens très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500511,
					"content": "Le plus important pour l'instant est de rentrer à la maison. Le Sanctuaire d'Asase a besoin de sa grande prêtresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500512,
					"content": "En résumé, vous rentrez avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
