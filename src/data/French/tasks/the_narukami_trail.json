				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "« Sanctuaire de Narukami »... C'est ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500202,
					"content": "Il y a beaucoup de portails rouges. Les humains aiment-ils beaucoup les portails rouges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500203,
					"content": "On appelle ça des portails torii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "Il y en a aussi au Sanctuaire d'Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500205,
					"content": "Oh, je comprends à présent. Donc, c'est un portail torii. C'est un endroit où vivent les oiseaux, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500206,
					"content": "Donc, plus il y a de portails torii, plus il y a d'oiseaux, n'est-ce pas ? Les oiseaux c'est très bien. Les humains sont plutôt intelligents aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500207,
					"content": "Savez-vous où est Hibiki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500208,
					"content": "C'est désert...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "On dirait qu'il n'y a vraiment personne dans les environs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500210,
					"content": "Pourquoi ne pas interroger les prêtresses du Sanctuaire de Narukami ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500211,
					"content": "Hibiki est certainement une prêtresse aussi... Elles pourraient nous en apprendre plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "Miaou, ce sanctuaire est très grand et plein d'humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500302,
					"content": "Waouh ! La boîte à offrandes et les supports en bois sont aussi impressionnants. Normal qu'il y ait beaucoup de visiteurs ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500303,
					"content": "Prenez-en de la graine. Le Sanctuaire d'Asase ressemblera à ça plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500304,
					"content": "Probablement pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "Je ne vois toujours pas Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500307,
					"content": "Hum, allons interroger quelqu'un à propos de Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500305,
					"content": "Pourquoi c'est moi qui dois en prendre de la graine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inagi Hotomi",
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "#Bonjour, {M#voyageurs venus}{F#voyageuses venues} de loin, et bienvenue au Sanctuaire de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500402,
					"content": "Si vous avez des problèmes ou si vous voulez simplement faire un vœu, n'hésitez pas à venir ici pour piocher des omikuji. Que l'Archon Électro vous bénisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500403,
					"content": "Nous ne sommes pas là pour connaître notre fortune aujourd'hui, mais pour vous demander quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500404,
					"content": "Oui ? Je vous écoute, alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500405,
					"content": "En résumé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "Hibiki... du Sanctuaire d'Asase ? Vous voulez parler d'« Asase Hibiki » peut-être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500407,
					"content": "Oui, c'est bien elle ! Vous la connaissez ? Savez-vous où elle est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500408,
					"content": "Hum... Hein ?! Ce chat vient de parler ou c'est moi qui hallucine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500409,
					"content": "Les humains, vraiment... C'est si bizarre de m'entendre parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500410,
					"content": "Connaissez-vous Hibiki ? Savez-vous où elle se trouve ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500411,
					"content": "C'est quand même étrange de se faire questionner par un chat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500412,
					"content": "Enfin, si c'est bien la même « Asase Hibiki » que vous recherchez, vous êtes malheureusement à la mauvaise adresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500413,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500414,
					"content": "À la mauvaise adresse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "J'ai vu son nom dans des textes anciens bien préservés. Elle était la dernière grande prêtresse du Sanctuaire d'Asase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500416,
					"content": "Il y a quatre cents ou cinq cents ans, les « Trois Yougou » : Asase Hibiki, Kamuna Harunosuke et Mikoshi Nagamasa se sont rendus au Mont Yougou pour devenir les disciples du Tengu de Yougou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500417,
					"content": "À l'époque, Asase a fait une période d'apprentissage dans notre sanctuaire et est devenue amie avec la Kitsune Saiguu. Cependant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500418,
					"content": "Les Trois Yougou se sont séparés après qu'un « désastre » est survenu. Ce dernier est assez vague, les textes ne l'expliquent pas... Kamuna Harunosuke a traversé la mer et s'est rendu à Liyue pour étudier la maîtrise des puissants pouvoirs des Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500419,
					"content": "Mikoshi Nagamasa est retourné à la Cité d'Inazuma pour servir le Shogunat. Quant à Asase Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500420,
					"content": "Elle est revenue sur l'Île de Seirai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Oui, mais on ne connaît pas les détails. Les textes historiques sur lesquels s'appuyer sont peu nombreux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500423,
					"content": "Attendez un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Hmm... Elle a dit quatre cents ou cinq cents ans plus tôt. Ça veut dire que Hibiki a vécu il y a trèèèès longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500425,
					"content": "Neko aurait donc 400 ou 500 ans ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500426,
					"content": "Miaou ? Je ne sais pas. Que veut dire « 400 ou 500 ans » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500427,
					"content": "Je ne suis pas humaine, alors je ne me soucie pas de ces choses. Je sais juste que le soleil se lève, puis laisse place à la lune et ainsi de suite... La meilleure solution est de dormir si je ne suis pas de bonne humeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500428,
					"content": "Moi aussi, j'aimerais bien vivre cette vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500429,
					"content": "Je ne vois pas vraiment de différence avec celle que tu mènes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "Hé ! C'est méchant, je me fais du sang d'encre pour toi tous les jours, moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500433,
					"content": "Vous avez dit beaucoup de choses que je n'ai pas comprises. Où est donc Hibiki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500434,
					"content": "Je vais être franche avec vous. Malheureusement, je crains que Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500435,
					"content": "Hibiki n'est pas ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "O—Oui ! Hibiki est partie ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500438,
					"content": "Vous avez raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500439,
					"content": "Que peut-on y faire ? Hibiki est comme mes petits chenapans, toujours à vadrouiller où bon lui semble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500440,
					"content": "En tout cas, merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500441,
					"content": "On vous laisse, à bientôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "*soupir* Prenez soin de vous. N'hésitez pas à venir me voir en cas de besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500431,
					"content": "Les chats peuvent-ils vivre aussi longtemps ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500432
					]
				},
				{
					"id": 220500432,
					"content": "Pas que je sache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500421,
					"content": "Elle est donc retournée là-bas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				}
			]
		},
		{
