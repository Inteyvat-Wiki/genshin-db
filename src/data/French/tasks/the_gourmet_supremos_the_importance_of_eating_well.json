			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "#Parvaneh... et {M#le voyageur}{F#la voyageuse} ? Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160202,
					"content": "Je viens vous donner un coup de main.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "Je vois, merci beaucoup. Julie semble s'être aventurée encore un peu plus loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160204,
					"content": "Les monstres sont nombreux, ce qui rend les choses difficiles seulement à deux. Mais c'est une autre histoire si vous nous accompagnez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160210,
					"content": "Allons-y. Elle se trouve certainement dans la forêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160205,
					"content": "Je suis là pour le festin que vous m'aviez promis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "Bien sûr, je n'ai pas oublié. Malheureusement, je ne peux pas cuisiner un festin à moi tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160207,
					"content": "Que diriez-vous de nous aider à retrouver Julie d'abord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160208,
					"content": "Julie s'est aventurée très loin. Les monstres sont nombreux, ce qui rend les choses difficiles seulement à deux. Mais c'est une autre histoire si vous nous accompagnez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160209,
					"content": "Une fois qu'on aura ramené Julie, j'honorerai ma promesse de festin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh",
					"Xudong",
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "Hé, mais avec quoi on cuisine si tu casses le wok ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160302,
					"content": "Ne sous-estime pas le talent des forgerons liyuéens. J'utilise ce wok en fonte pour m'entraîner à faire sauter les ingrédients, il ne se cassera pas aussi facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160303,
					"content": "Puis, ce ne sont que quelques monstres. Un wok ne sert à rien s'il ne peut pas les assommer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160304,
					"content": "Tu en attends vraiment trop d'un simple wok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160305,
					"content": "Xudong en impose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "Et comment ! J'ai suivi un entraînement de chef après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160307,
					"content": "Quoi ?! Depuis quand les cuisiniers apprennent à se battre contre des monstres avec des woks en fonte ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160315,
					"content": "Bien, Julie, allons-nous-en d'ici maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160316,
					"content": "A—Attendez ! Il faut aller aider monsieur Kamei ! Il est en train d'affronter des Oni des mers tout seul dans la forêt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160317,
					"content": "Tu es sûre que c'étaient des Oni des mers et pas des monstres normaux ? Pourquoi devrait-on s'en mêler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160318,
					"content": "J—Je t'expliquerai plus tard... Allons vite l'aider ! Il est vraiment tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160319,
					"content": "#C'est compris. {M#Voyageur}{F#Voyageuse}, si vous pouviez rester encore un peu avec nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160320,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "Dépêchons-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160321,
					"content": "Vous voulez affronter les Oni des mers ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "Oui ! Mon wok brûle d'impatience de les frapper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160323,
					"content": "Puis, un cuisinier ne peut pas fuir devant le danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160324,
					"content": "Je t'ai déjà dit qu'il ne fallait pas trop en attendre des cuisiniers et de leurs woks !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160308,
					"content": "Où peut-on acheter le même genre de wok ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "Hahaha ! C'est le patron des Ferronniers de Hanfeng qui me l'a confectionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160310,
					"content": "Il l'aurait même renforcé avec du minerai provenant du Gouffre. Allez le voir si ça vous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160311,
					"content": "Par contre, j'ai entendu dire que le Gouffre est scellé depuis un moment. Peut-être qu'il ne pourra pas recréer ce wok même si vous le lui demandiez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160312,
					"content": "Parvaneh est pas mal non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "Hein ? Ah, mais... Hahaha ! Je n'ai fait que jeter des livres à la tête de ces monstres. C'est grâce à vous que j'ai réussi à en battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160314,
					"content": "Attendez, où est passé mon tome 6 de « Avec les Dieux » ? Oh non, ne me dites pas que je l'ai perdu ? Je ne l'avais pas encore terminé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201604,
			"completionStepIds": [
				2201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
