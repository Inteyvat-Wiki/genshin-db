						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Julie",
					"Xudong",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "*tousse* Désolé que vous ayez à me voir dans cet état...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160402,
					"content": "Vous n'avez rien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160403,
					"content": "Ce ne sont que quelques égratignures, rien de grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160404,
					"content": "Julie, c'est le moment de tout nous raconter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160405,
					"content": "Raconte-nous tout en détail, sinon j'aurai sacrifié mes livres pour rien... Ah... Les pages sont toutes froissées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160406,
					"content": "C'est très simple : je voulais seulement apporter à manger à monsieur Kamei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160407,
					"content": "Toi alors... Tu lui fais aveuglément confiance, alors que tu ne l'as croisé qu'une seule fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160408,
					"content": "Je suis persuadée que c'est quelqu'un de bien ! Il nous a donné à manger quand on avait l'estomac vide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160409,
					"content": "Et quelqu'un qui accepte de faire ça alors qu'il a lui-même faim ne peut pas être méchant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160410,
					"content": "Ta conception du bien et du mal est vraiment trop naïve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160411,
					"content": "Tu dois vivre dans un conte de fées, mais pas sur Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160412,
					"content": "Hahaha ! Je trouve que Julie n'a pas tort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160413,
					"content": "Je pense que les personnes qui arrivent à garder leur sang-froid même lorsqu'elles ont faim ne peuvent pas être mauvaises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160414,
					"content": "Votre logique est quand même assez simpliste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "Bref. Continue, Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160416,
					"content": "J'avais préparé des brochettes de poulet et de champignons en espérant trouver monsieur Kamei sur le lieu de notre première rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160417,
					"content": "Et il était bien là quand je suis arrivée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160418,
					"content": "Je m'apprêtais à lui dire bonjour, quand j'ai vu qu'il faisait face à des Oni des mers. Ils étaient en train de se dire quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160419,
					"content": "Ensuite, je voulais partir, mais je me suis fait repérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160420,
					"content": "Laissez-moi continuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160421,
					"content": "Parmi ces... gens, il y avait d'anciens amis avec qui j'ai servi le Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160422,
					"content": "Nous avons quitté l'organisation pour gagner notre vie à la suite de tous ces changements soudains à Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160423,
					"content": "Ils étaient donc en train de « gagner leur vie » tout à l'heure ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "... En effet. Nous ne savons rien faire à part brandir nos épées pour subvenir à nos besoins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160432,
					"content": "Par la suite, mes anciens collègues ont formé les Oni des mers et se sont tournés vers le vol pour survivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160433,
					"content": "Je ne voulais pas finir comme eux, alors j'ai essayé de chercher du travail par-ci, par-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160434,
					"content": "Mais personne ne voulait m'embaucher après avoir entendu que j'étais un ancien samouraï à la solde du Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160435,
					"content": "Comme vous avez pu le voir, je ne pouvais que chercher de la nourriture dans les contrées sauvages pour subsister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160436,
					"content": "Ces derniers jours, les Oni des mers recrutent activement. C'est pour cela qu'ils viennent me voir tous les jours. Bien sûr, je refuse à chaque fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160437,
					"content": "Aujourd'hui, après l'apparition de Julie, ils ont cru que j'avais cherché de l'aide d'un clan pour me débarrasser d'eux, alors ils nous ont attaqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160438,
					"content": "Ça n'a pas de sens...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "Ça n'en a jamais avec eux, mais ce n'est pas surprenant dans leur situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160444,
					"content": "Puis, monsieur Kamei s'est occupé de ces vauriens pendant que je restais à l'attendre. Quand soudain, un groupe de monstres a débarqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160445,
					"content": "Vous avez pu en venir à bout ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "Je n'ai aucun problème d'habitude, mais je suis partie le ventre vide ce matin, alors je n'avais pas de forces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160447,
					"content": "Et j'ai laissé tomber mes brochettes quand je me suis fait surprendre par les Oni des mers... Heureusement que monsieur Kamei m'a protégée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160448,
					"content": "C'est pour ça qu'il faut toujours manger son petit déjeuner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "Il y a encore beaucoup d'Oni des mers à Inazuma. Nous allons rester ici pendant un bout de temps, alors je ne suis pas rassurée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160451,
					"content": "Avec notre nombre, on peut repousser des petits monstres, mais c'est peine perdue face à des guerriers experts en arts martiaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160452,
					"content": "Ah... Vous disiez chercher du travail, monsieur Kamei ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160453,
					"content": "Pourquoi ne pas vous joindre à nous si vous le souhaitez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160454,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160455,
					"content": "Mais il a dit lui-même que c'était un ex-samouraï du Shogunat, non ? Cela ne risque pas de nous attirer des ennuis à Inazuma ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160456,
					"content": "... Vous avez raison. À cause de mon identité, je vous expose à des problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160457,
					"content": "Hahaha ! Je trouve qu'il n'y a pas de quoi s'inquiéter. De toute façon, nous ne faisons rien à part chercher des ingrédients de cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160458,
					"content": "Ce travail n'a aucun rapport avec le Shogunat ou ses samouraïs. Il est donc parfait pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160459,
					"content": "Admettons que vous travailliez comme garde ou dans la sécurité, cela attirerait de l'attention indésirable sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160460,
					"content": "De plus, je trouve que ce n'est pas juste que quelqu'un d'aussi honnête ne puisse pas se nourrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160461,
					"content": "Je ne peux pas permettre cela en tant que chef cuisinier. Je sais que je ne peux pas résoudre tous vos problèmes, mais laissez-moi au moins cuisiner pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160462,
					"content": "Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160463,
					"content": "Héhé. Alors qu'en dites-vous ? On ne gagne pas beaucoup d'argent, mais on se remplit bien la panse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160464,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160465,
					"content": "À vos ordres, chef !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160466,
					"content": "Trop bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160467,
					"content": "Je suppose que ce n'est pas trop mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160468,
					"content": "Parfait ! Je suis certain que vous devez mourir de faim après toutes ces aventures. Il n'y a pas de quoi faire la cuisine ici, mais je vais trouver un moyen de vous régaler quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160469,
					"content": "#Reposez-vous, {M#voyageur}{F#voyageuse}. Je m'occupe de tout ! Vous n'avez qu'à attendre que le repas soit servi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160470,
					"content": "C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160471,
					"content": "Et le tour est joué, haha ! J'ai fait quelques onigiris avec des restes. Ce n'est pas très fin comme gastronomie, mais ils nous rempliront l'estomac. Bon appétit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160472,
					"content": "#Au fait, {M#voyageur}{F#voyageuse}. Merci beaucoup de nous avoir accompagnés. Je vous offre cette recette en cadeau ! C'est Munehisa qui me l'a donnée tout à l'heure. Je vous en ai fait une copie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160473,
					"content": "Il a dit que c'est une recette qu'il a apprise pendant son service au Shogunat. Apparemment, elle serait spéciale ! N'hésitez pas à l'essayer par vous-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160474,
					"content": "Trêve de bavardage, mon plat ne va pas se manger tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160449,
					"content": "La prochaine fois, n'oubliez pas le petit déjeuner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "Ils sont un peu susceptibles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "C'est normal d'être susceptible dans ce genre de situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160442,
					"content": "Mais je crois qu'ils voulaient juste une raison d'en finir avec moi, celui qu'ils n'arrivaient pas à convaincre, et asseoir leur autorité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160443,
					"content": "Après tout, j'ai refusé leur offre plusieurs fois. Ça a sans doute fini par les énerver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160425,
					"content": "Alors, les Oni des mers sont...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "Eh bien, pas tous. Mais ils n'en restent pas moins des lâches qui lèvent leurs épées sur les faibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160427,
					"content": "Pourquoi avez-vous arrêté de travailler pour le Shogunat ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "Je n'étais tout simplement pas d'accord avec certaines de ses actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160429,
					"content": "Je ne suis qu'un guerrier. J'ignore si celles-ci étaient bonnes ou non pour le pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160430,
					"content": "Tout ce que je sais, c'est qu'elles étaient contraires à mes principes. Alors, j'ai choisi de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160431,
					"content": "Haha ! Peut-être que je suis juste vieux jeu... Je dois être risible à vos yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160501,
					"content": "Je crois que je suis en train de caler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160502,
					"content": "Pourquoi l'avez-vous aidé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "Qui ? Munehisa ? Je n'ai fait ce que n'importe quel chef cuisinier aurait fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160504,
					"content": "Je plaisante ! Mais il est vrai que je ne voulais pas voir un homme honnête ne pas manger à sa faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160505,
					"content": "Non, je souhaite que tout le monde puisse manger à sa faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160506,
					"content": "La faim est une sensation terrifiante... et je sais de quoi je parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160507,
					"content": "Les gens sont capables d'actes effroyables quand ils ont faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160508,
					"content": "Je crois que nous éviterions bien des problèmes si tout le monde pouvait se nourrir correctement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160509,
					"content": "Je ne peux pas nourrir tout le monde, mais en tant que chef, je dois m'assurer que mes compagnons ne manquent de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160510,
					"content": "Hahaha, pour dire les choses simplement, je veux juste que tout le monde puisse manger et bien. Un idéal plutôt terre-à-terre, j'imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160511,
					"content": "Je trouve que c'est un beau rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "Merci, héhé. Assez parlé, reprenez-en un peu. Il ne faudrait pas en laisser, ça serait un crime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160513,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160514
					]
				},
				{
					"id": 220160514,
					"content": "#Vous partez déjà ? Vous êtes {M#sûr}{F#sûre} que vous n'en voulez pas encore un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
