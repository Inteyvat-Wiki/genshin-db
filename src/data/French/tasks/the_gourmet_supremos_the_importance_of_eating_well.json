			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160802,
					"content": "Pourquoi avez-vous accepté l'offre de Xudong ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Pour la raison qu'il a avancé : il n'y a pas de meilleur travail si je veux être sûr de bien manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160804,
					"content": "De plus, mademoiselle Julie et sieur Xudong, sont des personnes d'une grande intégrité, c'est un honneur pour moi de voyager avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160805,
					"content": "Quant à Parvaneh... Elle fait preuve de beaucoup de prudence, alors je comprends qu'elle soit sur ses gardes avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160806,
					"content": "Malgré cela, elle ne s'est pas opposée à ce que je les rejoigne. C'est amplement suffisant pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160807,
					"content": "C'est vrai que vous avez vagabondé pendant tout ce temps ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Je ne mens jamais. Après avoir quitté le Shogunat, j'ai été un peu partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160809,
					"content": "En général, je me nourrissais de fruits sauvages, et quand j'avais de la chance, j'arrivais à chasser un peu de gibier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160810,
					"content": "Parfois, j'aidais des gens à repousser des monstres ou des Oni des mers pour qu'ils me récompensent en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160811,
					"content": "Haha... Tout compte fait, mes perspectives professionnelles étaient plutôt limitées. Je ne suis bon qu'à combattre avec mon épée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160812,
					"content": "Ma réputation d'ancien samouraï du Shogunat n'est pas un cadeau non plus. Les gens m'associent toujours aux Oni des mers, alors ma recherche d'emploi était encore plus difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160813,
					"content": "Je n'ai pas de logement à Inazuma, ni de famille. Vagabonder était la seule option pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160814,
					"content": "Pourquoi avez-vous arrêté de travailler pour le Shogunat ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "Je n'étais tout simplement pas d'accord avec certaines de ses actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160816,
					"content": "Je ne suis qu'un guerrier. J'ignore si celles-ci étaient bonnes ou non pour le pays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160817,
					"content": "Tout ce que je sais, c'est qu'elles étaient contraires à mes principes. Alors, j'ai choisi de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160818,
					"content": "Haha ! Peut-être que je suis juste vieux jeu... Je dois être risible à vos yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160819,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		}
	]
