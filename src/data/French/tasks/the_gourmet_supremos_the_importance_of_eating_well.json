				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160601,
					"content": "C'est délicieux, héhé. J'en reprendrais bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160602,
					"content": "Pourquoi vouliez-vous lui apporter à manger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "Je ne supportais pas de voir monsieur Kamei affamé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160604,
					"content": "De plus, la dernière fois, il avait l'air mal en point. Du coup, je me suis dit que c'est parce qu'il devait avoir faim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160605,
					"content": "C'est pour cette raison que je voulais lui apporter à manger et lui rendre le sourire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160606,
					"content": "Pourquoi lui faites-vous confiance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "J'ai écouté mon intuition d'aventurière. Croyez-moi, je sais bien différencier les gens honnêtes des gens malhonnêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160608,
					"content": "Puis, je pense sincèrement qu'une personne qui partage son repas alors qu'elle a faim ne peut pas être mauvaise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160609,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "Au revoir. Je ne manquerai plus jamais mon petit déjeuner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
			"id": 2201607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
