			"dialogs": [
				{
					"id": 790501501,
					"content": "Et voilà, c'est réparé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501502,
					"content": "Voir les Gouttelettes si heureuses me remplit de joie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501503,
					"content": "Nous avons sauvé leur amitié.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Les amies du peintre sont à nouveau heureuses et son travail dans le Mirage de veluriyam est réparé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "Peut-être qu'un jour, ce peintre reviendra rendre visite à ses amies et contempler son chef-d'œuvre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "En parlant de ça, le style de cette peinture est assez unique... Même si ce n'est pas très sophistiqué, je la trouve magnifique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "Et le plus important, c'est que je puisse la comprendre ! Peut-être que si j'imite son style, je pourrais aussi peindre de beaux tableaux qui seront accessibles au plus grand nombre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501509,
					"content": "Les peintures remarquables ne sont pas nécessairement compliquées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "Oui, prenons une photo de ce tableau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501512,
					"content": "Comme ça, je pourrai l'étudier quand je voudrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501514,
					"content": "Peut-être que si je peins quelque chose d'aussi joli, cela attirera de nombreuses Gouttelettes qui voudront devenir mes amies !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501510,
					"content": "Tu veux apprendre à peindre comme ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501504,
