			"dialogs": [
				{
					"id": 750350401,
					"content": "Bienvenue dans notre boutique ! Si vous souhaitez que nous taillions une pierre précieuse, vous êtes au bon endroit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350402,
					"content": "Bonjour ! Nous avons une pierre précieuse que nous souhaiterions faire tailler sur mesure. C'est pour notre compagnon tepetlisaure, voici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350403,
					"content": "Waouh ! Cette pierre est d'une qualité vraiment exceptionnelle ! Regardez la taille et la pureté... Si vous souhaitez un travail personnalisé, c'est une tâche relativement complexe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350404,
					"content": "J'ai l'impression d'avoir déjà entendu ça quelque part. Tu veux dire que ça va coûter plus cher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350405,
					"content": "Bien sûr que non ! Pour quel genre de personne me prenez-vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350406,
					"content": "Notre boutique est spécialisée dans l'art de tailler et de polir les pierres précieuses. Si nous en trouvons une de qualité supérieure, nous préférons la polir gratuitement plutôt que de laisser passer la chance de la tailler. Sa beauté servira de vitrine sur le monde pour notre boutique. Nous ne profiterions jamais des clients !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350407,
					"content": "Mais tout comme un bon artisan recherche les meilleurs matériaux avec lesquels travailler, les meilleures pierres précieuses nécessitent également un artisan suffisamment talentueux pour les tailler. Or, il se trouve que je connais justement un maître joaillier, et il serait parfait pour rendre justice à cette pierre précieuse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350408,
					"content": "Waouh, c'est super ! Appelez-le sans plus attendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350409,
					"content": "Héhé, mais vous devriez peut-être prendre rendez-vous à l'avance. Sinon, il sera probablement en quête d'inspiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350410,
					"content": "En quête d'inspiration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "C'est exact ! La vision de maître Kulahaw est un peu particulière, même pour un maître artisan. Il estime que les artisans ne doivent pas se contenter de tailler une pierre précieuse selon un plan, mais qu'ils doivent comprendre comment observer toute la beauté que la nature a à offrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350412,
					"content": "Par exemple, apprendre les techniques de polissage à partir des minuscules ondulations à la surface d'un lac, ou les motifs de chantournage à partir des nuages qui s'élèvent et changent de forme... Il appelle ça cultiver l'inspiration !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350413,
					"content": "Euh... Ça a l'air un peu compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350414,
					"content": "#Mais si vous êtes {M#pressés}{F#pressées}, vous pouvez essayer de trouver là où il est parti chercher l'inspiration ! Je vais vous indiquer où il a dit qu'il allait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
