						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "Pour un maître, vos métaphores ne sont pas très magistrales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Hé, je ne suis pas un conteur ! En réalité, tout ce que j'ai à faire, c'est de me souvenir des belles couleurs de la nature... Utiliser de jolis mots pour les décrire n'est pas mon fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "Vous pouvez me laisser la pierre. Comme je l'ai déjà dit, je la taillerai gratuitement, en remerciement de votre aide pour récupérer mes outils. Quant au temps que ça prendra... Passez à la Gemmeterie dans deux jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "Alors, c'est ça que vous appelez cultiver l'inspiration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "Oh ? Vous avez déjà entendu parler de cette pratique ?",
					"roleType": "TALK_ROLE_NPC",
