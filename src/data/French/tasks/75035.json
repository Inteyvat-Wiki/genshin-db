						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#Hmm, {REALNAME[ID(2)|SHOWHOST(true)]} a l'air plutôt content de revenir ici. Peut-être qu'il a quelque chose à nous dire ?",
					"roleType": "TALK_ROLE_NPC",
