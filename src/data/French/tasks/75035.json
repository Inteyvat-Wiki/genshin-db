						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "#On dirait que {REALNAME[ID(2)|SHOWHOST(true)]} apprécie cet endroit ! Mais c'est logique, après tout, tu as dû passer beaucoup de temps ici avant de nous rencontrer...",
