			"dialogs": [
				{
					"id": 750350801,
					"content": "Mes outils sont de retour, c'est incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Je n'avais pas bien vu avant, mais je dois admettre que c'est une très jolie pierre ! Elle est du même jaune charnu qu'une patte d'oiseau... Bah ! Je ne devrais pas utiliser ces maudits voleurs dans mes analogies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Comme le ciel qui s'éclaircit à l'aube, comme les premiers rayons du soleil, ce genre de couleur que prend le ciel tôt le matin... Oui, c'est une bonne description...",
					"roleType": "TALK_ROLE_NPC",
