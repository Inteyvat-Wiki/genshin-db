				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "Ah, vous voilà. Maître Kulahaw a laissé la pierre précieuse taillée dans la boutique et a demandé que je vous la remette personnellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Oh ? Maître Kulahaw n'est pas là aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Non, il est encore sorti dans l'espoir de trouver l'inspiration. Il a d'ailleurs fabriqué un ensemble de cadenas à emporter avec lui. Il a dit que c'était pour empêcher que ses outils ne soient volés... Comme c'est étrange... Qui voudrait voler des outils de coupe pour les vendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Bien sûr que non ! C'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(... Donc Imix ne sait toujours pas qu'ils ont été volés par des oiseaux... Épargnons-lui cet embarras !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "C'est parce que... quelqu'un pensait qu'en volant ses outils, il pourrait devenir aussi doué que lui, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Enfin, n'en parlons plus... Nous allons prendre la gemme ! La forme est tellement jolie, il mérite vraiment son statut de maître !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#On dirait que {REALNAME[ID(2)|SHOWHOST(true)]} l'aime beaucoup aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Merci pour {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Si votre petit saurien l'aime, c'est l'essentiel ! Je ne manquerai pas de transmettre vos compliments à maître Kulahaw. Revenez nous voir à l'occasion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
