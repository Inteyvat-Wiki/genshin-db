						750351209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351209,
					"content": "Ouh hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "Yaa, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "Hein ? Tu veux qu'on se retourne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351212,
					"content": "Tu ne nous aurais pas préparé une surprise, par hasard ? Héhé, on lit en lui comme dans un livre ouvert !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351213,
					"content": "Très bien, alors, on va jouer le jeu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#Paimon et vous vous retournez, et tout ce que vous pouvez entendre, c'est des tintements et des cliquetis continus.\\nOn dirait que {REALNAME[ID(2)|SHOWHOST(true)]} est en train de bricoler quelque chose...\\nAprès un court instant, {REALNAME[ID(2)|SHOWHOST(true)]} laisse échapper un rugissement. Il est probablement temps de vous retourner...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "Waouh, il y a plein de trucs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Laisse-moi regarder ! Alors, une branche bien droite, un rocher bien rond... Et une nourriture étrange avec une couleur et une odeur bizarre qui est là depuis on ne sait combien de jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "#Tu as soigneusement sélectionné et rassemblé tout ça, n'est-ce pas ? Ce sont des cadeaux pour {NICKNAME} et moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "Yaa, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Mais nous ne pouvons pas manger des aliments qui ne sont pas frais ! Quiconque en mange aura de sacrés maux d'estomac, et toi y compris ! Nous devons donc d'abord régler ce problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351220,
					"content": "Raouh yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "Par contre, cette branche est vraiment impressionnante !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Tu as raison ! Je suis sûre qu'elle serait aussi impressionnante qu'une épée de maître !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351225,
					"content": "Yaa, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "Hmm, nous acceptons tout ça avec plaisir ! Héhé, on va mettre tout ça dans la pochette secrète du sac à dos ! Peut-être que ça sera utile un jour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Hmm, puisque {REALNAME[ID(2)|SHOWHOST(true)]} nous a fait un cadeau, nous devrions aussi lui en offrir un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Laisse-moi voir ce qu'il y a dans la cachette secrète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "C'est rare de te voir si généreuse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} a fait tout son possible pour nous montrer à quel point il tient à nous. Ce n'est pas quelque chose à prendre à la légère ! Et puis, si le sac devient trop lourd, je ne pourrai pas bien voler. Alors, autant lui donner quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#Et voilà ! C'est une pierre précieuse particulièrement brillante ! Tu l'aimes, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351234,
					"content": "Yaa, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Oh ! En te voyant si heureux, on dirait que j'ai bien choisi... Hé, fais attention, ne la laisse pas tomber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "#... J'ai l'impression que {REALNAME[ID(2)|SHOWHOST(true)]} va la perdre s'il la conserve comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "Pourquoi n'allons-nous pas trouver les Enfants des échos ? Ils ont des maîtres joailliers qui pourraient la tailler pour nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Qu'est-ce que tu as planqué, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
				{
					"id": 750351232,
					"content": "#J'ai dit que c'était ma cachette secrète ! Même si nous sommes les {M#meilleurs amis}{F#meilleures amies} du monde, je ne peux pas vraiment te répondre ! Enfin, il y doit y avoir quelque chose qu'on pourrait offrir à {REALNAME[ID(2)|SHOWHOST(true)]} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351223,
					"content": "Ce rocher est vraiment rond !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351224
					]
				},
				{
					"id": 750351224,
					"content": "#Rond et brillant ! Héhé, {NICKNAME} a traversé de nombreuses rivières et nous avons vu beaucoup de rochers ronds, tu peux donc nous croire lorsque nous disons que celui-ci est un joyau parmi les rochers !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
