			"dialogs": [
				{
					"id": 220000201,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "C'est parti alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000203,
					"content": "OK, on commence par là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000204,
					"content": "La scène du vol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Waouh ! Un pirate !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220000206,
					"content": "Lulu, mets-toi derrière moi ! Je vais te protéger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000207,
					"content": "#Tu es {M#un}{F#une} pirate ! Pourquoi tu voles les gens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000208,
					"content": "#Justement parce que je suis {M#un}{F#une} pirate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Un pirate sait faire la différence entre le mal et le bien, c'est pas tous des voleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou est une pirate, pourtant tout le monde l'apprécie, parce qu'elle est très gentille et qu'elle cuisine bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000212,
					"content": "#Pourquoi tu veux être {M#un méchant pirate}{F#une méchante pirate} alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000213,
					"content": "Tu m'as dit toi-même qu'ils étaient méchants tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "#Oui, je me suis {M#trompé}{F#trompée}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Beidou m'a dit que c'est bien de vouloir revenir dans le droit chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000217,
					"content": "Occupe-toi de nettoyer les environs, alors. C'est une bonne action qui fera de toi une bonne personne ou un bon pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000215,
					"content": "Je veux être quelqu'un de bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Tout pirate qui se respecte pille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
