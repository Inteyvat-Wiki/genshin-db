			"dialogs": [
				{
					"id": 220000501,
					"content": "Tout est propre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000502,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Allez, dépêche-toi. C'est pas tous les jours que tu peux te racheter une conduite et devenir une bonne personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000504,
					"content": "Tu ne penses pas que c'est un peu trop facile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000505,
					"content": "#Tu es une bonne personne tant que tu es {M#prêt}{F#prête} à faire de bonnes actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000506,
					"content": "Ce n'est pas si simple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000507,
					"content": "Les bonnes actions font les bonnes personnes, point barre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000508,
					"content": "Si c'est aussi simple, alors pourquoi les méchants existent encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000509,
					"content": "Dans ce monde, les choses sont plus faciles à dire qu'à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000510,
					"content": "C'est bien plus facile de faire le mal autour de soi que le bien aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000511,
					"content": "C'est aussi Beidou qui t'as appris ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000512,
					"content": "Non, je l'ai lu dans un livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				}
			]
