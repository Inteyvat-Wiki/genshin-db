			"dialogs": [
				{
					"id": 220000301,
					"content": "Tu as fini de nettoyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Beau travail ! Prends ça en cadeau. Merci d'avoir joué avec nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000304,
					"content": "Tu dois devenir quelqu'un de bien plus tard toi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000305,
					"content": "Et je pourrais être capitaine de mon propre navire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000306,
					"content": "La prochaine fois, ça sera toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000307,
					"content": "Hmph, c'est ce que tu as dit la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				}
