			"dialogs": [
				{
					"id": 220000101,
					"content": "Comment on joue aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000102,
					"content": "Hmph, je ne joue pas si on n'a pas de pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000103,
					"content": "C'est ça le problème, qu'est-ce qu'on fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000104,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "À chaque fois qu'on veut jouer ensemble, personne ne veut jamais être le pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000106,
					"content": "On ne peut pas commencer notre jeu si personne ne nous vole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000107,
					"content": "#Hé, vous ! Ça te dit d'être {M#le}{F#la} pirate ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000108,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Cool ! On va se préparer alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000115,
					"content": "#Reviens nous voir quand tu seras {M#prêt}{F#prête} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000110,
					"content": "Euh... Comment on y joue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "T'inquiète, je vais t'expliquer ! Hum... les pirates, ce sont des méchants qui volent les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000112,
					"content": "Je n'en ai jamais vu, mais ma sœur m'en a déjà parlé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000113,
					"content": "Alors j'ai pensé que ça serait marrant de se prendre pour eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220000114,
					"content": "Héhé ! Tu vas assurer ! On compte sur toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Petit Meng"
				}
			]
		},
		{
			"id": 2200002,
			"completionStepIds": [
				2200002
			],
			"beginWay": "TALK_BEGIN_NONE",
