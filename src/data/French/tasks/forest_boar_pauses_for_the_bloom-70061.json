			},
			"dialogs": [
				{
					"id": 700610101,
					"content": "Ah, encore... Pourquoi le champ de fleurs est-il de nouveau dans cet état... Vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "#Les fleurs ne vont pas pouvoir être livrées à temps dans ces conditions... Comment vais-je expliquer ça aux clients{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "#Qu'est-ce qu'il se passe{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Le champ de fleurs a été détruit... Elles étaient si belles avant, et maintenant regardez dans quel état elles sont.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "#Tout ça, c'est la faute de cette crapule{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "#C'est inhumain{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "#Oui{NON_BREAK_SPACE}! Ce n'est pas humain... Enfin, façon de parler, parce que celui qui fait ça n'est effectivement pas humain, c'est un sanglier des forêts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "J'ignore pourquoi, mais récemment, il vient toujours grignoter les fleurs et se rouler au milieu du champ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "En plus, il est particulièrement rusé... Dès qu'il entend du bruit et que quelqu'un approche, il s'enfuit aussitôt. Tout à l'heure, il a failli blesser une personne âgée qui passait par là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "#Il exagère{NON_BREAK_SPACE}! Ce n'est pas un gentil sanglier{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "#Attendez, vous êtes le chevalier honoraire, n'est-ce pas{NON_BREAK_SPACE}? {M#Le grand héros}{F#La grande héroïne} qui a sauvé Mondstadt... A—Aidez-moi, s'il vous plaît{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "#D'accord, je vais le chasser{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "Je suis soulagée... Si je me souviens bien, il s'est enfui dans la vallée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Mais cette bestiole est particulièrement rusée, il faudra sans doute utiliser des fleurs pour l'attirer... Malheureusement, le champ de fleurs est dans un sacré état...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "#Vous pourriez cueillir quelques fleurs de Vent-repos en chemin pour l'attirer et lui faire savoir ce que ça fait de se faire avoir{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
