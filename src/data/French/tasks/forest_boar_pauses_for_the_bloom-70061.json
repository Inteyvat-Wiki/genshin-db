			"dialogs": [
				{
					"id": 700610701,
					"content": "#Oh... Vous revoilà{NON_BREAK_SPACE}? Comment ça s'est passé{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "#On l'a fait fuir{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Ah, merci infiniment. Tenez, voici votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Tout travail mérite salaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Maintenant, on va pouvoir remettre en état le champ de fleurs. J'espère que cette fois, aucune autre créature ne viendra nous embêter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		}
