			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "Bonjour, ça vous dit d'essayer la « Poursuite du vent » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590102,
					"content": "C'est quoi la « Poursuite du vent » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "Je suis content que vous demandiez ! La Poursuite du vent, c'est un jeu basé sur l'histoire de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590104,
					"content": "Vous devez avoir entendu parler des aristocrates qui vivaient autrefois dans la Cité de Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590105,
					"content": "C'étaient des tyrans et leur règne était brutal. On ne peut même pas décrire la façon dont le peuple a souffert sous leur joug...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590106,
					"content": "Pour lutter contre leur oppression, un groupe de braves citoyens s'est réuni pour former une résistance clandestine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590107,
					"content": "Ces vaillants rebelles ont mené des opérations dans toute la cité, mettant de sérieux bâtons dans les roues des aristocrates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590108,
					"content": "Mais les aristocrates ont riposté, formant rapidement leur propre équipe d'hommes de main pour réprimer les rebelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590109,
					"content": "Et ainsi, les rebelles se sont battus lutte après lutte avec les laquais des aristocrates dans tout Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590110,
					"content": "La Poursuite du vent s'inspire de ce chapitre passionnant de l'histoire de Mondstadt ! C'était un jeu très apprécié avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590111,
					"content": "« Avant » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "Malheureusement, oui. Les jeunes n'ont pas l'air très intéressés par ce jeu de nos jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590113,
					"content": "Je ne peux pas me résoudre à laisser la Poursuite du vent tomber dans l'oubli. Alors, j'ai modifié un peu les règles pour que ce soit plus accessible et plus amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590114,
					"content": "J'ai également ajouté un tas de nouvelles cartes. J'espère que ça aidera à attirer plus de monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
		{
			"id": 7065903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
