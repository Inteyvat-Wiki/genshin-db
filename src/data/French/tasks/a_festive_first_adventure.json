				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Hmm... Pourquoi personne n'est venu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Je... Je vous en prie, j'ai besoin d'aide ! Vous savez bien que le Festival des lanternes bat son plein, non ? La Guilde souhaite profiter de l'ambiance festive pour recruter de nouveaux aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380104,
					"content": "J'ai entendu que Qian avait trouvé une nouvelle... Comment dire... Une nouvelle combine ! Je ne peux pas me laisser distancer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380105,
					"content": "C'est pour ça que j'ai conçu une nouvelle activité appelée... « Première journée d'aventure » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380106,
					"content": "Pour faire simple, je veux utiliser des lanternes célestes en tant que balises pour tracer un itinéraire de planage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380107,
					"content": "Ceux qui sont intéressés peuvent utiliser leur planeur et suivre cette route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380108,
					"content": "Comme ça, vous pouvez vivre le frisson de l'aventure tout en profitant d'une magnifique vue sur Liyue alors que vous planez le long des lanternes célestes ! Qu'est-ce que vous en dites, pas mal non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380109,
					"content": "J'ai prévu deux itinéraires, mais les Millelithes m'ont ordonné de trouver d'abord quelqu'un pour les tester et évaluer leur sécurité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380110,
					"content": "Vous avez l'habitude, non ? Alors... Si vous êtes d'accord, vous pourriez vous en charger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380111,
					"content": "Aucun problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Merci bien ! Bon, allons d'abord sur les Monts Tianheng. C'est de là que part le premier itinéraire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
