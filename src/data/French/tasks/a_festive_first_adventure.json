			"dialogs": [
				{
					"id": 413380201,
					"content": "Voilà, c'est le point de départ. Vous voyez, j'ai déjà placé les lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380202,
					"content": "#Bon, vous n'avez qu'à commencer quand vous serez {M#prêt}{F#prête}. Attention : vous devez récupérer les lanternes célestes avant d'atteindre la ligne d'arrivée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
