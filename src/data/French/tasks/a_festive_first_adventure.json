				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "Et voilà, c'est l'arrivée ! Vous maîtrisez vraiment bien votre planeur... Alors, votre avis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380302,
					"content": "C'est très amusant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Héhé, bien sûr ! J'ai prêté attention à tous les détails, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380305,
					"content": "Bon, passons au deuxième itinéraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380303,
					"content": "J'aime bien les lanternes célestes qui flottent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
