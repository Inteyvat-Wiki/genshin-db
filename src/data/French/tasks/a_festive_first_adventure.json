			"dialogs": [
				{
					"id": 413380501,
					"content": "Alors, qu'avez-vous pensé de ces deux itinéraires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380502,
					"content": "Pas mal du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "Voilà qui fait plaisir à entendre ! Bon, je peux contacter les Millelithes à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380504,
					"content": "Avec une activité aussi passionnante, on devrait sûrement pouvoir recruter pas mal de monde pour la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380505,
					"content": "Oh, c'est vrai... Voici votre récompense pour avoir testé mes itinéraires. Tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
