			"dialogs": [
				{
					"id": 733560101,
					"content": "C'est vraiment difficile à croire. Je n'aurais jamais imaginé me retrouver ici à prendre le thé avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560102
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560102,
					"content": "Est-ce vraiment si étrange ? Je voulais simplement vous remercier pour le noyau que vous avez fourni pour la matrice arithmétique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560103,
					"content": "Pourquoi parlez-vous comme si vous nous connaissiez parfaitement ? On dirait que vous comprenez notre nature en profondeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560104,
					"content": "Je vous l'ai dit, je suis assez doué pour juger les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560105
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560105,
					"content": "Mais... Ah, vous avez raison. Je ne devrais pas prétendre vous comprendre aussi bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560106,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560107,
					"content": "Comparé à notre dernière rencontre, j'ai l'impression que vous avez beaucoup changé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560108,
					"content": "Hmph ! Peu importe jusqu'où vous voulez remonter pour comparer... Les seuls changements que j'ai opérés consistent à accepter les défauts qui sont en moi et à ouvrir les yeux pour voir certaines choses clairement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560109,
					"content": "#Et vous alors ? En tant que « marionnette » vous aussi, vous arrive-t-il parfois d'avoir des «{NON_BREAK_SPACE}erreurs de décodage{NON_BREAK_SPACE}» dans votre cœur{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560110,
					"content": "Ah... J'éprouve bien plus que de simples erreurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560111
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560111,
					"content": "Je vous écoute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560112,
					"content": "On ne se connaît pas assez bien pour ça pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560113,
					"content": "Hé, très bien. Je ne faisais que poser la question par politesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560114,
					"content": "Quoi qu'il en soit, une marionnette doit faire bien des détours avant de trouver son cœur. Du moins, ça a été mon cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560115,
					"content": "On dirait que vous vous entendiez plutôt bien avec votre créateur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560116
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560116,
					"content": "C'est vrai, il m'a beaucoup aidée et guidée, dans la vie... et après.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560117,
					"content": "À cet égard, il y a une différence fondamentale entre nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560118
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560118,
					"content": "... Oh. C'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560119,
					"content": "Je suis désolée. Même si nous partageons certaines similitudes en tant que marionnettes, je n'aurais pas dû prétendre vous connaître sur cette seule base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560120,
					"content": "#Ne vous en faites pas. Pour reprendre votre expression, j'ai moi aussi « accepté » mes «{NON_BREAK_SPACE}erreurs{NON_BREAK_SPACE}» passées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560121,
					"content": "C'est juste que j'ai déjà fait trop de détours. Je dois parcourir un chemin encore plus long pour les compenser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560122,
					"content": "Dans ce cas... bon courage ? Pour reprendre votre formule, je ne vous connais pas encore assez pour vous donner davantage de conseils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560123,
					"content": "Haha... Bien dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
