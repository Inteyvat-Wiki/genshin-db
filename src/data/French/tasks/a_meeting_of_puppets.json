			"dialogs": [
				{
					"id": 733560201,
					"content": "Nous avons chacun notre propre chemin à suivre. Inutile d'en dire davantage. Ce thé est vraiment excellent, au passage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Type au chapeau"
				},
				{
					"id": 733560202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560204,
					"content": "Très bien, au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Type au chapeau"
				},
				{
					"id": 733560203,
					"content": "L'heure du thé est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
