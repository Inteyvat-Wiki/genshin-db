			"dialogs": [
				{
					"id": 766600101,
					"content": "#Bonjour, {M#aventurier}{F#aventurière} ! Veux-tu que je regarde les missions disponibles pour toi{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 766600102,
					"content": "Ah, je me sens comme chez moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "#Oh... Hum, es-tu {M#pressé}{F#pressée} ? Puis-je t'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 766600105,
					"content": "Mais non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "#On est juste trop {M#heureux}{F#heureuses} de te voir, Catherine ! Tu es vraiment la meilleure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766600108,
					"content": "C'est gentil de ta part, mais si c'était censé être drôle... J'ai peur de ne pas avoir compris la blague...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 766600109,
					"content": "Mais bienvenue à Nod-Krai, une terre pleine d'opportunités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 766600110,
					"content": "Je suis certaine que tu vivras de grandes aventures ici, et que tu découvriras des trésors dont tu n'as jamais osé rêver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 766600111,
					"content": "#Bonne chance, {M#aventurier}{F#aventurière} ! Vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 766600106,
					"content": "On est juste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600103,
					"content": "Ah, heureusement que c'est toi, Catherine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				}
			]
		}
	]
