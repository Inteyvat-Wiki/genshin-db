			"dialogs": [
				{
					"id": 150170101,
					"content": "Oh, vous êtes en avance ! Vous avez hâte de recevoir votre cadeau, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "#Nous sommes simplement {M#heureux}{F#heureuses} de rendre visite à Tlazolli et Nechca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "C'est exact ! Nechca a été tellement malade que Tlazolli a dû abandonner un travail vraiment important...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Les choses s'améliorent peut-être, mais elles ont encore besoin d'un peu de réconfort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Haha, j'ai déjà demandé à quelqu'un de passer et de prévenir Tlazolli de notre arrivée. Elle a probablement fait tous les préparatifs nécessaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Allons-y alors. Tu veux bien surveiller le magasin, Imix ? Je reviens tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "Oui, je me demande ce que peut bien être ce cadeau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Moi aussi... Mais nous sommes aussi là pour prendre des nouvelles de Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Après avoir été aussi malade, je me demande comment elle se porte maintenant. Et puis, il y a Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Elle a dû renoncer à ce qu'elle aime... Nous voulons simplement leur remonter le moral !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1501702,
