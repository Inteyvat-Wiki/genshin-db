						],
						"pointId": 350400107
					}
				]
			},
			"dialogs": [
				{
					"id": 150170201,
					"content": "Nous y voilà. Jolie maison, pas vrai ?. Un instant, je vais frapper à la porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "#Hé, Tlazolli ! {M#Ils}{F#Elles} sont là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "... Tlazolli ? Tu es là ? Ouvre, s'il te plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Étrange... La porte est verrouillée, mais elle ne devrait pas être dehors à cette heure-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "Nechca ? C'est moi, Cheven. Ouvre, s'il te plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "Toujours pas de réponse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Mais c'est étrange, j'en avais parlé à Tlazolli... A-t-elle dû sortir d'urgence avec Nechca pour aller chercher des médicaments ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "Hein ? Qu'est-ce que c'est là-bas ? On dirait un nid de tepetlisaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "C'est exact. Tlazolli a un compagnon tepetlisaure. Si je me souviens bien, son nom est... Iengu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Lorsqu'elle travaillait encore dans le secteur de la forge, elle se faisait souvent aider par Iengu pour certains travaux d'excavation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Mais depuis que Nechca est tombée malade, Tlazolli ne laisse plus beaucoup Iengu creuser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Attendez une minute. Qu'est-ce que...? Cet endroit est en pagaille ! Et Iengu est introuvable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Waouh, regardez toutes ces boîtes cassées ! Il est peut-être arrivé quelque chose de grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Regardons de plus près.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Restez ici, Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Oh... D'accord ! Je vais... trouver un endroit où me cacher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Sérieusement, les lèvres d'Imix ont-elles été bénies par la Wayob ? Chaque fois qu'elle me dit de ne pas aller dans un endroit dangereux, je finis toujours par me retrouver en danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Vous voulez que j'enfonce la porte ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Est-ce qu'il leur serait arrivé quelque chose à toutes les deux ? Ou peut-être que c'est à cause de l'état de Nechca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Ne tirons pas de conclusions hâtives. Elles allaient très bien quand je suis passée hier. Nechca dormait profondément dans sa chambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
