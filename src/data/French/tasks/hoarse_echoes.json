				]
			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "Oh, il y a un tepetlisaure ici. Mais je ne sais pas si c'est le compagnon de Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Au moins, il ne semble pas être en danger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "#Non, attends, nous sommes {M#venus}{F#venues} chercher Tlazolli, mais elle est introuvable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170405,
					"content": "#Hé, {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "C'est Cheven, pourquoi crie-t-elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Il y a quelqu'un à côté d'elle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "Descendez vite, Tlazolli est ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "Hein ? On vient tout juste d'arriver ici, et Tlazolli est déjà de retour ? Quelle coïncidence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "Quoi qu'il en soit, descendons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "Hmm ? Pourquoi ce tepetlisaure nous suit-il... Waouh, hé, ne cours pas, tu vas nous renverser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Vous descendez la montagne avec le tepetlisaure...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, viens ici... As-tu encore été méchant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Bon saurien, c'est bien. Tu as faim ? Désolée... Je te préparerai quelque chose de bon plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Très bien, va jouer maintenant. J'arrive dans un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "#Désolée, {M#tous}{F#toutes} les deux. Je vous attendais à la maison quand Nechca... est sortie en douce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "#Quand je l'ai trouvée, elle m'a dit qu'elle voulait simplement faire un cadeau à nos {M#invités}{F#invitées}, alors elle est sortie chercher de jolies fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Elle cueillait des fleurs en se promenant, mais a fini par se perdre... Heureusement que j'ai réussi à la retrouver à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "Est-ce qu'elle va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "Oui, Cheven nous a dit que son état ne s'était amélioré que récemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "Son corps est encore très faible. Elle a été choquée et exposée à des vents très froids, elle a donc un peu de fièvre en ce moment. Elle a pris des médicaments et est allée se coucher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "Ce n'est rien de grave. Une bonne nuit de sommeil lui fera du bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Cela dit, j'ai peur qu'elle ne puisse pas vous rencontrer aujourd'hui, désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Ce n'est pas grave ! Cheven nous a dit que la maladie de Nechca était très grave et qu'elle est encore en train de se rétablir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "Nous venions simplement voir comment elle allait. Sa santé reste une priorité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "Est-elle guérie maintenant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "... Eh bien, elle peut au moins me parler et vaquer à ses occupations normalement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "C'est déjà bien plus que ce que je pouvais espérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "Allez, ne faites pas cette tête ! Il faut sourire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Nous apprécions qu'elle ait essayé de nous accueillir avec des fleurs. Au fait, Tlazolli, à propos de ce que je te disais tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "Ah, le cadeau !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "Oh ! De quel genre de cadeau s'agit-il ? On peut savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Eh bien, c'est une inscription flamboigemmée. Je l'ai fabriquée à partir du minerai le plus pur et elle est presque totalement résistante à l'érosion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "Les techniques à l'origine de sa fabrication s'inspirent de la création des antiques noms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "C'est donc une sorte de version simplifiée d'un antique nom ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "Hé, ne dites pas ça, vous allez m'attirer la colère de la Wayob. Le processus de fabrication a simplement recours à quelques techniques et matériaux similaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "Quand j'en ai fabriqué une pour la première fois, je ne pensais pas qu'elle pourrait avoir une quelconque utilité pratique, à part être jolie et résistante à l'érosion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Mais Cheven a ensuite suggéré d'utiliser ces cristaux pour créer des ornements uniques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "Des inscriptions flamboigemmées réalisées par une artisane des antiques noms, gravées de mots qui ne s'effaceront jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "Un bon argument de vente qui sonne plutôt bien, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "La description aide vraiment à rendre cet article spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Vous avez le sens des affaires...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Haha, les inscriptions flamboigemmées de Tlazolli sont vraiment spéciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "Le bouche-à-oreille n'est pas toujours fiable. Au fur et à mesure que les informations circulent, elles deviennent incomplètes et sont progressivement oubliées. Peut-être même que des mensonges commenceront à se répandre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Mais si les mots sont inscrits sur ces cristaux, les inscriptions traverseront les âges, plus claires que jamais et impossibles à déformer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "C'est un cadeau idéal, que vous souhaitiez l'offrir à un proche ou à votre partenaire. Vous pourrez même le transmettre aux jeunes générations !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "Vous essayez de me convaincre d'en acheter d'autres, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#Ça m'intéresse ! Hé, {NICKNAME}, pourquoi on n'en achèterait pas une pour y faire graver nos noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "#Et puis, une fois que nous aurons trouvé {M#ta sœur}{F#ton frère}, nous pourrons lui demander d'y graver son nom également.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "Comme ça, nos noms resteront côte à côte pour toujours. Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "On dirait que tu es déjà à fond...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "Ne soyez pas modeste. Après tout, vous m'avez sauvée, et avec moi, le cadeau d'anniversaire de Nechca. Ce n'est vraiment pas grand-chose en comparaison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, je t'ai déjà dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "Ne sois pas modeste non plus, Tlazolli ! C'est un super cadeau. Je sais la quantité de travail que nécessite la fabrication d'une inscription flamboigemmée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "#Merci, Cheven, et vous aussi, {NICKNAME}. Je vais m'en occuper dès que possible. Le moment venu, je vous demanderai de graver l'inscription personnellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Je pense que Nechca devrait aller mieux d'ici là, je suis sûre qu'elle sera heureuse que vous lui rendiez visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Les bonnes choses sont meilleures en bonne compagnie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "#Hé, n'allons pas trop vite. Ces choses pourraient être assez chères... Tu es {M#sûr}{F#sûre} que nous avons assez d'argent pour le voyage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Attends un peu... Ça ne ferait pas partie d'un plan que Cheven a concocté pour nous faire dépenser tout notre argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "C'est possible, qui sait... Vous avez l'air d'avoir de belles économies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#Ah, non ! Tu ne dois pas dépenser tout ton argent, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Haha ! Je vais vous laisser en discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "Hein ?! Il revient ! Vite, barrez-lui la route, je ne veux plus me faire renverser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "Oh, doucement, doucement !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Si ça ne te dérange pas, Tlazolli, j'aimerais que tu m'aides à réparer mon inscription flamboigemmée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Je l'ai laissée tomber lorsque j'ai été attaquée plus tôt. La lanière et le fermoir se sont cassés, c'est pourquoi je ne la porte pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "J'ai essayé de la réparer moi-même, mais ce n'est pas assez solide. Tu voudrais bien m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "Pas de souci, je m'en occupe. Elle sera comme neuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "... Et merci, Cheven, d'avoir accepté de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "Ce n'était pas grand-chose, Tlazolli. Nous voulons surtout que Nechca aille mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "... D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Allez, Iengu, sois sage ! Je te nourrirai dans un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "#{NICKNAME}, Cheven vous contactera une fois l'inscription terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Nous pourrions peut-être faire coïncider ça avec l'anniversaire de Nechca. Comme ça, nous ferons vraiment la fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "Héhé, il y aura sûrement plein de plats délicieux ! Vous pouvez compter sur nous et notre appétit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "Bon, à bientôt, Tlazolli !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Au revoir, prenez soin de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "Je suis sûre que Nechca adorera vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "J'espère que Nechca se rétablira bientôt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Je devrais en acheter pour en offrir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Ça a l'air un peu trop précieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Vous êtes très convaincante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#Oui, ça a l'air d'être un bon produit ! Achetons-en un pour y graver nos noms. Et puis, une fois que nous aurons trouvé {M#ta sœur}{F#ton frère}, nous pourrons lui demander d'également y graver son nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "Pas étonnant que vous ayez votre propre magasin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "Le moment que je préfère !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "J'imagine qu'elle va mieux si elle est partie en courant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Oui, et elle court particulièrement vite quand j'essaye de lui faire manger ses légumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Elle saute sur les chaises, se cache sous la table... Elle court tout autour de la maison aussi. J'ai vraiment du mal à l'attraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "Quand je vois comment elle va maintenant... Je suis déjà très satisfaite, je ne pourrais rien demander de plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "Oui, quelle coïncidence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "Enfin, allons voir en bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170403,
					"content": "On dirait qu'il est monté tout seul...?",
					"roleType": "TALK_ROLE_PLAYER",
