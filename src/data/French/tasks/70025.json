			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu... mimi tomo... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250202,
					"content": "Bonjour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika ! Ah... C'est toi... J'ai eu peur... S'il te plaît, ne me dérange pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250204,
					"content": "Euh, tu ne voulais pas nous voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250212,
					"content": "Hein ? Oh... C'est vous ! Merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250205,
					"content": "Est-ce que mes notes sont correctes ? Ça suffit pour communiquer de manière pacifique avec les Brutocollinus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250206,
					"content": "Ce n'était pas grand-chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Bien, je progresse dans mon dictionnaire ! Preuve que ma théorie selon laquelle humains et Brutocollinus peuvent coexister en paix repose bien sur du solide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250209,
					"content": "Mais c'est quand même dommage qu'on n'ait pas pu communiquer avec cet étrange Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250210,
					"content": "D'après le lexique que j'ai réuni, il se peut qu'il veuille simplement se faire de nouveaux amis dans ce territoire inconnu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250213,
					"content": "C'est bien dommage qu'on n'ait pas pu communiquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250214,
					"content": "Oh, j'oubliais, voici un cadeau en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250215,
					"content": "Tu m'as bien aidée. Si possible, j'aimerais bien travailler encore avec toi sur d'autres projets à l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250211,
					"content": "Quoi ? Alors il sait quand même parler correctement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250207,
					"content": "Je préfère quand même ma méthode habituelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
