			"dialogs": [
				{
					"id": 700250101,
					"content": "#Bonjour {M#aventurier}{F#aventurière} ! Je sais déjà que tu as terminé la mission. La Guilde te remercie ! Voici ta récompense.",
					"roleType": "TALK_ROLE_NPC",
