			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Nora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Vous êtes de sa famille ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "La mère de Nora ne peut pas s'en occuper pour certaines raisons, alors c'est moi qui le fais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Je m'occupe aussi d'autres enfants qui en ont besoin. C'est mon devoir de religieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "C'est comme si j'avais une famille très nombreuse tout à coup ! Ces enfants sont très gentils et ils s'entendent très bien avec Gloria aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Timmy est celui que dont je me suis occupée le plus longtemps. Il m'appelle même « maman » maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Qui est le père de Nora ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Son père s'appelle Patton. Son alcoolisme causait des problèmes à sa vie de famille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "L'Église et l'Ordre de Favonius l'ont averti maintes fois, mais il a continué de boire. En fin de compte, maître Diluc a agi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
