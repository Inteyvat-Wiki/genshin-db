					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "Comment je vais faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "Vous voyez la statue de l'Archon Anémo ? Regardez un peu plus haut, vers sa main !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580104,
					"content": "Je veux aller jouer dessus, mais tata Grace ne veut pas me laisser escalader jusqu'en haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580105,
					"content": "Vous pouvez lui parler pendant quelques minutes ? Ne la laissez pas me voir. Je vais escalader la statue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580106,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "Merci ! Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580110,
					"content": "Allez distraire tata Grace pour que j'y aille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580111,
					"content": "Nora ! Non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580112,
					"content": "*soupir* Je tourne la tête une seconde et elle fait des bêtises ! Je m'excuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580113,
					"content": "Pourquoi t'es méchante ? Je veux juste aller jouer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580114,
					"content": "Non, c'est non. Ton père ne voudrait pas non plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580115,
					"content": "Et vous, ne l'encouragez pas ! Vos proches s'inquièteraient aussi pour vous si vous faisiez des choses aussi dangereuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580108,
					"content": "C'est trop dangereux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "Ça ira ! Je suis forte en escalade !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				}
			]
		},
		{
			"id": 2005802,
			"completionStepIds": [
				2005802
