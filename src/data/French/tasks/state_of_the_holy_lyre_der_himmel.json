			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "Ah, vous revoilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790202,
					"content": "La lyre sacrée ! Vous avez réussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790203,
					"content": "Le motif du vent gravé sur son bois de rose... Ses cordes sont froides au toucher. Rien n'a changé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790204,
					"content": "Alors, Venti ? Est-il possible d'invoquer Dvalin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790205,
					"content": "Bien qu'il s'agisse d'Himmel, la véritable lyre sacrée, je crains que ça ne soit pas possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790206,
					"content": "Cet instrument a vu passer des millénaires. Ses pouvoirs Anémo se sont progressivement épuisés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790207,
					"content": "Dans un état pareil, je ne pourrais même pas l'utiliser pour jouer un morceau à la taverne de maître Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790208,
					"content": "Beaucoup de bardes se battent pour jouer sur ma scène. Un peu de respect, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3790209,
					"content": "Maître Diluc ! Ce n'est pas le moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790210,
					"content": "Et toi, le chanteur... Ne me dis pas qu'on a fait tout ça pour que tu divertisses des ivrognes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790211,
					"content": "Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790212,
					"content": "Comment ça, « héhé » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790213,
					"content": "Quoi qu'il en soit, invoquer Dvalin avec est impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790214,
					"content": "Himmel est en bon état, mais on ne peut pas en dire autant de ses cordes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790215,
					"content": "#À toi de jouer, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790216,
					"content": "Qui ? Moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "Ne t'en fais pas ! La lyre n'est pas cassée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790219,
					"content": "C'est juste que l'intensité de ses pouvoirs a... beaucoup diminué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}, tu as toujours la larme de Dvalin avec toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790221,
					"content": "... (hoche la tête) ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "Je n'y connais rien en réparation d'instruments sacrés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
