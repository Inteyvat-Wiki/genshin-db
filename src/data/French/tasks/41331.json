					"content": "Waouh, plein de trucs trop bons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 413313707,
					"content": "Mamie, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 413313708,
					"content": "Ah, les enfants... Bien, bien, allez-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313709,
					"content": "Vous ne venez pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Moi ? Oh, je ne suis pas pressée. Je veux rester encore un peu pour contempler les lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313711,
					"content": "Oh, j'ai failli oublier... Tiens, c'est pour toi, pour te remercier de nous avoir aidés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313712,
					"content": "Merci, grand-mère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "#Tu seras toujours {M#le bienvenu}{F#la bienvenue}. Tu es encore jeune, ça ne doit pas être facile d'aller et venir comme ça... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313714,
					"content": "Pourquoi ne pas rester un moment au village pour profiter du festival avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313715,
					"content": "Tu as le droit de te reposer un peu, tu sais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
