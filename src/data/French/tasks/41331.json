			},
			"dialogs": [
				{
					"id": 413310301,
					"content": "Il me manque encore tant de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 413310302,
					"content": "#Je suis {M#venu}{F#venue} t'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "Hein ? Oh, tu tombes à pic ! Je me demandais justement comment j'allais faire pour tous ces ingrédients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 413310304,
					"content": "Voyons... Tu penses que tu pourrais m'aider à récupérer trois portions de viande crue et trois autres de volaille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 413310305,
					"content": "Et moi, je m'occupe du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				}
			]
		},
