			"dialogs": [
				{
					"id": 413310601,
					"content": "Bonjour, que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310602
					],
					"speakerTitle": "Oncle Kai"
				},
				{
					"id": 413310602,
					"content": "Je viens à propos des chaises et des tables...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310603
					]
				},
				{
					"id": 413310603,
					"content": "Les chaises et les tables ? Oui, je me souviens. J'ai déjà tout préparé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310604
					],
					"speakerTitle": "Oncle Kai"
				},
				{
					"id": 413310604,
					"content": "Hum... Il doit en rester dans la boutique. Eh bien, prenons tout tant qu'à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310605
					],
					"speakerTitle": "Oncle Kai"
				},
				{
					"id": 413310605,
					"content": "Voilà, ça devrait suffire comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310606
					],
