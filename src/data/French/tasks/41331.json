			},
			"dialogs": [
				{
					"id": 413310501,
					"content": "Oui, c'est suffisant... Puis-je te demander un autre service ? Peux-tu aller dire à oncle Kai d'apporter des chaises et des tables ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310502
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 413310502,
					"content": "J'ai l'intention de faire beaucoup de plats, donc si on attend trop longtemps pour mettre en place les tables, j'ai peur que la nourriture ne commence à refroidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
