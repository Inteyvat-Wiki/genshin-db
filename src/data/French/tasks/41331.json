						413311004
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311004,
					"content": "Si tu veux, passe ce soir, et on les lâchera ensemble pour fêter le festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311005,
					"content": "Mais qui sait où sont passés les autres jeunes ? Je ne peux pas courir bien loin avec ces vieilles jambes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311006,
					"content": "Si tu les trouves, peux-tu les ramener ici ? Je suis sûre qu'ils adoreraient lâcher des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311007,
					"content": "Et n'hésite pas à inviter quiconque tu croiseras sur la route. Après tout, plus on est, mieux c'est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
