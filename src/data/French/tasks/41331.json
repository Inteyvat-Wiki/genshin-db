			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "Et un nouveau Festival des lanternes... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310202,
					"content": "Qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "L'ambiance pendant le festival est censée être festive et animée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310204,
					"content": "Mais au Village de Qingce, les habitants sont soit trop vieux, soit trop jeunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310205,
					"content": "Les adultes sont partis travailler en ville et n'ont pas de jours de repos pour venir céléber avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310206,
					"content": "Ou ils sont partis trop loin pour pouvoir rentrer au village à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310207,
					"content": "Vous savez, le festival est un moment qu'on passe en famille normalement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Je comprends que ce ne soit pas facile pour eux, mais... *soupir* Il s'agit quand même d'un festival important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Ahh... Je ne devrais pas gémir comme ça pendant la période des fêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310210,
					"content": "Au fait, je crois que Xiaobai aurait besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310211,
					"content": "Elle m'a dit qu'elle voulait préparer à manger pour tout le monde, mais j'ai bien peur que ce ne soit trop pour une seule personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310212,
					"content": "Je m'en occupe !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Ah, merci, tu es adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310213,
					"content": "Ne vous inquiétez pas, je vais l'aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
