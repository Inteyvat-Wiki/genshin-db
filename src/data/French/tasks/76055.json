					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550303
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550303,
					"content": "(Ah ! Venez ! Tournez la roue et arrêtez-la ! Il y aura de la délicieuse nourriture !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550304
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550304,
					"content": "(Hein ? Pourquoi vous ne tournez pas la roue ? Allez ! Il y a de la délicieuse nourriture !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550305
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550305,
					"content": "Un petit chien ? Tu me demandes de faire tourner ta roue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550306,
					"content": "(Hé ! Vous pouvez me comprendre ! Oui, tournez la roue, sinon je ne pourrai pas manger quelque chose de délicieux !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550307
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550307,
					"content": "Tu as faim ? Je viens d'acheter des encas. Tiens, sers-toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550308,
					"content": "(Hein ? Vous voulez me donner à manger sans tourner la roue ? D'accord. Pourquoi pas ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550309
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550309,
					"content": "(Merci ! Je m'appelle Pavlov ! Merci, c'était délicieux ! Mais vous n'avez toujours pas tourné la roue.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550310
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550310,
					"content": "Ces friandises sont plutôt bonnes, mais... cette roue dont tu parles... à quoi sert-elle exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550311,
					"content": "(Si vous tournez la roue, de la bonne nourriture tombe quand vous l'arrêtez. Ça a toujours été comme ça !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550312
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550312,
					"content": "(Pourquoi ne le faites-vous pas ? Tout le monde est content après !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550313
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550313,
					"content": "Ça te ferait plaisir que je la fasse tourner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550314,
					"content": "(Oui, oui ! Les gens jouent avec moi, la roue joue avec moi, et il y a de la bonne nourriture... La nourriture, c'est vraiment la meilleure partie !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550315
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550315,
					"content": "Je vois... En effet, c'est important la bonne nourriture. Tiens, prends aussi le reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550316,
					"content": "Je dois aller en racheter. À plus tard, Pavlov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550317,
					"content": "(Mmm... miam, miam ! Au revoir ! Revenez me voir !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
