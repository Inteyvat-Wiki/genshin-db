			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Lauma</color> semble avoir entendu quelque chose...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "... Étrange. J'ai cru entendre quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "#(Ah, {M#chers clients}{F#chères clientes} ! Venez ! Tournez la roue et arrêtez-la ! Il y aura de la délicieuse nourriture !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Hein ? Pourquoi vous ne tournez pas la roue ? Allez ! Il y a de la délicieuse nourriture !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "On dirait... un chiot ? Faire tourner la roue pour de la délicieuse nourriture ? Qu'est-ce que cela veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Hé ! Vous pouvez me parler, vous savez ! Tournez la roue, ou je ne pourrais pas manger quelque chose de délicieux !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "As-tu faim ? J'ai apporté des biscuits. Tiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Hein ? Vous voulez me donner à manger sans tourner la roue ? D'accord. Pourquoi pas ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Merci ! Je m'appelle Pavlov ! Merci pour le biscuit. C'était délicieux ! Mais vous n'avez toujours pas tourné la roue.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Je t'en prie, mais... que veux-tu dire par « tourner la roue » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Si vous tournez la roue, de la bonne nourriture tombe quand vous l'arrêtez. Ça a toujours été comme ça !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "(Pourquoi ne le faites-vous pas ? Tout le monde est content après !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Ça ira. Ta vie a l'air agréable ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Oui, oui ! Les gens jouent avec moi, la roue aussi, et il y a de la bonne nourriture !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Tant mieux. Dis bonjour à ton maître de ma part. Je vais te laisser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Ohh... Au revoir ! Revenez une prochaine fois !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
