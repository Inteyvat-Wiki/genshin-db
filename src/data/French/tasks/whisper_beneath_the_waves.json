							2190.965,
							200.227,
							8784.622
						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "C'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Vous avez vu ça ? L'arbre s'est illuminé tout à coup, et ces petites créatures... Dommage que ce ne soit pas des poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Le truc au milieu, c'est probablement sa racine, non ? Je ne sais pas pourquoi, mais elle brille maintenant. L'arbre est beaucoup plus beau que quand il était tout sinistre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Vous lui racontez ce qui s'est passé précédemment...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "C'est difficile à croire... mais vous n'avez pas de raison de me mentir. On dirait que mon compagnon de pêche à moitié Descendant de givrelune racontait la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Et alors ? Ce ne sont que des illusions du passé. Peu importe ce qu'elles disent ou chantent, ça ne va pas empêcher les vivants de pêcher des poissons vivants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "#Bref, vous êtes aussi des {M#chasseurs}{F#chasseuses} de trésors, non ? L'objet que vous avez ramassé tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "C'est donc ça, la <color=#00E1FFFF>preuve du connaisseur</color> ? On dirait une plume ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Un commerçant que je connais a dit un jour qu'en récupérant cinq <color=#00E1FFFF>preuves du connaisseur</color>, vous découvrirez un fabuleux trésor à l'est de la lune et à l'ouest du soleil. J'ignore si c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Pourtant, de nombreux chasseurs de trésors ont l'air d'y croire. Ils se sont tous rués dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "C'est un trésor, après tout ! Moi aussi, je suis un peu curieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "Si j'avais vingt ans de moins... Non, je serais quand même en train de pêcher. Enfin, je suppose que je vais encore rentrer bredouille aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}