			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2219.314,
							-199.188,
							8840.311
						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Ouah... il y a plein de ces petites choses brillantes qu'on a vues tout à l'heure ! Euh, où est-on ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "On a fait le tour de cet arbre bizarre ? Et ces trucs verts... Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
