			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Encore un jour où je rentre bredouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200102,
					"content": "Que faites-vous là ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Je pêche. Même si j'ai tout attrapé sauf des poissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200104,
					"content": "Je n'aurais pas râlé pour des babioles d'épaves, parce que les marchands ambulants les achètent. Une fois, j'ai pris une botte avec une moitié de... *soupir* Peu importe. Cette conversation va faire fuir les poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200105,
					"content": "Y a-t-il des choses auxquelles je dois faire attention dans le coin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Vous êtes encore à la recherche de trésors ? Apparemment, il existe un fabuleux trésor à l'est de la lune et à l'ouest du soleil... C'est suffisant pour savoir que ce n'est pas ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200107,
					"content": "Oh, d'ailleurs, il y a eu quelques épaves dans les eaux environnantes. Peut-être qu'il y a un trésor dans les profondeurs, mais il n'est pas facile à trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200108,
					"content": "À la taverne, j'ai entendu un des marins survivants raconter qu'il n'y avait pas de lune dans le ciel cette nuit-là, mais que quelque chose brillait au milieu des vagues gigantesques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200109,
					"content": "On dit que c'est certainement un Kratti à un œil, un monstre qui serait capable de dévorer la lune. Il se disputait du territoire avec le serpent de mer géant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200110,
					"content": "Pendant longtemps, cet endroit était aussi noir que de l'encre du comptable. Aucun navire n'osait le traverser. Tout le monde craignait que les âmes perdues sous les vagues les emporteraient avec elles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200111,
					"content": "J'ai entendu dire que des âmes perdues erraient encore près ici, mais ce sont des histoires pour faire peur aux gamins. Je ne crois pas en ces bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200112,
					"content": "À propos de cet arbre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "Il est vraiment sinistre. Autrefois, un tourbillon se trouvait ici. Les marins appelaient l'Œil de Kratti et un jour, cet arbre a poussé à la place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200114,
					"content": "Ce n'est pas le seul phénomène étrange qui s'est produit à cette époque. Quand j'y pense, tout a commencé quand ces pierres sont tombées du ciel... Peut-être que cet arbre vient du même endroit qu'elles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200115,
					"content": "Il y avait aussi des petites choses brillantes qu'on aperçoit de temps en temps. Elles sont très rares. Je me suis dit que de nouveaux types de poissons apparaîtraient aussi, et me voilà venu tenter ma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200116,
					"content": "J'avais un compagnon de pêche, mais il me disait qu'il n'arrêtait pas d'entendre des chants bizarres. Le type a tellement eu peur qu'il n'est jamais revenu. Il n'est qu'à moitié Descendant de givrelune, mais il a hérité de toutes leurs mauvaises habitudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200117,
					"content": "Je vais vous laisser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Pas de problème. Il n'y a pas le moindre poisson en vue pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		},
