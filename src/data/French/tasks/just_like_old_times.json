			"dialogs": [
				{
					"id": 761840301,
					"content": "C'était sympa finalement, ce goûteron. Si j'avais su que c'était aussi amusant, je serais venu bien plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840302,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "D'accord, à la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tartaglia"
				},
				{
