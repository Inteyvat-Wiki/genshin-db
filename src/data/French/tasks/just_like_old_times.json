			"dialogs": [
				{
					"id": 761840101,
					"content": "Hé, voilà qui est inédit. Je ne pensais pas que tu m'inviterais un jour à boire le thé, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840102,
					"content": "Si tu travaillais un peu ton étiquette, je t'aurais invité plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840103,
					"content": "Je suis d'accord. Ça t'aiderait aussi si tu arrêtais de défier tout le monde en duel à tout bout de champ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761840104,
					"content": "Je croirais entendre mes grands frères et sœurs. Je ne peux pas m'en empêcher. À l'époque où mon maître m'entraînait dans la nature, l'étiquette n'était pas vraiment une priorité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840105,
					"content": "Laisse tomber. Ce n'est pas souvent qu'on arrive à se retrouver. Profitons simplement de l'instant présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840106,
					"content": "Hmm ? C'est ta dernière création ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840107,
					"content": "Elle s'appelle Fagio. C'est une Facilitatrice automatisée généraliste interactive et omnitâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840108,
					"content": "Cela signifie-t-il que Pulonia est vraiment irréparable...? Je suis désolé de l'apprendre, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840109,
					"content": "Ça va, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840110,
					"content": "... Je suis désolé d'apprendre que je n'aurai jamais l'occasion de me battre contre lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840111,
					"content": "Évidemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840112,
					"content": "Pulonia avait l'air fort, mais cette « Fagio » semble un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840113,
					"content": "... Tu n'allais tout de même pas dire qu'elle a l'air faible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840114,
					"content": "Euh... Haha, non, non. C'est juste qu'elle n'a pas l'air aussi puissante que Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840115,
					"content": "Hmph. Pulonia a été conçu pour faire des mesures et des calculs. J'ai pris soin de ne pas compromettre sa puissance de traitement lorsque je l'ai doté de capacités de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840116,
					"content": "Mais Fagio n'a pas besoin de traiter des formules complexes. Toute sa puissance de calcul peut être consacrée à son module de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840117,
					"content": "Donc... Ça veut dire qu'elle est en fait plus forte que Pulonia ? C'est possible...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840118,
					"content": "Tu ne seras pas satisfait sans une démonstration, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840119,
					"content": "Que ce soit bien clair, je ne paierai pour aucune réparation si je l'abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 761840120,
					"content": "Et je ne paierai pas tes frais d'hôpital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840121,
					"content": "(*soupir*... Je savais que ça arriverait.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761840122,
					"content": "(*miam miam* ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
