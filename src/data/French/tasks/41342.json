			"trigger": {
				"objectNames": [
					"Marteau Li"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "Cette lanterne céleste, c'est de la part de Sishu, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420603,
					"content": "Vous avez entendu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Ah, je le connais bien. Même pas besoin de deviner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420606,
					"content": "C'est la même chose que l'année dernière... Il est sorti un moment, et puis il est revenu marteler des clous dans la coque d'un bateau toute la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420607,
					"content": "Je sais bien pourquoi il fait ça, mais bon... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420608,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pouvez l'aider ? Se torturer ainsi pendant les fêtes, vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420609,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "*soupir* Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420611,
					"content": "J'imagine qu'il doit être en train de bosser sur la coque d'un navire... Dépêchez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420612,
					"content": "Moi, je vais aller préparer de quoi manger. Revenez quand vous en aurez fini, on mangera ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420604,
					"content": "Comment le savez-vous ?",
