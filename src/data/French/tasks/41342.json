			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sishu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Je suppose que je devrais lui offrir une lanterne céleste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420102,
					"content": "Offrir une lanterne ? À qui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "#Oh, {M#voyageur}{F#voyageuse}, c'est vous ! Eh bien, vous connaissez Wang le costaud, non ? Il s'est toujours occupé de moi, depuis qu'on est petits. Même maintenant, il m'aide tout le temps. C'est un vrai frère pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420104,
					"content": "Mais il travaille sans arrêt pendant les fêtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420105,
					"content": "J'aimerais bien lui offrir une lanterne céleste. On jouait souvent ensemble plus jeunes, il adorait regarder les lanternes s'envoler quand il était petit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420106,
					"content": "#Je suis sûre que ça lui fera plaisir si je lui en offre une. {M#Voyageur}{F#Voyageuse}, pourriez-vous la lui apporter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420107,
					"content": "Pourquoi ne pas l'offrir vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "J'aimerais bien y aller moi-même, mais j'ai encore tellement de choses à faire chez moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420110,
					"content": "Je suis sortie faire quelques emplettes, mais mon mari est resté pour s'occuper de la maison. Je dois me dépêcher de rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420111,
					"content": "Je compte sur vous pour cette lanterne. Quand on aura le temps avec mon mari, on ira rendre visite à Wang le costaud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420112,
					"content": "J'espère qu'il aura un peu de temps libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sishu"
				},
				{
					"id": 413420108,
					"content": "Mieux vaut que vous vous en chargiez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
