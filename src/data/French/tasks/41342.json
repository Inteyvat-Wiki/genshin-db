				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420901,
					"content": "Désolé pour l'attente ! C'est fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420902,
					"content": "Comment ça, tout est réglé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420903,
					"content": "#Bah, c'était pas grand-chose. Et puis, j'avais l'aide de {M#ce voyageur}{F#cette voyageuse}, ça a été vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420904,
					"content": "Sérieusement... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420905,
					"content": "Allez, on est en période de fête. Pas la peine de faire cette tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420906,
					"content": "Sûr, comme tu veux... Et la lanterne céleste, tu l'as préparée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420907,
					"content": "La lanterne céleste... Mince, j'ai oublié. J'ai la tête ailleurs aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420908,
					"content": "C'est pas grave, c'est qu'une lanterne céleste... Tant pis si on doit faire sans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420909,
					"content": "Arrête de dire n'importe quoi ! C'est le festival, oui ou non ? Au festival, on lâche une lanterne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420910,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous aideriez mon ami à fabriquer une lanterne céleste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Marteau Li"
				},
				{
					"id": 413420911,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Merci, on vous attend ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marteau Li"
				}
			]
		},
