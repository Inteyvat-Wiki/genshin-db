			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang le costaud"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Sishu ? Ça... ça vient d'elle ? Faites-moi voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420502,
					"content": "Haha, c'est elle qui a écrit ce vœu pour moi, c'est ça ? C'est vrai que c'était ce que je désirais le plus quand on était mômes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420503,
					"content": "Tant d'années écoulées en un clin d'œil... Ah, le temps passe vite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420504,
					"content": "Par contre... Pourquoi vous demander de la livrer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420505,
					"content": "Elle a des choses à faire chez elle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Oh, je vois... Bien, bien... Très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420508,
					"content": "J'imagine que tout va bien pour elle. C'est tout ce qui compte... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420509,
					"content": "C'est une bonne chose... Désolé... Je dois vraiment y aller. J'ai encore beaucoup à faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413420506,
					"content": "Elle a dû rentrer pour aider son mari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
