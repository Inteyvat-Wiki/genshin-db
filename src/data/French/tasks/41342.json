				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "Oui, ça devrait faire l'affaire. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413421203,
					"content": "Il reste encore quelques bricoles. Vous iriez au port faire l'inventaire des nouvelles marchandises pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413421204,
					"content": "Il devrait y avoir trois caisses, placées sur le quai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wang le costaud"
				},
				{
					"id": 413421205,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Bon, je compte sur vous. Moi, je dois me dépêcher de finir ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang le costaud"
				}
			]
		},
