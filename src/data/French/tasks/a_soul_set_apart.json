			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Dain, vous voilà ! Avez-vous croisé Jean ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030102,
					"content": "Oui, je l'ai vue, mais je l'ai évitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030103,
					"content": "Étant Chevalier du Croc de Lion et Grande Maîtresse suppléante, il serait tout naturel qu'elle ait quelques réserves à mon encontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030104,
					"content": "Si je ne fais pas attention, je pourrais bien devenir un jour l'objet de l'une de ses enquêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030105,
					"content": "Mais revenons à nos Brutocollinus... J'ai vaincu quelques monstres de l'Abîme, mais je n'ai obtenu aucune information. Avez-vous eu plus de succès ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030106,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030107,
					"content": "Bon, nous pouvons plus ou moins nous faire une idée de l'endroit où est allé le « Laboureur originel ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030108,
					"content": "Ah bon ? Rien qu'à partir de l'histoire de Borée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030109,
					"content": "Pas uniquement... En la combinant à une analyse plus complète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030110,
					"content": "En prenant en compte, par exemple, cette histoire ancienne qu'on vous a racontée à la cathédrale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030111,
					"content": "« La fureur finale du tyran » !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Exactement. Cette étrange histoire que vous a racontée cette sœur a longtemps été prise pour la malédiction d'un tyran décédé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030113,
					"content": "Si ces boules de feu étaient en réalité des missiles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "Oh, j'ai compris ! En fait, cette « fureur finale du tyran » n'était en réalité que les missiles tirés par cette machine après qu'elle soit partie du Territoire des Loups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030116,
					"content": "Après son combat contre le Loup du Nord pendant lequel elle a été blessée, elle a dû errer jusqu'aux ruines du vieux Mondstadt et y rester...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030117,
					"content": "Et ensuite, chaque fois que quelqu'un s'approchait, PIF, PAF, BOUM ! Elle tirait des tonnes de missiles... Jusqu'au jour où elle est finalement tombée en panne pour de bon. Alors, les boules de feu ont cessé de pleuvoir du ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030118,
					"content": "À l'époque, les Mondstadtois n'étaient pas familiers avec les Gardiens des ruines, alors ils ont interprété ça comme la « fureur finale du tyran » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030119,
					"content": "On dirait bien qu'il va nous falloir aller jusqu'à l'<color=#00E1FFFF>Antre de Stormterror</color> pour fouiller la zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030120,
					"content": "Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Oh ? Que voulez-vous dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030123,
					"content": "Je... Je m'en souviens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Hein ? Tu veux dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030125,
					"content": "#Oh, moi aussi ! On a vu ce <color=#00E1FFFF>gardien assis au sommet de la tour</color> quand on y est {M#allés}{F#allées} ! Impossible d'oublier un truc comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030121,
					"content": "Ce n'est pas nécessaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Les Mondstadtois d'alors n'ont pas compris ce qu'étaient vraiment ces boules de feu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "Euh, c'était la Diaconesse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
			"completionStepIds": [
				800305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800305",
