						80030506
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80030506,
					"content": "Dainsleif, ennemi de l'Abîme... Toujours aussi agaçant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80030507,
					"content": "Ton âme est souillée par la puanteur du sang, je peux le sentir... Le résultat de tes cauchemars les plus sombres, peut-être... À moins que... Tiens...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80030508,
					"content": "Oh... Il s'agit de quelque chose de bien plus dangereux. Tu empestes d'une corruption qui m'est bien familière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80030509,
					"content": "Toi et moi sommes tous les deux annonciateurs de danger... Mais la place des dangers n'appartenant pas à l'Abîme est dans une cage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Apôtre de l'Abîme"
				},
				{
					"id": 80030510,
					"content": "Tsss.",
