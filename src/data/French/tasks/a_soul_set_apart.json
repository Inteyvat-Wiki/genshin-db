				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "C'est bien ça, non ? Utilise ta vue élémentaire pour retrouver l'œil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030302,
					"content": "Ooooh... Alors, qu'est-ce que tu as vu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030303,
					"content": "Hein ? Rien du tout ? Mais j'étais excitée comme une petite puce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030304,
					"content": "#Qu'est-ce qui s'est passé... Tu es {M#sûr}{F#sûre} que tu as fait comme il faut ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030305,
					"content": "La méthode n'est pas la bonne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030306,
					"content": "L'utilisation de la vue élémentaire sur un Laboureur n'est d'aucune utilité, car il n'est pas alimenté par les éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030307,
					"content": "Laissez-moi essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030308,
					"content": "... Voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030309,
					"content": "Waouh ! C'est... C'est le...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030310,
					"content": "La chose même que l'Apôtre de l'Abîme recherche depuis toujours : « l'œil du Laboureur originel ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030311,
					"content": "Les Gardiens des ruines restants ne sont que des répliques de cette machine. Mais celui-ci était un prototype. Sa capacité de combat était illimitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030312,
					"content": "Un prototype ? Je ne connais pas ce mot... Est-ce que c'est encore un vieux terme de Khaenri'ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030313,
					"content": "Comme l'Ordre de l'Abîme l'a deviné, si cet œil est placé entre les mains de la « statue profanée »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030314,
					"content": "Et si les membres d'Ortell, le Dieu du Vortex, sont attachés à la statue... Alors vous obtenez un dieu mécanisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030315,
					"content": "Ainsi, le dieu nouvellement créé aura le pouvoir de « renverser les trônes divins de Celestia ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "Une opération aussi extrême que dangereuse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "C'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "Mais alors... Que faire de cet œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030320,
					"content": "Cachons-le quelque part où personne ne le trouvera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "Non. Je le protégerai moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030323,
					"content": "Hein ! Vous ! Dain... Vous n'allez rien faire de dangereux avec, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030324,
					"content": "Vous pouvez douter de moi si vous le souhaitez, mais je dois m'assurer qu'il ne tombe pas entre de mauvaises mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030325,
					"content": "Peu importe où nous le cachons, ils le trouveront. Et quant à l'Église de Favonius... Vous savez que je ne leur fais pas confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030326,
					"content": "Oh... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030327,
					"content": "Notre tâche n'est cependant pas encore terminée. Pour éviter de futurs troubles, nous devons également nous occuper de cette « statue profanée ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030328,
					"content": "Et de quelle façon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "Mieux vaut ne pas impliquer l'Église. Occupons-nous-en nous-mêmes... Quant à ce que j'entends par « s'en occuper »... Je veux bien sûr dire qu'il faut la détruire complètement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030331,
					"content": "La... La détruire ?! Mais c'est une Statue des Sept ! En plus d'être une relique culturelle de taille, c'est aussi un objet sacré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030332,
					"content": "Heureusement qu'on n'a rien dit à Barbara tout à l'heure... Sinon, ça la rendrait dingue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030333,
					"content": "Hmm... Les Sept Archons attendent-ils vraiment de moi que je veille sur ce qui leur appartient ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030334,
					"content": "Retournons dans ces ruines et détruisons la <color=#00E1FFFF>statue renversée</color>. Avec un peu de chance, nous croiserons également la route de cet Apôtre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030335,
					"content": "Et je m'assurerai qu'il ne s'échappe pas cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030329,
					"content": "On ne peut pas laisser l'Église s'en occuper ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Confions-le à l'Église de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "L'Ordre de l'Abîme doit être arrêté.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
