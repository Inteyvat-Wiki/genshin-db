					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "#Vraiment ? Tu es {M#sûr}{F#sûre}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "#Au moins maintenant, on a une piste en plus des Sept Archons avec Dain pour retrouver {M#ta sœur}{F#ton frère}, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
