				{
					"id": 80030614,
					"content": "#Tout d'abord, cet Apôtre de l'Abîme a appelé {M#ta sœur « Princesse »}{F#ton frère « Prince »}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#On dirait bien que {M#ta sœur}{F#ton frère} dirige les opérations de l'Ordre de l'Abîme, et a un statut encore supérieur à celui de l'Apôtre de l'Abîme... Mais on ignore si c'est {M#elle la plus haut placée}{F#lui le plus haut placé} dans l'organisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#Ensuite, {M#ta sœur}{F#ton frère} a parlé d'« engloutir les trônes de Celestia » et d'une guerre contre « l'ordre divin ». Qu'est-ce que ça veut dire... {M#Elle}{F#Il} voudrait détruire les Sept Archons et les Sept Nations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Quoi d'autre... Les monstres de l'Ordre de l'Abîme sont en réalité les anciens habitants de Khaenri'ah, transformés après la destruction de leur nation. C'est tout simplement terrifiant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "Et Dain aussi vient de Khaenri'ah, il a assisté à sa destruction il y a cinq cents ans. Mais... lui ne s'est pas transformé, et combat à présent l'Ordre de l'Abîme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Et c'est pour ça que {M#ta sœur}{F#ton frère} a dit que Dain était son ennemi, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Mais... Si les monstres de l'Abîme étaient autrefois les personnes que Dain était en charge de protéger... Pourquoi est-il maintenant l'ennemi de l'Ordre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "#Et puis, comment ça se fait... Tout ce temps passé à chercher {M#ta sœur}{F#ton frère}, pour apprendre qu'{M#elle}{F#il} est du côté de l'Abîme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Beaucoup de nouvelles questions, mais peu de réponses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Oui, tu as raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#Il ne faut pas se laisser abattre, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "Notre voyage est loin d'être terminé, alors allons-y ! Il est largement temps de quitter cet endroit et de retourner là où le soleil brille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Si {M#ta sœur}{F#ton frère} veut que tu atteignes « la fin de ton voyage »... Alors, tu vas lui montrer de quoi tu es capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "#Allez, {M#voyageur}{F#voyageuse}, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Ressasser tout ça ne sert à rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#J'étais trop {M#concentré}{F#concentrée} sur {M#ma sœur}{F#mon frère} pour écouter attentivement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Un objectif supplémentaire à notre périple...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Tu as raison, Paimon. Il y a de l'espoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Hmm, c'est vrai, tu as raison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}