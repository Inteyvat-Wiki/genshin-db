			"dialogs": [
				{
					"id": 220270401,
					"content": "Les dango trois couleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Vraiment ? ... OK ! J'ai justement des dango trois couleurs sur moi. Ma mère m'en a préparé, mais je ne les ai pas encore mangés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Offrons-les aux divinités !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "J'espère que les divinités me béniront et m'aideront à réaliser mon souhait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "Merci de m'avoir tenu compagnie. Prends ce cadeau en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Je reviendrai ici demain. J'espère que les divinités ne m'ignoreront pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
