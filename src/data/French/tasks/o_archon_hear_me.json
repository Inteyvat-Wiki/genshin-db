			"dialogs": [
				{
					"id": 220270301,
					"content": "Nanatsuki m'a donné des conseils, mais je ne vois pas ce que je devrais donner en offrande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Ce que je préfère... Ce sont les dango trois couleurs, j'adore ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Mais n'est-ce pas un peu trop rudimentaire des dango trois couleurs ? J'ai déjà offert des bonbons konpeito et aucune réponse des divinités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "J'ai entendu dire que certaines personnes mettaient des pétales de fleurs fraîches dans des sachets pour en faire une offrande. C'est déjà plus approprié que des dango, je trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "Que faire ? Lequel devrais-je choisir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
