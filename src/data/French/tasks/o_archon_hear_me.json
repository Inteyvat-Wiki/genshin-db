			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Comment fabrique-t-on les objets en laque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270102,
					"content": "Que voudrais-tu faire de ces objets ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "Oh, c'est toi. Hum, as-tu déjà entendu parler de l'intervention divine d'un autel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270104,
					"content": "J'ai entendu des gens dire que nos vœux pouvaient se réaliser si on faisait une offrande d'objets à un autel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270105,
					"content": "Je pense que les objets en laque ont beaucoup de valeur. Si je les offrais au sanctuaire, je suis sûr qu'on répondrait à mes prières !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270106,
					"content": "Je n'ai pas les moyens d'acheter des objets en laque, alors je voudrais en fabriquer un moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270107,
					"content": "Apparemment, mademoiselle Nanatsuki des Laques Yayoi serait douée pour ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270108,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourrais-tu m'accompagner lui demander plus d'informations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270109,
					"content": "Pas de problème, allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270111,
					"content": "Pourquoi tu n'y vas pas tout seul ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Mademoiselle Nanatsuki est quelqu'un de très... austère, je n'ose pas vraiment lui demander conseil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270113,
					"content": "C'est mieux que tu m'accompagnes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202702",
							"2"
						],
						"stepId": 2202702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Bonjour, que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Eh bien, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "On voudrait des renseignements sur les objets en laque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "Ah, tu voudrais faire une offrande d'objets en laque fabriqués par toi-même à l'autel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Je vous en prie, il faut vraiment que mon souhait se réalise ! Et je... je vous promets de ne parler à personne de votre recette secrète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "Ce n'est pas vraiment une question de recette. Pour faire de beaux objets en laque, il faut surtout des années et des années de pratique en plus de la peinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "Puis, ce n'est pas seulement une question de temps, mais plutôt une question de... capital. L'art de la laque se transmet de génération en génération au sein de ma famille. Ça fait quatre générations avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "J'ai même voyagé à Sumeru pour étudier le laquage. Il est donc peu probable qu'on puisse apprendre à fabriquer des objets en laque en un jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "Ah bon ? Mais je ne vois pas ce que je pourrais faire d'autre comme offrande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "Je pense que la valeur monétaire d'une offrande n'est pas ce qu'il y a de plus important. Il faut surtout qu'elle ait une valeur sentimentale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Tant que tu es sincère et avec de bonnes intentions et que tu offres tes objets préférés, je suis sûre que les divinités te répondront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Tant que je suis sincère et avec de bonnes intentions... Mes objets préférés",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Hmm, je crois que je vois ce que vous voulez dire, mais j'ai aussi l'impression de ne pas tout comprendre... Merci quand même, Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "#{M#Voyageur}{F#Voyageuse}, retournons d'abord à l'autel. J'aimerais que tu m'aides à trouver quoi donner en offrande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
