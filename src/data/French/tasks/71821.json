			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "Mais pourquoi c'est tombé sur moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "Qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "#Vous savez, {M#voyageur}{F#voyageuse}, les lanternes célestes doivent être récupérées chaque année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Bien sûr, quand elles sont dans le ciel, c'est très joli... Mais elles peuvent aussi poser problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "Certaines lanternes ne sont pas assez robustes et se brisent en plein vol. Il ne reste ensuite plus que des morceaux de plaustrite qui s'envolent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Et avec les bourrasques de vent, des lanternes peuvent aussi se retrouver coincées partout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "C'est non seulement dangereux, mais ça nuit en plus à la beauté de la ville ! C'est pour ça que le Bureau des affaires civiles affecte toujours quelqu'un pour les récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "Et cette année, c'est tombé sur moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "Mais il y a bien trop de lanternes lâchées pendant le festival cette fois-ci... Ça va être impossible de toutes les récolter après les célébrations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "Le seul moyen, c'est donc que je les ramasse au fur et à mesure que les gens les lâchent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Et même ainsi, je doute que je puisse toutes les récupérer tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "Vous m'aideriez à aller vérifier à ces endroits s'il y a des lanternes à récupérer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "J'ai marqué les endroits sur votre carte, alors je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
