			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling le Poing rapide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "C'est vraiment injuste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "Ling le Poing rapide"
				},
				{
					"id": 718210202,
					"content": "Qu'est-ce que vous faites là ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "Je... Bon, je vous explique... Mon maître a récemment créé un nouveau coup de pied, et sacrément puissant avec ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "Ling le Poing rapide"
				},
				{
					"id": 718210204,
					"content": "Mais il dit que mon cœur manque de sincérité, et que mes connaissances de bases sont insuffisantes. Il refuse de me l'enseigner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "Ling le Poing rapide"
				},
				{
					"id": 718210205,
					"content": "Je pensais profiter du Festival des Lanternes pour lui offrir une jolie lanterne céleste. Comme ça, s'il est de bonne humeur, peut-être qu'il acceptera de m'apprendre cette technique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "Ling le Poing rapide"
				},
				{
					"id": 718210206,
					"content": "Mais je n'arrive pas à trouver de plaustrite... J'ai bien vu une lanterne coincée là-bas, et je voulais récupérer la pierre à l'intérieur, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "Ling le Poing rapide"
				},
				{
					"id": 718210207,
					"content": "Eh bien, vous avez vu ce qu'il s'est passé. Autant que vous gardiez cette lanterne pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "Ling le Poing rapide"
				},
				{
					"id": 718210208,
					"content": "*soupir* M'être fait avoir par ces monstres... Apparemment, mes compétences de base ne sont vraiment pas à la hauteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ling le Poing rapide"
				}
			]
		},
		{
			"id": 7182103,
