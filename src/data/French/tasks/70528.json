			"dialogs": [
				{
					"id": 705280401,
					"content": "*soupir* La Guilde va-t-elle s'en sortir avec tout ce travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "#Ah, {M#voyageur}{F#voyageuse} ! Désolé, j'avais l'esprit occupé par les affaires de la Guilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Vous êtes à Mondstadt pour la Fête des alizées, je suppose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Ça tombe bien, la Guilde des aventuriers propose en ce moment un mini-jeu. Je vous assure que ça sera une partie de plaisir, et en plus, il y a des prix à gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Alors ? Vous voulez essayer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Bien, laissez-moi vous présenter ce mini-jeu. Son inventeur appelle ça les « Échecs floraux ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Il a affirmé que c'est le fait de voir le vent poursuivre des pétales de fleurs virevoltants qui l'a inspiré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "Ce jeu est censé reproduire le romantisme que l'on ressent lorsqu'on poursuit des pétales de fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "S—Sacrée histoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Son créateur est un barde, donc il dispose d'une imagination... débordante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "Pour faire simple, lors d'une partie, le but est de collecter le plus de ballons des alizées éparpillés à l'intérieur de l'échiquier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "En même temps, il vous faudra éviter toutes sortes d'obstacles... Mais bien entendu, vous trouverez aussi des accessoires pour vous aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "Notre ami a même rédigé un manuel exprès pour cet événement, que je vous laisserai consulter un peu plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "Si cela vous intéresse, alors n'hésitez pas à tenter votre chance ! Vous obtiendrez une récompense rien que si vous participez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "C—Ce n'est pas un peu compliqué ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}