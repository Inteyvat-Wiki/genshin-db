			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Tiens ? Vous avez déjà trouvé toutes les répliques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Excellent ! Vous avez un don pour l'archéologie, dites-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Eh bien. Ce cadeau est pour vous. Merci d'avoir participé à l'activité organisée par notre darshan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "#J'espère que vous avez pu découvrir les joies de l'archéologie, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Cela dit, l'archéologie dans la vie réelle a tendance à être un travail plutôt monotone et laborieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Mais c'est quand on découvre une relique essentielle qu'on se dit que tout cela en vaut la peine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "Et si vous échouez à déterrer quoi que ce soit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Si on ne déterre rien... Eh bien, comme on dit chez nous, ce sont des efforts gaspillés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "Et pour être honnête, c'est en fait ce qui se passe le plus souvent. Les fois où nous trouvons quelque chose d'important sont en effet assez rares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Mais pour travailler dans l'archéologie, il faut s'habituer à ces circonstances et garder espoir. Sinon, personne ne pourrait supporter ce travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "#Je suis {M#sûr}{F#sûre} qu'il y a des fois où vous ne déterrez rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
