				"points": []
			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "La perturbation des flux élémentaires me donne des sensations désagréables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Dépêchons-nous de remettre ce temple dans son état normal. J'aimerais me sentir... mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 30814,
			"completionStepIds": [
				30814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
