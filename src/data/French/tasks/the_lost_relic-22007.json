					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070304,
					"content": "Autant retourner voir Bao'er.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070306
					]
				},
				{
					"id": 220070306,
					"content": "OK, allons voir ce que Bao'er a à nous dire.",
