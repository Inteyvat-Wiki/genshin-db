						220070202
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070202,
					"content": "Cette boîte... Ce n'est pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Quoi ? Hé, je te ferai remarquer que j'ai mis plusieurs vêtements à l'intérieur pour l'améliorer quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "Je suis une chercheuse sérieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "Enfin, merci pour ton aide. Je ne servirais pas à grand-chose contre des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
