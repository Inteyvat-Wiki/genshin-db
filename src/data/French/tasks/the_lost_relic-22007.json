					"nextDialogs": [
						220070403
					]
				},
				{
					"id": 220070403,
					"content": "Voyons voir... Diable ! C'est bien une relique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070404
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070404,
					"content": "Hum... Ce n'est pas celle que j'ai perdue, mais... Elle a l'air précieuse malgré tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070405
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070405,
					"content": "Mieux vaut que vous la laissiez à une professionnelle. Ne t'inquiète pas, j'en prendrai bien soin, héhé... Merci à vous.",
