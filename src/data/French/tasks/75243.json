			},
			"dialogs": [
				{
					"id": 752430101,
					"content": "#Ah, {M#cher client}{F#chère cliente}, vous m'avez vraiment sauvé la mise ! Ces Fatui ont dépassé les bornes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "Je ne sais pas d'où viennent ces imbéciles, mais ils n'ont même pas pris la peine de me menacer... Ils ont juste plongé leurs mains dans mon sac ! Ce sont des voleurs, je vous dis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "#Heureusement que vous êtes {M#intervenu}{F#intervenue} ! Sinon, j'aurais subi de lourdes pertes... Je vous prie d'accepter mes remerciements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "Oh, c'est vrai. J'ai failli oublier de vous présenter cet endroit. Voici le Parc des alpagas. Vous pouvez y voir de gentils alpagas, et aussi acheter des jouets à leur effigie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "Mais ces voyous ont fait fuir mon personnel et mes clients... Je dois m'occuper de cette pagaille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "Si vous souhaitez visiter le Parc des alpagas, je vous invite à revenir demain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
