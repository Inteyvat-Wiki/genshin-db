			"dialogs": [
				{
					"id": 102020401,
					"content": "Devine qui c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "C'est la voix de Paimon que j'entends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Cellule d'isolement"
				},
				{
					"id": 102020403,
					"content": "On te sort de là ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Oh, oui, d'accord... Non, attendez ! Euh, non, ce n'est pas possible. Je dois être une gentille fille et réfléchir à ce que j'ai fait ! Ne me tentez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Cellule d'isolement"
				},
				{
					"id": 102020406,
					"content": "Enfin, puisque je suis coincée ici, je vais en profiter pour fabriquer un nouveau trésor... version Ludi Harpastum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Cellule d'isolement"
				},
				{
					"id": 102020407,
					"content": "Un « trésor » tu dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Héhé... Je lui ai donné la forme d'un harpastum et tout ! C'est tellement mignon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Cellule d'isolement"
				},
				{
					"id": 102020409,
					"content": "Une bombe en forme de harpastum ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Tout le monde sera surpris pendant le Ludi Harpastum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Cellule d'isolement"
				},
				{
					"id": 102020412,
					"content": "*soupir* Ça serait la fin des haricots si Jean nous entendait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "La période d'isolation de Klee pourrait être rallongée de beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Donc... Une autre bombe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "On te ramène de la nourriture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
