					}
				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "Hein ? Pourquoi j'ai l'impression qu'il y a soudain un bassin supplémentaire ? Qu'est-ce qu'il y a écrit sur ce panneau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "« Danger ! Interdiction d'approcher ! » Qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Ça veut dire exactement ce qui est écrit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010104,
					"content": "Ouah ! Sandrone... Vous m'avez fait peur ! C'est vous qui avez placé ce panneau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Oui. Dans l'intention d'éloigner les curieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010106,
					"content": "Qu'est-ce qu'il a de spécial, ce bassin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Il est rempli de piranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010108,
					"content": "Q—Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Haha, je plaisante. Vous n'y avez quand même pas cru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010110,
					"content": "J'ai appris que certains poissons de l'aquarium sont très territoriaux et peuvent devenir plutôt agressifs. Alors je les ai déplacés ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010111,
					"content": "Vous m'avez fait peur... Cet endroit sert donc en quelque sorte de zone spéciale pour les poissons agressifs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Exactement, l'eau de ce bassin est bien plus profonde et il y a beaucoup plus d'espace. Ça aide à calmer les poissons les plus territoriaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010113,
					"content": "J'ai aussi demandé à Sigewinne de la Forteresse de Méropide des appâts spéciaux pour les aider à se calmer un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010114,
					"content": "Oh... Vous vous souciez vraiment du bien-être de ces poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Je ne pense pas que quiconque ait envie de voir l'aquarium se transformer en bain de sang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010116,
					"content": "C'est sûr ! Pourquoi ne pas nous laisser nous en occuper ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Si vous insistez. Quand les poissons du bassin se sentiront assez à l'aise pour nager jusqu'à la surface, cela signifiera qu'ils sont en voie de guérison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010118,
					"content": "Donc une fois qu'ils seront tous détendus et heureux, on pourra les remettre dans l'aquarium ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Vous pourrez les placer où bon vous semble. Tout ce dont je suis responsable, c'est de récupérer les plus turbulents et de les amener ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010120,
					"content": "Compris ! Mais ce panneau est vraiment trop effrayant. On pourrait peut-être le changer pour quelque chose d'un peu moins... terrifiant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Hmm... Très bien. Après tout, c'est vous qui avez attrapé ces poissons. Je vous laisse décider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
}