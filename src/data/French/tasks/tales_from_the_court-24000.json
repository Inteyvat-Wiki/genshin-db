			},
			"dialogs": [
				{
					"id": 240000101,
					"content": "Je répète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000102,
					"content": "Monsieur Livre, je comprends votre demande et je suis prête à faire de mon mieux pour vous aider, mais... Regardez cette demande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000103,
					"content": "La personne responsable de votre dossier est monsieur Clapiers. Tous les documents que vous avez fournis lui ont été remis. Et nous n'avons pas le droit d'intervenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000104,
					"content": "Il est actuellement en déplacement, et son tampon officiel doit être apposé sur vos documents pour que le processus de remboursement puisse commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000105,
					"content": "Ouais, ouais, c'est bon ! Je suis déjà venu ici trois fois. Vous allez faire quelque chose ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000106,
					"content": "Monsieur Livre, calmez-vous, s'il vous plaît. Il n'y a que deux personnes qui travaillent pour son bureau. Lui, et un certain monsieur Monthois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000107,
					"content": "Mais monsieur Monthois est relativement âgé et attend sa retraite. Pour tout dire, il n'a pas réellement travaillé au bureau depuis un moment, il ne touche même plus de salaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000108,
					"content": "Dans ce cas, je vais aller dans son bureau et lui demander de venir pour tamponner mes documents. Je vais les tamponner moi-même s'il le faut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000109,
					"content": "Je suis vraiment désolée, mais ce n'est pas possible, monsieur Livre. D'une part, ce serait contraire aux règles en vigueur. Et d'autre part, c'est monsieur Clapiers qui a la clé pour accéder au tampon officiel, personne d'autre n'y a accès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000110,
					"content": "Et j'ai également autre chose à faire... Monsieur Clapiers va revenir aujourd'hui et il pourra vous aider avec votre demande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000111,
					"content": "D'accord... Bonne journée, mademoiselle Cornélia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000112,
					"content": "Bonne journée à vous aussi, monsieur Livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 240000113,
					"content": "Cornélia s'empresse de partir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "On dirait bien que je vais devoir rentrer aujourd'hui... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000115,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "Rien, vraiment. J'ai juste perdu une demi-journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000118,
					"content": "J'en ai marre de ce Clapiers ! Le Palais Mermonia nous a commandé des machines horlogoïdes, mais ils ne les ont pas encore payées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000119,
					"content": "La première fois que je suis venu le chercher, il m'a dit que c'était la fin du mois et que le bureau procédait à leur audit interne mensuel. Par conséquent, ils ne pouvaient pas payer des parties externes avant le mois suivant. Ma demande ne pouvait donc pas être traitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000120,
					"content": "La deuxième fois, il a affirmé qu'ils n'avaient plus d'encre pour tampon et que leur entrepôt d'encre avait pris feu. Ils allaient devoir en acheter ailleurs. Ma demande ne pouvait donc toujours pas aboutir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000121,
					"content": "La troisième fois, il a affirmé que le formulaire d'inscription du personnel externe avait été mis à jour et devait être rempli à nouveau. Mais bien sûr, ils n'en avaient plus et les nouveaux exemplaires allaient arriver le jour suivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000122,
					"content": "Je suis donc venu en chercher un aujourd'hui, mais il n'est même pas dans son bureau. Nom d'un Archon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000123,
					"content": "Hmm ? Vous m'avez l'air contrarié, monsieur Livre. Je peux vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000124,
					"content": "Officière Rhemia, vous tombez bien ! Laissez-moi vous expliquer la situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000125,
					"content": "Livre explique en détail la situation...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "Ah, monsieur Clapiers... C'est vraiment difficile de lui mettre la main dessus. Mais il est effectivement sur l'Île d'Erinnyes en ce moment, et pas au Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000127,
					"content": "Enfin, concentrons-nous d'abord sur le formulaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000128,
					"content": "Hein ? Mais Clapiers a dit qu'il n'y en avait plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000129,
					"content": "J'ai peut-être une solution. Certains magasins qui ont des accords à long terme avec le Palais Mermonia ont rencontré le même problème que vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000130,
					"content": "Leur solution est de venir régulièrement au Palais pour récupérer les formulaires et documents dont ils pourraient avoir besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000131,
					"content": "Non seulement ça facilite et accélère le remplissage et la soumission des formulaires, mais ça leur permet aussi d'être au courant des modifications les plus récentes... « Être bien préparé rime avec sérénité », comme on dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000132,
					"content": "C'est... C'est pour ça qu'il n'y a plus de formulaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000133,
					"content": "Ces magasins doivent sûrement avoir des formulaires supplémentaires, allons leur rendre visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000134,
					"content": "De plus, je suis sûre qu'ils seront ravis de vous aider une fois qu'ils auront entendu parler de vos voyages futiles au Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000135,
					"content": "Hmm. Nous ferions mieux d'obtenir les formulaires dont vous avez besoin, de les remplir, puis de les apporter au bureau de monsieur Clapiers avant la fermeture du Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000136,
					"content": "#Pourriez-vous nous aider, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000137,
					"content": "Aidez-moi, s'il vous plaît ! Je n'aurai pas l'esprit tranquille tant que je ne réglerai pas cette histoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000138,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "Il vous suffit de vous rendre dans ces deux magasins pour essayer d'avoir la dernière version du formulaire d'inscription du personnel externe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000141,
					"content": "Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000142,
					"content": "Veuillez vous rendre à la forge d'Estelle et à l'horlogerie de Caron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000143,
					"content": "Il n'y a pas si longtemps, Estelle a aidé le Palais à réparer les lampadaires, tandis que Caron a réglé leur horloge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000144,
					"content": "Ils travaillent souvent pour le Palais, ils doivent sûrement avoir un formulaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000145,
					"content": "Nous comptons sur vous pour ces deux magasins. Livre et moi allons nous séparer et aller dans d'autres magasins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000139,
					"content": "Comment puis-je vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "Quel est le problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
