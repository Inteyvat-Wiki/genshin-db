					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000302,
					"content": "Le formulaire d'inscription du personnel externe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000303
					]
				},
				{
					"id": 240000303,
					"content": "Vous décrivez le problème de Livre et sa demande de formulaire...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000304
					]
				},
				{
					"id": 240000304,
					"content": "C'est fréquent avec le Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000305
					],
					"speakerTitle": "Caron"
				},
				{
