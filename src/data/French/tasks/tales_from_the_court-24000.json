			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "Quelle plaie... Tout ça pour une poignée de moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "Le formulaire d'inscription du personnel externe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "Vous décrivez le problème de Livre et sa demande de formulaire...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "*soupir* Ce n'est vraiment pas de chance pour Livre... Mais je n'en ai plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000205,
					"content": "J'ai demandé à quelqu'un de la boutique de m'aider à réparer les lampadaires au Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000206,
					"content": "Mais il n'a pratiquement rien fait. Du coup, je n'ai pas mis son nom sur le formulaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000207,
					"content": "Mais au moment de remettre le formulaire, Clapiers a insisté pour que j'écrive vraiment tous les noms...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000208,
					"content": "Il a même parlé de « conséquences graves et imprévisibles » si je ne le remplissais pas parfaitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000209,
					"content": "Franchement, il ne manque qu'un nom. Quelles conséquences ça pourrait réellement avoir ? C'est ridicule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
