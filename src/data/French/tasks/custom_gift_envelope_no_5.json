			"dialogs": [
				{
					"id": 715370101,
					"content": "Chevalier honoraire ! Quelle coïncidence de te voir ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 715370102,
					"content": "Tu fais des enveloppes-cadeaux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Oui ! J'ai enfin eu l'occasion de venir ici pour des vacances. Je voudrais ramener quelques cadeaux pour les collègues de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 715370104,
					"content": "J'ai entendu dire que, pendant le Festival des lanternes, les habitants du coin aimaient offrir une de ces enveloppes avec leurs cadeaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 715370105,
					"content": "Je voudrais faire pareil et réaliser moi-même quelques enveloppes-cadeaux, mais elles ne sont pas très belles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 715370106,
					"content": "Je veux qu'elles soient jolies ! Peux-tu me montrer comment faire, chevalier honoraire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 715370107,
					"content": "Bien sûr, compte sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
