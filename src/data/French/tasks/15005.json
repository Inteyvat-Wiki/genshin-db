			"dialogs": [
				{
					"id": 150050101,
					"content": "Les koholasaures vaincus se dispersent et s'enfuient.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "À en juger par vos vêtements, vous devez être des chercheurs de Sumeru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050103,
					"content": "Oui, je m'appelle Karya et voici mon aîné, Viramdra. Merci beaucoup de nous avoir secourus, c'était moins une...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050104,
					"content": "#Ce n'est rien, c'était un jeu d'enfant pour nous. Je m'appelle Paimon, et voici {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050105,
					"content": "*soupir* On dirait que tous les koholasaures se sont enfuis... Mais nous devons en capturer au moins un vivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050106,
					"content": "En capturer un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050107,
					"content": "#C'est exact. Je vois que vous êtes plutôt {M#doués}{F#douées} pour les gérer. Si je sers d'appât, vous pensez que vous pourriez nous aider à en capturer un ? Je vous récompenserai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050108,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050109,
					"content": "Veuillez excuser Viramdra, il est obnubilé par ses recherches. Ne faites pas trop attention à lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050110,
					"content": "Ah, pas de problème ! Mais pourquoi avez-vous approché tout un groupe de koholasaures sauvages ? Et pourquoi vouloir en capturer un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050111,
					"content": "Ne me dites pas que vous voulez aussi prendre une photo avec eux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "Ça m'étonnerait que ce soit ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050113,
					"content": "Je suis sûre que nous devons avoir l'air d'idiots... Pour tout vous dire, nous sommes à la recherche d'une île mystérieuse dont parle une légende. Et apparemment, un indice très important se trouverait sur les koholasaures, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050114,
					"content": "Mais les approcher sans l'aide d'un guide du Peuple des sources était imprudent de notre part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050115,
					"content": "Une île mystérieuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050116,
					"content": "Oui. Une légende du Peuple des sources mentionne une île mystérieuse, et Viramdra pense que la clé de ses recherches se trouve là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050117,
					"content": "#Ahem... Vous êtes {M#sûrs}{F#sûres} de ne pas vouloir accepter ma proposition ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050118,
					"content": "Votre proposition... Nous n'utiliserions jamais une personne comme appât !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050119,
					"content": "Alors, je suppose qu'en discuter davantage ne serait qu'une perte de temps. Je dois trouver une autre solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050120,
					"content": "Viramdra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050121,
					"content": "Oh, c'est vrai... Vous venez de nous sauver, Karya et moi, et je suppose que je devrais exprimer une certaine gratitude... Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050122,
					"content": "C'est un peu bizarre, mais d'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050123,
					"content": "Nous devrions y aller, Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050124,
					"content": "Oui, merci encore. Viramdra n'est vraiment pas doué avec les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050125,
					"content": "Ce n'est rien. Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050126,
					"content": "On ne voit pas des aventuriers comme ces deux-là tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050127,
					"content": "Je dois dire que cette île mystérieuse dont elle a parlé m'intrigue vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050128,
					"content": "Tu as aussi envie de trouver l'île, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "Oui ! Qui sait, il y a peut-être un trésor à la clé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050130,
					"content": "Après tous les endroits incroyables que nous avons explorés au cours de nos aventures, trouver une île mystérieuse devrait être une promenade de santé pour nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050131,
					"content": "Mais nous n'avons aucune information sur cette île.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "Ah, tu as raison... La dame a mentionné que l'île mystérieuse est liée à une légende du Peuple des sources... On pourrait peut-être commencer par aller leur demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050133,
					"content": "Il n'y a pas de temps à perdre ! Notre prochaine aventure commence maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050134,
					"content": "Nous avons prévu d'interroger des gens... Mais qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050135,
					"content": "Nous pourrions peut-être simplement demander à voir la cheffe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "Hum... C'est une bonne idée. La dame a mentionné que l'île mystérieuse est liée à une légende du Peuple des sources... Donc si quelqu'un sait quelque chose, c'est le chef !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
