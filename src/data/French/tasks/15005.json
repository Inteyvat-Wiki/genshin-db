			},
			"dialogs": [
				{
					"id": 150050201,
					"content": "Waouh, quelle vue incroyable ! Et on peut même apercevoir quelques koholasaures ici et là ! On pourrait essayer de se prendre en photo avec un ou deux d'entre eux dans la nature ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "Et s'ils essayaient de nous mordre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Mais... Les koholasaures sont si mignons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "Hein ? Que se passe-t-il là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "À l'aide ! Quelqu'un, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "Ah ! Les koholasaures sauvages mordent vraiment les gens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "À nous de jouer !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#Ces deux-là ont des ennuis ! {M#Le}{F#La} légendaire {NICKNAME} et son fidèle compagnon Paimon ne resteront pas les bras croisés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Les photos vont devoir attendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Oui, ça ne presse pas ! Quelqu'un a besoin de notre aide, nous devons faire quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
