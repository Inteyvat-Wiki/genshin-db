				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Cet endroit a l'air d'avoir ses propres secrets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "Chut, écoute ! On entend des gens qui parlent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "#Rah ! Je ne m'attendais pas à ce qu'elle soit aussi bornée. Elle n'a pas dit un mot{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740102,
					"content": "Ne vous inquiétez pas. L'interrogatoire, c'est notre spécialité. Allez faire un tour. On va s'en occuper dans un instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ronin - Anbu"
				},
				{
					"id": 722740103,
					"content": "#On n'a pas de temps à perdre. Le professeur veut savoir ce qu'elle connaît de notre plan et il veut le savoir maintenant, ou ça va être notre fête à nous aussi{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740104,
					"content": "Grr. Il est vraiment de mauvaise humeur... Qu'est-ce que cette femme a bien pu faire pour le mettre dans cet état ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ronin - Anbu"
				},
				{
					"id": 722740105,
					"content": "Le plan du professeur impliquait cette personne nommée Lyudochka comme pièce maîtresse. Mais cette femme du Shuumatsuban l'a éliminée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740106,
					"content": "Heureusement, le feu n'était pas encore éteint quand nous sommes arrivés. Le professeur tient bien son nom : il a tout de suite identifié Lyudochka à ses vêtements et a pris conscience que nos plans pouvaient être compromis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740107,
					"content": "Aussi terrible que ça puisse être, au moins, il a sauvé la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ronin - Anbu"
				},
				{
					"id": 722740108,
					"content": "Mais on ne sait toujours pas ce que cette femme connaît de nos plans, ou si elle a eu le temps d'en informer un autre membre du Shuumatsuban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740109,
					"content": "On dirait que Momoyo est enfermée dans une cellule souterraine. Sortons-la de là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
