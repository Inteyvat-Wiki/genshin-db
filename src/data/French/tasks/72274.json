			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tirailleur Fatui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Argh, je n'aurais jamais pensé que notre plan puisse s'ébruiter. Quelle poisse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740202,
					"content": "Et comment ! Le professeur a soudainement reçu l'ordre de rentrer à Snezhnaya, mais l'opération sur l'Île de Watatsumi a été maintenue malgré tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740203,
					"content": "Tu ne penses pas que le professeur agit un peu en solo ? Il n'a même pas informé Arlecchino de cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740204,
					"content": "C'est vrai. Cette mission, c'était son idée. Tu sais quoi ? J'ai un mauvais pressentiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Tirailleur Fatui"
				},
				{
					"id": 722740205,
					"content": "Tu penses que le professeur va nous faire porter le chapeau si la mission échoue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirailleur Fatui"
				}
			]
		}
	]
