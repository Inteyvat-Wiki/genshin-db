			"dialogs": [
				{
					"id": 750800101,
					"content": "Waouh, quelle jolie fleur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800102,
						750800103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800102,
					"content": "Pourquoi ça me semble aussi familier ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750800104
					]
				},
				{
					"id": 750800104,
					"content": "Oh, c'était la graine pour laquelle nous avions utilisé du phlogistique à l'époque. Je n'avais pas réalisé qu'il s'agissait d'une graine de fleur braisée. Pas étonnant qu'elle n'ait pas germé avant ! Il n'y avait tout simplement pas assez de phlogistique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800105,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750800106,
					"content": "#Tu vois, {REALNAME[ID(2)|SHOWHOST(true)]}, c'est la fleur que tu as plantée. La graine n'est pas morte. Au contraire, elle fleurit super bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800107,
					"content": "#Je suis {F#surprise}{M#surpris} que ce ne soit pas une Fleur mensongère...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750800108
					]
				},
				{
					"id": 750800108,
					"content": "Arrête de penser à ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800109,
					"content": "Yaa... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750800110,
					"content": "#Héhé, tu es vraiment content, hein, {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800111,
					"content": "Maintenant, tu dois veiller à devenir un saurien grand et fort, tout comme cette graine est devenue une fleur, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800103,
					"content": "#Est-ce que c'est la graine plantée par {REALNAME[ID(2)|SHOWHOST(true)]}...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750800104
					]
				}
			]
		},
