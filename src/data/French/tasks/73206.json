			"dialogs": [
				{
					"id": 732050501,
					"content": "♪ Rose, rose, réalise mon souhait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Tiens ? Vous êtes toujours là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Pourquoi habitez-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Héhé... De toute façon, je suis un vieillard loufoque, et les vieillards loufoques font des choses difficiles à expliquer... C'est rare que des gens viennent me poser cette question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "J'ai toujours voulu sortir de mon village et saisir l'occasion de faire quelque chose dans ma vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Peu après mon mariage, j'ai failli partir avec les Érémites, mais je me suis dit que je ne pouvais pas laisser ma femme toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Plus tard, j'ai rencontré un marchand ambulant et j'ai voulu le suivre pour me lancer dans les affaires. Mais au final, je n'ai pas pu le faire car je n'avais pas assez d'argent à investir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Ensuite, ma femme m'a quitté. Je n'avais plus rien pour me retenir, cependant, j'étais trop vieux pour partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "J'ai passé ma vie à hésiter et j'ai raté beaucoup de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Avec le recul, je me rends compte que je n'avais pas ma place dans ce village ou ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "Finalement, j'ai déménagé à la périphérie du village pour vivre seul et être tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "Voilà ce qui s'est passé au cours de ces quelques décennies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "#J'aimerais vous inviter à venir admirer ces fleurs quand elles auront fleuri. Ça sera peut-être demain ou après-demain, aurez-vous le temps de venir les voir{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Très bien, très bien, j'ai compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪ Rose, rose, réalise mon souhait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Dites-m'en plus sur ce vieux fantôme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Seuls les étrangers posent des questions sur le vieux fantôme, même les enfants du village connaissent tous ce nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Si un enfant n'est pas sage, ses parents lui font peur en lui disant : « Le vieux fantôme va venir pour t'emporter »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Aucun de ces jeunes n'a jamais vu le vieux fantôme, mais ils savent évoquer son nom pour effrayer les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "J'ai vu le vieux fantôme en personne quand j'étais petit, et effectivement, il déteste les enfants. En revanche, il n'était pas bien effrayant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Je ne sais pas pourquoi on s'est mis à l'appeler le vieux fantôme. Selon moi, ce sont des gens qui n'avaient rien de mieux à faire qui ont parlé derrière son dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Vous n'étiez pas amis alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Quand j'étais petit, je me faufilais souvent dans son petit jardin pour jouer. Quand il me découvrait, il me chassait avec sa houe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Il me voyait probablement comme un vilain garçon qui venait mettre le désordre, c'est impossible qu'il se souvienne de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Même si lui ne se souvient pas forcément de moi, moi, je me souviens toujours de lui et de son petit jardin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Donc si je dis que c'est mon ami, ce n'est pas incorrect, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Je veux faire pousser les mêmes fleurs qu'il y avait chez lui pour recréer ce petit jardin qu'il y a dans mes souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
