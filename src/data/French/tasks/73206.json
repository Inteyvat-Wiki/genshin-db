			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "Oh, c'est vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060102,
					"content": "Comment vont les graines ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "Aucune d'entre elles n'a germé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060104,
					"content": "J'ai examiné la surface des graines et il n'y a même pas le moindre signe de germination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060105,
					"content": "J'aimerais tout de même savoir pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060106,
					"content": "Je suis sûr de ne pas m'être trompé de graines. J'ai suivi les notes manuscrites du vieux fantôme et j'ai fouillé dans la réserve pour les trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060107,
					"content": "Selon ses notes, les graines peuvent se conserver longtemps et tant qu'elles sont gardées au sec, elles ne pourrissent pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060108,
					"content": "Ça ne doit pas non plus être un problème de méthode. Je n'ai pas oublié l'eau et les engrais. Alors, pourquoi ça ne fonctionne pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060109,
					"content": "Ne soyez pas pressé, monsieur Affan. Attendez encore un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060110,
					"content": "#Chaque fois qu'on sort dans la nature pour cueillir des fruits et des fleurs, {NICKNAME} et moi, il leur faut plusieurs jours pour repousser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060111,
					"content": "Soyez patient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "*soupir* Je suppose que je vais devoir attendre. Vous êtes libres aujourd'hui ? Est-ce que vous pouvez m'aider à les arroser à nouveau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060114,
					"content": "Je viens juste d'ameublir le sol de la pépinière et je suis trop épuisé pour aller chercher de l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060115,
					"content": "Entendu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060112,
					"content": "Essayez de continuer à les arroser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"2"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "Il faut encore les arroser et les fertiliser... Mais est-ce que ça va vraiment servir à quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060302,
					"content": "Même moi, je n'en suis plus si certain. *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060303,
					"content": "Jusqu'à ce jour, j'ai vécu sans but, et maintenant que j'ai décidé de faire quelque chose, je n'y arrive pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060304,
					"content": "Désolé, vieux fantôme. Je vous ai déçu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060305,
					"content": "Monsieur Affan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060306,
					"content": "Les enfants, allez faire ce que vous avez à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
