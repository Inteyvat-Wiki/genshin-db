			},
			"dialogs": [
				{
					"id": 715380101,
					"content": "#Bonjour, {NICKNAME}. Joyeux Festival des lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Vous êtes ici pour enquêter sur une affaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "J'ai été forcée de prendre des congés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Comment ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Le règlement de Maison Gardiennage dit que tous les employés sont tenus de prendre leurs congés avant la fin de l'année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Les calculs de fin d'année ont été faits et la patrouille a découvert que je n'en avais pas pris un seul jour, alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Votre travail est exigeant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Nos officiers travaillent par roulement, mais en tant que capitaine de la brigade, je dois toujours être de service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Je m'occupe également de nombreuses affaires urgentes, alors au fil du temps, j'ai juste... oublié de prendre des vacances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Ça ne me dérangeait pas de ne pas prendre de congés cette année, mais mes officiers n'ont rien voulu entendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Ils ont commencé à me crier que « les règles sont faites pour être suivies » et qu'« une capitaine doit montrer l'exemple ». Je ne pouvais pas refuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "L'un des gestionnaires qui travaille avec nous a dit que Liyue était une destination idéale pour des vacances pendant le Festival des lanternes. Il a sorti un billet de bateau ensuite, alors... me voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Et je dois admettre que Liyue est vraiment splendide à cette période de l'année. Je reviens tout juste du Village de Qiaoying. J'ai beaucoup aimé les dim sum et le thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "J'en ai acheté pour les manger avec les membres de la patrouille. Je voudrais aussi leur fabriquer des enveloppes-cadeaux selon les coutumes locales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "C'est juste que... je ne suis pas très douée pour ce genre de choses. Le résultat est toujours un peu bancal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#Savez-vous comment les faire, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "J'ai quelques suggestions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "C'est comme ça pour tout le monde ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Vous... n'avez pas l'air d'être là pour le travail ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
