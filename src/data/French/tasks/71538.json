			"dialogs": [
				{
					"id": 715380301,
					"content": "Ouah, superbe ! Hmm... Vous méritez quelque chose en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Prenez un peu de ces dim sum en guise de remerciement. Ce voyage en valait le détour, rien que pour cette enveloppe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "... Mais ça fait un certain temps que je me suis absentée. Je me demande si mes officiers s'entraînent correctement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Je pense que je vais bientôt planifier un test d'aptitude physique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
