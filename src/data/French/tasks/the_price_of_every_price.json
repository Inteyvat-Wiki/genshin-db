			"dialogs": [
				{
					"id": 401960301,
					"content": "#{NICKNAME}, Kinich, vous revoilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960302,
					"content": "Chevreuse vient d'emmener le coupable, elle avait l'air ravie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960303,
					"content": "C'était plus simple que prévu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "Héhé, après avoir fait courir tout le monde dans tous les sens, il n'avait pas la force de se battre, hein ? Je suppose que la fuite était le seul tour qu'il avait dans son sac !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960306,
					"content": "Au fait, Wriothesley m'a demandé de vous dire qu'il était déjà retourné faire son rapport au Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960307,
					"content": "Il a dit que la Maréchaussée fantôme allait démarrer une enquête approfondie sur les activités illicites de jeux d'argent. Ils vont avoir du pain sur la planche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960308,
					"content": "Enfin, c'est au Palais Mermonia de s'en occuper, pas à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960309,
					"content": "Vu la vitesse à laquelle le duc a déguerpi, je dirais plutôt qu'il fuyait mon Daguerréotype !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960310,
					"content": "Pff, je commence à en avoir l'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960311,
					"content": "Ça ne vous ressemble pas d'abandonner aussi vite, Charlotte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960312,
					"content": "Héhé, ce n'est pas grave. J'ai déjà pris plein de bons clichés tout à l'heure, assez pour faire la première page !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960313,
					"content": "Justement, je vais devoir y aller. Ces photos ne vont pas se développer toutes seules !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960314,
					"content": "Assurez-vous de choisir le cliché avec mon meilleur profil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960315,
					"content": "Oh, elle est partie si vite. J'espère qu'elle a entendu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960316,
					"content": "Tu peux faire confiance à son jugement de professionnelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "Héhé, c'est vrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960318,
					"content": "Qu'est-ce qui vous a pris autant de temps ? Il y a eu un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960319,
					"content": "Ajaw s'est cogné la tête et s'est mis à pleurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960321,
					"content": "#{M#Petit insolent}{F#Petite insolente} ! Tu ne sais pas tenir ta langue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960322,
					"content": "Sa Majesté saurienne suprême, K'uhul Ajaw, ne s'est jamais rabaissé à de telles pleurnicheries !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960323,
					"content": "Assez souvent, au contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960329,
					"content": "Qu'allez-vous faire ensuite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "Pour être honnête, je n'y ai pas encore réfléchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960331,
					"content": "Je n'ai pas d'urgence pour le moment. Même si je devrais peut-être encore aller témoigner au tribunal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960332,
					"content": "Cette arme à feu est une pièce à conviction essentielle, je vais probablement devoir attendre que l'affaire soit classée avant de pouvoir la ramener à Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960333,
					"content": "Je pense que je vais rester ici pour profiter encore un peu du sable et de la mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960324,
					"content": "Kinich s'est cogné la tête et s'est mis à pleurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "Si vous le dites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960326,
					"content": "Hahaha, il n'y avait personne pour réconforter le petit Kinich, alors il s'est mis à pleurer dans son coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960327,
					"content": "Vraiment ? C'est plus probable que ce soit Ajaw qui se soit mis à pleurer, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960328,
					"content": "Hé ! Espèce de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960304,
					"content": "Notre adversaire était assez faible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
}