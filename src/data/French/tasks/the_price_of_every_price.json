			"dialogs": [
				{
					"id": 401960201,
					"content": "Ça fait quelques jours, et la plage semble de plus en plus animée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960202,
					"content": "(Oui, c'est sans doute aussi grâce aux nombreux agents en civil.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "#{NICKNAME}, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960204,
					"content": "Ahem ! Je commence à avoir faim... Allons jeter un coup d'œil au menu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960205,
					"content": "(La personne qui transporte cette mallette doit être venue pour la transaction.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "(C'est l'heure de passer aux choses sérieuses.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "Bon sang, vous ne pouvez pas simplement traîner quelqu'un comme ça ! Quel mépris pour la vie humaine... On se verra au tribunal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960208,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960209,
					"content": "#Je pense que je vous ai plutôt fait une faveur en vous éloignant de votre «{NON_BREAK_SPACE}public{NON_BREAK_SPACE}». Je vous ai sauvé la face, au moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960210,
					"content": "Quant à savoir si vous regardiez vers le haut ou vers le bas en cours de route... C'était votre décision, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960211,
					"content": "Espèce de...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960213,
					"content": "C'est bon, je le reconnais. Je suis en tort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960214,
					"content": "*soupir* Je sais différencier le bien du mal, mais je n'avais pas d'autre choix. J'avais désespérément besoin de cet argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960215,
					"content": "J'étais expert en reliques anciennes... J'avais une brillante carrière et une famille heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960216,
					"content": "Mais mon fils... Il est tombé dans le piège des jeux d'argent en fréquentant les mauvaises personnes... Nous avions bien quelques économies, mais tout a fondu comme neige au soleil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960217,
					"content": "Après s'être endetté, ses créanciers venaient souvent le menacer. En tant que père, comment pouvais-je rester les bras croisés à le regarder souffrir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960218,
					"content": "*soupir* Mon fils a à peu près le même âge que vous. Si seulement il pouvait être comme vous... C'est la seule raison pour laquelle j'avais besoin d'argent, vous devez me croire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960220,
					"content": "Vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960221,
					"content": "Je vous en prie, jeune homme, aidez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960222,
					"content": "Nous sommes tous deux originaires de Natlan, n'est-ce pas ? Épargnez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960223,
					"content": "Je peux encore remettre mon fils dans le droit chemin si je rentre. Mais si je vais en prison, il ne survivra pas. Il sera condamné, je vous dis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960224,
					"content": "N'est-ce pas normal pour les membres d'une famille de se battre ensemble pour un meilleur avenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960225,
					"content": "Notre destin est entre vos mains, jeune homme. S'il vous plaît, ayez pitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960227,
					"content": "Haha, Kinich, pourquoi tu ne dis plus rien ? Il t'a ému, ce type ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960228,
					"content": "Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960229,
					"content": "Je ne crois pas un mot de ce que vous dites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960230,
					"content": "Wriothesley vous avait pratiquement cerné. Vous êtes tout simplement un parieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960231,
					"content": "Un parieur ? Moi ? Pas du tout, je vous dis que mon fils...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960232,
					"content": "Tout d'abord, venez-vous vraiment de Natlan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960233,
					"content": "Étant donné que vous gardiez un œil sur l'emplacement de l'arme, vous auriez dû au moins reconnaître un visage familier de Natlan depuis tout ce temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960234,
					"content": "Et puis, la manière dont vous avez parlé de me traîner au tribunal... C'était bien trop naturel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960235,
					"content": "Comment ? Juste avec ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960236,
					"content": "J—Je peux tout expliquer ! En fait, j'ai grandi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960237,
					"content": "Tss. Je n'écouterai pas un mot de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960238,
					"content": "Ajaw, je te donne une chance de faire taire quelqu'un, pour changer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960239,
					"content": "Hahaha, j'attends ce moment depuis si longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960240,
					"content": "Prends ça, vieux schnoque !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960241,
					"content": "Mentir de manière compulsive est l'une des caractéristiques des parieurs invétérés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960242,
					"content": "Je suppose que vous êtes un Fontainois qui prétend venir de Natlan. Même si vous avez encore des amis ou de la famille, je suppose qu'ils ont depuis longtemps coupé les ponts avec vous à cause de votre train de vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960243,
					"content": "Bien entendu, c'est aussi possible que je me trompe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960244,
					"content": "Mais bon, qu'est-ce que ça changerait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960245,
					"content": "Je suis juste ici pour vous arrêter. Je ne suis pas venu pour vous défendre ou encore moins pour vous prêter une épaule sur laquelle pleurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960246,
					"content": "De toute façon, c'est au tribunal que vous chérissez tant que revient la charge de faire éclater la vérité. N'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960247,
					"content": "Exactement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960248,
					"content": "Monsieur Kinich, ça faisait longtemps. La patrouille de surveillance spéciale va s'occuper de ce criminel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960249,
					"content": "Merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960250,
					"content": "C'est moi qui vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960251,
					"content": "Et moi ? Et moi alors ! Quelle insolence ! On oublie de remercier Sa Majesté saurienne suprême ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960252,
					"content": "Dans ce cas, merci à vous et à monsieur Cacucu pour vos brillantes performances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960253,
					"content": "Qu'est-ce que ça veut dire ? Restez là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960254,
					"content": "Kinich, est-ce que ça va ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "Ne vous en faites pas, ce n'est pas moi qu'on a traîné jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960256,
					"content": "Vous avez l'air de mauvaise humeur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "Pfft... Petit Kinich, tu repenses à quand tu n'étais qu'un « riki Kinich » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960258,
					"content": "Ne te mets pas à pleurer comme un bébé ! Que vont dire les gens en voyant que Sa Majesté saurienne suprême s'affuble d'un serviteur aussi pathétique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960259,
					"content": "Mais qu'est-ce que tu racontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960260,
					"content": "Villain Ajaw !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "Je n'ai pas de raison de vous le cacher. Pour faire simple, je déteste les parieurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960262,
					"content": "Ce sont les personnes les plus irresponsables au monde, elles ne respectent pas le principe selon lequel il faut donner pour recevoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960263,
					"content": "Elles sont prêtes à inventer des millions de mensonges pour une petite pièce et s'imaginent pouvoir faire fortune avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960264,
					"content": "Mais nous savons tous qu'il y a souvent un coût invisible lorsqu'on obtient quelque chose sans effort ni sacrifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960265,
					"content": "Par le passé, j'ai également payé le prix des pertes aux jeux de mon père. Je ne veux pas que quelqu'un d'autre se retrouve dans une situation similaire si je peux l'éviter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960266,
					"content": "Kinich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "Ne soyez pas triste pour moi, je ne le suis pas moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960268,
					"content": "On dit que les gens sont façonnés par leur passé. Puisque je suis arrivé jusqu'ici, j'ai dû faire pas mal de choses correctement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960269,
					"content": "Personne ne devrait être puni pour les erreurs d'autrui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960270,
					"content": "Au lieu de cela, j'ai choisi de me souvenir des moments qui m'ont aidé à grandir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960271,
					"content": "Comme la première fois où j'ai appris à utiliser un grappin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960272,
					"content": "Ou la première fois que j'ai eu soif de connaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960273,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "Je vous crois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960275,
					"content": "Allons-y. Ils vont s'inquiéter inutilement si nous ne rentrons pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
		},
