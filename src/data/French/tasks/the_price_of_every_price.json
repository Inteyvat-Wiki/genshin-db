			"dialogs": [
				{
					"id": 401960101,
					"content": "Bonjour ! J'espère qu'on n'est pas en retard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "Non, c'est parfait. Vous avez pu vous reposer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "Je préfère rester en alerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "C'est bien pour garder la forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "Est-ce que vous avez commencé les préparatifs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Monsieur Argenteau nous a communiqué hier l'heure et le lieu de la transaction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Elle aura lieu cet après-midi dans un lieu que nous connaissons bien, le restaurant du Parc cinématographique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "Vraiment ? Le vendeur a un penchant pour cet endroit ou quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "Euh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Nous partageons les mêmes inquiétudes, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Exactement. Appréhender quelqu'un dans une zone très fréquentée sera bien plus difficile que dans un lieu ouvert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "Le coupable pourrait essayer de se fondre dans la foule ou même prendre un otage pour s'enfuir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "C'est pourquoi nous avons pris des mesures supplémentaires. Dès que nous avons reçu les informations hier, nous avons commencé à nous coordonner avec la Maréchaussée fantôme et la patrouille de surveillance spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Oui, des agents en civil seront en poste sur les lieux. Si un incident se produit, la priorité sera d'assurer la sécurité des citoyens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Bien sûr, nous espérons que tout se passera bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "J'ai reconnu quelques visages familiers de l'affaire précédente, comme mademoiselle Chevreuse, la capitaine de la patrouille de surveillance spéciale. Je suis optimiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "Nous faisons confiance à l'instinct d'un héros de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "Oh, et nous avons également informé mesdemoiselles Lépine-Pauline et Navia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "La Spina di Rosula apportera son soutien de manière contrôlée. Ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "Le seul problème... pourrait bien être mademoiselle Escoffier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "Elle ne veut pas servir des criminels ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "Elle veut leur présenter sa planche à découper ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Haha, si seulement c'était aussi simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Vous savez quoi, ce n'est peut-être pas une si mauvaise idée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Trêve de plaisanteries. Mademoiselle Escoffier nous a clairement fait savoir qu'elle n'accepterait pas que son établissement subisse la moindre perte à cause de notre opération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "Haha, mais euh... J'ai l'impression que les choses ne se passeront pas aussi bien qu'elle l'espère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "Comment puis-je aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "#Pour être honnête, vous n'auriez pas dû être {M#mêlé}{F#mêlée} à cette affaire, cela vous a déjà causé suffisamment d'ennuis. Les autorités de Fontaine se chargeront de la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "Mais j'imagine que vous souhaitez voir comment tout cela va se terminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "Dans ce cas, n'hésitez pas à vous rendre sur place. Mais restez en alerte et improvisez. Vous n'aurez pas besoin d'intervenir, sauf en cas d'urgence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "Je ferais de mon mieux pour éviter que les choses en arrivent là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "Oh, vous y allez aussi, Kinich ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Beaucoup de questions restent sans réponse, mais nos informations indiquent que le coupable vient de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Et puis, je suis témoin dans cette affaire. Je ne peux pas rester sans rien faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "Haha, ce n'est pas étonnant de votre part, Kinich !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Le groupe discute des détails de l'opération et des points importants auxquels faire attention.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Bon, je pense qu'on a assez discuté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "L'opération aura lieu cet après-midi. Si on se dépêche, on pourra même prendre le thé avant de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "#{NICKNAME}, et si on allait manger un bout nous aussi ? On ne peut pas travailler le ventre vide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "Mais on ne fera que regarder, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "Hé, c'est aussi important d'être à leurs côtés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Je vais déjà me rendre sur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Ça fait des jours qu'Ajaw répète qu'il veut goûter au menu exclusif de l'événement. Autant y aller pour qu'il arrête enfin de jacasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "À tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "J'attendrai de vos nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
