				"objectNames": [
					"Monsieur Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "Je ne savais pas qu'un Élémentosaure pouvait être aussi grand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Il s'agit d'une espèce barbare sans éducation, après tout. C'est pour cela qu'ils peuvent prendre des formes plus qu'étranges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"402501",
