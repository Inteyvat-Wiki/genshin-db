				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monsieur Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "En parlant de ça, Neuvillette...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "C'est vrai ! Neuvillette est le Dragon Hydro, non ? Ça voudrait dire que celui-là est beaucoup plus vieux que lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "Un nouveau dragon de l'eau est né ? Enfin, la maîtresse des eaux multiples est décédée il y a bien longtemps aussi... Beaucoup de temps s'est écoulé depuis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monsieur Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "Bref, le dragon malveillant du nom de Scylla était autrefois l'ami du sébaste, mais il s'est révolté à un moment décisif lors de la confrontation entre nous, les Rémuriens, et... les Fontainois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832302,
					"content": "À cette époque, Scylla mena les descendants des dragons belliqueux à Machimos, avec l'intention d'attaquer le Capitolium, le centre de la capitale où le sébaste résidait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832303,
					"content": "Machimos ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Les habitants du village parlent souvent de Machimos et d'un clocher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Oui, Machimos est la partie extérieure de la capitale, mais le dragon malveillant doit passer par l'Initium Iani pour pénétrer dans le centre-ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832307,
					"content": "Il s'agit de la barrière qui sépare la partie extérieure et le centre de la capitale. La symphonie composée par le sébaste et ses musiciens qui couvrait tout Remuria passait à travers elle ainsi que ses canaux dorés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832308,
					"content": "Boethius et sa légion ont profité de ce fait pour fermer l'Initium Iani et sceller le dragon malveillant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832309,
					"content": "Peut-être que Scylla avait l'intention de se rendre au trône du sébaste, mais ce n'est désormais plus possible. Après cela, il a sombré dans les profondeurs avec Remuria. Depuis lors, la trace du sébaste a disparu jusqu'à ce jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832310,
					"content": "(Il y a quelque chose qui cloche avec cette histoire...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#{NICKNAME}, vous vous souvenez de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832314,
					"content": "C'est un peu confus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Hmm... Je n'ai appris ce qui s'est passé que plus tard. Après tout, je n'étais pas dans la cité royale lorsque la catastrophe s'est produite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832316,
					"content": "Personne ne savait ce qui était arrivé au sébaste. Je crains que nous ne devions continuer à avancer pour le découvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832317,
					"content": "Le gros poisson brillant que nous avons vu au château était probablement la manifestation des pensées de Scylla qui se sont échappées des fissures de sa prison de pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832318,
					"content": "J'ai bien peur qu'il ait déjà remarqué notre présence. Après avoir été emprisonné ici aussi longtemps, il va forcément trouver un moyen de nous attirer vers lui maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832319,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Attendez, vous avez dit qu'on devait passer par cette porte ou un truc du genre si on voulait atteindre le Domus aurea. Mais Boethius l'a fermée, non ? Ça veut dire qu'on ne peut pas y accéder ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "C'est vrai que c'est une question assez délicate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832322,
					"content": "Ouah, je sais que c'est quelqu'un de grossier, mais il pourrait au moins ne pas nous mentir en nous disant de le retrouver au Domus aurea... Alors qu'il ne nous a pas laissé la porte ouverte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Je pense qu'il faudrait trouver le moyen de briser le sceau qui emprisonne le dragon malveillant afin que l'ennemi qu'il a vaincu ouvre la porte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "Comment pourrait-on faire cela ?! Je veux dire... C'est l'ennemi juré de Remuria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832325,
					"content": "Mais l'ennemi de mon ennemi est mon ami, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "C'est vrai, et ça fait un sacré bout de temps en plus ! Peut-être bien qu'il changera d'attitude et deviendra un bon dragon, qui sait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Mais cela reste un dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832329,
					"content": "#Et alors ? Peut-être que c'est un gentil dragon qu'on pourra persuader ? On a déjà eu affaire à des dragons, pas vrai, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832326,
					"content": "Remuria a disparu depuis bien longtemps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "(Dans ce que j'ai vu en rêve... À ce moment-là...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
