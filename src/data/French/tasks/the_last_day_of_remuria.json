			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Ouah... Ça ressemble au poisson brillant qu'on a vu auparavant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Pourquoi y a-t-il ces choses bizarres entremêlées en haut... Qu'est-ce que c'est ? Je n'y comprends rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "J'ai déjà entendu cette voix dans un rêve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Hmm, vous l'avez sûrement rencontré dans les souvenirs du sébaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830406,
					"content": "Scylla est un dragon malveillant qui a servi le puissant sébaste. Il a été neutralisé et scellé en ces lieux par Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830407,
					"content": "Hein ? Il a neutralisé un dragon malveillant ? Je ne pensais pas que quelqu'un d'aussi grossier que lui était capable de ce genre de prouesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "On dit que c'est un dragon malveillant, mais il s'agit en réalité d'un Élémentosaure un petit peu plus fort que les autres. Après tout, aucun nouveau Dragon Hydro ne peut naître tant que la mère des nombreuses eaux hiberne dans les profondeurs des mers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830404,
					"content": "... Par contre, je ne me souviens plus de son nom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Monsieur Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Oh, des courants marins chauds ! Je suis enfin libre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Vous venez de la surface, petites créatures ? Je ne sais vraiment pas ce que vous êtes venues faire dans cette cage des eaux profondes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "On n'est pas des petites créatures ! C'est juste vous qui êtes énorme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Haha, très bien ! Quoi qu'il en soit, vous m'avez rendu un grand service puisque vous m'avez libéré des chaînes qui m'emprisonnaient depuis un millénaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "Dites-moi s'il y a quelque chose que je peux faire pour vous. Considérez cela comme un signe de ma gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Héhé, je savais que vous étiez quelqu'un de raisonnable ! Ah sinon, je m'appelle Paimon, et {M#lui}{F#elle}, c'est {NICKNAME}. Et voici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Hmm... Je ne sais pas comment vous avez l'habitude de l'appeler, mais nous, on l'appelle Monsieur Os !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Ah, Cassiodor, c'est vous ! Cela faisait bien longtemps. Quel dommage que vous soyez revenu aussi tard... Vous êtes en retard d'un millénaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Oh ! On dirait que notre énorme camarade connaît bien Monsieur Os !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "Je n'ai rien à dire à un traître comme lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830611,
					"content": "Faites attention à ce que vous dites, mortel ! Contrairement à votre race arrogante, nous, les descendants des dragons, tenons nos promesses. Nous n'avons jamais trahi personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Ces paroles sont aussi insignifiantes que des éphémères qui se noient dans l'eau. Votre trahison est incontestable, et c'est précisément à cause de cela que nous avons perdu cette guerre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830613,
					"content": "Si seulement nous n'avions pas perdu cette guerre... Notre nation... Le sébaste ne serait pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830614,
					"content": "Vous êtes parti depuis bien trop longtemps, Cassiodor ! La vérité n'est pas celle que vous imaginez. Mais cela ne m'étonne pas, c'était un plan secret à l'origine. Comment ces détails auraient-ils pu parvenir à vos oreilles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "... Un plan secret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830616,
					"content": "Mon assaut de la cité royale avec l'armée d'Élémentosaures faisait en réalité partie de l'ultime plan secret de Remus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "Il a fait cela pour sauver sa nation et son peuple. C'est un grand homme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "C'est un peu tiré par les cheveux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "C'est très bizarre, pas vrai ? Pourquoi un souverain demanderait à quelqu'un d'autre d'attaquer sa propre nation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Mes petites créatures, comment pourrions-nous espérer comprendre les pensées de Remus ? Quoi qu'il en soit, Cassiodor, vous pouvez sans doute comprendre ce que cela signifie rien qu'en regardant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "Ce sont les abeilles dorées... Ces insectes qui guident le destin n'écoutent que l'appel de la Symphonie. Pourquoi le sébaste aurait-il donné la puissance de la Symphonie à des dragons barbares ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830624,
					"content": "Parce qu'ils avaient conclu un pacte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "Oh ? Vous en savez des choses, ma petite créature ! Où est-ce que vous avez appris cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "Cela me vient des souvenirs éparpillés dans les eaux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Vous avez raison ! Nous avions conclu un pacte, mais je l'ai trahi. J'ai trahi son noble sacrifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "Je n'ai pas réussi à atteindre le Domus aurea à temps ! Les vagues déchaînées ont alors englouti toute la ville. Mes semblables n'ont pas pu s'échapper non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "Comment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830630,
					"content": "Hmpf ! Si vous voulez parler d'une véritable traîtrise, c'est bien celle de Boethius !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "Sans ce démon menteur, ce rat trompeur qui nous a dupés avec ses paroles malhonnêtes, comment un prince parmi les dragons comme moi, qui dirigeait nos armées après l'ère des anciens dragons, aurait-il pu être battu aussi facilement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "Il a tout d'abord menti en disant qu'il avait renoncé à toute résistance et ordonné à sa légion de faire de même sur ordre de Remus. Mais quand nous sommes arrivés ici, il nous a soudainement attaqués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Maintenant que j'y pense, il a dû apprendre les plans de Remus bien avant. C'est comme cela qu'il a pu tendre son piège et le refermer progressivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "Ainsi, mon sang et ma chair se sont transformés en pierre, jusqu'à ce que vous me sauviez aujourd'hui, un millénaire plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Alors Boethius savait pertinemment que son action allait engendrer une immense tragédie, mais il a... A-t-il commis ces crimes pour s'emparer du contrôle de la phobos ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830636,
					"content": "J'ai l'impression qu'on n'a pas encore entendu toute l'histoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "Ouah ! Celui qui accuse les autres de traîtrise serait donc le véritable traître ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Mais pourquoi ? On va devoir aller demander au grossier personnage de s'expliquer ? En tout cas, j'ai l'impression qu'il ne va pas nous dire la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Oh ? Ce démon indigne et récalcitrant n'a pas encore disparu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "#Oui ! Et il a volé l'âme de beaucoup de Fontainois ! On est justement {M#venus}{F#venues} ici pour les sauver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "#Il a dit qu'il nous attendrait au Domus aurea... Ah non, il a juste dit qu'il attendrait Monsieur Os. On est vraiment {M#arrivés}{F#arrivées} à l'improviste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Il ne nous a même pas laissé la porte ouverte, espèce de malpoli !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "L'Initium Iani... Hmpf, cela ne reste qu'une simple porte en pierre malgré ses airs mystérieux qui sont là pour nous berner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "J'ai perdu ma forme physique, mais je peux envoyer mes petites créatures pour régler cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Regardez attentivement, mes petites créatures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Oh ! On dirait qu'on peut compter sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "#Nous avons seulement à briser ces sceaux visibles un par un. Nous pourrons nous mettre en route quand vous serez {M#prêts}{F#prêtes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Est-ce que vous êtes prêt, Monsieur Os ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Nous n'avons pas d'autre choix que d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830647,
					"content": "#Très bien, et toi, {NICKNAME} ? Est-ce que tu es {M#prêt}{F#prête} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "Il est devenu fou, lui aussi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
