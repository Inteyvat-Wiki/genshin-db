			"dialogs": [
				{
					"id": 10030601,
					"content": "Je suis en pause, merci de ne pas me déranger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Excusez-moi, je voudrais du tofu aux amandes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Je t'ai dit que j'étais en pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030604,
					"content": "Ce chef est aussi aimable que Wagner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "C'est une demande du patron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030607,
					"content": "Je vois. J'imagine que je n'ai pas le choix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030608,
					"content": "Mais je ne suis pas d'humeur à faire un dessert aussi élaboré qu'un tofu aux amandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030609,
					"content": "Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "Les épéistes doivent avoir des gestes fermes avec leur arme, et c'est la même chose pour les cuisiniers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030611,
					"content": "Or mes mains tremblent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Un jour, un voyageur m'a dit que cette auberge était... hantée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030613,
					"content": "Et là ! Tout à l'heure ! J'ai vu... J'ai vu un truc louche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030614,
					"content": "(Ce chef fait le dur à cuire, mais dès qu'on parle de fantômes...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "Je ne peux pas cuisiner de tofu aux amandes tant que je ne me sentirai pas en sécurité ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030616,
					"content": "#OK, {NICKNAME}. Regardons ce qui cloche avec cette cuisine, ou on peut dire adieu à notre tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
