			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "Dites-nous en plus à propos de l'Adepte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "Oh ? Vous avez rencontré Xiao ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030403,
					"content": "Ce n'est pas souvent qu'il est d'assez bonne humeur pour rencontrer des gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030404,
					"content": "Vous appelez ça « bonne humeur » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030405,
					"content": "Oh oui, il est très dur de rencontrer un Adepte. Beaucoup de gens passent leur vie à prier sans jamais en voir un seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030406,
					"content": "L'Archon Géo a fait appel à la puissance des Adeptes pour la fondation de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030407,
					"content": "Comme ils ne savent que se battre pour protéger la cité, les Adeptes vivent reclus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030408,
					"content": "Ce sont donc les hommes qui ont gouverné Liyue pendant des millénaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030409,
					"content": "Vous en savez beaucoup, dites donc, patronne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030410,
					"content": "Ce n'est pas « patronne », c'est juste « patron » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030411,
					"content": "Bénéficier de la faveur d'un Adepte ne peut que vous faciliter la tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030412,
					"content": "Si vous voulez mon avis, tout se passera bien tant que vous maintiendrez Xiao de bonne humeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030413,
					"content": "Bonne humeur ? J'ai un peu de mal à imaginer ce Gardien Yaksha être de « bonne humeur ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030414,
					"content": "Haha, vous n'êtes pas au bout de vos surprises, croyez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030415,
					"content": "(Il n'a jamais esquissé un seul sourire depuis qu'on se connaît, c'est vous dire...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030416,
					"content": "Demandez du tofu aux amandes à notre chef, et préparez le meilleur plat que vous pouvez de votre côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030417,
					"content": "Le tofu aux amandes est un des seuls plats humains que Xiao apprécie. Vous choisirez le second plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030418,
					"content": "#Le choix est à nous, {NICKNAME}... C'est quoi ta spécialité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030419,
					"content": "La salade copieuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "C'est un plat facile à préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030423,
					"content": "Comme on va cuisiner pour un Adepte, il vaut mieux partir sur une valeur sûre. Une salade copieuse ferait l'affaire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030421,
					"content": "Le Pyroblob géant à la sauce super ultra piquante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "Ouh, ce plat sort de l'ordinaire ! J'ai bien envie de le goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				}
			]
		},
