				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "Ah, vous voilà, comme prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340103,
					"content": "Ryuuji est en train d'enquêter sur l'Île de Yashiori en suivant mes indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340104,
					"content": "Laissez-moi marquer les emplacements sur votre carte. Si vous vous dépêchez, vous pourrez le rattraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340105,
					"content": "Pourquoi est-ce qu'on doit se dépêcher comme ça ? Ryuuji n'était-il pas censé nous retrouver ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340106,
					"content": "Parce que l'enquête est presque terminée, évidemment. Dépêchez-vous. La vérité est sur le point d'éclater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340107,
					"content": "#Ooh, quand vous le dites comme ça, je me sens tout excitée, moi aussi ! Allez, {NICKNAME}, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "Ryuuji ! On est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340202,
					"content": "Ah, c'est vous. Sango m'a envoyé ici pour faire des recherches préliminaires en me disant que vous arriveriez peu de temps après. Et vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340203,
					"content": "Eh bien, elle nous a dit qu'on vous trouverait ici ! Comment avance l'enquête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340204,
					"content": "Hein. Il n'y a que des cages à animaux ici. Où sont les gens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340205,
					"content": "Ils viennent de partir. C'étaient des Pilleurs de trésors. Sango m'a dit qu'ils avaient prévu de voler des chiens et de les entraîner à chasser les trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340206,
					"content": "Un peu comme avec les belettes voleuses ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "Exactement. Le problème avec les belettes, c'est que ce sont des animaux rusés difficiles à éduquer. C'est pourquoi leur entraînement a été un échec. Cette fois, ils ont prévu de réessayer avec des animaux un peu plus coopératifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340210,
					"content": "On s'est déjà occupés de plusieurs missions concernant les Pilleurs de trésors auparavant. Maintenant que j'y pense, Sango avait raison à propos de ça aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340211,
					"content": "Tout comme les gens laissent des empreintes, les organisations laissent des traces derrière elles. On a entendu parler d'autres animaux perdus et emprisonnés tout au long de cette affaire, mais les signes pointent tous dans la direction des Pilleurs de trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340212,
					"content": "Après avoir consulté les méthodes précédentes que nous avions utilisées pour résoudre ces affaires, je me suis rendu compte que mes recherches m'amenaient ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340213,
					"content": "Mais, ne laisser aucun garde... Quel manque de conscience professionnelle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340214,
					"content": "#C'est vraiment sympa de leur part ! Je suis sûre que même toi, tu dois être {M#fatigué}{F#fatiguée} après t'être autant {M#battu}{F#battue} ces derniers jours, n'est-ce pas {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340215,
					"content": "Eh bien, vu que personne n'est là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "Oui, c'est justement ce que je pensais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340216,
					"content": "J'imagine qu'on peut récupérer les animaux discrètement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "Hein, comme Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
