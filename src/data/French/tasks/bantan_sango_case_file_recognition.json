			"dialogs": [
				{
					"id": 400340601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340602
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340602,
					"content": "Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340603,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340604,
					"content": "C'est le « Chien en chef ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "Pas du tout ! Qu'est-ce que c'est que ce surnom ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340609,
					"content": "En tout cas, on dirait qu'il n'a aucune intention de nous attaquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340610,
					"content": "Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340611,
					"content": "Et le voilà parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340612,
					"content": "Il s'est retourné plusieurs fois dans notre direction. Tu penses qu'il veut qu'on le suive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340613,
					"content": "Rattrapons-le.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "Il se pourrait bien que la vérité se trouve droit devant... comme Sango l'avait prédit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340606,
					"content": "« Chien qui a du chien ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "Non, c'est le « Chien en chef » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340608,
					"content": "C'est « Ombre noire ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
				4003409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003409",
							"2"
						],
						"stepId": 4003409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#Bon, c'est déjà ça de fait. Mais c'est bizarre. Kageroumaru avait l'air tellement gentil, et en un rien de temps, on se retrouve à combattre ! Heureusement que {NICKNAME} était là, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340902,
					"content": "#... D'ailleurs, pourquoi Kageroumaru te suit partout, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340903,
					"content": "Ouaf, ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340904,
					"content": "Son aboiement a l'air... joyeux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "Comment tu fais pour savoir ? Moi, je n'ai rien compris du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340906,
					"content": "#Si je ne me trompe pas, Kageroumaru est désormais le ninken de {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340907,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340908,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "Je ne suis pas un expert, mais on raconte qu'un ninja doit vaincre un ninken pour que ce dernier reconnaisse sa force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340910,
					"content": "Les ninjas, tout comme les ninken, souhaitent un compagnon redoutable. Seule une reconnaissance mutuelle permet d'établir un contrat entre ces deux parties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340911,
					"content": "#Mais {NICKNAME} n'est pas {M#un}{F#une} ninja, et puis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340912,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340913,
					"content": "Qu'est-ce qu'il y a, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#... Fais-moi une promesse, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340915,
					"content": "Laquelle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "Promets-moi que tu la tiendras d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340917,
					"content": "D'accord, je tiendrai cette promesse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "Même si tu as un contrat avec Kageroumaru maintenant, n'oublie jamais que c'est moi ta meilleure amie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340919,
					"content": "Je ne l'oublierai jamais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "Super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340921,
					"content": "Tu es déjà bien plus fiable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "#Héhéhé ! Nous sommes les {M#meilleurs amis}{F#meilleures amies} du monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340924,
					"content": "Hum, c'est touchant de voir que vous vous entendez bien, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340925,
					"content": "Si Kageroumaru est si fort que ça, pourquoi cette personne aurait-elle demandé à quelqu'un d'autre d'en prendre soin dans sa lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340926,
					"content": "#Oh, je crois savoir ! {NICKNAME} est quelqu'un de fort, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340927,
					"content": "Oui, beaucoup plus que n'importe quel individu normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340928,
					"content": "#Mais si un jour, je devais {M#le}{F#la} quitter, je me ferai quand même du souci pour {M#lui}{F#elle}. Peu importe sa puissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340929,
					"content": "#... Ça n'arrivera jamais, hein ! C'était juste une analogie pour illustrer mes propos ! {NICKNAME} et moi sommes inséparables !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340930,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "Ton raisonnement est pertinent, Paimon. Dans ce cas, il nous reste une question : pourquoi ce chien volait-il des petits animaux aux villageois pour ensuite les protéger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340932,
					"content": "Euh... Je vous avoue que je ne sais pas trop, malgré ma grande sagesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340933,
					"content": "#Dommage que Kageroumaru ne puisse pas parler, mais {NICKNAME} pourrait lui demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340934,
					"content": "Je pense qu'on devrait aller voir Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "Oui ! C'est l'heure pour le cerveau de l'opération de montrer ses talents !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340936,
					"content": "Très bien. Je vais aller rendre ces animaux et on se retrouvera à l'agence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340922,
					"content": "... qu'un chat ou un chien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "Nous revoilà, Sango. Alors, voilà ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341002,
					"content": "Ah, alors c'était ça. Je pense que j'ai une idée de pourquoi Kageroumaru voulait protéger les autres animaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341003,
					"content": "Il voulait certainement que les autres deviennent plus forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341004,
					"content": "Il était faible quand il était petit et il est devenu plus fort avec le temps. C'est probablement la raison pour laquelle il voulait entraîner les autres à devenir plus forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341005,
					"content": "#Mais Kageroumaru a fini par vous trouver. Vous êtes quelqu'un qui protège les faibles, c'est pourquoi il vous a accepté comme {M#son maître}{F#sa maîtresse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341006,
					"content": "Cela vient également de son empathie pour les plus faibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341007,
					"content": "Enfin, ce ne sont que mes conclusions d'après les indices actuellement en notre possession.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341008,
					"content": "Pour ce qui est des circonstances exactes, je doute de m'être totalement trompée. Mais étant donné que Kageroumaru ne peut pas parler, on ne peut pas avoir de réponse définitive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341009,
					"content": "Hum. Ça fait sens. Comme on pouvait s'y attendre de la part du « cerveau » de cette opération, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341010,
					"content": "Ouaf, ouaf, ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400341011,
					"content": "Ouah, tu es d'accord avec Sango ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341012,
					"content": "Vous me flattez, mais je ne vous accorderai quand même aucune réduction la prochaine fois que vous me confierez une affaire. Sinon, je pense qu'on peut considérer cette affaire comme close.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341013,
					"content": "#Je vous remercie pour votre aide à {M#tous}{F#toutes} les deux, {NICKNAME} et Paimon. Nous n'aurions pas pu élucider ce mystère sans vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341014,
					"content": "Ah ! J'oubliais : comment avez-vous trouvé l'utilisation du Filet d'ubiquité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341015,
					"content": "C'était très pratique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "Je vois. Très bien, j'en toucherai deux mots à mon amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341018,
					"content": "#On vous en prie ! N'hésitez pas à faire appel à nous en cas de problème, {NICKNAME} sera sur le coup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341019,
					"content": "#Il est vrai que {M#le voyageur}{F#la voyageuse} est d'un talent indéniable, mais vous n'avez pas besoin de m'adresser ces paroles aimables. Après tout, les sentiments sont l'ennemi de la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341016,
					"content": "J'avais peur de le déchirer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kageroumaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "Pfiou, on l'a enfin rattrapé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341102,
					"content": "Hein ? On dirait qu'il y a une sorte de... lettre ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341103,
					"content": "Lisons-la. C'est notre seul indice à l'heure actuelle, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341104,
					"content": "Héhéhé, c'est vrai ! Laissez-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341105,
					"content": "« À qui... » blablabla... Argh, c'est tout déchiré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341106,
					"content": "C'est probablement « À qui lira cette lettre. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341107,
					"content": "Hum. Sûrement. Ça dit... « Notre clan est spécialisé dans l'entraînement des ninken, nous avons fourni de nombreux compagnons aux ninjas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341108,
					"content": "« ... J'ai bien peur de ne pas pouvoir revenir de cette dernière expédition. Je n'ai aucun regret, mais s'il me restait des craintes, ce serait pour Kageroumaru. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341109,
					"content": "« Il était trop faible quand il était petit, il a été mis de côté quand les ninjas sont venus pour choisir leur ninken. Ça n'avait pas d'importance pour moi. En tant que dresseur, je n'abandonne jamais un de mes chiens. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341110,
					"content": "« À mesure que les jours d'entraînement ont passé, Kageroumaru est devenu plus fort. Malheureusement, il ne veut pas s'associer avec un ninja. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341111,
					"content": "« La guerre n'a pas encore éclaté mais les missives provenant du Poste de police se font plus pressantes. Je n'ai plus de temps pour lui, il faut que j'y aille. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341112,
					"content": "« Je ne peux que laisser cette lettre derrière moi. Si quelqu'un la trouve dans les jours qui viennent, prenez soin de Kageroumaru pour moi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341113,
					"content": "« Il a une cicatrice sur la face qui remonte à quand il était petit, et il se tient d'une manière très différente des autres chiens. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341114,
					"content": "Alors le « Kageroumaru » dont parle la lettre, c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341115,
					"content": "Celui qui nous a amenés ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "Il est vraiment unique ! Attends, il y a autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341117,
					"content": "« Je comprends que cela puisse être présomptueux de ma part, mais je n'ai pas d'autre choix. Si jamais il voulait s'associer à quelqu'un dans le futur et qu'il parvient à amener cette personne ici, alors voilà comment fonctionne le contrat... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341118,
					"content": "Attendez, j'arrive pas à le croire ! Celui qui a écrit cette lettre a barré la partie la plus importante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341119,
					"content": "Il a probablement pensé que c'était impossible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341120
					]
				},
				{
					"id": 400341120,
					"content": "C'est vrai. Il n'y avait aucune raison de penser le contraire de prime abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341121,
					"content": "Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
