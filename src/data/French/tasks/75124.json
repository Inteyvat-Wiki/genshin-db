							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "*soupir* Il s'est encore enfui. Il n'en reste plus qu'un avec une bouée... Qu'est-ce qu'on fait maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Combien de temps ça va prendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Oh, on dirait que quelqu'un prend des photos... d'oiseaux fluxeaux, ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Ils sont plutôt mignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "La façon dont ils se balancent d'un côté à l'autre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "N'est-ce pas ? Ils sont tellement mignons à se balancer en marchant. Et quand ils se mettent en boule pour flotter sur l'eau... Ah, ça me rend vraiment heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Excellent, ma charmante demoiselle aux magnifiques cheveux argentés et brillants ! Vraiment, la personne qui a créé ces oiseaux fluxeaux mérite tous les éloges du monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "C'est tellement génial, c'est... Oh, attendez, j'ai oublié de me présenter. Je suis amateur de photographie d'oiseaux fluxeaux. Vous pouvez m'appeler Jonvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Je m'appelle Paimon et voici {NICKNAME}... Mais, pourquoi soupirez-vous tristement ? N'y a-t-il pas des oiseaux fluxeaux partout autour de vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "C'est... une longue histoire, mais je vais résumer. Nous sommes beaucoup à partager la même passion, et nous voulons tous prendre les photos les plus originales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "Mais il y a quelques jours à peine, j'ai eu une idée des plus ingénieuses... Immortaliser tous les oiseaux fluxeaux présents dans le champ de mon Daguerréotype avec des bouées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "Et quel est le but, exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Bien sûr, le sens est qu'il n'y a aucun sens ici. Les oiseaux fluxeaux savent nager, et donc, leur faire porter ces bouées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "C'est aussi dénué de sens que d'acheter des moras avec des moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Je me demande si vous ne leur en demandez pas trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "En effet, c'est ce qu'ils appellent la photographie surréaliste : il faut chercher un sens plus profond à la photo que l'on prend... Malheureusement, nous avons rencontré quelques soucis de ce côté-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Évidemment, les vrais oiseaux fluxeaux ne portent pas de bouées, et il n'est donc pas possible de réellement prendre de telles photos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Vous avez appelé ça « surréaliste », vous savez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Attendez. Nous pourrions simplement leur mettre une bouée à tous, non ? Allez, {NICKNAME}. Nous devons l'aider, entre amateurs d'oiseaux fluxeaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Trop bien, une coopération joyeuse et enthousiaste !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Parfaitement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Vraiment ? Vous allez m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Héhé, à condition que vous nous donniez quelques beaux clichés lorsque vous aurez fini !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "E—Eh bien, je m'en remets à vous alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "Même si je préfère les polatouches...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Arrête de dire ce genre de choses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "En effet, ce n'est pas quelque chose que les personnes ordinaires envisagent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Lorsque les oiseaux fluxeaux, qui sont capables de flotter, portent malgré tout des bouées, ça crée une signification en plusieurs couches dans la photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "En explorant pleinement les thèmes de la « surutilisation » et du « gaspillage »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "Je préfère les polatouches, pour être honnête...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Eh bien, ils sont mignons aussi. Mais pourrais-tu vraiment regarder des oiseaux fluxeaux droit dans les yeux et leur dire « les polatouches sont plus mignons » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
