			"dialogs": [
				{
					"id": 751240301,
					"content": "Ah, quel timing parfait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "J'ai du mal à croire que ma quête de clichés, que j'avais trouvée impossible malgré tant de travail acharné, ait pu être achevée si rapidement grâce à votre aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Tous ces oiseaux fluxeaux, leurs formes flottantes et roulantes assises dans les bouées ! Un spectacle tellement émouvant que j'en ai les larmes aux yeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "Est-ce vraiment si émouvant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Parfois, nous passons notre vie à poursuivre quelque chose que les autres ne peuvent pas comprendre voire considèrent absurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Mais je pense que tant que je continuerai à prendre ces photos, le nombre de passionnés d'oiseaux fluxeaux comme nous n'aura de cesse d'augmenter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "J'y crois aussi à cent pour cent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "#Ah, merci beaucoup à {M#tous}{F#toutes} les deux pour votre aide ! Prenez ceci comme un témoignage de ma gratitude, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
