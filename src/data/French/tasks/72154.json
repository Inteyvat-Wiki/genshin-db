	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Attendez ! Ah, monsieur le soldat, la ligne que vous venez de lire manque de gravité émotionnelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "« Samouraï, comme le vent qui balaie la terre. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "Vous vous souvenez encore de ce que j'ai dit sur la scène ? Elle est censée être libératrice et donner au public un sens des vicissitudes de la vie. J'ai dit libératrice ! Libératrice, vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "Cette ligne est la clé de toute la pièce. Vous devez exprimer vos émotions complètement, entièrement et parfaitement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "Il faut que les mouvements d'épée soient moins rapides pour que le Kinétoscope puisse les enregistrer. Et assurez-vous d'être dans son champ de vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Gardez la pose, OK ? Arrêtez-vous un moment, puis sabrez avec une grande force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "Mais vous ne pouvez pas balancer votre épée comme ça quand vous vous battez contre des gens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "C'est vrai, mais vous devez adapter votre jeu aux besoins du tournage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Eh bien. Préparez-vous un peu, et nous essayerons une nouvelle fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#Ah, c'est vous ! Ah, {M#mon cher ami}{F#ma chère amie}, quel bon vent vous amène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "Comme vous le voyez, je tourne un film de cape et d'épée avec notre soldat. Je l'ai appelé « Le septième samouraï ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "Enfin, film de cape et d'épée, c'est ainsi que j'appelle ces films.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "Ce genre de film doit comporter des scènes de combat à l'épée et embarquer le spectateur dans un voyage incroyable sur le champ de bataille... Enfin, c'est l'idée, du moins !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "Monsieur Toranosuke a du temps libre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Le tournage a été approuvé par les seigneurs. Selon eux, il permettra d'accroître le prestige du Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "Cela dit, je n'ai aucune idée de comment monsieur Xavier a réussi à les convaincre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "Honnêtement, monsieur Mikoshi Genjirou est un homme si... sérieux. Heureusement, il est aussi très compréhensif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "Après une discussion sincère entre nous, il a accepté ma demande avec plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "Mais... En échange, je dois faire un film qui raconte l'histoire du Shogunat, de préférence avec un samouraï comme rôle principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "J'ai toujours été intéressé par ce genre de sujet de toute façon, alors bien sûr, j'ai accepté, et le seigneur Mikoshi Genjirou était également très heureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "En plus de nommer personnellement notre bon soldat pour m'accompagner, il m'a aussi assigné des troupes qualifiées, et puis il a dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "« Utilisez ces scènes où l'acier se heurte à l'acier pour montrer la majesté des samouraïs et du Shogunat. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "Je dois dire que monsieur Genshirou est vraiment un homme visionnaire, pour avoir saisi si rapidement le potentiel d'utiliser des films comme outil de propagande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "Quant à moi, je ne refuserais jamais rien qui puisse m'aider à faire mes films.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "Et votre production, tout va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "Honnêtement, ça ne va pas si bien que ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "Bien que ces soldats soient très compétents en arts martiaux, ils ne sont pas habitués à ce type de combat dit « mis en scène ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Non seulement leurs mouvements d'épée sont trop rapides pour que le Kinétoscope puisse les enregistrer, mais ils courent même parfois en dehors du champ de vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous avez le temps, cela vous dérange-t-il de suivre mon scénario et de jouer l'histoire pour que les soldats la voient ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "Je crois qu'avec votre compétence et votre compréhension, vous serez capable de vous comporter brillamment devant le Kinéscope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "Ils devraient être en mesure de mieux comprendre l'histoire après l'avoir vue du point de vue du spectateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Venez, venez ! Lisez d'abord le scénario et le texte. C'est plutôt une scène d'action...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "« La bataille est perdue. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Ah, c'est le texte d'une autre scène... Celle-ci est une scène d'action, donc il n'y a pas beaucoup de répliques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "Très bien, laissez-moi jeter un coup d'œil au scénario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "Au fait, vous jouerez le rôle de « Juusaburou ». Ses compagnons et lui sont employés par les villageois pour protéger le village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "Dans cette scène, un de vos compagnons, « Kyuuzou », a des répliques... Je vais jouer son rôle, et nous allons faire une lecture tous les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Maintenant, vous devez incarner le rôle et le comprendre ! Imaginez que vous êtes « Juusaburou ». Vous avez compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "J'ai compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "Bien, très bien, génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "#Vous me direz quand vous êtes {M#prêt}{F#prête}. Je dois ajuster la position du Kinétoscope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "Je suis « Juusaburou ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "« Mais même en péril, le samouraï reste un samouraï. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "« Vous êtes tous de bons épouvantails... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "« Mais nos ennemis ne sont pas des pinsons. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "Ça vous dirait que je joue un rôle ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#Bien sûr ! Aucun problème ! Vous êtes {M#un héros}{F#une héroïne} de toujours dans mon cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "Je me souviendrai toujours des « Contes de Tatara » que nous avons joués ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Bien que ces soldats soient très compétents en arts martiaux, ils ne sont pas habitués à ce type de combat dit « mis en scène ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Non seulement leurs mouvements d'épée sont trop rapides pour que le Kinétoscope puisse les enregistrer, mais ils courent même parfois en dehors du champ de vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "Comment vous avez réussi à convaincre monsieur Toranosuke ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Notre cher soldat a bien compris la portée d'un tel film. Le plus dur, en fait, a été de persuader monsieur Mikoshi Genjirou de me permettre de tourner un film à Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "« Samouraï, comme le vent qui balaie la terre. »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "Vous dites ces mots avec trop de passion. Ça devrait être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
