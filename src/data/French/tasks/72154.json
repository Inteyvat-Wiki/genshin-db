			"dialogs": [
				{
					"id": 721540801,
					"content": "De quoi parle exactement ce film ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Ah ! Bonne question ! Mais franchement, je ne sais pas non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Pour moi, un film peut parler de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "L'amour, le suspense, l'action, même les mythes illusoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Même si je dois dire que je pense que les films ont une sorte de charme que je n'ai pas encore réussi à faire pleinement ressortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Mais je pense que j'y arriverai si je continue à faire des films.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
