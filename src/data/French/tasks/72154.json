				{
					"id": 721540401,
					"content": "« Film de cape et d'épée »... Quel nom unique monsieur Xavier a trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "Que pensez-vous de ce film ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Les seigneurs pensent que ce film contribuera à étendre le prestige des samouraïs du Shogunat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Peut-être que c'est moi qui ai du mal... Mais je ne vois pas trop en quoi c'est le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Le script est plein de... répliques défaitistes. Il n'y a rien de la dignité du samouraï pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "Je me demande comment les seigneurs ont approuvé un tel script.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Le Fourneau Mikage fonctionne bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Depuis que monsieur Hanbei a eu sa « promotion », c'est Yousuke qui est en charge à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "C'est un artisan dans l'âme, terre-à-terre et fiable. Il montre qu'il est là pour faire avancer les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Maintenant qu'il est en charge du Fourneau Mikage, je doute qu'il y ait d'autres problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
