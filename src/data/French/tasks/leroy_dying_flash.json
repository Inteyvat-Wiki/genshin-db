	"talks": [
		{
			"id": 7414901,
			"completionStepIds": [
				7414901
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
