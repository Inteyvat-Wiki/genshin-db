					"Benoît Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "Vous avez terminé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490502,
					"content": "Ah oui, monsieur Leroy. En fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "#Vous voulez être {M#payés}{F#payées} en bonbons ou en argent de poche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490504,
					"content": "Les deux. On veut les deux, héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Quelle petite gourmande, hahaha. Ce n'est rien, les enfants sont tous comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490507,
					"content": "Et plus spécialement les petites demoiselles toutes mignonnes qui aimeraient manger des macarons, se vêtir de jolies robes et habiter dans une jolie maisonnette comme vous, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490508,
					"content": "#C'est aussi ce que je pense ! Dis {NICKNAME}, est-ce que tu peux m'acheter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "Même pas en rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#*sniff* Hmph ! Tu es vraiment {M#radin}{F#radine} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "#Paimon, nous sommes des {M#aventuriers}{F#aventurières}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Je ne vois pas en quoi c'est incompatible avec des macarons, des robes et une jolie maisonnette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "Regardez-vous en train de vous chamailler... C'est puéril. Votre petite dispute montre que vous n'êtes encore que des enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490515,
					"content": "À vrai dire, je suis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "L'enfance ne dure pas longtemps, c'est pour ça qu'il faut la chérir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490518,
					"content": "D'accord, j'ai compris. Voici vos friandises et votre rémunération, arrêtez de vous chamailler maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490519,
					"content": "Super, à manger ! Merci monsieur Leroy !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Appelez-moi simplement Benoît, Leroy est mon nom de famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490521,
					"content": "Je suis le seul Leroy restant dans tout Fontaine. Quand vous prononcez mon nom de famille, cela m'attriste énormément. Alors s'il vous plaît, appelez-moi simplement par mon prénom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490522,
					"content": "Monsieur Le... Euh, Benoît, votre fille ne porte pas votre nom de famille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia n'est pas ma fille biologique, je l'ai adoptée il y a seulement six mois. Malgré tout, je la considère comme ma fille de sang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490524,
					"content": "Si vous le souhaitez, vous pourrez aussi venir demain. Morticia et Athos seront rentrés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490525,
					"content": "Je suis sûr que ça ne la dérangera pas d'accueillir deux enfants adorables comme vous pour le goûter, surtout que vous nous avez aidés avec le ménage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490526,
					"content": "Parfois, d'autres enfants viennent ici, vous pourrez jouer ensemble à l'occasion. Je les adore, plus il y a d'enfants à la maison, plus elle est animée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490527,
					"content": "Si vous ne me voyez pas quand vous revenez ici, toquez à la porte et Athos vous ouvrira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490528,
					"content": "Très bien ! On reviendra demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "D'accord, je dois rentrer de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490530,
					"content": "À demain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "On se voit plus tard, les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490516,
					"content": "Ça prouve qu'on s'entend très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Paimon, n'oublie pas l'objectif de notre voyage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
