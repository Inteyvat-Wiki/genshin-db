			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "À propos de la nouvelle mission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Oh ? J'ai l'impression que la mission des « Chroniques de l'humanité » ne représente pas un véritable défi pour vous. Ou alors vous êtes à court de moras en ce moment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "On n'a jamais assez de moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Hmm, c'est ce que tout le monde pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "S'il y a quelque chose qui ne manque pas ici, c'est bien des missions. À part la Guilde des aventuriers, L'Oiseau de vapeur est probablement la plus grande source d'offres d'emploi de toute la Cour de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "En théorie, nous ne sommes pas obligés d'offrir ce genre de services pour la société.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Quoi qu'il en soit, puisque vous avez besoin de moras, permettez-moi de vous suggérer un emploi à long terme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Il s'agit d'un mot dans la rubrique des « Chroniques de l'humanité » que monsieur Leroy nous a laissé il y a six mois. La plupart de ceux qui vivent dans cette rue le connaissent très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Malgré sa mauvaise réputation lorsqu'il était plus jeune, je n'ai entendu aucune rumeur fâcheuse à son sujet ces dernières années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Il a été seul la majeure partie de sa vie, et comme sa fille unique n'est pas à ses côtés, il n'y a personne pour prendre soin de lui. Je pense qu'il aurait besoin d'une aide à domicile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "D'après ce que je sais, monsieur Leroy n'est pas avare, le salaire qu'il vous proposera sera certainement attractif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Je pense que ce travail ne comporte aucun risque et la rémunération n'est pas mauvaise. Vous devriez y réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Tout ce qu'il y a à faire, c'est de l'aider dans ses tâches ménagères ? Je trouve que c'est très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Donnez-moi son adresse, s'il vous plaît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "D'accord. Pour aller à la maison de monsieur Leroy, vous devez tourner à deux angles de rue, et ensuite faire un tour jusqu'à... Ah, oubliez ça, je vais vous donner un plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "#N'oubliez pas de lui dire que c'est moi qui vous ai {M#présentés}{F#présentées} à lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Les deux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "#Vous êtes vraiment {M#un jeune homme travailleur}{F#une jeune femme travailleuse}. Très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
			"id": 7414902,
