			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoît Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "Mille moras pour la chemise d'Athos... Et pour le collier de Morticia... Tss ! Les jeunes d'aujourd'hui savent comment gaspiller leur argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490202,
					"content": "Bonjour, monsieur Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Bonjour ! Nous venons de la part de mademoiselle Euphrasie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Vous racontez la raison de votre venue à monsieur Leroy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Haha, c'est une demande qui remonte à six mois. Je ne savais pas que mademoiselle Euphrasie avait conservé cette mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490206,
					"content": "C'est vrai, j'avais en tête de recruter une aide à domicile. Peu importe ce dont on est capable durant notre jeunesse, on aura toujours besoin d'aide pendant nos vieux jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490207,
					"content": "J'ai travaillé dur toute ma vie pour avoir une maison comme celle-ci. Mais en vieillissant, j'ai fini par comprendre que je me retrouvais tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490208,
					"content": "Penser à ça m'a rendu triste pendant un certain temps. C'est donc une bonne chose que ma fille et mon gendre soient venus s'occuper de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490209,
					"content": "Ce sont de bons enfants, et ils s'aiment l'un l'autre. Il n'y a rien qui me fasse plus plaisir que leur compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490210,
					"content": "#Ce qui veut dire, mes jeunes {M#amis}{F#amies}, que je ne recherche plus d'aide à domicile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490211,
					"content": "#On dirait que nous sommes {M#venus}{F#venues} ici pour rien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "#Ne soyez pas {M#déçus}{F#déçues} non plus, je déteste voir des jeunes tristes. Vous devez tous croquer la vie à pleines dents, avec le sourire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490214,
					"content": "#Mais après tout, puisque vous êtes {M#venus}{F#venues} ici sur recommandation de mademoiselle Euphrasie, j'ai peut-être du travail pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490215,
					"content": "#Il se trouve que mes enfants sont sortis et que je ne peux pas tout faire tout seul. Bien sûr, vous serez {M#payés}{F#payées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490216,
					"content": "Waouh, monsieur Leroy, vous êtes vraiment un chic type !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Hahaha, vos paroles sont douces comme du miel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490218,
					"content": "Allez, aidez-moi à nettoyer les taches sur la porte et à l'arrière de la maison. Et pensez à donner du poisson à Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490219,
					"content": "Ah oui, Nana est mon chat, celui qui est près de la porte. Je vous remercie d'avance de sa part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490220,
					"content": "Ça a l'air assez simple. Pas de problème ! Laissez-nous faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Non mais vraiment, cette mademoiselle Euphrasie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
