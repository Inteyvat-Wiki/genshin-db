			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "C'est à vendre ! Pas touche si vous ne l'achetez pas... Hé, vous ! Oui, vous avec les cheveux blonds ! Attendez une seconde, ne partez pas si vite. Laissez-moi vous regarder de plus près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "Hmm, c'est bien ce que je pensais. Cette chevelure brille comme le soleil... Et ces yeux, aussi profonds que le Fief nocturne... Je peux vous assurer... Non, je suis même sûre que vous deviendrez quelqu'un d'incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "#J'ai ici un merveilleux ensemble d'ornements de jade, chacun d'entre eux contient une mélodie différente. Parfait pour {M#un héros}{F#une héroïne} comme vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "Ce sont des trésors inestimables. Si quelqu'un d'autre voulait les acheter, je les aurais cédés pour au moins 10 millions de moras. Comme je vois qu'ils vous sont destinés, vous pouvez les avoir pour un dixième du prix. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Ouah, un dixième ?! C'est une bonne affaire ! Mais attendez... Ça fait plus d'un million de moras. C'est un peu trop, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "Oui, eh bien... C'est le prix coûtant. Les petits commerçants comme moi ne font pas beaucoup de bénéfices, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "Vous ne devriez pas gagner de l'argent de cette manière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Ah, vous avez entendu ? Haha, je crois que j'ai trop l'habitude de parler toute seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "*soupir* Bon, puisque vous savez tout, je vais être franche avec vous. J'ai trouvé ces ornements de jade par hasard. Ils ne valent pas ce prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Enfin, comme vous l'avez entendu, nous sommes un peu à court d'argent. Nous n'avons même pas assez pour payer quelqu'un pour collecter les données des bouées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "Dans ce cas, oubliez les bouées ! C'est mieux que d'arnaquer les gens, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Ce n'est pas possible... Les autres organisations peuvent simplement cesser leurs activités si elles manquent de fonds, mais notre travail bénévole consiste également à observer le volcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Nous avons installé ces bouées pour mesurer l'activité volcanique en recueillant des données sur la température de l'eau, entre autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Le volcan devient de plus en plus actif, alors nous devons les récupérer rapidement, ou les conséquences pourraient être graves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Blessée comme je le suis, je ne peux pas casser les bouées, ni récupérer leurs données...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#Qu'en penses-tu, {NICKNAME} ? Pourquoi ne pas l'aider ? Cette histoire de volcan touche tout le monde, on ne peut pas rester les bras croisés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "V—Vraiment ? Si vous nous apportez votre aide, je vous offre ces ornements de jade ! Ce sera votre récompense. Ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Vous avez parlé d'un million de moras tout à l'heure, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Pas d'inquiétude. Nous n'avons pas grand-chose, mais nous avons certainement plus à vous offrir que ces ornements de jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Héhé, ça nous suffit ! Après tout, on vous rend service pour la sécurité de tous les gens qui se trouvent à proximité du volcan ! Pas de souci, on s'en occupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Commençons tout de suite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "J'ai besoin de me préparer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "On peut commencer quand vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "C'est tout ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Quel type d'aide vaudrait un million de moras ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
