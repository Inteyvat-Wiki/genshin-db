			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Dix, vingt... On a vendu un bon nombre de choses, ce qui a remis nos finances au beau fixe pour le moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Vous n'allez pas essayer de gagner un peu plus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "Haha, non ! Je sais quand m'arrêter ! Si vous ne m'aviez pas aidée et fait preuve de compréhension, j'aurais été dans le pétrin pour ces quelques morceaux de jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "C'est fatigant de courir après l'argent aussi. Pour moi, ce n'est qu'un passe-temps. L'important, c'est d'observer le volcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "On peut toujours gagner de l'argent, mais si un signal d'éruption n'est pas envoyé à temps... Ce serait dévastateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Vous n'êtes pas subventionnés par le Bureau de délibération ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Nous n'en avons pas fait la demande. Avec tout ce qu'ils ont déjà à gérer au quotidien, je doute qu'ils aient besoin de stress supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "La bande et moi, on est différents. On a l'habitude de financer nos voyages avec des petits boulots. C'est un peu devenu notre mode de vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Surveiller le volcan lors de nos déplacements n'est donc pas un problème. Un peu comme vous aidez naturellement les gens qui en ont besoin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Prenez soin de vous, héhé. Peut-être qu'on se reverra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
