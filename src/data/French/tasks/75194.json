			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Quel soulagement ! On dirait que la situation n'est pas aussi grave que ce qu'on pensait. On pourra dormir sur nos deux oreilles cette nuit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "C'est grâce à vous. Si vous ne nous aviez pas aidés sans rancune, les choses ne se seraient pas aussi bien passées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Considérez ceci comme un témoignage de ma gratitude et comme des excuses aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Héhé, si vous le dites... On accepte gracieusement !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "Qu'avez-vous prévu pour la suite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "J'ai encore des stocks de marchandise. Nos activités devraient renflouer les caisses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Nous ne sommes pas dans une situation d'urgence cette fois-ci, alors je serai honnête dans mes affaires. Ne vous en faites pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
