			"dialogs": [
				{
					"id": 250250101,
					"content": "Reviens par là un instant, s'il te plaît ? J'ai besoin de nettoyer cette zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Koholasaure paresseux"
				},
				{
					"id": 250250103,
					"content": "Sois bien sage et remonte, sinon, je devrai te ramener de force !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Koholasaure paresseux"
				},
				{
					"id": 250250105,
					"content": "Oh là là... Il nage si vite, comment vais-je faire pour l'attraper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "Qu'est-ce qu'il vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "Oh ? Vous êtes là pour une baignade ? Désolée, je suis en train de laver le bassin, il faudra attendre un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Et ce chenapan ne veut pas en sortir. *soupir* J'ai tellement de bassins à nettoyer encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Est-ce que je l'ai mis en colère en voulant le forcer à sortir de l'eau l'autre jour ? Quelle galère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
