			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Comment se passent les choses pour toi ces derniers temps, Lyylikki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Ah ! Bonjour, dame Lauma. Tout va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "La réserve d'ingrédients est toujours bien approvisionnée. Personne ne crée de problèmes et mes compétences en cuisine se sont améliorées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "D'ailleurs, les amis dont vous avez parlé la dernière fois... C'étaient ces animaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Ils sont si bien élevés et se contentent de regarder les gens dans la file d'attente. J'ai essayé de leur donner quelque chose à manger, mais ils n'ont pas voulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Ces petits savent qu'ils ont des responsabilités. Quand ils sont en service, ils restent concentrés et font le travail attendu d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "En revanche, n'hésite pas à leur donner une petite friandise après le travail. Je suis certaine qu'ils en seront ravis, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "D'accord ! Je cuisinerai quelque chose de bon pour les remercier aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Merci, Lyylikki. Dis-le-moi si tu as besoin de quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Ça ira, merci ! Je gère ! Mademoiselle Jahoda et monsieur Kantor m'aident aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Très bien. Je te laisse alors. À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Ah, je devrais sortir le prochain lot de repas... Dame Lauma, souhaiteriez-vous goûter à ce plat ? Ça vient d'être préparé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Bon, il faut servir la nourriture dans les assiettes maintenant... Oh ? Où est la vaisselle que je viens de laver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}