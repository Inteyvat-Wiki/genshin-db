				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "Stormterror... Il est en train d'attaquer l'enceinte de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}, vous êtes arrivés à temps ! Nous devons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Pas si vite, Amber. Aurais-tu l'amabilité de nous présenter d'abord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "Ah, oui. Je vous présente Kaeya, capitaine de cavalerie de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#Voici {NICKNAME} et Paimon, {M#deux voyageurs venus}{F#deux voyageuses venues} de loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "#({M#Venus}{F#Venues} de loin ? C'est tout ce qu'elle sait à leur sujet ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "En gros, voilà ce qu'il s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "Je vois... Bienvenue à Mondstadt, même si je crains que vous n'ayez pas choisi le meilleur moment pour arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Je conçois que c'est difficile d'être séparé de sa famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "Par contre, j'ai du mal à comprendre pourquoi vous cherchez l'Archon Anémo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Enfin, tout le monde a des secrets, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "Haha ! Je n'insisterai pas alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "#En tout cas, j'aimerais vous remercier {M#tous}{F#toutes} les deux de la part de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "Nous ne pouvions pas rester les bras croisés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "Un grand nombre d'habitants a été témoin de votre combat contre le dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "#La Grande Maîtresse suppléante de l'Ordre de Favonius voudrait vous rencontrer {M#tous}{F#toutes} les deux au <color=#00E1FFFF>quartier général de l'Ordre</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "Mais de rien ! Où est notre récompense ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Hum... Que diriez-vous d'un délice de viande et de carottes au miel ? C'est une spécialité culinaire traditionnelle de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "Je crois que j'ai déjà entendu ça quelque part...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}