			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "C'est vous... Je me souviens de vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020202,
					"content": "#J'étais en train de m'occuper de certaines créatures qui avaient été contaminées par les démons. Il semble que je vous ai {M#dérangés}{F#dérangées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020203,
					"content": "(Hein ? Il n'est pas aussi poli que ça d'habitude, qu'est-ce qu'il se passe...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020204,
					"content": "Mais vous êtes ici pour exorciser les démons, comment pourriez-vous déranger qui que ce soit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020205,
					"content": "Parce que les mutations qui s'opèrent dans ces monstres proviennent de moi... ou plus précisément du karma que j'ai accumulé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020206,
					"content": "Mutations, karma... Est-ce que ça veut dire...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020207,
					"content": "Ce livre en parlait... « Les Yakshas, gardiens Adeptes »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "Oui. Je me rappelle que Xiao est aussi appelé le « Gardien Yaksha », n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020210,
					"content": "Alors... alors ça veut dire... Ohhhhh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020211,
					"content": "*sniff* Pauvre Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020213,
					"content": "On a lu votre histoire dans un livre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "Je vois. Vous devez parler de ce morceau de fiction littéraire d'il y a des centaines d'années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020216,
					"content": "Rien n'est permanent, exister c'est agoniser. Mais nous, les Yakshas, n'avons besoin ni de sympathie ni de larmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020217,
					"content": "Mes compagnons tombés verraient vos larmes comme une tache sur leur héritage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020218,
					"content": "Oh, euh... Je suis vraiment désolée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020219,
					"content": "Ça n'a pas d'importance. Quoi qu'il en soit, j'étais en chemin pour purifier une caverne de son influence démoniaque, c'est ici que nos chemins se séparent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020220,
					"content": "A—Attendez ! Laissez-nous vous accompagner. On va vous aider, je vous le promets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020221,
					"content": "Ce n'est pas nécessaire. J'ai l'habitude de combattre seul et de toute façon, ces mutations sont ma responsabilité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020222,
					"content": "Eh bien... Disons que c'est ma façon de m'excuser pour avoir manqué de tact à l'instant ! ... Ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020224,
					"content": "... Allons-y alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020214,
					"content": "On a lu « Les Yakshas, gardiens Adeptes ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "Xiao est donc le « dernier Yaksha » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
			"id": 1110204,
