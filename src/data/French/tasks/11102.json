			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "Cet endroit me donne la chair de poule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020402,
					"content": "Je vais utiliser le rituel connu sous le nom de Fléau du mal pour purifier cet endroit de son karma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020403,
					"content": "Vous devez rester calmes. Ne vous laissez pas affecter par la colère persistante des dieux du passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "Nous avons bien fait de venir ici. Il y avait un nombre anormal de créatures qui étaient tombées sous l'influence démoniaque. Si nous n'étions pas arrivés à temps, les conséquences auraient pu être désastreuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020602,
					"content": "Maintenant, qu'en est-il de ce « Céleste voleur d'étoiles » dont vous parliez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020603,
					"content": "Oh, je vais vous raconter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020604,
					"content": "Un Adepte qui exauce des souhaits... Dire que des gens ont pu se faire avoir par des mensonges aussi flagrants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020605,
					"content": "Et vous en tant qu'Adepte, vous pouvez exaucer des vœux, Xiao ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020606,
					"content": "Les Liyuéens d'autrefois n'auraient jamais demandé aux Adeptes de leur accorder des faveurs non méritées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020607,
					"content": "Il y a des milliers d'années, le peuple ancestral de Liyue n'aspirait à rien de plus qu'avoir la force de protéger la terre qu'il appelait sa patrie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020608,
					"content": "Euh... Pour être honnête, un Adepte qui exauce les souhaits a plus d'attrait pour les gens aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020609,
					"content": "Peu m'importe les faiblesses des gens d'aujourd'hui. Tout ce qui m'intéresse est d'honorer la volonté originelle du Souverain de la Roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020610,
					"content": "Oups... J'ai encore parlé sans réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020611,
					"content": "Oh, ah, encore une chose ! Ce faux Adepte a un talisman de permission. C'est ce qu'il utilise pour exorciser les démons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020612,
					"content": "Attendez, vraiment ? Quelle bêtise. Exorciser les démons sans les exterminer... Rien d'étonnant à ce qu'ils se soient rassemblés ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020613,
					"content": "Si cela continue ainsi, la situation pourrait échapper même à mon contrôle... Nous devons confisquer ce talisman de permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020614,
					"content": "On va simplement le « confisquer » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "On pense à la même chose ! Je suis d'accord, on devrait lui montrer ce qu'il en coûte d'essayer de nous avoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020617,
					"content": "Et il se trouve qu'on a un véritable Adepte avec nous en plus ! Si Xiao lui donne une leçon, je suis sûre qu'il n'osera plus jamais se faire passer pour un Adepte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020618,
					"content": "Non. Je n'élimine que les démons, je ne tue pas les mortels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020619,
					"content": "On n'a jamais parlé de le tuer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020621,
					"content": "Ça serait certainement dans l'intérêt de Liyue de le convaincre de cesser ses manigances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020622,
					"content": "Je possède une technique appelée « Voie des rêves ». Elle est normalement utilisée pour séparer l'âme du corps et les entraîner lors d'un rêve éveillé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020623,
					"content": "Mais elle peut également être utilisée pour appeler d'autres âmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020624,
					"content": "Ouah, c'est ce j'appelle une véritable technique d'Adepte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020625,
					"content": "C'est comme ça qu'on transmet des visions dans les rêves ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "Il faut procéder à un rituel pour utiliser cette technique. Aidez-moi à récupérer quelques objets... Un encensoir, sept lampes et quelque chose qui puisse réduire la température.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020628,
					"content": "Réduire la température... Oh, des fleurs de brume devraient faire l'affaire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020629,
					"content": "Mais pour ce qui est de l'encensoir et des sept lampes... Hmm... Ce ne sont probablement pas des choses qu'on va trouver dans la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020630,
					"content": "Connaissez-vous les deux statues de Yaksha qui gardent les abords de la route des marchands, sur la face sud des Monts Tianheng ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020631
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020631,
					"content": "Les ancêtres du peuple de Liyue ont construit des sanctuaires là-bas. Vous devriez pouvoir y trouver des objets rituels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
