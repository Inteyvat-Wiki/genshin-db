				"points": []
			},
			"dialogs": [
				{
					"id": 700270101,
					"content": "Vous arrivez juste à temps. Le travail de calibrage sur les Pointes de Pursina se déroule comme prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270102,
					"content": "Avec les composants, elles seront réparées en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270103,
					"content": "J'en ai trouvé quelques-uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "Merci, ça m'est d'une grande aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270105,
					"content": "Avec ces composants, je vais pouvoir les réparer maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270106,
					"content": "Il y a encore un petit problème dont j'ai pensé qu'il valait mieux que je vous parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270107,
					"content": "Lorsque vous avez collecté des composants ces derniers jours, j'ai observé le fonctionnement interne des Pointes de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270108,
					"content": "C'est un outil très complexe, comme j'aurais dû m'y attendre d'une personne aussi douée que Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270109,
					"content": "Même un petit ajustement peut grandement affecter le fonctionnement de l'ensemble de la machine, j'étais donc un peu inquiet de voir si notre calibration aurait l'effet souhaité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270110,
					"content": "Pour des raisons de sécurité, j'aimerais vous demander de faire quelques essais. Je ferai ensuite d'autres calibrations sur la base des données que vous aurez récoltées pendant ces essais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270111,
					"content": "Comme ça, on pourra s'assurer que nos pointes fonctionnent de manière optimale. Sinon, les choses pourraient mal tourner quand vous aurez à faire au Colosse des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270112,
					"content": "C'est très consciencieux de votre part.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "C'est la première fois que j'utilise les Pointes de Pursina. Alors, il vaut mieux être prudent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270115,
					"content": "#Je vous laisse vous occuper des tests, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hussein"
				},
				{
					"id": 700270113,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
}