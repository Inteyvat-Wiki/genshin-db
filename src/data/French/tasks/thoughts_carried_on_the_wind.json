			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "Vous avez réussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350302,
					"content": "Et pas qu'un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "Je vous remercie. Le danger est écarté pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350304,
					"content": "Vous devriez vraiment regagner la cité maintenant. Je m'excuse de vous avoir demandé de risquer votre vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350305,
					"content": "Quand vous y serez, pourriez-vous me rendre un service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350306,
					"content": "Ce n'est pas grand-chose ! Mais promettez-moi de le faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350307,
					"content": "Qu'est-ce donc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Hum, pourriez-vous prendre des nouvelles de Gloria ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350309,
					"content": "Elle devrait être en sécurité, mais je ne peux pas m'empêcher de me faire un sang d'encre pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350310,
					"content": "Je vous en prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350311,
					"content": "D'accord, j'irai la voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "Merci du fond du cœur ! Oh, et ne lui dites pas que je suis ici ! Pour elle, je suis encore en expédition dans une contrée lointaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350313,
					"content": "Je suis désolé de vous embêter avec ça, mais elle ne doit pas savoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113504,
