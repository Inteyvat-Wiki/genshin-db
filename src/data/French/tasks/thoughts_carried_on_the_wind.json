				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "Je me demande comment va ma Gloria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "Ah, ce n'est que vous. Le coin est dangereux en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350104,
					"content": "Regagnez la cité pour votre sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350105,
					"content": "Et vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Eh bien, je... je vais rester ici pendant un moment. Un chevalier de Favonius n'abandonne jamais son poste, même dans les temps difficiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350107,
					"content": "Je ne peux pas retourner à Mondstadt pour certaines raisons, et puis je peux toujours être utile en restant ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350108,
					"content": "Les monstres des environs sont devenus très agressifs après la chute des météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350109,
					"content": "Si nous ne les maîtrisons pas maintenant, cela pourrait dégénérer. D'ailleurs, je m'apprêtais à aller les combattre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350110,
					"content": "Tout seul ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Ils sont en effet très nombreux... mais ça devrait aller si je me montre prudent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350112,
					"content": "Par contre, les vaincre me prendra certainement énormément de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350113,
					"content": "Si ça ne vous dérange pas, pourriez-vous m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350114,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Merci beaucoup, vous me sauvez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350116,
					"content": "Pourquoi ne pas demander de l'aide à vos collègues ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Hum, disons que j'ai mes raisons pour ne pas le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350118,
					"content": "Vous pouvez m'aider à nettoyer ces camps de monstres ? Considérez cela comme un service rendu aux chevaliers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
