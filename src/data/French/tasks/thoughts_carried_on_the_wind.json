			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gloria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "J'espère que Godwin est sain et sauf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350402,
					"content": "Godwin m'a envoyé prendre de vos nouvelles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Godwin ? Vous savez où est-ce qu'il est ? Cela fait un moment que je n'ai plus entendu parler de lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350404,
					"content": "Il est encore en expédition dans une contrée lointaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350406,
					"content": "Si cette pluie de météorites ne s'était abattue sur le pays, j'aurais demandé aux chevaliers de prendre de ses nouvelles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350407,
					"content": "Je n'ai rien à craindre comme je ne bouge jamais de la cité, mais lui... Il est sans doute en train d'accomplir sa mission coûte que coûte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350408,
					"content": "*soupir* Faites qu'il n'ait rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350409,
					"content": "#Ne vous inquiétez pas, je suis {M#sûr}{F#sûre} qu'il va très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Merci. Ce serait merveilleux... D'ailleurs, pourriez-vous me faire une faveur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350411,
					"content": "J'ai acheté des graines de pissenlit chez Flora et je cherchais quelqu'un pour les disperser à un endroit en hauteur... pour que le vent les transporte vers Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350412,
					"content": "Mais avec la situation actuelle, aucune chance de trouver une personne qui veuille bien m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350413,
					"content": "Si vous le croisez, pourriez-vous lui remettre ces graines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350414,
					"content": "Oui, avec plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Merci. Mon bien-aimé doit être si loin d'ici... Après tout, il a rejoint l'expédition du Grand Maître...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Gloria"
				},
				{
					"id": 411350416,
					"content": "Dites-lui que je vais bien et qu'il doit prendre soin de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gloria"
				}
			]
		},
		{
			"id": 4113505,
			"completionStepIds": [
				4113507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
