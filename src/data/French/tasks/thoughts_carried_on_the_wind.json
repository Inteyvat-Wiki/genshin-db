					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350501,
					"content": "#Avez-vous vu Gloria, {M#voyageur}{F#voyageuse} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350502,
					"content": "Comment va-t-elle ? Elle n'est pas blessée, j'espère ? Je sais qu'elle n'a pas quitté la cité depuis tout ce temps, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350503,
					"content": "Elle voulait vous donner ces graines de pissenlit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350504
					]
				},
				{
					"id": 411350504,
					"content": "Des graines de pissenlit ? C'est bien quelque chose qu'elle ferait... *soupir* J'espère qu'elle ne m'en veut pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350505
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350505,
					"content": "Merci beaucoup pour votre aide et prenez ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350506,
					"content": "*soupir* Si seulement le Grand Maître était là, nous n'aurions rien eu à craindre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113506,
