			"dialogs": [
				{
					"id": 411350201,
					"content": "Où le Grand Maître peut-il bien se trouver ? A-t-il eu mot de ce phénomène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "*soupir* Il ne serait de toute façon pas en mesure de revenir rapidement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
