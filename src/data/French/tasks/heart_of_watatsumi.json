			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490302,
					"content": "Tsuyuko ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "Ah, toutes mes excuses. J'étais perdue dans mes pensées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490304,
					"content": "Grâce à vous, nous avons pu mettre la main sur la « clé des profondeurs baignées de lune ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490305,
					"content": "La clé des profondeurs beignet de lune ? Euh, c'est quoi ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490306,
					"content": "#Haha, vous pouvez juste l'appeler « clé des profondeurs ». Nous n'allons pas embêter {M#un étranger}{F#une étrangère} avec ce genre de détails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490307,
					"content": "C'est quelque chose dont nous aurons besoin pour ouvrir l'entrée d'Enkanomiya. Elle a été forgée à partir du sang répandu de la Divinité des tréfonds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490308,
					"content": "... Enfin, c'est ce que dit la légende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490309,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490310,
					"content": "Tout ça devient de plus en plus étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "Haha ! Mais non, ce n'est pas étrange du tout ! En fait, c'est tout le contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490312,
					"content": "Eh bien, pour le moment, nous avons juste à faire notre rapport à la Prêtresse divine, obtenir son approbation et attendre que le flux des lignes spirituelles nous soit favorable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490313,
					"content": "Une fois ces conditions réunies, nous pourrons nous diriger vers Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490314,
					"content": "Attendez, alors pourquoi on a fait tout ça au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490315,
					"content": "Eh bien, ce n'est pas comme si vous reveniez les mains vides de cette aventure, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490316,
					"content": "Je veux dire... Vous avez gagné... l'amitié éternelle du Sanctuaire de Sangonomiya ! L'Île de Watatsumi vous accueillera toujours à bras ouverts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490317,
					"content": "Vous n'avez pas quelque chose d'un peu plus concret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490319,
					"content": "Les archives mentionnent que les perles d'esprit ne répondront qu'à l'appel d'un individu pur et que la clé n'apparaîtra qu'à une personne dont le cœur est aussi limpide que l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490320,
					"content": "Je ne crois généralement pas ce que disent ces textes, mais je pense que vous avez vraiment le pouvoir de changer la situation de l'Île de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490321,
					"content": "Eh bien, quand le temps viendra de descendre à Enkanomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490322,
					"content": "On se reverra, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "Alors, à bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490323,
					"content": "Les cartes vous le diront, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "Héhé. On m'a prédit beaucoup de chance, je suis certaine qu'on se reverra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
