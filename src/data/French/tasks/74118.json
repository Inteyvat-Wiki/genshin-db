					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "... Monsieur, nous devrions peut-être nous rendre d'abord à Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Bien que monsieur Xavier et monsieur Félix ne soient pas là, monsieur Mécantre et monsieur Babisse devraient toujours être au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Peut-être qu'ils pourront vous donner des conseils ou de l'inspiration. Même dans le pire des cas, vous aurez deux personnes à qui vous pourrez confier ce qui vous trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "Non, mon cher Lutong, non... Les recherches de Mécantre et de Babisse battent leur plein en ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "La dernière fois qu'ils m'ont écrit, ils m'ont dit qu'un homme brillant de l'Institut de recherche de Fontaine était arrivé à Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Monsieur Bossuet est très érudit et perspicace. Il les a aidés à résoudre beaucoup de problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "Et moi... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#{NICKNAME}, c'est un plaisir de vous revoir. Je ne savais pas qu'on se reverrait à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Même si... vous arrivez au bon moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Oui, quelle sacrée coïncidence... Nous sommes quand même très heureux de vous revoir, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Ouah, il a l'air épuisé et ses cernes sont très prononcés... Il a l'air complètement exténué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "Qu'est-ce que vous avez, Garcia ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Nous... Euh, les recherches de monsieur ont fait face à des problèmes sans précédent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "Mais c'est une longue histoire... Nous allons nous rendre à l'Opéra Épiclèse afin de les aider à régler leurs comptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "Quand nous en aurons fini avec ça, nous aurons l'occasion de trouver un endroit calme pour discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "Vous avez un autre travail à faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Ce n'est pas vraiment un travail. Nous sommes simplement embauchés ici et là pour aider à faire divers calculs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "L'Opéra Épiclèse a accueilli de nombreuses troupes ces derniers temps. Nous avons besoin d'en dresser un bilan en urgence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Par conséquent, afin de couvrir le coût du retour à Petrichor, nous... Enfin, j'ai accepté cette mission en représentant monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Ce n'est pas grand-chose non plus ! Ces calculs sont si simples que je peux tous les faire en un après-midi et même sans utiliser l'Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "C'est donc un bon moyen pour nous de récolter des fonds. Dépêchons-nous, monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#D'ailleurs, {NICKNAME}, puis-je vous demander de nous accompagner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "#Avec {M#un ami aussi renommé}{F#une amie aussi renommée} que vous à nos côtés, nous ne rencontrerons certainement aucun problème qui pourrait nous entraver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "Nous vous récompenserons en conséquence, ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Je ne peux pas vous le garantir... Héhé. Dans tous les cas, nous devons y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "Il ne devrait pas y avoir de problème en ville.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Vous êtes de retour à Fontaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
