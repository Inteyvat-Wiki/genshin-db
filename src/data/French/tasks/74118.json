					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "Il faut l'avouer, cet opéra est très impressionnant. Il doit être très rentable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "L'opéra... *soupir* Nous ferions mieux de nous mettre au travail rapidement. Une fois que nous aurons fini avec ça, nous pourrons retourner à Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180203,
					"content": "Ensuite, j'ouvrirai une pâtisserie en ville et je ne toucherai plus jamais à une Arithmétrice de ma vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180204,
					"content": "Euh... Monsieur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "#Qu'est-ce qu'il y a, Lutong ? Votre visage... Vous avez vu un fantôme ou quoi{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180206,
					"content": "C'est vraiment... un fantôme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180207,
					"content": "Garcia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "Mademoiselle Kaia ?! Mais qu'est-ce qu'elle fait ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Sacrée coïncidence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Monsieur, ce que vous venez de dire est déplacé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Oh, taisez-vous, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180212,
					"content": "#Garcia, quel plaisir de te voir ici, et vous aussi, {NICKNAME}. Laisse-moi deviner, tu es venu aider l'opéra à régler ses comptes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "Est-ce que les comptes qu'il doit régler sont...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "Pas du tout. Notre troupe ne se produit pas dans cet opéra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "Cependant, Garcia n'a jamais été du genre à voir des spectacles d'opéra pendant son temps libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "La raison pour laquelle tu es venu à l'opéra... C'est seulement parce que tu as été embauché pour y travailler, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "Je sens du fond de mon cœur que vous êtes plus apte à l'accompagner que moi, mademoiselle Kaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Chacun d'entre nous est irremplaçable, mon cher Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "Je... Euh... Kaia, ravi de te revoir. Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180220,
					"content": "... Mais tu n'as pas l'air très content. Tes recherches ne se passent pas très bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "Vous aussi, vous l'avez deviné ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "Oh, au moins il n'est pas malheureux de me voir, ni vous ou Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "La seule chose qui puisse rendre heureux Garcia dans sa vie est cette Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "Comment connaissez-vous aussi bien Garcia, mademoiselle Kaia ? Vous ne vous êtes pas vus depuis si longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Peut-être que c'est son intuition.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "Vous devriez probablement aller vous poser dans un café et discuter tranquillement. Ce n'est pas quelque chose qu'on peut expliquer en quelques mots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "Je dois encore... Euh, non. Je suis content... Mais nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180229,
					"content": "Ne vous inquiétez pas, monsieur. Ces calculs sont extrêmement simples. Je peux tout faire moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "... Vous ne pouvez pas laisser mademoiselle Kaia de côté jusqu'à ce que notre travail soit terminé, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Vous êtes vraiment attentionné, Lutong. Nous vous apporterons une tasse de café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Je vous remercie, mademoiselle. Profitez bien de votre café avec monsieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "Kaia et Garcia partent ensemble...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "Ils sont juste partis boire un café... Cela n'avait rien à voir avec nous depuis le début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "Absolument rien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#Vous vous méprenez, {NICKNAME}. Votre mission officielle est sur le point de commencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "Il faut chercher des ingrédients ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "Vous en avez, de l'humour. Mais je n'ai pas l'intention de vous faire perdre votre temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "En fait, monsieur Garcia et moi sommes en danger actuellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "Hein... Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Allons en discuter un peu plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "Il faut chercher des composants ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "Et si j'allais les prendre en photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "Alors qu'est-ce qu'on fait là...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "Garcia est un homme simple à comprendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
