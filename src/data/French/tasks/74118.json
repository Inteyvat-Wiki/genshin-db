						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "... Ici, ça devrait aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Permettez-moi de commencer depuis le début. Depuis que vous nous avez aidés à modifier l'Arithmétrice à Sumeru, les performances de cette machine ont fait un bond en avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Monsieur Garcia était très enthousiaste et voulait continuer à l'améliorer. Mais comme il l'a dit, les structures traditionnelles de transmission des machines sont limitées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Les performances de cette Arithmétrice ne peuvent plus être améliorées, nous souhaitions donc retourner à Fontaine pour trouver d'autres idées pour nos recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Mais sur le chemin du retour, un homme étrange est venu voir monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "Il lui a déclaré qu'il pourrait lui financer ses recherches et même l'aider à trouver d'autres collaborateurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "Mais en échange, monsieur Garcia devait partager avec lui toutes ses idées de conception et les données de son Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Garcia n'accepterait jamais ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Mais au fait ! C'est du vol d'obliger quelqu'un à remettre les résultats de ses recherches, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Exactement. C'est pour ça que monsieur Garcia a fermement refusé l'offre de cette personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Mais depuis cette affaire, j'ai l'impression que nous sommes suivis, monsieur Garcia et moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "En plus, quelqu'un est entré dans notre chambre et a fouillé dans nos affaires pendant que nous étions dehors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "Même si cette personne a tout remis en place, monsieur Garcia a quand même retrouvé des traces de son passage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "C—C'est effrayant... Il n'a pas voulu les lui donner, alors ce type est venu les voler ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "À vrai dire, après avoir découvert que notre chambre a été fouillée, nous avons décidé de rassembler de l'argent pour quitter cet endroit et retourner à Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Une fois sur place, nous contacterons plusieurs autres gentilshommes du club des rêvasseurs pour résoudre cette affaire ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Et Petrichor est... Héhé, c'est le quartier général de monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Pour lui, il n'y a pas d'autre endroit plus sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "Nous étions censés partir aujourd'hui pour notre voyage vers Petrichor. C'est pour ça que nous aimerions vous demander de nous y escorter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "Je ne pensais pas que nous tomberions sur mademoiselle Kaia... Par mesure de sécurité, je n'ai pas eu d'autre choix que de laisser monsieur Garcia la ramener en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "Qu'est-ce que je peux faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "On dirait que nous allons devoir reporter notre jour de départ. Faites au plus vite pour retrouver monsieur Garcia. Faites comme je vous ai dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "#Avec {M#un ami aussi renommé}{F#une amie aussi renommée} que vous à nos côtés, nous ne rencontrerons certainement aucun problème qui pourrait nous entraver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "J'y vais tout de suite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Monsieur Garcia informera mademoiselle Kaia de tout ce qui s'est passé. Quant à la suite... Laissons-la décider par elle-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "Quoi qu'il en soit, nous ferions mieux de retourner en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "Ils ne vont tout de même pas se retrouver dans une situation dangereuse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "Non, je ne pense pas. Monsieur Garcia est toujours dans l'enceinte de la Cour de Fontaine, il y a beaucoup de Gendarmeks qui patrouillent là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "S'ils veulent recourir à la violence, la Maison Gardiennage résoudra la plupart de ces problèmes pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "Comment puis-je vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "À vous entendre, ce type n'a pas l'air d'être quelqu'un de bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
