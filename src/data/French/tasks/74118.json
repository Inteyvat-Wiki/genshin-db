			"dialogs": [
				{
					"id": 741185001,
					"content": "#À votre service, très {M#cher}{F#chère} {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185002,
					"content": "Qu'est-ce que vous comptez faire pour la suite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "Pour le moment, nous n'avons pas encore découvert l'identité de ces personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185004,
					"content": "Nous avons déjà signalé cette affaire, mais nous n'avons pas d'indices et les officiers n'ont aucun moyen de mener une enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "Et puis, la Cour de Fontaine est si grande qu'ils ne peuvent pas s'occuper de nous partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185006,
					"content": "Et maintenant... Mademoiselle Kaia est impliquée, ce qui risque de compliquer les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185007,
					"content": "J'espère que monsieur Garcia pourra persuader mademoiselle Kaia de quitter Fontaine rapidement. Et si c'est le cas, nous pourrons toujours agir selon le plan initial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "Alors les recherches de monsieur Garcia sont dans une impasse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "Cette impasse veut dire que ses performances ne peuvent pas être améliorées davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "Mais dans le domaine des applications pratiques, cette Arithmétrice a un grand potentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "Cependant, monsieur Garcia n'y a jamais vraiment prêté attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "Je pense que c'est l'une des raisons pour lesquelles il souffre si souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "Mais c'est précisément pour cette même raison qu'il joue si bien le rôle du chercheur frustré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Je m'en remets donc à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
