						741180503
					]
				},
				{
					"id": 741180503,
					"content": "Vous racontez ce qui s'est passé à l'officière Menthe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "C'est à propos de monsieur Garcia... Je comprends. Allons le voir ensemble.",
