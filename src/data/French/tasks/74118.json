					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180403,
					"content": "J'en suis certain, c'est lui qui nous suit depuis quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
