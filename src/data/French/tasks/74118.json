				},
				{
					"id": 741180404,
					"content": "Je vais prévenir un officier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "C'est une bonne idée... Il y en a un pas loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Nous avons déjà signalé cette affaire à l'officière Menthe, et elle est également au courant de la situation actuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Je suis sûr qu'elle est prête à nous aider. Avec quelqu'un comme elle à nos côtés, cette bande n'osera pas faire quoi que ce soit de radical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, allez expliquer ce qui se passe à l'officière Menthe. Je vais aller voir monsieur Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180410,
					"content": "Très bien, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180405,
					"content": "Sérieusement, prévenons les Gendarmes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				}
			]
