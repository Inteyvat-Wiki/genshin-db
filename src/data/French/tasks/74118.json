				]
			},
			"dialogs": [
				{
					"id": 741180601,
					"content": "... Je vous remercie, officière Menthe. Il s'est levé et est parti dès que vous êtes arrivée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180602
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180602,
					"content": "Ce n'est rien, je ne faisais que mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Monsieur, nous devrions quitter rapidement cet endroit et retourner à Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Je pense qu'ils sont en train de perdre patience. Ils vont sûrement... faire quelque chose de radical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Je vais le signaler à mes supérieurs. J'aurai une réponse dans les prochains jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Dans le meilleur des cas, nous pourrons envoyer quelques-uns de nos collègues pour vous escorter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Mais nos effectifs sont limités et nous devons nous occuper des affaires de la ville. Nous ne pouvons vous accompagner que sur une certaine distance, et pas jusqu'à Petrichor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "D'ici là, vous feriez mieux de rester dans un endroit sûr. Les discussions sur cette affaire pourraient continuer... pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Laissez-moi vous escorter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "Merci. Avec vous à mes côtés, cette bande de crapules n'osera rien faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "Mais mademoiselle Kaia ne travaille-t-elle pas avec la troupe ? Si vous allez à Petrichor, elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "Oh, je vais y aller avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "Comment ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Mademoiselle, je vous le demande du fond du cœur. S'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180616
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180616,
					"content": "Cher Lutong, n'essayez pas de m'en dissuader. Comme votre patron, je ne me laisserai pas faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180617
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180617,
					"content": "Mais... Mais nous ne savons pas sur quels dangers nous allons tomber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180618
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180618,
					"content": "Raison de plus pour moi de venir avec vous ! Ou comptes-tu m'abandonner à nouveau comme la dernière fois, avec rien d'autre qu'une partition de musique sans début ni fin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180619
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180619,
					"content": "D'ailleurs, le directeur de notre troupe est également très intéressé par ce genre de partition musicale calculée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180620
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180620,
					"content": "Je pense qu'il devrait également être très favorable à ce que je voyage avec vous... Bon, c'est tout ce que j'avais à dire. Où devrions-nous aller ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180621
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180621,
					"content": "C—Comme à Sumeru, mademoiselle Kaia a pris le dessus sur Garcia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180622,
					"content": "Garcia ne pourra jamais s'imposer face à elle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180623
					]
				},
				{
					"id": 741180623,
					"content": "Peut-être que monsieur Garcia n'avait pas l'intention de gagner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "*tousse* Lutong ! Dépêchons-nous de trouver où nous loger ! Un endroit avec beaucoup de monde serait l'idéal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Un endroit avec beaucoup de monde... On pourrait peut-être aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Pourquoi ne pas vous rendre à l'hôtel où se trouve notre troupe ? Il y a beaucoup de monde et nous nous connaissons tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Si un intrus cherche à s'y infiltrer, il sera immédiatement découvert. De plus, le directeur de notre troupe doit aussi vouloir en savoir plus sur l'Arithmétrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "C'est décidé ! Génial, tous nos problèmes sont résolus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Tous nos problèmes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#Voilà qui est fait ! {NICKNAME}, veuillez accepter ceci comme acompte pour vos services.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "Je ne sais pas quand nous pourrons nous mettre en route... Mais le moment venu, je compterai sur votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "Mais pourquoi j'ai l'impression que nous avons de plus en plus de problèmes maintenant ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Je peux vous escorter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
		},
