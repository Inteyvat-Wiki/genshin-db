			"dialogs": [
				{
					"id": 718300601,
					"content": "Très bien. Je vais prendre les morceaux de <color=#00E1FFFF>bois d'haréna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300602
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300602,
					"content": "Le temple va prendre un moment à réparer, donc je vais rester ici pendant ce temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
