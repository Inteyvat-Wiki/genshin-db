			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Boss des Pilleurs de trésors"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "S—S'il vous plaît, arrêtez ! Vous avez gagné ! Mais s'il vous plaît, épargnez-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300402,
					"content": "Prenez vos affaires et déguerpissez !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "O—Oui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300405,
					"content": "Mais... Est-ce que je peux vous demander ce qu'on a fait pour vous mettre en colère comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300406,
					"content": "Vous avez trouvé un trésor dans la zone, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300407,
					"content": "On répare un temple pas loin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "Vous réparez un temple ? Au milieu de ces montagnes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300409,
					"content": "... Il y a un temple commémorant un Adepte ici ?! Attendez une minute. Est-ce que ce serait pas cette vieille maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300410,
					"content": "Patron, on a vu une statue d'oiseau quand on se reposait là-bas. Ça devait être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Acolyte des Pilleurs de trésors"
				},
				{
					"id": 718300411,
					"content": "C'est Pervases, un des Yakshas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300413,
					"content": "P—Patron ! V—Vous pensez vraiment qu'on a fâché un Adepte...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Acolyte des Pilleurs de trésors"
				},
				{
					"id": 718300414,
					"content": "A—Arrête de dire des bêtises ! On ne savait pas, donc ça ne compte pas ! On n'y pouvait rien ! L'Adepte ne nous en voudra pas... Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300415,
					"content": "Bon, enfin, merci de nous avoir dit qu'il y avait des réparations en cours au temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300416,
					"content": "On est désolés... On savait pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300417,
					"content": "On va aller dire aux autres de prendre leurs distances avec le temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300418,
					"content": "Patron, est-ce qu'on ferait pas mieux d'y aller et d'allumer quelques bâtons d'encens pour s'excuser auprès de l'Adepte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Acolyte des Pilleurs de trésors"
				},
				{
					"id": 718300419,
					"content": "Hé, hé, quand est-ce que t'es devenu aussi bavard ! Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boss des Pilleurs de trésors"
				},
				{
					"id": 718300403,
					"content": "Ne revenez plus dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
