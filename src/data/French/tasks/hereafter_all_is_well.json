					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Haha, c'est parfait. Rapportez-moi simplement le <color=#00E1FFFF>bois d'haréna</color> que vous aurez trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "Est-ce qu'il y a d'autres gens qui ont déjà apporté leur contribution ?",
