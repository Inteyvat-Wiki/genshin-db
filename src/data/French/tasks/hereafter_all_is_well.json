			"trigger": {
				"objectNames": [
					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Ça va vraiment être quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "Vous êtes vraiment en train de réparer cet endroit, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Ah, c'est vous. Je veux dire, je vous ai dit que j'étais devenu un citoyen honnête, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Je ne m'attendais pas à ce que ce projet soit aussi prenant cependant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "Ce désigneur que j'ai fait venir pour planifier le nouveau temple s'est emballé dès que je lui ai dit qu'il s'agissait d'un temple de Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Non seulement il a dessiné des tonnes de plan, mais en plus il m'incite à acheter du matériel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "S'il avait quelques décennies de moins, je parie qu'il insisterait pour faire le travail lui-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "Vous n'avez pas rencontré de danger, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "De danger ? Oh, vous voulez dire des monstres ou des Pilleurs de trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "Vous n'avez pas besoin de vous inquiéter. Quand le Bureau des affaires civiles a appris que je restaurais le temple d'un Yaksha, ils ont envoyé des Millelithes pour m'escorter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Ils ont plus ou moins chassé tous les monstres qu'il y avait dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "Quant aux Pilleurs de trésors... On dirait qu'ils font profil bas depuis que les Millelithes sont là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Cependant, les travaux pour réparer ce temple sont de bien plus grande ampleur que je ne l'avais imaginé. Les matériaux qu'on avait préparés ne sont pas suffisants, on a dû en faire venir de la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "Et même si ces Pilleurs de trésors ne tenteront probablement rien sur le lieu du chantier, il est possible qu'ils se tiennent en embuscade sur le chemin pour voler les matériaux pendant la livraison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "Les Millelithes peuvent tenir le chantier, pas de problème de ce côté-là. Mais ils auront très certainement du mal à aider ceux qui livrent les marchandises s'ils sont attaqués sur la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Est-ce que je peux vous demander une faveur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "Je sais de quoi vous êtes capable. Ces Pilleurs de trésors ne sont vraiment pas de taille face à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Est-ce que vous pourriez aller leur donner une petite leçon et les empêcher de perturber notre travail ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Merci. Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Pourquoi vous ne demandez pas aux Millelithes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Ils ont déjà assez à faire à garder le chantier de jour comme de nuit. Je n'ai pas envie de leur en demander plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "#Je vous laisse vous en occuper, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Je crois me rappeler que cette zone n'était pas des plus sûres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Vous faites allusion aux monstres et aux Pilleurs de trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
