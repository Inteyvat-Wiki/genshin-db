					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Hahaha. C'est gentil de demander. Mais vous m'avez déjà beaucoup aidé. Ce ne serait pas convenable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "Enfin, si vous voulez, vous pouvez nous aider à trouver du <color=#00E1FFFF>bois d'haréna</color>. Considérez ça comme votre contribution aux travaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "#Il s'agit d'une bonne action après tout. Vous serez peut-être {M#récompensé}{F#récompensée} par le destin.",
