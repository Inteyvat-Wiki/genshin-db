			"dialogs": [
				{
					"id": 721290601,
					"content": "Comment ça se passe ? Avez-vous déjà fini de restaurer les protections ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290602,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "Ah, pas de souci. Prenez votre temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290603,
					"content": "J'y travaille encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "Si vous n'arrivez pas à les réparer, laissez tomber. Le plus important est de ne pas rester trop longtemps dans cet endroit, c'est dangereux.",
					"roleType": "TALK_ROLE_NPC",
