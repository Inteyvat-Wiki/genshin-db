			"dialogs": [
				{
					"id": 721290201,
					"content": "Vous observez la protection, et soudain, une étrange énergie vous traverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Toucher la protection"
				},
				{
					"id": 721290202,
					"content": "Vous vous rendez compte qu'elle ne vous résiste pas, mais qu'elle vous demande quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Toucher la protection"
				},
				{
					"id": 721290203,
					"content": "Hmm... Quelque chose semble manquer à cette protection. On ferait mieux de jeter un œil dans le coin, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Utilise ta vue élémentaire pour rechercher des traces d'éléments à proximité. Tu trouveras peut-être quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
