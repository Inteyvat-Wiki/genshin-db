					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "#Pas mal, l'{M#étranger}{F#étrangère} ! Les nuages ont presque disparu. On dirait que j'avais raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Ensuite, il faut encore réparer deux protections, une à la Tête du serpent et une dans la Mine Jakotsu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Si cela ne vous dérange pas, je vous laisse vous en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "J'y vais de ce pas !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "#Merci beaucoup pour votre aide. Bien que je ne sois pas un homme riche, je vous promets que vous serez {M#récompensé}{F#récompensée} dûment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Je ne sais pas quand cela arrivera, mais il semble que l'heure des retrouvailles avec ma famille et mes amis se rapproche de plus en plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "Au fait, vous pourrez me trouver du côté ouest de l'île une fois que vous aurez terminé. Il y a eu une attaque de rebelles au Fort Mumei et je soupçonne que ce soit lié à ces changements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
