			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "La lanterne de pierre aux formes étranges semble émettre une énergie inquiétante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721290102,
					"content": "Cette lanterne de pierre est si étrange... Elle me donne les chocottes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Oh, qu'est-ce qui est écrit dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "« Voyageurs de passage : si vous avez des questions à propos de cette protection, veuillez vous rendre aux Gorges de Musoujin et parler à monsieur Kaji. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721290105,
					"content": "L'écriture semble très récente, et il y a quelques lignes plus petites écrites en dessous, érodées par la pluie :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721290106,
					"content": "« S'il vous plaît, dites à monsieur Kaji que nous avons essayé... Mais malheureusement... Peut-être qu'il peut trouver ça quelque part à proximité... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721290107,
					"content": "« S'il vous plaît, dites à monsieur Kaji de venir au refuge dès que possible. Il manque beaucoup à sa famille. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 721290108,
					"content": "Ce monsieur Kaji semble assez préoccupé par ces lanternes de pierre. Pourquoi ne pas aller aux gorges de Musoujin et lui demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
