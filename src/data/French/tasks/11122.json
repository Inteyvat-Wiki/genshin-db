			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "Hé, une minute ! Il y a des traces par terre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "Sûrement laissées par les mineurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Trouvons comment sortir de la Passe de Lingju. Si on ne trouve pas de traces une fois sortis, alors cela signifie que les mineurs sont toujours ici. Si on trouve de nouveaux indices, on continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112202",
							"2"
						],
						"stepId": 1112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "Là ! Des empreintes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "On dirait bien qu'ils sont passés par la Passe de Lingju. Continuons d'avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Si on suit les empreintes, on devrait pouvoir trouver où ils sont allés, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiaoling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Bonjour, vous avez-vu passer des mineurs par ici ces derniers temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "Hum, il y a de ça quatre ou cinq jours peut-être, plusieurs personnes sont passées par ici, avec des seaux et des pioches... J'imagine que c'est d'eux qu'il s'agit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Xiaoling"
				},
				{
					"id": 111220403,
					"content": "Oui, c'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "« Quatre ou cinq jours » ? On dirait bien qu'ils sont allés moins vite que ce qu'on imaginait. Ils ont dû être ralentis par la topographie de la Passe de Lingju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "Ils étaient bizarres... Quatre costauds sans une expression sur le visage... Comme s'ils étaient dans une sorte de transe ! Et il y avait un enfant devant eux, qui marchait en titubant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Xiaoling"
				},
				{
					"id": 111220406,
					"content": "Avez-vous vu à quoi ressemblait cet enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "J'ai juste jeté un coup d'œil. Des cheveux bleus, de très petite taille... Je crois que c'était une fille ! Et elle avait un air si sérieux, pas un sourire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Xiaoling"
				},
				{
					"id": 111220408,
					"content": "Ils sont partis par cette route ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Oui, ils sont partis droit devant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Xiaoling"
				},
				{
					"id": 111220410,
					"content": "En chasse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Ces monstres sont d'une agressivité... Ils ont dû me voir quand j'ai voulu passer par ici, et avant que j'ai pu faire quoi que ce soit, ils étaient sur moi. Merci mille fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Mon nom est Wanyu. J'appartiens à la Chambre Shenglu. Je suis en charge des recherches en civilisation et culture humaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "Ah ? Alors vous n'êtes pas... mineur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "« Mineur » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Oui, on cherche des mineurs, quatre en tout ! Des gars costauds transportant de l'équipement minier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "Ah, ça me dit quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Oui, j'ai quitté Nantianmen avant-hier pour me diriger vers la Passe de Lingju. J'avais fait la moitié du chemin quand j'ai croisé ces gens – plusieurs hommes accompagnés d'un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "Pourriez-vous être plus spécifique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Je marchais vite, et je ne leur ai guère prêté attention. Je crains bien de ne vous être d'aucune utilité... Toutes mes excuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "C'est déjà amplement suffisant. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "Tant qu'on peut aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Bon, vous m'excuserez, mais je dois reprendre la route, une conférence m'attend. Encore une fois merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Donc, d'après cette personne, ils sont partis en direction de Nantianmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "Est-on sûrs qu'il s'agit des hommes qu'on recherche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "Un enfant et plusieurs hommes marchant ensemble, on ne voit pas ça tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Ce n'est pas si rare que ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Ah, euh... Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "Hé, regardez cette pierre, là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "Ah ! Notre arme secrète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "Je devrais pouvoir en tirer quelque chose. Laissez-moi essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Hum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "Il s'agit bien d'eux. Ils ont suivi la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Sieur Kun, votre capacité à voir dans les pierres n'est pas quelque chose que j'oublierai de sitôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Si c'est un talent, je n'en trouve pas souvent l'usage. Mais un compliment de la part de sieur Zhongli est toujours bon à prendre, sans aucun doute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "Kun Jun est notre compas ! C'est grâce à toi qu'on sait où aller, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Hahaha, vraiment ? Alors je ne serai pas venu pour rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "J'ai l'impression qu'on est en train de résoudre une affaire criminelle. C'est passionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "Quand bien même, nous ferions mieux de rester vigilants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Quatre hommes adultes en état de transe, marchant d'une traite de jour comme de nuit à travers plaines et montagnes... Et dirigés par un enfant. Il ne s'agit pas là d'une affaire ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "Oh, vous avez raison, sieur Zhongli, en effet. Mieux vaut rester sur nos gardes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "Ce n'est pas tout. La personne que nous venons d'interroger s'est fait attaquer par des Jeunes Géosaures. Mais ces créatures ne sont normalement pas aussi agressives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Nous avons trouvé nombre d'indices en chemin. Et tous pointent dans la même direction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Les mineurs se dirigeaient vers Nantianmen il y a deux jours. En partant d'ici, il leur aura fallu passer par un chemin de montagne particulièrement périlleux. Si leur destination est vraiment Nantianmen, alors on devrait être en mesure de les rattraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "Super ! Alors allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "J'ai laissé une marque pas loin d'ici. Si oncle Dai passe par là, il devrait pouvoir nous retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "Pas bête ! Du Zhongli tout craché !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mineur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "Et il y a un seau aussi... Ça doit être un des mineurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220803,
					"content": "Ohé, ohé ? Il y a quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220804,
					"content": "À en juger par son apparence, il a dû tomber d'épuisement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220805,
					"content": "On le réveille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220806,
					"content": "Je peux encore... creuser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "Mineur"
				},
				{
					"id": 111220807,
					"content": "Hein ? On dirait qu'il murmure quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220808,
					"content": "Il a l'air de lutter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "C'est comme s'il pensait avoir encore du travail à faire. Quelque chose ne va pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220811,
					"content": "Il y a un camp près d'ici. Amenons-le là-bas qu'il puisse récupérer, et faisons le point ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220809,
					"content": "On dirait qu'il veut se mettre debout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "Alors ? Il ne va quand même pas y rester ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "Il s'est rompu à la tâche et est entré dans un état de stupeur. Mais il n'est pas en danger grave, heureusement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "Comment s'est-il épuisé comme ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Je l'ai entendu marmonner quelque chose, comme quoi il devait creuser... Il s'est épuisé en creusant alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "C'est bien possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Vraiment bizarre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Tiens ? On dirait qu'il y a quelque chose dans sa poche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "Des fragments de minerai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "J'ai vu la mémoire de ces fragments. C'est lui-même qui les a extrait de la mine. C'est l'un des hommes qu'on recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Pourquoi et comment il est arrivé ici, voilà ce qui nous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Amené jusqu'ici, pour ensuite... être abandonné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Mais s'il n'était d'aucune utilité, pourquoi l'avoir mené tout le long du chemin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "À moins que quelque chose ne soit arrivé... Quelque chose qui lui ait fait prendre du retard sur le reste de l'équipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "J'en peux plus de tout ce mystère !!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "Oh, c'est vrai ! Voir ces fragments m'a rafraîchi la mémoire. J'ai quelque chose pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "Comment ça ? Oh, un cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "Quelque chose... pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Comme je l'ai dit plus tôt, j'avais l'esprit dans la brume quand j'ai rencontré oncle Dai. Mais je sens le brouillard se lever au fur et à mesure que je vous accompagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Pour tout vous dire, j'ai été secrètement soulagé quand j'ai vu qu'oncle Dai vous avait demandé de l'aide. Je n'aurais jamais été aussi loin tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Voici des cristaux que j'ai achetés au marché. Il ne s'agit pas de n'importe quels cristaux : leur pureté est remarquable ! Tenez, un chacun. Disons que ça fera un souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "Waouh, ils sont super jolis ! Oh, et la couleur change quand on les tourne ! On dirait un cristal différent selon l'angle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Ça doit valoir une fortune...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Bien sûr, pas la peine de faire des manières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "Et celui-ci est pour sieur Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "Oh ? Qu'est-ce qu'il y a ? Il ne vous plaît pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Non, bien au contraire... Je ne m'attendais juste pas à recevoir un cadeau dans ces circonstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Mille mercis. J'en prendrai bien soin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Merci d'accepter. C'est toujours un plaisir d'offrir quelque chose qui plaît à un ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Il y a pas mal de pierres par ici. Vous devriez vous reposer, je vais faire un tour. Peut-être que certaines de ces pierres auront des informations utiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Dis donc, tu les aimes, tes pierres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "Les minerais sont les cristaux de la terre, le sédiment du temps. Je me sens... en paix avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Reposez-vous bien, et appelez-moi quand vous voudrez repartir, je serai dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Il peut se débrouiller tout seul, hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Pas la peine de s'inquiéter. J'ai fait un tour des environs, il ne risque rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "Ah, oui. Il y a quelque chose dont j'aimerais vous parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "Ah ? Pourquoi cet air si sérieux d'un coup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "#{M#Voyageur}{F#Voyageuse}... Est-ce que la dragonite vous parle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "Pas du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Vous parlez bien du minerai que cherche Kun Jun ? Qu'y a-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "La dragonite est un minerai extrêmement rare utilisé dans la forge. La majorité des cristaux se forme dans des environnements à température élevée, mais la dragonite est le résultat de réactions élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "Les réactions élémentaires peuvent produire des objets matériels ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "En effet. Mais seule une infime minorité arrive à survivre à de longues périodes de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "La dragonite est apparue la première fois lors d'une grande bataille, il y a de cela des milliers d'années. Les forces élémentaires puissantes s'affrontant donnèrent naissance aux cristaux élémentaires. Lorsque le combat s'arrêta enfin, ces vestiges géologiques furent miraculeusement conservés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Cooool...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Il s'agit de cristaux, certes, mais ils sont peu nombreux, et peu connus. Ils ont été exploités et épuisés il y a de cela plusieurs siècles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Alors pourquoi quelqu'un de Liyue chercherait aujourd'hui à mettre la main sur un minerai qui a disparu depuis si longtemps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "C'est vrai ça ! S'il connaît l'existence de ce minerai, il devrait aussi savoir qu'il est épuisé, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Bizarre, vraiment... J'y comprends rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "Certains spécialistes de l'industrie minière s'y intéressent aussi. Mais que quelqu'un comme Kun Jun s'y intéresse... sans même savoir lui-même pourquoi... Voilà qui défie la raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Il a peut-être d'autres motivations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "« D'autres motivations » ? Ce serait un méchant alors ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Difficile à dire pour l'instant. Mieux vaut attendre de voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "N'oubliez pas : notre objectif est de trouver et sauver ces mineurs. Pour ce qui est du reste... La vérité finira bien par voir le jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Nous nous rapprochons de notre objectif. Je pense que nous devrions continuer à suivre cette route. On a trouvé un des mineurs, les autres ne doivent pas être loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "Une fois la pause finie, appelez Kun Jun. Il nous reste encore du chemin à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Pour ce qui est du mineur que l'on a sauvé, assurons-nous qu'il est bien installé ici. Une fois cette affaire résolue, il nous suffira de revenir ici pour s'occuper de lui. Je propose de laisser une note à l'attention d'oncle Dai. S'il trouve le camp, il saura quoi faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "Je peux vraiment le garder ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Il a bien été amené jusqu'ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
