				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Pfiou... Oui, voilà ! Comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150502,
					"content": "L'Herborisatrice se servait de ces papillons colorés pour décorer la porte autrefois, mais le mécanisme a été détruit par la suite. Les papillons et la jarre médicinale sont censés nourrir l'arbre adeptal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150503,
					"content": "L'arbre adeptal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Tout à fait ! C'est l'Herborisatrice qui l'avait planté à l'époque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150505,
					"content": "D'après elle, c'est possible de le revigorer tant qu'il y a encore des papillons colorés ici, même s'il est tout flétri maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150506,
					"content": "*soupir* L'Herborisatrice est partie dès qu'elle n'a plus eu assez de puissance pour maintenir sa forme humaine. Je me demande ce qu'elle devient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150507,
					"content": "« Alors que les papillons colorés convergent dans la jarre, l'arbre flétri reprend vie... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Absolument ! Tant que... Oh ? Mais comment le savez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150509,
					"content": "#Bref, voilà ! Tant que ces papillons colorés retournent dans la jarre, l'arbre flétri sera revigoré ! Je compte sur vous, {M#gentils humains}{F#gentilles humaines} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacre insouciant"
				}
			]
		},
