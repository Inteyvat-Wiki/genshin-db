			"dialogs": [
				{
					"id": 711151101,
					"content": "Hé ! Vous nous avez menti ! Tous les papillons sont retournés dans la jarre, mais l'arbre adeptal n'a pas du tout changé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "#Hm ? Qui êtes-vous ? Vous dérangez mon... Ah, c'est vous, {M#gentils humains}{F#gentilles humaines}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151103,
					"content": "Oh ! Je ne pensais pas que vous n'y arriveriez pas ! J'avais juste dit ça comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151104,
					"content": "Non ! Je veux dire que... j'ai senti l'énergie mystique ! Il ne reste plus qu'à réciter la formule que l'Herborisatrice a laissée pour revigorer l'arbre adeptal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151105,
					"content": "Attendez, comment c'était déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151106,
					"content": "« ... Né en hiver, prospérant et flétrissant au fil du temps. Mais j'aspire au printemps où la beauté sera retrouvée... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151107,
					"content": "... Les papillons convergent... Et je ne m'en souviens plus, mais je crois qu'à la fin, tout reprend vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacre insouciant"
				}
			]
		},
