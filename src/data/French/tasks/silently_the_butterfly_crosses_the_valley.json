				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Oh ? Qui êtes-vous ? J'étais en plein milieu d'un beau rêve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150402,
					"content": "Ah ?! Qui parle ? J'ai peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Bouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150404,
					"content": "Ahhh !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "#Hahahaha ! Oui, vous devriez avoir peur ! Si je n'étais pas enfermé dans cette pierre, je vous aurais déjà {M#dévorés}{F#dévorées} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150406,
					"content": "Hein ? Ah ! Vous n'êtes qu'une statue de pierre parlante... Et moi qui pensais qu'on avait affaire à un monstre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Hmph ! Comment ça « qu'une statue de pierre parlante » ?! Vous ne trouvez pas ça effrayant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150408,
					"content": "Ce n'est pas la première fois qu'on en rencontre, vous savez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "Quoi ?! *soupir* Très bien, je n'arriverai pas à vous faire peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150410,
					"content": "Et pourquoi vous voulez effrayer les gens ? Sérieusement, vous n'êtes qu'une statue de pierre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hmph ! Quand bien même, vous vous trouvez dans la demeure de l'Herborisatrice ! Quand elle habitait encore ici, elle détestait se faire déranger par les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150412,
					"content": "C'est pour cette raison que j'effraie les gens ! Je continuerai à le faire, même en son absence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150413,
					"content": "#Cependant, vous m'avez l'air {M#différents}{F#différentes} des autres mortels... En plus du fait que vous n'avez pas pris vos jambes à votre cou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150414,
					"content": "Puis-je vous demander un service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150415,
					"content": "Oh ? Comment pourrait-on vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Ahem, regardez ces papillons colorés ! Depuis le départ de la maîtresse des lieux, ils se sont éparpillés un peu partout, virevoltant comme bon leur semble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150417,
					"content": "Chut... Attendez, il y en a un sur votre tête ! On va l'attraper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
