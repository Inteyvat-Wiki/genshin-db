			"dialogs": [
				{
					"id": 711151201,
					"content": "Ouah ! Il s'est complètement transformé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "#Hmph, l'Herborisatrice m'a confié cet arbre. Je ne supportais plus de le voir se ratatiner ! Merci, {M#gentils humains}{F#gentilles humaines} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151203,
					"content": "Vous ne vous souveniez même pas de la formule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Ce n'est qu'un détail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711151205,
					"content": "Oh, j'ai un petit secret à partager, si ça vous intéresse ! Brisez une branche et mettez-la dans la jarre cassée à l'extérieur de la demeure. Une porte en pierre s'ouvrira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacre insouciant"
				}
			]
