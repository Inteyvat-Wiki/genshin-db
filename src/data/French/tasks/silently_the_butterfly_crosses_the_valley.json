			"dialogs": [
				{
					"id": 711150601,
					"content": "Pfiou... Oui, voilà ! Comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150602,
					"content": "L'Herborisatrice se servait de ces papillons colorés pour décorer la porte autrefois, mais le mécanisme a été détruit par la suite. Les papillons et la jarre médicinale sont censés nourrir l'arbre adeptal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150603,
					"content": "L'arbre adeptal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Tout à fait ! C'est l'Herborisatrice qui l'avait planté à l'époque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150605,
					"content": "D'après elle, c'est possible de le revigorer tant qu'il y a encore des papillons colorés ici, même s'il est tout flétri maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150606,
					"content": "*soupir* L'Herborisatrice est partie dès qu'elle n'a plus eu assez de puissance pour maintenir sa forme humaine. Je me demande ce qu'elle devient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150607,
					"content": "#Que suis-je {M#supposé}{F#supposée} faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, désolé. Je me suis emporté en racontant les souvenirs de ma maîtresse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150609,
					"content": "#Ahem ! Écoutez bien, {M#humains}{F#humaines} ! Tant que ces papillons retournent dans la jarre, l'arbre flétri pourra être revigoré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150610,
					"content": "C'est le mécanisme des Adeptes que l'Herborisatrice a conçu. Pas mal, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150611,
					"content": "Je vais essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "#Merci, je compte sur vous, {M#gentils humains}{F#gentilles humaines} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150613,
					"content": "Pourquoi des papillons colorés ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Hein ? Hum, c'est vrai ça... Peut-être que l'Herborisatrice les aimait bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Simulacre insouciant"
				},
				{
					"id": 711150615,
					"content": "#En tout cas, je compte sur vous pour ramener ces papillons dans la jarre, {M#gentils humains}{F#gentilles humaines} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacre insouciant"
				}
			]
		},
