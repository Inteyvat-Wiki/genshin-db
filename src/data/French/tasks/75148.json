			"dialogs": [
				{
					"id": 751480201,
					"content": "Hein ? C'était... un qucusaure ?! Ils amènent donc vraiment les statues volées jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Attends, est-ce qu'il vient de prendre la statue et de sauter... directement dans le cratère ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Voilà donc le cratère... C'est impressionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Hmm... Quand on a demandé notre chemin, on nous a répondu que de grandes quantités de phlogistique gazeux s'accumulaient ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Oh, c'est juste ! Nous devons <color=#00E1FFFF>trouver un moyen de traverser le phlogistique gazeux</color>, tout comme l'a fait le qucusaure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Mais... C'est vraiment haut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Ne t'inquiète pas, je vais te porter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Euh ? Tu veux plonger aussi ? ... D'accord, alors ça ne me fait plus si peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "Et ce n'est pas juste à cause de la hauteur... Il y a aussi tout ce phlogistique gazeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "Enfin, bref... Allons-y quand nous serons prêts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "Tant que tu me rattrapes au bon moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Non, c'est impossible ! Même si j'étais suffisamment forte... Te rattraper au bon moment serait beaucoup trop difficile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "#Et toi, arrête de {M#le}{F#la} soutenir. *soupir* ... Même si je ne suis plus aussi nerveuse maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
