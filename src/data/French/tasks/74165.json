							3381.435
						],
						"pointId": 6766
					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "#Je sens la « raison » s'éveiller en moi. Vous êtes {M#les successeurs}{F#les successeures} du Narzissenkreuz ou une menace ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650102,
					"content": "Vous avez dégainé votre épée contre moi. Il semble que la réponse soit évidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650103,
					"content": "Narzissenkreuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Hum ? C'est Narzissenkreuz ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "Maintenant que vous avez entendu parler de moi, vous devriez comprendre ma mission de sauver le monde. Dès que vous avez entendu mon nom, l'étincelle du salut s'est allumée en vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650106,
					"content": "#Il semble que vous ayez été {M#dupés}{F#dupées} par des mensonges, d'où votre hostilité. Je n'ai pas le loisir de gaspiller mon énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650107,
					"content": "Réjouissez-vous, applaudissez. Après tout, je vais répondre à toutes vos questions, je vais tout vous montrer. Maintenant, rendez-moi la sainte lame, puis partez d'ici pour rejoindre un lieu sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650108,
					"content": "On ne peut pas vous donner la sainte lame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "Quelle stupidité, mais je vous pardonne et je vais vous sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650110,
					"content": "Je ressens également cela, bien que les quatre Orthants aient été inversés, l'image entière de l'arbre d'émanation n'est pas encore achevée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650111,
					"content": "Ce n'est plus possible de sauver tout le monde. Je vais étendre ma compassion au maximum, au prix de ma propre vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650112,
					"content": "Si je peux n'en sauver que certains, j'essayerai d'en sauver le plus grand nombre possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650113,
					"content": "Maintenant, je viens prendre la sainte lame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
