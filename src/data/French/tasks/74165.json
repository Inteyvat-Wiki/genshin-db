						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "#Impossible... J'aurais dû atteindre le stade de «{NON_BREAK_SPACE}non retour ». Comment ai-je pu revenir dans cet état ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650202,
					"content": "Et j'ai complètement perdu le contrôle sur la mer primordiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650203,
					"content": "Pourquoi ? Pourquoi ça s'est produit ? Pourquoi avez-vous fait cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650204,
					"content": "Le nouveau monde ne peut pas naître, tout le monde est condamné à mourir dans le rêve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650205,
					"content": "Ce serait préférable pour vous de vous réveiller de votre propre rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "Le problème de la fin du monde doit être résolu par tous les habitants de la planète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Je comprends, la sainte lame n'est pas de mon côté. Elle ne me soutient pas. Au contraire, à chaque mouvement, elle coupe les volontés des êtres qui m'entourent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650208,
					"content": "Finalement, ma faible nature humaine est revenue en moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650209,
					"content": "L'inondation de la mer primordiale ne se produira pas si rapidement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "J'ai constaté que les valeurs initiales de la formule mondiale ont été changées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650211,
					"content": "Qui contrôle la force vitale et qui a ouvert le royaume des bêtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650212,
					"content": "Il y a également une autre « variable » : vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650213,
					"content": "#{M#Destiné}{F#Destinée} à être le témoin de la défaite de la baleine dévoreuse, le témoin de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650214,
					"content": "Ah, je vois ! C'était donc ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650221,
					"content": "J'ai rêvé de devenir une personne comme vous, mais ce rêve vient de se briser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650222,
					"content": "Tout ce que j'ai fait a été vain. Un rêve vide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650223,
					"content": "Encore moins qu'un rêve, même. Les rêves ne font pas de mal, au moins. Mais je... Non, vous et les autres... ont tellement souffert à cause de mes actes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650224,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Ah, c'est vous. Je ne vous avais même pas remarquée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650226,
					"content": "Pouvez-vous me dire qui je suis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "Les noms ne sont que des étiquettes, mais je connais bien les deux couleurs qui constituent votre âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650228,
					"content": "La directrice Lyris ne sait pas ce qui s'était passé, elle se contente de tenir dans ses bras Mary-Ann, qui était à peine en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650229,
					"content": "Elle ne comprenait pas les complexités du présent ou du futur, et voulait juste rester dans le passé. Alors, elle a fait ce qu'elle pouvait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650230,
					"content": "Je m'appelle Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "Eh bien, bonjour Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650232,
					"content": "Je suis prête à vous pardonner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "Arrêtez de dire n'importe quoi. Depuis le début, mon objectif a été noble et sacré, sans une once d'égoïsme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650234,
					"content": "Personne ne peut me juger ou me condamner. Je n'ai pas besoin d'être pardonné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650235,
					"content": "Peut-être que votre intention est noble, mais votre folie a blessé beaucoup de gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "Vous n'avez même pas rempli correctement l'équation. Qu'y a-t-il de mal à faire une erreur et de se faire pardonner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "... Vous avez raison. Je suis désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650238,
					"content": "Narzissenkreuz, rentrez avec nous. Vous avez besoin de voir d'autres personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "Il est plutôt coopératif, mais ce genre de demande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650241,
					"content": "Hein ? D'habitude, s'ensuit une lutte intérieure et une longue persuasion, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Comme je l'ai dit, je ne ressens aucune culpabilité. Bien que notre projet ait échoué, le monde a quand même été sauvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650243,
					"content": "Laissez les autres me blâmer et se moquer de moi. Mon cœur est vide. Il ne me reste qu'un seul désir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650244,
					"content": "De quoi s'agit-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Je veux revenir au début, avant que les héros du Narzissenkreuz ne commencent leur voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650246,
					"content": "Cependant, ce n'est plus possible. Le destin des êtres humains ne dépend pas d'eux-mêmes, et je suis maintenant privé du pouvoir de contrôler mes propres rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650247,
					"content": "#Chevalier {NICKNAME}, une fois que vous serez {M#prêt}{F#prête}, allons sceller à nouveau la mer primordiale avant de quitter cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "La créature a été vaincue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "J'ai constaté que les valeurs initiales de la formule mondiale ont été changées. Une variable a été introduite dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650217,
					"content": "Les objets venant de l'extérieur de l'univers ne peuvent pas tous être appelés « apparition » ou « variable ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650218,
					"content": "J'avais négligé une autre « variable » : vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650219,
					"content": "#Le témoin, l'archiviste et {M#le concepteur}{F#la conceptrice} de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650220,
					"content": "Seul celui qui vaut un monde à lui-même peut prétendre à ce titre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7416505",
							"2"
						],
						"stepId": 7416505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650301,
					"content": "#Impossible... J'aurais dû atteindre le stade de «{NON_BREAK_SPACE}non retour ». Comment ai-je pu revenir dans cet état ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650302,
					"content": "Et j'ai complètement perdu le contrôle sur la mer primordiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650303,
					"content": "Pourquoi ? Pourquoi ça s'est produit ? Pourquoi avez-vous fait cela ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650304,
					"content": "Le nouveau monde ne peut pas naître, tout le monde est condamné à mourir dans le rêve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650305,
					"content": "Ce serait préférable pour vous de vous réveiller de votre propre rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "Le problème de la fin du monde doit être résolu par tous les habitants de la planète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "Je comprends, la sainte lame n'est pas de mon côté. Elle ne me soutient pas. Au contraire, à chaque mouvement, elle coupe les volontés des êtres qui m'entourent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650308,
					"content": "Finalement, ma faible nature humaine est revenue en moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650309,
					"content": "L'inondation de la mer primordiale ne se produira pas si rapidement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "J'ai constaté que les valeurs initiales de la formule mondiale ont été changées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650311,
					"content": "Qui contrôle la force vitale et qui a ouvert le royaume des bêtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650312,
					"content": "Il y a également une autre « variable » : vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650313,
					"content": "#{M#Destiné}{F#Destinée} à être le témoin de la défaite de la baleine dévoreuse, le témoin de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650314,
					"content": "Ah, je vois ! C'était donc ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650315,
					"content": "J'ai rêvé de devenir une personne comme vous, mais ce rêve vient de se briser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650316,
					"content": "Tout ce que j'ai fait a été vain. Un rêve vide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650317,
					"content": "Encore moins qu'un rêve, même. Les rêves ne font pas de mal, au moins. Mais je... Non, vous et les autres... ont tellement souffert à cause de mes actes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650318,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650319,
					"content": "Ah, c'est vous. Je ne vous avais même pas remarquée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650320,
					"content": "Pouvez-vous me dire qui je suis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650321,
					"content": "Les noms ne sont que des étiquettes, mais je connais bien les deux couleurs qui constituent votre âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650322,
					"content": "La directrice Lyris ne sait pas ce qui s'était passé, elle se contente de tenir dans ses bras Mary-Ann, qui était à peine en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650323,
					"content": "Elle ne comprenait pas les complexités du présent ou du futur, et voulait juste rester dans le passé. Alors, elle a fait ce qu'elle pouvait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650324,
					"content": "Je m'appelle Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650325,
					"content": "Eh bien, bonjour Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650326,
					"content": "Je suis prête à vous pardonner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650327,
					"content": "Arrêtez de dire n'importe quoi. Depuis le début, mon objectif a été noble et sacré, sans une once d'égoïsme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650328
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650328,
					"content": "Personne ne peut me juger ou me condamner. Je n'ai pas besoin d'être pardonné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650329
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650329,
					"content": "Peut-être que votre intention est noble, mais votre folie a blessé beaucoup de gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650330
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650330,
					"content": "Vous n'avez même pas rempli correctement l'équation. Qu'y a-t-il de mal à faire une erreur et de se faire pardonner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650331
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650331,
					"content": "... Vous avez raison. Je suis désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650332
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650332,
					"content": "Narzissenkreuz, rentrez avec nous. Vous avez besoin de voir d'autres personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650333
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650333,
					"content": "Il est plutôt coopératif, mais ce genre de demande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650334,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650335
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650335,
					"content": "Hein ? D'habitude, s'ensuit une lutte intérieure et une longue persuasion, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650336,
					"content": "Comme je l'ai dit, je ne ressens aucune culpabilité. Bien que notre projet ait échoué, le monde est quand même destiné à être sauvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650337
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650337,
					"content": "Laissez les autres me blâmer et se moquer de moi. Mon cœur est vide. Il ne me reste qu'un seul désir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650338
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650338,
					"content": "De quoi s'agit-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650339,
					"content": "Je veux revenir au début, avant que les héros du Narzissenkreuz ne commencent leur voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650340
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650340,
					"content": "Cependant, ce n'est plus possible. Le destin des êtres humains ne dépend pas d'eux-mêmes, et je suis maintenant privé du pouvoir de contrôler mes propres rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650341
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650341,
					"content": "#Chevalier {NICKNAME}, une fois que vous serez {M#prêt}{F#prête}, allons sceller à nouveau la mer primordiale avant de quitter cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
