			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Ah, vous voilà. Nul besoin de commander, je m'en suis déjà chargé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "Les « Trois Bolées du Port » ne sont pas comme les petites tavernes que l'on trouve à Mondstadt. Ce n'est pas ici qu'on va vous servir un jus de fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Alors je vais enfin pouvoir commander du vin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "Je vous ai commandé des boulettes de riz sucrées fermentées au vin, si cela compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "J'aurais dû m'en douter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "... Si vous le permettez, chers clients, je vais continuer à vous narrer l'histoire de la Chambre de Jade de la célèbre Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160107,
					"content": "Hé, il y a même un conteur ici ! Vraiment sympa comme ambiance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Outre le bon vin, l'excellente ambiance est la raison pour laquelle cet endroit est si apprécié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Mais quand je parle d'ambiance, je me réfère à quelque chose de différent de ce que le Guide de voyage en Teyvat utilise pour juger ses établissements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Comme vous le savez tous, au-dessus du pays de Liyue se trouve un pavillon dans les nuages, un palais dans la brume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160111,
					"content": "Qu'est-ce que cela signifie d'avoir des yeux qui voient tout, vous demandez-vous ? Ceci, mes amis est le chef-d'œuvre de Ningguang, qui relie la terre au ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160112,
					"content": "Imaginez. Le ciel est dégagé, et vous contemplez depuis le pont le monde d'en bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160113,
					"content": "Admirez la vue magnifique sur le Port de Liyue qui s'étend au loin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160201,
					"content": "Ce ne sont que de petits bouts de papier, et pourtant ils guident les décisions de Ningguang : telle est leur valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160202,
					"content": "Le simple fait d'en saisir un ou deux vous permettra de bénéficier d'un fragment de sa sagesse, juste ce qu'il faut pour garder une longueur d'avance ou deux sur la concurrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Tian la langue de fer"
				},
				{
					"id": 10160203,
					"content": "La Megrez Ningguang... Ce nom est sur toutes les bouches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Les habitants de Liyue parlent d'elle, les Fatui la détestent, c'est probablement elle qui a caché l'Exuvia, et nous l'avons vue pendant le rituel de la descente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Ha, je me demande quel genre de personne elle est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "#Enfin je vous ai {M#trouvés}{F#trouvées}, vous qui êtes {M#revenus}{F#revenues} du Karst Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Qui est là !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon, cours !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Attendez ! Je ne suis pas avec les Millelithes, et je ne suis pas là pour la prime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Cependant, je suis une émissaire des Sept Étoiles. Je m'appelle Ganyu, secrétaire du Pavillon Yuehai, et je suis venue spécialement pour vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "« Émissaire des Sept Étoiles » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Eh bien, pour être plus précise, je suis la secrétaire générale des Sept Étoiles. Je suis là en tant qu'émissaire spéciale de Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Ningguang vous a envoyée ? On parlait justement d'elle à l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "#Toutes mes excuses, à vous qui êtes {M#revenus}{F#revenues} du Karst Jueyun... J'ai des devoirs à remplir et ne peux m'attarder davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Mais j'ai avec moi une lettre de Ningguang. Elle vous adresse une invitation officielle en sa qualité de Megrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Elle vous invite à son palais céleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Une invitation officielle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Ningguang a dit ceci :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "#« Invite {NICKNAME} à venir ici. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "#« Je souhaite {M#le}{F#la} rencontrer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "« À la Chambre de Jade, ensemble, nous démêlerons chacun de ces fils noirs entremêlés. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "« Secrétaire du Pavillon Yuehai » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
