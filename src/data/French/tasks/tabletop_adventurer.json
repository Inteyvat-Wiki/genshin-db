					"nextDialogs": [
						745050106
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050106,
					"content": "Oh, c'est vraiment gentil de votre part, Armand ! Nous le lirons attentivement, c'est sûr.",
