					"nextDialogs": [
						745050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050107,
					"content": "C—Ce... Ce n'est pas grave si vous ne le lisez pas. C—C'est très s—s—simple et a—amusant... V—Vous voulez e—essayer ?",
