			"dialogs": [
				{
					"id": 721260301,
					"content": "Alors ? Avez-vous réussi à chasser ces monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260302,
					"content": "Ils ont tous déguerpi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Mille mercis ! Comme ça, je peux continuer à planter des fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260304,
					"content": "Ah, prenez ça en récompense ! Même si je n'ai pas grand-chose à vous offrir... Bref, merci pour votre aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
