			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "Oh non... Comment faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260102,
					"content": "Que s'est-il passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "C'est vous... Parfait ! Alors voilà, après que vous m'ayez donné des graines, j'ai commencé à planter des fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260104,
					"content": "Mais avant que je ne puisse finir, des monstres sont soudainement apparus ! Et ils rôdent maintenant autour de l'endroit où je voulais planter. Je n'ose plus y aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260105,
					"content": "Si on les laisse dans le coin, ils risquent de ravager mes fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260106,
					"content": "Pourriez-vous les chasser pour moi ? Je... Je veux juste planter des fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260107,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "Merci beaucoup ! Je vous en suis reconnaissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260109,
					"content": "Pourquoi êtes-vous si déterminée à faire pousser des fleurs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "Je pense que la raison pour laquelle les gens ne veulent pas revenir à Tatarasuna, c'est parce qu'ils craignent que cet endroit ne soit devenu inhabitable après l'incident du Fourneau Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260111,
					"content": "Je ne peux pas les persuader un par un, mais si je peux planter beaucoup de belles fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260112,
					"content": "Peut-être que ça suffira à les convaincre que Tatarasuna ne représente plus un danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260113,
					"content": "Et puis... Héhé, à part planter des fleurs, je n'ai pas d'autre moyen de convaincre les gens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260114,
					"content": "Alors, s'il vous plaît, aidez-moi à chasser ces monstres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
