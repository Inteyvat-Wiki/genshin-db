			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#Par ici, {NICKNAME} ! Par ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570202,
					"content": "Tu te souviens de cet endroit ? C'est là que notre voyage a commencé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570203,
					"content": "Sans nous en rendre compte, on a visité tellement d'endroits depuis ! Je suis un peu émue, rien que d'y penser. Oh, je pourrais même composer un poème là, tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570204,
					"content": "Dis-moi tout, Paimon la grande barde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "Pfft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "Ne m'interromps pas. Je réfléchis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570207,
					"content": "Ah ! Teyvat, que tu es vaste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570208,
					"content": "Tout ce chemin parcouru, mais il nous reste tant à voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570209,
					"content": "#(Rester {M#silencieux}{F#silencieuse}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "Ça ne rimait pas du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "Ah ! Hum... Ça ne veut plus sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570212,
					"content": "Hahahaha !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "Tu réfléchis à la difficulté de notre voyage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "C'est ça, moque-toi de moi. J'ai l'habitude maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570215,
					"content": "Oui ! Tu me connais bien, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570216,
					"content": "Plus sérieusement, c'est facile d'oublier d'où on vient après avoir voyagé pendant longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570217,
					"content": "Par exemple, je ne me souviens plus très bien du goût du poulet mariné aux fleurs sucrantes, alors que c'est l'un de mes plats préférés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570218,
					"content": "C'est pour ça que j'ai acheté cet album ! On pourra prendre des photos des endroits qu'on a visités et des gens que nous avons rencontrés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570219,
					"content": "« La fin est proche lorsque nous revenons à notre point de départ. » C'est un truc qui arrive assez souvent dans les romans et les films, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570220,
					"content": "Du coup, prenons une photo ici. Non pas par tristesse, mais plutôt pour avoir un souvenir du chemin parcouru et mieux aborder celui qui nous attend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570221,
					"content": "Tu as écouté mes conversations avec Kazuha ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "Quoi ? Tu as évolué Paimon ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "Hum... Oui, je vous ai écouté parler Kazuha et toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570224,
					"content": "J'étais en train de créer une ambiance, mais tout est parti en fumée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570225,
					"content": "Ne t'inquiète pas, j'ai compris ce que tu voulais dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "On continuera d'avancer ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "Héhé, tant que tu comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570228,
					"content": "Bon ! Ton modèle pour cette photo sera la meilleure guide de tout Teyvat ! Quelle pose veux-tu que je prenne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570101,
					"content": "Hé, attends. Où est le Daguerréotype que je t'ai prêté ? J'espère que tu ne t'as pas perdu. Regarde vite si tu ne l'as pas avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
