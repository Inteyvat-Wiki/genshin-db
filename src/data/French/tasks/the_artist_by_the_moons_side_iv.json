			"dialogs": [
				{
					"id": 761200101,
					"content": "... Tenez, c'est pour yoi. J'ai fait ma part là, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200102,
					"content": "Hé, c'est une toile. Ça veut dire que...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah. Vous arrivez juste à temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200104,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Tiens donc, c'est Maalaus, notre grande artiste ! Ça fait une éternité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "Pourquoi arrivons-nous « juste à temps » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Je viens juste d'emmener Maalaus faire un tour sur la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200108,
					"content": "Je suis tellement jalouse de la façon dont vous avez dit ça... comme si vous étiez allées dans le jardin d'à côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Mais qu'est-ce que vous êtes allées faire là-bas ? Chercher l'inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "C'est à moitié vrai. Nous avons aussi choisi un lieu pour une « exposition ». Vous vous en souvenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200111,
					"content": "Oui ! L'exposition de la Déesse de la lune de Maalaus ! N'oubliez pas de nous inviter le moment venu, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Bien sûr. D'ailleurs, Maalaus semble être capable de percevoir les changements subtils autour d'elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200113,
					"content": "Elle m'a dit que j'avais beaucoup changé depuis mon retour de la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200114,
					"content": "C'est pour ça qu'elle voulait que je l'emmène là-bas, pour voir s'il y avait quelque chose de spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200115,
					"content": "C'est bien une artiste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Cette chose spéciale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Je ne sais pas non plus. J'ai emmené Maalaus à de nombreux endroits, mais aucun ne lui a convenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200118,
					"content": "Du moins, jusqu'à ce que je l'amène près de votre vaisseau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200119,
					"content": "Notre vaisseau spatial ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Quand je l'ai emmenée plus près, j'ai découvert qu'elle ne s'intéressait pas au vaisseau en lui-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200122,
					"content": "Hein ? Qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Ah, elle virevolte autour de vous, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha. Elle a fait la même chose là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200126,
					"content": "Je crois que ce qui l'intéresse vraiment, c'est ma réaction quand j'ai vu le vaisseau spatial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200127,
					"content": "Comment étiez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Ça m'a rappelé quand {NICKNAME} et moi y sommes {M#allés}{F#allées} ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200129,
					"content": "#Nous admirions Teyvat {M#assis}{F#assises} dessus. {M#Il}{F#Elle} a découvert la vérité sur le passé, et moi, j'ai trouvé mon « foyer ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200130,
					"content": "Rien que d'y penser m'a donné un sentiment de paix... ou peut-être, de bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200131,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Oui, tu as raison. Ce ne sont pas des choses que j'aurais ressenties auparavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200133,
					"content": "Alors, j'ai raconté notre histoire à Maalaus, y compris ce qui s'est passé après notre arrivée sur la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200134,
					"content": "Elle avait l'air très satisfaite après ça, comme si elle avait enfin trouvé l'inspiration tant désirée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200135,
					"content": "Ah. C'est donc l'heure pour la grande artiste de nous montrer sa magie, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Vous ne m'avez pas emmenée là-haut la dernière fois, alors je suis très curieuse de voir ce que Maalaus va peindre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "Et qu'est-ce qu'on va utiliser comme peinture cette fois-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Cette fois, c'est quelque chose de spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200139,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus dit qu'elle veut des peintures qui n'appartiennent qu'à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200141,
					"content": "Et... qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Je pense qu'elle parle des choses qui vous rappelleront ce voyage, ce que vous en avez retiré et la joie qu'elles vous ont apportée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200143,
					"content": "Ne vous inquiétez pas. Maalaus veut juste voir et toucher ce genre d'objets. Elle n'utiliserait rien d'aussi précieux comme peinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200144,
					"content": "Que lui avez-vous donné ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "De la terre de la lune et la carte que vous m'avez donnée pour la Nuit de la prière lunaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200146,
					"content": "#Oh, donc en gros, il faut quelque chose qui représente cette aventure, c'est ça ? D'accord. {NICKNAME}, à toi de choisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "C'est particulier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
