					"nextDialogs": [
						100100512
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100512,
					"content": "« Bon, il se peut que Dodoco ait fait exploser tous les obstacles. Après tout, l'approche la plus directe est parfois la plus élégante. En tout cas, c'est ainsi que Dodoco parvint à la deuxième étape de l'épreuve... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100513,
					"content": "« ... qui, par coïncidence, était aussi l'étape finale. Après tout, même les enfants les plus énergiques ont besoin d'aller à leur rythme. Alors... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100514,
					"content": "« Dodoco se rendit aux berges d'un lac d'étoiles déchues, réussit l'épreuve finale et obtint sa récompense. Mais les choses pouvaient-elles vraiment être aussi simples...? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100515,
					"content": "« Un lac d'étoiles déchues »... Ça doit être le Lac Tombétoile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100516,
					"content": "Allons voir ce qu'on peut y trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100517,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100518,
					"content": "Je suis très curieuse de savoir quelle sera la récompense. Pourvu que ce soit un trésor incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
