			"dialogs": [
				{
					"id": 100100301,
					"content": "Qu'est-ce que c'est que toutes ces choses bizarres par ici ? Et pourquoi y a-t-il autant de Brutocollinus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100302,
					"content": "Hmm, peut-être que ce sont les Brutocollinus qui ont apporté tout ça ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100303,
					"content": "Ohhhh, je parie que c'est ici qu'on va trouver les tortues !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100304,
					"content": "Presque, mais la note disait « obstacles », pas « tortues ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100305,
					"content": "Et ce que nous cherchons est censé être enterré derrière tous ces « obstacles »... Hum, y aurait-il d'autres indices dans les environs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100306,
					"content": "Il n'y a pas d'appareil Dodo qui pourrait nous aider ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100307,
					"content": "Euh... non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100308,
					"content": "Qu'est-ce qu'on fait, alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100309,
					"content": "Hmm... Maman dit toujours que la meilleure chose à faire quand on rencontre un problème, c'est d'essayer de le résoudre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100310,
					"content": "Du coup, débarrassons-nous de ces obstacles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100311
					]
				},
				{
					"id": 100100311,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
