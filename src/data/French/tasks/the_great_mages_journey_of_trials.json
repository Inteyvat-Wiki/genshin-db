					"nextDialogs": [
						100100508
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100508,
					"content": "Ce n'est pas vraiment ce que j'avais en tête... Et l'épreuve ? A-t-on appris quelque chose de nouveau ?",
