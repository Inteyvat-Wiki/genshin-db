			"dialogs": [
				{
					"id": 100100101,
					"content": "Hmm... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100102,
					"content": "Salut Klee !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100103,
					"content": "Chevalier honoraire ! Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100104,
					"content": "Dodoco a besoin d'aide ! Maman m'avait dit que vous viendriez, mais je ne pensais pas que ce serait aussi vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100105,
					"content": "Dodoco... a besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100106,
					"content": "Oh, bon sang... C'est ça, la tâche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100107,
					"content": "Quoi ? Ça existe le mauvais sang ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100108,
					"content": "C'est une expression. Je te parlais de la tâche. Tu sais ce que c'est, hein ? C'est comme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100109,
					"content": "Une tâche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100111,
					"content": "... Merci, chevalier ho-non, sans blague.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100112,
					"content": "Bref, hum... Une tâche, c'est... Raaah, pourquoi c'est si difficile à expliquer ?! C'est comme... aider Dodoco ! Voilà ! C'est ça une tâche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100119,
					"content": "Oh ! Merci, Paimon. Je comprends mieux, mais pas vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100120,
					"content": "Allons aider Dodoco maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100121,
					"content": "Attends, de quelle aide Dodoco a-t-elle besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100122,
					"content": "Ah, hum, chaque Dodoco doit trouver un trèfle rouge à quatre feuilles pour devenir une super Dodoco spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100123,
					"content": "Ensuite, elle doit se faire beaucoup d'amis et réussir l'épreuve du Roi Dodo. Une fois que ce sera accompli, elle pourra devenir une...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100124,
					"content": "Dodo-sorcière super géniale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100125,
					"content": "... C'est ce que maman a dit, en tout cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100126,
					"content": "Tiens, un Roi Dodo qui commande une sorcière Dodo... Ça se tient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100127,
					"content": "Euh, mais concrètement, qu'est-ce qu'on doit faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100128,
					"content": "Je ne sais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100129,
					"content": "#Mais maman a dit que vous me le diriez, {M#tous}{F#toutes} les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100130,
					"content": "D—D'accord... Bon, jetons un coup d'œil à ce livre alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100131,
					"content": "Oh ! Il y a une note à l'intérieur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100132,
					"content": "Hmm, voyons voir ce qui est écrit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100133,
					"content": "... Lors de la première étape de l'épreuve, Dodoco arriva dans une forêt aux feuilles murmurantes. Là-bas, au-delà d'innombrables obstacles, un secret demeurait enfoui, attendant d'être découvert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100134,
					"content": "On dirait que c'est une histoire sur Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100135,
					"content": "Oh, je sais où se trouve cette forêt ! C'est là où je vais pour faire explo... Euh, je veux dire, que je vais souvent jouer là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100136,
					"content": "Allez ! Suivez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100137,
					"content": "Oui, en route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100113,
					"content": "C'est quelque chose qui doit être fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "Oui, quelque chose qui doit être fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100115,
					"content": "Oh ! Tu veux dire... comme quand je fais sauter les poissons avec mes bombes rebondissantes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100116,
					"content": "Non, non ! Ce n'est pas juste quelque chose qu'on a envie de faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100117,
					"content": "Je suis perdue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100118,
					"content": "*soupir* C'est comme... quand ta maman te demande de faire quelque chose ! Ça, c'est une « tâche » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
