			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole...? Étrange, il n'y a personne ici non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Vous êtes déjà dans mon atelier ? Avez-vous vu les fleurs que j'ai cultivées à partir d'échantillons venus des quatre coins du monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "Hélas, je ne peux pas me libérer pour venir vous rejoindre pour le moment. Je tiens un stand de sculptures à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Euh... Vous voulez qu'on vous aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "Non merci. C'est ma seule occasion de prendre la plume, même si je ne fais qu'écrire des chiffres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Mais comme vous n'avez pas souvent l'occasion de venir me rendre visite, n'hésitez pas à commencer sans moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Au fait, je vous ai laissé un parchemin. Je crois l'avoir posé près d'une statue de pinson contre le mur ouest. Pourquoi ne pas essayer de le trouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "Alors laissez mon guide silencieux vous accompagner... Bonne chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
