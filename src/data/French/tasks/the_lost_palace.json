				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Félicitations ! Laissez-moi voir... Hmm, joli travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Contrairement au Jardin de la sorcière actuel, j'ai vécu dans ce sanctuaire lorsque j'étais encore un ange. Ça a été ma maison pendant un bon moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "Il y a tellement d'anges ! On dirait que vous étiez très populaire, Nicole !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Je ne veux pas me vanter, mais tout le monde adorait écouter mes histoires. En particulier celles où je vivais parmi les humains, leur envoyais des présages et les guidais pour bâtir de grandes civilisations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Chaque fois que j'arrivais à un passage palpitant, les autres anges retenaient leur souffle, suspendus à mes lèvres. On n'entendait pas le moindre frémissement de corde de harpe, ni le moindre frottement de pinceau sur la toile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Puis les couleurs s'épanouissaient, entrelacées. Accompagnée de musique, une lumière dorée baignait toute chose. C'était un ravissement, une joie pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Ça avait l'air merveilleux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Oh, ça l'était, Paimon... Ça l'était.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Même si ces jours merveilleux sont révolus, la vie reste pleine d'heureuses surprises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Attendez un peu... Quelqu'un a vraiment eu le culot d'essayer de voler mes sculptures pendant que je lisais mon journal ? Oh, vous allez voir ce que vous allez voir ! Je vais vous montrer le chemin jusqu'à la Forteresse de Méropide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Attendez un peu... Quelqu'un a vraiment eu le culot d'essayer de voler mes sculptures pendant que je lisais mon journal ?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Oh, vous allez voir ce que vous allez voir !",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Je vais vous montrer le chemin jusqu'à la Forteresse de Méropide !",
					"roleType": "TALK_ROLE_NONE",
