				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Nara {NICKNAME}, Paimon, rebonjour. Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "Vous avez l'air joyeux, Araja !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "Hahaha... Je suis si heureux de constater à quel point Vanarana est pleine de vie, et voir tous ces aranaras de retour me met d'humeur radieuse. Je n'avais jamais pensé pouvoir participer au Festival Utsava en personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "Vous n'y avez jamais participé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "Une histoire raconte que j'y ai participé une fois. C'était il y a très, très longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "Avec moi, il y avait Aramuhukunda, Arana, Araji et... beaucoup d'aranaras. On a tous célébré le Festival Utsava avec nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "C'était une période difficile. Malgré tout, on a ri et chanté ensemble au festival. C'est une histoire que j'aime beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "Hein, alors vous y avez déjà participé, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "Oui, dans les histoires. Mais je ne m'en souviens plus. Ces histoires, elles ont toutes été racontées par Arana et les autres plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "Araja parle comme un vieux grand-père. Probablement parce qu'il est trop âgé pour se souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#Peut-être que ce n'est pas plus mal comme ça... Nara {NICKNAME}, Paimon, prenez ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "Une petite fleur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "Que cette fleur vous accompagne tout au long de votre voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "J'accepte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "Le temps des naras est beaucoup plus précieux que celui des aranaras, je ne vous retiens donc pas. Profitez bien de ce moment. Allez voir Arakavi un peu plus tard, il est lui aussi en train de se préparer pour le rituel du Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "Moi aussi, je suis d'humeur joyeuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "Moi aussi ! Par contre, vous n'avez jamais participé au Festival Utsava, Araja ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}