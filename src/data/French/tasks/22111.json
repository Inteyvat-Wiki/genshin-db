			"dialogs": [
				{
					"id": 221110101,
					"content": "C'est à propos de la nouvelle mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110102,
					"content": "Bonjour ! Tout le monde a entendu tes exploits à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110103,
					"content": "#Tu deviendras {M#un grand aventurier}{F#une grande aventurière} en un rien de temps si tu continues comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110104,
					"content": "Et donc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Mais pour cela, il te faut t'aventurer toujours plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110106,
					"content": "Tu as déjà acquis énormément d'expérience depuis tes debuts, alors il serait peut-être temps d'explorer hors des sentiers battus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110110,
					"content": "Prends cette lettre, tu la remettras à Catherine de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110111,
					"content": "Catherine de Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Oui, tu la reconnaîtras facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110115,
					"content": "Avec cette lettre, elle te proposera également son aide pour le bon déroulement de tes aventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110116,
					"content": "Bien évidemment, c'est moi qui m'occuperai encore de toi à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110117,
					"content": "Puis, je te prie de ne pas ouvrir la lettre. Je ne voudrais pas que son contenu se perde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110118,
					"content": "Vers les étoiles et au-delà ! En avant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110113,
					"content": "Je peux donc t'appeler « Catherine de Mondstadt » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "Bien sûr, si c'est plus simple pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110107,
					"content": "Je ne connais que Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "#C'est parce que tu étais {M#limité}{F#limitée} à cette région.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110109,
					"content": "Heureusement, tu pourras bientôt élargir tes horizons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Catherine"
				}
			]
		},
