			"dialogs": [
				{
					"id": 221110201,
					"content": "J'ai une lettre pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110202,
					"content": "Vers les étoiles et au-delà ! Bienvenue à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110203,
					"content": "Voici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "Une lettre ? De la part de qui ça pourrait bien être... Oh, je vois que vous venez de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110205,
					"content": "Hein ? Un pissenlit ? Qu'est-ce que ça fait là-dedans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110206,
					"content": "Est-ce que c'est vous qui l'avez mis à l'intérieur pour prouver son origine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110207,
					"content": "Réfléchissez un peu. Rien qu'en la lisant, je peux le savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110208,
					"content": "Ce n'est pas moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Tant pis, ce n'est pas vraiment important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110214,
					"content": "#Vous seriez {M#un aventurier aguerri}{F#une aventurière aguerrie} selon cette lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110215,
					"content": "#Je présume que vous êtes {M#prêt}{F#prête} à vous attaquer aux missions proposées par la branche liyuéenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110216,
					"content": "Vers les étoiles et au-delà ! En avant pour de nouvelles aventures fascinantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110210,
					"content": "Peut-être que c'est Catherine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "Catherine ? Vous parlez sûrement de celle de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110212,
					"content": "Pourquoi a-t-elle fait ça ? C'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 221110213,
					"content": "Tant pis, ce n'est pas vraiment important.",
					"roleType": "TALK_ROLE_NPC",
