				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "Tiens, vous revoilà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730202,
					"content": "Je me demandais si tu allais me suivre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730203,
					"content": "J'aimerais en savoir davantage sur l'Archon Anémo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "Barbatos ? Ça fait belle lurette qu'il a quitté Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730205,
					"content": "L'Archon Géo et l'Archon Électro résident encore l'un à Liyue, l'autre à Inazuma... Mais cela fait une éternité qu'on n'a plus vu Barbatos à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730206,
					"content": "Pourquoi une telle curiosité ? Est-ce qu'il y a un rapport avec Dvalin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730207,
					"content": "Ah, c'est parce que... les Archons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730208,
					"content": "Quelqu'un nous a parlé du passé du dragon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "Ah bon ? Je suis curieux de savoir ce que les gens disent de « Stormterror ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730210,
					"content": "Mais tu pourras me raconter tout ça plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730211,
					"content": "Ça fait longtemps que je ne suis pas revenu ici, et il semblerait que certaines personnes aient un problème avec ma présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "Dvalin n'est pas le seul à avoir été transformé par le vent du changement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730402,
					"content": "Tu me disais que quelqu'un t'a parlé du dragon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730405,
					"content": "... Alors c'est ce que cette bibliothécaire pense ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730406,
					"content": "Elle n'a pas tort. Si on en est arrivés là où on en est aujourd'hui, c'est parce que les deux parties impliquées ont recouru à la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730407,
					"content": "Cependant, sa haine n'est pas due à l'absence d'offrandes de la part des Mondstadtois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730408,
					"content": "... Elle n'est pas naturelle, vois-tu. Elle est le résultat de la corruption qui le consume chaque jour un peu plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730409,
					"content": "Corruption ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730410,
					"content": "Oui, la corruption du sang noir, qui lui a assombri le cœur. Ce mal le torture depuis maintenant des années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730412,
					"content": "Un Mage de l'Abîme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "Je crois que j'en ai entendu parler à Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "C'est ce qui a permis à un Mage de l'Abîme de le berner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730413,
					"content": "Ces mages sont des créatures qui font partie d'une organisation nommée l'Ordre de l'Abîme. Ils ont toujours été hostiles aux humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730415,
					"content": "Ces mages sont des créatures qui font partie d'une organisation nommée l'Ordre de l'Abîme. Ils ont toujours été hostiles aux humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730416,
					"content": "Je ne sais pas d'où ils viennent. Je sais juste qu'ils nourrissent une haine profonde à l'égard des hommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730417,
					"content": "Les Brutocollinus qu'on trouve dans la nature sont souvent à leurs ordres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730418,
					"content": "Avant mon arrivée à Mondstadt, j'ai moi aussi été victime d'une malédiction et été laissé pour mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730419,
					"content": "Mais à présent se dresse devant nous le symbole des héros de Mondstadt, le lieu qui a vu l'origine de la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730420,
					"content": "Le vent qui souffle dans les branches est si pur, et cette odeur... Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730421,
					"content": "D'être ici avec vous, au pied de cet arbre magnifique... Je me sens purifié, tout comme la larme a été purifiée. Comme si la corruption quittait mon corps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730423,
					"content": "Ah, je me sens tellement mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730424,
					"content": "Euh, comment t'es-tu fait empoisonner au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730425,
					"content": "Probablement parce que j'ai essayé de communiquer avec Dvalin tout à l'heure, mais « quelqu'un » m'a interrompu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730427,
					"content": "C'est tellement vrai ! Quoi qu'il en soit, je...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "Ça veut dire qu'on a...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "J'ai non seulement échoué à le libérer de sa malédiction, mais le sort s'est en plus retourné contre moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730429,
					"content": "C'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730431,
					"content": "#Alors pour te faire pardonner, tu vas t'introduire dans la cathédrale avec moi, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730432,
					"content": "La cathédrale ? Pourquoi faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730433,
					"content": "Mettre la main sur Himmel, la lyre sacrée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}