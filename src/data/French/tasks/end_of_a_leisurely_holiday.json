			"dialogs": [
				{
					"id": 765100101,
					"content": "... Ça devrait être assez pour prouver que ce n'est pas une arme militaire secrète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100102,
					"content": "Hmm, en effet, si le design est encore plus complexe, on ne pourra plus dire qu'il s'agit d'un simple jeu d'enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100103,
					"content": "Waouh ! L'ambiance est toute tendue qu'on dirait que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100104,
					"content": "Elles vont se battre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#Oui... Puisque {NICKNAME} est là, pourquoi ne pas nous affronter maintenant, à la loyale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100106,
					"content": "*soupir* Je me demande bien d'où vous vient cette obsession. Ne me dites pas que c'est parce que je vous ai mise à terre sans effort la dernière fois ! Si c'est vraiment ça, alors allons-y, croisons le fer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}, regardez bien qui de nous deux abandonnera en premier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100108,
					"content": "Pff, ce ne sont que des paroles en l'air !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100109,
					"content": "Edler a l'air d'être plus forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100113,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "Ouh là là ! Elles n'étaient pas censées s'entraîner ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100115,
					"content": "Vous pouvez encore abandonner, je vous laisse trois secondes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100116,
					"content": "Trois, deux, un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100117,
					"content": "Waouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100118,
					"content": "Après un « clac » métallique sec, le silence retombe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "C'est bon, Paimon. Vous pouvez ouvrir les yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100120,
					"content": "On dirait qu'on a trouvé la personne la plus tendue ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100121,
					"content": "Q—Quoi ? Wislawa, vous n'êtes pas blessée ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100122,
					"content": "Edler voulait juste effrayer Wislawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "Évidemment. Je n'ai vraiment pas envie de me retrouver dans une prison dans une autre nation pendant mon voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100125,
					"content": "Je n'avais pas d'autre choix que de prendre mon courage à deux mains et de bluffer, histoire de lui montrer que je ne suis pas une marchande qui se laisse intimider aussi facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100126,
					"content": "La prochaine fois qu'on se verra, elle ne se permettra plus de me chercher des noises comme si de rien n'était.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100127,
					"content": "#Mais dis-moi, {NICKNAME}, comment tu l'as remarqué ? Tu n'as pas eu l'air de t'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100128,
					"content": "Edler avait l'air détendue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "Vous êtes perspicace. L'intimidation est en effet le moyen le plus rapide de faire plier quelqu'un. Malheureusement, les raccourcis ne sont jamais aussi simples qu'ils n'y paraissent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100131,
					"content": "#Et puis, {NICKNAME} est là... En tout cas, je suis encore debout pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100132,
					"content": "J'espère juste que la prochaine fois qu'on se verra, j'aurai l'occasion de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100133,
					"content": "Épargnez-moi ça. Quelle est la probabilité qu'on se recroise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100134,
					"content": "Si jamais on se croise pendant votre service, et que vous tentez quoi que ce soit contre moi, je n'aurai d'autre choix que de me défendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100135,
					"content": "Et si on se croise pendant vos congés, on pourra toujours faire une partie de simulation tactique. Ça me fera un peu de chiffre d'affaires, comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100129,
					"content": "Edler a dit qu'on verrait « qui abandonnerait en premier ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "Il n'y a pas de balles dans le mousquet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "Wislawa semble plus imposante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}