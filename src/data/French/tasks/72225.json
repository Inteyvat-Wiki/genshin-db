				}
			]
		},
		{
			"id": 7222503,
			"completionStepIds": [
				7222505
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
