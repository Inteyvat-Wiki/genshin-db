			"dialogs": [
				{
					"id": 738020101,
					"content": "Vers les étoiles et au-delà ! Bienvenue à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020102,
					"content": "Bonjour Catherine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Bonjour Catherine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "Bonjour, vous avez l'air en pleine forme aujourd'hui. Êtes-vous ici pour recevoir une mission ? Ou est-ce pour autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020105,
					"content": "Eh bien... Pourquoi me regardez-vous comme ça ? Vous... Vous voulez me demander quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020106,
					"content": "Non !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "Je vois... Vous semblez avoir une grande expérience en matière d'aventures, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020109,
					"content": "Plus ou moins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Alors, tu connais certainement le fonctionnement de la Guilde des aventuriers. Je ne vais pas vous faire perdre plus de temps sur ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020111,
					"content": "Je suis à ta disposition si tu as d'autres questions concernant les affaires internes de la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020112,
					"content": "#N'hésitez pas à accepter des missions dans la Ville de Sumeru. {M#Un aventurier compétent}{F#Une aventurière compétente} comme toi sera d'une grande aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 738020113,
					"content": "Que tes aventures continuent vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
