			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Buyun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Bon, voilà ce qu'il faut dire d'après Keqing...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Bonjour, vous vendez des lunes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "En effet. Combien en voulez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210304,
					"content": "Parler quantité ici n'est guère pratique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "#Bien répondu. Voici, vous pourrez vous rendre à la Chambre de Jade... Ah oui. Êtes-vous les {M#invités}{F#invitées} ayant rendez-vous avec Ningguang aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210306,
					"content": "C'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "#(Mais le code qu'{M#ils}{F#elles} m'ont donné est celui de l'Alioth, et pas celui des invités. Qu'est-ce que ça signifie...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buyun"
				}
			]
		}
	]
}