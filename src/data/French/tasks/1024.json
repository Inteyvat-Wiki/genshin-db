			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "*souffle* Pfiou... Ça fatigue tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "Si on n'avait pas suivi la Chambre de Jade, on n'aurait jamais su où aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "Alors ? On arrive à temps ? Le Dieu du Vortex est toujours dans la mer et n'a pas touché à Liyue, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "Tiens, que... que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "Hein ? Les Adeptes ! Qu'est-ce que vous faites à bord de la Chambre de Jade ? Je croyais que vous vouliez vous en prendre aux Sept Étoiles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Face à une catastrophe d'une telle ampleur, les Adeptes et les Sept Étoiles ont accepté de mettre leurs différences de côté pour le moment, et de s'unir contre l'ennemi commun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10240208,
					"content": "Oh, je vois... Alors, comment est-ce que vous comptez défendre Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Ouh là... Rien que de voir le Dieu du Vortex d'ici me donne la chair de poule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "Tu n'es pas la seule. Les nouvelles recrues des Millelithes n'arrivent même pas à rester au garde-à-vous sans trembler. La vue d'un ancien dieu peut être difficile à supporter pour les gens du commun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "... Et c'est pour cette raison qu'il faut qu'on chasse ce démon avant qu'il ne s'approche davantage de Liyue et de ses habitants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "Alors c'est ce genre d'ennemi qui a combattu pendant la Guerre des Archons ? C'est juste légèrement terrifiant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Alors, est-ce que l'alliance des Sept Étoiles, des Millelithes et des Adeptes suffira à arrêter ce démon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Nous avons déjà discuté de ce sujet, et en toute franchise... Il est peu propable que nous réussissions à le stopper seuls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "Hein ? Mais... Les Adeptes sont supposés être les protecteurs de Liyue ! Il doit bien y avoir un moyen, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Il existe bien un moyen, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10240218,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "Les Sept Étoiles ont par le passé étudié le mécanisme que vous connaissez sous le nom de « baliste de Guizhong ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10240220,
					"content": "Or le destin a voulu que la conceptrice de cette baliste soit justement parmi vous aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10240221,
					"content": "Qu'avez-vous donc appris, vous simples mortels, sur la complexité des mécanismes conçus par les Adeptes ? Sachez qu'avec quelques subtiles modifications apportées à la tourelle, cette dernière se révélera une arme à la puissance dépassant votre imagination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Souffle-Nuages"
				},
				{
					"id": 10240222,
					"content": "On peut dire qu'il s'agit là d'une bénédiction des Adeptes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "Qu'il en soit ainsi, alors. Nous utiliserons la baliste de Guizhong améliorée pour repousser ce dieu. Tous les Adeptes présents vont aider à son maniement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "Plus une minute à perdre, il faut agir maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
