				},
				{
					"id": 413330302,
					"content": "Il est encore tout chaud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "J'ai encore besoin d'un peu de temps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "*soupir* Bon, je continue mon poème...",
					"roleType": "TALK_ROLE_NPC",
