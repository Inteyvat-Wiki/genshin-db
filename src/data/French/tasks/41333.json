			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chunkie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "« Le mystérieux Adepte des hauteurs célestes s'élève dans les cieux ». C'est beau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330102,
					"content": "Vous regardez les étoiles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Oui... et non... C'est le Festival des lanternes en ce moment, pas vrai ? Alors quoi de plus approprié que cette magnifique vue en ces temps de célébration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330104,
					"content": "J'ai même essayé d'écrire quelques vers... Vous savez, mes amis disent que les filles aiment ce genre de choses de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330105,
					"content": "Alors peut-être que Ziwei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330106,
					"content": "Vous apprenez la poésie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "Ziwei m'a appris le nom de nombreuses constellations. *soupir* Elles ont des noms tellement jolis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330109,
					"content": "Donc j'aimerais la remercier, vous voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330110,
					"content": "J'aimerais bien écrire un poème sur une lanterne céleste, puis trouver un bon endroit pour la lâcher avec Ziwei... Et on pourrait manger quelque chose, et chanter des chansons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330111,
					"content": "Sûr que ça va marcher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330112,
					"content": "Marcher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "Euh... Je veux dire... Comme ça, ce sera plus sympa, vous voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330114,
					"content": "Enfin, passons... Je cherche un endroit avec une bonne ambiance, où il n'y a pas trop de monde, mais avec une belle vue quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330115,
					"content": "J'ai demandé à droite à gauche, et j'ai trouvé deux endroits. Regardez ces deux-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330116,
					"content": "Des amis m'ont dit qu'ils avaient l'habitude d'y aller pour lâcher des lanternes célestes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330117,
					"content": "Mais bon, j'ai encore mon poème à écrire... Si j'y vais pour voir quel endroit est le mieux, je risque de perdre mon inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330118,
					"content": "Vous pourriez peut-être m'aider à aller voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330119,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Vous me retirez une épine du pied ! Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330107,
					"content": "Ziwei ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
