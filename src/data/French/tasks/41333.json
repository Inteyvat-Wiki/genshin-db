			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chunkie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "« La rencontre de Ziwei et Chunkie »... Non, ça ne va pas, c'est trop direct...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330202,
					"content": "Oh ? Vous êtes déjà de retour ? Alors, vous avez trouvé les endroits dont je parlais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330203,
					"content": "Oui, on en revient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "Vous avez fait vite, dis donc ! Bon, je regarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330205,
					"content": "OK, voyons voir... Cet endroit est assez unique, tandis que l'autre est plutôt pittoresque... Ça me rappelle la chanson « Aucune montagne n'est trop haute... » Euh, j'ai oublié la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330206,
					"content": "Ah, peu importe... Ces deux emplacements sont magnifiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330207,
					"content": "#Mais je sais lequel choisir... {M#Voyageur}{F#Voyageuse}, j'aurais un autre petit service à vous demander, si possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330208,
					"content": "Mes amis m'ont dit qu'il valait mieux apporter quelque chose à manger. Alors, à votre avis, qu'est-ce que je devrais apporter quand j'irai voir Ziwei ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330209,
					"content": "Du poisson chihu grillé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Du poisson chihu grillé... C'est un peu trop gras, non ? Pas vraiment approprié. Que pensez-vous d'un tofu aux amandes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330212,
					"content": "Oui, du tofu aux amandes ! C'est parfait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330213,
					"content": "#{M#Voyageur}{F#Voyageuse}, puis-je vous demander de m'aider à préparer un tofu aux amandes dans ce cas ? Je n'ai pas encore fini de fignoler mon poème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330214,
					"content": "« Et d'innombrables étincelles se mettent à voltiger »... Oui, c'est pas mal ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330211,
					"content": "Du tofu aux amandes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
