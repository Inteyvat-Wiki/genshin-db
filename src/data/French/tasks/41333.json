		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "Sous cet angle... cette constellation... ressemble un peu à un chien. Quel nom lui donner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Oh, Chunkie ! Vous me cherchiez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Euh... Eh bien... C'est que... Je me promenais autour de Liyue, et je suis tombé sur un endroit splendide et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330704,
					"content": "Un endroit splendide ? Pour observer les étoiles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "Euh... Oui, pour les étoiles... Et aussi, pour lâcher une lanterne céleste que j'ai préparée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330706,
					"content": "Là, regardez ! Et j'ai même écrit un poème dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330707,
					"content": "« Que les étincelles naissent de la rencontre de la pioche et de la météorite. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Hmm... Je ne comprends pas bien votre souhait, mais c'est un très joli poème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "Mais vous savez, vous ne devriez pas montrer votre souhait aux autres, sinon il ne se réalisera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "Mais sinon, pourquoi vouliez-vous me voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Euh, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330712,
					"content": "Il a trouvé un bel endroit pour lâcher sa lanterne céleste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Pour lâcher une lanterne céleste ? Oh, désolée... En fait, j'aimerais plutôt trouver un endroit où il n'y a pas de lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "Vous savez, la lumière des lanternes empêche de bien contempler les étoiles. Alors, je préfère trouver un endroit isolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Merci à vous, vous êtes bien gentils. Je vais aller chercher un peu plus loin, vers là-bas. Passez un bon festival !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "Euh... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330718,
					"content": "Elle est partie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "Ce... Ce n'est pas grave. C'est mon poème qui était un peu trop abstrait, et c'est pour ça qu'elle n'a pas compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330721,
					"content": "Ne vous inquiétez pas, je ne perdrai pas courage. Le jour viendra où... elle comprendra mes sentiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330722,
					"content": "#{M#Voyageur}{F#Voyageuse}, merci pour toute votre aide. Tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330723,
					"content": "*soupir* Je peux au moins aller lâcher cette lanterne céleste, j'imagine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chunkie"
				},
				{
					"id": 413330719,
					"content": "Ne vous découragez pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "Pourquoi ne pas l'accompagner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
