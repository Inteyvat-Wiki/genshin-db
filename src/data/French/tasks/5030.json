			},
			"dialogs": [
				{
					"id": 50301101,
					"content": "Oh, c'est vous. Merci encore de nous avoir secourus. Osawe, regarde qui c'est ! Dis « merci » à ces héros !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301102
					],
					"speakerTitle": "Iyoba"
				},
				{
					"id": 50301102,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301103
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301103,
					"content": "#Ce n'est rien. Nous sommes {M#contents}{F#contentes} que vous alliez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301104,
					"content": "Je dois aussi remercier les autres personnes qui nous ont aidés. Comment s'appelaient-ils ? Les Fa... tulences...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301105
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301105,
					"content": "Les Fatui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301106,
					"content": "C'est ça, les Fatui ! Ils ont aussi été incroyables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301107
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301107,
					"content": "Avant, je n'avais pas une très bonne image des Fatui, mais ça a vraiment changé mon point de vue. Je suppose qu'il y a de bonnes personnes dans toutes les organisations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iyoba"
				}
			]
		},
