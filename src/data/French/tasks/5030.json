			"dialogs": [
				{
					"id": 50300301,
					"content": "Où en sommes-nous ? Avons-nous suffisamment de stocks ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300302,
					"content": "Pratiquement plus. Il y a toujours du matériel d'urgence, mais ils sont réservés aux médecins et aux guerriers. Nous ne pouvons pas y toucher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Je sais, je sais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300304,
					"content": "Très bien, eh bien... Donne-moi au moins ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
