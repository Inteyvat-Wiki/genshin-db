			"dialogs": [
				{
					"id": 50301001,
					"content": "Ah, vous êtes de retour. Merci de m'avoir sauvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301002
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301002,
					"content": "#Nous sommes simplement {M#heureux}{F#heureuses} que tu ailles bien. Hé, où sont passés ces sauriens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301003,
					"content": "Oh, ils sont déjà repartis pour aider les coursiers restants avec la reconnaissance et la livraison d'informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301004
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301004,
					"content": "Ça m'embête vraiment de ne pas pouvoir faire ma part. Surtout en sachant à quel point les choses se sont aggravées dehors. Mais j'imagine qu'il faut connaître ses limites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raman"
				}
			]
		},
