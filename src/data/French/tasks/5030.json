			},
			"dialogs": [
				{
					"id": 50300601,
					"content": "Je suis tellement reconnaissante que Mayahuel soit là. Grâce à son expertise, nous avons pu soigner beaucoup plus de personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300602
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300602,
					"content": "Mais j'ai peur qu'elle en fasse trop. Elle ne s'est pas encore arrêtée. J'ai besoin que quelqu'un d'autre intervienne pour pouvoir la persuader de faire une pause.",
					"roleType": "TALK_ROLE_NPC",
