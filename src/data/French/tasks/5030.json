			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Oh, Archon, je suis hors de moi... Nous sommes en sous-effectif et sous-approvisionnés, et je ne peux même pas soigner la moitié des blessures que je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "J'aimerais juste avoir quelqu'un avec plus d'expertise vers qui me tourner... Non, non, je ne dois pas penser comme ça. Je dois relever le défi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "#Je vous ai {M#vus}{F#vues} ramener Chuychu... C'est une telle tragédie. Chuychu était la plus prometteuse médecin que j'aie eu la chance de rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Nous étions de proches partenaires commerciaux. Elle avait les normes les plus élevées en matière de fournitures médicales et elle puisait souvent dans ses propres poches pour soigner ses patients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Elle m'a toujours dit à quel point elle appréciait l'expérience plus que l'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Elle a dit qu'elle devait perfectionner ses compétences pour pouvoir sauver plus de personnes, en particulier la personne qu'elle voulait le plus sauver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Malheureusement, en fin de compte, la seule personne qu'elle n'a pas pu sauver était elle-même. Et maintenant, Natlan a perdu l'une des plus belles promesses d'une génération...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
