			},
			"dialogs": [
				{
					"id": 50301501,
					"content": "Vous allez bien ! Pfiou, nous étions morts d'inquiétude pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301502
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301502,
					"content": "Alors vous êtes parvenus à vous mettre à l'abri ? Le voyage s'est bien passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301503,
					"content": "Euh... Pas exactement. Nous avons rencontré un groupe de monstres de l'Abîme et avons dû nous battre pour nos vies. Mais je dois bien l'admettre, ces gens ont vraiment été à la hauteur. Ils combattaient aussi bien que s'ils avaient été des guerriers entraînés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301504
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301504,
					"content": "Héhé, je suppose que ma mémoire musculaire est toujours intacte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "J'ai beaucoup de chance d'être en vie. Nous devons continuer à survivre pour pouvoir commencer à reprendre ce qui nous a été pris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "Vous feriez mieux de veiller à rester en vie, vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunak"
				}
			]
