			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uturunku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Ah, c'est vous deux ! Fantastique ! Je suis très reconnaissant pour tous vos encouragements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Beaucoup de gens à Natlan considèrent que combattre l'Abîme est un honneur, mais ils laissent ensuite l'excitation leur monter à la tête et finissent par se mettre en grand danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Vous aviez raison, il est important de se battre, mais il est également important de rester en vie. Nous nous battons pour les gens que nous aimons, mais aussi pour avoir la chance de les revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "J'ai partagé vos réflexions avec mes frères d'armes, et ils ont également été inspirés. Désormais, tout le monde se bat avec plus de détermination, et nous inversons la tendance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "Alors encore une fois... Merci du fond du cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
		{
			"id": 503009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
