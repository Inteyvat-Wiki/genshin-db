				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300901,
					"content": "... Oh, c'est vous deux. Je pensais qu'on ne se reverrait plus jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300902
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300902,
					"content": "J'ai bien résisté et nous avons gagné, même si nous avons enregistré des pertes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300903
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300903,
					"content": "#Vous allez continuer à vous battre ? Dans ce cas, soyez {M#prudents}{F#prudentes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300904
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300904,
					"content": "Combattre l'Abîme est un grand honneur, mais le chemin vers la victoire ne réside pas dans l'honneur et la gloire, il réside dans le fait de voir un jour de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
