			},
			"dialogs": [
				{
					"id": 50301401,
					"content": "#Je suis ravi de vous voir revenir {M#sains et saufs}{F#saines et sauves}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301402
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301402,
					"content": "Nous avons dit que nous vous verrions au Stade, n'est-ce pas ? Nous avons tenu parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Héhé... Tu sais, c'était la première fois de ma vie que je tuais un monstre de l'Abîme, et c'est alors que j'ai réalisé... qu'ils n'étaient pas si redoutables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301404
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301404,
					"content": "J'ai laissé ma peur prendre le dessus trop longtemps... Je me demande combien de personnes j'aurais pu sauver si j'avais eu assez de courage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301405
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301405,
					"content": "Ne sois pas si dur avec toi-même. À l'heure actuelle, rester en vie est la chose la plus importante que tu puisses faire. Nous devons continuer à vivre pour que leurs histoires puissent être racontées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301406
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301406,
					"content": "Ils vivront à jamais dans nos cœurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Libiac"
				}
			]
		},
