						50300504
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300504,
					"content": "Très bien, eh bien... Donne-moi au moins ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300505
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50301601,
					"content": "#Ah, c'est vous. Je suis contente de voir que vous allez bien {M#tous}{F#toutes} les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Comment va votre fils ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Aucune idée. Les communications se sont raréfiées et il y a trop de blessés à soigner. Pour le moment, je me concentre sur eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Mais je lui fais confiance. Je sais qu'il fera le bon choix même lorsque les choses se compliqueront. C'est mon fils et je serai toujours fière de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
		{
			"id": 503006,
