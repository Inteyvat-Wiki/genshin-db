				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "Oh ? Où est passée Columbina ? Je ne la vois nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540103,
					"content": "Ouah, que faites-vous tout là-haut ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Rejoignez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540105,
					"content": "Dans quoi on s'embarque cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Vous souvenez-vous des pierres qu'on a ramassées la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540107,
					"content": "La dernière fois ? Ah, celles qui brillent après avoir absorbé le kuuvahki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Tout à fait. Après cela, les kuuhenkis en ont ramassé davantage et je les ai triées en deux catégories : les sombres et les claires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540109,
					"content": "Les sombres et les claires ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Pour jouer aux « échecs lunaires », évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540111,
					"content": "Les « échecs lunaires » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Vous n'y avez jamais joué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540113,
					"content": "... Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Je vois... J'ai eu envie d'essayer depuis que j'ai vu les grilles que les enfants des Descendants de givrelune dessinent par terre, mais je n'ai jamais vu personne jouer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540115,
					"content": "Quelles sont les règles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hm... Ce sera plus facile de vous montrer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540117,
					"content": "Ouah, mais c'est génial ! Comment avez-vous fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hm ? Avec un peu de kuuvahki, bien sûr... Vous ne pouvez pas le faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540119,
					"content": "Vous devriez revoir vos attentes à la baisse. On n'est pas des Déesses de la lune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Très bien. Voici le plateau. Cela représente le « ciel nocturne », et les pions de chaque joueur représentent les « lunes ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540121,
					"content": "Les deux joueurs placent à tour de rôle leurs lunes dans le ciel, et le premier à aligner trois lunes gagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540122,
					"content": "Oh ! C'est un type de morpion !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "On appelle donc ce jeu les « échecs lunaires » à Nod-Krai... Il a hérité d'une touche locale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Je vois. Dans cette version, les lunes peuvent tourner, alors il ne peut jamais y avoir plus de trois lunes à la fois dans le ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540125,
					"content": "Lorsque le ciel nocturne est plein, la lune qui s'est élevée le plus tôt disparaîtra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540126,
					"content": "C'est logique... et ça rend le jeu beaucoup plus difficile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Voulez-vous essayer ? Ce sera aussi ma première fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540128,
					"content": "(On dirait qu'elle a hâte d'y jouer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Héhé, ça a l'air sympa ! Je serai l'arbitre ! {NICKNAME} est {M#malin}{F#maligne}, alors je ferais attention si j'étais vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
