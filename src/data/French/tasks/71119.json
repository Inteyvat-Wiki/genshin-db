					"nextDialogs": [
						711190102
					],
					"speakerTitle": "Inscription d'encens"
				},
				{
					"id": 711190102,
					"content": "« ... Le parfum des orchidées, l'odeur des fleurs, un chaudron en jade et une coupe en or, les effluves de l'encens sont emportées vers l'<color=#00E1FFFF>est</color> et l'encens brûlant vers l'<color=#00E1FFFF>ouest</color>... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711190103
					],
					"speakerTitle": "Inscription d'encens"
				},
				{
					"id": 711190103,
					"content": "#« ... <color=#00E1FFFF>Construisez un autel</color> pour le sacrifice, la libation de vin doux et l'imbibition{NON_BREAK_SPACE}; brillant depuis mille ans, illuminant toutes les directions... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscription d'encens"
				}
			]
