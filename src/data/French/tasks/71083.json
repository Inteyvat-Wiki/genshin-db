				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "C'est incroyable que vous ayez vraiment brisé le sceau des Sept Étoiles. Il faut que j'écrive ça dans le rapport hebdomadaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Faites en sorte que ça ait l'air grandiose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "Hum... Un peu de sérieux. Cette affaire est grave, et c'est au Sept Étoiles de statuer là-dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "#En d'autres termes, lorsque je présenterai le rapport, ne soyez pas {M#surpris}{F#surprise} si les Sept Étoiles viennent en personne vous arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "Hmph. À ce moment-là, je ne pourrai rien faire pour vous protéger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(Sa suggestion est un peu trop évidente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Hmph ! Alors, vous avez la frousse ? Il y a des gens qui vous attendent, allez-vous-en !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
