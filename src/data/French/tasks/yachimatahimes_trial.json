			"dialogs": [
				{
					"id": 722690101,
					"content": "#Je suis Eki des jibashiri. {M#Héros}{F#Héroïne} de Sangonomiya, je vous considère comme digne de relever ce défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690102,
					"content": "Je serai responsable de l'épreuve de « clairvoyance ». Avancez-vous, et résolvez toutes les énigmes pour remettre les flammes de la grande porte à leur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "Un champ de bataille évolue constamment. Ce n'est qu'en gardant les oreilles et les yeux grands ouverts en tout instant que vous pourrez appréhender correctement la situation et maîtriser toutes les variables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				}
			]
		},
