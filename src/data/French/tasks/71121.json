					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Marchand étrange"
				},
				{
					"id": 711210304,
					"content": "Je vous conseille de regarder quels trésors ils ont laissés ici. Oh... ne vous inquiétez pas, je les ai tous répertoriés... Je m'occupe de tout ce qui doit être rendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Marchand étrange"
				},
				{
					"id": 711210305,
					"content": "Attendez...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Mais non, nous nous reverrons certainement !",
