					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "Tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010404,
					"content": "Tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220010405,
					"content": "Arrêtez ! Vous n'êtes pas fatigués de vous chamailler autant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010406,
					"content": "C'est qu'un jeu, pas la peine de s'énerver. On est tous amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010407,
					"content": "Regardez ce que j'ai là, des fruits du lotus fraîchement cueillis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010408,
					"content": "Mangez d'abord. On verra pour le reste quand vous aurez fini de manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010409,
					"content": "On décidera des rôles de chacun calmement, ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010410,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220010411,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010412,
					"content": "Ils se sont vraiment calmés tout à coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Je te l'avais dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010414,
					"content": "Comment tu savais que ça allait marcher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Je joue avec eux depuis assez longtemps pour le savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010416,
					"content": "Tu es trop forte, Lulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Merci ! Mais Beidou est encore plus forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010418,
					"content": "J'espère que je serai comme elle quand je serai grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				}
			]
		},
