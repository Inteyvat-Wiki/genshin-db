			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "Voilà, c'est lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010302,
					"content": "Quoi ?! Pourquoi tu les as ramenés ici ? Tu devais les mener en bateau pour que Lulu et moi on ait le temps de déguerpir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220010303,
					"content": "Et pourquoi c'est moi qui devrais me sacrifier pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010304,
					"content": "J'ai eu une meilleure idée : te vendre aux pirates pendant que MOI je m'enfuis avec Lulu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010305,
					"content": "Espèce de... Beidou a dit qu'on ne devait pas trahir ses amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220010306,
					"content": "Ah bon ?! Mais est-ce qu'elle a dit qu'un capitaine devait s'enfuir comme un lâche dès qu'il y a un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010307,
					"content": "Je ne te donnerai plus jamais de fruit du lotus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220010308,
					"content": "Je m'en fiche ! Comme si je pouvais pas en trouver moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010309,
					"content": "Pourquoi ils se disputent comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Ne t'inquiète pas, j'ai une solution pour les calmer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010311,
					"content": "Ils adorent les fruits du lotus, alors ça devrait les calmer si on leur en donne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010312,
					"content": "Tu pourrais m'en chercher quelques-uns ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010313,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Merci ! Fais vite s'il te plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010315,
					"content": "Je ne crois pas que ça réglera le problème...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Hum... Est-ce que tu as une meilleure solution ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010317,
					"content": "Tant pis, va quand même chercher des fruits du lotus. Leur dispute ne peut pas durer toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				}
			]
		},
