			"dialogs": [
				{
					"id": 220010101,
					"content": "Petit Meng, c'est à mon tour d'être le capitaine aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, j'ai été capitaine plusieurs fois déjà. On devrait laisser Fei être capitaine cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220010103,
					"content": "Mais Petit Meng, tu es le meilleur capitaine ! J'ai envie que tu le restes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010104,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "On joue ! C'était à mon tour d'être le capitaine normalement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010106,
					"content": "Mais Lulu dit que c'est plus marrant quand c'est Petit Meng le capitaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010107,
					"content": "Enfin bon... Si Lulu le dit, c'est que c'est vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010108,
					"content": "Dis, tu as du temps pour jouer aux pirates avec nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010109,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Je suis encore le serviteur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010113,
					"content": "#Reviens me voir quand tu seras {M#prêt}{F#prête}, comme la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010111,
					"content": "#Je veux être {M#un gentil}{F#une gentille}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Ah, c'est encore moi le capitaine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Fei"
				}
			]
		},
