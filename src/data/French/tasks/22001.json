						220010603
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010603,
					"content": "Pff, c'est nul d'être le serviteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010604,
					"content": "Il n'y a que Lulu et Petit Meng qui s'amusent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010605,
					"content": "La scène du vol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "#{M#Un}{F#Une} pirate ? Désolé, j'ai rien à voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010607,
					"content": "Si tu veux un butin il faudra trouver quelqu'un de riche... Attends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010608,
					"content": "Ah ! Le capitaine est plein aux as ! Tu devrais aller le voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010609
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010609,
					"content": "Hein ?! Mais t'es censé être son allié, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010610,
					"content": "Justement ! C'est pour ça que je sais où il se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010611
					],
					"speakerTitle": "Fei"
				},
				{
