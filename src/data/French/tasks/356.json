			"dialogs": [
				{
					"id": 3560401,
					"content": "Alors... Voilà ton cadeau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560402,
					"content": "Un <color=#00E1FFFF>planeur de vent</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560403,
					"content": "Les Éclaireurs planent avec dans les airs, et les habitants de Mondstadt aiment s'en servir aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560404,
					"content": "J'ai voulu te l'offrir ici pour que tu puisses essayer ce joujou tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560405,
					"content": "Tu as l'air de bien t'y connaître !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560406,
					"content": "Le vent est au cœur de la vie des Mondstadtois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560407,
					"content": "Allez, essaye-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560408,
					"content": "Les commandes sont faciles, mais écoute quand même mes instructions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
