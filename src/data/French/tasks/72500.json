				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "Mauvaise nouvelle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "Le patron s'est encore fait arrêter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Un gars de la Commission administrative vient d'afficher un avis sur le panneau qui annonce la suspension de notre festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "Je ne comprends pas pourquoi. Peut-être que le patron a réellement distribué nos prospectus au Tenshukaku ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "Il a lui-même affirmé que la Shogun ne voudrait pas rater le Festival des tambours harmonieux du sublime Arataki !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Hein ? Bon, je suis plutôt d'accord avec lui. C'est une occasion qu'elle ne voudrait rater pour rien au monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "Bah oui. Tu ne trouves pas, Mamoru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "Peu importe ce qu'on pense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "Le patron s'est fait arrêter sur-le-champ par les okuzumeshuu, qui l'ont emmené à la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "Qu'est-ce que vous allez faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Shinobu est sans doute déjà sur le coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "Les okuzumeshuu l'ont arrêté pour motif de trouble en zone militaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Puis dame Kujou a changé celui-ci en trouble à l'ordre public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "Rah, cette fichue Tengu ! Elle a aggravé le cas du patron !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "Mais non, idiot ! Au contraire, elle a allégé la charge retenue contre lui. On s'en sort généralement avec un simple avertissement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "En tout cas, il faudra attendre le retour du patron pour décider de la suite du festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "#Ne t'inquiète pas, {M#voyageur}{F#voyageuse}. Tout ira bien tant que Shinobu s'en charge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "Tu nous as tellement soutenus pour l'organisation du festival que le patron voudra te remercier en personne dès qu'il sera relâché. J'en suis sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "J'espère que ton voyage sera de mieux en mieux, à l'image de notre festival !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "Oui, de mieux en mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
}