			"dialogs": [
				{
					"id": 250360101,
					"content": "... Cette question était-elle trop facile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "#Ah, désolé. J'étais en train de penser tout haut, je ne vous avais pas {M#remarqué}{F#remarquée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Permettez-moi de vous saluer. Je suis Keita des Maîtres du vent nocturne et un apprenti ici, responsable de la gestion des dossiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "À quoi pensiez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah... À quelques questions simples sur le passé, le présent et le futur de Natlan. Pas de quoi en faire une histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "#Vous avez l'air d'être {M#un voyageur venu}{F#une voyageuse venue} de loin. Je peux voir que vous entretenez des amitiés profondes et que vos connaissances sont vastes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "Vous pouvez essayer de répondre aux questions que j'ai déjà préparées, si vous le souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "Les réponses à ces questions se trouvent dans vos voyages, qu'ils soient passés, présents ou futurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
