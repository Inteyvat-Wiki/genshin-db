			"dialogs": [
				{
					"id": 230310601,
					"content": "Très bien, les ingrédients sont tous là. Je vais pouvoir fabriquer un appât sans pareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310602,
					"content": "Kayvan fabrique un appât avec une grande aisance.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Bon, on commence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310604,
					"content": "La profondeur de l'hameçon dans l'eau est correcte... Le flot de l'eau est convenable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310605,
					"content": "Ne faites pas de bruit, les poissons dans l'eau y sont sensibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310606,
					"content": "Le bruit de vos pas pourrait les effrayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310607,
					"content": "Je ne bouge pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "Alors du calme et un peu de patience...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310610,
					"content": "Kayvan a pêché un sac d'objets trempés.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "C'est quoi ça ? Ce n'est même pas un poisson !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310612,
					"content": "C'est vrai que je n'avais jamais vu ce genre de poisson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "C'est toujours comme ça, je ne suis pas du tout surpris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "#Ahem, {M#étranger}{F#étrangère}, gardez votre calme et ne prêtez pas une si grande attention aux détails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "Toute chose sortie de l'eau à l'aide de l'hameçon peut être considérée comme un poisson pêché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "Je ne vous cache pas que ce n'est pas moi qui me suis attribué ce titre de meilleur pêcheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "Après tout, ce n'est pas donné à tout le monde de pêcher à chaque fois quelque chose qui ne mord pas et n'est pas vivant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Les autres pêcheurs me complimentent et disent que j'ai un talent sans pareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
					"content": "Ils essayent peut-être de vous réconforter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "Donc pour faire simple, vous pouvez tout pêcher sauf du poisson ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310622,
					"content": "Ha ! Peu importe ce qu'ils pensent ! Moi au moins, j'arrive toujours à pêcher quelque chose !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310623,
					"content": "Et j'arriverai bien un jour à pêcher un poisson. Si ce n'est pas aujourd'hui, ça sera demain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310624,
					"content": "Merci de m'avoir aidé à trouver les ingrédients, voici votre récompense. Je vais aller à un autre endroit pour continuer à pêcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310625,
					"content": "La prochaine fois... La prochaine fois, je pêcherai un gros poisson à coup sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310620,
					"content": "Ils se moquent peut-être de vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "Les pieds de Paimon ne touchent pas le sol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
		},
