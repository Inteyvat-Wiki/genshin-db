			"dialogs": [
				{
					"id": 230310201,
					"content": "#De quel ingrédient avez-vous besoin{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310202
					]
				},
				{
					"id": 230310202,
					"content": "Si j'en crois mon intuition du jour... Des pêches zaytuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310203,
					"content": "C'est un ingrédient banal, mais peu de gens l'utilisent comme appât.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310204,
					"content": "Pourriez-vous m'aider à en trouver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
