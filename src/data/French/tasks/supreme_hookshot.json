			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "#Hé, vous semblez être... {M#le voyageur}{F#la voyageuse} ? Quelle surprise de vous voir si {M#décontracté et élégant}{F#décontractée et élégante} dans un tel endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310102,
					"content": "#Ou alors vous êtes simplement {M#un pêcheur}{F#une pêcheuse} qui a choisi ce plan d'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310103,
					"content": "Vous avez l'œil ! Ici, c'est le meilleur endroit du coin pour pêcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310104,
					"content": "On dirait bien qu'il n'y a pas d'autres pêcheurs dans le coin, pourtant. Alors, pourquoi en êtes-vous si sûr ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310105,
					"content": "C'est évidemment parce que j'ai une intuition unique, voyez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310106,
					"content": "En tant que meilleur pêcheur de la région, j'ai des méthodes qui me sont propres pour sélectionner mes lieux de pêche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310107,
					"content": "C—C'est vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "Vous n'avez rien pêché, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310109,
					"content": "N'en dites pas plus. Laissez-moi vous présenter le splendide hameçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310110,
					"content": "Le splendide...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Procurez-moi les ingrédients spéciaux avec lesquels je prépare moi-même mes appâts, et je vous pêcherai un poisson que vous n'avez jamais vu auparavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310113,
					"content": "Ça m'a l'air louche, tout ça. Est-ce que ses appâts faits à la main sont vraiment efficaces ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310114,
					"content": "Ça ne coûte rien d'essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "#Vous êtes {M#direct}{F#directe}, j'adore parler avec des gens comme vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310116,
					"content": "En plus de la pomme crépusculaire et du blé qui constituent la base de mes appâts, j'ai besoin d'un autre ingrédient pour leur donner une âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310111,
					"content": "Hameçon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
