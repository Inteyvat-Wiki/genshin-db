					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Je lui souhaite beaucoup de succès dans son travail.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "#Haha, vous vous en sortez très bien. On dirait de {M#vrais patrons}{F#vraies patronnes}, presque plus que moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "Je déclare le Parc cinématographique de Chevalmarin officiellement ouvert !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Gérer un parc d'attractions est une entreprise à long terme. Ce n'est pas en se précipitant qu'on fait du profit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Cette tâche est presque terminée. Reposons-nous un peu en attendant le rapport des revenus de ce cycle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Je suivrai de près son taux de présence !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
		{
			"id": 4018909,
