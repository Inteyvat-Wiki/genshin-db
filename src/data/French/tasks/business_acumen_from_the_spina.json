			"dialogs": [
				{
					"id": 401891601,
					"content": "Pfiou... Tout est fin prêt ! Vous savez maintenant tout de la gestion du Parc cinématographique de Chevalmarin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "Hein ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "C'est vrai qu'on a appris beaucoup de choses, mine de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "Vous nous avez bien expliqué comment faire, Navia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Non, je n'ai pas fait grand-chose. Vous avez essentiellement suivi votre intuition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "J'imagine que cette histoire de « gestion à long terme » a dû vous effrayer, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "Mais il n'y avait pas de raison d'avoir peur. En y allant étape par étape, on peut s'occuper d'une chose à la fois. Même quelqu'un sans talent particulier peut y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "Tous ces progrès m'ont vraiment motivée ! Je vais prendre bonne note de vos mots d'encouragement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "À partir de maintenant, gérons ensemble le Parc cinématographique de Chevalmarin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "Navia, c'est grâce à vos bons conseils que nous avons pu réussir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
		}
