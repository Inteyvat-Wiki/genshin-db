			"dialogs": [
				{
					"id": 401891001,
					"content": "Les chiffres ne sont peut-être pas très élevés, mais il faut bien commencer quelque part. Ça reste un bon début !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Sur la base de cette dynamique, nous devrons envisager de déployer des stratégies commerciales plus originales lors du prochain cycle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "Pour attirer du monde, j'ai invité la célèbre cheffe cuisinière de Fontaine, mon amie Escoffier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "Elle montrera l'étendue de ses talents au restaurant du parc. En parlant d'elle, allons la retrouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "Le restaurant fait aussi partie de notre stratégie commerciale ? C'est de plus en plus compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
