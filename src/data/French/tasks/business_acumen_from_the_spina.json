			"dialogs": [
				{
					"id": 401891401,
					"content": "J'ai revisité la sauce pour ces côtes levées au barbecue. La saveur est plus riche que celle de la version classique, mais pas du tout grasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891402
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891402,
					"content": "L'extrait de menthe dans l'assaisonnement apporte une sensation de fraîcheur, ce qui en fait un plat idéal après une journée passée à s'amuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891403,
					"content": "Mais si vous voulez mon avis, je dirais que les artisans auront davantage besoin de ce plat que les visiteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891404
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891404,
					"content": "Les artisans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891405,
					"content": "Vous avez sans doute remarqué que la construction du parc n'est pas terminée. Une portion de ces côtes levées au barbecue devraient revigorer en un clin d'œil vos artisans, ce qui accélérera grandement l'avancée des travaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891406,
					"content": "Puisque vous les employez, c'est à vous de les nourrir. Pourquoi ne pas les inviter à déjeuner ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891407,
					"content": "Qui sait, cela pourrait également leur remonter le moral et améliorer leur productivité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891408
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891408,
					"content": "Ah, je me souviens que vous aviez aussi proposé des poisson-frites revisités aux porteurs du Fleuve cendré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891409,
					"content": "Les jours qui ont suivi, les ouvriers étaient incroyablement efficaces. Ils parvenaient à terminer huit heures de travail en seulement cinq, puis revenaient gonflés à bloc le lendemain puisqu'ils avaient pu terminer plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891410,
					"content": "Il n'y a pas de temps à perdre. Invitez les artisans à venir déguster ces côtes tant qu'elles sont chaudes. Je vais préparer quelques accompagnements et des desserts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891411
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891411,
					"content": "Excellent ! Escoffier, vous êtes vraiment à la hauteur de votre réputation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891412,
					"content": "On dirait que ces plats thématiques joueront un rôle central ! Nous viendrons régulièrement pour vous voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891413,
					"content": "Navia et vous invitez les artisans à déguster ce festin de côtes levées au barbecue revisitées...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
