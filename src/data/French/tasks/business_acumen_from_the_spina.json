			"dialogs": [
				{
					"id": 401890601,
					"content": "Vous avez l'air encore plus enthousiastes qu'avant... On dirait que le premier essai vous a plu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890602,
						401890603
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890602,
					"content": "Le format de défi est très chouette !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				},
				{
					"id": 401890604,
					"content": "Je n'ai pas vu beaucoup de films, mais après avoir essayé ce jeu, je pourrais bien... devenir accro ! On devrait regarder le film sur lequel il est basé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890605,
					"content": "C'est génial, Paimon ! Vous comprenez désormais ce qui motive ces passionnés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890606
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890606,
					"content": "Susciter la curiosité des visiteurs pour les films qui ont inspiré ces attractions, c'est exactement ce que recherchent nos amis les passionnés ! Ils seront ravis de l'apprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890607,
					"content": "Ils seront même prêts à payer davantage de leur poche dans la mesure où leurs dépenses le permettent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890608,
					"content": "De leur poche ? Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890609,
					"content": "Vraiment ! La Spina di Rosula ne s'occupe que des matériaux de construction de base et des frais de locations des stands. De nombreux enthousiastes ont financé personnellement le matériel promotionnel et les produits dérivés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890610
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890610,
					"content": "La location des étals n'est pas leur dépense principale. Certains ont déjà commencé à concevoir des produits dérivés inspirés des personnages des films.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890611
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890611,
					"content": "Prenez la mascotte de cette édition par exemple, la surintendante Chevalmarin. Elle a remporté la deuxième place du dernier concours de popularité dans la catégorie comédie, et a reçu le titre de « Quintessence de la mignonnerie ronde et rebondie ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890612
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890612,
					"content": "Nombreux sont ceux qui ont exprimé leur intérêt quant à la conception d'oreillers à son effigie, en utilisant les tissus les plus raffinés et en faisant appel aux artisans les plus qualifiés pour les produire en masse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890613
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890613,
					"content": "Ces oreillers seront mis officiellement en vente lors de la prochaine convention. Il y aura également beaucoup d'autres produits similaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890614,
						401890616
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890614,
					"content": "Maintenant que vous le dites, j'aimerais bien en avoir un aussi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890615
					]
				},
				{
					"id": 401890615,
					"content": "C'est super, non ? De plus, en tant que responsable des droits à l'image et tutrice de la surintendante Chevalmarin, Furina recevra 60 % des bénéfices des ventes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890618,
					"content": "Après tout, ces amateurs font ça de manière bénévole et non dans un but lucratif. Ils souhaitent simplement promouvoir l'adorable image de la surintendante Chevalmarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890619
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890619,
					"content": "Plus Furina aura de moras, plus la surintendante Chevalmarin pourra manger de bonnes choses. Tout le monde sera content !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890620
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890620,
					"content": "Héhé, ça me parle ! Tout le monde travaille dur par passion, sans se soucier du profit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890621,
					"content": "Malgré tout, on ne peut pas complètement ignorer la question des moras. Qu'il s'agisse de créations de passionnés ou de projets commerciaux officiels, maintenir un certain équilibre financier est nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890622
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890622,
					"content": "Cela s'applique également au Parc cinématographique de Chevalmarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890623
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890623,
					"content": "Dès que nous aurons terminé les guides de stratégie standard, nous pourrons ouvrir les portes au public. Cependant, nous ne pourrons pas nous charger nous-mêmes de la billetterie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890624
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890624,
					"content": "Il y a encore du pain sur la planche pour les différents étals et la construction du parc. Nous devons assigner des employés dédiés à la maintenance et à la gestion de chaque attraction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890625
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890625,
					"content": "Il y a une section dédiée au recrutement sur le tableau d'affichage du parc. Beaucoup de personnes ont déjà postulé, elles ont toutes leurs points forts. Nous devons associer les meilleurs candidats à chaque attraction en fonction des besoins du projet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890626
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890626,
					"content": "#Une fois que les tâches seront assignées, le personnel assurera le fonctionnement des attractions, garantissant ainsi un flux de revenus continu{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890627
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890627,
					"content": "#Euh ? On vient soudainement de passer de {M#testeurs}{F#testeuses} à {M#recruteurs}{F#recruteuses} ? Ça ne nous est jamais arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890628,
						401890629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890628,
					"content": "Mes exigences sont élevées en matière de CV.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890630,
					"content": "Tu ne peux pas te présenter comme le modèle à suivre et attendre que tout le monde soit aussi capable que toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890631,
					"content": "Allez, examinons les CV ! J'espère qu'on trouvera des pépites rares !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890629,
					"content": "#Je ferais {M#un super patron}{F#une super patronne}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890616,
					"content": "Furina ne devrait-elle pas recevoir une part importante ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890617
					]
				},
				{
					"id": 401890617,
					"content": "Ne vous inquiétez pas, en tant que responsable des droits à l'image et tutrice de la surintendante Chevalmarin, Furina recevra 60 % des bénéfices des ventes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890603,
					"content": "Il s'inscrit parfaitement dans le thème du cinéma !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				}
			]
		},
