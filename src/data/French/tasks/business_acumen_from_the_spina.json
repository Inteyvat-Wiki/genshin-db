				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "#{M#Cher}{F#Chère} partenaire et Paimon, il est temps d'entrer dans le vif du sujet, le Parc cinématographique de Chevalmarin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Comme je l'ai dit, cette édition est à l'origine d'une initiative de passionnés. La Spina di Rosula s'occupe de la planification, de la construction et de la gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Bien entendu, ces passionnés ne sont pas des professionnels polyvalents. Ils ne s'occupent en général que de concevoir les étals pour l'événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Notre rôle est d'élaborer un plan de gestion à long terme et de décider des guides de stratégie standard à suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Un plan de gestion... à long terme... Ça a l'air compliqué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "Mais nous passons la plupart de notre temps à partir à l'aventure ! En plus, on n'a jamais géré notre propre stand. Tu penses vraiment qu'on peut s'en sortir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "Tous les patrons ne sont pas diplômés d'écoles de commerce !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "Voilà ce que je veux entendre ! Vous en avez vu de toutes les couleurs, pas vrai ? Je dirais même que vous avez eu un impact sur certaines des plus grosses entreprises en Teyvat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "Bref ! Tout d'abord, jetons un œil aux bases de la gestion du parc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Je crois que j'ai plus ou moins compris. {NICKNAME}, qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Haha, c'est dans mes cordes !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Oui ! Faisons de notre mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "Vous avez parlé de guides de stratégie standard... Ça veut dire qu'il y en a d'autres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Bien sûr ! Chacun a sa propre vision du cinéma et du divertissement, il y aura donc une série d'activités variées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Certains visiteurs pourraient s'éloigner et se retrouver en dehors du lieu de l'événement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "D'autres pourraient ramasser par erreur des accessoires dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Pour éviter toute confusion, nous devons créer un guide de stratégie standard pour chaque activité. Un peu comme une sorte de marche à suivre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "Je vois, vous voulez que je fasse office de cobaye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Maintenant que vous le dites, toutes sortes de situations inattendues pourraient bien se produire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "En cas de difficulté, on devra compter sur nos compétences pour s'en tirer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "#Bien sûr, je ne souhaite pas vous mettre en danger, {M#chers}{F#chères} partenaires. J'ai soigneusement vérifié toutes les installations avant votre arrivée. Je vous assure qu'il n'y aura aucun risque de sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "#Je voudrais également que vous soyez les {M#premiers}{F#premières} à découvrir les attractions. Nous aimerions connaître vos avis et vos suggestions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "Haha, Navia, on peut toujours compter sur vous pour s'amuser en toute sécurité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "J'ai hâte d'entendre ce que vous en pensez ! Votre avis compte énormément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "Très bien, commençons par les Frasques éclectiques et élaborons notre premier guide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "Je comprends, vous voulez que je vous serve de référence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Ouah... J'imagine qu'on apprendra sur le tas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "On a aussi conclu pas mal d'affaires nous-mêmes !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
