			"dialogs": [
				{
					"id": 401891101,
					"content": "Hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891102
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891102,
					"content": "Ce restaurant est très bien, l'atmosphère des repas au bord de l'eau est tout à fait particulière. Les reflets des scènes à la surface permettent d'éveiller la sensibilité des clients, ce qui les rend plus réceptifs aux mets qu'ils dégustent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891103,
					"content": "Les ingrédients sont prêts, les ustensiles également. Il n'y a plus qu'à se mettre au travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891104,
					"content": "Bonjour, Escoffier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891105,
					"content": "#Tiens, voilà mes {M#employeurs}{F#employeuses}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891106,
					"content": "#La présidente de la Spina di Rosula ainsi que les célèbres {NICKNAME} et Paimon... Vous semblez un peu trop {M#qualifiés}{F#qualifiées} pour vous occuper d'un parc d'attractions sur le thème du cinéma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891107,
					"content": "Je dirais plutôt que la plus surqualifiée serait sans doute l'ancienne cheffe de l'Hôtel Debord ? Où que vous alliez, les arômes de la cuisine raffinée vous suivent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891108,
					"content": "Ahem... Revenons-en à notre affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891109,
					"content": "#J'imagine que vous souhaitez laisser {NICKNAME} décider du plat thématique pour chaque cycle, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891110,
					"content": "Un plat thématique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "C'est la stratégie commerciale dont je parlais. Nous allons utiliser la cuisine d'une cheffe renommée pour attirer davantage de clients dans le Parc cinématographique de Chevalmarin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891112,
					"content": "Il ne s'agit pas seulement d'attirer les visiteurs. Je suis certaine que les chefs-d'œuvre d'Escoffier produiront d'autres résultats surprenants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891113,
					"content": "Pensez-y, Paimon. S'il vous suffisait d'un simple billet d'entrée pour profiter de toutes ces attractions et goûter à tous ces mets légendaires... Ne seriez-vous pas tentée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891114,
					"content": "A—Absolument ! Je viendrai tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891115,
					"content": "Est-ce qu'il a des cartes annuelles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "Cependant, si nous rendons le menu public, ce sera moitié moins efficace pour attirer les clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891118,
					"content": "D'après les résultats de recherche d'un consultant en gastronomie, de nombreux restaurants proposent aujourd'hui une « surprise du chef ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891119,
					"content": "Vous n'aurez qu'à me donner de l'inspiration lors des différents cycles opérationnels, et je déciderai de notre prochain plat thématique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891120,
					"content": "Donnez-moi votre main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891121,
					"content": "Ma main ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "Je ressens quelque chose de chaleureux et énergique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891124,
					"content": "Vos mains sont calleuses à force de manier l'épée, mais elles restent délicates. Lorsque vous en saisissez la poignée, c'est comme si vous teniez l'archet d'un violon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891125,
					"content": "Une épée, hmm... Je vois. Le thème cette fois-ci sera la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891126,
					"content": "Voyons à présent comment cette force se manifestera en cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891122,
					"content": "Je ne savais pas qu'on pouvait transmettre l'inspiration par le toucher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "Je trouverai un moyen de vivre dans le parc !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
