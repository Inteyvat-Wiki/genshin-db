					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031501,
					"content": "Je me demande si les Brutocollinus apprécieront ce que j'ai écrit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Pourquoi écrire un poème en... langue Brutocollinus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Ah... Pour être franche, je ne maîtrise pas encore la langue. La grammaire, la syntaxe et comment les phrases s'organisent entre elles... Il me reste encore pas mal de choses à approfondir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "J'y ai mis tous mes efforts, mais qui sait si les Brutocollinus ne vont pas trouver ça de mauvais goût ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Il suffit qu'un mot diffère un tout petit peu pour que la phrase prenne un tout autre sens... Et sans essayer de communiquer avec les Brutocollinus je n'y arriverai jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Enfin... Beaucoup de gens ne comprennent pas qu'on veuille étudier ce langage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Mais... Je ne vois pas d'autre moyen de mieux les comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "Et puis, je me dis que c'est tout de même difficile de faire mieux que la poésie pour se faire comprendre par les monstres des environs de Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "À propos de tes indications...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "Ah, les passages que je t'ai marqués. Comment dire... Les termes que j'ai utilisés sont tous utilisés à l'écrit, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Même si j'ai fait de mon mieux pour respecter la façon de les utiliser dans une phrase, et que j'ai sué sang et eau pour écrire quelques phrases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "La langue n'en demeure pas moins vraiment compliquée, tu sais... Il suffit de mal placer un seul terme pour que son sens change – quand ce n'est pas le sens de la phrase entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Ces quelques phrases sont ce que je peux faire de mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "Il y a aussi quelques vers que je serais bien incapable de traduire... Ça je ne te les montrerai pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Contente-toi de suivre les phrases marquées, ça devrait suffire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Enfin, ça reste du « à peu près » hein. L'idée derrière a beau être de communiquer harmonieusement avec les Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "S'ils comprennent autre chose, ils ne pourront pas le dire ; imagine qu'ils m'attaquent, je serais incapable de me défendre et pas d'autre choix que fuir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "C'est pour ça que je m'adresse à toi, héhé... Rassure-toi, tant que tu colles aux indications, ça devrait bien se passer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Ça devrait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
