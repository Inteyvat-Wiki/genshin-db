			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "Tiens, c'est encore toi ! Tu te souviens de moi ? Tu te rappelles au moins de notre dernier échange amical avec les Brutocollinus, j'en suis sûre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Pas la peine de me regarder comme ça... L'étude d'une langue demande beaucoup de pratique, tu sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Mais ne t'inquiète pas : tes efforts n'auront pas été vains, et mon Brutocollinus s'est sacrément amélioré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Enfin... Pour ce qui est de l'oral. L'écrit compte aussi, et c'est pour ça qu'après pas mal de recherches, j'ai composé moi-même un poème entièrement en langue Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Enfin, hum... Il y a quelques passages dont je ne suis pas sûre à cent pour cent. Ça te dirait de creuser la question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "« Creuser la question » voulant dire...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Euh, les déclamer aux Brutocollinus et voir comment ils réagissent à la poésie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Mais n'aie pas peur ! Regarde, pour que ce soit plus pratique, je t'ai <color=#00E1FFFF>marqué</color> les passages qui posent problème. Il ne devrait pas y avoir de trop grosse différence de sens de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "J'ai déjà choisi un groupe de Brutocollinus pour toi ; ils ont l'air d'assez bonne composition. Il te suffit de leur lire ces quelques lignes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Merci hein ! Et n'oublie pas de revenir me voir quand tu auras fini !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "... Parce qu'il faut ENCORE aller faire la lecture aux Brutocollinus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Voilà ! Tu vois, tu connais déjà bien le truc ! Et puis, je t'ai <color=#00E1FFFF>marqué</color> les passages à problème, même s'il n'y ne devrait pas y avoir de trop grosse différence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "J'ai déjà choisi un groupe de Brutocollinus pour toi ; ils ont l'air d'assez bonne composition. Il te suffit de leur lire ces quelques lignes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Merci hein ! Et n'oublie pas de revenir me voir quand tu auras fini !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "Je suis sûre que tu sauras te débrouiller si jamais quelque chose d'imprévu arrive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
