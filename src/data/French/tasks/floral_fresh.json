			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Ces fleurs aussi ont flétri, quel dommage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "Que se passe-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Il y a souvent des clients qui n'achètent qu'une seule fleur pour offrir, donc j'en coupe plusieurs chaque jour à cet effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Mais les fleurs coupées ne durent pas longtemps... Si je ne peux pas les vendre le jour même, elles se fanent rapidement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "J'ai tout essayé, mais la plupart des fleurs ont vraiment mauvaise mine après une journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Si seulement il y avait un moyen de préserver les fleurs plus longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Il faudrait faire comme avec la nourriture...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "J'ai entendu dire que Sara, du Bon Chasseur, conservait les ingrédients inutilisés dans un endroit frais, ou les congelait parfois avec de la glace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "J'ai déjà essayé de faire comme ça... Mais quoi que je fasse, les fleurs deviennent toutes bizarres si elles sont placées directement dans la glace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Elles ne sont pas vraiment fanées... Mais elles ne restent pas non plus fraîches. En gros, elles ne sont plus belles à voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "J'ai demandé à plein de gens, et à Sayid... Tu le connais, non ? C'est un savant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Il m'a parlé d'une méthode de « réfrigération des fleurs » qu'il avait lue dans un livre un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Plus précisément... Il faut mettre les fleurs dans un récipient, puis placer ce dernier près de la glace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Il a ajouté ensuite que pour tester cette théorie, l'environnement glacial des Monts Dosdragon serait parfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Mais il paraît que ces montagnes sont très dangereuses, et je n'ai pas encore trouvé d'aventurier prêt à m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourrais-tu enterrer ces trois boîtes de fleurs dans les Monts Dosdragon pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Merci d'accepter de m'aider ! Voyons voir... Les Monts Dosdragon sont vastes et divisés en plusieurs zones... Donc, les effets de préservation doivent également différer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Bon, il vaut mieux comparer dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Aide-moi à enterrer ces fleurs dans les Monts Dosdragon : <color=#00E1FFFF>en dessous d'une Statue des Sept</color>, au <color=#00E1FFFF>bord d'une étendue d'eau</color> et aussi... à l'<color=#00E1FFFF>entrée d'une grotte</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Où faut-il les enterrer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Ce serait bien de pouvoir tout vendre le jour même...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Bien sûr ! Ça serait parfait. Mais il reste toujours une ou deux fleurs que personne n'achète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "C'est pas grand-chose, mais ça me fend le cœur de les perdre comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
