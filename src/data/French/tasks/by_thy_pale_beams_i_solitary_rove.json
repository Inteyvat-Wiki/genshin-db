				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "Comment... Même les appâts de mon père n'ont pas fonctionné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620302,
					"content": "Ne soyez pas triste, c'est de la faute de ce Gardien des ruines ! Il a dû effrayer le léviathan lunaire ! Essayons encore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620303,
					"content": "Oui, réessayons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620306,
					"content": "Arrêtons-nous-en là. Je me sens un peu fatiguée... Et si Nantuck avait raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620307,
					"content": "*soupir* ... Je vais aller me promener histoire de me calmer et de réfléchir à la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620308,
					"content": "Voici une récompense pour vous. Quoi qu'il en soit, vous m'avez énormément aidée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620309,
					"content": "On dirait que Momiji a besoin d'être seule, revenons la voir plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
