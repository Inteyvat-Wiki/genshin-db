			"trigger": {
				"objectNames": [
					"Kujirai Momiji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "Venez voir ! J'ai feuilleté le journal de bord de mon père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620102,
					"content": "Il y a une annexe qui parle de la formule d'un appât spécial qu'il a inventé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620103,
					"content": "Lorsqu'il a vu le léviathan lunaire, il a utilisé un mélange d'herbe marine et de minerai de cristal magique pour l'attirer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620104,
					"content": "On pourrait en faire de même si on en fabrique nous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620105,
					"content": "Les herbes marines, c'est pas ce qui manque ici, mais le minerai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620106,
					"content": "Pas d'inquiétude, j'en ai sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "Ah bon ? Vous l'avez obtenu à Araumi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620108,
					"content": "Mon père mentionne dans son journal que le minerai de cristal magique doit être collecté dans les ruines d'Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620109,
					"content": "Je ne comprends pas en quoi c'est différent du minerai de cristal magique ordinaire, mais puisqu'on a décidé de le faire, suivons les notes à la lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620110,
					"content": "Ça me revient, mais il y a beaucoup de monstres à Araumi. C'est un endroit dangereux. Demandons de l'aide à la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620111,
					"content": "Pas besoin, je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "#Ah oui, j'oubliais que vous étiez {M#un grand aventurier}{F#une grande aventurière} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620113,
					"content": "Je suis chanceuse de pouvoir compter sur vous ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620114,
					"content": "Je vais chercher des outils pour fabriquer les appâts. Je vous retrouve plus tard sur la côte ouest d'Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
