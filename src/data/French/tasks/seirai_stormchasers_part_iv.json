			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "La tempête... s'est calmée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580102,
					"content": "On dirait que les quatre pierres de protection ont été scellées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580103,
					"content": "En effet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "C—C'est toi ? Comment tu as fait pour arriver là-haut ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580105,
					"content": "#Taisuke a dit que tu étais {M#passé}{F#passée} par une sorte de porte et que tu avais disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580106,
					"content": "Qu'est-ce que c'était cette porte ? C'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580107,
					"content": "Qu'est-ce qui s'est passé là-haut ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580108,
					"content": "Etsuko et moi, on a entendu un grondement soudain, presque comme le tonnerre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580109,
					"content": "Mais la tempête aurait déjà dû se calmer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580110,
					"content": "Eh bien, voilà ce qui s'est passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Des roches qui flottent dans le ciel... et qui forment une plateforme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580112,
					"content": "Hein. C'est... Je dois avouer que c'est un phénomène assez surnaturel pour l'Île de Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580113,
					"content": "... En même temps, est-ce qu'il y a quoi que ce soit qui te semble naturel dans tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580114,
					"content": "C'est assez surnaturel dans l'ensemble, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580115,
					"content": "Je suis d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Bon, naturelle ou pas, la tempête s'est calmée et on a terminé notre mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580118,
					"content": "On a aussi trouvé cette plume étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "Eh bien, c'est... Taisuke, regarde, toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580120,
					"content": "Voyons cela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580121,
					"content": "Je suis désolé, mais je n'ai aucune idée d'où peut venir cette plume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580122,
					"content": "Les couleurs et la texture de cette plume ne ressemblent en rien aux oiseaux que je connais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580123,
					"content": "Et si on étudie ses dimensions et leurs rapports avec la taille, cet oiseau aurait été aussi grand que cette plateforme de pierre là-haut dans le ciel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580124,
					"content": "Cette plume est si importante que ça ? Si tu veux savoir d'où elle vient, pourquoi ne pas poster une mission à la Guilde ? Qui sait, tu rencontreras peut-être quelqu'un qui pourra t'éclairer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580125,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "#Eh bien, dans ce cas, merci encore pour ton aide, {M#aventurier}{F#aventurière}. Taisuke et moi devons retourner à la Guilde pour faire notre rapport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580128,
					"content": "Ah, oui. Voilà pour toi. Ce n'est pas grand-chose... Mais je pense que tu mérites une récompense pour ton aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580129,
					"content": "Taisuke, prépare-toi à faire tes bagages. On retourne à la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580130,
					"content": "Euh, Etsuko... On peut d'abord aller voir ce sanctuaire pour rendre visite à madame Neko, tu veux bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580131,
					"content": "... Taisuke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580132,
					"content": "Attends ! C'est un chat qui peut parler ! Un chat qui parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580133,
					"content": "*soupir* Vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580126,
					"content": "Je vais y réfléchir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "Je pense que vous avez raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}