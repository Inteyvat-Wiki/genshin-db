				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aranaga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "#Le Festival Utsava... Ça me rend nostalgique... Tiens ? C'est {M#le nara doré}{F#la nara dorée} et Blanche-volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "#Tiens donc, c'est l'{M#ami narien}{F#amie narienne} et l'amie de l'{M#ami narien}{F#amie narienne} ! J'espère que vous passerez un bon Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "#L'ami d'un ami est aussi un ami ! {M#Nara doré}{F#Nara dorée} et Blanche-volante sont les {M#amis}{F#amies} d'Aragaru !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		}
	]
