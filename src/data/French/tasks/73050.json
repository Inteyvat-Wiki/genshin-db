			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} et Paimon ! Ne vous inquiétez pas. Les méchants qui rendaient la vana malade sont partis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Nara {NICKNAME} et Paimon, merci d'avoir aidé Ararycan à protéger la vana. Ararycan a une fleur pour nara {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "#Prenez cette fleur, {M#amis}{F#amies} d'Ararycan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7305003,
			"completionStepIds": [
				7305003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
