						730091103
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#Je me souviens combien {M#elle}{F#il} manquait aux aranaras de l'époque et à quel point ils aimaient ses histoires. Mais maintenant que tu es ici avec nous, nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
