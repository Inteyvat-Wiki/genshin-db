			"dialogs": [
				{
					"id": 730090301,
					"content": "(Rana dort toujours. Arana n'est pas là.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090302,
					"content": "(Une vague image apparaît sur la « bulle » enveloppant Rana.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090303,
					"content": "(Vous vous laissez emporter par cette image...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "Vous êtes au milieu d'une forêt où tout paraît immense et profond. En revanche, vous vous y sentez parfaitement à l'aise.\\nLe soleil rayonne à travers les feuilles et des mauvaises herbes aussi grandes que vous chuchotent et rient, vous touchant doucement la main lorsque vous passez devant elles.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "En écoutant le bourdonnement des arbres et la musique du ruissellement de l'eau, vous entendez un cri d'inquiétude. En cherchant sa provenance, vous trouvez une petite personne.\\nIl semble qu'elle se soit endormie dans la prairie, fatiguée d'avoir tant pleuré. Vous allez à ses côtés et entonnez doucement le chant qui calme les esprits...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "(... L'état de Rana ne semble pas s'être aggravé.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090307,
					"content": "(Partons sans faire de bruit.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
