			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana va s'occuper d'elle. Parce qu'elle est l'amie la plus importante d'Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, dirige-toi vers Vanarana, chante la mélodie du grand rêve. Ensuite, demande-leur de préparer le bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Je comprends rien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Tout comme les nuages qui comprennent qu'il faut laisser tomber les gouttes de pluie et les gouttes de pluie qui comprennent qu'il faut entrer dans la terre. La graine comprend qu'elle doit grandir, devenir un grand arbre et produire beaucoup de fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "Je... Je vois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, Arana voit que tu n'as pas compris. C'est pas grave. Quand l'heure sera venue, tu comprendras ce qu'il faut faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
