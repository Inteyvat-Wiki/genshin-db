			"dialogs": [
				{
					"id": 730091001,
					"content": "Parlez-moi des fruits vasomas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "C'est un fruit rempli d'énergie. Il pousse en absorbant les souvenirs et les rêves de la terre, et ce n'est que grâce aux efforts des aranaras et des naras qu'il peut porter des fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091003,
