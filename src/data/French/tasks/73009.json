			"dialogs": [
				{
					"id": 730091101,
					"content": "À propos de l'aranyaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#C'est ce que nara Varuna a laissé. C'était {M#une nara dorée}{F#un nara doré}, aussi {M#gentille, courageuse et droite}{F#gentil, courageux et droit} que vous.",
					"roleType": "TALK_ROLE_NPC",
