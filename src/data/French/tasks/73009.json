					"Araja"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#C'est grâce à nara {NICKNAME} et Paimon qu'on peut fêter le Festival Utsava. Merci à vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "C'est dommage... Je n'ai pas pu me joindre à ton aventure comme l'ont fait Arama et les autres. Je n'ai pas pu vous aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "#Ceci dit, si jamais tes aventures t'épuisent trop, viens à Vanarana. Tu seras toujours {F#la bienvenue}{M#le bienvenu} dans ce rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
