					"Horripicière"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Je suis ici pour vous défier, gang Arataki !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Horripicière"
				},
				{
					"id": 727320102,
					"content": "Quoi encore ? Le Grand Maître Hanakado nous envoie encore une gamine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320103,
					"content": "Il n'a trouvé personne d'autre ou quoi ? Faut le faire pour en arriver là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320104,
					"content": "... Tu ne m'intéresses pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Horripicière"
				},
				{
					"id": 727320105,
					"content": "Ceux qui ont la tête creuse font souvent le plus de bruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Horripicière"
				},
				{
					"id": 727320106,
					"content": "#Contrairement à toi, cette personne aux cheveux blonds a l'air très forte. Ce doit être {M#lui}{F#elle}, {M#le vrai chef}{F#la vraie cheffe} du gang Arataki, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Horripicière"
				},
				{
					"id": 727320107,
					"content": "#Hahaha ! Elle sait de quoi elle parle ! {NICKNAME} mérite plus de compliments{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320108,
					"content": "Hé ! Qu'est-ce que vous racontez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320109,
					"content": "#Mon {M#ami est fort}{F#amie est forte}, mais {M#il}{F#elle} est seulement là pour aider le gang et son véritable chef : moi, Arataki Itto !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320110,
					"content": "#Est-ce qu'on ajoute le mot «{NON_BREAK_SPACE}temporaire{NON_BREAK_SPACE}» à mon titre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "C'est une bonne idée ! Le gang Arataki n'est pas le plus fort du monde, mais c'est cool d'être chef !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320113,
					"content": "Si ça te va, je pourrais être « Paimon, membre temporaire du gang Arataki » ou « Paimon, cheffe temporaire du gang Arataki » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320114,
					"content": "Hé, ne tombez pas dans le jeu de votre adversaire, vous deux ! Elle est en train... d—de semer la zizanie et de nous monter les uns contre les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320115,
					"content": "Attendez que j'écrase son patron ! Elle me suppliera de la laisser ravaler ses mots !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320116,
					"content": "Arrête de te donner de l'importance. Les affaires internes du gang Arataki ne m'intéressent pas, je veux seulement affronter des adversaires qui en valent la peine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Horripicière"
				},
				{
					"id": 727320117,
					"content": "#Voyons de quel bois tu te chauffes, {M#le blondinet}{F#la blondinette} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Horripicière"
				},
				{
					"id": 727320111,
					"content": "#Tu ne pouvais pas me laisser être {M#le chef}{F#la cheffe} pour quelques jours ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}