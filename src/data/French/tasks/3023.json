				"points": []
			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "Si je peux faire quelque chose pour vous, dites-le-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "J'ai beau ne pas pouvoir quitter le Village d'Aaru, j'ignore pourquoi, quand je vous vois... mon cœur se met à battre la chamade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "Quand je me battais seule autrefois, je n'ai jamais été aussi excitée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "Je pense que c'est sans doute le pouvoir de la camaraderie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
