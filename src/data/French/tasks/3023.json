			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Ne vous inquiétez pas. Il est impossible de se préparer aussi vite pour quelque chose d'aussi important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Prenons le temps de réfléchir pour nous assurer que le plan soit fiable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "À peine avez-vous dit ça que vous vous remettez à relire votre livre ! Vous êtes incorrigible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Vous voulez que je vous prête un livre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "Non, vos livres ne sont pas faits pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Je plaisantais. C'est vrai qu'ils ne vous conviendraient pas, et puis je ne les prête pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Grrr ! Il m'énerve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
