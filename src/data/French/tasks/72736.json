			"dialogs": [
				{
					"id": 727360101,
					"content": "Excellent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727360102,
					"content": "Je ne m'attendais pas à ce que le gang Arataki batte autant de mes subordonnés. Vous semblez vous y connaître en combats de scarabées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727360103,
					"content": "Je retire ce que j'ai dit. Vous êtes des adversaires dignes et respectables. C'est pour cette raison que je vais vous affronter avec tout ce que j'ai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 727360104,
					"content": "Allez, vacheron ! C'est à ton tour d'entrer en scène !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "Et ne prends pas au sérieux ce qui a été dit tout à l'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "Allez, l'Authentique Roi oni des scarabées de combat !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Hahahahahaha ! Tant mieux ! Mais c'est moi qui sortirai vainqueur de cette bataille ultime !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Je ne sais pas comment tu as entraîné tes larbins, mais les résultats parlent d'eux-mêmes ! Le gang Arataki gère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Gare à tes fesses, Grand Maître Hanakado !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "Roi VS Grand Maître !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
