			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "J'espère qu'un poisson mordra à l'hameçon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040102,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "Je pêche. J'attends qu'un gros poisson morde à l'hameçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040104,
					"content": "Comme mon seul ami est cuisinier, je me suis dit que ça lui ferait plaisir que je lui attrape un gros poisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040105,
					"content": "Le problème est que les monstres effraient les poissons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040106,
					"content": "Je sens un puissant pouvoir élémentaire en vous. Pourriez-vous vous occuper de ces monstres pour moi, s'il vous plaît ? J'aimerais attraper ce poisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040107,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040112,
					"content": "Mais comment savez-vous que ces monstres viendront ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040113,
					"content": "Il n'y a qu'à regarder derrière vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040114,
					"content": "Derrière nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040109,
					"content": "Comment vous savez ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "J'étais un détenteur d'œil divin. Je ne l'utilise plus, mais je peux encore sentir les éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040111,
					"content": "Avec ces pouvoirs, vous pourrez vous débarrasser d'eux sans aucun problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "Vous l'avez vaincu ?! On ne vous a pas vu bouger pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "Qui êtes-vous exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Je ne suis qu'un simple pêcheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Ça ne colle pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Vous avez raison. Il y a beaucoup de choses qui ne collent pas dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "Yanxiao, le cuisinier de l'auberge, était un épéiste avant de travailler là. Il fait le dur, mais il a un cœur en or.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "La patronne se dit originaire de Mondstadt, mais aucun Mondstadtois qui passe dans le coin ne la connaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "Et puis vous aussi... Vous ne possédez pas d'œil divin, et pourtant vous avez des pouvoirs élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Ces choses arrivent, mais pas de quoi s'affoler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Prenez ça en récompense. Je dois reprendre la pêche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}