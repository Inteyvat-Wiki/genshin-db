					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070401,
					"content": "Bienvenue au Restaurant Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070402,
					"content": "À propos des friandises de Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "Ah, j'ai déjà préparé les friandises que maître Kamaji a commandées. Je vous les apporte tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070404,
					"content": "Mais je suis curieuse de savoir à qui maître Kamaji va les offrir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070405,
					"content": "Ce n'est rien de plus qu'un geste de relations publiques, mademoiselle Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070406,
					"content": "Il y a quelque temps, monsieur Hiiragi Shinsuke a offert à mon père un lot de thé de qualité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070407,
					"content": "Mon père est au courant que la fille adorée de monsieur Hiiragi, Chisato, aime les friandises. Il m'a donc demandé d'en préparer quelques-unes comme cadeau en retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070408,
					"content": "#Je craignais que la livraison ne prenne trop de temps, et qu'il y ait des chocs inévitables pendant le voyage... J'ai donc spécifiquement demandé à {M#ce voyageur}{F#cette voyageuse} de livrer ces friandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070409,
					"content": "Mademoiselle Kiminami, puis-je jeter un œil aux friandises, s'il vous plaît ? Je veux m'assurer que je n'ai rien oublié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070410,
					"content": "Hmm... Bien sûr, voici les friandises. Vous pouvez vérifier par vous-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070411,
					"content": "Merci, mademoiselle Kiminami, tout y est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070412,
					"content": "#Allons-y, {M#voyageur}{F#voyageuse}. J'ai d'autres choses à vous dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070413,
					"content": "Voici le laissez-passer, prenez-le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070414,
					"content": "Avec ce laissez-passer, vous pouvez entrer et sortir librement de Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070415,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "Ce n'est rien. Ce laissez-passer vous permettra de livrer les friandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070417,
					"content": "Et aussi... cette lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070418,
					"content": "C'est vous qui avez écrit cette lettre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "Oui. J'ai essayé d'écrire cette lettre avec... tact. J'espère que mademoiselle Hiiragi ne sera pas offensée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070420,
					"content": "Veuillez remettre cette lettre et les friandises à mademoiselle Hiiragi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070421,
					"content": "Je dois encore y retourner...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "Héhé, mais cette fois-ci, vous avez le laissez-passer. Vous devriez avoir beaucoup plus de liberté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070423,
					"content": "#Alors je compte sur vous, {M#voyageur}{F#voyageuse}. Je dois rentrer pour m'occuper des affaires officielles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070424,
					"content": "Argh, quand pourrais-je lui rendre visite personnellement ?",
					"roleType": "TALK_ROLE_NPC",
