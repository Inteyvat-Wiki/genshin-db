			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#Vous êtes... Ah, vous êtes {M#le voyageur venu}{F#la voyageuse venue} de loin. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "À propos de la lettre d'Hiiragi Chisato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Cette lettre, mademoiselle Hiiragi vous a vraiment demandé de me la remettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Cette écriture... C'est bien elle... Archon merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "#Merci d'être {M#venu}{F#venue}, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Quant au laissez-passer... Comme il s'agit d'une demande personnelle de mademoiselle Hiiragi, je vais naturellement m'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Cependant, j'ai besoin d'un peu de temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Que pensez-vous d'aller m'attendre au Restaurant Kiminami, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Pourquoi voulez-vous aller là-bas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Eh bien... J'ai besoin de vous demander une petite faveur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Je pensais également envoyer quelque chose à mademoiselle Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "J'ai écrit une lettre et j'ai également demandé à mademoiselle Kiminami de me préparer quelques friandises. J'avais l'intention de les envoyer ensemble à mademoiselle Hiiragi en tant que cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "#Mais si mon père découvrait mes plans, il serait contrarié... J'étais justement en train de réfléchir à la manière de procéder quand vous êtes {M#arrivés}{F#arrivées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "C'est seulement un cadeau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Père ne veut pas que je communique avec mademoiselle Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Je comprends ses préoccupations. Après tout, je suis un membre du Clan Kujou et l'un des responsables de la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "Alors que mademoiselle Hiiragi fait partie du Clan Hiiragi de la Commission économique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Si je me rapproche trop d'elle, quelqu'un pourrait essayer de profiter de la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Même s'il ne s'agit que d'un cadeau aux yeux de certaines personnes, c'est bien plus que cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Héhé, ne parlons pas de ces questions triviales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "#{M#Voyageur}{F#Voyageuse}, veuillez m'attendre au Restaurant Kiminami. Je vous y apporterai le laissez-passer quand il aura été approuvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Votre père est-il strict ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Il... Il doit naturellement être strict. Je comprends pourquoi il ne veut pas que je communique avec mademoiselle Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "Après tout, je suis un membre du Clan Kujou et l'un des responsables de la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070323,
					"content": "Alors que mademoiselle Hiiragi fait partie du Clan Hiiragi de la Commission économique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070324,
					"content": "Si je me rapproche trop d'elle, quelqu'un pourrait essayer de profiter de la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070325,
					"content": "Même s'il ne s'agit que d'un cadeau aux yeux de certaines personnes, c'est bien plus que cela.",
					"roleType": "TALK_ROLE_NPC",
