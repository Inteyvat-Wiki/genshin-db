			"dialogs": [
				{
					"id": 728070201,
					"content": "*soupir* Quelle prise de tête... Bonjour, vous avez besoin de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070202,
					"content": "À propos de Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Vous parlez de maître Kamaji ? Que lui voulez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Vous montrez la lettre de Chisato.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Vous dites que cette lettre vient de mademoiselle Hiiragi Chisato ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Si cette lettre vient bien de mademoiselle Hiiragi Chisato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Je pense que... Vous devriez aller parler directement à maître Kamaji. Il était en train de se promener près du pont.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
