					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070501,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070502,
					"content": "Je suppose que vous avez livré ma lettre à Kamaji ? ... Est-ce que vous avez obtenu le laissez-passer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070503,
					"content": "Oui, je l'ai. Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "Vous devriez plutôt remercier Kamaji, pas moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070506,
					"content": "Hé ? Qu'est-ce que c'est ? Des friandises et... une lettre écrite par Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070507,
					"content": "C'est lui qui vous a demandé de m'apporter tout ça ? Il a même fait préparer des dango trois couleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070508,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse} ! Je vais prendre le temps de savourer ces friandises ! Et pour la lettre... Je la lirai attentivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070509,
					"content": "Merci pour votre travail. Veuillez accepter ceci en gage de paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070510,
					"content": "Il se peut... que j'aie besoin de vos services à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070505,
					"content": "Voici des cadeaux de la part de Kamaji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
		{
			"id": 7280706,
			"completionStepIds": [
