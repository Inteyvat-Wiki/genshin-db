			"dialogs": [
				{
					"id": 766740101,
					"content": "Oh, le résultat final a dépassé toutes mes attentes... Si quelqu'un venait à s'égarer ici par mégarde, il serait assurément impressionné par la puissance de cette sorcière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "Si quelqu'un finit vraiment par arriver ici par hasard...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Eh bien, tout dépend de la personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "L'aide peut engendrer de la complaisance et la paresse si l'on n'y fait pas attention. Si cette personne veut réaliser ses souhaits grâce à ses propres capacités, comme vous, alors je l'aiderai volontiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "Mais si elle fait partie de ces gens qui placent tous leurs espoirs dans le pouvoir de la sorcière sans lever le petit doigt... Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "... Q—Qu'est-ce que vous voulez dire par « héhé » ? Vous la transformeriez en statue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "Non, rien de tel. Je l'orienterai plutôt vers le Curatorium des secrets. Je suis sûre que Nefer saura mieux s'en occuper que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Ceux qui veulent récolter sans semer doivent en payer le prix, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "Guideriez-vous cette personne pour qu'elle puisse réaliser ses souhaits ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
