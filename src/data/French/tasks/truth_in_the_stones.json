				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Kun Jun, qu'est-ce que tu regardes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210202,
					"content": "Ah, c'est vous. Vous arrivez au bon moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210203,
					"content": "Tu as trouvé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210204,
					"content": "Il y a un morceau de minerai là qui pourrait contenir des informations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210205,
					"content": "Du minerai ? Quel rapport avec la disparition des types ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210206,
					"content": "On ne le saura qu'en essayant. Un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210209,
					"content": "Il a l'air sacrément concentré... Qu'est-ce qu'il est en train de faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210210,
					"content": "Je vois... Quatre hommes... Qui quittent la mine avec quelqu'un... Un enfant, on dirait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210211,
					"content": "Un enfant ? Qu'est-ce qu'un enfant viendrait faire dans une mine ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210212,
					"content": "Je ne suis pas sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210213,
					"content": "Et puis, comment as-tu « vu » tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210214,
					"content": "Oh, je ne voulais pas dire « voir » au sens traditionnel du terme. Je... J'apprécierais que vous gardiez ce que je vais vous confier pour vous. C'est un secret un peu... particulier, dont je n'ai jamais parlé à quiconque auparavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210215,
					"content": "La vérité est que... je suis capable de percevoir la mémoire du minerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210216,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210217,
					"content": "« Percevoir » ? Aucune conjecture, donc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210218,
					"content": "Il te suffit de mettre la main sur une pierre, et... hop, le tour est joué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210219,
					"content": "J'ai toujours senti que le minerai avait sa propre « mémoire ». Parfois, il s'agit d'événements étant arrivés à proximité. Tout ce que j'ai à faire, c'est toucher la pierre, me concentrer, et les souvenirs affluent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210220,
					"content": "Impressionnant ! Alors tu peux savoir tout sur tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210221,
					"content": "Ça dépend du minerai. Tous les minerais n'ont pas la même mémoire. Certains minerais communs comme le fer et le fer blanc ne renvoient que des images floues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210222,
					"content": "Les cœurs de lapis et les cristaux sont beaucoup plus puissants, et peuvent enregistrer les événements de manière plus détaillée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210223,
					"content": "Voir à travers les pierres... Fascinant. Un talent rare s'il en est. Monsieur Dai a eu le nez creux en vous recrutant, sieur Kun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210224,
					"content": "Haha, je suis heureux de pouvoir aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210225,
					"content": "D'après ce que j'ai vu, ils ont dû suivre ce chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210226,
					"content": "Cela devrait nous mener au nord et nous faire quitter la mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210227,
					"content": "« Partis au nord »... Un autre indice pour oncle Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112103",
							"2"
						],
						"stepId": 1112103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Vous travaillez ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Oui ! Vous êtes ici pour la disparition des autres gars, c'est ça ? Vous devez les retrouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210303,
					"content": "Je... J'ignore ce qui s'est passé. Il faisait un temps couvert ce jour-là, et le contremaître est parti avec quelques mineurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210304,
					"content": "Je suis resté derrière avec les quatre autres, et j'ai euh... pris une petite pause au bout d'un moment. Juste histoire de, hein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210305,
					"content": "Je me suis endormi dans l'abri à l'intérieur. Quand je me suis réveillé, plus signe de personne ! Je leur parlais encore un instant avant, et... plus rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210306,
					"content": "Et... Et si je suis le prochain sur la liste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210307,
					"content": "Ainsi donc, ceux qui travaillaient ont disparu, et il ne reste que celui qui n'était pas au travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Peut-être un accident lié à l'exploitation de la mine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Brrr... Pas rassurant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "« Accident de travail »... Encore une autre piste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Regardez, là ! C'est quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Une pile de vêtements... Des pantalons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Des objets de tous les jours, ils doivent appartenir à monsieur Dai et à ses hommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Un, deux, trois, quatre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Hum... On dirait bien. Dix hauts et dix paires de pantalons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Il doit s'agir de vêtement de rechange, non ? Oncle Dai porte les mêmes, regardez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Les quatre hommes sont donc partis depuis six jours, sans vêtements de rechange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "Il y a aussi quelques serviettes et du savon à côté... Et des ceintures porte-outils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "De quoi se laver le visage... de l'équipement minier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Autrement dit... Ils n'ont pris aucun bagage avec eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "En effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Peut-être qu'ils n'en avaient pas besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Peu probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Il manque quatre pioches. On dirait bien qu'ils sont partis avec leurs outils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Ils avaient le temps de prendre leurs outils, mais pas le temps de prendre d'autres objets courants ? Curieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Euh... Pourquoi partir avec des outils et laisser le reste des bagages derrière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Première possibilité : ils n'allaient pas travailler loin d'ici, et n'avaient pas besoin de leurs autres bagages. Cependant, ils ne sont pas encore rentrés, cela paraît donc assez peu probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Deuxième possibilité : ils ne sont pas partis de leur propre volonté, et n'ont pas eu le temps de penser à leurs bagages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Oh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Vous voulez dire... qu'ils ont été kidnappés ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Disons qu'il s'agit certainement là d'une possibilité. Mais il va nous falloir plus d'indices avant de tirer une conclusion définitive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "« Possiblement forcés de partir par quelqu'un »... Un autre indice pour oncle Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Peut-être qu'ils ont juste oublié ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Ah, vous revoilà. Alors, l'enquête avance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210702,
					"content": "Nous avons trouvé trois pistes dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "D'abord, il manque quatre pioches, mais les objets de tous les jours sont toujours à leur place, ce qui suggère que les hommes ne sont pas partis de leur propre volonté, mais ont été forcés de le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "« Forcés » ? Mais... Qui voudrait kidnapper des mineurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210705,
					"content": "Ensuite, sachez qu'il y avait cinq mineurs présents. L'un d'eux a quitté le site pour prendre une pause. À son réveil, ses collègues avaient tous disparus sans laisser de trace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Tous ceux qui travaillaient se sont évaporés. Celui qui se trouvait dans la zone de repos est le seul à être sain et sauf. On dirait donc que l'accident a eu lieu sur le site.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Maintenant que vous le dites, c'est vrai que Hu avait mentionné avoir pris une pause...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210708,
					"content": "Mais comment quelqu'un aurait-il pu pénétrer dans la mine et les forcer à le suivre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210709,
					"content": "Ceci nous amène justement au troisième indice. Sieur Kun Jun ici présent a... utilisé ses talents d'expert... et est arrivé à la conclusion que les hommes avaient été emmenés par un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Un enfant ?! Mais il n'y a quasiment aucune habitation dans les environs, un enfant n'aurait jamais pu rejoindre la mine aussi facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210711,
					"content": "Aussi bizarre que ça sonne, c'est notre conclusion. Vos hommes suivaient un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Où... Où sont-ils partis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210713,
					"content": "D'après nos déductions, ils ont quitté la mine par le chemin du nord, et se sont dirigés vers les ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Le nord ! Bon, je vais de ce pas rassembler quelques hommes et aller les chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210715,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Vous avez été d'une aide précieuse pour l'enquête, on s'occupe de la suite. Si on se dépêche, on arrivera peut-être à les retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210717,
					"content": "Une minute. Tout ça est arrivé il y a déjà six jours. Quand bien même ils sont partis à pied, ils peuvent maintenant être à des lieues d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "Hum, c'est vrai... Bon, changement de plan. Je vais aller poser des questions aux habitants plus loin avec mes gars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210719,
					"content": "En dehors de la mine, il n'y a que quelques endroits dans les environs pouvant servir d'abri pour la nuit. On s'occupe de cette partie de l'enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210720,
					"content": "Vous pouvez chercher plus d'indices ? Partons chacun de notre côté, et si on ne se revoit pas d'ici là, retrouvons-nous demain matin à l'Auberge Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210721,
					"content": "Excellent plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Bon, alors je rassemble mes gars et on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210723,
					"content": "Bon, alors... Ils vont mener l'enquête auprès des habitants, et nous on continue ici, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "En effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Mais... Il ne reste aucun indice dans la mine... On ne devrait pas plutôt partir vers le nord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Une minute, il nous manque quelqu'un, il me semble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Mais oui, où est Kun Jun ? Encore en train de chercher, à coup sûr. Appelons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
