			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Pfiou, cette mine est gigantesque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "C'est ici qu'a eu lieu l'accident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210103,
					"content": "Il y a six jours, je suis parti avec quelques-un des gars, certaines affaires m'appelaient. À notre retour, les quatre hommes qu'on avait laissés avaient disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210104,
					"content": "J'ai organisé une équipe de recherche, et on a fouillé la mine de fond en comble, sans en trouver une seule trace. C'est là que j'ai décidé d'aller chercher de l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210105,
					"content": "Ainsi donc, quatre mineurs ont disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Oui. Nous étions dix au départ. Les mineurs disparus sont Long, Cen le chauve, Cen le brave, et Mao. Je travaille avec eux tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210107,
					"content": "Les mineurs sont souvent de jeunes hommes en bonne santé, et solides. Est-il possible que ces quatre-là soient partis exploiter une autre mine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Peu probable. On ne trouve pas d'autre hébergement à des lieues à la ronde, et on n'a croisé aucune autre mine en venant ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210109,
					"content": "Hum... La mine est grande. Vous êtes sûr d'avoir tout fouillé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "On a fouillé de fond en comble, vraiment. On a tout essayé, à part creuser. Mais quatre mineurs ne vont pas disparaître comme ça dans le soubassement rocheux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Oncle Dai"
				},
				{
					"id": 111210111,
					"content": "Jetons d'abord un œil avant de tirer des conclusions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Très bien. J'attendrai ici, vous êtes libres de regarder où bon vous semble. Mais n'oubliez pas de me prévenir si vous trouvez un indice !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oncle Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
