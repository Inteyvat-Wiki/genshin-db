				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun ! Qu'est-ce que tu fais encore ici ? On a fait le tour, on doit partir maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Ah, pardon, je faisais des recherches pour mon propre compte. Je suis à la recherche d'une pierre précieuse, la dragonite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Dragonite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Jamais entendu parler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "La dragonite est souvent utilisée pour la forge. Pourquoi donc en cherchez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "Je... Je l'ignore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "Toutes mes excuses, je... Je ne m'en rappelle pas. Tout est confus dans ma tête depuis ces derniers temps. Hormis mon nom et mon adresse, je n'arrive à me rappeler de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "Pour tout dire, tout ça m'angoisse... J'ai comme l'impression d'avoir oublié de finir quelque chose... C'est plutôt déplaisant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Oh, je sais de quoi tu parles ! Savoir qu'on a oublié quelque chose, sans se rappeler quoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "*soupir* Je ne sais même pas où aller, j'ai juste... erré ces derniers temps. L'autre jour au marché quand j'étais en train de faire un achat, j'ai entendu parler de la dragonite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Le mot était si familier, comme si un lien m'unissait à cette pierre... Alors j'ai décidé d'en trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Peut-être qu'une fois la pierre dans les mains, je me rappellerai ce que je devais faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Je vois... Si l'occasion se présente pendant notre voyage, je vous aiderai à en chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Vraiment ? Sieur Zhongli, vous êtes trop gentil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Ce n'est rien, vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Bon, alors on y va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Partir du Gouffre vers le nord nous mènera à la Passe de Lingju. Si c'est bien le chemin qu'ils ont suivi, on devrait pouvoir trouver des traces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "OK, alors c'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Je n'y connais rien dans tout ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
		{
			"id": 1112109,
