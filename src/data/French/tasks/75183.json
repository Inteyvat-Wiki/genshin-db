						751830106
					],
					"speakerTitle": "Ma'chah",
					"speakerSubtitle": "Maître-formateur du Collectif de l'abondance"
				},
				{
					"id": 751830102,
					"content": "#Je suis {M#prêt}{F#prête} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Maître-formateur du Collectif de l'abondance"
				},
				{
