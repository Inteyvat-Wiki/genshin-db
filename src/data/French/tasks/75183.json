			"dialogs": [
				{
					"id": 751830101,
					"content": "Je la sens ! Votre « intensité »... Elle est impressionnante... Extraordinaire, même ! Voulez-vous relever le défi guerrier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
