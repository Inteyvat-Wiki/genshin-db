					"nextDialogs": [],
					"speakerSubtitle": "Maître-formateur du Collectif de l'abondance"
				},
				{
					"id": 751830106,
					"content": "Pourquoi tremblez-vous comme ça ? Avez-vous attrapé froid ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
