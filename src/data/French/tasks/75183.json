					],
					"speakerSubtitle": "Maître-formateur du Collectif de l'abondance"
				},
				{
					"id": 751830107,
					"content": "Moi, attrapé froid ? Pas dut tout. Je ne fais que frissonner d'enthousiasme devant votre « intensité » ! Allez, essayez de battre mon record et de m'arracher le titre de « plus fort du Collectif de l'abondance » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ma'chah",
					"speakerSubtitle": "Maître-formateur du Collectif de l'abondance"
				}
