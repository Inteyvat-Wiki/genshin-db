			"dialogs": [
				{
					"id": 747090101,
					"content": "#Merci pour votre travail, {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "J'ai maintenant une assez bonne compréhension de l'état de nos patients. Je leur ai donc préparé un médicament mélusine spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Ajouter ces herbes dans l'aquarium devrait les apaiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "Vous transformez carrément tout l'aquarium en centre de soins ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "Quand on y réfléchit bien... Il n'y a vraiment que vous qui pourriez imaginer quelque chose de pareil, Sigewinne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "Mais cela ne va-t-il pas juste soulager leurs symptômes temporairement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Vous avez raison. Je vais devoir inviter toute une variété de poissons différents pour des examens physiques avant de pouvoir déterminer exactement ce qui ne va pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "Je vais établir une liste de patients à examiner en fonction des caractéristiques dont j'ai besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "J'apprécierais que vous gardiez un œil attentif sur les poissons qui correspondent à ces critères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
					"content": "Pour les guérir complètement, il faut encore trouver la cause profonde...",
