			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Hmph. Il a vraiment du culot de vivre à mes crochets depuis si longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030102,
					"content": "Qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Moi ? Je fais à manger pour un pique-assiette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030104,
					"content": "C'est un fainéant qui passe ses journées à flaner au lieu de m'aider un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Il part à la pêche tous les jours, mais je n'ai presque jamais vu l'ombre d'un poisson par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030106,
					"content": "Si je n'étais pas là, il serait en train de mourir de faim devant l'auberge !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Bref, passons. Ce n'est pas comme s'il pouvait m'entendre, et de toute façon, je crois qu'il ferait la sourde oreille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Si tu as le temps, tu pourrais aller me chercher des ingrédients ? Il ne m'en reste pas assez pour cuisiner ce plat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030109,
					"content": "Alors, je voudrais <color=#00E1FFFF>un piment de Jueyun</color> et <color=#00E1FFFF>un fruit du lotus</color>, s'il te plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Merci ! Reviens me voir lorsque tu auras tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Cette auberge propose de nombreux plats...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Mon patron paie les ingrédients, et tu crois qu'il a les moyens de rembourser ? J'crois pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Je le nourris de ma poche. Il me doit beaucoup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030115,
					"content": "Bref, vas-y. Il doit t'attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
