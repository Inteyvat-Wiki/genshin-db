				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "Dépêche-toi, sinon qui sait quelle bêtise il fera avec un estomac vide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030402,
					"content": "Pourquoi se donner autant de mal pour lui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Ce gars est un ermite qui ne connaît personne à part moi à Liyue. Il n'y a qu'à moi qu'il ose gratter de la nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030404,
					"content": "... Bon, je l'apprécie quand même. Ça te va comme raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Si je ne le nourrissais pas qui sait quel genre de trucs bizarres il ferait dans ce marais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030406,
					"content": "#Qu'est-ce que tu fais encore {M#planté}{F#plantée} là ? Allez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
