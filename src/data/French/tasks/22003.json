					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Patiente ici, je te donnerai ta part du plat quand j'aurais terminé de le préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030302,
					"content": "Pas la peine de prendre cet air étonné... Tout travail mérite salaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030303,
					"content": "Bien, livre ce repas au pique-assiette maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030304,
					"content": "Il s'appelle <color=#00E1FFFF>Jiangxue</color> et tu devrais le trouver en train de pêcher. Impossible de le rater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
