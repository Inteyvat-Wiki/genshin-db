				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "C'est bon, tu le lui as livré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Oui, il m'a dit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Le connaissant, il a dû te dire de me remercier ou je ne sais quoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Franchement, j'entends ce genre de bêtises à longueur de journée, j'en ai mal aux oreilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030605,
					"content": "S'il a le temps de pêcher ou de dire merci, ce fainéant devrait travailler pour gagner sa croûte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030606,
					"content": "Ah, ça ne sert à rien de m'offusquer de toute façon. Tiens, c'est pour toi. Maintenant, va t'occuper de tes affaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200307,
