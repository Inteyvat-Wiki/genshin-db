				"points": []
			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "Vous êtes encore là ? Vous devriez retourner à l'auberge ou Yanxiao va se fâcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030702,
					"content": "Pourquoi vous donne-t-il à manger ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Disons que nous sommes de vieux amis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Hum... Je suis allé au Marais Dihua un jour et j'y ai fait quelque chose de mauvais, mais que je devais faire à tout prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "C'est le seul endroit où on me laisse tranquille ici, et Yanxiao s'assure que je suis nourri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030706,
					"content": "Bref, je ne vais pas m'attarder dessus. C'est une longue histoire et vous avez sans doute autre chose à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030707,
					"content": "Vous feriez mieux d'y aller. Yanxiao n'est pas très patient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
