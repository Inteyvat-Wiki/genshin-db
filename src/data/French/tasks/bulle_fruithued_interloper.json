			"dialogs": [
				{
					"id": 705400101,
					"content": "*feulement* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Chevalier Orangelot"
				},
				{
					"id": 705400102,
					"content": "... Mademoiselle Rosalia, il a l'air méchant ! J'ai peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Vous feriez mieux de vous éloigner alors, il risque de vous griffer le visage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400104,
					"content": "Qu'est-ce qui se passe ? Valerina se fait embêter par un chat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Voilà un nouveau chat errant qui arrive au refuge...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "Chevalier honoraire ! Chuchoteuse féline ! Boule-de-neige était en train de se promener quand ce gros chat l'a épié et suivi jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Ne sois pas nerveux, personne ne te fera de mal ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400109,
					"content": "Tu es protégé par les remparts de cette cité. Tous les vauriens qui voudront te forcer à faire d'horribles choses resteront à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400110,
					"content": "Tu es entouré de personnes bienveillantes. Même si elles peuvent être agaçantes, elles font tout ça pour ton bien. Alors détends-toi et profite d'une vie tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400111,
					"content": "*feulement* ... *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Chevalier Orangelot"
				},
				{
					"id": 705400112,
					"content": "Le... Le gros chat a compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "On dirait que ça a marché. Ce chat a l'air plutôt malin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400114,
					"content": "Il est énorme comparé aux autres, et il est orange comme un jus de fruits bullés ! En y regardant de plus près, il porte aussi un foulard... Ouah ! Il y a également l'insigne des chevaliers de l'Ordre de Favonius sur celle-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "On peut l'appeler Chevalier Orangelot. Qu'est-ce que vous en dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Chevalier Orangelot"
				},
				{
					"id": 705400117,
					"content": "Vous vous y prenez vraiment bien avec les chats. Il a complètement baissé sa garde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400118,
					"content": "J'ai plutôt l'impression que c'est grâce à vous, Rosalia, que Chevalier Orangelot s'est calmé, après tout ce que vous lui avez dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "Vous avez l'air de l'avoir apprivoisé, Rosalia !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "Cela m'importe peu. Même s'ils sont mignons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 705400122,
					"content": "#Maintenant, {NICKNAME}, utilisons notre magie féline pour faire en sorte que la colère de Chevalier Orangelot se dissipe et qu'il soit content !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Vous avez l'air plus heureuse grâce à ce travail particulier !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Ce chat a un air distingué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
