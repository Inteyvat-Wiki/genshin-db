			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "Je viens d'essayer. C'est conforme à mes attentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420602,
					"content": "N'oubliez pas de rester calme en tout temps et de respirer profondément si vous ne vous sentez pas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420603,
					"content": "Je vais noter tous les résultats et points de données observables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Ça va, {NICKNAME} ? C'est quoi cette tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "On dirait que ça... brûle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "Vous avez dit que vous l'aviez essayée ! Vous êtes sûr que c'était prêt ? Qu'est-ce qu'il lui arrive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Hmm ? Oh, c'est un résultat auquel je m'attendais, et un résultat très positif même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Cette potion canalise l'énergie élémentaire dans le corps. Dans des circonstances normales, une réaction répulsive est à prévoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Mais si le flux élémentaire interne n'est pas entravé, vous ne ressentirez qu'un inconfort momentané. Une fois le flux terminé, les effets s'estompent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Donc, vous saviez que ça rend malade, mais vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Héhé, c'était ma propre concoction après tout, c'est tout naturel que ce soit moi le cobaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Par... considération pour le sujet du test ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "#Mais bien sûr ! Vous êtes mon {M#assistant}{F#assistante}. De toute évidence et de raison, il serait erroné de ma part de vous faire courir ce risque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "#En bref, je dirais que nous avons notre conclusion ! En ce qui concerne l'énergie élémentaire, vous n'êtes pas {M#différent}{F#différente} de quiconque dans ce monde, vraiment rien de particulier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Je voulais qu'il se passe quelque chose de cool...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Mais par contre, mieux vaut un résultat ordinaire qu'un résultat... spécial. Les résultats spéciaux ont tendance à être de qualité... indésirable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Voilà qui est diablement spécifique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "L'avantage de l'ordinaire, c'est que tout est un objet de référence et que tout le monde vous comprend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "Les gens sont les mêmes, ils peuvent se comprendre, compatir, s'encourager et se soutenir les uns les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Lorsque vous êtes malade, un médecin peut vous diagnostiquer parce qu'il est comme vous. Quand quelque chose ne va pas, vous pouvez demander leur expérience aux gens qui ont fait la même erreur, parce que vous êtes comme eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Mais les personnes spéciales... Elles n'ont pas beaucoup de recours pour les choses que nous tenons pour acquises. L'essence de leur vie est fondamentalement différente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Par exemple... Un humain ne peut pas comprendre la vie d'un Arbre enflammé, ou d'un Noyau de tempête. Comprenez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Je pense que je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "Quoi qu'il en soit, l'expérience aura eu un résultat positif. À l'avenir, vous pouvez utiliser votre énergie élémentaire sans crainte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, les résultats de la nouvelle expérimentation sont arrivés. Si vous pouviez les rassembler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Juste un instant, monsieur ! Je m'en occupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Vous m'avez donné beaucoup de choses à considérer, ça a vraiment repoussé mes limites. J'y vois beaucoup plus clair à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Vous considérer comme un animal n'était pas très prudent de ma part, mais commencer par la prémisse d'une forme de vie élémentaire !? Alors là, c'était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Pas mal ! Je pense que c'est une piste intéressante. Quelle que soit la vérité sur le sujet, j'aimerais que vos recherches soient au premier plan, plutôt que mon jugement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Vous pouvez compter sur moi, monsieur ! Je vais en extraire un résultat satisfaisant pour tous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Il va à la guerre ou quoi ? Il a vraiment l'air motivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Euh... Ce que je voulais dire, c'est que... C'est le bon esprit ! Monsieur Albedo... Dites quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Hmm... Avant que nous puissions poursuivre nos recherches, je dois... Préparer quelque chose. Patientez un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "#Si vous êtes {M#intéressés}{F#intéressées}, pourquoi ne pas jeter un œil aux alentours ? Cela peut aider à passer le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Quand même... C'est étonnamment spécifique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "Mais c'est risqué pour vous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "C'est peut-être juste la confiance en soi des chercheurs, et ça accélère bien les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Ça... passe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
