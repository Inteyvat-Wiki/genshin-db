			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "J'ai une question. Une fois que la graine aura germé, est-ce qu'elle deviendra, euh, quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Je ne sais pas, mais je pense que la méthode compte plus que le résultat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Nul doute que pouvoir utiliser l'alchimie pour faire naître une vie d'un autre monde en Teyvat constituerait un grand pas en avant dans ma compréhension de l'essence de la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Après l'éveil, peut-être que même la création sera possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Haha, auriez-vous encore du mal à comprendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "Mais euh... Non ! Je comprends ! Mais qu'est-ce que la graine va devenir ? C'est quand même la question la plus intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Moi, je dis que tu n'as rien compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Eh bien, s'il s'avère que c'est un fruit délicieux, je vous invite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Ouais ! Ce n'est pas tombé dans l'oreille d'une sourde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Vous savez vraiment comment convaincre Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Eh bien, disons simplement que j'ai... Parfois à m'occuper d'un enfant. C'est encore une longue histoire, j'en ai peur... Je suppose que c'est l'une des rares disciplines non liées à l'alchimie dans laquelle je suis doué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "Le sujet de mes premières recherches était les éléments. Dans ce monde, manipuler les éléments requiert un œil divin, bien que je ne vois rien qui ressemble à ça sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "J'aimerais savoir comment vous êtes capable de manipuler librement l'énergie élémentaire. J'ai quelques questions à ce sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "Tout d'abord, possédez-vous des organes supplémentaires ? Un deuxième cœur, un quatrième estomac, vous savez... Ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "Non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Fascinant... Et cette gamine qui flotte est... Reliée à votre corps d'une manière ou d'une autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Quelle question stupide ! Vous voyez pas l'écart entre nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "Et aussi, c'est PAIMON ! Et pas gamine qui flotte ou je sais pas quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "J'envisageais simplement la possibilité que vous soyez un organe externe, avec peut-être une force invisible qui vous relie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "J'ai rencontré Paimon lors de mes voyages.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Oh, ça exclut cette possibilité... Je me demande, est-ce que c'est Paimon qui guide l'énergie élémentaire jusqu'à vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Mais cela signifierait que l'énergie élémentaire de Paimon peut percer une roche de montagne d'au moins dix mètres d'épaisseur... Ou retenir la cascade au sud de Deauclaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Hum... Non, ça ne peut pas être ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Hé, j'ai pas mon mot à dire ou quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "Dans ce cas, il semblerait qu'il n'y ait pas de différence évidente entre la composition de votre corps et celle des humains de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Étant donné qu'il y a clairement une divergence dans les recherches, il semble que seule l'expérimentation fournira des réponses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Premièrement, cette mystérieuse énergie élémentaire... J'aimerais examiner exactement comment cela se manifeste à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Laissez-moi attirer quelques Blobs dans la zone. Et vous pourriez les combattre en utilisant la méthode qui vous vient le plus naturellement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Euh, ça ne fait pas très scientifique tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Une observation directe et claire est indispensable pour une bonne expérimentation. Ce n'est qu'un simple exercice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Naturellement, si vous voulez un plus grand défi, nous pouvons trouver six Océanides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Des Blobs ! Des Blobs, c'est très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Je ne comprends pas, et ça a quand même l'air assez compliqué.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Bon, préparez-vous. Les Blobs seront là d'un moment à l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Tant que je ne dois pas me battre contre des Mimiqueurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "J'ai attrapé Paimon avec une canne à pêche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Pas que je sache...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "On dirait que vous avez percé Paimon à jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "J'aimerais aussi entendre votre histoire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "Excellent travail ! Avez-vous ressenti quelque chose qui sorte de l'ordinaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "#Si vous êtes {M#blessé}{F#blessée}, j'ai des potions d'urgence prêtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Pas même une égratignure !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Très bien ! Selon mes observations, la manifestation du flux élémentaire externe est comme prévue, et les réactions élémentaires sont normales. Il n'y a rien d'extraordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Maintenant que nous savons que le flux externe se manifeste normalement, testons le flux interne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "Le flux interne... Comment vous testez ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "C'est très simple... Je peux utiliser l'alchimie pour créer une potion qui extraira l'énergie élémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Si l'énergie élémentaire est stockée ou accumulée physiquement dans votre corps, cette potion pourra provoquer une réaction élémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Et ça va faire des tours dans mon estomac ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Ça a l'air terrifiant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Ne vous inquiétez pas ! Si tout se passe normalement, vous ne ressentirez qu'un malaise temporaire, mais aucune blessure corporelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "Et si tout se passe anormalement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Si quelque chose d'imprévu arrive, j'ai fait les préparatifs nécessaires. Essayez de ne pas vous inquiéter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Ce n'est pas très rassurant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Eh bien, ce n'est pas qu'il n'y ait pas de risques impliqués. Mais si quelque chose bloque votre flux élémentaire, nous pourrons le localiser avec ce test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Juste un avertissement ! Si une réaction élémentaire interne se produit pour une autre raison, c'est mauvais signe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "C'est comme un bilan de santé, en fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Oui ! C'est une excellente façon d'y penser. Avant de commencer, il manque un catalyseur à la potion que nous utiliserons pour le test. Nous devons le trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "C'est un type de minerai connu sous le nom d'« argétoile », mais malheureusement, tous ne conviennent pas forcément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Je vous emmène à mon campement, et on peut récupérer de l'argétoile sur le chemin. Je vous montrerai tous ceux qui conviennent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Si tout va comme prévu, nous devrions être en mesure de commencer à concocter la potion lorsque nous arriverons au campement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "J'ai encore quelques doutes sur la fiabilité de tout ça, mais il semble qu'il y ait une lueur d'espoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Gardons les yeux bien ouverts !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Et ça va se cristalliser dans mon estomac ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "J'ai juste un peu froid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Voici mon campement ! J'ai ajouté les matériaux que nous avons recueillis dans la concoction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "En attendant, jetez donc un œil par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Mon assistant, Timaeus, est ici pour m'aider dans mes recherches. Je suppose que vous vous êtes déjà rencontrés à Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Bonjour, je viens de récupérer les données de votre expérimentation, et le rapport est déjà affiché sur le tableau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Waouh ! Regardez toutes ces données ! Vous avez obtenu tous ces résultats avec une seule bataille de Blobs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Haha, je n'appellerais pas ça des résultats... Des déductions plutôt, et peut-être quelques suppositions audacieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "#Je pense que la direction la plus rationnelle serait d'expliquer la relation phylogénétique entre {M#ce voyageur}{F#cette voyageuse} et les Blobs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "C'est rationnel, ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Pensez-y : vous n'avez pas d'œil divin, mais vous pouvez manipuler l'énergie élémentaire. Les Blobs n'ont pas non plus d'œil divin, mais ils sont également capables de manipuler les éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "En suivant cette ligne de pensée, je suis sûr que nous pourrons établir une base factuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "C'est un bon point d'approche, mais à proprement parler, les Blobs sont des formes de vie élémentaires. En d'autres termes, des êtres entièrement constitués d'éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Un Arbre congelé, ou même une Fleur mensongère, serait une meilleure analogie. Mais pour retracer les relations phylogénétiques entre les plantes et les animaux... Vous auriez à remonter aux origines du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "En ce sens, les choses pourraient devenir difficiles, vous ne pensez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Oh ! Oui, monsieur. Cela semble correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "#Après tout, nous avons déjà nos données primaires. {M#Ce voyageur}{F#Cette voyageuse} est {M#un visiteur}{F#une visiteuse} d'un autre monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "#S'il s'avérait qu'{M#il}{F#elle} avait une relation phylogénétique avec ce monde... Alors là, ce serait vraiment quelque chose, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "Ahhhh, c'est vrai ! Toutes mes excuses, j'étais tellement excité d'obtenir les données. J'y prendrai garde la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "En parlant de données... Pour achever nos recherches, il nous en faut davantage. Je vais effectuer une analyse ici pour le moment. Si vous souhaitez obtenir un rapport, venez me trouver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Très bien, je vous laisse faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "On dirait que la potion est prête. Je vais d'abord en essayer un peu. Si tout va bien, je vous la donne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "J'aurais pensé que même Paimon et moi étions plus proches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
