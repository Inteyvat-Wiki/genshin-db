	"talks": [
		{
			"id": 1104201,
			"completionStepIds": [
				1104201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104201",
							"2"
						],
						"stepId": 1104201,
						"stateName": "QUEST_STATE_UNFINISHED"
