					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120701,
					"content": "C'est fini. Diluc n'en a fait qu'une bouchée... On dirait qu'il y a des choses qui ne changent pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120702,
					"content": "Mais alors, est-ce qu'il y a vraiment du danger ici ? On dirait que ce ne sont que des illusions du passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120703,
						705120704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120703,
					"content": "Diluc a déjà dû passer par là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				},
				{
					"id": 705120705,
					"content": "Donc, Diluc en a déjà fini ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120706,
					"content": "#Est-ce que d'autres monstres vont apparaître si on s'approche encore de ces sédiments des lignes énergétiques ? Et qu'est-ce qui est arrivé au jeune Diluc{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120707,
					"content": "Si c'est comme les autres sédiments des lignes énergétiques qu'on a vus, il aurait dû disparaître après avoir vaincu tous les monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120708,
						705120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120708,
					"content": "Alors comme ça, tu t'intéresses au jeune Diluc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120710,
					"content": "Non, non, héhé. Je suis juste un peu inquiète, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120711,
					"content": "#Et si un curieux qui passait par là venait voir et soudain, « yaah ! », un monstre surgissait tout à coup et, «{NON_BREAK_SPACE}clang », il lui donne un coup ? Ce serait terrible, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120712,
					"content": "... Pourquoi tous ces effets sonores ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120713
					]
				},
				{
					"id": 705120713,
					"content": "... Comme ça, tu vois que c'est dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120714,
					"content": "#De toute façon, on est {M#venus}{F#venues} ici pour aider Diluc, pas vrai ? Alors restons encore un peu et assurons-nous que l'endroit est sûr avant de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120715,
					"content": "Quel sens des responsabilités !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120716
					]
				},
				{
					"id": 705120716,
					"content": "Héhé... Pas vraiment. C'est juste que je veux mon jus de raisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120717,
					"content": "Allez, finissons-en au plus vite. Quand on aura le jus de raisin, je te partagerai du mien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120709,
					"content": "Ou tu as soudainement développé un intérêt pour les anomalies des lignes énergétiques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120704,
					"content": "Il pourrait rester tout au plus quelques vestiges.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				}
			]
		},
