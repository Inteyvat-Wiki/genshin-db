			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "Waouh ! D'où viennent tous ces monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120502,
					"content": "Attends... Ce ne serait pas Diluc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120503,
					"content": "Il a l'air un peu différent de d'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "Regarde ça ! Il a tellement de fougue ! Alors c'est ça que ça donne le capitaine Pyro en action ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120505,
					"content": "Ça doit être le Diluc du passé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "En effet, en regardant de plus près, ce Diluc a l'air plus jeune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120508,
					"content": "Mais que s'est-il passé ? Pourquoi Diluc s'est-il battu ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120509,
					"content": "Hmm. Je suppose qu'on aura qu'à lui demander quand on le verra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120510,
					"content": "#{NICKNAME}, qu'est-ce qu'on fait maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120511,
					"content": "Il ne faut pas se précipiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "D'accord, voyons comment le jeune Diluc se débrouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120512,
					"content": "Commençons par observer ce qu'il se passe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "Les lignes énergétiques montrent ce qu'il s'est passé à cette époque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
		{
			"id": 7051207,
			"completionStepIds": [
				7051207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051207",
