			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "Bonjour vous deux. Ça fait longtemps. Vous avez l'air en forme, comme toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "Bonjour Adeline !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "Qu'est-ce qui vous amène ici aujourd'hui ? Vous avez un sujet important à discuter avec maître Diluc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Du jus de raisin, en fait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "C'est exact, Adeline, mais puisque vous êtes là, vous allez peut-être pouvoir nous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "On rate à chaque fois les promotions sur le jus de raisin du Domaine, alors cette fois, on a décidé de s'y prendre à l'avance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "Est-ce que vous pouvez nous réserver une bouteille ? Ça ne nous dérange pas de payer un acompte, votre prix sera le nôtre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "Bien sûr que je le peux, il ne sera pas nécessaire de me verser un acompte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "Mais j'ai bien peur que vous ne deviez attendre longtemps. Le jus de raisin de la promotion du Domaine de l'Aurore prend beaucoup de temps à fabriquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Chaque été, maître Diluc cueille à la main deux barils des meilleurs raisins pour les transformer en jus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "Quoi ? Pourquoi vendre les bons produits à bas prix ? Les meilleurs raisins ne devraient-ils pas être les plus chers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "Le maître n'a jamais expliqué pourquoi. Si je devais émettre une hypothèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "La promotion pourrait être une technique pour attirer les clients. Ça marche toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "Le maître espère peut-être populariser les jus de fruits, afin que les gens aient plus d'options en matière de boissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "C'est une alternative idéale pour les plus gros buveurs, car ils ne seront pas ivres et ne feront pas de bêtises. Dans le même temps, ceux qui ne boivent pas d'alcool ont la possibilité d'essayer quelque chose de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "Cela ne nuit-il pas aux affaires du Domaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Ce n'est pas qu'une question d'argent pour maître Diluc. Je pense qu'il préfère voir les gens boire avec modération plutôt que de courir après le profit à tout prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Imaginez un monde où on pourrait boire un bon verre de vin et s'amuser tout en gardant l'esprit clair et sans causer d'ennuis aux autres... Ce ne serait pas formidable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Maître Diluc est vraiment gentil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "Alors, est-ce que Diluc est en train de cueillir les raisins de cette année ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Pas encore. Il commencera dès qu'il aura réglé quelques problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "Si ça vous intéresse, je suis sûre que maître Diluc sera ravi d'entendre vos suggestions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "Il y a des problèmes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "#Vous savez bien qu'à chaque fois que maître Diluc a vent de l'arrivée d'invités peu recommandables à Mondstadt, il ne peut pas s'empêcher d'aller les «{NON_BREAK_SPACE}saluer{NON_BREAK_SPACE}» en personne. C'est le cas, une fois encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "Il devrait être quelque part près de la Côte du Faucon, je ne sais pas pour combien de temps encore il en a... Est-ce que vous voulez aller vous asseoir pour l'attendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "Il faut que je reste ici pour attendre l'arrivée d'autres invités, mais Hillie et Moco se feront un plaisir de s'occuper de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "« Des invités peu recommandables » ? Qu'est-ce que ça veut dire...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "J'imagine que ça a un rapport avec l'autre métier de Diluc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "Hein ? Tu veux parler du Héros de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "Ahem... Est-ce que l'Ordre de l'Abîme serait encore en train de préparer quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "En tant que fidèles compagnons de maître Diluc, on ne peut pas rester les bras croisés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "#Si vous pouviez l'aider, ce serait génial. Après tout, le maître a confiance en vous et vous êtes {M#tous}{F#toutes} les deux très {M#doués}{F#douées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "#Merci à vous de vous être {M#proposés}{F#proposées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "Ce n'est rien ! Plus vite maître Diluc est libéré, plus vite on pourra goûter à ce délicieux jus de raisin, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#Allez {NICKNAME}, on va à la Côte du Faucon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Très bien, on va attendre à l'intérieur l'arrivée de Diluc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "Ummm... J'aurais mauvaise conscience si on restait à attendre Diluc dans sa maison pendant qu'il est dehors à s'affairer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "Allons à la Côte du Faucon pour aider Diluc avec ses problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Même si Diluc est super fort, de l'aide est toujours la bienvenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "Ça ne me paraît quand même pas être le plus rentable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "Rien de très important, en réalité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Cette tente n'a pas l'air d'appartenir à Diluc. C'est peut-être un camp d'aventuriers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Oh, il y a une note et un carnet là-bas. Lisons-les.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "« Cher Héros de la Nuit, nous assistons à une recrudescence du phénomène étrange auquel on avait assisté il y a de cela plusieurs années. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 705120404,
					"content": "« Vous aviez réussi à résoudre le problème une bonne fois pour toutes, malheureusement les lignes énergétiques semblent s'être activées à nouveau et libèrent les mêmes monstres. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 705120405,
					"content": "« Je suppose que vous voudrez vous occuper de ceux qui représentent la plus grande menace en premier. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 705120406,
					"content": "« Je vais donc prévenir qui de droit, conformément aux procédures en vigueur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 705120407,
					"content": "Hmm... À en juger par le ton de cette lettre, elle semble avoir été écrite par quelqu'un que Diluc connaît bien. On va l'appeler « ami de Diluc » pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "Il a constaté que quelque chose de grave était arrivé, il a écrit une note pour maître Diluc, puis il est parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "Est-ce qu'il n'aurait pas fait preuve d'un peu de négligence ? Et si quelqu'un d'autre était tombé dessus ? En plus, il a laissé son carnet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Maintenant que j'y pense... Tu vois ces étranges sédiments des lignes énergétiques sur la plage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "Ce ne serait pas ça les phénomènes étranges ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Pourtant, tout semble aller bien ici... Pas un monstre en vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, toi aussi, tu as envie de lire le carnet de l'ami de Diluc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "Sinon, allons voir de plus près les sédiments des lignes énergétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
