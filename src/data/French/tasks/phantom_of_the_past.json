	"talks": [
		{
			"id": 7051202,
			"completionStepIds": [
				7051201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
