					"id": 705120801,
					"content": "Transmettez mes salutations à maître Diluc quand vous le verrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120802
					],
					"speakerTitle": "Adelinde"
				},
				{
