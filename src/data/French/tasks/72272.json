			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "J'ai un trésor à vous vendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "Ah ? Pour tout vous dire, nous avons réussi à rétablir un approvisionnement régulier en marchandises, et nous n'avons pas vraiment l'habitude de récupérer des bibelots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720104,
					"content": "Mais rien qu'en vous regardant, je pense que l'on peut supposer qu'il s'agit de quelque chose de très intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720105,
					"content": "Eh bien... Laissez-moi y jeter un œil, si vous le voulez bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720106,
					"content": "Vous parlez de l'orbe d'os-dragon à Mikoshi Genichirou.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720108,
					"content": "Je vais être honnête avec vous. C'est une histoire assez incroyable... Mais elle est justement un peu trop incroyable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720109,
					"content": "Cet objet sort un peu de mon domaine d'expertise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720110,
					"content": "Ne vous moquez pas de moi, je ne suis qu'un simple artisan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720120,
					"content": "Bon, je vous en donne 80 000 moras et 5 assortiments de sashimis. Ces plats ne sont pas donnés, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720111,
					"content": "#Si vous êtes {M#prêt}{F#prête} à accepter ce prix, alors je vous l'achète.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720112,
					"content": "... Qu'allez-vous en faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "Je ne suis pas encore tout à fait sûr, il faut que j'y réfléchisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720114,
					"content": "Et qui sait, peut-être que je pourrai le transformer en netsuke si la situation le permet. Comme ça, je pourrai le vendre à un prix un peu plus élevé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720115,
					"content": "Ça me paraît raisonnable. Marché conclu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "Tenez, voici vos moras. Quant à moi, je m'en vais étudier cet objet plus en profondeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720117,
					"content": "Je vais réfléchir encore un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "Très bien. Ça me permettra aussi d'y réfléchir plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720119,
					"content": "Revenez quand vous aurez pris votre décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				}
			]
		},
