				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "Ah ! Encore vous ! Vous avez fait peur à mes pigeons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480102,
					"content": "J'étais en train de les nourrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480103,
					"content": "Pardon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "Hmph. Maman dit que si on est vraiment désolé, on doit le montrer avec ses actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480105,
					"content": "Les pigeons sur ce pont sont mes amis. Je les nourris tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480106,
					"content": "Ces derniers temps, des canards viennent voler leur nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480107,
					"content": "J'aimerais que vous trouviez trois brins de blé pour nourrir ces canards. Je vais faire en sorte que les pigeons aient assez à manger pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480108,
					"content": "Les canards et les pigeons pourront devenir amis quand ils auront tous à manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480109,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480112,
					"content": "Les animaux peuvent devenir vos amis si vous les traitez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480110,
					"content": "#Ça ne m'intéresse pas d'être {M#ami}{F#amie} avec des pigeons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "Puis, même si ça ne vous intéresse pas, vous leur devez quand même des excuses pour tout à l'heure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 200480114,
					"content": "Alors dépêchez-vous de rapporter ce blé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				}
			]
		},
