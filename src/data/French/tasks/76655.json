			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins ! Vous êtes là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Bien sûr. Je dois vous remercier. Ce phare a bien meilleure allure maintenant qu'il a été entretenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Ne vous en faites pas. Cet endroit restera sombre, peu importe ce qu'on fait. Il y a aussi encore des endroits que la lumière n'arrive pas à atteindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "En effet. Dans le cimetière, on a l'impression que le temps s'est figé à la fin de la bataille pendant cette nuit-là, contrairement à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Je n'avais pas l'intention de changer mon environnement, mais on dirait que vous avez permis au temps d'avancer à nouveau en allumant le phare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "Ça aura une répercussion sur votre vie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Si vous parlez de répercussion négative, alors je dirais que non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "La vie est un cycle. Malgré notre absence, les fantômes qui errent ici se dissiperont progressivement et retourneront dans les lignes énergétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Alors, ne vous inquiétez pas. Le phare illumine bien le moindre recoin de l'île. Le brouillard qui enveloppe la zone se lèvera au fur et à mesure que les fantômes disparaîtront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "Le soleil finit toujours par se lever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "#{M#Désolés}{F#Désolées}, ce n'était pas notre intention.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Ne vous excusez pas. Je ne suis pas allergique au changement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
