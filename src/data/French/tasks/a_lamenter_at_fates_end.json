					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "Qu'est-ce qu'est ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Enchaînée dans les airs et dégageant une aura sinistre... C'est comme la statue profanée !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(Je savais que l'Ordre de l'Abîme était impliqué... Ces Brutocollinus en transe... C'est comme la personne de l'autre fois...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "#Eide, cet endroit est maudit ! Partons{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "Ô créature, pourquoi t'inclines-tu ? As-tu peur de l'inconnu ? Pour obtenir un pouvoir que tu convoites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110509,
					"content": "(D'où vient cette voix ? De ma tête ? Eide ne semble pas l'entendre.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "... Ô créature, pourquoi fais-tu cela ? Je ne suis pas une divinité. Je ne suis rien d'autre qu'un transgresseur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110511,
					"content": "(Un transgresseur...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Tu es comme une fleur née du péché, mais d'une pureté immaculée... Je connais ton destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110513,
					"content": "Nul besoin de retenir ta rancœur ou d'accepter les mensonges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110514,
					"content": "Deviens un être transcendant et élève-toi au-dessus du destin qui t'a été accordé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110515,
					"content": "Et je verserai une larme à la fin des temps... en contemplant ta vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110516,
					"content": "(... Qui êtes-vous ? Que veulent dire ces paroles ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Synthèse"
				},
				{
					"id": 80110518,
					"content": "(La voix a disparu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "... Eide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*halète* Que vient-il de se passer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "Quand j'ai vu cette chose, mon cœur s'est apaisé. J'ai ressenti une certaine révérence ? De la joie ? Je ne sais pas trop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "Vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Très bien, même mieux que quand nous sommes arrivés ici. Que c'est étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Il y a quelque chose qui cloche ici, nous devons partir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Ah bon ? Je vous suis alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Vous quittez la grotte sinistre et revenez à la maison d'Eide...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert ! Ouf, tu es bien resté ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "On doit encore prier la Statue des Sept, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "J'ai le sentiment étrange que les événements que nous avons vécus étaient destinés à se produire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Pour que cela se produise quand je rechignais à courber l'échine devant la Statue des Sept...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "Vous me dites que je me suis incliné devant cette chose... Peut-être que cela a le même effet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "C'est un peu tiré par les cheveux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "En tout cas, je dois tout essayer... Vous l'avez dit vous-même : « Il faut envisager toutes les possibilités ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Vous donnez le remède au Brutocollinus une fois de plus...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "Pa... Pa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "Ah ! Caribert ! Je ne rêve pas, le miracle s'est produit ! Mon petit Caribert !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "Je n'arrive pas à le croire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "Regardez, ça a véritablement marché ! Caribert a retrouvé la parole !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "Où est maman ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "Elle... Caribert, regarde-moi. Est-ce que tu me reconnais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Oui, tu es mon papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Haha... Hahahaha... C'est donc ça, le salut ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "Comment te sens-tu, Caribert ? Es-tu complètement réveillé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Oui... J'ai l'impression d'avoir dormi très longtemps. Dans mes rêves, j'étais caché dans une pièce. Je n'osais pas en sortir, mais je ne voulais pas le faire non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Mon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "Mon corps ! Qu'est-ce qui m'est arrivé ?! C'est moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Papa, que s'est-il passé ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "... Ne panique pas, fiston. Pendant ton sommeil, nous sommes arrivés dans un monde comme dans les contes de fées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "Khaenri'ah n'existe plus, nous ne reverrons plus notre maison. Mais ça veut dire que le ciel rouge a disparu et la crainte de la fin du monde aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "Dans ce monde, tu auras beau être un petit monstre, papa sera à tes côtés pour toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Je... Je suis mort, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "Pas du tout. Regarde, Caribert, tu as encore le foulard de maman attaché au bras. Elle veille sur toi et te protège. Comment pourrais-tu être mort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Oui ! Tu viens de te réveiller, c'est normal que tu te sentes un peu perdu. Repose-toi pour l'instant, tout ira bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Oh, et promets-moi une chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "N'enlève pas ton masque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Quoi qu'il arrive, ne le retire pas. D'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "D'accord, papa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Père et fils continuent leur discussion pendant un certain temps. Eide est devenu un homme changé après cette expérience...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "Je n'ai jamais été aussi heureux qu'aujourd'hui... Je n'arrive vraiment pas à y croire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Moi non plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Hmph, je savais que je n'aurais pas dû supplier les Sept... Je me suis même incliné devant l'une de leurs statues comme un imbécile. C'est la pire humiliation que j'ai vécue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Des meurtriers seront toujours des meurtriers, j'ai été naïf de croire qu'ils pouvaient me sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "Contrairement à eux, la divinité que nous avons vue dans cette grotte était toute-puissante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "Son pouvoir mystique était fascinant... C'est sûrement la raison pour laquelle je me suis inclinée devant elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Dans ce cas, lorsqu'on prie une divinité et qu'elle réalise ce qu'on a demandé... Ne faut-il pas lui témoigner sa fidélité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "Je ne suis pas un modèle de piété, mais je devrais honorer la divinité qui a entendu mes prières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "... Ce n'en était pas une, Eide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "Un transgresseur ? Qu'est-ce que vous racontez ? Vous ne savez même pas qui c'est... Comment osez-vous proférer de tels blasphèmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "Vous avez été témoin de ses pouvoirs. Qu'ont fait les Sept quand je les ai implorés pour un miracle ? Rien du tout... Cet être divin est beaucoup plus puissant qu'eux ! Et vous le considérez comme un transgresseur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Ce n'est pas grave... Votre avis n'ébranlera pas ma foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Je vais lui rendre hommage, avec ou sans vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "Vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "(Eide a été bouleversé par les derniers événements... Il était plutôt instable, mais cette ferveur religieuse...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "(*soupir* Je devrais quand même y aller avec lui. Les monstres grouillent de partout, je ne dois pas le laisser à leur merci...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110656,
					"content": "Faites ce que vous voulez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110650,
					"content": "C'était un « transgresseur ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110642,
					"content": "C'est incroyable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110616,
					"content": "Incroyable !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110608,
					"content": "Si vous le dites...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
