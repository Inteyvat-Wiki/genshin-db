			"dialogs": [
				{
					"id": 80110401,
					"content": "Qui c'était ? Il...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "Il vous a fait peur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "... C'est un être parfait. Je suis impressionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Une merveilleuse aura émanait de lui, élégante et dangereuse à la fois... Fascinant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "Et vous avez été en mesure de le vaincre. J'ai vraiment sous-estimé votre force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "Vous avez des goûts particuliers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Continuons d'avancer, ma curiosité et mon enthousiasme ne cessent de grandir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "J'ai beaucoup d'expérience en combat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "J'ai déjà rencontré ses semblables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
