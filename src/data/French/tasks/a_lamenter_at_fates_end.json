			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "Quel endroit sinistre... Cet endroit a-t-il toujours existé ? Je crois que je ne l'ai jamais remarqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Regardez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Ah ? On dirait qu'ils sont en train de vénérer quelqu'un ou quelque chose ? Ils marchent, puis ils s'agenouillent... Et ça m'a l'air fait de manière sincère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "Je n'ai jamais vu une chose pareille de toute ma vie. Qu'est-ce qui se passe ici, au juste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Il n'y a qu'une seule façon de le découvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(Cette atmosphère et ce lieu sinistre... Est-ce que ce serait...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "Que font ces Brutocollinus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
