			"dialogs": [
				{
					"id": 80110301,
					"content": "Halte-là, humains. Le destin ne vous a pas accordé le droit d'accéder à ce lieu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Diseur de bonne aventure"
				},
				{
					"id": 80110302,
					"content": "(Un Apôtre de l'Abîme ? Non, il n'a pas l'air de faire partie de l'Ordre de l'Abîme...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Vous insistez pour obtenir une « audience » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Diseur de bonne aventure"
				},
				{
					"id": 80110304,
					"content": "... Très bien. Dans ce cas, je vous soumets à l'épreuve de la destinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diseur de bonne aventure"
				}
			]
		},
