			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "Il semblerait que ce ne soit pas Caribert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110102,
					"content": "Non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "Oui, j'avais offert ce foulard à sa mère. Il me sert à le repérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110105,
					"content": "Mes yeux ne sont vraiment plus ce qu'ils étaient. Je n'ai même pas su reconnaître mon propre fils... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110106,
					"content": "Mais ce Brutocollinus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "C'est vrai, il n'avait pas du tout l'air intéressé par nous et s'est contenté de marcher dans cette direction... Qu'y a-t-il là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110109,
					"content": "Je ne sais pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "Oui, plus nous en saurons sur les Brutocollinus et mieux ce sera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110110,
					"content": "Allons voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "Il était quand même un peu étrange.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "Il n'a pas de foulard en soie autour du bras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801104",
