			"dialogs": [
				{
					"id": 740730601,
					"content": "Des lithiases. Tu sais, comme les calculs rénaux et ce genre de choses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730602
					]
				},
				{
					"id": 740730602,
					"content": "C'est vrai que les calculs ne peuvent pas être brûlés par le feu et qu'ils restent cachés dans les organes internes. Mais ils ne sont pas créés en un instant, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730603,
					"content": "Ah, c'est vrai. Et quelle est la réponse à ton avis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
