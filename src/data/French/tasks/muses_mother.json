			"dialogs": [
				{
					"id": 740730101,
					"content": "Les feux de camp sont encore allumés. Attends, mais pourquoi y a-t-il des feux ici ? On est dans des ruines, pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Voyons ce qui est écrit sur cette stèle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "« Ici se trouve l'Orthant de la mémoire, le Hall de la mémoire et la Salle de la mémoire. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "#« Né en un instant »... « Souvent contradictoire et auprès de vous dans un sommeil éternel, toujours unis »... « Difficile à brûler avec du feu{NON_BREAK_SPACE}»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Ce sont des énigmes. L'ancienne civilisation de Fontaine les aimait beaucoup, l'Ordo Narzissenkreuz aussi. Je ne sais pas s'il s'agit d'une tradition ancienne ou d'un simple intérêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "J'ai essayé de chercher avec tous les mots-clés, mais je n'ai pas trouvé de réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Mais c'est une énigme qui est déjà résolue. Peut-être que la réponse a un rapport avec le feu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "À quoi ça sert de réfléchir à une énigme déjà résolue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "Ça sert à quelque chose, croyez-moi. Nous sommes ce que nous sommes aujourd'hui, mais découvrir notre passé reste important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "En effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#Chevalier {NICKNAME}, quelle est la réponse selon vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
