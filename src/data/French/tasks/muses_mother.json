					"nextDialogs": [
						740730702
					]
				},
				{
					"id": 740730702,
					"content": "Oui, c'est l'ombre ! Elle ne peut pas être consumée par le feu et nous accompagne toute notre vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730703,
					"content": "Mais à quoi ça sert de réfléchir à cette énigme déjà résolue ?",
					"roleType": "TALK_ROLE_NPC",
