			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#{NICKNAME} ! Je me fais des idées, ou... Ces Brutocollinus ont l'air bizarres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Ils dégagent une énergie inquiétante, c'est vrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Je pense aussi ! Nous avons vu beaucoup de Brutocollinus jusqu'ici et c'est vrai qu'ils sont toujours des monstres... Mais là, c'est différent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "Oh ! Et l'Auberge Wangshu n'est pas loin ! C'est dangereux pour les clients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Maintenant qu'on les a vus, je me sentirais mal si on ne s'en chargeait pas... Allez ! On s'en occupe, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Ils ont l'air plus agités que d'habitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Ça aurait un rapport avec cette aura noire qu'ils dégagent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Ces super Brutocollinus sont aussi plus difficiles à vaincre que les normaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "Hé, regarde là-bas ! Il y a tout un tas de gens... Je me demande ce qu'ils font.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Waouh ! Tu as vu ce type avec son masque ? Il a fait fuir tous les Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "C'est un Adepte ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Oh, tu veux dire, un Adepte comme Xiao ? En y pensant... Xiao aussi a un masque comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "Mais la magie qu'il utilisait avait l'air encore plus « Adepte » que celle de Xiao ! On va lui dire bonjour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "On dirait qu'il utilisait la magie des Adeptes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110004",
							"2"
						],
						"stepId": 1110004,
						"stateName": "QUEST_STATE_UNFINISHED"
