				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fidèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Vous avez vu la puissance du maître des étoiles ? Il est divin, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000402,
					"content": "Je suis sûr que mon père va enfin aller mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000403,
					"content": "Parlez-moi du maître des étoiles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Vous n'avez qu'à regarder sa technique. On voit bien que c'est un véritable Adepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000405,
					"content": "Je lui avais demandé d'aider mon père malade... Et le médicament qu'il lui a donné était bien plus efficace que les remèdes bon marché du Cottage Bubu, je vous le dis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000406,
					"content": "Une fois plongé dans l'eau bouillante, ça dégageait une fumée mystérieuse. Exactement comme un remède secret d'Adepte, pour sûr ! Bon, il y avait aussi des fleurs de brume dedans, mais bon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000407,
					"content": "Les soins des Adeptes sont vraiment efficaces. Je suis sûr que mon père sera bientôt sur pied !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000408,
					"content": "Bien sûr, ce genre de traitement n'est pas donné ; c'est difficile à trouver, même pour lui ! Alors j'ai dû lui donner des antiquités en offrande... Mais bon, ce n'est rien comparé à la santé de mon père, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fidèle"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110005",
							"2"
						],
						"stepId": 1110005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fidèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Enfin... De l'espoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000502,
					"content": "Parlez-moi du maître des étoiles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Êtes-vous également un des fidèles du « maître des étoiles » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000504,
					"content": "Quand mon fiancé est parti sans dire mot, les jours étaient marqués par mes pleurs sans fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000505,
					"content": "J'ai donc eu recours à la magie d'Adepte du « maître des étoiles ». Il a suggéré de brûler son portrait et de répandre les cendres en pleine mer au lever du soleil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000506,
					"content": "Maintenant, au fond de mon cœur, j'ai la sensation qu'il va revenir ! J'en suis sûre, cela n'a rien à voir avec tous ces charlatans avec leurs conseils bancals...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Fidèle"
				},
				{
					"id": 111000507,
					"content": "J'en suis si convaincue que j'ai donné toutes mes économies au « maître des étoiles » ! En plus, il m'a assuré que mon fiancé reviendrait après avoir fait fortune, alors je n'en ai plus besoin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fidèle"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110006",
							"2"
						],
						"stepId": 1110006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fidèle - Marchand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "Avec le « maître des étoiles » parmi nous, on n'a plus besoin des Millelithes, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Fidèle - Marchand"
				},
				{
					"id": 111000602,
					"content": "Parlez-moi du maître des étoiles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Je suis un marchand, vous savez... Et ma dernière cargaison de marchandises était très précieuse ! Alors, j'ai demandé au « maître des étoiles » s'il pouvait m'accompagner, aussi présomptueux que cela puisse être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Fidèle - Marchand"
				},
				{
					"id": 111000604,
					"content": "Et j'ai bien fait ! Quand les monstres se sont montrés, il a sorti son talisman, et ils ont tous déguerpi. Nous n'avons plus rencontré aucun problème pendant tout le voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Fidèle - Marchand"
				},
				{
					"id": 111000605,
					"content": "Ce n'était pas donné, bien sûr... Mais solliciter les services d'un dieu n'est pas une mince affaire, regardez le rituel de la descente ! Alors j'ai accepté, mais je doute que la plupart des étrangers en fassent de même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fidèle - Marchand"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Céleste voleur d'étoiles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "Quelles sont vos impressions ? Mes fidèles ont probablement exagéré un peu, mais c'est parce qu'ils parlent avec le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000802,
					"content": "Je dirais avec leur imagination plutôt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Hahaha, vous plaisantez sûrement ! Il existait autrefois un maître Adepte, Wuliang, que les mortels appelaient « Quanta ». Il a une fois déclaré :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000804,
					"content": "« Toutes les choses sont liées ! Ce que les mortels appellent l'imagination n'est en fait qu'une connexion entre l'esprit et la matière. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000805,
					"content": "En d'autres termes, leurs souhaits sont déjà en passe de devenir réalité. Est-ce que vous comprenez mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000806,
					"content": "Non, vous rendez les choses encore plus compliquées... En gros, vous dites que leurs souhaits peuvent se réaliser, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Exactement ! Vous êtes intelligente, ma chère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000808,
					"content": "OK... En parlant de ça... On a une autre question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Oh ? Il vous suffit de demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000810,
					"content": "Pourquoi portez-vous ce masque ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "J'erre... parmi les mortels, en faisant le bien et en éliminant le mal. Je souhaite ne pas révéler mon visage pour éviter de perturber ce monde plus que de nécessaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000815,
					"content": "Oh, je comprends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "À présent, quels sont vos souhaits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000817,
					"content": "#J'aimerais savoir où se trouve {M#ma sœur}{F#mon frère}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Hmm... Vous semblez cacher un passé tragique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000824,
					"content": "Quoi qu'il en soit, ce souhait est à la portée de ma puissance divine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000825,
					"content": "Mais tout d'abord, il me faut une preuve de votre... foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000826,
					"content": "Qu'est-ce que ça signifie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "La voie des Adeptes ne repose pas que sur la simple compréhension des mots. Il faut rechercher... les vérités profondes qui se cachent derrière eux... Si vous ne parvenez pas à comprendre leur signification cachée, alors malheureusement, je ne pourrai pas vous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000828,
					"content": "Qu'est-ce qu'on fait ? Je ne comprends rien à ce qu'il raconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Je crois qu'il veut quelque chose en contrepartie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "Oh, C'est vrai ! Certains des fidèles de tout à l'heure ont mentionné qu'ils avaient dû payer une jolie somme pour obtenir l'aide d'un Adepte, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Mais je vais pas lui laisser mes moras, et on n'a rien de précieux sur nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Tu n'as même pas d'œil divin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "Je ne pense pas que ça se vende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "Hé ! Pourquoi ne pas lui préparer un bon repas ? Personne ne peut résister à la tentation de la bonne nourriture, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Personne de ceux qui partagent les mêmes valeurs que toi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Oui, un bon repas, c'est sûr que ça va marcher ! Hihihi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Pourquoi ne pas aller à la Librairie Wanwen pour voir s'il y a de nouvelles recettes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Miam ! Bonne idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Merci de me le rappeler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Je crois qu'il veut des moras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "#Je veux être aussi {M#puissant}{F#puissante} que les dieux.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "En effet, de nombreux obstacles peuvent être franchis avec une telle puissance. Mais je me demande... Quelle rancune entretenez-vous envers les dieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000821,
					"content": "J'aimerais devenir riche sans tarder !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#Hé ! Tu as déjà oublié {M#ta sœur}{F#ton frère} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "#Hmm... Une pensée commune chez les mortels... Vous ne semblez pas être de Liyue, mais vous semblez pourtant avoir été {M#influencé}{F#influencée} par son matérialisme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111000811,
					"content": "Retirez votre masque pour voir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "Hé ! N'est-ce pas un peu inapproprié ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Hum. En effet, ce serait inapproprié que je retire mon masque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				}
			]
		},
		{
			"id": 1110010,
