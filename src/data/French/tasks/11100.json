			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Céleste voleur d'étoiles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Ahem. Bonjour ! Permettez-moi de nous présenter, nous sommes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "#Je vous en prie, si vous êtes {M#venus}{F#venues} me remercier, il ne fallait pas vous donner la peine. Éliminer les démons de ce monde est le rôle de tout Adepte. Ne vous embêtez pas pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001003,
					"content": "Attendez, qui êtes-vous ? Je pensais que vous étiez des fidèles, mais en y regardant de plus près, je ne crois pas qu'on ait été présentés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001004,
					"content": "#Nous ne sommes que des {M#voyageurs}{F#voyageuses} de passage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Je m'appelle Paimon ! Et {M#lui}{F#elle}, c'est mon compagnon de voyage, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Je vois. Je vais donc me présenter à mon tour en vertu du code de bienséance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001010,
					"content": "Ahem... Celui qui se tient devant vous n'est autre que l'Adepte maître des étoiles, mais mes fidèles me connaissent mieux sous le nom de « Céleste voleur d'étoiles ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001011,
					"content": "Je suis descendu de ma demeure céleste pour libérer le monde du mal, c'est là que le destin a jugé bon que nos chemins se croisent. Alors, parlez-moi donc de vos souhaits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001012,
					"content": "Nos souhaits ? Je pensais que les Adeptes de Liyue ne faisaient que combattre... Vous pouvez également exaucer les souhaits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Haha... Il y a différents rangs chez les Adeptes... Les étoiles ne sont-elles pas plus élevées que les montagnes, les nuages ou la lune ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001014,
					"content": "Cependant, il n'est pas digne d'un Adepte de faire l'apologie de ses propres pouvoirs. Vous pourriez d'abord vous entretenir avec mes fidèles, et ainsi vous faire votre propre idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Céleste voleur d'étoiles"
				},
				{
					"id": 111001007,
					"content": "Nous suivons également la trace des Adeptes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Je m'appelle Paimon ! Et {M#lui}{F#elle}, c'est mon compagnon de voyage, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "C'est donc le destin qui a voulu notre rencontre. Je devrais donc moi aussi me présenter, selon le code de bienséance des Adeptes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Céleste voleur d'étoiles"
				}
			]
		},
