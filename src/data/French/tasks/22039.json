					"Ogura Mio"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "On ne peut pas continuer comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Je suis désolée. Je me suis perdue dans mes pensées. Vous êtes ici pour du prêt-à-porter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Bien que la soie liyuéenne de haute qualité soit toujours en rupture, il nous faut quand même proposer de nouveaux kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Vous aviez l'habitude d'acheter la matière première à Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Oui, nous avons toujours pu nous procurer de la soie liyuéenne de haute qualité, comme de la soie de fleur de soie de la Guilde des marchands de Feiyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Cependant, étant donné la situation actuelle à Inazuma... nous n'avons pas été en mesure d'en importer depuis un moment. On a dû compter sur notre stock restant pour continuer de faire tourner la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Mais la soie s'utilise rapidement, alors notre stock s'amenuise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Au départ, je voulais concevoir des motifs originaux ou utiliser des teintures novatrices et créer de nouveaux tissus pour attirer la clientèle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Mais je n'ai pas réussi à trouver de teinture qu'on pourrait qualifier de « novatrice »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous qui en avez vu des choses, auriez-vous des suggestions de teintures novatrices ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Oui, j'ai quelques idées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "V... Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Pourriez-vous m'en apprendre plus et m'apporter des ingrédients qui peuvent être transformés en teintures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Je suis même prête à vous payer. Je vous en prie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Vous n'avez besoin que de teintures ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Dans ces circonstances, c'est la seule chose que je peux faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Si vous connaissez une matière première qui permet de fabriquer une teinture novatrice, merci de me l'apporter. Je préparerai de quoi vous payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
