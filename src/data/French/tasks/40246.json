			},
			"dialogs": [
				{
					"id": 402461101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461102,
					"content": "Euh, Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461103,
					"content": "Ne gâche pas ce moment. Sinon, je vais me mettre à penser à la fois où tu m'as téléportée dans un endroit au hasard alors que je t'avais clairement dit d'arrêter de faire ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461104,
					"content": "E—Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461105,
					"content": "Et... Coupez ! Bravo ! Bravo ! On l'a ! C'est exactement la fin que j'espérais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Producteur de films"
				},
				{
					"id": 402461106,
					"content": "... Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461107,
					"content": "Mais où étiez-vous passée, mademoiselle Columbina ? Vous avez disparu, et l'instant d'après, vous étiez de retour, en train de prendre dans vos bras cette, euh... nouvelle amie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "T—Tout ça... a été... filmé...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461109,
					"content": "Eh bien, le Kinétoscope tournait déjà, et tout s'est passé si vite, alors... Voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Attendez, ça doit être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Oui, ma meilleure amie. Celle que je cherchais. Je n'aurais jamais pensé pouvoir la revoir un jour. Je suis juste... tellement heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461112,
					"content": "En plus, le film connait une fin heureuse. Tout ça grâce à toi, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461113,
					"content": "... Sandrone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461114,
					"content": "Tu ne pouvais pas arrêter d'être agaçante, ne serait-ce qu'une seconde ?! Columbinaaaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
