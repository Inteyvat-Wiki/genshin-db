			},
			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, on est là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Oh, pile à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Eh bien, oui... Ce n'est pas nous qui avons bu l'équivalent de notre poids en alcool hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Héhé, quoi ? Tu insinues que mamie ne tient pas l'alcool ? Il en faut bien plus que ça pour me saouler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Vraiment ? Parce que, euh, vous avez commencé à dire n'importe quoi au bout d'un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "A—Ah bon ? Tiens, je ne m'en souviens pas. J'espère que je n'ai rien dit... de trop farfelu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Voyons voir... Vous avez passé une demi-heure à critiquer Ororon, une demi-heure à vous plaindre du travail, une heure à parler de romans légers... et, euh, je me suis endormie après ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "... Elles sont parties ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461209,
					"content": "Hein ? Ah, celles de l'équipe de tournage ? Oui, on les a croisées sur le pont, mais elles viennent de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Attendez, mais maintenant que tout est réglé de votre côté, qu'est-ce qui vous empêche d'aller voir Columbina ? Vous lui manquez beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Je... Je veux juste mettre de l'ordre dans tout ça d'abord. En plus, c'est l'occasion rêvée de lui faire une surprise pour une fois. Je dois encore bien réfléchir à tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461212,
					"content": "Mais bon, trêve de bavardages. Avez-vous réussi à localiser notre cible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461213,
					"content": "Bien sûr. Quand grand-mère Itztli promet quelque chose, elle tient toujours parole !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Bien, voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461215,
					"content": "La Région mortée... Un instant, c'est la Tour de la gestalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461216,
					"content": "L'endroit où les âmes ont été dissociées... Est-ce là que réside la source de la rancœur ? Ou s'agit-il plutôt de l'Ordo Narzissenkreuz tout entier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461217,
					"content": "Laissez-moi vous accompagner. Cette chose ne reste pas immobile. Si elle n'est pas à l'endroit prévu quand nous y arriverons, je pourrai utiliser un rituel pour l'invoquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Vous vous êtes déjà donné bien assez de mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461219,
					"content": "Ça ne me dérange pas. De toute façon, ces vieux os n'ont rien de mieux à faire. Ça ne me dérange pas d'invoquer un esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(En plus, si je n'y vais pas, je vais encore rater des blagues personnelles et je me sentirai exclue !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Très bien. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461222,
					"content": "Héhé, pas de temps à perdre. C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
