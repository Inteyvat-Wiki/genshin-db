				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2644.99,
							253.937,
							3639.558
						],
						"pointId": 8
					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "C—C'est terminé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Oui. Je vous avais dit que ce serait du gâteau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460903,
					"content": "Comment avez-vous fait ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "Cette créature n'avait rien d'exceptionnel. Il suffit de prendre un tas d'âmes sans refuge, d'y ajouter une pointe d'énergie malveillante, quelques impuretés, une bonne dose de rancœur, et voilà le résultat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460905,
					"content": "Tout ce que j'ai fait, c'est séparer les âmes d'origine du reste de cette souillure, afin qu'elles puissent être acceptées par les lois qui régissent actuellement le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460906,
					"content": "Le principe qui sous-tend la formule mondiale est celui de la « divergence ». Partant d'un point d'origine, elle déconstruit et reconstruit les possibilités du monde afin de trouver certaines réponses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460907,
					"content": "Il en découlerait donc que le calcul inverse de la formule mondiale nous permet au contraire d'atteindre la convergence et la restauration. J'ai pu y parvenir grâce à la matrice arithmétique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460908,
					"content": "Cela s'apparente au concept de réduction homologique en mathématiques. Je les ai ramenés à l'essence même de leur être, sans pour autant modifier leur nature profonde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460909,
					"content": "Ça voulait dire que... Hmph, peu importe. À en juger par vos visages inexpressifs, je suppose que cela ne vous intéresse pas vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460910,
					"content": "Je crois que je comprends enfin ce que ressentent les étrangers quand je leur parle sans fin de trucs de shaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "E—En tout cas, c'était vraiment impressionnant ! Vous êtes incroyable, Sandrone !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Héhé, vous venez seulement de vous en rendre compte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460913,
					"content": "Je n'en attendrais pas moins de celle qui défie toute raison ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Ahem, assez parlé de ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460915,
					"content": "N—Nous devrions y aller ! Je vais réinitialiser les mécanismes à l'intérieur de la tour. On se retrouve sur la terre ferme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
			"id": 4024610,
