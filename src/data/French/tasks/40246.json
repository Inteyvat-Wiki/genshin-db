			"dialogs": [
				{
					"id": 402460501,
					"content": "Hmm, toujours rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460502,
					"content": "Devrais-je commencer le rituel d'invocation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Vidons d'abord l'eau de cet étage de la tour. Ça nous permettra de nous déplacer plus facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460504,
					"content": "Attendez, on peut faire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Bien sûr. Alain et René avaient tous deux entrevu l'avenir qui attendait Fontaine, et ils ont même partagé quelques techniques pour l'étanchéité des bâtiments. En principe, cela repose sur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460506,
					"content": "... Hum, peu importe. Déverrouillez simplement les mécanismes dans l'ordre que je vais vous indiquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
