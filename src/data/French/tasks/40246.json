			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "#{M#Prêts}{F#Prêtes} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Oui. Quand cette chose apparaîtra, j'essaierai de parler aux âmes à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460703,
					"content": "Mais elles semblent déjà avoir perdu la raison. Si la communication échoue, nous allons devoir nous battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460704,
					"content": "Dans ce cas, je ferais mieux de trouver une cachette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Si un combat éclate, je porterai le coup de grâce. Faites-moi confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460706,
					"content": "Compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Bien. J'ai besoin d'un peu de silence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "... Esprits errants, emportés par les marées, écoutez-moi. Âmes brisées, réduites au silence, déchirées et abandonnées, suivez les traces du passé et revenez à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "... Que la rancœur reconnaisse la rancœur. Que les entités malfaisantes se rassemblent, et qu'en ce lieu, elles reprennent forme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(... Et maintenant ? C'est tout ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460713,
					"content": "(Hmph... C'est exactement pour ça que je m'en tiens aux mathématiques et pas à la magie. Comment peut-on savoir à quelle étape en est le sort ? C'est comme s'il n'y avait aucune logique.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460714,
					"content": "(La science mécanique, c'est tellement plus simple à...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460716,
					"content": "Attention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Ressentiment des âmes errantes"
				},
				{
					"id": 402460718,
					"content": "Hé, vous ! Ou quiconque se trouve en vous... J'ai besoin que vous m'écoutiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460719,
					"content": "Je suis une descendante d'Alain Guillotin, le maître-artificier de Fontaine. Je peux vous rendre votre intégrité et vous ramener vers les lignes énergétiques. Tout ce que vous avez à faire, c'est de coopérer avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Ressentiment des âmes errantes"
				},
				{
					"id": 402460721,
					"content": "Sandrone !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Tss... On dirait bien que discuter n'est pas une option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460723,
					"content": "D'accord, plan B... Il est temps de se défouler un peu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
