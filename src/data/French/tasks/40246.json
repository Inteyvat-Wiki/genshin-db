			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Columbina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3537.532,
							452.648,
							4178.716
						],
						"pointId": 16568
					},
					{
						"sceneId": 3,
						"position": [
							3538.825,
							452.648,
							4179.689
						],
						"pointId": 16573
					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Citlali a vraiment beaucoup bu hier soir, hein... Je me demande si elle est réveillée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460203,
					"content": "Ouah ! C—Columbina ! On peut dire que vous savez faire une entrée remarquée... Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "On vient de finir de tourner une scène de dernière minute, alors je suis montée prendre l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460205,
					"content": "Les autres sont encore en bas à discuter de la scène finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460206,
					"content": "Vous voulez dire, de la façon dont ça devrait se terminer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Oui. Ils ne savent pas si l'héroïne doit renouer avec sa vieille amie ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460208,
					"content": "Ah... Parce que le but, c'est justement qu'elle est venue dans le pays natal de son amie pour la retrouver, non ? J'avais presque oublié l'intrigue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Oui. La réalisatrice Furina et mademoiselle Chiori pensent qu'une fin tragique, où les deux personnages ne se rencontrent jamais, serait plus émouvante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460210,
					"content": "Mais le réalisateur Xavier estime que leurs retrouvailles rendraient la fin plus attendrissante et touchante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460211,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Moi ? Je... Je ne suis pas sûre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460213,
					"content": "Sur le plan personnel, bien sûr que j'ai envie de la revoir... J'ai évidemment envie de vivre ce moment où nous nous retrouvons... même si ce n'est que devant un Kinétoscope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460214,
					"content": "Mais ça veut dire... qu'une actrice devrait prendre sa place, et ça me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Ne vous inquiétez pas pour ça pour l'instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460218,
					"content": "Oui ! Ne soyez pas si inquiète ! Tourner un film, c'est avant tout pour s'amuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "E—Et puis, tout va s'arranger ! Vous pouvez me faire confiance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "S'arranger... Comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460221,
					"content": "Euh, eh bien... Vous savez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "#Je suis {M#sûr}{F#sûre} que ce sera une jolie fin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Oui ! Exactement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Ah... D'accord. Je vous fais confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460225,
					"content": "Pour l'instant, je vais simplement essayer de m'amuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460226,
					"content": "#Tiens, tiens, regardez qui voilà ! {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "#Ah, {M#le}{F#la} spécialiste de l'éclairage et l'assistante clap qui ont déserté leur poste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "#Euh, oui... On s'est en quelque sorte {M#absentés}{F#absentées} sans permission. Veuillez nous excuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Héhé, ne vous inquiétez pas. Tout se passe bien de notre côté, alors contentez-vous de faire ce que vous avez à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Merci pour votre compréhension...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Vous semblez être de meilleure humeur maintenant, mademoiselle Columbina. Je m'excuse si notre conversation de tout à l'heure vous a mise dans l'embarras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Ça va, je me sens mieux maintenant. {NICKNAME} et Paimon m'ont aidée à y voir plus clair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460234,
					"content": "Alors, que pensez-vous de la fin ? Devrions-nous les faire se retrouver ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "On devrait... tourner une jolie fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460236,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "On se rattrapera, c'est promis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
