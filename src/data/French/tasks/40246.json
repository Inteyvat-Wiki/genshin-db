					}
				]
			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "Eh bien, voilà une sacrée pagaille de réglée. Je suis contente que ce soit enfin terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461002,
					"content": "Ça fait du bien de faire une bonne action de temps en temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461003,
					"content": "Vous avez aussi beaucoup aidé à Nod-Krai ! On dirait bien que vous avez bon cœur, au fond !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Ha, je n'en suis pas si sûre. Je vais bientôt retourner chez les Fatui. Vous faites trop vite confiance aux gens, vous deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461005,
					"content": "En tout cas, on sait qu'on peut vous faire confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "#Hmph, très bien. Mais ne venez pas dire que je ne vous avais pas {M#prévenus}{F#prévenues} quand ça vous retombera dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461007,
					"content": "Bon, quelle est la prochaine étape ? On retourne au bateau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Oui ! Votre souci personnel et cette histoire de Narzissenkreuz, c'est réglé. Ça veut dire que vous pouvez désormais « voir les personnes que vous devez voir », n'est-ce pas, Sandrone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Tout le monde va être tellement heureux de vous revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Ha... Je n'aurais jamais osé l'avouer avant, mais... Oui. Tout le monde m'a vraiment manqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461011,
					"content": "Mais Columbina, c'est un cas à part ! Cette fois, je vais me venger d'elle pour toutes les fois où elle est venue m'embêter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
			"id": 4024611,
			"completionStepIds": [
				4024611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
