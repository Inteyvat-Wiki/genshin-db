					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "Alors ? Qu'est-ce que ça a donné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "#Oh ! Ce crabe m'a l'air bien bon. Vous êtes {M#doué}{F#douée} pour ça, à ce que je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Bien, on a tous les ingrédients qu'il nous faut. Au travail maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "#Je me prépare. {M#Voyageur}{F#Voyageuse}, attendez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216903,
			"completionStepIds": [
				7216904
			],
