				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Le nom de ce plat est vraiment du style de Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "C'est vrai, à première vue, je pensais que c'était un plat de Mondstadt. Je n'ai pas imaginé que c'était un plat d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "Je parie que c'est aussi bon que son nom l'indique, Xudong ! Allez, faisons ça, s'il te plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "On se retrouve !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "#Ah ! {M#Voyageur}{F#Voyageuse}, héhé, je vous ai dit qu'on se retrouverait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong vient de récupérer une nouvelle recette en ville, « Kourayaki d'œufs de crabe » ! Qu'est-ce que vous en pensez ? C'est un bon nom, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "Ce n'est pas un plat difficile à faire. Mais on a besoin d'une grande quantité de crabes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "J'ai déjà préparé des crabes ordinaires, mais j'ai encore besoin de... crabes spéciaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Des crabes spéciaux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "C'est ça. Pour être plus exact, on recherche les crabes qui habitent sous les cerisiers tonnerres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "On pourrait tout aussi bien les appeler « crabes foudroyés »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Hahaha, dans tous les cas, je suis curieux de connaître le goût des crabes qui vivent dans tels endroits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Mais... Nous n'avons pas osé nous approcher de ce cerisier tonnerre, car des éclairs tombaient sans cesse à côté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "Le livre indique que... comme j'ai mentionné, vous devez d'abord toucher la « branche de cerisier tonnerre » pour que quelque chose appelé « Électrogranum » vous accompagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "#Comme ça, vous ne serez pas {M#frappé}{F#frappée} par la foudre quand vous vous approcherez du cerisier tonnerre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Mais bon, vous avez vu à quoi ressemble cet arbre. Je ne vais pas prendre un tel risque en me basant sur un résumé aussi approximatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Et si on court assez vite, ça ira, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Ça va pas ? On ne peut pas courir aussi vite qu'un éclair, voyons !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Et pourquoi ne pas utiliser une branche pour récupérer les crabes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "À mon avis, on devrait creuser une tranchée pour évacuer l'eau et attirer les crabes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Hahaha... Vous avez chacune des idées, c'est très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "#Si cela ne vous dérange pas, {M#voyageur}{F#voyageuse}, pourriez-vous nous aider à attraper quelques-uns des crabes qui vivent sous ce cerisier tonnerre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Si vous y arrivez, je vous préparerai un grand festin en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Ah oui, attendez un instant... Prenez ces appâts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Si vous voulez attraper des crabes là-bas, commencez par utiliser ces appâts pour les attirer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Cela devrait être plus facile pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Je me demande vraiment quel goût ont les crabes qui vivent près du cerisier tonnerre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Encore des plats délicieux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
		{
			"id": 7216902,
