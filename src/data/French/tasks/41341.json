							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "#Euh... Bonjour, euh... {M#monsieur le client}{F#madame la cliente}... Si vous voulez bien vous asseoir ici et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410203,
					"content": "#On est {M#venus}{F#venues} t'offrir une lanterne céleste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "... Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410205,
					"content": "Petit Yu, tiens. C'est pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "Mengmeng ? C'est toi qui l'as faite ? Merci, c'est trop gentil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410207,
					"content": "#Oui, c'est {M#lui}{F#elle} qui m'a appris ! C'est pas super bien fait, je sais... Est-ce que... tu aimes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "Elle est trop top, cette lanterne ! Je l'adore. En plus, j'étais inquiet parce que j'ai pas encore eu le temps d'en faire une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410209,
					"content": "Merci, Mengmeng. Je vais trouver quelqu'un pour l'accrocher au-dessus de la porte tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410210,
					"content": "Pourquoi demander de l'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Euh... Mon papa, il est toujours malade, il peut pas accrocher la lanterne. Et puis, je suis trop petit, je ne suis pas assez haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410213,
					"content": "Si je veux la mettre au-dessus de la porte, je dois demander à quelqu'un de m'aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410214,
					"content": "Je vais t'aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "Vraiment ? Super ! Ça m'ennuyait de quitter la boutique pour chercher quelqu'un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410215,
					"content": "Laisse-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Ton papa ne peut pas t'aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "Oh, cette lanterne céleste est super jolie ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410402,
					"content": "Bon, Petit Yu... On va jouer ? J'ai trouvé un endroit où il y a plein de jolies fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "#Et aussi, {M#le monsieur}{F#la madame} m'a appris comment faire des lanternes célestes. On peut y aller et je te montre, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "Non... Je peux pas. Je dois m'occuper de la boutique. Papa m'a dit qu'il faut nettoyer même quand il y a pas de clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410405,
					"content": "Ou alors... On fait pas les lanternes, et on va juste discuter un peu, t'en penses quoi ? Et puis on revient vite, comme ça il n'y a pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410407,
					"content": "Je peux t'aider à nettoyer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "Ah ? Vraiment ? Mais je... Je peux pas, c'est trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410410,
					"content": "On reste pas, et on revient vite. Comme ça, ça prendra pas beaucoup de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "#Merci à vous, {M#monsieur}{F#madame} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "Pour le ménage, laisse-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "On dirait qu'ils sont encore en train de jouer... Pas la peine de s'inquiéter alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "Ils sont tout mimi comme ça... Peut-être qu'on devrait les laisser tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "Je me demande ce qu'ils se racontent...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Et si je fais une lanterne céleste pour ton papa, ça l'aidera à guérir plus vite, tu crois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "Je sais pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410707,
					"content": "Dans les livres, ils disent qu'on peut guérir plus vite quand on est content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "Moi, je pense que ton papa, il doit être très content... Parce que tu es super fort, tu l'aides tout le temps dans la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "Mais... Papa me dit aussi « Reste pas tout le temps dans la boutique, va jouer dehors. » ou des trucs comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410710,
					"content": "« Si tu vas pas voir Mengmeng, elle va cueillir toutes les fleurs du coin. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410711,
					"content": "Il y a trop de fleurs ici, comment je pourrais toutes les cueillir... Attends, je vais te faire une couronne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Merci, Mengmeng. On devrait rentrer maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Petit Yu"
				},
				{
					"id": 413410713,
					"content": "D'accord... Mais quand ton papa ira mieux, tu auras plus de temps, non ? On pourra rejouer ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410714,
					"content": "Oui... Papa va aller mieux, j'en suis sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Petit Yu"
				},
				{
