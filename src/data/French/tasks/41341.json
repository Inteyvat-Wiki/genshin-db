			"trigger": {
				"objectNames": [
					"Mengmeng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "C'est quand même pas facile à faire, ces lanternes célestes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#Vous savez comment faire des lanternes, {M#monsieur}{F#madame} ? J'essaye depuis tout à l'heure, mais j'y arrive pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Par le trou, puis on tourne sur la gauche et puis... Soit je fais tout tomber, soit le fil casse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "Je voulais vraiment faire une lanterne céleste pour Petit Yu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Petit Yu doit s'occuper de la boutique de thé. Il a pas le temps de jouer ou de faire une lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "Mais je suis sûre qu'il a aussi un souhait qu'il aimerait faire, c'est pour ça que je voulais lui donner une lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "Je peux en faire une pour toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Mais... J'voulais en faire une moi-même pour la donner à Petit Yu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "Et puis, j'ai envie de savoir comment on fait, pour lui raconter plus tard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "Vous... Vous pouvez m'apprendre à en fabriquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "Bon, comme ça... et c'est prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "Encore merci ! Venez, on va la donner à Petit Yu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "Je peux en faire une pour lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
