			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Francis m'a contactée pour confirmer la bonne réception des marchandises. Je vous en dois une !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "Déjà ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Haha, ça vous en bouche un coin, hein ? Vous savez, les mercenaires comme moi, on est bien plus rapides que la moyenne. Tout comme nos communications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "C'est grâce à vous que ce contrat a été mené à bien. Juste pour que vous le sachiez, je suis pour la rémunération en conséquence de toute tâche. Alors donnez-moi un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "Vous ne faites pas de pause pendant le festival ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "Dans notre métier, on ne sait jamais quand il y aura du travail... Je ne peux pas donc pas rentrer pour le Festival des lanternes, c'est comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "Vous aimez voyager, non ? Vous devriez vous rendre à Liyue pour faire l'expérience du festival : tout le monde y lâchera des lanternes célestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "Et vous, alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Moi ? Je suis généralement en déplacement à cette période de l'année. Alors, je n'ai jamais le temps d'en lâcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "C'est vrai qu'en lâcher une pour attirer la bonne fortune ne ferait pas de mal, mais je n'aurai jamais le temps d'en faire une...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160513,
					"content": "Je rate un peu les festivités, c'est sûr, mais bon, ça n'a pas plus d'importance que ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160514,
					"content": "Pourquoi ne pas me laisser vous en fabriquer une ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "Hein ? Vous voulez en faire une pour moi ? Vous êtes vraiment... quelqu'un de gentil, dis donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160515,
					"content": "Laissez-moi faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "Avez-vous déjà lâché une lanterne cette année ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "Pas encore... Vous savez, en tant que mercenaire, je n'ai pas vraiment le temps pour ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
