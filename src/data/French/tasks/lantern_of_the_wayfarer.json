	"talks": [
		{
			"id": 7181601,
			"completionStepIds": [
				7181601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181601",
							"2"
						],
						"stepId": 7181601,
