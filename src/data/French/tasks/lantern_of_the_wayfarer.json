			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Voilà, c'est là qu'il a stocké ses marchandises. Bon, vous avez proposé de m'aider, alors escortez ce ballon de transport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "Par contre, je vous préviens : ce sont des matériaux pour la fabrication de lanternes célestes, donc c'est fragile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "Si on les abime ou les laisse brûler, ça n'ira pas, alors attention en chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "On va rencontrer des monstres et des Pilleurs de trésors en chemin, alors tenez-vous sur vos gardes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Bon, à vous de jouer ! Assurez-vous simplement que les marchandises arrivent bien jusqu'à Francis, et vous pourrez venir me retrouver sur le pont au sud-ouest de la Falaise Chihu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181603,
