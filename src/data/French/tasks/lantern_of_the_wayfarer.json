				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Oh, ce sont... les marchandises que j'avais commandées... Nom d'un petit Archon, elles sont enfin là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "#À en juger par votre style vestimentaire, mon {M#ami}{F#amie}, vous ne devez pas non plus être originaire de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "#Ah, mon {M#ami}{F#amie}, je ne sais pas si vous avez eu le privilège de goûter les délices de Liyue, mais ils sont tout simplement succulents ! Croyez-moi, ça vaut le détour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "Bon, maintenant que mes marchandises sont arrivées, je peux retourner profiter de mon repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
			"completionStepIds": [
				7181610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
