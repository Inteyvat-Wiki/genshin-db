				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "Mais comment je vais bien pouvoir livrer tout ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "Qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "#Oh, c'est vous, {M#voyageur}{F#voyageuse} ! Vous arrivez pile-poil pour le Festival des lanternes, vous avez de la chance. Moi, par contre, ça ne pourrait pas être pire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "Nous autres, Liyuéens, avons l'habitude de lâcher des lanternes célestes pendant le festival. Donc, chaque année, les livraisons de matériaux s'enchaînent à cette période.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "Peut-être que c'est juste mon imagination, mais j'ai l'impression que cette année, il y a encore plus de cargaison que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "Il y en a trop pour moi... Et mon client de Fontaine ne connaît rien à Liyue et n'arrête pas de me relancer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "J'aimerais avoir quelqu'un pour me donner un coup de main, mais je ne trouve personne. Ça vous dirait, ce type de mission d'escorte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "#Je suis {M#partant}{F#partante}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Bien ! J'aime les gens qui sont directs. Si seulement la personne à protéger était comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "C'est quoi son nom, déjà ? Fran-quelque chose... Ah, Francis ! Franchement, les noms étrangers et moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "Si vous êtes d'accord, retrouvez-moi là où il a stocké les marchandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "J'ai même fait une marque sur votre carte, comme ça, vous trouverez facilement. Bon, j'y vais et on se retrouve plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "Un marchand de Fontaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "Oui. Fran-quelque chose... Ah, Francis ! Franchement, les noms étrangers et moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "Je ne sais pas ce qu'il veut faire de tous ces matériaux à lanterne, mais bon... Du moment qu'il paie, je bosse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "Et puis, vous aurez votre part quand on aura fini. Faites-moi confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
