				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Monsieur Kayvan, réessayez avec le nouvel appât.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "J'ai essayé maintes fois, mais le résultat est toujours le même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Hein ? Pourquoi vous pêchez encore ensemble, vous deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "#{M#Voyageur}{F#Voyageuse}, on se retrouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Bonjour à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Avez-vous découvert pourquoi vous n'arriviez pas à sortir le moindre poisson ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Haha, pas du tout. Ce chercheur et moi avons essayé d'améliorer ma canne à pêche, mes appâts et ma méthode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "De plus, on a aussi essayé de nombreux plans d'eau et de nombreux angles... Il m'a même fait pêcher dans un étang plein de poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Mais après tous ces efforts, je continue à pêcher toute sorte de choses, sauf des poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Ne vous inquiétez pas, monsieur Kayvan. Ce chercheur vous a promis de continuer ses recherches, n'est-ce pas ? Il vous aidera sûrement à découvrir la raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Regardez, il a conçu un nouvel appât pour vous et m'a envoyée vous accompagner pour noter les détails de votre pêche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "J'espère vraiment qu'il pourra trouver... En attendant, je vais pêcher à ma façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous être libre, aidez-moi donc à chercher des ingrédients pour mon appât.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Avez-vous obtenu quelque chose du chercheur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
