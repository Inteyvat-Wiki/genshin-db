					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "Il me faut un bon début...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160102,
					"content": "Encore vous ? Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Ah, c'est vous. J'écris un nouveau roman... Enfin, j'essaye. Je sèche sur l'introduction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160104,
					"content": "Je me creuse les méninges depuis un moment, mais toujours rien. À cette vitesse, je n'aurai jamais fini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160105,
					"content": "Mais j'y pense... Vous avez voyagé et avez pas mal d'expérience, non ? Qu'est-ce qui fait un bon roman d'après vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
