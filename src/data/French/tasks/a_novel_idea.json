			"dialogs": [
				{
					"id": 221161801,
					"content": "Alors ? Qu'est-ce que ça a donné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221161802,
					"content": "Tenez, j'ai noté ceci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "Ah ! Montrez-moi ça... Oui... Ça manque un peu de force, mais ce sont des enfants après tout. Il y aurait peut-être matière à romance en revenant d'ici quelques années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221161804,
					"content": "Enfin je vais quand même y réfléchir ; ça pourrait tout de même avoir une place dans un roman... ou tout du moins servir de référence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221161805,
					"content": "Et prenez ceci en échange, pour vous remercier. Maintenant je m'en vais réfléchir à ce que je vais pouvoir en tirer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
