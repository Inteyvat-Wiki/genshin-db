			"dialogs": [
				{
					"id": 221161201,
					"content": "Lulu, c'est au tour de Fei d'être le capitaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 221161202,
					"content": "Oui, ça fait déjà plein de fois qu'on le dit, et c'est toujours moi qui fais le marin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161203,
					"content": "Mais c'est toujours plus rigolo pour tout le monde quand c'est Petit Meng le capitaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 221161204,
					"content": "Lulu, enfin... Fei le joue super bien aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 221161205,
					"content": "On est tous bien dans notre rôle... Toi tu es le capitaine, moi le riche marchand, et Fei le second !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 221161206,
					"content": "C'est pas vrai que c'est plus rigolo ? Et ça va être super cette fois-ci, pas vrai Fei ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 221161207,
					"content": "Lulu, tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 221161208,
					"content": "Puisque Lulu le dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161209,
					"content": "Fei, enfin, on en a déjà parlé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 221161210,
					"content": "C'est rien, c'est rien ! Du moment que Lulu s'amuse, c'est pas très grave. Allez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161211,
					"content": "Capitaine ou pas, je m'en fiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161212,
