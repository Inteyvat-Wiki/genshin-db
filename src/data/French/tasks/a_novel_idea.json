			"dialogs": [
				{
					"id": 221161101,
					"content": "Chaoxi... Tu es enfin rentré ! Je viens juste d'apprendre à cuisiner un plat formidable, viens avec moi ! Je te le ferai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Ah, Sisi... Je viens juste d'arriver, et je suis épuisé, mentalement et physiquement. Je ne souhaite qu'une chose : me reposer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Bien sûr ! Tu le mérites après tout ce travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "Alors... Quand tu auras fini de te reposer, on discutera, d'accord ? On peut prendre rendez-vous maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Oui, oui, pourquoi pas. C'est juste que... Je ne peux pas vraiment décider d'une date tout de suite. Non, je n'essaye pas de trouver une excuse... C'est juste que je ne veux pas faire de promesse que je ne pourrai pas tenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "*soupir* Je suis un marin, Sisi, et l'océan est ma compagne. Tu mérites mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Chaoxi, s'il te plaît, ne parle pas comme ça... Je te comprends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
