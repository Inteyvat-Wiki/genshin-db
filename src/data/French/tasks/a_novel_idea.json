			"dialogs": [
				{
					"id": 221160901,
					"content": "Ah, et il y a au port trois enfants qu'on voit jouer souvent ensemble, Lulu, Petit Meng et Fei. Ça vous parle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160902
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160902,
					"content": "Ce ne sont que des enfants, mais... qui sait si à eux trois ils n'ont pas d'histoire qui vaille le détour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160903
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160903,
					"content": "Allez jeter un œil, d'accord ? Et si vous trouvez quelque chose qui puisse m'inspirer, revenez me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
