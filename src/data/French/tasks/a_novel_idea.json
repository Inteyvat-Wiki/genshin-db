			"dialogs": [
				{
					"id": 221161001,
					"content": "Bien le bonjour, Qiming ! Aujourd'hui, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161002
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161002,
					"content": "Aujourd'hui n'est pas un bon jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161003,
					"content": "Hein ? Mais... Je n'ai pas fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161004,
					"content": "Pas la peine. Je sais ce que vous vous apprêtez à dire, et aujourd'hui n'est point le bon jour pour cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161005,
					"content": "Ah... Alors quand ? Ou alors vous pourriez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161006,
					"content": "Quand le jour sera le bon, alors l'occasion sera là, faites-moi confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161007,
					"content": "Euh, ça ne veut rien dire ! Qiming, écoutez-moi, je vous en prie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161008
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161008,
					"content": "Au suivant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161009
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161009,
					"content": "Je n'ai encore rien dit ! Et puis il n'y a personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
