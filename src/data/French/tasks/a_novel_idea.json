			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "Lors de ma dernière visite en ville, j'ai vu un homme parler à une jeune dame, qui avait l'air d'être une diseuse de bonne fortune. Il avait l'air impatient, mais je n'ai pas pris le temps d'écouter plus que ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160702,
					"content": "Je me suis renseigné par la suite ; il s'avère que l'homme s'appelle Zhihua, et la femme Qiming. On dirait bien qu'il y aurait matière à récit... Pourquoi ne pas aller vous enquérir de leurs histoires ? Si vous trouvez que ça a quoi que ce soit d'intéressant, revenez me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Tenez, d'ailleurs, connaissez-vous une fille nommée Sisi par hasard ? Elle traîne souvent du côté du port, et attend un marin nommé Chaoxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160802,
					"content": "Si mes souvenirs sont bons, elle va régulièrement l'attendre. Je me demande quelle histoire se cache derrière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160803,
					"content": "Si vous pouvez, allez voir de quoi il retourne. Sait-on jamais, peut-être leur histoire vaut la peine d'être narrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
