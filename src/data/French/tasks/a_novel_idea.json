			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Des combats épiques et du suspens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Des combats épiques, du suspens... Pas faux, c'est vrai que c'est ce qui plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160303,
					"content": "Mais ça va être dur pour moi de trouver de l'inspiration sur ce sujet au Village de Qingce... Il ne s'y passe jamais rien de semblable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160304,
					"content": "Il va falloir que j'aille chercher ailleurs... Je sais ! Il paraît qu'il y a plein d'aventuriers en dehors des villes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160305,
					"content": "Qui cherchent des trésors, et combattent les monstres qu'on y trouve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160306,
					"content": "Et je connais justement l'endroit parfait. Plein de monstres. On n'a qu'à y aller et patienter jusqu'à ce que débarque un aventurier pour leur donner une leçon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160307,
					"content": "Et après, j'aurai mon histoire, héhéhé... Bon, ce n'est pas tout près, j'y vais de ce pas. Rejoignez-moi vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "Parfait... Cette fois je sais vraiment ce que ça fait que d'être pris dans un combat épique ! Hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160502,
					"content": "Je croyais que vous vouliez juste observer à distance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "En effet, c'est ce que je voulais faire au début. Mais aucun aventurier n'est venu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160504,
					"content": "Et les monstres avaient l'air prêts à partir... Et sans monstres, je serais venu pour rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160505,
					"content": "Alors j'ai... lancé une pierre pour voir, comme dans les romans, vous voyez ? Pour attirer leur attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160506,
					"content": "Manque de pot, la pierre a atterri juste sur la tête d'un des monstres... La suite vous la connaissez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160507,
					"content": "Enfin, tout est bien qui finit bien. Quelques bleus valent bien une histoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160508,
					"content": "Je sens la muse m'habiter ! Enfin, l'inspiration ! Oh, et tenez, prenez ceci pour vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 221160509,
					"content": "Haha ! Je sens que l'angoisse de la page blanche est finalement partie ! Il faut que j'y aille, tant que ça dure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
