			"dialogs": [
				{
					"id": 221160201,
					"content": "Il faut du cœur, de l'âme !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160202
					]
				},
				{
					"id": 221160202,
					"content": "Assez avec ce genre de balivernes, allez... Je suis sérieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
