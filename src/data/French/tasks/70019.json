						700190102
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700190102,
					"content": "Mimi tomo. Mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190103,
					"content": "Yoyo mani mi ? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190104
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700190104,
					"content": "Il dit qu'il ne veut plus voir le soleil, qu'il veut dormir et ne plus se réveiller, qu'il veut mourir... Qu'est-ce qui le fait donc tant souffrir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700190106,
					"content": "Hmm, donnons-lui ce qu'il veut, ça devrait le réconforter, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
