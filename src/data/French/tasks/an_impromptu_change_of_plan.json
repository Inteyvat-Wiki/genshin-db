			"dialogs": [
				{
					"id": 10020501,
					"content": "Excusez-moi, nous avons été importunés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020502,
					"content": "Eh bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020503,
					"content": "Grotesque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020504,
					"content": "GROTESQUE !!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020505,
					"content": "Les Sept Étoiles me déçoivent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020506,
					"content": "Comment ont-elles pu laisser quelqu'un assassiner le Souverain de la Roche pendant la cérémonie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020507,
					"content": "Et oser en faire porter la responsabilité sur quelqu'un du public ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020509,
					"content": "#{M#Voyageur}{F#Voyageuse}, je suis au courant que vous avez été injustement {M#accusé}{F#accusée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020510,
					"content": "Et j'ai mon idée sur le vrai coupable, mais je dois consulter mes pairs pour confirmer mon intuition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020511,
					"content": "Partez. Prenez avec vous votre talisman de permission, et aidez-moi à faire passer un message.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020512,
					"content": "Qui devrai-je voir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "Où devrai-je aller ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "Taille-Monts et Souffle-Nuages se trouvent souvent ici. Seul le destin décidera si vous les trouverez – seul le destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020515,
					"content": "Le Gardien Yaksha qu'on appelle aussi Dompteur de démons se trouve aux environs de l'Auberge Wangshu. Rendez-vous-y et cherchez-le là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grave-Lune"
				}
			]
		}
	]
