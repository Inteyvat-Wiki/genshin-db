			"dialogs": [
				{
					"id": 10020201,
					"content": "Qui ose pénétrer dans l'enceinte sacrée du Karst Jueyun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020202,
					"content": "#J'ai été {M#envoyé}{F#envoyée} ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Regardez ça, s'il vous plaît...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "Un talisman de permission... Cela fait des années qu'on n'en a pas vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020205,
					"content": "Vous vous tenez en présence de Grave-Lune, lui-même. Quelle est la raison de votre présence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020206,
					"content": "En fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020207,
					"content": "#C'est l'assassin ! {M#Il}{F#Elle} a osé fuir au Karst Jueyun !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Instructeur des Millelithes"
				},
				{
					"id": 10020208,
					"content": "Chef, vous êtes sûr qu'on peut mettre les pieds ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Soldat des Millelithes"
				},
				{
					"id": 10020209,
					"content": "#O—On n'a pas le choix ! Notre priorité est de capturer {M#ce criminel}{F#cette criminelle} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Instructeur des Millelithes"
				},
				{
					"id": 10020210,
					"content": "... Troubler nos frontières...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "Grave-Lune"
				},
				{
					"id": 10020211,
					"content": "Renvoyez-les d'où ils viennent. Je ne tolèrerai aucune interruption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grave-Lune"
				}
			]
		},
		{
