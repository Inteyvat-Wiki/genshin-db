				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Waouh, vous combattez vraiment d'une manière singulière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100202,
					"content": "On m'a dit que les détenteurs d'yeux divins pouvaient sentir la présence des élément. Je crois qu'on appelle ça la « vue élémentaire »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100203,
					"content": "Malgré le fait que vous n'en avez pas, êtes-vous capable d'une telle chose aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100204,
					"content": "J'ai aperçu quelque Blobs dans les environs. Pourriez-vous me montrer comment vous utilisez cette vue élémentaire en retrouvant leur trace ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Comme je ne possède pas d'œil divin, je n'ai pas pu constater l'usage de votre vue élémentaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100302,
					"content": "Je suppose que c'est normal après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100303,
					"content": "Merci quand même de m'avoir montré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100304,
					"content": "*soupir* J'aimerais tellement avoir un œil divin aussi, de type Électro de préférence. Ça serait génial, je pourrais me défendre avec et avoir la classe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100305,
					"content": "Mais c'est des moins probables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100306,
					"content": "#Je suis {M#sûr}{F#sûre} que vous y parviendrez avec des efforts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "Hélas, ça ne marche pas comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100308,
					"content": "Vous ne le saviez pas ? Personne n'a obtenu d'œil divin de type Électro depuis environ un an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100309,
					"content": "Les sages de l'Académie se sont penchés sur la question et ils en ont conclu qu'il s'agissait de la volonté de l'Archon Électro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100310,
					"content": "D'ailleurs, cette divinité a promulgué un « décret de saisie » qui vise à confisquer tous les yeux divins sur le territoire d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100311,
					"content": "Les détenteurs qui résistent sont sévèrement punis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100312,
					"content": "Je voulais voyager à Inazuma pour mes recherches, mais il en est hors de question à présent. Ça a l'air trop dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100313,
					"content": "Ça passe encore, non ? Vous n'avez pas d'œil divin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "Ne dites pas ça ! Les détenteurs d'yeux divins ont la vie dure, mais imaginez pour ceux qui n'en ont pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100315,
					"content": "Je vais terminer mes recherche à Liyue paisiblement avant de rentrer à l'Académie de Sumeru avec mes découvertes dès que possible. On me passera un savon si je tarde trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100316,
					"content": "Ah oui, prenez cette récompense pour m'avoir aidée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100317,
					"content": "Je vais terminer cette fichue thèse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		}
	]
}