			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "Comment suis-je censée rédiger cette thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100102,
					"content": "Qu'est-ce qu'il vous arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Je... Oh, c'est vous ! Vous vous souvenez de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100104,
					"content": "Je suis celle qui a été enfermée dans une cage par les Pilleurs de trésors à la Passe de Lingju. Haha, merci de m'avoir sauvée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100105,
					"content": "Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "Après que vous m'ayez sauvée, je me suis rendue à l'Auberge Wangshu à la recherche de Soraya. Par un coup de chance, je l'ai bel et bien trouvée là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100107,
					"content": "Elle est si gentille ! En plus de m'inviter à manger un repas, elle m'a aussi aidé à réorganiser mes notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100108,
					"content": "Mais d'après elle, mon sujet de thèse a déjà été fait à toutes les sauces à l'Académie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100109,
					"content": "Il n'y a aucune chance qu'on valide ma thèse à moins qu'elle soit excellente. Soraya m'a conseillé de changer d'angle, et d'aborder la question du point de vue des éléments, par exemple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100110,
					"content": "Mais je ne possède pas d'œil divin, alors je ne sais pas par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100111,
					"content": "Alors je me suis dit que j'allais tenter ma chance ici, et sur un malentendu, peut-être que je trouverai quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100112,
					"content": "Hé, mais attendez. Lorsque vous m'avez sauvée, vous vous battiez d'une manière particulière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100113,
					"content": "#Êtes-vous {M#détenteur}{F#détentrice} d'un œil divin, à tout hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100114,
					"content": "Non, je n'en ai pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "Comment est-ce possible ? Pourtant, vous vous battez bien avec des pouvoirs élémentaires, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100116,
					"content": "Oubliez, je suis sûre que c'est compliqué à expliquer... mais j'aimerais vous demander un service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100117,
					"content": "Pourriez-vous me montrer votre façon de combattre ? Je relèverai peut-être quelque chose en rapport avec mon sujet de thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100118,
					"content": "Aidez-moi, je vous en prie ! Si je ne finis pas cette thèse, je suis cuite à mon retour à l'Académie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100119,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "#Vous êtes {M#génial}{F#géniale} ! Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100121,
					"content": "Je crois avoir vu un groupe de Brutocollinus pas loin. Montrez-moi de quel bois vous vous chauffez sur eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100122,
					"content": "Comment c'est l'Académie ? Ça fait peur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Oui, et pas qu'un peu ! Je me réveille en larmes dès que je fais des cauchemars à ce sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100124,
					"content": "Je préfère encore passer le restant de mes jours dans cette cage plutôt que faire cette soutenance de thèse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100125,
					"content": "Bref, n'en parlons plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100126,
					"content": "Je crois avoir vu un groupe de Brutocollinus pas loin. Montrez-moi de quel bois vous vous chauffez sur eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181002,
