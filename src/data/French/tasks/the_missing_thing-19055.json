			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, toutes mes excuses une fois de plus. Je suis vraiment désolé de ne pas avoir été honnête avec vous, mais je... n'avais pas le choix d'agir ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Je comprends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "Au fait, est-ce que Kokomi est au courant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Son Altesse ? Disons juste que la guerre a apporté beaucoup de mauvaises choses et nous a beaucoup fait grandir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Alors, elle est au courant ou pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "#Eh bien... Vous n'êtes pas {M#curieux}{F#curieuse} de savoir qui a fait pression pour le nouveau projet de loi sur les marchandises ? Cela ne peut pas être la Commission économique, vu que cela ne leur profite pas directement et que l'on n'a pas de connaissances là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "C'est vrai, ça. C'est comme si une main divine était soudainement venue à votre secours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Haha, une main divine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Il y a quelque temps, l'Île de Narukami a accueilli la tenue du Festival Irodori. Son Altesse Sangonomiya et moi avons également été invités à y assister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "À ce moment-là, j'étais sur la place du marché en train d'attendre pendant que Son Altesse Sangonomiya allait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
