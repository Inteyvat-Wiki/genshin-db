			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tokuda",
					"Todoroki",
					"Masashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "Vos informations étaient exactes, Todoroki. Au moment où on est arrivés, ces Nobushis étaient toujours endormis, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "On les a tous attrapés et on a récupéré les biens, ils sont tous ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Je vais faire le compte... Hmm... Aucun problème, merci pour votre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Allons, allons ! C'est grâce au travail ardu de votre caravane marchande que les prix des céréales ont pu baisser au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "C'est vrai. Quant à nous, les vétérans, qui aurait cru que les blessures que la guerre a laissées sur nous seraient si graves ? Heureusement, vous avez ramené des médicaments qui ont permis de sauver des vies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Grâce au soutien d'en haut, les choses ont changé pour le mieux. Quelle est la situation des stocks dans le village ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Je confirmerai ça ce soir. Je partirai tôt demain matin pour demander des instructions au général Gorou après être allé à Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Pas d'inquiétude, Todoroki. La liste est déjà prête. Venez avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
