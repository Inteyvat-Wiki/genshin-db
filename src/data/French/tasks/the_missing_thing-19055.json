			"dialogs": [
				{
					"id": 190551701,
					"content": "Voir dame Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "C'est exact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "Elle est allée à la rencontre de dame Miko à la Commission économique, officiellement pour parler de romans légers, mais elles ont abordé d'autres sujets qui n'ont pas été rendus public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Dès son retour, nous avons pris des mesures pour stimuler le commerce, et il y a eu rapidement une impulsion pour lancer le nouveau projet de loi sur les marchandises sur l'Île de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
					"content": "Alors, pensez-vous que Son Altesse Sangonomiya est au courant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
