			},
			"dialogs": [
				{
					"id": 220300201,
					"content": "C'est ici. Les deux groupes de monstres se sont installés des deux côtés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Je suis déjà venu ici en reconnaissance. Les monstres du camp de gauche sont faibles, mais nombreux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "Les monstres du camp de droite sont un peu moins nombreux, mais ils sont exceptionnellement forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Je vous laisse le soin d'éliminer un de ces groupes de monstres. Je m'occuperai de l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
