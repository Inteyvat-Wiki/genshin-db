			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "Merci ! Ces ingrédients sont encore utilisables, mais nous ne pouvons pas attendre plus longtemps... Je vais commencer à cuisiner maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "C'est fait. Pfiou... C'est grâce à vous que j'ai pu réussir ce plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "Vous êtes un vrai perfectionniste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Naturellement. Qu'il s'agisse de l'arrangement floral, de la cérémonie du thé, de la cuisine ou de l'art de l'épée, si vous ne cherchez pas la perfection, tout cela perd de son sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "Je vis selon la philosophie de l'extrême. Sieur Xudong voit les choses différemment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Il m'a raconté un jour qu'il existait un concept à Liyue, appelé « le juste milieu ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
