		{
			"id": 2203006,
			"completionStepIds": [
				2203011
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203011",
							"2"
						],
						"stepId": 2203011,
