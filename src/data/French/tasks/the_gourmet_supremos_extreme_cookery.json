			"dialogs": [
				{
					"id": 220300301,
					"content": "Je vais aller à droite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Je m'en remets à vous. Je vais m'occuper de l'autre camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "Pourrez-vous les affronter seul ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "Ce ne sont que quelques monstres, pas de quoi paniquer. Si je ne m'inquiétais pas pour les ingrédients, j'aurais pu m'en occuper seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "Retrouvez-moi une fois que vous aurez vaincu les monstres et obtenu les ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "Nous devons agir vite. Si les ingrédients sont mauvais, je crains que le plat ne soit pas aussi appétissant que prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
