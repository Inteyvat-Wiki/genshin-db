			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "Nous nous retrouvons à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300102,
					"content": "Pardonnez-moi d'être si abrupt, mais j'ai une faveur à vous demander aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300103,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "Depuis que j'ai été engagé par sieur Xudong, j'ai commencé à voyager avec son groupe et lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300107,
					"content": "Je voudrais lui faire un cadeau pour le remercier de m'avoir accueilli parmi eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300108,
					"content": "Mais sieur Xudong préfère la nourriture aux arts martiaux, alors je voudrais lui cuisiner un plat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300109,
					"content": "J'ai déjà trouvé deux endroits pour des ingrédients et j'avais prévu d'attendre qu'ils mûrissent avant de les cueillir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300110,
					"content": "Cependant, deux groupes de monstres occupent ces lieux, et ils ont tout pris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300111,
					"content": "Pour le plat que je prépare, il est essentiel que les ingrédients soient frais. J'avais donc prévu de prendre d'abord les ingrédients d'un endroit et puis d'aller à l'autre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300112,
					"content": "Mais maintenant que les monstres s'en sont emparés, je dois me procurer ces deux ingrédients rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300113,
					"content": "Mais je ne peux pas être à deux endroits à la fois. Si je peux m'occuper des monstres d'un endroit, il n'y aura plus rien à l'autre endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300114,
					"content": "Je vous demande donc de vous joindre à moi pour vaincre ces monstres et récupérer les ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300115,
					"content": "Bien sûr, allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Merci, je vous en suis reconnaissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300119,
					"content": "Eh bien... Inutile d'en parler ici, venez parler avec moi plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300117,
					"content": "Pourriez-vous me faire goûter votre plat quand il sera prêt ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "#Évidemment, vous serez {M#le premier}{F#la première} à y goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300104,
					"content": "Pas besoin d'être si poli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Je suis en train de solliciter votre aide. La courtoisie est évidemment de mise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
