				"objectNames": [
					"Nacker"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Initialement, cet endroit était l'École des applications horlogoïdes fondée par monsieur Butor, une référence absolue dans le domaine des machines horlogoïdes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Néanmoins... D'un point de vue scientifique, le développement et l'amélioration des machines horlogoïdes traditionnelles ont atteint leurs limites. Leurs inconvénients étaient évidents en pratique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Ainsi, les recherches de monsieur Butor ont progressivement été marginalisées au sein de l'Institut. Non seulement les financements ont diminué, mais il a aussi eu du mal à recruter des chercheurs dans ce domaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "En fin de compte, après une série d'incidents malencontreux, le groupe de recherche de monsieur Butor a été officiellement dissous et cet endroit a été abandonné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "Si vous voulez mon avis, monsieur Butor a vraiment eu une poisse inouïe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
