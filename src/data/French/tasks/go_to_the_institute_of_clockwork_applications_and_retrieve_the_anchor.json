			},
			"dialogs": [
				{
					"id": 740880601,
					"content": "Pff... Je n'arrive toujours pas à oublier le comportement élusif de Choiseul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "Et Raimondo... C'est un type arrogant et méprisant qui se croit au-dessus de tout. Vous avez vu comment il me regardait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "Je pense que vous valez bien mieux qu'eux. Vous n'auriez jamais eu ce genre de comportement à leur place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chronie"
				}
			]
		}
	]
