			"dialogs": [
				{
					"id": 402010101,
					"content": "Pas mal, vous êtes à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Comment se passe l'affaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "#Le jour où on s'est {M#introduits}{F#introduites} dans l'entrepôt, les deux sbires, Corder et Doddamani, ont commencé à déplacer les marchandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Vous voyez ce bateau ? C'est sur celui-là que Doddamani a chargé les objets. Il opère comme navire de transport de personnes et de marchandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Ouah, il est énorme ! Je peux voir toutes les marchandises entassées sur le quai ! On dirait qu'il transporte aussi beaucoup de passagers vers le Port de Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "Et si ce n'étaient pas nos marchandises ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Vous avez deux longueurs d'avance, j'aime ça. Vous apprenez vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Si Corder et Doddamani pensent que les autorités sont à leurs trousses, il est possible que la marchandise ne soit rien d'autre qu'un simple appât pour nous leurrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "#En tout cas, nous devons être {M#prudents}{F#prudente}. Plusieurs membres de l'équipage ont avoué qu'un Pilleur de trésors aguerri, connu sous le nom d'Escroquier, est de mèche avec le Financier-blanchisseur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "L'Escroquier est un prisonnier évadé et un fugitif aguerri. D'après nos informations, c'est lui qui a fait des missions de reconnaissance au phare des Millelithes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Je vais faire un tour de la zone pour détourner son attention pendant que vous inspectez les marchandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "#N'oubliez pas de rester {M#discret}{F#discrète}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Oui, je ferai attention.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Et moi, je ferai de mon mieux pour... flotter au plus près du sol ! Pas plus haut que l'épaule de {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Ne vous inquiétez pas. Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Devrait-on vérifier au cas où ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Du nouveau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
