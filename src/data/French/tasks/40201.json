			"dialogs": [
				{
					"id": 402010401,
					"content": "Bon, c'était tout pour les bombes sur le pont. Et dans la cale ? On a assez de temps pour s'en occuper ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010402,
					"content": "Je m'en suis déjà chargée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010403,
					"content": "#Merci, {NICKNAME} et Paimon. Votre fermeté et votre vivacité d'esprit en situation d'urgence sont irréprochables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010404,
					"content": "Yelan ! Honnêtement, tout est grâce à vous. C'est vous qui avez eu l'idée de monter à bord. On n'aurait jamais pu comprendre ce message sans votre liste de codes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010405,
					"content": "Oh, attendez ! Où sont passés Corder et Doddamani ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010406,
					"content": "Hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010407,
					"content": "J'imagine qu'ils se remettent du choc. Sacrée épreuve, n'est-ce pas, messieurs ? Vous êtes la cible d'un dangereux individu. Vous avez failli perdre votre cargaison et vos vies en même temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010409,
					"content": "En effet. Je ne pensais pas qu'un individu aussi malveillant puisse exister dans ce monde... J'ai du mal à imaginer ce que j'ai pu lui faire pour qu'il en vienne à vouloir m'assassiner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010410,
					"content": "N'ayez crainte. Je vais immédiatement alerter la Maison Gardiennage et lui demander d'envoyer des agents au Port de Lumidouce. Vous avez manifestement besoin de protection tous les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010411,
					"content": "Votre cargaison devra également être remise aux autorités pour inspection, monsieur Corder, pour éliminer tout risque de danger. Ensuite, la Maison Gardiennage vous escortera jusqu'à votre destination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010412,
					"content": "Où devez-vous livrer vos marchandises, monsieur Corder ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010413,
					"content": "... À l'Hôtel Debord, pour une vente aux enchères dans deux jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010414,
					"content": "Ne vous en faites pas, les agents de la Maison Gardiennage sont compétents et responsables. Vous pouvez être sûr que vos biens arriveront à la vente aux enchères sans la moindre égratignure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010415,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010416,
					"content": "Après un certain temps, le navire accoste sans accroc au Port de Lumidouce. Les autorités de la Maison Gardiennage procèdent à une rapide inspection de sécurité et déchargent toute la cargaison du navire.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "Pendant ce temps, vous parlez à Yelan de la note que l'Escroquier a laissée à Corder et Doddamani.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
