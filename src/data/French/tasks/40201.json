				]
			},
			"dialogs": [
				{
					"id": 402010301,
					"content": "Vous m'avez fait peur en allant leur parler comme ça, Yelan ! Et s'ils avaient réalisé ce que vous faisiez ? Ils auraient pu nous causer des problèmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010302,
					"content": "Je suis sûre qu'ils ont tout compris, Paimon. Mais dans leur propre intérêt, ils n'avaient pas d'autre choix que de jouer le jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010303,
					"content": "#Maintenant, on est {M#sûrs}{F#sûres} que le Financier-blanchisseur est désespéré. Il a essayé de réduire ses pertes pour sauver sa peau avec ce coup sur le bateau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010304,
					"content": "Il a besoin de se débarrasser de tout ce qui pourrait remonter à lui, alors il a voulu faire exploser le navire pour envoyer les marchandises destinées à la vente aux enchères dans les profondeurs de la mer et faire porter le chapeau à l'Escroquier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010305,
					"content": "#Il voulait empêcher à tout prix que les marchandises arrivent jusqu'à la vente, mais on s'est {M#assurés}{F#assurées} qu'elles le seraient. Il n'a donc pas d'autre choix que d'aller jusqu'au bout des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010306,
					"content": "Il pourrait ne pas envoyer l'un de ses hommes à la vente aux enchères et laisser un acheteur insouciant acheter ses marchandises, mais leur valeur est surestimée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010307,
					"content": "Ce n'est qu'une question de temps avant qu'il ne se rende compte que l'estimation était erronée et qu'il ne le signale aux autorités. En tant que vendeur, Corder risquerait d'être condamné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010308,
					"content": "Dans le meilleur des cas, le Financier-blanchisseur doit trouver un nouveau plan pour blanchir ses moras sales. Dans le pire des cas, il perd l'un de ses agents les plus fiables à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010309,
					"content": "S'il décide de poursuivre la vente aux enchères...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "Exactement. On pourra quand même obtenir davantage d'indices et laisser l'acheteur de la vente aux enchères nous mener vers le Financier-blanchisseur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010312,
					"content": "D'accord, hum... Du coup, euh... Ça veut dire que... Vous pouvez répéter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010313,
					"content": "#Ne vous inquiétez pas. {NICKNAME} vous expliquera tout plus lentement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010314,
					"content": "#C'est la dernière ligne droite pour nous. Cette vente aux enchères est cruciale... Venez en étant {M#prêts}{F#prêtes} à aller jusqu'au bout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010315,
					"content": "L'officière Edler a envoyé un informateur sur place. Cette lettre d'invitation vous permettra d'accéder à la vente aux enchères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010316,
					"content": "Je vous retrouve à l'Hôtel Debord dans deux jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010310,
					"content": "Ça joue aussi en notre faveur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
