			},
			"dialogs": [
				{
					"id": 402010201,
					"content": "Excusez-moi, passagers. En raison du manque d'espace dans le cargo, on a été obligés de mettre une partie des marchandises sur le pont. Désolé pour ce désagrément.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "Membre d'équipage"
				},
				{
					"id": 402010202,
					"content": "Ne vous excusez pas d'avoir été victime de votre succès ! J'espère juste que ça déteindra sur nous aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "Passager enthousiaste"
				},
				{
					"id": 402010203,
					"content": "On dirait que toutes les marchandises marquées par l'Escroquier sont expédiées par Corder. Doddamani est dans le cargo, sans doute pour s'assurer que toutes les marchandises sont en place pour la livraison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010204,
					"content": "Est-ce qu'ils... inspectent quelque chose ? Pourquoi fouillent-ils les caisses ? Je ne comprends pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010205,
					"content": "Tenez, prenez cette liste. Elle devrait vous aider à comprendre leurs messages codés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010206,
					"content": "Voici le plan : pendant que je distrais Corder et Doddamani, vous enquêtez sur les marchandises qui portent la marque de l'Escroquier. On pourrait découvrir d'autres pistes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010207,
					"content": "Si je trouve quelque chose de préoccupant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "Pas de problème. Je fais confiance à votre jugement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010210,
					"content": "Hein ? Quoi ? Vous allez parler avec ces gars ?! Yelan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010211,
					"content": "Hm ? Excusez-moi messieurs... Est-ce qu'on se connaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010212,
					"content": "Vous êtes monsieur Corder, un célèbre collectionneur d'antiquités du Quartier lyonnais, non ? Je crois que nous avons déjà eu le plaisir de nous rencontrer tous les trois au Salon de thé Jiulue au Port Yilong, si je ne m'abuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010213,
					"content": "Quoi ? Vous... C'est vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010214,
					"content": "... Ah, la maîtresse des dés de la Maison de thé Yanshang. Le plaisir est pour nous, mademoiselle Yelan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010215,
					"content": "Vous avez entendu parler de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010216,
					"content": "Oui, j'ai pris une excellente tasse de thé là-bas un jour. On peut difficilement partir de la Maison de thé Yanshang sans entendre parler de votre légendaire talent aux dés. En tant qu'amateurs de thé, le destin a décidé de notre rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010217,
					"content": "Oui, ce doit être ça... Eh bien, nous sommes tombés l'un sur l'autre au bon moment. Je me rends à Fontaine pour mes vacances. Avez-vous des recommandations d'endroits à visiter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010218,
					"content": "Un endroit où je pourrais trouver un superbe service à thé, peut-être... Une exposition d'art, par exemple, ou une vente aux enchères ? J'ai entendu dire que le thé noir fontainois avait une saveur unique. J'imagine que vos services à thé sont également très beaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010219,
					"content": "Vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010220,
					"content": "Ah, est-ce que les services à thé vous intéressent aussi, monsieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010221,
					"content": "Je... *tousse* Bien sûr. Heureux de vous rencontrer, mademoiselle Yelan. Je me rends également à Fontaine pour un voyage, sur l'invitation de Corder. Même si le navire est à moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010222,
					"content": "Yelan a réussi à leur parler ! Mais est-ce que ça ira pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010223,
					"content": "On n'a pas beaucoup de temps !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "D'accord ! Sortons de leur champ de vision et commençons à inspecter ces caisses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010226,
					"content": "*tousse* C'est quoi l'odeur qui se dégage de ces boîtes ? Ça pique le nez... Ce doit être un mélange de tout un tas de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010227,
					"content": "Il y a une note étrange, mais je n'arrive pas à lire ce qu'elle dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010228,
					"content": "C'est un message codé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "Yelan pense vraiment à tout ! Mais, euh... Tu sais comment utiliser ce truc, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010231,
					"content": "Alors ? Qu'est-ce que ça dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010232,
					"content": "Si je ne me trompe pas, ils prévoient de se débarrasser de la marchandise...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "Quoi ?! Ils vont faire exploser le bateau ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010235,
					"content": "Mais ils sont cinglés ? Je pensais qu'ils voulaient juste échapper aux autorités ! Pas attirer encore plus l'attention sur eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010236,
					"content": "L'Escroquier doit protéger celui qui tire les ficelles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "Yelan avait raison ! Ce type est complètement fou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010240,
					"content": "Il y a des innocents sur ce navire ! On doit trouver ces bombes et les désamorcer dès que possible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010237,
					"content": "Il essaye de nous distraire de l'essentiel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "Et de nous empêcher de remonter la piste vers eux dans la foulée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "En faisant exploser le bateau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "Heureusement, on a la liste des codes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "Elle nous rend service, alors mettons-nous au travail !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "Ça vous va si je m'en occupe immédiatement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
