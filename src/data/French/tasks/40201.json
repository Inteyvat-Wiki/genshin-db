			},
			"dialogs": [
				{
					"id": 402010501,
					"content": "Bon, on peut confirmer que ces personnes étaient très impatientes d'acheminer leurs marchandises à Fontaine en une seule fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010502,
					"content": "Tu as vu les marques étranges sur certaines caisses ? Je me demande ce que ça veut dire... Allons demander à Yelan !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010503,
					"content": "Vous retrouvez Yelan et lui racontez les résultats de votre enquête...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010504
					]
				},
				{
					"id": 402010504,
					"content": "Superbe. En ce qui concerne la vente aux enchères, l'officière Edler a pu obtenir des informations utiles. Nous avons la quasi-certitude qu'ils ciblent la vente aux enchères qui aura lieu à l'Hôtel Debord dans deux jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010505
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010505,
					"content": "Les marques que vous avez photographiées ont été appliquées avec une peinture spéciale. Elle est presque impossible à repérer sans une technologie spécialisée, comme le Photomesureur criminalistique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010506
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010506,
					"content": "Je pense qu'il s'agit d'un insigne de Pilleurs de trésors. Chaque membre important de l'organisation a le sien, un peu comme une signature personnelle. Compte tenu de ce que nous savons de l'affaire, je parie que c'est l'œuvre de l'Escroquier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010507,
						402010508
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010507,
					"content": "C'est donc lui qui a marqué la marchandise, mais pourquoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				},
				{
					"id": 402010509,
					"content": "D'après la liste dressée par le personnel du port, parmi les marchandises marquées se trouvent... de l'engrais de Sumeru, des feux d'artifice locaux, du savon et du parfum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010510
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010510,
					"content": "Rien de spécial en somme... Juste des produits agricoles et de première nécessité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010511,
					"content": "Engrais, savon et parfum... Non, quelque chose cloche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010512
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010512,
					"content": "C'est peut-être risqué, mais je vais enquêter à bord et en profiter pour aller à Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010513,
						402010514
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010513,
					"content": "Tant qu'on y est...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010515,
					"content": "Oui ! Je suis curieuse de savoir ce que ces types manigancent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010516,
					"content": "#Vous avez prouvé votre efficacité, alors je n'y vois aucun inconvénient. Sachez juste qu'une fois à bord du bateau, nous serons forcément {M#confrontés}{F#confrontées} directement à Corder et Doddamani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010517
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010517,
					"content": "#Soyez {M#préparés}{F#préparées}, notre enquête sera un peu différente cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010514,
					"content": "On vous accompagne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010508,
					"content": "Quel message veut-il transmettre ?",
					"roleType": "TALK_ROLE_PLAYER",
