				"points": []
			},
			"dialogs": [
				{
					"id": 721180301,
					"content": "Alors, vous avez vu ce qu'il en était de la situation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180302,
					"content": "Je l'ai fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211804,
			"completionStepIds": [
				7211809
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211809",
							"2"
						],
						"stepId": 7211809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Parfait ! Laissez-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "On a de la chance, on dirait. L'état du Fourneau Mikage est assez stable et l'énergie à l'intérieur n'est pas encore saturée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "Je pense que mon appareil peut tenir à ce niveau de concentration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Doit-on purifier toute cette énergie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Si cet appareil en était capable, j'aurais déposé un brevet depuis longtemps. Mais notre bon ami ici ne peut faire baisser le niveau d'énergie que dans une zone localisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Cependant, la raison pour laquelle le Fourneau Mikage était en panne et ne pouvait même pas exécuter la procédure de redémarrage automatique était la forte concentration d'énergie du Tatarigami qui l'entourait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Si on trouve la zone avec la concentration la plus élevée et qu'on la purifie, on devrait pouvoir faire refonctionner le noyau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "À ce stade, le Fourneau Mikage devrait redémarrer et après, tout devrait bien se passer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Voilà le plan. Mais avant, j'ai encore quelques derniers préparatifs à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
