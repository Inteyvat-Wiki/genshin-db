			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Enfin ! C'est terminé, heureusement que je me souviens encore des normes de fabrication...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Alors on va purifier l'énergie du Tatarigami ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Eh bien, même si j'aimerais mettre un terme à ce problème, je ne peux pas me permettre de prendre le Tatarigami à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "De plus, comme je n'ai pas pu trouver certains des matériaux requis, j'ai dû me contenter de substitutions de dernière minute. Le résultat étant que la fiabilité de cet appareil est quelque peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Hmm. Eh bien, disons simplement que « dans certaines circonstances, l'appareil n'est pas en mesure d'atteindre l'efficacité souhaitée ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "Il fonctionne normalement pour le moment, mais je doute qu'il puisse résister à un accident. La moindre secousse risquerait de déplacer ses composants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "De ce fait, nous avons encore quelques préparatifs à faire avant de pouvoir mettre notre nouvel ami à la tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "J'aimerais que vous alliez près du Fourneau Mikage et que vous enregistriez des données pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Merci. Je vous attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "On doit vraiment être aussi prudents ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Bien sûr. J'ai déjà sauté pas mal d'étapes. Si monsieur Flois était là, ça nous aurait pris une semaine avant d'en avoir fini avec le processus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "Quoi qu'il en soit, étant donné qu'on se trouve dans une situation désespérée, je vous autorise, en vertu de mon rôle de représentant du comité d'examen du projet, à agir en fonction des besoins de la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7211802,
