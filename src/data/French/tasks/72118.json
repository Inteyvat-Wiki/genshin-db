			"dialogs": [
				{
					"id": 721180501,
					"content": "Les actions des Fatui sont de plus en plus étranges ces derniers jours. Ils se rassemblent tous autour du noyau du fourneau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "J'espère qu'ils ne manigancent pas encore un autre de leurs complots ignobles... Ou pire, qu'ils ne tentent pas quelque chose contre lequel on ne pourrait pas se défendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
