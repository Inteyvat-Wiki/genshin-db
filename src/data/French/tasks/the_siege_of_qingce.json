						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Bien, je vais appeler les autres immédiatement ! Il vaut mieux agir le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Jinglun"
				},
				{
