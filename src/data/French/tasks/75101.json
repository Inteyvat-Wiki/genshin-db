			"dialogs": [
				{
					"id": 751010101,
					"content": "Héhé, c'est enfin normal... Voilà la connexion stable que nous attendions avec la Statue des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010102,
					"content": "Le problème qu'on a eu avant était donc dû à ce méchant dans le Fief nocturne ? Ça a dû être difficile pour la Statue des Sept à ce moment-là... Beau travail, statue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010103,
					"content": "Enfin, ce n'est pas comme si tu avais pu entrer en résonance avec l'élément Pyro même si tu le voulais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010104,
					"content": "Oui, c'est arrivé pendant que je combattais aux côtés de l'Archon Pyro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751010105
					]
				},
				{
					"id": 751010105,
					"content": "#J'ai eu super peur à ce moment-là... Mais tu as quand même été {M#le plus fort}{F#la plus forte} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010106,
					"content": "Quoi qu'il en soit, heureusement qu'on a réussi à se débarrasser de tous ces monstres de l'Abîme et à restaurer les Statue des Sept !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
