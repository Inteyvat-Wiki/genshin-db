				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Oh ? Intéressant, voyons voir... Hm, je mettrais un six pour la créativité, mais peut-être un quatre pour sa possibilité de réalisation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "C'est... un plan criminel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Haha. En fait, j'ai quitté mon poste à la hâte parce que j'ai entendu dire que quelqu'un ici était en train d'élaborer un « plan criminel » des plus étranges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "... Mais après avoir vu cette feuille de notes, je comprends mieux comment ces rumeurs ont commencé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Je vais remettre ce « plan criminel » à l'Ordre de Favonius. Si vous avez le temps, passez me voir à la base. Vous y trouverez peut-être quelque chose d'intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
}