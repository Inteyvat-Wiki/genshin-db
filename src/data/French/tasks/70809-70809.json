			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uchida Kotaro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "C'est... C'est... mon modus operandi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME} ! Il vient de tout avouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "Ah ! Ne vous méprenez pas, s'il vous plaît. C'est une intrigue que je comptais inclure dans mon prochain roman. Elle m'est venue à l'esprit pendant que je buvais un verre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090404,
					"content": "Quand je me suis réveillé et que j'ai vu que la page avait disparu, j'ai pensé que ce n'était qu'un rêve lié à l'alcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090405,
					"content": "En tout cas, merci beaucoup de m'avoir aidé à la récupérer ! Je devrais pouvoir publier mon roman sans problème maintenant. Quand je l'aurai terminé, je vous ferai cadeau d'un exemplaire ! Dédicacé, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uchida Kotaro"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
