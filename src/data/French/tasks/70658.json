			"dialogs": [
				{
					"id": 706580101,
					"content": "Bonjour, vous profitez bien de la Fête des alizées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580102,
					"content": "Oui, et c'est grâce à vos recommandations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Héhé, j'ai ici une autre activité très sympa. Elle s'appelle « L'air du vent ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580105,
					"content": "J'imagine que vous avez déjà vu des bardes à Mondstadt, non ? Cette activité vous permet de jouer de la musique comme eux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580106,
					"content": "Au sommet d'une montagne, au bord d'un lac, la brise qui souffle, être concentré sur la mélodie... Une excellente façon de se détendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580107,
					"content": "Je n'ai aucune expérience en musique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Ne vous inquiétez pas ! Cette activité a été conçue pour donner aux novices une opportunité de profiter des joies de la musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580110,
					"content": "Tant que vous suivez les indications et le rythme, il n'y aura pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580111,
					"content": "Bon, ça me rassure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Bien. Je vous souhaite une joyeuse Fête des alizées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580112,
					"content": "Je vais aller essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "Ça sonnera vraiment bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580103,
