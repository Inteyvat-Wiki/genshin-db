			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "#Ah... {M#voyageur}{F#voyageuse}, ça fait plaisir de vous voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "Comment allez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Vous avez des poches sous les yeux, et il semble que vous puissiez à peine parler. Vous devriez faire une pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "Je... Je ne peux pas me reposer. Je suis resté debout toute la nuit à écrire des brouillons, mais aucun n'était assez bon ! Je dois continuer d'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Si vous avez besoin de mon aide pour une affaire officielle, veuillez patienter un instant... Vous pouvez vous asseoir près de monsieur Roialte, il a peut-être même du café...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "Je... Je dois me remettre à écrire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "Argh ! Non, utiliser « À mes chers collègues » n'est certainement pas assez formel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "Vous n'avez pas l'air en forme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
