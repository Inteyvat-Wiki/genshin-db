					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "#{M#Voyageur}{F#Voyageuse}, heureux de vous revoir. Café ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Maintenant que vous le dites...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Ouais ! Je me posais aussi la question, mais... Mais ces gars parlaient si fort, je n'osais pas parler d'autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "#Et j'ai cru que j'allais être {M#mis}{F#mise} dehors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "Pourquoi ? Haha, aucune raison de s'inquiéter ! Les gardes vous ont laissé entrer, alors pourquoi devrions-nous nous en faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "#C'est aussi un exemple de délégation claire d'autorité et de responsabilité. Bonjour, {M#voyageur}{F#voyageuse}. Je m'appelle Semaine, c'est un plaisir de vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Semaine travaillait au tribunal en tant que secrétaire adjoint. En raison de circonstances... plutôt confuses, il a été muté à la Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Grâce à son sens aigu de déduction, nous avons pu trouver des solutions à de nombreux problèmes jusque-là insolubles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "Vous me flattez, vraiment. J'ai simplement utilisé mon expérience, et la valeur de certaines choses pour déduire l'importance des questions qui leur sont liées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "Bien qu'en pratique, nous rencontrons d'innombrables questions qui ne peuvent pas être mesurées avec précision. Mais dans ces cas-là, l'application des axiomes de Roialte sur l'interaction humaine est d'une grande aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "Et ça veut dire... quoi, exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Pour faire simple, Semaine est doué pour envisager les différentes parties à un problème, et parvient à ce que chacun ait le sentiment d'être important. À trouver le juste équilibre, si vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "Et si l'équilibre n'est pas possible, alors je peux faire pencher la balance grâce au « poids des mots ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "Iaune a vraiment l'air de travailler dur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "Ouais ! On dirait qu'il est sur le point de s'écrouler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "C'est une épreuve qu'on doit tous traverser tôt ou tard. Si je l'aidais à écrire ce document, il n'apprendrait rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Sa tête et son cœur débordent de fantasmes idéalistes sur ce qu'est le travail à la Maison Gestion. Mais les fantasmes sont pour la jeunesse, pas pour le personnel de notre organisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "Et moi, je ne sais tout simplement pas comment rédiger ces documents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Vous êtes plutôt franc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "Alors, qu'est-ce qui vous amène ici ? Je verrai si je peux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune accourt soudainement pris de panique...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Malheur ! Tout joue contre moi ! Monsieur Roialte, avez-vous des capuchons de touche de rechange pour la dactylographeuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Pendant que je tapais, j'ai soudainement découvert qu'il m'en manquait un. Je n'ai aucune idée de quand cela aurait pu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "As-tu bien regardé partout ? Peut-être est-il simplement tombé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "Ou peut-être est-il coincé dans un livre, ou entre des documents... Avez-vous déjà vérifié ces possibilités ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "Ou alors, dans un porte-stylo, ou dans votre manche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "Ou dans vos cheveux, voire dans une tasse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "J'ai regardé partout ! Même dans mes poches et dans mes chaussures, j'ai cherché partout, il reste introuvable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Très bien. Alors tu devrais aller demander à Cornélia. Si nous avons des pièces de rechange comme les capuchons de touche, alors c'est à elle qu'il faut soumettre une demande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Je devrais juste aller en acheter un moi-même ! Estelle devrait pouvoir faire ça rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Mon cher Iaune, tiens-tu vraiment à le payer de ta poche ? La dactylographeuse et ses touches sont de la propriété publique de la Maison Gestion. Le dépôt d'une demande auprès de Cornélia est la procédure appropriée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "Ça ne coûte vraiment pas grand-chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "Ce n'est pas une question de prix. C'est une autre question d'autorité et de responsabilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "La réparation de la propriété publique de la Maison Gestion devrait être payée par les moras publics !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Si vous payez cela de votre poche sans soumettre une demande de remboursement, on ne saura pas d'où vient l'argent lorsque les dépenses seront examinées à la fin de l'année !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "Bon, d'accord ! Je vais trouver Cornélia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Même acheter quelque chose semble si pénible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "C'est tout à fait normal ici, à la Maison Gestion. Par ici, s'il vous plaît, allons trouver Cornélia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "Donc même payer pour quelque chose est si compliqué...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Pouvez-vous l'aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "Et vous êtes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "Pourquoi aucun d'entre vous n'a été surpris de me voir ici avant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
		},
		{
			"id": 7403503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
