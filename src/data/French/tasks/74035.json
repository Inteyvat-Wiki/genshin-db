			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "#Bonjour monsieur Iaune. Comment puis-je vous aider{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350402,
					"content": "Bonjour, mademoiselle Cornélia. Avons-nous des capuchons de touche de rechange pour une dactylographeuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350404,
					"content": "Il manque un capuchon de touche à ma dactylographeuse. J'aimerais donc en demander un de rechange. S'il n'y en a pas en stock... Je pourrais en acheter un nouveau et me le faire rembourser plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Vous faire rembourser un capuchon de touche... Ce ne devrait pas être un problème, en principe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350406,
					"content": "Veuillez signer ici. Écrivez simplement « Demande de remboursement pour un capuchon de remplacement en raison d'un dysfonctionnement de la dactylographeuse », puis signez votre nom et écrivez le bureau pour lequel vous travaillez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350407,
					"content": "Très bien. Je peux obtenir le capuchon de remplacement aujourd'hui, n'est-ce pas ? J'ai vraiment besoin de me remettre au travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Monsieur Iaune, avez-vous déjà fait une demande de remboursement pour l'achat d'un bien de propriété publique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350409,
					"content": "Ce n'est pas aussi simple... Vous ne pouvez pas simplement acheter quelque chose et vous le faire rembourser. Nous devons rassembler toutes les notes de frais, faire un rapport, puis soumettre le tout à la Maison Cardinalice pour approbation à la fin du mois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350410,
					"content": "Ce processus est lié à l'approbation et au paiement des salaires de l'ensemble de la Maison Gestion. Si le montant dépensé est trop important, la Maison Cardinalice devra soumettre le rapport à monsieur Neuvillette pour approbation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350427,
					"content": "Les paiements ne peuvent être officiellement versés qu'une fois qu'ils ont été examinés et signés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350411,
					"content": "Si monsieur Neuvillette a des questions sur une certaine note de frais, le membre du personnel qui l'a soumise doit soumettre un rapport écrit... Nous allons justement soumettre le premier lot de rapports dans les prochains jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350412,
					"content": "Vous êtes en train de dire que, si je n'ai pas de chance, monsieur Neuvillette va devoir signer ma note de frais lui-même, pour un capuchon de touche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Ce sont les règles, monsieur Iaune. Et les dépenses totales pour ce mois sont assez importantes, en effet. Il est donc probable que monsieur Neuvillette soit amené à vérifier les rapports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350414,
					"content": "Monsieur Neuvillette... Attendez, n'est-ce pas le juge suprême ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Mais ce n'est qu'un capuchon de touche... Devons-nous vraiment le déranger juste pour ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "N'y a-t-il pas un autre moyen ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "C'est ce que je pense aussi ! Nous n'avons pas besoin d'embêter monsieur Neuvillette pour ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Il y a d'autres moyens, oui. Vous pourriez d'abord aller acheter un capuchon de touche, et je vous fournirai ensuite une reconnaissance de dette officielle dans les comptes publics.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350420,
					"content": "Une fois tous les remboursements traités et le processus de paiement terminé, le montant dû vous sera versé directement par le trésor public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350421,
					"content": "Super ! Faisons ça, alors ! Après tout, un capuchon de touche ne coûte pas cher, je peux le payer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Veuillez signer ici, s'il vous plaît. Et n'oubliez pas d'écrire « Demande de remboursement pour un capuchon de remplacement en raison d'un dysfonctionnement de la dactylographeuse »... Allez-vous l'acheter chez mademoiselle Estelle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350423,
					"content": "Oui. Y a-t-il un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Alors j'apporterai la reconnaissance de dette à monsieur Roialte pour qu'il la signe, avant de la montrer à mademoiselle Estelle pour qu'elle confirme le montant de l'achat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350425,
					"content": "Mais vous n'avez pas à vous en soucier. Dépêchez-vous d'acheter votre capuchon de touche, je m'occupe du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350426,
					"content": "#Merci beaucoup ! Vous êtes vraiment la meilleure, mademoiselle Cornélia. Je vais l'acheter tout de suite... Allons-y, {M#voyageur}{F#voyageuse}, ne perdons pas de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Essayons autre chose !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
