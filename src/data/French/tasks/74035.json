			"dialogs": [
				{
					"id": 740350601,
					"content": "Qu'est-ce qu'il y a, Iaune ? Tu as l'air essoufflé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "Estelle ! J'ai besoin d'un capuchon pour une dactylographeuse ! Dis-moi que tu en as, s'il te plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Bien sûr, mais les dactylographeuses ont tellement de touches différentes ! Regarde ici pour voir si tu trouves ton bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune commence à fouiller, cherchant le capuchon de touche dont il a besoin comme si sa vie en dépendait...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "C'est ça ! J'ai trouvé ! Voici l'argent, merci, Estelle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "La dernière fois, tu as dit que tu aimerais faire du bateau avec moi... Iaune ! HÉ ! Iaune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
