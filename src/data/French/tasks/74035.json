			"dialogs": [
				{
					"id": 740350301,
					"content": "Un capuchon de touche pour une dactylographeuse... Hé, Semaine, on peut vraiment rentrer une note de frais pour ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "Je ne suis pas sûr. Mais si on peut en rentrer pour des dactylographeuses, j'en déduis que c'est aussi valable pour les capuchons de touche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
