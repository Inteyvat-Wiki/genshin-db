					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140405,
					"content": "Et c'est quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "Voyons... Cela contient des documents, et aussi un décret qui n'a pas encore été publié. C'est surprenant de voir comme c'est bien préservé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140407,
					"content": "Par contre, votre trouvaille devrait nous épargner un peu de travail... Même si j'ai l'impression qu'on n'arrivera jamais au bout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140408,
					"content": "Merci tout de même ! Tenez, prenez ceci en remerciement.",
					"roleType": "TALK_ROLE_NPC",
