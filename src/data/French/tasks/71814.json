			"dialogs": [
				{
					"id": 718140401,
					"content": "Bonjour, en quoi puis-je vous être utile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140402,
					"content": "J'ai trouvé ça dans la mer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Oh ? Laissez-moi voir ça de plus près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Oui, effectivement, ça vient de la Chambre de Jade.",
