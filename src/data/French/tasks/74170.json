			"dialogs": [
				{
					"id": 741700210,
					"content": "Parlons du défi plus tard. Qu'est-il arrivé à Coutrot ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Son expulsion de l'Institut de recherche de Fontaine ne lui a pas suffi. Il est vraiment têtu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "Mais personne ne le soutient maintenant, alors vous pouvez vous détendre. Il ne peut plus causer d'ennuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
