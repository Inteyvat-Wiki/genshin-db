				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Vous avez réussi ! On dirait que ce défi n'est pas impossible en fin de compte ! Je crois que je peux proposer ça à l'Institut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "Dommage que je n'aie pas encore fini de vérifier toutes les ressources. Il faudra que je revienne ici plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "En tout cas, merci pour votre aide ! Ah et voici votre récompense. Bonne route !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
