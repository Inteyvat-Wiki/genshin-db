			"dialogs": [
				{
					"id": 741700213,
					"content": "Quoi qu'il en soit, qui est Kuisel ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Je ne sais pas non plus. Je ne me souviens de personne portant ce nom à l'Institut de recherche de Fontaine... Peut-être qu'en ce qui le concerne, il vaut mieux qu'il n'y ait personne de ce nom ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Comme il l'a dit lui-même, Kuisel n'était qu'un personnage pratique. Plus ce personnage était différent de lui-même, mieux c'était, car ça réduisait les chances d'être reconnu... Bien que ce ne soit qu'une supposition de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "*soupir* Si vous me demandez, cependant, je pense qu'il a suffisamment changé au fil des années. Je ne l'avais pas reconnu au début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
