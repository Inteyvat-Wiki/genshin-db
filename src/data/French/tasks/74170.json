				{
					"id": 741700217,
					"content": "Mettons le défi de côté, ces appareils ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "C'est déroutant, n'est-ce pas ? On dirait qu'il a fait... Euh... Diverses modifications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Il s'apparente désormais plus à une ruine antique que les touristes pourraient visiter... Même s'il n'est peut-être pas trop prudent de le dire ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "Ahem. Ce point de vue n'est que mon opinion, et n'est pas représentatif de l'Institut de recherche de Fontaine ni de ses points de vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
