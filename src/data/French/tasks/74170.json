				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Oh, vous êtes de retour. Moi aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "L'Institut a pris connaissance de mon rapport, et m'a demandé d'évaluer la zone pour déterminer si elle convenait comme site de formation pour le développement de la qualité, en même temps que mon travail de recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "*soupir* Tout ça me dit quelque chose. Je me souviens que notre officier administratif insistait pour que tout le monde suive une formation de plongée, fut un temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Personnellement, je pense que c'est inutile, mais c'est mon travail. Je ne peux rien dire... Sans parler du fait que cet endroit est plutôt étrange... Hum, je veux dire, unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "C'est pour cette raison que j'ai placé quelques ancres de relevé dans la zone. Ce sont juste des modèles, alors il n'y a aucun danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "Au cours de cette formation, il faudra <color=#00E1FFFF>récupérer toutes les ancres de relevé dans le bâtiment dans le délai imparti</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Ça vous dit d'essayer ? Vous obtiendrez une récompense pour votre participation. Après tout, vous contribuez au progrès de la recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
