					"nextDialogs": [
						240111502
					]
				},
				{
					"id": 240111502,
					"content": "Hmm... C'est une bonne idée. Mais vous pensez vraiment pouvoir nourrir autant de goélands ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111503,
					"content": "Enfin... Même si ce n'est pas possible, ce n'est pas grave. Tant que j'ai le temps de manger mes frites. OK, je compte sur vous alors.",
