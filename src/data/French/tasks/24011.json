			"dialogs": [
				{
					"id": 240111401,
					"content": "On va tous les chasser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "D'accord, mais pourriez-vous... vous contenter de les chasser ? Ils veulent juste manger quelques frites. Ils n'ont pas vraiment de mauvaises intentions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Enfin, c'est embêtant pour moi, mais ce n'est pas grand-chose. Alors... Ne faites que les chasser, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
