			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Bon, les goélands, je comprends que vous ayez faim, mais je dois aussi manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Peu importe. Tant que ça vous fait plaisir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Quelle bonne surprise. Si vous avez besoin de quelque chose, je crains que vous ne deviez attendre un peu. Je n'ai pas fini mes frites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "#Je ne suis pas {M#venu}{F#venue} pour demander quelque chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Oh, OK... Très bien, je dois me dépêcher de finir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "C'est mon repas principal. J'ai des choses à faire avec Roialte plus tard, il ne faut donc pas que je traîne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "En général, je ne mange pas dans le Palais Mermonia. J'ai l'habitude de sortir pour trouver un endroit plus calme où manger rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Mais aujourd'hui... Je ne sais pas ce qu'il se passe. Ces goélands se jettent ensemble sur mes frites, et ils ne sont jamais rassasiés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Ils sont nombreux, et il n'y a pas tellement de frites...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "C'est vrai, mais je ne peux pas vraiment nourrir tous les goélands du littoral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Ce sont vos frites, alors ne laissez pas les goélands toutes les avoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Sinon, vous allez être affamé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Vous m'avez l'air un peu faible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Ah, bon ? Je ne... D'accord, c'est vrai. Il n'y a rien qui vous échappe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Je ne sais pas à quoi sert mon travail. J'ai travaillé à la Maison Gestion toute la journée, mais je ne sais pas si ça a servi à quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Je n'ai aidé personne, aucune vie n'a été améliorée grâce à mes actions. Roialte dit que notre travail est essentiel, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Je passe mes journées à la dactylographeuse, je tape sans arrêt. Mais à quoi cela sert-il ? Je ferais mieux de perdre un autre capuchon de touche, au moins comme ça, Estelle pourra gagner quelques moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Désolé, je me suis laissé emporter. C'est juste que je me sens un peu perdu. Peut-être que... j'ai besoin de plus de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Vous devriez d'abord finir de manger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Vous avez raison. Mais je n'ai plus le temps de racheter des frites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Ce n'est pas important, je vais partager avec les goélands. Je pourrai aller chercher quelque chose à manger quand j'aurai fini avec Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "Ça devrait nous prendre... Euh... Une demi-journée peut-être ? Ça devrait aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Vous êtes sûr de pouvoir tenir si longtemps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Je vais m'occuper des goélands.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Hmm... Ne vous embêtez pas. Ce n'est qu'une portion de frites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Contentez-vous de terminer votre repas. Vous devez manger, même si vous êtes très occupé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "J'en fais mon affaire, de ces goélands.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Commençons par résoudre ce problème de goélands.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Vous n'avez pas l'air dans votre assiette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Ils n'en ont pas encore tous reçu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "Pourquoi vous mangez vos frites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
