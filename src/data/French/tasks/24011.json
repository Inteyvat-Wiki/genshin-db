					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "#Hmm, peut-être en mangeant ailleurs{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "J'y ai pensé, mais c'est le meilleur endroit. Si je suis trop près du Palais Mermonia, je pourrais tomber sur des collègues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "Et je devrai encore discuter du travail avec eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Si, en revanche, je m'éloigne trop, je ne pourrai pas retourner au bureau à temps, et je risque de rater quelque chose d'important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "C'est vraiment ici le meilleur endroit pour manger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401113,
