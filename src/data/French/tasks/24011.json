					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111101,
					"content": "Et si vous essayiez d'élever un chien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "Vous pensez qu'un chien pourrait leur faire peur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111103,
					"content": "C'est une bonne idée. Je pourrais peut-être demander à quelqu'un de m'en confier un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401112,
