			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Argh, ces goélands. Mangez ces frites et laissez-moi tranquille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Comment ça se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Non, pas du tout. Lorsque les goélands se sont rapprochés de mes frites, le chien s'est caché derrière moi et a commencé à trembler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "*soupir* Ce n'est pas de sa faute. Tout ce qu'on leur demande, c'est d'être aimant, on ne leur a jamais appris à attaquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "On attend ça de nous aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "C'est vrai. Mais dans certaines circonstances, l'amour est aussi synonyme de « pouvoir ». Et tant que ce sera le cas, les choses ne pourront pas s'arranger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Je me suis emporté, désolé. J'ai dû gérer de nombreux conflits émotionnels récemment, et je ne suis toujours pas passé à autre chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "*soupir* Ma priorité est de savoir comment manger mes frites tranquillement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "Le chien a-t-il été utile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
