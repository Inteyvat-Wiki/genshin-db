			"dialogs": [
				{
					"id": 200230901,
					"content": "Alors ? Est-ce que vous avez des nouvelles de Nimrod, mon enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230902
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230902,
					"content": "Nimrod est resté sobre aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Le problème, c'est qu'on ne peut pas vous le prouver...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "C'est pas grave. S'il n'y a aucune preuve de son ébriété, ça veut dire qu'il est sur le bon chemin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Je crois en son innocence jusqu'à preuve du contraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Mais quand les preuves de conduites discutables s'amoncellent... C'est assez marrant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Prenez ça en guise de remerciement. J'espère que vous n'aurez aucun péché à confesser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		}
