			},
			"dialogs": [
				{
					"id": 200230401,
					"content": "Alors ? Est-ce que vous avez des nouvelles de Nimrod, mon enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230402
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230402,
					"content": "Voilà son addition à la taverne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "Hmph, je le savais. Il continue de boire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230404,
					"content": "On oublie vite ses actes quand on ne souffre pas de leurs conséquences...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230405,
					"content": "Merci pour votre aide. Je vous prie d'accepter ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230406,
					"content": "Je vais réfléchir à la punition de Nimrod...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
