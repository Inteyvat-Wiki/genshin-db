				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "Les affaires vont de plus en plus mal ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Je disais juste que les affaires devenaient de plus en plus difficiles dans cette taverne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Pour nous autres, dans la restauration, être là depuis longtemps est à la fois une bénédiction et une malédiction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "Le bon côté d'avoir un établissement de longue date est d'avoir une certaine notoriété, ce qui permet d'attirer plus de clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "L'inconvénient, c'est que les gens se lassent de voir toujours la même chose. Dans les grands restaurants, où il y a beaucoup de variété, ce n'est évidemment pas un problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Mais je n'ai qu'une petite taverne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "Nos clients réguliers connaissent toute la carte et reviennent de moins en moins souvent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "J'ai entendu dire que l'industrie du vin était prospère à Mondstadt. Ils ont un célèbre vin de dent-de-lion, soi-disant fait à base de pissenlits fermentés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "J'ignorais qu'on pouvait fermenter les pissenlits... Mais j'aimerais essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Pourriez-vous aller à Mondstadt et me ramener des pissenlits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Fantastique, je vous récompenserai pour votre travail. Vous avez ma parole de liyuéen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Du vin de dent-de-lion ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Vous trouvez ça bizarre ? Pourtant, j'ai entendu dire que c'était très populaire à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "Mais ça ne va pas se vendre si je copie exactement la même recette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Quoi qu'il en soit, commencez par m'apporter des <color=#00E1FFFF>pissenlits</color>, et en attendant, je vais réfléchir à une façon d'apporter une touche liyuéenne au processus de fermentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
