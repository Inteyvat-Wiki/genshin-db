			"dialogs": [
				{
					"id": 223030301,
					"content": "Je vais expérimenter un peu pour commencer et voir si je peux ajouter des pissenlits au processus de fermentation traditionnel liyuéen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Prenez ça, c'est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Je ne m'attends pas à réussir du premier coup. Cela me prendra probablement plusieurs tentatives. Si je manque de pissenlits, je referai peut-être appel à vous.",
					"roleType": "TALK_ROLE_NPC",
