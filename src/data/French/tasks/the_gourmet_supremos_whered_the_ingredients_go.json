			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Oui, c'est suffisant. Merci. Si vous ne m'aviez pas aidée, j'aurais été m'occuper de ces monstres seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Et j'aurais sûrement oublié ces fleurs de cerisier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "D'ailleurs, voici une brochette de poulet et de champignons pour vous remercier. C'est un classique de la cuisine des aventuriers que Lynn m'a appris à préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Je vais ramener les fleurs de cerisier à Xudong. Je me demande ce qu'il va faire pour manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
	]
