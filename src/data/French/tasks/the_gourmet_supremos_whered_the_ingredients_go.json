			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Hmm... Ça devrait être par ici pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie ? Pourquoi êtes-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "#Hein ? Mais c'est {M#le voyageur}{F#la voyageuse}. Héhé, je n'arrive pas à croire que je vous rencontre ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Je suis ici pour chercher des ingrédients. Xudong travaille sur un nouveau plat et Parvaneh lui donne des idées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong dit qu'il veut faire un dessert doux et sucré qui s'inspire des dango trois couleurs d'Inazuma, mais il a besoin de plusieurs ingrédients spéciaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Munehisa est allé en ville pour acheter des melons lavandes, et je suis venue ici pour ramasser des fleurs de cerisier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "J'en ai rassemblé un peu, mais c'est encore un peu insuffisant. J'allais regarder plus loin, mais ce côté est plein de créatures magiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, pouvez-vous m'aider à trouver trois fleurs de cerisier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Merci ! Quand vous reviendrez, je vous régalerai d'un délicieux repas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Ces monstres ne devraient pas vous poser trop de problèmes, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Oui, d'habitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Mais, si je devais les combattre, je suis sûre d'oublier de collecter les ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Même à Mondstadt, j'oubliais tout ce que j'avais à faire d'autre quand je combattais des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Ce n'est que lorsqu'ils sont complètement vaincus que je me souviens de mes autres tâches... C'est comme ça que j'échouais toujours mes missions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "Vous détestez vraiment les monstres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Non pas vraiment... Je pense que c'est amusant de se battre contre eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "C'est agréable de penser à rien d'autre qu'à battre des monstres, vous voyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Bref, passons. Merci de m'aider à collecter des fleurs de cerisier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "Quand vous reviendrez, je vous offrirai quelque chose de délicieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
