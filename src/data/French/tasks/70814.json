				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Oh ? Vous êtes déjà de retour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Ma mission est accomplie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "#Vous êtes trop {M#fort}{F#forte} ! Tout à l'heure, j'ai trié les ordres de missions et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "Il y avait une montagne de demandes pour se débarrasser de monstres. Ce genre de missions qui plaisent aux aventuriers, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "J'ai aussi trouvé des rapports qui indiquaient la présence de Pilleurs de trésors dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Les aventuriers peuvent aussi s'en occuper ? J'ai davantage l'impression que c'est un travail pour les Millelithes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "Oui, bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Ah bon ? Les aventuriers ont l'air de savoir tout faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "Je vous laisse vous occuper de cette mission alors. Une généreuse récompense vous attendra à votre retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "Pourquoi vous nous rajoutez une mission supplémentaire ? Nous n'avons même pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "La récompense n'en sera que plus grande ! J'en ai déjà parlé à Lan, elle est d'accord pour l'augmenter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Ça me va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "Je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "J'ai réussi à refiler deux missions d'un coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "Les conseils de Lan pour me faciliter la tâche ont marché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "Tant que la récompense ne déçoit pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Les aventuriers sont incroyables... Ils peuvent tout faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
