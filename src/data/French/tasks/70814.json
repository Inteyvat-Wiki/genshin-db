					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "#V—Vous êtes {M#un aventurier}{F#une aventurière} ? C'est pour une mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "Hum, laissez-moi voir un instant... « Participant à une compétition de planage », « Guide de survie en nature » et « Instructeur d'escalade »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "Vous travaillez vraiment pour la Guilde des aventuriers ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Je vois ! Lan m'avait déjà fait la même réflexion... Ce ne serait donc pas des aventures que j'ai là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "C'est pourtant le seul genre de missions que je puisse attribuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "Vous n'avez pas de demandes concernant des monstres, par exemple ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "Ce sont des missions dangereuses. Hum, il y a beaucoup de monstres à Lisha qui peuvent s'en prendre aux passants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "Mais une personne normale ne pourrait pas espérer en venir à bout sans être blessée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "#Vous en êtes {M#sûr}{F#sûre} ? Bon, si vous insistez... Je vais parler à Lan pour qu'on convienne d'une récompense à vous donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "#Je ne suis pas une personne ordinaire, je suis {M#un aventurier}{F#une aventurière}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Si vous insistez... Je vais parler à Lan pour qu'on convienne d'une récompense à vous donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
