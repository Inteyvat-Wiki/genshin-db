			"dialogs": [
				{
					"id": 708140701,
					"content": "Vous avez terminé la mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140702,
					"content": "C'est bon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "#C'est donc ça la force d'{M#un aventurier}{F#une aventurière} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140704,
					"content": "Si ça ne vous gêne pas, pourriez-vous répondre à une de mes questions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140705,
					"content": "À part tuer les monstres, quelles missions les aventuriers seraient-ils plus enclins à accepter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140706,
					"content": "Réparer des véhicules et rénover des bâtiments.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Ouah, vous pouvez faire tout ça ? Quelle polyvalence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140710,
					"content": "Merci beaucoup ! Je note tout ça... Avant que je n'oublie, voici votre récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140711,
					"content": "La prochaine fois que vous viendrez me voir, je vous attendrai avec la meilleure des missions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140707,
					"content": "Cueillir des plantes et pêcher du poisson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140708,
					"content": "Livrer des repas et jouer avec des enfants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				}
			]
		}
