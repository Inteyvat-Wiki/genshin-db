			"dialogs": [
				{
					"id": 708140401,
					"content": "Les aventuriers veulent donc entreprendre ce genre de missions dangereuses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140402,
					"content": "Que font-ils en cas de blessures ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
