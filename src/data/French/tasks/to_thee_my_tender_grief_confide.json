				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "#Oh, {M#jeune pêcheur}{F#jeune pêcheuse}, c'est un plaisir de te voir. Qu'y a-t-il ? Un problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Je suis ton instructeur de pêche, tu peux tout me dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "Ah, le léviathan lunaire... Kujirai est encore attachée à cette histoire. Pas étonnant, son vœu était...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "*soupir* Si elle veut découvrir la vérité derrière cette légende, je pense qu'elle sera déçue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "Quel genre de vérité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "Après que nous avons pris la mer, il y a quelques années, je n'ai pas arrêté de faire des recherches sur le léviathan lunaire jusqu'à ce que je trouve une piste dans un vieux livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Grâce à celle-ci, je suis allé consulter un rapport géologique qui m'a appris des choses étonnantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "J'ai inclus ces éléments dans mon livre. Il semble plutôt bien se vendre récemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Tiens, j'ai justement un exemplaire pour toi. Toute la vérité sur le léviathan lunaire est dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "Je veux tout savoir aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "« Comment j'ai découvert que le léviathan lunaire était en fait une tortue de mer géante »... C'est long comme titre... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "Une tortue de mer géante ? C'est ça la véritable forme du léviathan lunaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "C'est exact. Le léviathan lunaire n'est autre qu'une grosse tortue de mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "Cette nuit-là, ce que nous avons vu n'était en réalité qu'une tortue géante dont la carapace était recouverte d'herbes à lampes ou d'une autre plante luminescente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "Cette tortue était enceinte et se dirigeait vers le rivage pour pondre ses œufs. C'est comme ça que nous avons pu retrouver notre chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "Alors retourne le dire à Kujirai. Il faut qu'elle connaisse la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "Oui, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "À en juger par ton expression, tu n'as pas l'air de croire ce que je dis, n'est-ce pas ? J'ai des preuves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "Il était indiqué dans ce vieux livre que le léviathan lunaire était un animal antique qui est apparu il y a très longtemps, quand de très nombreux animaux vivaient encore sur la terre ferme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Leurs ancêtres vivaient dans la région des Monts Dosdragon. D'ailleurs, on peut tomber sur certains fossiles de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "J'en ai découvert la dernière fois sur le versant ouest de la <color=#00E1FFFF>Vallée Ronfledragon</color>. Vas y jeter un œil si tu ne me crois pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
