						],
						"stepId": 7266106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "Il ne reste que des débris de minerais. J'ai l'impression que des gens ont pris ce qu'il y avait dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610502,
					"content": "Hé ?! Mais c'est un Pilleur de trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610503,
					"content": "Tu crois que c'est lui qui a volé ce qu'il y avait à l'intérieur des minerais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610504,
					"content": "Rattrapons-le vite. Son campement doit être dans les environs, tout comme ce qu'il a volé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610505,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "#Il faut rester {M#discrets}{F#discrètes}, il ne faut pas qu'il nous repère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7266106,
			"completionStepIds": [
				7266109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
