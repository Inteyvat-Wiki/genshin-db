			"dialogs": [
				{
					"id": 726610701,
					"content": "Hé, les gars, vous pensez que ce caillou a de la valeur ? Il était à l'intérieur de ce minerai, ça a l'air rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Qi le désuet"
				},
				{
					"id": 726610702,
					"content": "Tu rigoles, j'espère ? T'as déjà ouvert un livre dans ta vie ? C'est ce qu'on appelle un fossile. Fo-ss-ile, compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Lin le fuyard"
				},
				{
					"id": 726610703,
					"content": "Ça vaut une masse de thunes ! On pourrait acheter la moitié du Port de Liyue avec ! Un peu de lecture ne te ferait pas de mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Lin le fuyard"
				},
				{
					"id": 726610704,
					"content": "Ah bon ? Ça vaut autant d'argent ? On en a ramené plein, c'est la commotion assurée au sein de l'organisation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Bazi"
				},
				{
					"id": 726610705,
					"content": "C'est promotion ! Lis des bouquins, toi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Lin le fuyard"
				},
				{
					"id": 726610706,
					"content": "Hé, vous ! Donnez-nous le fossile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Paimon"
				},
				{
