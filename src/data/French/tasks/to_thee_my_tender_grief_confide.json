				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "Vous êtes de retour. Oh ? Jiawei n'est pas venu avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "Il est resté en ville.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "Ah ? Il s'est marié ? Haha ! Ça lui ressemble bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "Après tout, son souhait était de... Bon, je lui pardonne bien parce que c'est lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "Et Nantuck ? Vous l'avez trouvé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "Il a écrit un livre qui se vend très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "Hein ? Il est vraiment devenu écrivain ? Pas mal du tout ! De quoi parle son livre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "Je sais ! Alors, son livre s'appelle : « Comment j'ai découvert que le léviathan lunaire était en fait une tortue de mer géante ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Le nom est long, c'est un roman léger ? Ça m'a l'air bien, je devrais en acheter un exemplaire pour voi... Quoi ? Attendez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "« Comment j'ai découvert que le léviathan lunaire était en fait une tortue de mer géante » ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "Oui, c'était une tortue de mer géante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "Qu'est-ce qu'il raconte ? Comment ça une tortue de mer géante ? Aurait-il oublié qu'on l'a vu de nos propres yeux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "On n'y croyait pas au début aussi, mais après avoir trouvé le fossile du léviathan lunaire... Le voici, avec un exemplaire du livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "Non, je refuse d'y croire. Mon histoire est vraie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "Vous ne comprenez pas. Ma famille, les Kujirai, a de l'influence dans le milieu de la pêche. Mon père est l'un des pêcheurs les plus connus d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "Il a consacré des décennies de sa vie à parcourir la mer pour attraper le léviathan lunaire. Une fois, il avait même presque réussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Bien que mon père ait failli perdre son bateau une fois, il n'a pas renoncé à son but. Attraper le légendaire léviathan lunaire, c'est la plus grande gloire à laquelle un pêcheur peut aspirer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "Mais il n'est jamais revenu après une énième tentative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "Voilà pourquoi je ne crois pas les paroles de Nantuck. Aidez-moi, je vous en prie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "Qu'avez-vous l'intention de faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Je retourne chercher les objets que mon père a laissés. Il a poursuivi le léviathan lunaire toute sa vie et a laissé beaucoup d'informations derrière lui. Je suis sûre que je peux trouver un moyen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "Je vous ai préparé un exercice de pêche. Je vous redemanderai votre aide quand je reviendrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
