			"dialogs": [
				{
					"id": 200500101,
					"content": "Qu'est-ce que je suis censée faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500102,
					"content": "Qu'est-ce qu'il t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Je m'entraîne pour la sélection de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500104,
					"content": "Mais je suis loin d'être aussi puissante que Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500105,
					"content": "Je pense que je devrais me concentrer davantage sur la technique que sur la force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500106,
					"content": "Par exemple, je me demandais comment je pourrais casser tous ces mannequins en un coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500107,
					"content": "Si tu as un peu de temps libre, ça te dit de réfléchir avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500108,
					"content": "Ça marche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Merci. Prends ton temps, ces mannequins n'iront nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500111,
					"content": "Moi non plus d'ailleurs... Je suis coincée ici jusqu'à ce que je trouve la solution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500114,
					"content": "On m'a dit que les éléments interagissent entre eux d'une manière assez spéciale. On pourrait essayer d'utiliser le feu sur ce brasero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500115,
					"content": "Enfin, faudrait déjà qu'il y ait du feu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500109,
					"content": "Voyons voir ça ensemble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "Tu aimes bien combattre en équipe ? C'est super d'avoir quelqu'un sur qui on peut compter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200500113,
					"content": "Le mieux que je puisse faire est de me battre seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Eileen"
				}
			]
		},
