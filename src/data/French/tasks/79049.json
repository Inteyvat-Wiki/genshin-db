			"dialogs": [
				{
					"id": 790490101,
					"content": "Pourquoi y a-t-il un journal intime caché dans un coin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790490102,
					"content": "Apparemment, cette immense dalle de pierre à l'extérieur est un cadeau d'Idyia qui lui servait de toile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790490103,
					"content": "Hmm... On dirait qu'il aimait beaucoup les paysages du Mirage de veluriyam, mais qu'il est aussi devenu ami avec les Gouttelettes qui lui ont donné de nouvelles idées pour ses peintures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790490104,
					"content": "Une rencontre très chanceuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "C'est sûr ! J'ai entendu dire que certaines personnes devenaient folles après un échec ! Elles continuent d'essayer encore et encore jusqu'à en perdre la tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790490107,
					"content": "Il a pu garder la raison grâce au matériel qu'Idyia lui a offert et à la compagnie des Gouttelettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790490105,
					"content": "Bien mieux que d'être obsédé par la pratique intensive.",
					"roleType": "TALK_ROLE_PLAYER",
