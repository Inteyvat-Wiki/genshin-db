			"dialogs": [
				{
					"id": 730030301,
					"content": "Ouf... Enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Rana... Bouhouhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... Mon petit, ne pleure pas... Écoute... Si j'arrive à décrire ce que j'ai ressenti dans la zone de siccité... aux chercheurs de l'Académie... Ils pourront s'occuper de ce problème une bonne fois pour toutes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#Et puis... Tu as vu... Tu as vu comme je me suis battue... Non... Tu as vu comme {NICKNAME} s'est {M#battu}{F#battue} ? N'oublie pas de {M#le}{F#la} remercier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Économisez votre souffle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Reposez-vous, Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ha... haha... Ce n'est rien. J'ai juste la tête qui tourne et un peu de fatigue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Rana... Je suis désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "De... De quoi tu parles ? Tu es mon petit tigre... Alors, ne pleure pas ! Tu vas bien, n'est-ce pas ? Iotham... Tu ne te sens pas bien...? Tu as des vertiges ou tu es fatigué ? ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Je vais bien, mais Rana, tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Ça va... Je n'ai rien. Je suis tout de même une brigadière forestière aguerrie ! Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "Je vais chercher de l'aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
