						730030506
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030506,
					"content": "#Ce n'est pas grave, tant que tu vas bien... {NICKNAME}, donnez-moi une seconde. Je vais venir avec vous, mais je dois d'abord préparer des médicaments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Alphonso"
				},
				{
