					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "La Marana ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "Que l'on appelle aussi... zone de siccité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030820,
					"content": "Ah... Oui, c'est la zone de siccité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "L'avatar de la Marana ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Oui. Il représente la Marana sur terre... C'est quelque chose de très grand et très noir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "La Marana... Quel nom étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Hmm... Comment se fait-il que je sache que la Marana désigne la siccité...? Et mince... J'ai mal à la tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Iotham, c'était quoi cette chose verte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "C'est l'ararakalari... Elle protège les gens de la corrosion de la Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Ça fait de plus en plus de choses que je ne comprends pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "C'est... une sorte de magie de la forêt et aussi un genre de musique... C'est un ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "Un quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Ne pensez plus à tout ça, Rana. Vous devez vous reposer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Je l'ai sur le bout de la langue, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "Pardon, Rana. Je suis désolé... Je ne m'éloignerai plus. Dorénavant, je resterai à la maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Oui, oui, je sais bien. Il faut que tu deviennes intelligent, que tu sois en bonne santé, et que tu saches distinguer ce qui est bon de ce qui est mauvais... Un peu comme savoir quels champignons sont comestibles et lesquels ne le sont pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "D'accord... Bien compris... Désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Il faut que tu saches que la Marana est mauvaise, mais que... la forêt est bienveillante... Il faut que tu deviennes quelqu'un de fort et de droit, qui aide son prochain... Comme {NICKNAME} et Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "Et n'oublie pas... que la forêt se souvient de tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Oh non ! On dirait que Rana va de plus en plus mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Allons chercher de l'aide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Hein ? Oh, ce n'est rien... J'ai juste besoin de me reposer un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, s'il vous plaît... Aidez-moi à ramener Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Oui. Partons, Iotham. Rana, ne bougez pas, on revient tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, attendez-nous ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
