						730030721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030721,
					"content": "Oui, nara Iotham, c'est l'ami d'Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030727,
					"content": "#Les aranaras sont les enfants de la forêt, on vit avec les arbres. Nara {NICKNAME}, t'es pas pareil, t'es l'enfant des pissenlits, toujours en voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030728,
					"content": "#Comment connais-tu le nom de {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030729,
					"content": "C'est pas important. L'important, c'est qu'Arana veut aider nara Rana.",
