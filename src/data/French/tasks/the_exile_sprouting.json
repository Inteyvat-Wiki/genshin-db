			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "#Vous savez manipuler l'élément Dendro ? Serais-je tombée sur {M#un détenteur}{F#une détentrice} d'œil divin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930902,
					"content": "Ça fait longtemps que je n'ai pas vu quelqu'un qui possède un œil divin. Ça me rend nostalgique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930903,
					"content": "Ça va comme ça, Sabbah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Oui, en utilisant l'élément Dendro directement sur ces graines, elles devraient germer très rapidement. Attendons un peu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930905,
					"content": "Petit à petit, quelques jeunes pousses fines émergent de la terre.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Quelques feuilles vertes s'ouvrent, et les jeunes pousses cessent de croître.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Elles ont germé ! Je vous l'avais dit, {NICKNAME} est capable de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "Les résultats sont visibles immédiatement, comme je m'y attendais... Merci à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930909,
					"content": "C'est dommage qu'elles n'aient pas fleuri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "Ah, c'est tout à fait normal. Il faut savoir être patient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930911,
					"content": "Les plantes ont plusieurs étapes de croissance comme la germination, la ramification, le bourgeonnement et la floraison. Le fait que vous arriviez à faire germer ces graines aussi rapidement est déjà très impressionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930912,
					"content": "Les roses ont besoin d'un peu plus de temps pour absorber davantage de nutriments avant de pouvoir fleurir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930913,
					"content": "Je vous suis déjà très reconnaissante pour tout ce que vous avez fait aujourd'hui. Il serait donc impoli de ma part de vous déranger davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930914,
					"content": "Revenez les voir de temps en temps quand vous aurez le temps, ça sera déjà très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
