					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "J'ai un trésor à vous vendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Quels objets rares avez-vous trouvés cette fois-ci ? Montrez-les-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Vous racontez ce qui s'est passé avec l'orbe d'os-dragon à Linlang.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "À vous entendre, on dirait qu'il s'agit d'une relique exceptionnelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Mais après un examen rapide, je n'ai rien trouvé de spécial à son sujet. Peut-être faut-il l'utiliser longuement pour qu'il révèle ses qualités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "De la façon dont je le vois, il semble que les propriétés merveilleuses que vous lui attribuez soient un peu... exagérées. Ou peut-être m'avez-vous raconté des excuses utilisées par quelqu'un qui aurait failli à sa tâche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Haha, ne le prenez pas mal. Je ne fais que dire ce qui me passe par la tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "C'est un phénomène assez courant dans notre domaine, en tout cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "De plus, il semble que vous ne l'avez pas conservé dans un endroit étanche. En regardant un peu, on peut voir des marques d'usure sur sa surface.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "J'ai bien peur de devoir baisser le prix également pour cette raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "Que dites-vous de 80 000 moras ? Et je vous offre 5 années d'abondance avec cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Je pense que c'est un bon prix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "... Qu'allez-vous en faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Pour être honnête, je trouve que l'histoire qu'il y a autour de cet objet a plus de valeur que l'utilité même de l'objet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Je suppose que le conteur d'histoire, la troupe d'opéra, ou encore les nobles de la Terrasse Yujing trouveront cela intéressant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Rien que le fait de le présenter sur le comptoir de ma boutique peut le transformer en relique rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "Ça me paraît raisonnable. Marché conclu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Vous n'y allez pas par quatre chemins. Voici vos moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "N'hésitez pas à revenir si vous trouvez d'autres trésors comme celui-ci. Notre boutique vous accueillera à tout moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Je vais réfléchir encore un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Pas de problème. Après tout, il faut toujours comparer la marchandise – je veux dire, les prix – quand on envisage de vendre des reliques précieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "#Revenez quand vous vous serez {M#décidé}{F#décidée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
