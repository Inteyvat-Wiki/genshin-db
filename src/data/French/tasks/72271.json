			"dialogs": [
				{
					"id": 722710201,
					"content": "À propos de l'orbe d'os-dragon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "Alors, avez-vous réfléchi à mon offre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710203,
					"content": "Nous pouvons vous l'acheter pour 80 000 moras et 5 années d'abondance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710204,
					"content": "Il est à vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Merci de votre visite. Voici vos moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710206,
					"content": "N'hésitez pas à revenir si vous trouvez d'autres trésors comme celui-ci. Notre boutique vous accueillera à tout moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710207,
					"content": "Laissez-moi y réfléchir encore un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
					"content": "Après tout, il faut toujours comparer les prix quand on souhaite vendre des objets précieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710209,
					"content": "#Revenez quand vous vous serez {M#décidé}{F#décidée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		}
