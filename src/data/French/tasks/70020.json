					"nextDialogs": [
						700200201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700200201,
					"content": "Yeye dada ! Mosi mita !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200202
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700200202,
					"content": "Odomu tomo zido mi ! Mi mani yeye ! <color=#00E1FFFF>Unta nunu</color> !",
