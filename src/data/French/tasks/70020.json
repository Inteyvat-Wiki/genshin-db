					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200205,
					"content": "Tomo, valo !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200203,
					"content": "« <color=#00E1FFFF>Unta nunu</color> »... On dirait que ça a quelque chose à voir avec le temps... On regarde les notes ?",
