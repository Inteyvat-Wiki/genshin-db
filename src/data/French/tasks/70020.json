						700200104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200104,
					"content": "Mimi tomo, Odomu nye ! Muhe mani ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200105,
					"content": "Mani ? Mani ! Yoyo mani mi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200106
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700200106,
					"content": "Dada !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200107,
					"content": "Dada !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200108,
						700200109
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700200108,
					"content": "On dirait que tout se passe bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "Je lui ai demandé s'il avait besoin d'aide. Et apparemment, il a vraiment besoin de nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200111,
					"content": "Dada odomu ! Kundala dada ! Kundala zido, mi dada ! Muhe yeye !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700200112,
					"content": "Oh... Il veut dire qu'il a besoin de nous pour l'aider à vaincre des ennemis... très forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200113,
					"content": "Ya zido ? Ye ? Mi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200114,
					"content": "Mi ! Mi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 700200115,
					"content": "Bon, l'emplacement est indiqué sur la carte. Je vous laisse faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brutocollinus"
