					"nextDialogs": [
						230040503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040503,
					"content": "#Des Fongus... Ouf, heureusement que je n'y suis pas allé seul. Merci beaucoup, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040504
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040504,
					"content": "Je vous en suis infiniment reconnaissant. Veuillez accepter ceci en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040505
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040505,
					"content": "Venez manger, mes petits serpents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
