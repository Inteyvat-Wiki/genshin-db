			"dialogs": [
				{
					"id": 230042401,
					"content": "Ah ! Ne serait-ce pas là le mur d'escalade que j'ai fabriqué ? Ça me rappelle tant de souvenirs, hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "Un mur d'escalade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "C'est un jouet pour mes petits serpents. Ils peuvent grimper dessus. Sans ça, ils s'enrouleraient toujours sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Merci de me l'avoir rapporté. Veuillez accepter ceci en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "Je l'avais conçu comme ça ? Ça m'évoque plein de souvenirs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
