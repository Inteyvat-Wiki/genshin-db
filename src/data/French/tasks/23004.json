					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Oh ? Ces chapeaux... Hahaha, je les avais fabriqués pour mes petits serpents. Comment ai-je pu les perdre aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "J'avais fabriqué un bonnet de nuit pour chaque serpent. Je voulais attirer plus d'enfants à mes spectacles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Le rouge était pour Jori, le vert pour Amum, le jaune pour Gana et le bleu pour Drak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "À vous entendre, ça avait l'air très mignon. Je suis sûre que votre spectacle a cartonné !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "Au début, oui. Mais une fois que les serpents ont ouvert leurs bouches, les enfants ont commencé à pleurer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "*soupir* Bref, n'en parlons plus. Veuillez accepter ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
