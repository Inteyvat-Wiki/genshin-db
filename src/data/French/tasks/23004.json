			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Hein ? Cette perle... Où l'avez-vous trouvée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Dans un pot au camp, est-ce à vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "C'est un objet que j'utilisais lors de mes spectacles. Quand je jouais de la flûte, mes serpents dansaient avec cette perle sur la tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Mais cela fait déjà bien longtemps que ce genre de pirouettes ne marche plus trop. Et puis, je n'ai pas donné le moindre spectacle depuis un bon moment, alors je ne m'étais même pas rendu compte que j'avais perdu cette perle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "En tout cas, merci de me l'avoir rapportée. Veuillez accepter ceci en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
