			"dialogs": [
				{
					"id": 230041101,
					"content": "Il y a vraiment de la nourriture spéciale pour les serpents domestiques ? Je croyais qu'ils se contentaient de souris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041102,
					"content": "Au début, ils la cherchaient eux-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041103
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041103,
					"content": "Mais je n'ai plus osé les laisser sortir après qu'ils ont effrayé plusieurs enfants. Alors j'ai commencé à préparer leur nourriture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041104
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041104,
					"content": "*soupir* ... Depuis que je les nourris, ils sont devenus paresseux et ne veulent plus rien manger d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041105
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041105,
					"content": "Hmm... De la nourriture obtenue sans bouger le petit doigt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041106,
						230041107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041106,
					"content": "Délicieux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				},
				{
					"id": 230041108,
					"content": "Je n'ai même pas encore parlé du goût. N'y pense pas, tu n'auras pas l'occasion d'y goûter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041109,
					"content": "C'est pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041110,
					"content": "Tu es bien sûre de toi, dis donc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041111
					]
				},
				{
					"id": 230041111,
					"content": "J'ai peut-être laissé la nourriture dans un camp quand je suis parti cueillir des herbes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041112
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041112,
					"content": "Mais je ne peux pas aller la chercher, je dois rester ici pour prendre soin de mes petits... Il ne faudrait pas qu'ils effraient d'autres personnes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041113
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041113,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous vous rendre au camp et me ramener la nourriture ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041114,
						230041117,
						230041119
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041114,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041115
					]
				},
				{
					"id": 230041115,
					"content": "Merci à vous. Je ne crois pas que c'est une bonne idée pour moi d'y aller avec mes serpents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041116
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041116,
					"content": "Imaginez qu'ils soient attirés par quelque chose et finissent par jouer dans la forêt pendant quelques jours, je serai fichu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041122,
					"content": "#En tout cas, je compte sur vous, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041123
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041123,
					"content": "J'ai marqué les camps où je suis resté cette fois-ci sur votre carte. Allez y jeter un œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041117,
					"content": "Y a-t-il d'autres serpents là-bas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041118
					]
				},
				{
					"id": 230041118,
					"content": "Non, il n'y en a pas. Quand j'ai choisi l'emplacement de ces camps, je me suis assuré qu'il n'y avait pas d'autres serpents dans le coin, afin d'éviter tout problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041119,
					"content": "Vous avez plusieurs camps ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041120
					]
				},
				{
					"id": 230041120,
					"content": "J'en ai aménagé un bon nombre quand je vivais dans la forêt tropicale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041121
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041121,
					"content": "Et bien que je n'y vive plus aujourd'hui... Je me repose dans ces camps chaque fois que je vais en forêt pour cueillir des herbes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041107,
					"content": "Vraiment délicieux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				}
			]
		},
