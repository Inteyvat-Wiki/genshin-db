					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "Tous ceux que j'ai montés autrefois sont presque tous à l'abandon maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Gulabgir"
