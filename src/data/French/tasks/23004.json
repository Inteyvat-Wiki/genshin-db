			"dialogs": [
				{
					"id": 230040701,
					"content": "Oui ! Je l'avais bien perdue dans un camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "C'était sous des pierres. Il y a dû avoir un éboulement à l'emplacement du camp et la nourriture a dû rouler très loin. On l'a trouvée après un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "Ah bon ? C'est étrange qu'il y ait eu un éboulement là-bas, l'endroit a toujours été sans danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Ah, ça me revient ! Lorsque j'ai campé là-bas, j'ai entendu des bruits étranges pendant la nuit. Et puis quelque chose n'arrêtait pas de se frotter à ma tente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "Mes petits serpents sont restés très vigilants et m'ont réveillé à chaque fois. Mais je n'ai rien pu voir quand je sortais vérifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "Enfin bref, trêve de bavardages. Merci à vous. Veuillez accepter ceci en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
