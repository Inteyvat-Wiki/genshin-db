			"dialogs": [
				{
					"id": 230040501,
					"content": "Oui ! Je l'avais bien perdue dans un camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040502
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040502,
					"content": "#Nous avons surpris des Fongus en train de les manger quand nous sommes {M#arrivés}{F#arrivées}.",
