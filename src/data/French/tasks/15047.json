			"dialogs": [
				{
					"id": 150470501,
					"content": "Vous revenez, après avoir habité un iktomisaure...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "Mualani, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470503,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#Oh ! Il est trop mignon ! Où est passé {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "#Euh, {NICKNAME} a eu mal au ventre, alors {M#il est parti}{F#elle est partie} aux toilettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(Paimon, ton excuse est nulle... Bref, tant que Mualani y croit...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "T'es gentil, toi ! Tu veux goûter au champicorne brillant ? Tiens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470509,
					"content": "(Ce champignon a une saveur curieuse, en effet. C'est épais, juteux et étonnamment délicieux...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Haha ! Je suis contente que tu aimes ! Ils sont tous à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470512,
					"content": "Je peux te caresser ? Soyons amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470513,
