			"dialogs": [
				{
					"id": 150470101,
					"content": "Vous êtes là ! On dirait que le personnel a dû s'absenter un peu, mais j'ai plus ou moins découvert comment jouer avec... Je veux dire, comment terminer les tests !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Super ! Montrez-nous alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "En gros, une personne est sur le bateau tandis que l'autre envoie des signaux au personnel saurien. L'objectif est de guider le bateau en toute sécurité jusqu'à sa destination grâce à ce travail d'équipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Je suis assez confiante, car {NICKNAME} et moi, savons travailler parfaitement bien ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Vraiment ? Parce que les gens qui se vantent finissent souvent par chavirer, vous savez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Hé, Paimon ! Ne dites pas ce genre de choses, ça porte la poisse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "D'accord... Du coup, je vous souhaite... un bon voyage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Héhé, évidemment qu'il sera bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "En fait, j'ai plutôt envie de prendre le bateau. Je relève souvent des défis de surf difficiles, alors ce sera bien de changer mes habitudes pour une fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "Je me lasse de la barge moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Vous voyez, on est parfaitement synchro ! C'est la preuve que notre lien est fort, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "J'ai hâte de gonfler mon maillot de bain gonflable et de rebondir sur le bateau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Je m'occupe des signaux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
