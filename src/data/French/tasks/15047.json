			},
			"dialogs": [
				{
					"id": 150470401,
					"content": "... Oh, c'est encore en construction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470402,
					"content": "Regardez, il y a un employé iktomisaure ! On lui demande de l'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470403,
					"content": "Bonjour ! Pourrais-tu nous aider à construire ceci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150470405,
					"content": "Pose-le... ici... et construis-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150470407,
					"content": "Il n'a pas l'air de comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470408,
					"content": "C'est vrai... Qu'est-ce qu'on fait maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470409,
					"content": "... Attendez, j'ai une idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470410,
					"content": "Hii !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150470412,
					"content": "Hii ! Hii ! Hii !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470413,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150470414,
					"content": "Ah, ça n'a pas marché... Au moins, on sait maintenant qu'il ne parle pas le koholasaure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470415,
					"content": "Et si on...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "Hé, j'ai une autre idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470417,
					"content": "Quoi encore ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470418,
					"content": "Un jour, j'ai entendu Ifa dire que les iktomisaures adorent les champicornes brillants... Et devinez ce que j'ai sur moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470419,
					"content": "Parfait, ça va marcher ! Une fois qu'il aura fini de manger ça, on sera sur la même longueur d'onde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470420,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150470421,
					"content": "On n'a jamais trop d'affaires quand on part pour un long voyage... Kachina avait raison. Merci, Kachina !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470422,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "Jeune iktomisaure"
				},
				{
					"id": 150470423,
					"content": "Ce n'est pas ce que j'appelle être sur la même longueur d'onde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470424,
					"content": "Quelle catastrophe... Mon rêve de relever tous les défis de la Baie vaguelée s'est évaporé dès le premier jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470425,
					"content": "#{NICKNAME}, illustre {M#héros}{F#héroïne} {NICKNAME}, avez-vous une idée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470426,
					"content": "Il y a toujours cette option...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "D'accord, essayons ! Merci, et désolée pour le dérangement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470427,
					"content": "Je vais aller chercher un autre iktomisaure pour nous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
