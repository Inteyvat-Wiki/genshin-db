					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Ce n'est pas si évident, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "#Notre capitaine serait furieuse si l'on apprenait que nous, membres de la brigade volante, pouvions être battus par n'importe {M#quel aventurier}{F#quelle aventurière} de passage. Haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "Allez, il n'y a pas de quoi se morfondre. Je devrais vous remercier d'avoir préservé ma fierté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "#Vous vous êtes bien {M#débrouillés}{F#débrouillées}, mais vous êtes encore un peu jeunes pour me battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "Si vous pensez pouvoir faire mieux, pourquoi ne pas réessayer ? Vous ne devriez jamais arrêter d'essayer tant que vous êtes jeunes. De toute façon, ce n'est pas grave de perdre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
