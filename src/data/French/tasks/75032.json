				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "Il est temps pour mon saurien de retourner à son nid. Dois-je moi aussi descendre de la scène céleste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320602,
					"content": "N'arrêtez pas de voler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "Je suppose que vous m'avez entendue marmonner, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320606,
					"content": "Je devrais rentrer chez moi, je n'ai pas encore parlé de ma retraite à ma famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320607,
					"content": "J'aurai bientôt beaucoup de temps libre, mais je ne sais pas encore ce que je pourrais en faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320608,
					"content": "Une fois que j'aurai trouvé mes repères, je devrai affronter la prochaine étape de ma vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320609,
					"content": "Je devrais donc d'abord entendre ce que ma famille a à dire à ce sujet. Mon père faisait partie de la brigade volante et il est devenu maître-formateur après sa retraite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320610,
					"content": "Il a suivi cette voie, il doit donc avoir un avis sur la question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320611,
					"content": "#Je vais démonter cet endroit et l'emporter, mais je laisserai le parcours en l'état. Après tout, les jeunes {M#guerriers}{F#guerrières} comme vous ont toujours besoin d'un endroit pour s'entraîner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320612,
					"content": "Est-ce qu'on se reverra, Manyoya ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320613,
					"content": "Je ne sais pas. Mais, quel que soit le choix que je ferai, je ne pense pas pouvoir un jour abandonner les airs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320614,
					"content": "Tant que vous continuerez à voler, je pense que nous nous reverrons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320615,
					"content": "À la prochaine fois, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "#À bientôt, jeune {M#guerrier}{F#guerrière}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320604,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "Ah, vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				}
			]
		},
