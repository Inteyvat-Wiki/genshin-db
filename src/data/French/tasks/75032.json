			},
			"dialogs": [
				{
					"id": 750320101,
					"content": "La vue est belle, vous ne trouvez pas ? C'est également parfait pour prendre son envol. S'élever dans les airs, suivre le vent... C'est une sensation géniale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320102,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "#Bonjour, {M#guerrier}{F#guerrière} ! Si vous voulez faire un vol d'essai ici, n'hésitez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320105,
					"content": "Mon père a construit cet endroit pour moi, mais ça ne me dérange pas de le partager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320106,
					"content": "Merci, j'avais justement envie d'essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "#De rien ! Du moment que vous aimez voler, vous êtes l'{M#ami}{F#amie} de Manyoya ! C'est moi, au fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320109,
					"content": "#Vous avez l'air un peu jeune pour la brigade volante des chevaucheurs de sauriens. Êtes-vous {M#un chevaucheur}{F#une chevaucheuse} de réserve ? Ou vous entraînez-vous pour devenir {M#un guerrier}{F#une guerrière} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320110,
					"content": "#Nous ne sommes que des {M#aventuriers}{F#aventurières} de passage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "#Oh ? Je vois rarement des {M#aventuriers}{F#aventurières} autant {M#passionnés}{F#passionnées} par le vol. Jusqu'à il y a quelques instants, je pensais que vous vous entraîniez pour l'épreuve de la brigade volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320112,
					"content": "S'élever dans les airs... C'est une sensation qu'on n'oublie jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320113,
					"content": "Je doute que vous trouviez quiconque qui ne souhaiterait pas conserver cette liberté envers et contre tout, et je ne fais pas exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320114,
					"content": "Vous avez l'air de savoir de quoi vous parlez. Êtes-vous de la brigade volante ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320115,
					"content": "Haha ! Je l'étais ! Je suis à la retraite maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320116,
					"content": "J'ai volé pendant plusieurs années, et même si ça ne me rend pas trop vieille à bien des égards, j'étais une véritable vétérane de la brigade volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320117,
					"content": "Alors, quand ma condition physique s'est dégradée, il a été temps de dire au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320118,
					"content": "Je ne suis pas à plaindre. Haha ! Je ne suis même pas triste, même si c'est dommage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320119,
					"content": "Nos jeunes chevaucheurs de sauriens viennent tout juste de commencer à prendre leur envol, mais j'ai déjà attrapé une étoile filante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320120,
					"content": "Bien sûr, les choses ne seront plus les mêmes et je ne passerai plus la majeure partie de mon temps dans les airs. Mais j'aurai encore l'occasion d'y retourner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320121,
					"content": "C'est pourquoi je suis ici, pour me remémorer la vie que j'ai laissée derrière moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320122,
					"content": "Dommage que voler en solitaire soit plutôt ennuyeux sans la compagnie de mes camarades de la brigade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320123,
					"content": "Oh, au fait. Ça vous plairait de voler avec moi ? Notre brigade faisait souvent des petites compétitions, juste pour s'amuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320124,
					"content": "#{M#Celui}{F#Celle} qui obtient le score le plus élevé reçoit les louanges tandis que l'autre paie le repas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320125,
					"content": "Les chevaucheurs de sauriens sont un groupe très soudé, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320126,
					"content": "Oui, tout le monde est incroyable. Nous sommes à la fois coéquipiers et rivaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320127,
					"content": "Ah, non pas que je pourrai un jour profiter à nouveau de cette atmosphère... Je ne peux pas non plus nier que mes compétences ne cessent de diminuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320128,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320129,
					"content": "Mais même si la force physique diminue et le jugement s'émousse, l'expérience ne cesse de s'accumuler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320130,
					"content": "J'ai donc peut-être pris ma retraite de la brigade, mais pas celle des airs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320131,
					"content": "Alors, qu'en dites-vous ? Pensez-vous pouvoir rivaliser dans les airs avec une vétérane des chevaucheurs de sauriens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320132,
					"content": "Marché conclu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "#Hm. J'ai eu peur pendant un moment que vous me preniez pour un monstre parce que j'ai brusquement mentionné ces choses à {M#un}{F#une} jeune comme vous. Heureusement, ce n'est pas le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320135,
					"content": "Mais faites-moi savoir quand vous voudrez essayer. Fixons-nous ceci comme objectif :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320136,
					"content": "Chevauchez votre saurien aussi loin que possible le long du parcours dans le délai imparti. Je vais vous aider à compter les points. Les résultats sont divisés en 4 niveaux, et nous compterons ça comme une victoire si vous parvenez à battre le deuxième meilleur niveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320137,
					"content": "#Faites-moi savoir quand vous serez {M#prêt}{F#prête} à me défier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320133,
					"content": "Je dois y réfléchir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "Merci. Peut-être quand je serai libre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "Bonjour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
			"id": 7503202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503203",
							"2"
						],
						"stepId": 7503203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "Alors, qu'est-ce que vous en dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320202,
					"content": "Chevauchez votre saurien à toute vitesse le long du parcours et réalisez le meilleur score possible dans le délai imparti. <color=#00E1FFFF>Battez le deuxième meilleur score et la victoire de cette manche est à vous.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320203,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "Bon ! Allons au point de départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320205,
					"content": "J'ai besoin de plus de temps pour me préparer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "#Bien sûr. Faites-moi savoir quand vous serez {M#prêt}{F#prête}. Voler a toujours été synonyme de détente et de plaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503204",
							"2"
						],
						"stepId": 7503204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "#Haha ! Vous étiez {M#génial}{F#géniale} ! Je suppose que ce qu'on dit est vrai, la jeunesse est vouée à surpasser les anciens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320402,
					"content": "Même les étoiles peuvent tomber, sans parler des humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320403,
					"content": "J'ai fait mon temps. Prendre une retraite heureuse était le bon choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320405,
					"content": "... Ah, mais c'est tellement difficile à accepter. Je suis encore jeune, je n'ai même pas de rides. Pourquoi devrais-je prendre ma retraite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320406,
					"content": "Comment ma carrière a-t-elle pu se terminer aussi tôt ? J'ai commencé à tomber avant même de savoir ce que ça fait d'atteindre le sommet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320407,
					"content": "Si j'avais su que je nourrirais autant de regrets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320408,
					"content": "Ce n'est pas grave. Si c'était à refaire, je referais les mêmes choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320409,
					"content": "Je ferais encore de mon mieux pour rejoindre la brigade volante, ce qui n'est pas difficile compte tenu de mes compétences. Ensuite, je finirais par prendre ma retraite au même âge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320410,
					"content": "J'ai fait de mon mieux et tout ce que je peux faire maintenant, c'est l'accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320411,
					"content": "Je suppose que c'est la vie. Beaucoup de choses échappent à notre contrôle. Quand on rêve de devenir une héroïne, on doit peut-être accepter qu'on ne puisse briller que l'espace d'un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320412,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320413,
					"content": "#Ne vous inquiétez pas, {M#il}{F#elle} est très {M#doué}{F#douée}. Vous aviez ce regard plein de pitié tout du long, alors pourquoi ce visage inquiet maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320414,
					"content": "Haha ! La vie est pleine de surprises, et elles arriveront, que vous les acceptiez ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320415,
					"content": "Prenez ça comme une perle de sagesse de la part d'une chevaucheuse de sauriens à la retraite. C'est à moi de résoudre mes problèmes. Ne les laissez pas gâcher votre humeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320416,
					"content": "Je suis impressionnée. Si seulement mes frères étaient aussi calmes que vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320417,
					"content": "Vous avez des frères ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320418,
					"content": "C'est exact, j'ai deux jeunes frères. Et contrairement à vous, c'est une véritable corvée d'avoir affaire à eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320419,
					"content": "Ils s'entraînent aussi à voler... Enfin, non. Acomitl se concentre simplement sur son départ de la brigade, alors il est peut-être plutôt en train de se cacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320420,
					"content": "Oublions ces gamins. Je peux voir votre talent, clair comme de l'eau de roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320421,
					"content": "Essayez de vous entraîner un peu plus si vous avez le temps. Qui sait ? La brigade volante pourrait venir frapper à votre porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320422,
					"content": "Je ferai de mon mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "#Très bien. J'espère que je vous surprendrai à voler à nouveau. Bonne chance, jeune {M#guerrier}{F#guerrière}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503206",
