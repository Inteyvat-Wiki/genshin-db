			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "Qu'est-ce qu'il y a, les enfants ? Vous aussi, vous venez vous moquer du vieil homme qui fait pousser des pierres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040102,
					"content": "Je vais bien, et je n'ai pas besoin que les villageois s'en préoccupent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040103,
					"content": "Hé oh, inutile d'être si agressif dès le début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040104,
					"content": "Vous vous méprenez, on n'est pas du Village d'Aaru, et on n'est pas non plus là pour se moquer de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040105,
					"content": "On ne fait que passer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Vous êtes juste de passage ? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040110,
					"content": "D'habitude, les seules personnes qui viennent ici sont de vieilles connaissances à moi. Ils n'arrêtent pas de me dire d'abandonner cette pépinière et de retourner au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040111,
					"content": "Il y a aussi quelques garnements qui s'amusent à venir ici pour causer le désordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040112,
					"content": "C'est la première fois que je vois des gens habillés comme vous. Qu'est-ce que vous faites ici, mes enfants ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040113,
					"content": "#On est des {M#voyageurs}{F#voyageuses} à la recherche de nos proches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Oui, et pour atteindre cet objectif, on a fait beaucoup de route et on a surmonté bon nombre de dangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040115,
					"content": "#{M#Lui}{F#Elle}, c'est {NICKNAME}. {M#Il}{F#Elle} est quelqu'un de droit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040119,
					"content": "On ne s'amuse pas à intimider les personnes âgées qui vivent seules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040120,
					"content": "Donc ne vous inquiétez pas, monsieur. On n'est pas des mauvaises personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040121,
					"content": "Ahem. C'est un peu gênant de devoir m'excuser auprès de vous, les enfants. Excusez-moi, j'aurais dû réfléchir avant de parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040122,
					"content": "Les enfants, mon nom est Affan et je vous présente mes excuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040123,
					"content": "#Regardez-vous, si jeunes et déjà capables de prendre soin de vous-mêmes. Vous êtes {M#débrouillards}{F#débrouillardes}, plus que je ne l'étais quand j'étais jeune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040124,
					"content": "Si j'ai bien compris ce que vous venez de dire, je peux faire appel à votre aide si j'ai un souci à régler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040125,
					"content": "Oh ? Vous voulez dire que vous avez une mission à nous confier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040126,
					"content": "Quel genre de problèmes avez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "J'ai en fait deux pépinières, une ici et l'autre à l'ouest du village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040128,
					"content": "Je suis trop vieux pour m'en occuper tout seul. Je ne suis pas allé à l'autre pépinière pendant plusieurs jours, et celle-ci a été envahie par quelque chose de sombre et d'étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040129,
					"content": "C'est trop dangereux ! J'ai failli ne pas réussir à sortir. Ça m'a tellement effrayé que je n'ose même plus m'approcher de ce champ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040130,
					"content": "Mon plus grand espoir est de soigner le sol de cette pépinière afin que je puisse y planter des fleurs à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040131,
					"content": "#Ça n'a pas l'air trop compliqué. Qu'en penses-tu, {NICKNAME} ? Devons-nous accepter cette mission ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040132,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "La pépinière se trouve à l'ouest du village, ne vous trompez donc pas de chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040134,
					"content": "Ne vous inquiétez pas, c'est du gâteau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040116,
					"content": "#Je suis aussi {M#un aventurier}{F#une aventurière} qui explore le monde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Oui, on a franchi beaucoup de lacs et de montagnes pour arriver à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040118,
					"content": "#Comment on dit déjà ? On est... Euh... Des {M#aventuriers}{F#aventurières} au grand cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040107,
					"content": "On a entendu dire que quelqu'un faisait pousser des fleurs ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Oui, c'est vrai. Je plante des fleurs, pas des pierres de pacotille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040109,
					"content": "Je pensais que... Oups, qu'est-ce que je voulais dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Vous êtes de retour. Comment va la pépinière ? Pensez-vous qu'elle puisse être sauvée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040402,
					"content": "C'est réglé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Vous expliquez le problème de la siccité à Affan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "C'est donc ça. Pas étonnant que tant de choses sombres et étranges soient soudainement apparues dans une terre de si bonne qualité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040405,
					"content": "Très bien, excellent. Je peux enfin planter des graines sans m'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040406,
					"content": "Lorsque ces trois graines germeront, fleuriront et produiront de nouvelles graines, je planterai ces dernières dans ce champ. De cette manière, il y aura des fleurs partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040407,
					"content": "#Hein, ces pierres aux formes étranges ? Elles peuvent faire pousser des fleurs{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040408,
					"content": "Monsieur Affan, où avez-vous acheté tout ça ? Ne vous laissez pas berner par les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040409,
					"content": "Tu as bon cœur, petite. Ne vous inquiétez pas, il est impossible d'acheter ces graines de fleurs avec des moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040410,
					"content": "Ces trois-là sont... Euh... Des graines précieuses qu'un ami m'a laissées. Alors bien sûr qu'elles sont différentes des semis de fruits et de fleurs ordinaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040411,
					"content": "Ça a l'air bien étrange. Monsieur Affan, qu'est-ce que vous allez planter exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040412,
					"content": "Héhé, ce que je vais planter est la volonté d'un ami, un souhait de sa part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040413,
					"content": "Quelle curieuse réponse. Ça se plante, ces choses-là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040414,
					"content": "Petite, tu ne comprendrais pas même si je te l'expliquais. Reviens voir plus tard quand tu en auras l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040415,
					"content": "Elle est peut-être vide à l'heure actuelle, mais ces graines germeront dans cette pépinière et produiront des fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040416,
					"content": "Plus tard, il y aura de plus en plus de fleurs. Haha, ça sera magnifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040417,
					"content": "Bon, puisque vous m'avez fait une faveur, je vais vous récompenser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040418,
					"content": "Tenez, vous deux. Il n'y a pas grand-chose que je puisse vous donner, tout est là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040419,
					"content": "Ouf, la mission est terminée. J'ai un peu faim après avoir fait tout ce trajet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040420,
					"content": "C'est pourtant moi qui ai dû courir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "J'ai discuté avec toi sur la route. Parler consomme aussi de l'énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040422,
					"content": "#Ne sois pas si pingre, {NICKNAME}. Que dirais-tu d'aller se payer un excellent repas avec cet argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040423,
					"content": "Voyons voir combien de repas on va pouvoir s'offrir avec cette paie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040424,
					"content": "Je regarde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "Hein ? Des shawarmas, du tahtchine et beaucoup de légumes. Il y a plus de nourriture que de moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040426,
					"content": "C'est trop. Est-ce qu'on... aurait pris la nourriture qu'Affan était censé manger aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040427,
					"content": "Ça doit être difficile pour monsieur Affan de vivre seul en dehors du village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "En plus des moras, il nous a même donné toute sa nourriture. Euh... Je me sens un peu mal à l'aise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040429,
					"content": "Et puis il a planté des graines qui ressemblaient à des cailloux, et malgré ça, il nous a assuré qu'il plantait... un souhait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040430,
					"content": "Est-il possible qu'il ait vécu seul trop longtemps et qu'il se soit mis à imaginer des choses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040431,
					"content": "Je m'inquiète de plus en plus pour lui. Allons lui rendre visite quand on aura le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
