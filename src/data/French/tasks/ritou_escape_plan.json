			"dialogs": [
				{
					"id": 20131001,
					"content": "Ouf, on peut se réfugier dans le village en face. Comment allez-vous, mademoiselle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Je vais parfaitement bien. Vous pouvez vous arrêter ici. La route vers l'Île de Narukami est juste là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
