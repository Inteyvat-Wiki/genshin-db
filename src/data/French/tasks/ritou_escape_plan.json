			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Attendez s'il vous plaît... Ces marchandises sont envoyées à... l'Île de Watatsumi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "Mademoiselle ! Quelle surprise inattendue. Vous avez raison, ce lot de marchandises a été spécialement mandaté par le Commissaire économique. Nous devons nous assurer qu'il atteigne l'Île de Watatsumi intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "Il y a quelque chose qui ne va pas, mademoiselle Hiiragi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "Non. Mon père était simplement inquiet pour la sécurité du convoi et m'a ordonné de venir avec une escorte spéciale pour m'assurer du transport de marchandises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Mademoiselle, vous ne suggérez tout de même pas que vous avez l'intention d'accompagner personnellement ce convoi, n'est-ce pas ? Vous n'avez certainement pas à vous soucier de ce genre de chose, et quant à cette « escorte spéciale »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "J'ai hâte qu'on travaille ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "S'il vous plaît, ne nous retardez pas. Si ma mémoire est bonne, mon père a dit que ce convoi devait arriver à temps. Je suis sûre qu'il y aura des représailles si ce n'est pas le cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Oui, bien sûr mademoiselle. C—C'est juste que... Eh bien, on ne connaît pas cette personne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "Dois-je vous rappeler quelle est la sentence s'il devait m'arriver quelque chose ? Je suis sûre que vous connaissez le caractère de mon père.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "Êtes-vous vraiment sûrs de pouvoir garantir ma sécurité à vous seuls ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Eh bien, Chisato sait argumenter, ils n'ont pas la moindre chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "A—Ah, oui mademoiselle. Très bien alors... C—C'est un honneur de vous avoir avec nous. Votre sécurité est notre priorité absolue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "Shinnojou ! Tu vas vraiment accepter ça !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "Eh bien, la requête vient de mademoiselle Hiiragi elle-même. C'est notre devoir de la servir de notre mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Oui, mais... ce n'est pas le problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "Bon, si c'est réglé, alors je suggère qu'on parte sur-le-champ. Flâner ne laissera que plus de temps aux voleurs potentiels pour nous attaquer, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "O—Oui, mademoiselle. Vous avez entendu, il n'y a pas de temps à perdre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "Vous osez douter de mes capacités ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
		{
