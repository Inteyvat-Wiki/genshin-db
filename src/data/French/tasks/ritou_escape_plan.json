			"dialogs": [
				{
					"id": 20131101,
					"content": "Halte ! C'est le bureau du Commissaire économique ici. Défense d'entrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131102
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131102,
					"content": "On est là pour voir, euh... vous savez, euh... le Commissaire économique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131103,
					"content": "Le Commissaire économique ne reçoit pas les étrangers. Partez, maintenant ou on sera obligés de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131104,
					"content": "Ah... Attendez, attendez, attendez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131105,
					"content": "Oh ! Commissaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131106,
					"content": "#Ces deux-là sont des {M#invités}{F#invitées} de marque {M#venus}{F#venues} de loin, pas besoin de leur faire la sérénade habituelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131107,
					"content": "Entrez, et voyons ce qu'on peut faire pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131108,
					"content": "Hmpf ! Vous avez compris !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Paimon"
				},
