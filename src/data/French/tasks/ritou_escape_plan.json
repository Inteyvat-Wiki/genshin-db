				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "Ah, vous voilà enfin... P—Permettez-moi de me présenter, je m'appelle Hiiragi Chisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130702,
					"content": "C'est... techniquement la deuxième fois qu'on se rencontre. C'est un plaisir de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130703,
					"content": "Waouh, c'est la fille du Clan Hiiragi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130704,
					"content": "Tout le plaisir est pour moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "#I—Inutile d'être aussi {M#formel}{F#formelle}. Je suis depuis longtemps émerveillée par vos exploits... Nous avons enfin la chance de nous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130707,
					"content": "C'est moi ou il y a quelque chose de bizarre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130708,
					"content": "La raison pour laquelle je voulais vous rencontrer secrètement ici, c'est que... Eh bien, je craignais de ne pas avoir d'autres opportunités de discuter de cela avec vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130709,
					"content": "D—Discuter de quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130710,
					"content": "Hum... Je voudrais demander votre aide pour... livrer une lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Argh, tel père, telle fille ! Vous n'avez pas quelque chose de plus original ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130714,
					"content": "N—Non ! Vous m'avez mal comprise, s'il vous plaît... Laissez-moi vous expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130715,
					"content": "J'espérais que vous pourriez remettre une lettre sur l'Île de Narukami à ma place. Elle doit être remise à Kujou Kamaji de la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130716,
					"content": "Mon père m'a toujours interdit de communiquer avec Kujou Kamaji. Il sait qu'il y a des possibilités de mariage pour moi qui lui offriraient de meilleures perspectives politiques. Mais mon cœur appartient à Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130717,
					"content": "#Personne n'ose défier la volonté de mon père à Ritou, mais vous êtes des {M#étrangers}{F#étrangères}, qui plus est des {M#étrangers}{F#étrangères} qui cherchent à se rendre sur l'Île de Narukami. Ce serait dommage de laisser passer une telle occasion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130718,
					"content": "Ah, je comprends maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130719,
					"content": "Bien entendu, par la même occasion, je ferai tout mon possible pour vous aider à quitter Ritou. Je vous en fais la promesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130720,
					"content": "Hmm, ça a l'air raisonnable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "Pour être tout à fait honnête avec vous... tant que vous resterez à Inazuma, mon père n'a aucune intention de vous laisser quitter Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130723,
					"content": "Oui, on avait remarqué. Il paraissait assez évident qu'il essayait de nous retenir ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130724,
					"content": "J'ai surpris une conversation entre mon père et une femme à l'air arrogant il y a quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130725,
					"content": "On aurait dit qu'ils discutaient de la façon de vous garder ici sur Ritou. En fait, c'était la première fois que j'entendais mon père parler avec autant de respect à une personne qui n'était pas la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130726,
					"content": "Une femme à l'air arrogant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "Nous n'avons pas beaucoup de temps. Je vais vous expliquer comment quitter l'île. Il se trouve qu'un convoi de marchandises est sur le point de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130729,
					"content": "(Hiiragi Chisato vous dévoile ses plans...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130730,
					"content": "Très bien, je vous attendrai à la frontière. Je compte sur vous pour livrer ma lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130727,
					"content": "On dirait qu'on va devoir quitter Ritou au plus vite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "Étant donné qu'on n'a pas d'autres options...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "Je crois que je vais y aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "#Je suis {M#ravi}{F#ravie} de vous revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
