			"dialogs": [
				{
					"id": 790590101,
					"content": "#C'est une scène coupée de « La pérégrination vers l'Est{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790590102,
					"content": "À l'origine, c'est l'histoire d'un voyageur et de son expédition vers l'est, de Fontaine à Sumeru, afin de trouver une sagesse sans prétention dans le Foyer de Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790590103,
					"content": "Cette scène montrait la façon dont le voyageur avait sauvé le Maître des transformations en l'empêchant d'être écrasé par un énorme rocher, et leurs aventures sur la route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790590104,
					"content": "Malheureusement, les Eidolons Hydro jouant les rôles du voyageur et du Maître des transformations ont disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Notes de scène"
				},
				{
					"id": 790590105,
					"content": "Si seulement quelqu'un pouvait <color=#00E1FFFF>les ramener tous les deux</color>, et capturer la scène près de l'énorme rocher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Notes de scène"
				}
			]
		},
