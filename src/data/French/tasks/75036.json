					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#Ah, {NICKNAME}, les principes actifs du phlogistique ont cessé d'agir. Ils ont dû être absorbés par la graine, mais... Rien ne s'est passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360806,
					"content": "Ouh ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Elle a peut-être tout simplement besoin d'un peu de temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Vraiment ? Hmm, maintenant que j'y pense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "Les graines de pissenlit s'envolent comme de petits parapluies si on souffle doucement dessus. Quant aux baies à crochet, elles s'attachent aux petits loups et les accompagnent jusque dans des contrées lointaines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "Les graines sont de petites choses tenaces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "Laissons-la tranquille pour le moment, nous reviendrons plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Peut-être que la graine a le trac...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "Tu crois ? Hmm, peut-être que je suis trop impatiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#La graine a été déterrée par {REALNAME[ID(2)|SHOWHOST(true)]}, ses nutriments ont été volés par des insectes volants et elle a même été dérangée par des monstres qui ont fait irruption...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "Ça a dû être terrifiant pour cette graine, c'est tout à fait normal qu'elle préfère rester cachée dans le sol sans bouger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				}
			]
