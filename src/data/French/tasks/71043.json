	"talks": [
		{
			"id": 7104301,
			"completionStepIds": [
				7104305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "« ... Le sergent-chef Anton a découvert une grande cloche au sud-est. Sur les parois rocheuses, il y a le mot « ils » écrit un peu partout... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Journal d'un Fatui"
				},
				{
					"id": 710430102,
					"content": "« ... C'est très similaire à la grande cloche que le capitaine a découverte dans les ruines au nord-est. Peut-être que... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Journal d'un Fatui"
				},
				{
					"id": 710430103,
					"content": "« ... On a envoyé Snezhevna et Fadeyka pour sonner les deux cloches aux endroits respectifs... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Journal d'un Fatui"
				},
				{
					"id": 710430104,
					"content": "« ... Alors que le tintement retentissant des cloches résonnait dans la pierre, le brouillard noir s'est dissipé. Quel étrange phénomène... C'est presque comme si les cloches annonçaient l'arrivée de quelqu'un... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Journal d'un Fatui"
				},
				{
					"id": 710430105,
					"content": "« ... On a perdu dix de nos hommes, et les deux escouades de l'avant-garde ont subi d'importantes pertes. Le capitaine a ordonné la retraite... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Journal d'un Fatui"
				},
				{
					"id": 710430106,
					"content": "(Une carte s'échappe du journal, sur laquelle les deux cloches au nord-ouest et au sud-est sont marquées, et deux crânes sinistres sont dessinés à côté.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Journal d'un Fatui"
				}
			]
		},
