			"trigger": {
				"objectNames": [
					"Fréjus",
					"Chênée"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "#Bonjour, les {M#amis}{F#amies}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110102,
					"content": "Vous êtes... Gendarmes ? C'est à quel sujet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110103,
					"content": "Haha. À votre avis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110104,
					"content": "Est-ce parce que nous survolons les toits et sautons sur les murs de la ville ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "Oh, ça aussi ? Attendez une minute, je vais marquer ça quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110107,
					"content": "Attendez, vous essayez de nous tromper !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110108,
					"content": "C'était juste une blague. Laissez-moi nous présenter. Je m'appelle Chênée, et voici mon aîné, Fréjus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110109,
					"content": "#Fréjus a développé une invention que nous devons tester. Ça vous intéresse {M#tous}{F#toutes} les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110110,
					"content": "De quel genre d'invention s'agit-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110111,
					"content": "Une sorte de canon télécommandé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110112,
					"content": "Vous voyez, avec le canon précédent, il fallait quelqu'un pour l'actionner. Il suffisait donc à l'ennemi de viser le canon pour détruire le canon et l'opérateur. Par contre, si c'est un canon télécommandé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110113,
					"content": "Nous pouvons limiter les pertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110114,
					"content": "Parfaitement ! Il n'est pas étonnant que vous soyez connu comme celui qui a « rejeté à trois reprises une invitation de l'Institut de recherche de Fontaine ». Cette merveilleuse invention vous est venue si facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110115,
					"content": "Vous avez rejeté une invitation de l'Institut de recherche de Fontaine à trois reprises ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "C'est que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110117,
					"content": "Exactement ! Ils ont reconnu son talent et auraient payé une fortune pour qu'il fasse de la recherche de pointe pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110118,
					"content": "Mais il est resté, car il aime son travail à la gendarmerie. C'est admirable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110119,
					"content": "Cependant, il ne supporte pas l'idée de gaspiller son talent, alors de temps en temps, il propose de nouvelles inventions pour nous aider dans notre travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110120,
					"content": "Ça a l'air génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110121,
					"content": "Tu me flattes, Chênée. Tu te souviens de ce que je t'ai appris ? Plus une personne est intelligente, plus elle aime la modestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110122,
					"content": "Entendu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110123,
					"content": "Enfin, nous aimerions que vous testiez ce canon télécommandé. Le terrain et les objectifs sont déjà prêts. Et nous saurons nous montrer généreux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110124,
					"content": "#Haha, vous êtes tombés sur les bonnes personnes{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110125,
					"content": "Nous en avons vu des choses au cours de nos nombreux voyages. Nous vous dirons si votre invention est bonne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110126,
					"content": "Bon courage ! C'est parti, Fréjus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110127,
					"content": "Euh... Alors, par ici, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110105,
					"content": "Est-ce parce que j'ai pratiqué l'épée dans la ville ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}