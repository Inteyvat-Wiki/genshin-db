			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "Mona ! Grâce à toi, nous avons pu nous débarrasser de plein de météorites !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130102,
					"content": "Ah, vous tombez bien ! J'ai quelque chose à vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130103,
					"content": "Vous vous souvenez quand j'ai dit que les météorites provenaient de la constellation de quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130104,
					"content": "En théorie, c'est impossible que des étoiles qui sont à des années lumières d'ici se transforment en météorites en si peu de temps, mais c'est bien ce qu'il s'est passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130105,
					"content": "Si nous voulons en avoir le cœur net, il faut que nous trouvions à qui appartient cette constellation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130106,
					"content": "Tu as dit que toutes les victimes étaient tombées dans un profond sommeil et qu'ils avaient tous rêvé de montagnes enneigées, correct ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130107,
					"content": "Nous ne savons pas de quelles montagnes il s'agit, mais nous pouvons en déduire que ce n'était pas les Monts Dosdragon. Quelqu'un aurait fini par reconnaître l'endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130108,
					"content": "Les questions auxquelles il nous faut répondre sont : Les victimes ont-elles exactement eu le même rêve ? Et où est-ce que ce rêve se déroule-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130109,
					"content": "J'ai besoin de connaître les détails de ces rêves pour avancer dans l'enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130110,
					"content": "Nous devrions nous rendre à un endroit bien fréquenté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130111,
					"content": "Comme ça, nous aurons plus de chances d'interroger des victimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130112,
					"content": "J'ai besoin de rester dans un endroit calme, alors je vous laisse faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130113,
					"content": "Y a-t-il un endroit où nous ne sommes pas encore allés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130114,
					"content": "Bien que ce ne soit pas vraiment un endroit très fréquenté, il y a le <color=#00E1FFFF>Village de Qingce</color> dans la région de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130115,
					"content": "Mais je pense que le village a certainement dû être transformé en hôpital de fortune comme à l'Auberge Wangshu pour les victimes des météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111302",
							"2"
						],
						"stepId": 4111302,
						"stateName": "QUEST_STATE_UNFINISHED"
