						411131202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131202,
					"content": "On dirait bien qu'il se passe la même chose ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131203,
					"content": "Excusez-moi, est-ce que cet homme s'est réveillé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131204,
					"content": "Non, mais il marmonne des choses parfois.",
					"roleType": "TALK_ROLE_NPC",
