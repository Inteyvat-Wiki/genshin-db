			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "Mona ! Nous en savons plus sur les rêves !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130702,
					"content": "Cette imposante montagne enneigée dont le sommet atteint les nuages est l'origine d'un mal grandissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130703,
					"content": "Une montagne enneigée ? C'est tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130704,
					"content": "Toutes les victimes voient la même montagne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "C'est une montagne très haute que personne n'avait jamais vu et il y fait super froid au sommet. Tout le monde l'escalade, sans savoir pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130706,
					"content": "Ils l'escaladent jusqu'au sommet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130707,
					"content": "Qui voudrait atteindre le sommet de cette montagne ? Et ce désir est si fort que d'autres personnes se mettent à le faire aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130708,
					"content": "Des pauvres âmes ensevelies sous la neige gisent-elles là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130709,
					"content": "Ou... Un explorateur intrépide est particulièrement désireux de conquérir cette montagne en particulier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130710,
					"content": "Je vais relancer une séance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130711,
					"content": "Je crois que j'ai un nouvel indice ! La constellation appartient à un certain <color=#00E1FFFF>Léonard</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130712,
					"content": "C'était rapide, dis donc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130713,
					"content": "Je suis une astromancienne de génie après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130714,
					"content": "Léonard... Je ne connais personne qui porte ce prénom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111308",
							"2"
						],
						"stepId": 4111308,
						"stateName": "QUEST_STATE_UNFINISHED"
