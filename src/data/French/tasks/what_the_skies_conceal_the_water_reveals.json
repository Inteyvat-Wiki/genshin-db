				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "Bonjour, nous sommes de la Guilde des aventuriers. Est-ce que le Village de Qingce a été touché par la pluie de météorites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130202,
					"content": "Des aventuriers ! Parfait, je commençais à m'inquiéter qu'aucune aide ne nous soit envoyée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130203,
					"content": "Il pleut des météorites depuis des jours, et je ne vous parle pas des dégâts qu'elles ont causés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130204,
					"content": "Certaines ont atterri au beau milieu des <color=#00E1FFFF>champs</color> donc personne n'ose y travailler. D'autres bloquent l'<color=#00E1FFFF>entrée</color> de bâtiments et empêchent la circulation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130205,
					"content": "Savez-vous comment les enlever de là ? Elles nous rendent la vie impossible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130206,
					"content": "Je vois que les villageois ont aussi eu leur lot de problèmes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "Oui, nous devrions les aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111303,
