					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130904,
					"content": "Que veulent faire les Fatui avec ? C'est cette énergie élémentaire qu'ils convoitent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130905,
					"content": "C'est possible... mais alors, des créatures autres que les humains auraient aussi été attirées par l'énergie des météorites, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130906,
					"content": "Allons voir ça de plus près.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
