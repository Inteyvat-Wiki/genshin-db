						411131403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 411131403,
					"content": "Allons le voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131404,
					"content": "Vous pouvez, mais il est encore très affaibli. Allez-y doucement avec les questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 411131405,
					"content": "Votre princesse vous salue, malheureux mortel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Faim... J'ai faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131407,
					"content": "Comment vous sentez-vous ? On dirait bien que vous mourez de faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Ouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131409,
					"content": "Dites-moi ce qui vous ferait plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Un plat... local...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131412,
					"content": "Une spécialité locale du Village de Qingce ? Cela ne peut vouloir dire qu'une chose. Faisons-lui des <color=#00E1FFFF>délices rustiques de Qingce</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "Je vous prépare quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111315",
							"2"
						],
						"stepId": 4111315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gao le Sixième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "Waouh, je me sens revivre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131102,
					"content": "Dites-nous, avez-vous rêvé pendant votre sommeil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "Oui ! C'était le rêve le plus fatigant que j'ai jamais eu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131104,
					"content": "Comment ça se fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "Vous avez escaladé une montagne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Comment le savez-vous ? Cette montagne était si haute, comme je n'en avais jamais vue, et il y avait tant de neige...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131109,
					"content": "Que faisiez-vous sur cette montagne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "Je n'en ai aucune idée, j'étais comme possédé. Mon seul objectif était de grimper jusqu'au sommet de la montagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131111,
					"content": "Il y avait peut-être quelque chose de spécial au sommet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "Je ne sais pas. J'avais l'impression de ne pas être moi-même dans ce rêve, sans savoir pourquoi non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131113,
					"content": "Ce n'était donc pas « vous » qui vouliez escalader cette montagne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "Comment vous expliquer... Je sais que c'est bizarre, mais c'était comme si on me contrôlait et qu'on m'avait forcé à grimper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao le Sixième"
				},
				{
					"id": 411131115,
					"content": "Un scélérat s'est-il introduit dans les failles de votre âme ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "L'idée d'escalader la montagne s'est manifestée dans son subconscient... En effet, il pourrait bien s'agir d'une manipulation mentale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "Je devrais déjà avoir l'habitude, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "Les autres victimes ont également dit qu'elles avaient froid et besoin de repos... Étaient-elles en train d'escalader la montagne elles aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "Comment peuvent-ils tous avoir le même rêve ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "C'est vraiment surprenant... Allons faire notre rapport à <color=#00E1FFFF>Mona</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "Vous vous exprimez très différemment l'un de l'autre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "Vous étiez dans la neige ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Sur une montagne couverte de neige, même. Elle se dressait à une altitude vertigineuse et qu'est-ce que j'avais froid ! J'étais à son pied quand je me suis endormi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao le Sixième"
				}
			]
		},
