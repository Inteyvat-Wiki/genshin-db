				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "N'importe quel débutant en astromancie aurait pu le dire : cet homme était un Exécuteur des Fatui ! Comment avez-vous fait pour vous retrouver nez à nez avec ce genre d'individu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130716,
					"content": "Ce jeune homme était donc un Exécuteur ?! Quel infâme personnage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130717,
					"content": "Un Exécuteur ? Bonté divine !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "Quels que soient ses plans, c'est après toi qu'il en avait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130719,
					"content": "Il possède aussi une force extraordinaire ! Je l'ai senti dès que je l'ai vu. Il est bien plus puissant que ce que nous pouvons imaginer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130720,
					"content": "Ça ne m'enchante pas de l'admettre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130721,
					"content": "Se peut-il que ses pouvoirs égalent ceux de l'astromancienne de génie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130722,
					"content": "Je n'ai jamais dit ça ! ... Il a beau être un brin plus fort que moi, mais je l'écrase en astromancie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130723,
					"content": "Tiens, je me souviens que nous avons eu une petite altercation avec des Fatui à l'Auberge Wangshu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130724,
					"content": "Pourquoi seraient-ils intéressés par les météorites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130725,
					"content": "Ils doivent manigancer quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130726,
					"content": "Hum, se pourrait-il que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130727,
					"content": "Ah, je sais ! Ce sont eux qui auraient provoqué la pluie de météores, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130728,
					"content": "Paimon ! Arrête de piquer mes répliques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130729,
					"content": "Héhé, désolée ! Ma bouche bouge plus rapidement que celle des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130730,
					"content": "Le pouvoir d'invoquer une pluie de météorites existe-t-il vraiment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "Ouais... D'où le pouvoir de faire tomber toutes ces étoiles du ciel pourrait-il provenir !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130732,
					"content": "Quelle est ton humble opinion sur cette hypothèse, mon cher Ozvaldo von Hrafnavines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130733,
					"content": "Je pense que tout est possible, chère maîtresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130734,
					"content": "Les Fatui ne cesseront jamais de répandre leur néfaste influence sur ces terres tant que leur fortune le permet. Moi, je n'oublierai jamais leurs péchés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130735,
					"content": "Je crois aussi aux miracles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130736,
					"content": "Envoyée des astres, votre travail en tant que servante de mon illustre personne a été on ne peut plus remarquable ! Je déploierai mes forces pour assurer votre protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130737,
					"content": "Elle parle de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130738,
					"content": "Pas besoin ! Notre formation actuelle marche bien, alors gardons-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130739,
					"content": "Vous me sous-estimez Fischl. Je suis bien plus forte que vous le croyez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130740,
					"content": "Soyez assurée que ma maîtresse place une grande confiance en vous. Mais elle s'inquiète aussi pour votre sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130741,
					"content": "Ce n'est pas nécessaire. Vous êtes dans une position encore plus dangereuse que la mienne, alors c'est sans doute vous qui aurez besoin de ma protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130742,
					"content": "Tu es si gentille, Mona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "P—Pourquoi dis-tu cela...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130746,
					"content": "Pour le moment, nous devons faire face à un nouveau problème. Mon astrolabe m'indique qu'une nouvelle météorite s'est écrasée, c'est une <color=#00E1FFFF>météorite géante</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130744,
					"content": "Vous êtes si gentille, Fischl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "Cela va sans dire, voyons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Fischl"
				}
			]
		},
