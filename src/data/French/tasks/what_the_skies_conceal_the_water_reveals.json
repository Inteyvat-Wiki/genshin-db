						411131205
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131205,
					"content": "Comme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "Il dit qu'il a froid, qu'il ne peut plus continuer et d'autres choses du genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131207,
					"content": "Comme les autres victimes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
