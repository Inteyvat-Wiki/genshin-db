				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "Bonjour ! Tous les trésors que vous trouverez ici sont uniques dans leur genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040102,
					"content": "C'est clair que j'ai jamais rien vu de semblable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040103,
					"content": "Haha ! Je vous l'avais dit ! Ce sont des objets qui m'ont été rapportés des quatre coins du monde par des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040104,
					"content": "Quelque chose vous intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040105,
					"content": "Vous vendez de si belles choses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "Mais non, mais non ! Je fais du troc ici, je n'accepte pas d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040108,
					"content": "Je suis en train de fabriquer un objet spécial en ce moment, et il me faudrait beaucoup de <color=#00E1FFFF>sceaux Anémo</color> pour la décoration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040109,
					"content": "Auriez-vous un <color=#00E1FFFF>sceau Anémo</color> avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040110,
					"content": "Oui, quelques-uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Haha ! On dirait que Barbatos approuve vos aventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040114,
					"content": "Je voulais simplement vous dire que vous pouvez échanger des <color=#00E1FFFF>sceaux Anémo</color> contre des articles de cette boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040115,
					"content": "Voir les articles",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "C'est un emblème que Barbatos donne aux aventuriers en signe de reconnaissance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040106,
					"content": "Je n'ose pas regarder le prix de ces objets.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
