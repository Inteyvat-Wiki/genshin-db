			"dialogs": [
				{
					"id": 205040301,
					"content": "Les <color=#00E1FFFF>sceaux Anémo</color> se trouvent dans tout Mondstadt. Poursuivez votre exploration s'il vous en manque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "C'est vraiment juste pour de la décoration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Évidemment ! Quoi de plus beau qu'un cadeau de Barbatos comme ornement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Haha ! Je dois admettre que vous êtes plutôt perspicaces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "Disons que c'est compliqué à expliquer, alors je dis que c'est pour décorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Je veux des <color=#00E1FFFF>sceaux Anémo</color>, car ils possèdent des propriétés que d'autres matériaux n'ont pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Montrez-nous l'objet quand il sera terminé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "#Sans faute ! Vous serez incroyablement {M#surpris}{F#surprises}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "N'oubliez pas de me ramener autant de <color=#00E1FFFF>sceaux Anémo</color> que vous pourrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Venez aussi si vous tombez sur des trésors extraordinaires lors de vos aventures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "J'ai l'impression que vous exagérez un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "Et ça marche ! ... Je suis curieuse de voir ce que ça va donner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "Je ne peux rien vous dire pour l'instant ! Haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
