			"dialogs": [
				{
					"id": 400230101,
					"content": "#{M#Voyageur}{F#Voyageuse}, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230102,
					"content": "J'ai expliqué la situation à la Commission administrative et je leur ai montré les plans originaux. Ils ont fini par comprendre que la Chambre Onmyou mystique et moi n'étions pas une menace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230103,
					"content": "Génial ! Est-ce que ça veut dire que vous pouvez enfin vous concentrer sur votre mission initiale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230104,
					"content": "C'est exact. J'ai également restauré la Chambre Onmyou mystique dans son état d'origine. C'est désormais un donjon destiné au perfectionnement des techniques martiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230105,
					"content": "Il est possible que le pouvoir magique de ce donjon s'épuise avec le temps. Quand ce jour viendra, je le laisserai en repos pour que la magie puisse se renouveler progressivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230109,
					"content": "#C'est peut-être le bon moment pour essayer. Vous êtes {M#prêt}{F#prête} à relever le défi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230106,
					"content": "#Je suis {M#prêt}{F#prête} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "Oui ! Je suis avec toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230107,
					"content": "Allons-y !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				}
			]
		}
	]
