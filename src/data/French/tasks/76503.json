			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#Oh ? {NICKNAME} et Paimon, mes {M#chers amis}{F#chères amies}. C'est étonnant de vous croiser dans un endroit aussi reculé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "#Êtes-vous ici à la recherche d'indices ? Ou peut-être que vous vous êtes {M#perdus}{F#perdues} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "On se promène juste dans le coin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "Je vois. Effectivement, l'imposant Bureau d'études expérimentales du kuuvahki est assez impressionnant depuis le pont de cette épave, comme un colosse endormi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "C'est intimidant, même vu d'ici. Qui sait quels secrets il renferme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Je suppose qu'il pourrait être une excellente source d'inspiration pour vous, compte tenu de votre recherche d'éléments uniques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Après tout, les contes les plus fascinants naissent souvent de la frontière entre la lumière et l'obscurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Héhé ! Quand vous vous tenez là avec votre fidèle lanterne bleue, on dirait une scène tout droit sortie d'une histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "D'ailleurs, ne devriez-vous pas être stationné... euh, là-bas ? Vous êtes en congé ou en patrouille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "Les deux, en quelque sorte. Nous, les ratnikis, restons éternellement à l'affût de toute calamité qui pourrait surgir de l'ombre. C'est pourquoi nous devons rester vigilants, où que nous soyons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Cela dit, la situation a l'air stable dans les environs. Ne vous inquiétez pas, vous pouvez continuer votre activité créative tranquillement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Eh bien, puisque l'occasion se présente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "De moi ? Honnêtement, c'est une demande inattendue. J'avoue que je n'ai pas l'habitude de me tenir devant l'objectif, ni d'être observé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Sûrement parce que les tombes silencieuses et les murmures des défunts m'accompagnent au quotidien. Je suis sûr que vous comprenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "#Enfin, ce serait grossier de ma part de refuser la demande sincère d'{M#un ami}{F#une amie}. Un manque d'hospitalité de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "N'hésitez pas à immortaliser les moments qui en valent la peine selon vous. Ce serait un honneur et un plaisir de vous inspirer, ne serait-ce qu'un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "C'est bon pour une photo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "Ah oui, on cherche de l'inspiration pour des photos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
