				]
			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "Est-ce... le cœur du loup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "...! Roland !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "... Je ferai comme vous le souhaitez, Chevalier de Borée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Ha, vous n'êtes pas tout à fait comme je vous imaginais. Vous ne semblez pas aussi fou que dans les souvenirs contenus dans l'esprit du loup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Je ne me suis jamais écarté du droit chemin. Mais quand je vous regarde... je ne vois pas un héros capable de terrasser des dragons. Juste une âme perdue qui a erré trop longtemps. L'ombre du chevalier que vous étiez autrefois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Je suppose que nous avons cela en commun. Aucun de nous n'est au sommet de sa forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "Les forces du rächer de solnari ont été vaincues, et le Roland que vous voyez n'est qu'une image imparfaite projetée par l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Je possède le pouvoir dont Roland disposait à son apogée, mais mon cœur et mon esprit restent figés dans ce moment sanglant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Par conséquent, dans ma forme actuelle, je suis imparfait... Un chevalier ne peut supporter sa propre stagnation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Après vous avoir délivré de l'injustice et guidé votre reddition à l'Abîme, je me rachèterai et continuerai à suivre la voie de la chevalerie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Ha ! Le monde extérieur ne peut plus supporter votre tourment. Votre obsession reste clairement telle que je l'avais imaginée. Je suppose qu'il n'y a aucune chance de vous faire entendre raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Aucune parole ne peut faire douter un chevalier de ses convictions, aussi nobles soient-elles. Aucun de nous ne fera changer d'avis l'autre... mais vous connaissez cette vérité depuis longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Sinon, pourquoi mettriez-vous tous vos espoirs dans la seule pensée de Borée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Mais aujourd'hui, la lame qui abritait autrefois l'esprit du loup a été brisée. Tout ce qui vous reste est un fantôme qui en porte la forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Vous n'avez plus les moyens de changer la situation, et personne ne viendra à votre secours... Cet endroit sera votre tombe, guerrier solitaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Eh, vous avez peut-être en partie raison... Mais je pense bien avoir une chance d'être sauvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "... Que voulez-vous dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Il n'y a qu'une seule personne à qui je dois faire changer d'avis, et ce n'est pas vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Vous oubliez où nous nous trouvons ? C'est le cœur d'Andros, le dieu du Vent du Nord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110919,
					"content": "Andros ! Vous m'entendez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Réveillez-vous ! Vous êtes le grand dieu du Vent du Nord ! Combien de temps encore allez-vous vous laisser dominer par l'Abîme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110922,
					"content": "... Si c'est là votre dernier coup, je suis très déçu, Chevalier de Borée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "Les grandes démonstrations de souhaits sincères ne peuvent pas provoquer de miracles. Ce monde n'a pas de pitié pour ses habitants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "... Retourner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110925,
					"content": "... Retourner... aux lignes énergétiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "... C'est mon choix... Mon souvenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110928,
					"content": "... Est-ce là la réponse que j'ai trouvée... à la fin de mon voyage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110929,
					"content": "And{RUBY#[D]Borée}ros... Enfin, j'ai rendu ce gage à votre cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Ah... Un Chevalier de Borée ? Observe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110931,
					"content": "C'est tout ce qu'un lo{RUBY#[S]Moi}up peut espérer faire pour l'hum{RUBY#[S]Vous}anité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160110932,
					"content": "... Au nom de toute l'humanité, je vous remercie, Roi des loups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Borée... retourne dans les lignes énergétiques ? Mais pourquoi ? Votre épée est brisée, vous n'avez plus les moyens de porter son âme... À moins que... Non, ce n'est pas possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Prier pour un miracle est futile. Je le sais bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "... Mais une épée n'est qu'un seul type de réceptacle. Il existe d'autres moyens de conserver une âme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "Le Seigneur du Territoire des loups accorda jadis la puissance de son âme aux membres de sa meute, fortifiant leurs cœurs et aiguisant leurs griffes ainsi que leurs crocs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "... Même si ce n'est pas mon intention, l'âme du Loup du Nord ravagera, dévorera et assimilera inévitablement un cœur mortel... Comme si l'humain et le loup étaient forcés de fusionner en un seul être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Borée"
				},
				{
					"id": 160110938,
					"content": "... Lorsqu'un cœur mortel porte l'âme d'un dieu... Revenir en arrière est impossible. Cependant, je ne dissuaderai pas un chevalier de s'engager dans la quête qu'il a lui-même choisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "Capitano"
				},
				{
					"id": 160110939,
					"content": "Votre cœur, votre âme... sont-ils en train de s'effondrer ? ... Ah, je comprends maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "Vous vous demandiez comment un agneau pouvait apprivoiser le cœur d'un loup... n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Voici ma réponse : il faut faire avaler le cœur au loup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "L'esprit du loup dans l'épée n'était qu'un leurre... les véritables pensées et souvenirs étaient portés dans votre cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Pour éviter d'éveiller mes soupçons, vous avez délibérément laissé l'âme du Loup du Nord s'assimiler à la vôtre, puis être dévorée par moi... Mais... comment avez-vous trouvé la force de vous battre tout en portant un tel fardeau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "Comparé à la décision du Loup du Nord... mon sacrifice ne représente rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Vous avez une volonté tenace et avez employé une stratégie exceptionnelle... mais ce n'est pas ainsi qu'un vrai chevalier combat. Vous avez fait le mauvais choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Votre âme a désormais fusionné avec celle d'Andros. Quand il rejoindra complètement les lignes énergétiques, vous tomberez aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "#Que ce soit Barbatos ou {M#le voyageur}{F#la voyageuse}, personne ne pourra ancrer votre âme depuis l'intérieur des lignes énergétiques, et encore moins vous sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Vous avez perdu, et moi aussi. Malheureusement, je ne peux plus vous offrir le salut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "... Que votre âme repose en paix auprès de Borée, guerrier solitaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "... Haha, solitaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Désolée de vous décevoir, mais... Même si retourner ensemble dans les lignes énergétiques semblait être une fin parfaite pour nous deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "Le fait est que, contrairement au vrai Roland du passé, j'ai encore du bon vin et de bons amis qui m'attendent. Ils se réjouissent de mon retour triomphant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Je ne suis pas encore prêt à accepter mon destin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Ding dong ! Vous avez du courrier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
