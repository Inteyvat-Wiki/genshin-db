						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "... Avance, et ne te retourne pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andros"
				},
				{
					"id": 160111103,
					"content": "« Varka... Maintenant, je connais la signification de mon nom. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "« ... Après tout ce que vous avez fait endurer à tout le monde, vous avez intérêt à bien nous remercier quand vous reviendrez. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosalia"
				},
				{
					"id": 160111105,
					"content": "« J'ai plein de choses à vous raconter, vous savez... Mais ça peut attendre votre retour. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "« Je n'ai pas l'intention de retourner à l'Ordre de Favonius... Mais je suis sûr que vous trouverez un moyen de vous en sortir par vous-même. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "« ... Grand Maître, nous vous attendons tous. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "Hmm ? ... Oh. Hé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "Je... ne m'en sors pas si mal en tant que Grand Maître, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "... Je vais prendre ce silence pour un oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Tout ce que vous avez juré de protéger au péril de votre vie... Tout est encore là, sain et sauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "L'Ordre de Favonius, Mondstadt... et le serment prêté par chaque chevalier. Je les protégerai tous au péril de ma vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "Je livrerai cette lettre en votre nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "... Je sais que ce n'est qu'une ombre du vrai Roland, mais... si vous avez le temps, pourriez-vous la lui lire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam et Arundolyn... Ils ne vous ont jamais oublié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "Pfiou... Cette expédition aura été bien longue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "À partir de maintenant, je crois que je vais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "... Laisser le vent me guider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noëlle"
				},
				{
					"id": 160111130,
					"content": "... Hé, tout le monde. Ça fait un bail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Je suis... ravi de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Bon retour, Grand Maître.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "Oui. Je suis de retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
