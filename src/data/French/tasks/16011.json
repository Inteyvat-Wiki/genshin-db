					}
				]
			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "... L'épée est intacte ? Mais je ne ressens plus l'esprit du loup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(...On dirait que je ne suis plus dans la réalité. Cet espace doit être construit à partir des consciences entrelacées de Borée et Roland.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "Impossible de revenir en arrière. Tout ce qui m'attend, c'est la gueule du loup... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Ha, je suppose que la seule solution est d'aller de l'avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601107,
			"completionStepIds": [
				1601107
			],
