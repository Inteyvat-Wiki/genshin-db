				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "Bienvenue à la boutique de La Queue de Chat ! Y a-t-il quelque chose qui vous intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "Bonjour Diane ! On a une grosse commande pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "Vous expliquez la commande de Quqing à Diane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Oh ? La nouvelle boutique aux quais du nord de Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "Les marins venant du Port de Dornman avaient déjà parlé de cette dame, Margaret lui avait aussi déjà acheté des matières premières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "Récemment, mademoiselle Quqing a demandé aux marins à qui elle a vendu des boissons désaltérantes sur les quais de promouvoir l'eau de source de montagne du Village de Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "Elle achète de l'eau du Village de Qingce à un prix élevé pour la revendre là où il y a de la demande et ne se verse qu'une petite partie des bénéfices pour son travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "Grâce à elle, on peut profiter de l'eau de source du Village de Qingce à l'étranger pour produire des vins au goût unique et cela permet aux personnes âgées du village d'avoir un revenu. Une pierre deux coups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Mademoiselle Quqing est vraiment très gentille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Oui, La Queue de Chat envisagerait une coopération à long terme avec elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "#Bon, revenons à nos Brutocollinus, combien êtes-vous {M#prêts}{F#prêtes} à payer cette commande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
