					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Je compte sur vous pour la commande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220402,
					"content": "Avec ces boissons spéciales, les marins pourront se rafraîchir et profiter d'un goût nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220403,
					"content": "Un goût nouveau ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Les marins ont des goûts différents, certains aiment le thé avec un goût léger, d'autres préfèrent le jus de fruits avec un goût acidulé... Et si l'on boit toujours la même chose, on peut finir par s'en lasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220405,
					"content": "Donc j'ajoute souvent des boissons avec des goûts différents sur le menu de ma boutique pour répondre à leurs besoins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220406,
					"content": "À propos de la boutique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "J'ai ouvert récemment cette boutique sur le quai pour servir des boissons aux marins, car ils m'ont rendu un grand service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220408,
					"content": "Mais je suis inexpérimentée, alors les affaires ne marchent pas très bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220409,
					"content": "À tout à l'heure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "Au revoir ! Bon voyage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				}
			]
		},
		{
