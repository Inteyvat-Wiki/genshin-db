					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "Mademoiselle Quqing, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220302,
					"content": "Nous avons commandé les boissons dont vous avez besoin, elles seront expédiées demain et livrées sur le quai dès que possible. Voici votre reçu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220303,
					"content": "C'est déjà fait ? Vous êtes vraiment efficaces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220304,
					"content": "Je... Je vais préparer du thé avec la meilleure eau de source de montagne rien que pour vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220305,
					"content": "Pas la peine de faire tant de manières.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "Oui ! On doit aussi prendre les commandes d'autres personnes. Du coup, on vous laisse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220308,
					"content": "On espère que vos affaires seront prospères ! On reviendra boire une tasse chez vous une prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220309,
					"content": "Oui... Je vous préparerai des boissons qui vous plairont !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220310,
					"content": "N'hésitez pas à revenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220306,
					"content": "On a déjà eu une récompense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
