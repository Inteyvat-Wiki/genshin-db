			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "Bienvenue, qu'est-ce que je vous sers ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220102,
					"content": "Hum... À en juger par vos vêtements, vous n'êtes pas d'ici, n'est-ce pas ? Je ne sais pas si mon thé sera à votre goût...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220103,
					"content": "Je vais vous faire un pot de thé blanc Yunlai. Si cela ne vous va pas, revenez plus tard. D'ici là, je devrais pouvoir demander à quelqu'un d'acheter un lot de boissons spéciales du Weinlesefest de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220104,
					"content": "#Merci, mais nous ne sommes pas des {M#clients}{F#clientes}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "#Oui, vous ne trouverez pas plus fiables comme {M#coursiers}{F#coursières} ! Nous avons entendu dire que vous aviez publié un ordre de mission pour le Weinlesefest. Vous demandiez à des connaisseurs de commander des boissons pour vous, et nous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "Si vous voulez une boisson, il suffit de nous le dire et nous vous aiderons à passer commande à Mondstadt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "Vous avez fait tout ce chemin jusqu'à Liyue pour prendre des commandes ? C'est très gentil de votre part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220109,
					"content": "Et moi qui pensais que personne ne voudrait faire un travail aussi difficile... Eh bien, je m'en remets à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220110,
					"content": "Les marins qui sont allés à Mondstadt racontent que la boisson aux baies et à la menthe de <color=#00E1FFFF>La Queue de Chat</color> étanche la soif et calme l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220111,
					"content": "Je voudrais commander <color=#00E1FFFF>65 cartons de cette boisson aux baies et à la menthe</color> pour les vendre aux marins avec d'autres breuvages. Comme ça, ils pourront travailler efficacement et dans la bonne humeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220112,
					"content": "Avant, les commerçants de Mondstadt préparaient également des boissons équivalentes en fonction de mes besoins. Selon cette règle du Weinlesefest, j'ai quelques gelées de cru à leur donner. Je vous les confie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220113,
					"content": "J'ai préparé un budget généreux pour la commande, gardez ce qui reste comme récompense pour votre labeur. Même si ce n'est pas suffisant pour exprimer ma gratitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220114,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Pas de souci ! 65 cartons de boisson aux baies et à la menthe, c'est ça ? Vous pouvez compter sur nous, nous sommes des {M#professionnels}{F#professionnelles} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "On sera bientôt de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "Rien de plus facile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "#Nous sommes {M#venus}{F#venues} prendre des commandes de boissons du Weinlesefest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
