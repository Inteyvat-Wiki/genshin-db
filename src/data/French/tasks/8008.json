			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Monsieur le mineur, on vient vous faire un rapport sur notre mission !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Ah, je vous retrouve enfin ! Je commençais à m'inquiéter. Même si j'ai payé pour cette mission, en y repensant, envoyer quelqu'un dans un endroit aussi étrange était peut-être un peu risqué. Je ne voulais pas qu'il vous arrive quoi que ce soit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "Sinon je l'aurais eu sur la conscience pendant le restant de mes jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "#Mais non, voyons ! Vous ne savez pas qui on est ! Regardez, on est bien {M#revenus}{F#revenues}, non ? Et on a fait la lumière sur ce qui se passe au Gouffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "#Merveilleux ! Je suis impressionné. Pouvez-vous donc me dire ce qu'il se passe{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Euh... Eh bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "Un groupe de Brutocollinus est en train de prendre sa retraite au Gouffre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Ils prennent leur retraite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Euh, bref, les Brutocollinus à l'intérieur du Gouffre ne sont plus du tout agressifs. Et il faudrait éviter que les mineurs les dérangent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "Voilà, tout à fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Nous, les mineurs, on n'aime pas s'attirer des ennuis, alors on n'ira pas les provoquer. Tout ce qui compte à nos yeux, c'est tout ce qui est étincelant et scintillant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Oh... Je peux vous croire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "Je ne comprends pas tout ce que vous m'avez raconté, mais puisque vous m'assurez que tout va bien, alors je suis rassuré. On va pouvoir reprendre notre travail dès que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "Merci à vous deux. Vous vous êtes donné du mal. Prenez ceci, c'est pour vous récompenser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "Vous pouvez avoir le cœur léger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "L'intérieur du Gouffre est une utopie pour les Brutocollinus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Une utopie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
}