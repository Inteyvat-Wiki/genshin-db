					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "#Oh ! C'est vous, habiles {M#voyageurs venus de loin}{F#voyageuses venues de loin} ! Avez-vous essayé de faire des œufs magmiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Oui ! C'était revigorant comme plat !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Pas vrai ? C'est le pouvoir des bienfaits volcaniques contenu dans chaque bouchée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "Apparemment, on devient plus fort si on en mange tous les jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Le mien était trop cuit... J'ai failli m'évanouir après l'avoir mangé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Haha ! C'est difficile d'oublier ce goût, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "Honnêtement, ça va mieux quand on s'y habitue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Pas encore. Une prochaine fois, peut-être.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "Pas de souci. J'espère que le reste de votre voyage se passera bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
