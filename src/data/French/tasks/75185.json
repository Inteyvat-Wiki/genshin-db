					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "Quels beaux mouvements, vous deux ! Vous avez relevé le défi en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Maintenant, laissez-moi vérifier. Ouah, cette couleur et cette odeur... Ça me donne déjà l'eau à la bouche ! Allez, goûtez-y pendant qu'il est encore chaud !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Et voici la recette. La prochaine fois que vous aurez envie d'œufs magmiques, vous saurez comment les préparer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
