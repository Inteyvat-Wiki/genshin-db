					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "Que sont ces... œufs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "C'est un plat qui peut uniquement être préparé dans notre région volcanique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Nous jetons quelques œufs d'oiseaux dans les cheminées et laissons le phlogistique les griller. Quand la température et le moment sont bons, on obtient de délicieux œufs magmiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Mais attention, si on le laisse cuire trop longtemps, il aura un goût particulier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
