				"points": []
			},
			"dialogs": [
				{
					"id": 751850201,
					"content": "Si vous voulez en goûter, il suffit de relever le défi des œufs magmiques ! Allez jusqu'à la cheminée géothermale là-bas, ouvrez-la, puis prenez un œuf à l'intérieur ! Voilà votre encas chaud, fraîchement servi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
