						790030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030316,
					"content": "Hmm, mais la vraie question, c'est... Qu'est-ce que transportait le bateau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030317,
					"content": "Pourquoi ne pas regarder dans les environs ? *halète* On va peut-être trouver un trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030318,
					"content": "Après être resté dans l'eau aussi longtemps, il ne doit plus rester grand-chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
					"content": "#Hé ! Ne fais pas {M#ton}{F#ta} rabat-joie ! Je suis sûre qu'il y a un magnifique trésor qui nous attend.",
