			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "Oh, on dirait un bateau... Euh, enfin, un demi-bateau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030102,
					"content": "Qu'est-ce qu'un demi-bateau fait ici ? Oh, regarde ! Il y a quelque chose gravé dessus. Voyons voir ce que ça dit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030103,
					"content": "« ... On a perdu la moitié avant, mais on a quand même réussi à naviguer sur la moitié restante pendant un certain temps... Un sacré navire que voilà, haha ! Malheureusement, la majorité de la cargaison est probablement au fond de l'eau à l'heure qu'il est... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030104,
					"content": "« ... On dirait que... Qu'on a été poussés par les courants de sud-est ? Bon, peu importe, le problème à présent, c'est de trouver comment quitter cet endroit... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030105,
					"content": "Apparemment, il y a un groupe de gens qui a eu un problème en mer : « On a perdu la moitié avant »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030106,
					"content": "Cela veut donc dire qu'on est devant « la moitié restante » ! Waouh, qu'est-ce qui a bien pu briser un bateau en deux comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030107,
					"content": "Ça dit aussi qu'ils sont arrivés ici « poussés par les courants de sud-est ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030108,
					"content": "Si on suit la route qu'ils ont suivie et qu'on cherche l'autre moitié du bateau, on en découvrira peut-être davantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030109,
					"content": "Emportons la planche de bois qu'on vient de lire avec nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "Oh, je vois. Tu penses que ces mots gravés peuvent être des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030111,
					"content": "Je te suis ! La plupart du bois sur le bateau a déjà commencé à pourrir, on ne devrait pas avoir trop de mal à détacher cette planche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030112,
					"content": "Allez, arrachons cette planche et partons à la recherche de l'autre moitié du bateau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
