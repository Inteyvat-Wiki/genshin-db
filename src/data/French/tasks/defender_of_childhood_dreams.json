			"dialogs": [
				{
					"id": 110121101,
					"content": "Hé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121102,
					"content": "Tartaglia ? Vous êtes ici... Pourquoi vous cacher à tout prix comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Les adieux sont des moments spéciaux, et je ne veux pas que Teucer quitte Liyue en gardant de moi l'image que je donne maintenant, faible et présentant plutôt mal... Je préfère qu'il n'ait pas ce souvenir de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121104,
					"content": "Même si c'est un peu difficile de ne pas pouvoir lui dire au revoir moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121105,
					"content": "*soupir* C'est moi qui devrais le raccompagner et veiller à sa sécurité. Des hommes à moi l'escorteront, mais... Ce n'est pas la même chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121106,
					"content": "Vous l'avez assez gâté comme ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Haha... Je serais bien incapable de dire pourquoi, mais je me sens rassuré quand Teucer est sous votre garde. Quand on pense qu'il n'y a pas si longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121108,
					"content": "Oh, j'allais oublier. Tenez, votre rémunération pour services rendus. J'aurais difficilement pu m'en passer cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121109,
					"content": "Oh, vous avez donc un cœur après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "Une autre chose : n'oubliez pas votre promesse. Vous me devez une revanche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121111,
					"content": "Et cette fois-ci, c'est de mon honneur d'Exécuteur qu'il s'agit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121112,
					"content": "J'attends ça avec impatience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "Vous feriez mieux d'aller d'abord vous retaper... Ou alors vous allez encore pleurnicher quand vous aurez perdu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Hahaha... J'aimerais malgré tout vous inviter dans mon pays natal, peu importe qui l'emportera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121116,
					"content": "Ce sera l'occasion de vous présenter mes autres frère et sœur, Anthon et Tonia. J'en suis très fier, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121117,
					"content": "Offre acceptée ! Mais c'est seulement parce qu'on a fait une promesse à Teucer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Haha, Teucer sera ravi de vous voir, sans aucun doute. Bien, marché conclu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121119,
					"content": "J'attendrai avec impatience le jour où nous nous reverrons à Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121113,
					"content": "Vous ne me vaincrez pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
