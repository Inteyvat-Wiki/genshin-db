			"dialogs": [
				{
					"id": 110121001,
					"content": "Pfiou... Enfin réunis. Tu n'es pas blessé, n'est-ce pas, Teucer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121002,
					"content": "Blessé ? Pas du tout. C'était vraiment amusant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Tu es bien le seul à trouver ça amusant. On a failli mourir de peur nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "Oh, cette pièce est gigantesque ! C'est là que les amis de Qu'un-œil viennent quand ils passent lui rendre visite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "Exactement. Impressionnant, non ? Bon, et qu'est-ce que tu dirais d'une petite partie de cache-cache ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121006,
					"content": "Maintenant ? Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Héhé... J'ai une surprise pour toi, tu sais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121008,
					"content": "Une surprise ! Quelle surprise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "Ne t'inquiète pas, tu auras l'occasion de la chercher plus tard. Mais avant, tu dois fermer les yeux, te retourner et compter depuis 60.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110121010,
					"content": "Bon, d'accord... 60 ça fait beaucoup je trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
		},
