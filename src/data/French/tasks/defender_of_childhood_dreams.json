			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tartaglia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Nous y voilà : l'Institut pour la recherche en jouets de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120102,
					"content": "Ouais, on y est ! J'entends déjà les bruits des machines, c'est super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "C'est quoi cet endroit ? Et comment vous le connaissez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "D'après le peu que je sais, ceci appartient au Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120105,
					"content": "Le Dottore est un autre des Exécuteurs Fatui. Les vieilleries sont... une de ses passions. Il a converti ces ruines en lieu de recherche sur les Gardiens des ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120106,
					"content": "Hein ? Les Gardiens des ruines sont construits par les Fatui !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "Mais non. Les Gardiens sont intimement liés à l'Abîme, et sont donc autant nos ennemis que les vôtres... Il s'agit juste de recherches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120108,
					"content": "Quant à pourquoi les Gardiens des ruines se sont mis à quitter la zone... J'imagine qu'il a fini par se lasser de jouer avec, et a perdu son intérêt pour l'endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120109,
					"content": "Encore un Exécuteur au caractère hors norme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Enfin, ça explique pourquoi amener Teucer ici ne vous pose pas de problème. Vous avez réfléchi à la question, à ce que je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Pour être honnête... Je n'irais pas aussi loin. Je n'ai aucune idée de ce qu'il y a à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120112,
					"content": "Mais... Et la sécurité de votre frère dans tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Allons, bien sûr que c'est mon souci principal... Mais quel que soit le danger, je m'en occuperai. N'est-ce pas là le boulot d'un grand frère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120114,
					"content": "Même Teucer comprend cela, maintenant qu'il sait pourquoi il se bat... C'est une vérité que j'ai réalisé il y a bien longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120115,
					"content": "De quoi vous parlez tous ? Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Haha, allez. Suis-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tartaglia"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tartaglia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Heureusement que c'est vous qui m'avez trouvé d'abord... Utiliser la Posture du démon sans avoir pleinement récupéré m'a coûté plus que prévu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120202,
					"content": "Je ne sais pas ce que je ferais si Teucer me voyait comme ça... On dirait un ballon dégonflé, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120203,
					"content": "Vous n'avez pas peur que j'en profite pour en finir une bonne fois pour toutes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "Haha, si mes souvenirs sont bons, vous avez aussi de la famille, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120205,
					"content": "Je crois pouvoir avancer sans me tromper que vous ne feriez rien de tel devant mon petit frère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120206,
					"content": "On n'a jamais pensé que vous iriez aussi loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Je vous l'ai déjà dit... Je ne rate jamais une occasion de tester mes limites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120209,
					"content": "C'est pour ça que je suis toujours plus puissant... Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120210,
					"content": "Mais les rêves d'enfant, eux, sont facilement détruits. Même quand on ne s'en occupe pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120211,
					"content": "Alors, quelqu'un doit les protéger, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120212,
					"content": "Quand on donne sa parole, on la tient. De la même manière qu'on s'excuse quand on fait une erreur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120213,
					"content": "Et si vous donnez un rêve à quelqu'un, vous devez le faire durer aussi longtemps que possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120214,
					"content": "C'est ça aussi, la famille, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Haha... Ça vous parle peut-être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120217,
					"content": "*tousse* Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120218,
					"content": "Arrêtez de faire le dur ! Vous devez voir un médecin tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "Ah... Une suggestion intéressante, mais d'abord... J'ai quelque chose que j'aimerais que vous remettiez à Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120220,
					"content": "Mais c'est... Une figurine de Qu'un-œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Oui. Je l'ai fait faire spécialement par un artisan il y a quelque temps. Je comptais la ramener à Snezhnaya pour l'offrir en personne à Teucer, mais je crois qu'au point où on en est, ça fera un meilleur souvenir de voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120222,
					"content": "Je dirais presque que ça donne envie de faire partie de la famille de Tartaglia, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Et puis, j'ai besoin que vous expliquiez mon départ à Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120224,
					"content": "Je peux compter sur vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120225,
					"content": "« Promesse faite... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
