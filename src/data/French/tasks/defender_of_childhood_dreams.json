					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Attends un peu, Teucer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Tartaglia"
				},
				{
					"id": 110120807,
					"content": "La porte... La porte s'est fermée ! J'espère que Teucer ne va pas avoir de problèmes...",
