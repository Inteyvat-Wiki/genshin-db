	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Bonjour ! Installe-toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Notre précédente aventure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Tu veux parler du fait que j'ai été tellement têtue que j'ai causé du souci à tout le monde ? Haha, ça va, je sais que j'ai eu tort... Pas la peine de me le rappeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "Mais pour être honnête, je pense que c'est dans la nature des aventuriers d'être fascinés par le danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "On a la chance d'avoir une bonne constitution. Ça me paraît du gâchis d'avoir de telles prédispositions et de se contenter d'une existence paisible, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Et pour ce qui est des dangers mortels, ce n'est pas que je n'y ai pas pensé, mais... Hmm, je peux te poser une question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Vas-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "L'aventurier Stanley de Mondstadt est célèbre pour avoir traversé la Mare Jivari, mais il a perdu un ami cher au cours de ce voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "Même si peu de gens connaissent le nom de cet ami, son souvenir reste présent dans la mémoire des aventuriers pour avoir participé à cette aventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Je me disais... Et s'il te plaît, ne te moque pas de moi : est-ce qu'on ne peut pas considérer que cet ami de Stanley, qui n'est pas revenu, n'est en fait pas décédé, mais qu'il est bel et bien « vivant » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "Rester en vie est la chose la plus importante qui soit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Mais si les gens se souviennent de nous... Même si on devait mourir prématurément, ne pourrait-on pas considérer cela comme un prolongement de notre vie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "C'est vivre d'une manière différente, dans l'admiration, les souvenirs... dans le regard des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "Ne te préoccupe pas autant de ce que les autres pensent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "C'est ce que beaucoup de gens m'ont dit. « Reste toi-même », « Concentre-toi sur ton travail »... Mais sous couvert de conseil, ils me demandent en définitive d'abandonner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Je l'ai déjà dit, je crois, mais je ne pars pas à l'aventure pour qui que ce soit... Ou même pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Hmm, tu as déjà pensé à ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Ce monde est gouverné par les dieux, et bien que nous autres, simples mortels, n'ayons pas reçu d'« yeux » de leur part, nous n'avons pas pour autant l'intention de nous résigner à une vie de paix et d'oubli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Je pense que cette attitude n'est pas dénuée de sens, c'est pourquoi il est si important pour moi d'affronter le danger. Je veux dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "#Je veux dire, lutter contre des choses que même les dieux craindraient s'ils étaient aussi fragiles que nous... N'est-ce pas là ce qui nous rend «{NON_BREAK_SPACE}humains{NON_BREAK_SPACE}» après tout{NON_BREAK_SPACE}? En tout cas, c'est ce que je pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Tu n'es pas la seule à vouloir donner un sens à cette histoire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Je sais... Je n'oublierai pas l'aide que j'ai reçue... Ni les ennuis que j'ai causés. Je n'ai pas fait tout ça toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "C'est la nature même des aventuriers, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Tu veux encore jouer les héros, c'est ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "#Héhé, par rapport à toi, j'ai encore du chemin à faire... Je ne me vois pas comme un «{NON_BREAK_SPACE}héroïne{NON_BREAK_SPACE}», mais plutôt comme quelqu'un qui «{NON_BREAK_SPACE}n'a pas peur de mourir pour vivre sa vie pleinement{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "C'est quelque chose que m'avait dit une personne âgée de Sumeru, qui l'avait elle-même entendu des Érémites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Ça fait sens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Pour moi, tu es plus « quelqu'un qui court après les problèmes » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Je suppose que le souvenir est aussi une forme de succès.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Eh bien... Je n'ai jamais vraiment envisagé la réussite. Ce que je veux, c'est laisser un souvenir de moi, même si j'échoue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Au moins, les autres se diront : « Zhiqiong a eu le courage d'affronter les dangers du Gouffre ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "Au moins, je ne tomberai pas dans l'oubli comme ceux qui se sacrifient au milieu de nulle part, ou bien... comme cela m'arrive maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "Je n'ai jamais vu les choses sous cet angle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "#Vraiment...? C'est peut-être parce qu'en tant qu'{M#étranger}{F#étrangère}, tu attires forcément l'attention où que tu ailles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
					"content": "C'est un peu comme les enfants qui naissent avec une cuillère en or dans la bouche... L'expérience de la pauvreté est pour eux quelque chose d'inédit et de futile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360421,
					"content": "Oh, pardon... Ce n'est pas ce que je voulais dire. Je voulais juste dire que... Non rien. Oublie ce que j'ai dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Ah, cette Zhiqiong... Elle est partie récupérer les balises, et elle n'est pas revenue depuis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Je lui ai donné trois heures de plus, vu qu'elle a la mauvaise habitude de courir partout... Mais cela fait au moins cinq ou six heures maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "Est-ce que vous pourriez m'aider à la chercher ? Elle a l'air d'avoir beaucoup de respect pour vous, elle devrait vous écouter... Je ne veux pas qu'il arrive encore quelque chose à quelqu'un qui est sous ma surveillance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
					"content": "Rah, qu'est-ce qu'elle a encore à s'enfuir comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380205,
					"content": "Très bien, je vais y aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380207
					]
				},
				{
					"id": 710380207,
					"content": "Ah, oui ! Où avais-je la tête ? J'ai presque oublié de vous donner l'information la plus importante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380208,
