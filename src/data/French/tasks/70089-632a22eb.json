				},
				{
					"id": 700890103,
					"content": "#Hé, qu'est-ce que vous faites{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Je cherche le chemin du retour. Je me souviens seulement que je dois trouver la Statue de l'Archon Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890105,
					"content": "Je n'ai pas d'autre souvenir que celui-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890106,
					"content": "#Le chemin du retour{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "Je ressens une vague nostalgie, mais je ne me souviens de rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890108,
					"content": "#Quand je me suis réveillé, je n'avais en main qu'un bout de papier sur lequel était écrit «{NON_BREAK_SPACE}Tu es Maukie{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890109,
					"content": "#Si j'en crois donc ce papier, je m'appelle «{NON_BREAK_SPACE}Maukie{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890110,
					"content": "Je ne vous dérange plus. Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890111,
					"content": "Quelle personne étrange, mais je pense que ce n'est pas quelqu'un de méchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "#Qu'est-ce qu'il y a{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
