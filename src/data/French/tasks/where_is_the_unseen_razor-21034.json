			"dialogs": [
				{
					"id": 210340401,
					"content": "Alors ? Vous avez déjà éliminé tous les monstres de votre côté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "V—Vous avez déjà battu tous les monstres du coin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Oh ? Évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Je suis tout de même la présidente de la Guilde des aventuriers de Liyue. Ce ne sont que de vulgaires monstres, ça ne m'a pas demandé beaucoup d'efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
