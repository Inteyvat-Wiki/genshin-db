			"dialogs": [
				{
					"id": 210340501,
					"content": "#{M#Voyageur}{F#Voyageuse}, avez-vous fini de nettoyer le camp de votre côté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340502,
					"content": "Oui, j'ai fait le ménage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Ce ne sont que des monstres tout ce qu'il y a de plus commun, ça ne m'a pas demandé beaucoup d'efforts. Et puis, j'ai eu de la chance, je suis tombée sur un fragment d'épée qui a de la valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340505,
					"content": "Je n'ai rien trouvé de mon côté...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Ne vous en préoccupez pas. Grâce à vous, je peux rayer cet endroit de ma liste, merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340507,
					"content": "Tenez, vous pouvez prendre cette récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340508,
					"content": "Si vous arrivez à trouver tous les fragments...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "Ce que je veux faire ? C'est simple... Je veux reforger le Glaive occulte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340511,
					"content": "Les plans de fabrication du Glaive occulte ont été perdus et j'ignore quels matériaux ont été utilisés pour le forger... Mais je trouverai bien un moyen de le reconstituer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340512,
					"content": "Si j'arrive à reforger le Glaive occulte, mon frère... *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340509,
					"content": "Que ferez-vous avec ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "Comment ça s'est passé pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
		},
