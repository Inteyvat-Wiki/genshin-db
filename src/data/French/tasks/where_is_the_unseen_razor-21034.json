					"nextDialogs": [
						210340602,
						210340603
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340602,
					"content": "Oui, il ne reste plus aucun monstre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340604
					]
				},
				{
					"id": 210340604,
					"content": "Ce ne sont que des monstres tout ce qu'il y a de plus commun, ça ne m'a pas demandé beaucoup d'efforts. Je regrette cependant de ne pas avoir trouvé quoi que ce soit de valeur, il n'y avait que de la ferraille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340605
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340605,
					"content": "Comment ça s'est passé de votre côté ? Vous avez fait des découvertes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340606
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340606,
					"content": "Oui, voici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Tiens, on dirait un fragment d'épée... Merci. Je vais le rapporter et je l'examinerai plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340608
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340608,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Tenez, voici une récompense pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340609,
						210340610
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340609,
