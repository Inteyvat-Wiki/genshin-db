			"dialogs": [
				{
					"id": 210340101,
					"content": "Hmph, il semblerait qu'il se trouve ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340102,
					"content": "Lan ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "#{M#Voyageur}{F#Voyageuse}, je ne pensais pas vous voir dans un tel endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340105,
					"content": "Vous vous rappelez de cette garde d'épée que vous m'avez aidée à retrouver la dernière fois ? Il s'avère qu'elle faisait bel et bien partie du Glaive occulte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340106,
					"content": "Vous allez trouver ça drôle, mais si j'ai pu la reconnaître, c'est parce que j'avais discrètement gravé quelque chose dessus avec un couteau quand j'étais petite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340107,
					"content": "Je me souviens avoir dit à mon frère qu'il devait me donner le Glaive occulte s'il venait à changer d'épée à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340108,
					"content": "Haha... Ni lui ni moi n'avions imaginé à l'époque que c'est de cette manière que je mettrais la main sur le Glaive occulte. De toute évidence, cette épée... a véritablement été brisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340109,
					"content": "#Bien, trêve de bavardages. Puisque je vous ai {M#croisé}{F#croisée} ici, laissez-moi vous demander un service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340110,
					"content": "Il y a deux groupes de monstres devant nous. Ils ont amassé une quantité considérable d'armes usées qu'ils ont laissées à l'intérieur de leurs camps sans savoir quoi en faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340111,
					"content": "La Guilde des aventuriers craint que ces monstres ne fassent des ravages dans les environs. J'avais l'intention de poster une mission, mais en y réfléchissant à deux fois, j'ai pensé que... je pourrais sans doute trouver des morceaux du Glaive occulte ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340112,
					"content": "#{M#Voyageur}{F#Voyageuse}, allez nettoyer un de ces deux camps, je m'occupe de l'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340113,
					"content": "Il y a un groupe de Brutocollinus dans le camp de gauche. Même si un simple Brutocollinus n'est pas un problème pour vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340114,
					"content": "... Ils sont en grand nombre. S'ils chargent tous en même temps, j'ai bien peur que cela demande quelques efforts, même pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340115,
					"content": "Dans le camp de droite se trouve un Chef Brutorocheux. Je pense ne pas avoir besoin de vous expliquer le danger qu'il représente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340116,
					"content": "Puisque c'est moi qui vous demande de l'aide, je vous laisse choisir le camp dont vous préférez vous occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340103,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
