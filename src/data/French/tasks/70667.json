				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "#Miaou ! (« Incroyable ! Félicitations pour avoir réussi le défi. Tu es maintenant {M#un joueur expert}{F#une joueuse experte} ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670202,
					"content": "(« Tu peux maintenant défier plus de joueurs... Au fait, même si tu pouvais déjà le faire, je te rappelle que tu peux publier des défis sur le tableau d'invitations. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670203,
					"content": "Miaou... (« Comme ça, tout joueur qui veut te défier peut relever tes défis. C'est parfois intéressant de ne pas savoir qui est ton adversaire, tu ne trouves pas ? »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670204,
					"content": "(« Après tout, se retrouver pour jouer aux cartes, c'est aussi un moyen de se réunir. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680204,
					"content": "#Miaou ! (« Ah ! Désolé, je divague. En tant que {M#joueur expert}{F#joueuse experte}, tu as maintenant le droit d'acheter de magnifiques cartes... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670205,
					"content": "#(« Hmm... {NICKNAME}, n'oublie pas pourquoi tu as commencé en premier lieu, et que le plaisir t'accompagne dans le monde de l'Invocation des Sept ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
