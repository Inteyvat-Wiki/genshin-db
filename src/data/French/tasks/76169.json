			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon. Vous êtes là aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "#On est aussi {M#venus}{F#venues} le voir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "S'il le savait, il garderait ça pour lui, mais ça le rendrait heureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Vous vous tenez aux côtés d'Illuga devant la tombe pendant un moment...\\nIlluga s'adresse à son camarade tombé au combat, lui racontant les petits et grands événements qui se sont déroulés récemment à Piramida...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Maintenant qu'il sait que tout le monde va bien à Piramida, il peut enfin reposer en paix, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "Oui, il a accompli sa mission. Nous poursuivrons la nôtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "Et après nous, d'autres viendront pour continuer à veiller sur ces terres. Comme les glacelées d'hiver, ils endureront les tempêtes et le froid, et n'en deviendront que plus forts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
