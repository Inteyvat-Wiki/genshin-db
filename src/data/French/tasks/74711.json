			"dialogs": [
				{
					"id": 747110101,
					"content": "Ah ! Tout se passe bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Je peux désormais l'affirmer : notre travail pour soigner ces poissons agressifs est entré dans sa phase finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Mais en plus de trouver quelques patients aquatiques supplémentaires pour compléter la liste, j'ai une autre demande un peu plus particulière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Je voudrais que vous retrouviez certains mécanismes sous-marins essentiels dans les zones affectées pour récupérer les données enregistrées par leurs capteurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Puis analyser les données pour identifier des schémas pertinents...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Exactement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Il faudrait aussi parler aux propriétaires de bateaux et aux plongeurs pour s'assurer qu'ils retiendront la leçon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "C'est vrai, sans parler des pêcheurs et des touristes... Tous ceux qui prennent un bateau en surface, et ceux qui plongent en dessous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Tous ceux qui interagissent avec nos eaux doivent être vigilants. Ils ne peuvent pas simplement jeter des choses dans la mer et détruire les habitats marins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Sinon, des poissons très agressifs pourraient s'approcher et faire chavirer leurs bateaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Pour qu'on puisse éviter ce genre d'incidents à l'avenir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
}