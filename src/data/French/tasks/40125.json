			"dialogs": [
				{
					"id": 401251101,
					"content": "Vous n'envisagez pas de prendre la relique avec vous, mademoiselle Sangonomiya ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "Non, je pense que c'est mieux qu'elle reste ici avec Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "L'Île de Watatsumi a quelque chose de nouveau à chérir maintenant, et lentement mais sûrement, les gens voient des progrès dans la poursuite de leurs aspirations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "Elle sera plus utile ici, où elle pourra protéger la Bouteillère et les rêves de tous ceux qui voyagent par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
