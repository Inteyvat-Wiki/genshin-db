			"trigger": {
				"objectNames": [
					"Collei",
					"Eula",
					"Lessig",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "... Si nous commençons par le Village d'Aaru et faisons un léger détour, nous pourrons voir la Caravane Ribat et le Pardis Dhyai sur la route de la Ville de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Vous prévoyez d'acheter des souvenirs en cours de route ? Vous pouvez vous concentrer sur l'achat des cadeaux, je porterai les sacs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Ne vous inquiétez pas du poids, je peux le supporter ! Tant que ce n'est rien de trop gigantesque, je le rangerai dans le sac !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "On se calme... Pour combien de personnes pensez-vous que nous allons acheter des souvenirs...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Maman, Albedo, Jean, Razor... Ooh, Diona, Mona et Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "C'est quoi ce regard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Non, rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "Alors, Klee, qu'est-ce que tu comptes acheter pour tout le monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Hmm... Des bonbons au goût de pomme crépusculaire ! Et des gros chapeaux Fongus ! Et... Et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "... Et des tas de livres d'histoires pour tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Mais je n'ai pas encore décidé quoi offrir à maman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Il n'y a pas d'urgence. Voyons ce qu'ils proposent, et si vous n'êtes toujours pas sûre, nous pourrons vous aider à décider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Oui ! Merci à vous deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
