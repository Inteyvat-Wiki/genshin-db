			"dialogs": [
				{
					"id": 762020201,
					"content": "Bienvenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Bonjour, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Ouah, quelle maison élégante, vous l'avez décorée avec beaucoup de goût ! J'adore ce que vous en avez fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Héhé, je savais que ça vous plairait, Paimon. Ça me fait plaisir de l'entendre, même si j'ai dû y travailler pendant mon temps libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Tout a commencé le jour où j'ai fini de construire ce chalet secret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Je prévoyais de continuer sur ma lancée et d'en construire quelques autres, mais il n'y avait personne autour de moi pour m'inspirer. Alors au bout d'un moment, mon enthousiasme s'est simplement... évaporé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "« N'existe-t-il pas un moyen de m'amuser, me divertir, tout en ayant le sentiment d'accomplir quelque chose ? » Et soudain, la réponse m'est venue à l'esprit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Attendez, on est passé directement à la réponse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Allons, Paimon, le temps n'attend personne. Regardez, c'est juste devant vos yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Derrière cette porte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "#En fait, pas seulement cette porte. Mais vous n'avez pas tort. Il faut bien commencer quelque part... alors autant commencer ici. Vous êtes {M#prêts}{F#prêtes} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "#A—Attendez une seconde, vous allez trop vite ! Je n'arrive pas à suivre... {M#Prêts}{F#Prêtes} pour quoi exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Oh, ne vous inquiétez pas pour ça. Vous n'avez pas besoin de vous préparer, c'est juste une façon de parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "D'après ce que j'ai observé et compris de vous... vous n'êtes pas vraiment du genre à aimer les longues explications compliquées. Vous préférez plonger directement dans l'action pour vous amuser, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Vous n'avez pas tort...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Haha, ravie de l'entendre ! Dans ce cas, préparez-vous, je ne compte pas me retenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}, vous nous comprenez, nous les anges. Nous ne pouvons tout simplement pas résister au plaisir de guider les aventuriers vers les trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "Puisque le but est d'être bienveillante et d'aider les autres à trouver le bonheur, pourquoi ne pas commencer par donner à mes propres amis quelques conseils pour être heureux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "J'ai donc eu un éclair de génie ! J'ai transformé mon petit chalet en un endroit où vous pouvez vous détendre et vous amuser. J'ai même caché des trésors dans chacune des pièces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Pour être honnête, en comparaison avec les autres anges, je suis une vraie experte pour cacher des choses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Si je cachais un coffre quelque part dans la nature sans vous montrer le chemin, j'ai bien peur que vous ne le trouviez pas, même après plusieurs mois de recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "Ahem... Bref... Je m'égare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "Je ne vais pas vous compliquer la tâche, et vous n'aurez pas non plus à courir partout dans la nature juste pour me divertir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Tout ce que vous avez à faire, c'est de trouver trois plumes, ici même dans cette pièce ! Et une fois que vous aurez terminé, prévenez-moi pour que je puisse vous voir ouvrir votre récompense : un beau et gros coffre au trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Ah, donc c'est une chasse au trésor ! J'ai trop hâte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Exactement ! Une chasse au trésor. Ça va être tellement amusant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Mais j'aimerais quand même avoir une petite introduction cette fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "C'est un honneur d'être ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
