						762020603
					],
					"speakerTitle": "Examiner la porte"
				},
				{
					"id": 762020603,
					"content": "Attendez un instant. Désolée, c'est juste un petit problème technique. Voyons voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "Clic... Clac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Examiner la porte"
				},
				{
					"id": 762020605,
					"content": "Ça bouge ! Hé ! Ce truc nous attaque ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
