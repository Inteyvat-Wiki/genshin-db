				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762020401,
					"content": "Tout ça vous semble un peu trop compliqué ? Ne vous inquiétez pas, c'est incroyablement simple. Mettez vos cerveaux en marche, cherchez partout et récupérez votre récompense à la fin. C'est exactement le genre d'aventure dans lequel vous excellez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
