					}
				]
			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "Une délicieuse odeur se fait sentir.\\nHm, ça sent les roulés double-fruits, le tourteau du solstice, le rôti croustillant et les bonbons aux herbes et aux baies.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "#Hein ? Une bouffée d'air sucré vient de me traverser la gorge ! *tousse*... Hé{NON_BREAK_SPACE}! On est où{NON_BREAK_SPACE}? Cette théière et ces tasses ont l'air vraiment... vraiment grandes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Une seconde... Est-ce qu'on a rétréci ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "On dirait que c'est la magie de Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Désolée, je voulais inviter de vrais acteurs animaux, mais... Au final, j'ai dû me contenter d'acteurs un peu plus... « rigides ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Hein ? Nicole, vous aussi, vous avez rétréci ? Je pensais que vous alliez devenir gigantesque !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Une grande sorcière qui soutient le ciel tout en se penchant pour parler ? Non merci ! Je suis très bien dans ma taille actuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Bref... Bienvenue au goûteron de la grande sorcière ! Allez, servez-vous du thé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
