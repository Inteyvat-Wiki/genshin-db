			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "... Toujours aucune nouvelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020402,
					"content": "Tu nourris les pigeons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "Je les ai nourris aujourd'hui, et les ai fait voler loin d'ici, loin de... vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020404,
					"content": "Là j'écris une lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020407,
					"content": "Maman Grace m'a dit qu'il m'enverrait une lettre par pigeon quand il aura le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020408,
					"content": "Mais j'ai toujours rien reçu... Papa doit sûrement être très pris par son travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020409,
					"content": "C'est pour ça que je me suis dit que j'allais lui écrire, et mettre un petit cadeau avec, mais je ne sais pas ce qui lui ferait plaisir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020410,
					"content": "Je sais ! Des <color=#00E1FFFF>pissenlits</color> ! Maman dit toujours que les gens de Mondstadt adorent les pissenlits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020411,
					"content": "Vous pouvez m'aider à aller chercher des <color=#00E1FFFF>pissenlits</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020412,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "#Oh, merci ! Vous êtes pas si {M#méchant}{F#méchante} au fond...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020414,
					"content": "Tu ne veux pas offrir autre chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "J'aimerais bien, mais si c'est trop lourd les pigeons n'arriveront pas à voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020416,
					"content": "En plus, papa est très loin, les pigeons peuvent pas voler aussi loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020405,
					"content": "Qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "C'est une lettre pour mon papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmy"
				}
			]
		},
