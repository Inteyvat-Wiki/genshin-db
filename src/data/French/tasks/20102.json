			},
			"dialogs": [
				{
					"id": 201020601,
					"content": "Vous avez trouvé des pissenlits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020602,
					"content": "Je les ai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "Super ! Ça suffira !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020604,
					"content": "Plus qu'à mettre les graines avec la lettre, et fermer... comme... ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020605,
					"content": "Ça y est ! Ça va faire drôlement plaisir à papa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020606,
					"content": "Par contre... Il paraît qu'il faut des pigeons spéciaux pour envoyer du courrier, et puis je connais pas l'adresse de papa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020607,
					"content": "Je sais ! Maman Grace m'a dit que Draff élevait des pigeons voyageurs à Deauclaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020608,
					"content": "Et qu'il connaît mon papa en plus ! Il saura comment lui faire parvenir, parfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020609,
					"content": "Bon alors... Vous devez amener cette lettre à Draff, et lui demander de l'envoyer à mon papa, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020610,
					"content": "Et pas le droit de la lire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmy"
				}
			]
		},
