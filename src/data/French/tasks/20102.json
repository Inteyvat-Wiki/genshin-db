	"talks": [
		{
			"id": 2010201,
			"completionStepIds": [
				2010201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010201",
							"2"
						],
						"stepId": 2010201,
						"stateName": "QUEST_STATE_UNFINISHED"
