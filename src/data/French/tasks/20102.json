					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020903
					],
					"speakerTitle": "Timmy"
				},
				{
					"id": 201020903,
					"content": "Mais... Maman Grace m'a dit qu'ils étaient tous les deux très pris par leur travail. Je me demande si je serai comme ça aussi plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
