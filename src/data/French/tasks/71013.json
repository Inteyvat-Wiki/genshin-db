			"dialogs": [
				{
					"id": 710130901,
					"content": "Les monstres sont le fléau de ce monde, et nous qui sommes voués à le protéger devons à jamais nous rappeler : les monstres ne méritent que le tranchant de l'épée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130902
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710130902,
					"content": "Toucher la stèle",
					"roleType": "TALK_ROLE_PLAYER",
