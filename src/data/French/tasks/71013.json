				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "L'<color=#00E1FFFF>œil divin</color>... Un artéfact issu d'un royaume inaccessible. D'aucuns y voient un cadeau des dieux, mais nul ne peut dire qui en sera béni, ni pourquoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710131502,
					"content": "Les textes anciens nous disent que les dieux observent le monde des mortels avec compassion, et de l'<color=#00E1FFFF>œil divin</color> font don à celui qui combat le mal et protège le monde... Mais le désir d'éradiquer les monstres m'a quitté, et je ne souhaite aujourd'hui que communiquer avec eux, dans l'espoir de pouvoir comprendre leur vraie nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710131503,
					"content": "Cet <color=#00E1FFFF>œil divin</color> ne m'est plus d'aucune utilité à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Trésor des ruines"
				}
			]
		},
