	"talks": [
		{
			"id": 7101301,
			"completionStepIds": [
				7101316,
				7101317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101301",
							"2"
						],
						"stepId": 7101301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "Mon frère d'armes et moi-même sommes rompus au combat depuis notre plus jeune enfance. Notre quête a toujours été de repousser les forces du mal, et de protéger ce monde de la corruption – quand bien même <color=#00E1FFFF>en l'absence d'un œil divin</color>, la tâche ne fut guère aisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710130102,
					"content": "Nous avons trouvé refuge en ces lieux pour perfectionner nos techniques, et partir à la recherche d'un <color=#00E1FFFF>œil divin</color>. Que ce monument par nous érigé soit le témoignage de nos actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "Trésor des ruines"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101302",
							"2"
						],
						"stepId": 7101302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "La fortune m'a souri, et je fus de nous deux le premier à trouver un <color=#00E1FFFF>œil divin</color>. Mais le doute m'habite à présent... Est-ce vraiment aux hommes de terrasser les monstres qui gangrènent ce monde ? Et en quoi l'homme est-il différent, si ce n'est en apparence seulement ? Le monstre ressent lui aussi la joie, la peine ; lui aussi il érige, aime et haït...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710130202,
					"content": "J'appose ici ces réflexions et ces doutes qui m'habitent. Toi qui dans un lointain futur liras ces lignes, sauras-tu résoudre cette énigme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Trésor des ruines"
				}
			]
		},
		{
			"id": 7101303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
