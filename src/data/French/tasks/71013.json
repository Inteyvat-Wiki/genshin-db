			"dialogs": [
				{
					"id": 710131401,
					"content": "Toi qui lis ces lignes, j'ignore si tu possèdes les réponses à mes questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131402
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710131402,
					"content": "Celui qui lira ces écrits sans nul doute me ressemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131403
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>Puisses-tu retrouver les trésors par moi enfouis près de l'eau. Ma bénédiction t'accompagne.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710131404,
