			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131001,
					"content": "Ces trois questions j'ai posé à mon frère d'armes. Mais je n'ai en réponse obtenu que réprimandes. M'accusant d'abandonner mon devoir, c'est avec ire qu'il partit. Puissent les réponses à ces trois questions apporter la paix à ce monde. J'ai en mon temps cherché la sagesse des anciens textes à travers le monde, et me suis absorbé ici dans la plénitude de la méditation. Des monstres j'ai étudié le langage, dans l'espoir de comprendre leur vraie nature. Que cette stèle soit mon témoin lorsque viendra celui qui pourra répondre à ces questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131002
					],
					"speakerTitle": "Trésor des ruines"
				},
				{
					"id": 710131002,
					"content": "Toucher la stèle",
					"roleType": "TALK_ROLE_PLAYER",
