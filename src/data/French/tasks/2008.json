		{
			"id": 200803,
			"completionStepIds": [
				200806
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200806",
							"2"
						],
						"stepId": 200806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "C'est étrange... Ce n'est jamais aussi calme ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080302,
					"content": "Ouaf, ouaf... Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080303,
					"content": "C'est Thomas qui joue encore au ventriloque, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080304,
					"content": "Thomas... Thomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080305,
					"content": "Ouaf ! Ouaf ! ... Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080306,
					"content": "Hé, vous pouvez sortir à présent... Je vous vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080307,
					"content": "Euh, il n'y a pas un chat... Argh, où diable est-il, alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080308,
					"content": "Ouaf, ouaf, ouaf ! Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080309,
					"content": "Hein ? Pourquoi Taroumaru est aussi agité aujourd'hui ? Il est toujours si calme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080310,
					"content": "#Bonjour, est-ce que l'{M#un}{F#une} d'entre vous a vu Thomas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080311,
					"content": "Non, on pensait qu'il était avec vous ! Pourquoi... Il est arrivé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080312,
					"content": "Alors c'est ce que je craignais... J'ai entendu dire sur la route pour venir ici que Thomas avait été emmené par la Commission administrative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080313,
					"content": "Je ne savais pas si c'était vrai, alors je suis venue ici. Le fait qu'il ne soit pas arrivé comme nous en avions convenu suggère que ce soit vrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080314,
					"content": "La Shogun Raiden organise une cérémonie de saisie à la Statue de la divinité omniprésente aujourd'hui, pour marquer le 100e œil divin réquisitionné par ordre du décret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080315,
					"content": "Et le porteur du 100e œil divin en question... celui qui se le verra confisqué, j'en ai peur, c'est Thomas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080316,
					"content": "Attendez une seconde... Donc la cérémonie à laquelle Thomas disait que la Commission administrative se préparait... c'était cette cérémonie de saisie d'œil divin ? Et il en était la cible depuis le début ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080317,
					"content": "... C'est ce que je crois. La Shogun et la Commission administrative considèrent la cérémonie comme une étape importante. Avec le 100e œil divin capturé, elles souhaitent montrer le succès du décret de saisie jusqu'à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080318,
					"content": "... Je ne peux pas les laisser faire. Je dois aller le sauver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080319,
					"content": "Ouaf, ouaf ! Ouaf !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080320,
					"content": "Restez calme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Mais vous êtes la Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Oui ! Que vous le vouliez ou non, vous représentez la Commission culturelle dans son ensemble. Faire un coup comme celui-là, cela reviendrait à déclarer la guerre à la Shogun Raiden, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080323,
					"content": "Et en le faisant publiquement, vous pourriez compromettre beaucoup d'autres personnes de la Commission culturelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080324,
					"content": "Il n'y a pas d'autre option... Je dois agir au plus vite, la cérémonie va commencer. Je n'abandonnerai pas Thomas comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080325,
					"content": "Il est mon ami ! Dire qu'il n'y a pas si longtemps, on était... tous en train de manger une marmite ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080326,
					"content": "Il est aussi mon ami. Je vais le sauver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080328,
					"content": "Vous l'avez dit vous-même. Pas de temps à perdre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080330,
					"content": "#... D'accord, je... je vous attendrai ici. Revenez {M#sains et saufs}{F#saines et sauves}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080331,
					"content": "Ne vous inquiétez pas, Ayaka. La vie d'un ami est en jeu, on ne va pas laisser faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
