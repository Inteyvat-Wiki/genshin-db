					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751651002
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751651002,
					"content": "Vous verrez à quel point une carrure plus imposante peut être puissante en combat réel une fois que vous aurez essayé !",
					"roleType": "TALK_ROLE_NPC",
