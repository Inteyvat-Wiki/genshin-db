			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Héhé ! Pas mal, mais vous êtes encore un peu derrière moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Ça fait maintenant un moment que je suis légèrement potelée, mais croyez-moi, je n'ai jamais lésiné sur l'entraînement. Mon agilité et ma force sont bien supérieures à celles des accros de la salle de sport.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "Oubliez les muscles, célébrez la grandeur du gras avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
							"3"
						],
						"stepId": 7516505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516506"
						],
						"stepId": 7516506
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "#Vous vous êtes bien {M#débrouillé}{F#débrouillée}, mais honnêtement... Sans vouloir me vanter, mon record personnel reste meilleur que le vôtre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650802,
					"content": "Enfin, chacun a ses talents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650803,
					"content": "Vous voyez ? Même quelqu'un de mon gabarit peut être agile. Du coup, faites attention à bien manger sans faire de régime draconnien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
		{
			"id": 7516509,
			"completionStepIds": [
				7516506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
