		},
		{
			"id": 7516502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516502",
							"2"
						],
						"stepId": 7516502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "#Ah, {M#courageux passant}{F#courageuse passante} ! Je suppose que vous êtes quelqu'un qui cherche la force pour avoir fait tout ce chemin jusqu'aux Teteocans. Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "Peut-être en avez-vous déjà vu certaines personnes que le Collectif de l'abondance qualifierait de fortes. Ha. C'est une bande d'imbéciles, si vous voulez mon avis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "#Et vous ? Vous êtes plutôt svelte, et pas {M#l'un}{F#l'une} de ces accros de la salle de sport obsédés par leurs soulevés et leurs développés couchés quotidiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "C'est une escroquerie. Ne vous laissez pas avoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Vous n'aimez pas vous entraîner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "Ce n'est pas aussi simple, mais je trouve que le culte des muscles et le fait que tout le monde croit que la force d'un guerrier ne dépend que d'eux est complètement absurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Vous savez, les héros d'autrefois n'auraient jamais pu avoir un corps qui était constitué seulement de peau, d'os et de muscles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Ils vivaient dans des conditions bien plus difficiles que les nôtres aujourd'hui. La survie et la défense étaient primordiales pour eux. Pour pouvoir assurer pendant de vrais combats, je suis certaine qu'ils avaient une bonne couche de graisse pour se protéger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "Leur physique était sans doute plus proche du mien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "Ce corps légèrement potelé que j'ai est celui qu'auraient eu les héros d'autrefois : un corps qui incarne équilibre entre impact et agilité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Mais malheureusement, les membres de cette tribu ne veulent pas voir la vérité en face. Ce sont tous des idiots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "#Vous n'avez pas l'air tout à fait {M#convaincu}{F#convaincue}... Hmm, que diriez-vous de ceci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "Essayez le défi de destruction de pots que j'ai créé ! J'ai conçu cet endroit pour m'entraîner, mais je vous laisse tenter votre chance volontiers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Vous verrez à quel point une carrure plus imposante peut être puissante en combat réel une fois que vous aurez essayé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Vous n'aimez pas les muscles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
