			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "#Hé, {M#courageux passant}{F#courageuse passante} ! Oui, vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "*soupir* Vous êtes si maigre... Mangez-vous à votre faim ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Ma guide, Paimon, a mangé toute ma nourriture.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Quelles que soient vos raisons ou les difficultés que vous affrontez, la première règle est de bien se nourrir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "En arrivant chez les Teteocans, vous avez probablement vu les guerriers du Collectif l'abondance, je suppose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Permettez-moi de vous donner un conseil par bonté de cœur : ne faites jamais confiance à ces types qui n'arrêtent pas de vous parler de muscles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "Le gras dont l'Archon nous accorde est un précieux cadeau. Pourquoi renoncer à toute cette nourriture délicieuse pour le perdre, juste pour avoir des gros muscles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "C'est la chose la plus stupide à faire. Même les sangliers des forêts auraient pitié de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "Si nous parlons uniquement d'esthétique, ce culte des muscles n'est devenu populaire qu'au cours des dernières décennies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Mon grand-père m'a raconté qu'à son époque, les gens préféraient une silhouette un peu plus ronde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Ne laissez donc personne vous tromper et vous emmener sur le mauvais chemin de la perte du poids !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Mais si un jour, vous décidez de perdre du poids pour avoir plus de force comme les membres de ma famille au Collectif de l'abondance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Il y a autre chose à retenir : les guerriers avec un léger embonpoint peuvent être aussi agiles que des poissons. En matière de force, ces maigrichons ne nous arrivent pas à la cheville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Si vous voulez des preuves, il suffit de regarder les pots de ce terrain d'entraînement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Avec ma carrure, je peux facilement <color=#00E1FFFF>courir sans en casser un seul</color>. Je parie que les maigrichons n'y arriveraient pas avec ce niveau d'agilité. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Oh, je vois que vous essayez de ne pas rire, hein ? D'accord... Vous ne me croyez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Allez, tentez votre chance ! Courez à travers le terrain aussi vite que vous le pouvez, mais assurez-vous <color=#00E1FFFF>de ne pas briser un seul pot</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Voyons voir comment vous vous débrouillez et si vous pouvez battre mon record.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Hein ? Vous me proposez un repas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "#Pas vraiment... Mais si vous êtes {M#affamé}{F#affamées}, j'ai de la viande grillée dans mon sac. Bref, ce n'était pas le sujet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
