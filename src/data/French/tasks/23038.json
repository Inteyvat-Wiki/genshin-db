			"dialogs": [
				{
					"id": 230380101,
					"content": "#{M#Voyageur}{F#Voyageuse} ! {M#Voyageur}{F#Voyageuse}, venez vite ici, j'ai besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380102,
					"content": "Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Vous vous souvenez de Maruf ? Le médecin du Village d'Aaru qui vous a demandé de venir me voir pour une ordonnance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "Ce gars a essayé un bol de la soupe médicinale qu'il a préparée et a été pris de vomissements et de diarrhée pendant plusieurs jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Quand je l'ai interrogé, il m'a dit qu'il modifiait lui-même les ordonnances parce qu'il constatait que les traitements ne fonctionnaient pas sur les patients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Je me demande quel ingrédient il a ajouté à la soupe pour qu'elle lui fasse ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "*soupir* S'il avait suivi l'ordonnance en modifiant simplement les proportions et les méthodes de préparation, cela ne serait jamais arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "Ce n'est pas la première fois que ça lui arrive, comment se fait-il qu'il continue à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380109,
					"content": "Peu importe, il a peut-être ses propres difficultés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380110,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous aller chercher des ingrédients médicinaux pour moi ? Cette fois-ci, je prépare la soupe moi-même. Je vous demanderai ensuite d'aller l'apporter à Maruf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380111,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "L'ordonnance que Maruf a modifiée cette fois-ci est celle que je lui ai prescrite la dernière fois pour traiter les maux de tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380115,
					"content": "Il manque encore trois quandongs pour compléter cette ordonnance. S'il vous plaît, allez-m'en cueillir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380112,
					"content": "Ça lui est déjà arrivé auparavant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "Oui, je ne compte plus le nombre de fois que ça lui est arrivé. Heureusement qu'il n'utilise pas de médicaments puissants, sinon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
