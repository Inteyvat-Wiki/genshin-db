					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Qu'est-ce qui vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "J'ai apporté les médicaments de Zakariya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "Donc je suppose que vous avez appris ce qui m'arrive... Je suis désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Allez, buvez ce remède.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "Oh... Oui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf boit la potion...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Ouf... Je me sens mieux... Le docteur Zakariya est vraiment un bon médecin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "Pourquoi avez-vous modifié l'ordonnance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Vous vous souvenez de la soupe médicinale que j'ai faite avec vous la dernière fois ? Je ne sais pas pourquoi, mais elle n'est pas très efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "J'ai pensé qu'il y avait peut-être eu une erreur dans la préparation, ou qu'il manquait certains ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "Alors j'ai... Euh... Refait la soupe en me fiant à ma propre expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "Pour des raisons de sécurité, j'ai d'abord essayé la soupe moi-même, et puis j'ai fini dans cet état...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "Je viens de demander à quelqu'un d'aller voir le docteur Zakariya et de lui dire de me prescrire des médicaments. Je ne m'attendais pas à ce que vous m'apportiez les médicaments si rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}. Je vais me reposer encore un peu avant de continuer à recevoir des patients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "Il doit y avoir beaucoup de patients dans le village qui attendent de me voir après tant de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*soupir* On dirait que je suis encore à court d'herbes médicinales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
