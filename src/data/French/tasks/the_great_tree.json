				"points": []
			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "#{M#Voyageur}{F#Voyageuse}, quelle chance de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270202,
					"content": "Vous faites toujours des recherches ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Eh bien, Ladep et Pharez m'ont dit qu'ils avaient besoin de plus de données, alors je vais devoir continuer mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270204,
					"content": "Je me demande comment vont les racines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270205,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous avez le temps, s'il vous plaît, est-ce que vous pourriez noter à nouveau l'état des racines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
