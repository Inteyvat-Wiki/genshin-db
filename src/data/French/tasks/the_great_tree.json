			},
			"dialogs": [
				{
					"id": 230271101,
					"content": "Vous êtes de retour ! Comment vont les racines de l'arbre divin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Vous expliquez l'état des racines à Yasmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "... Oh, s'il y a des créatures, cela signifie que la terre est encore vivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271104,
					"content": "Les racines de l'arbre divin doivent pouvoir se développer sainement sans trop de problèmes pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271105,
					"content": "La seule chose dont on doit s'inquiéter... est la possible eutrophisation de l'eau environnante, ce qui engendrerait la prolifération des Fongus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271106,
					"content": "Oh, voilà votre récompense. Merci pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271107,
					"content": "Je ferais mieux de demander à Ladep et Pharez de surveiller la concentration élémentaire environnante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
}