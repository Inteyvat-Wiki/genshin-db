					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Il faut en prendre soin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#Vous êtes... {M#un voyageur}{F#une voyageuse} on dirait, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Je m'appelle Yasmin, je suis étudiante à l'Amurta. Je suis ici pour faire des recherches sur l'arbre divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "Cet arbre a vécu plus d'années que les grains de riz de tous les riz pilafs du Port Ormos réunis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "En même temps, il est la pierre de soutènement de l'Académie... Il est aussi important que le lit de légumes sous le poulet tandoori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "C'est quoi toutes ces métaphores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Si quelque chose lui arrivait, la Ville de Sumeru serait confrontée à une catastrophe sans précédent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Par exemple, s'il était infecté de criquets plus gros qu'un toit qui sortiraient de l'intérieur de l'arbre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Ou bien si ses branches se mettaient à pousser frénétiquement et si ses racines jaillissaient du sol tel un raz-de-marée, détruisant toutes les maisons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Ou encore si l'arbre divin se desséchait si rapidement que son tronc écrasait la moitié de la Ville de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "M—Mais tout cela ne va pas arriver, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Oh, bien sûr. Pour l'instant, tout va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Mais ce n'est pas comme si les Fongus qui vous attaquent quand vous allez cueillir des champignons dans les bois vous prévenaient à l'avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "C'est la raison pour laquelle je fais des recherches ici, pour observer l'état de ce grand arbre et se préparer à toute éventualité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Mais comme vous pouvez le voir, mon esprit a beau être aussi vif qu'un fauconuit, je n'ai pas plus de force qu'un champitoile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "#Alors, {M#voyageur}{F#voyageuse}, est-ce que vous pourriez noter l'état des racines de l'arbre divin pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "J'engage habituellement des aventuriers pour m'accompagner, mais personne n'a l'air disponible en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Est-ce que tous les chercheurs parlent comme vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Oh ? Vous voulez parler des métaphores ? Je suis désolée, j'ai toujours parlé comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "Beaucoup de gens m'ont fait la remarque à l'Académie, mais ce n'est pas comme si je pouvais changer comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Je compte sur vous. Je vous attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "#Je suis {M#sûr}{F#sûre} que Paimon comprend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Quel arbre immense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
