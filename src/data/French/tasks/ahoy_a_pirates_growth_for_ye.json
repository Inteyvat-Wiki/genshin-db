			"dialogs": [
				{
					"id": 210000101,
					"content": "*soupir* Est-ce que je peux vraiment y arriver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000102,
					"content": "Qu'est-ce qu'il t'arrive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#Oh, c'est toi, {NICKNAME}... Bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000104,
					"content": "Petit Meng, tu n'as pas l'air content, ça ne va pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "Qu'est-ce qu'il se passe ? C'est parce qu'ils ne veulent pas jouer avec toi à votre jeu de pirates ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Oh ? Non, Lulu et Fei sont déjà rentrés à la maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000107,
					"content": "Je... Je voulais marcher un peu tout seul, c'est pour ça que je ne suis pas encore rentré chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000108,
					"content": "Tes parents ne vont pas s'inquiéter pour toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "À cette heure-ci, mes parents doivent encore être en train de travailler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000110,
					"content": "#Enfin bref... {NICKNAME}, est-ce que je peux te poser une question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000111,
					"content": "Oui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{NICKNAME}, j'ai entendu beaucoup de gens me dire des choses sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000115,
					"content": "Tu as visité beaucoup d'endroits et vécu beaucoup de choses. Alors, peut-être que tu auras une réponse à ma question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000116,
					"content": "Ouah... Petit Meng, tu es si sérieux tout à coup. Qu'est-ce qu'il t'est arrivé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "Je voudrais te demander...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000118,
					"content": "Comment fait-on pour devenir « mûr » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000119,
					"content": "Grandir demande du temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Tu veux dire que l'on devient naturellement mûr en grandissant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000121,
					"content": "Mais, si on ne devient mûr qu'après avoir grandi, ce n'est pas un peu trop tard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000124,
					"content": "Hmm... Si tu as envie de sortir de la ville pour voir comment c'est, on pourrait t'accompagner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Non, je ne veux pas vous embêter... Et puis, je ne suis même pas sûr qu'on en tire quoi que ce soit d'intéressant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000126,
					"content": "#{NICKNAME}, je voudrais seulement te demander un petit service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000127,
					"content": "Apparemment, quand on a des soucis impossibles à résoudre, on peut les écrire sur une feuille et la mettre dans une bouteille que l'on jette à l'eau. Comme ça, ils se font emporter par le courant de la rivière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000128,
					"content": "Cette action pourrait être une façon de les résoudre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000129,
					"content": "Mais j'ai aussi entendu dire qu'il y avait beaucoup de monstres à l'extérieur. Ce serait dangereux si j'y allais tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000130,
					"content": "Est-ce que tu pourrais me protéger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000131,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "Merci ! Je te récompenserai avec les sous que j'ai économisés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000134,
					"content": "C'est parti. Allons d'abord à la Rivière Bishui pour voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000132,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Il faut avoir vécu des choses particulières.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Avoir vécu des choses particulières... Mais jusqu'à maintenant, je ne suis jamais sorti du Port de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000112,
					"content": "Je n'ai pas le temps de m'amuser avec toi pour l'instant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Hahaha, je ne joue à ce jeu que pour faire plaisir à Lulu et Fei. Je ne le fais donc pas quand ils ne sont pas là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Petit Meng"
				}
			]
		},
