			"dialogs": [
				{
					"id": 210000201,
					"content": "On est presque arrivés à la Rivière Bishui, non ? Bon, choisissons un bon endroit pour lâcher la bouteille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000202,
					"content": "Si on veut qu'elle dérive assez loin, il faut choisir un endroit en amont de la rivière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				}
			]
		},
