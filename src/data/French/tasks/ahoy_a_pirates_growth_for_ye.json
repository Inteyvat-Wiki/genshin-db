			"trigger": {
				"objectNames": [
					"Petit Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "Je n'arrive pas à croire que ce genre de chose existe... Ça m'a fait trop peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000302,
					"content": "Merci. On peut continuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000303,
					"content": "Hé ? Où est ma bouteille ? Je l'avais sur moi à l'instant. Elle a disparu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000304,
					"content": "Ne me dis pas que je l'ai laissé tomber quand on s'est fait attaquer par la Fleur mensongère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000305,
					"content": "S'il te plaît, aide-moi à la retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				}
			]
		},
		{
			"id": 2100005,
			"completionStepIds": [
				2100011
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100017",
							"3"
						],
						"stepId": 2100017,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100011",
							"2"
						],
						"stepId": 2100011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Génial... J'ai passé toute la soirée d'hier à écrire. Si je la perds, je devrai tout recommencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000502,
					"content": "Ouah... Tu as tant de soucis que ça ? Comment ça se fait que tu aies eu besoin d'une soirée entière pour tout écrire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Non, c'est juste que je veux savoir comment on fait pour devenir mûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000504,
					"content": "J'ai cherché beaucoup d'informations et lu des livres aussi. Mais plus je lis, et plus je tombe sur des choses difficiles à comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000505
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000505,
					"content": "Héhé, j'ai donc écrit toutes les choses que je ne comprenais pas. J'espère que je pourrai avoir des réponses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000506
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 210000506,
					"content": "Allez, allons vite jeter cette bouteille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petit Meng"
				}
			]
