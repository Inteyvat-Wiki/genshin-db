			"dialogs": [
				{
					"id": 728060501,
					"content": "Ah, vous êtes enfin de retour ! Comment ça s'est passé ? Avez-vous trouvé nos deux écrivains ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "Oui. Les lettres ont été livrées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "#Très bien ! Merci, {M#voyageur}{F#voyageuse}. Et qu'est-ce qu'ils ont dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "Ils ont tous les deux dit qu'ils liraient les lettres avec attention.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Bien, bien. *tousse* C'est juste dommage qu'ils soient tous les deux à Liyue... Même en temps normal, nous ne pouvons pas leur rendre visite facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Surtout monsieur Zhenyu... Son livre, « Une légende d'épée », n'a même pas été soumis par lui, mais par un marchand ambulant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Ensuite, un de nos éditeurs a lu cette œuvre et a reconnu sa valeur. Il avait même décidé d'aller à Liyue pour rencontrer ce Zhenyu et organiser la rédaction d'autres manuscrits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Qui aurait pensé qu'avec tout ce qui se passe à Inazuma, aucune des lettres que nous avons envoyées à Liyue n'aurait obtenu de réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Nous ne pouvions que publier d'abord son livre en consignant minutieusement les droits d'auteur dus à monsieur Zhenyu. Nous pensions les lui envoyer une fois le contact établi avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Mais cela fait si longtemps, et pourtant « Une légende d'épée » reste un best-seller. Ses droits d'auteur commencent à s'accumuler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "*soupir* Comme j'aimerais que monsieur Zhenyu puisse assister à cette compétition... Nous ne pouvons pas laisser cet argent s'accumuler comme ça plus longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
