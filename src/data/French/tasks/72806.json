			"trigger": {
				"objectNames": [
					"Chang le Neuvième"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "#Hmm ? {M#Voyageur}{F#Voyageuse} ? Qu'est-ce qui vous amène ici aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 728060202,
					"content": "Voici une lettre et un cadeau de la Chambre Yae...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Une lettre de la Chambre Yae ? Ils ne vont pas encore me demander de changer mon nom de plume, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 728060204,
					"content": "Je leur ai déjà dit mille fois que j'allais écrire en utilisant mon vrai nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 728060205,
					"content": "Ah, oubliez ça. Laissez-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 728060206,
					"content": "Ils veulent que je juge un concours d'écriture de roman... Hmm... Je ne pense pas avoir le temps, mais je suppose que je devrais quand même les remercier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 728060207,
					"content": "Hein ? C'est quoi, tout ça ? Ce sont... des suggestions créatives...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang le Neuvième"
				},
				{
					"id": 728060208,
					"content": "#Euh, eh bien... Je vais les lire attentivement. Merci, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang le Neuvième"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
