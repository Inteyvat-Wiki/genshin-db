			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "Oh, cette bouteille est lourde. Comme s'il y avait quelque chose dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280102,
					"content": "« Un vieil ami est venu hier porteur de mauvaises nouvelles... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280103,
					"content": "« Cela fait des lunes que je n'ai pas reçu de réponse de ta part. Peut-être avait-il raison... Peut-être devrais-je accepter la réalité... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280104,
					"content": "« Néanmoins, si tu parcours toujours ces contrées, j'espère que tu pourras m'envoyer une réponse, si tant est que tu reçoives ce message. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280105,
					"content": "« Apposes-y ton insigne, afin que je sois en mesure de le reconnaître le moment venu. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280106,
					"content": "« Tu te souviens de la Pagode Uyou ? Nous nous retrouverons là-bas. Je joins à cette lettre l'argent pour le vin. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280107,
					"content": "« Mais si vous n'êtes point la personne à qui je destine cette lettre... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Bouteille abandonnée"
				},
				{
					"id": 701280108,
					"content": "« J'espère également que vous pourrez conserver ce souvenir, et qu'un jour, peut-être, vous m'aiderez à le remettre à son propriétaire légitime. Prenez ces quelques moras en remerciement. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bouteille abandonnée"
				}
			]
		}
	]
}