			"dialogs": [
				{
					"id": 750210301,
					"content": "Merci, je n'y serais jamais arrivé seul !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Alors, c'est une étoile tombée du ciel ? En y regardant de près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Ah ! Je sens un pouvoir mystérieux s'emparer de moi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "Quoi ?! Vraiment ? Hé, attends, nous n'avons même pas encore trouvé les fragments éparpillés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "En parlant de fragments, y a-t-il vraiment des indices les concernant ici ? Je ne vois rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "Alors, quelle est la prochaine étape ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Nous devrons compter sur notre force brute. <color=#00E1FFFF>Frappez-le avec toute la puissance d'un tepetlisaure</color>, et peut-être que nous découvrirons où se trouvent les fragments manquants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "Mon père dit souvent que la force brute permet de résoudre la plupart des problèmes ! Mais je n'ai pas encore trouvé la mienne, et je n'ai pas non plus de compagnon saurien... Vous êtes mon seul espoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Quel étrange rocher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "C'est vrai qu'il est étrange... Mais je ne sens aucun pouvoir mystérieux qui en émane... C'est juste moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
