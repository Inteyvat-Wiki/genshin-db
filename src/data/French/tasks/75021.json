			},
			"dialogs": [
				{
					"id": 750211301,
					"content": "#Tu ressens une puissance incroyable, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Pas vraiment, non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "Le gros rocher n'a pas changé d'un poil ! Pas de lueur mystérieuse, pas même de secousse soudaine ni de fissure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "#Nous serions-nous {M#trompés}{F#trompées} d'incantation ? Ça me paraissait juste pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Nous avons déjà rencontré ce genre de situation en explorant des ruines ! Si on se souvient mal du mot de passe ou du signal, le mécanisme ne réagit tout simplement pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Bizarre... On m'a dit que ce truc libérerait le pouvoir caché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "Et la personne qui me l'a dit a fermé les yeux et a commencé à gémir de douleur peu de temps après l'avoir récitée ! Non seulement ça, mais par la suite, il a acquis un « œil magique » qui pouvait déterminer la valeur des pierres précieuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Waouh, c'est trop cool !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Hein ? Je trouve ça louche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Te voilà ! Je t'ai enfin trouvé, espèce de petite canaille ! Comment es-tu arrivé jusqu'ici ? Ton père est mort d'inquiétude !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211312,
					"content": "Je lui ai dit que je rentrerais quand ce serait l'heure de manger ! Était-ce vraiment nécessaire de te le dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Tu oses me répondre ? Vous deux, les enfants là-bas, ne tardez pas non plus ! Qui sait quels genres de dangers pourraient apparaître si vous traînez trop longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211314,
					"content": "Vous ramenez Orqo et expliquez la situation...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "#*soupir* Ce ne sont que des fantaisies enfantines. Désolée que vous ayez été {M#entraînés}{F#entraînées} dans ses bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211316,
					"content": "Il est devenu un peu difficile, car personne n'est là pour l'éduquer correctement. Sa mère n'est pas là, et son père perd la vue. Je suis leur voisine, donc j'essaye de faire ce que je peux pour aider, mais je n'ai pas non plus une énergie illimitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211317,
					"content": "Je le savais ! Imaginez simplement collecter quelques fragments de pierre et vous obtenez des pouvoirs mystérieux... Ce n'est pas possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Je ne suis pas difficile, c'est pour papa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Arrête de dire n'importe quoi ! Tout ça, c'est parce que tu n'écoutes jamais les aînés ni ceux qui en savent plus que toi. Aujourd'hui, tout s'est bien passé, mais as-tu seulement réfléchi à ce qui se passerait si tu avais de réels ennuis un jour ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211320,
					"content": "Bon, ça suffit. Sois un bon garçon et rentre avec moi maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211321,
					"content": "D'accord... Mais d'abord, voici pour vous. Ce sont les moras que je vous avais promis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Veuillez accepter, nous ne voudrions pas qu'il ait la réputation de quelqu'un qui ne tient pas parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211323,
					"content": "Dans ce cas... Nous ne pouvons pas refuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "J'aurai peut-être besoin de votre aide à l'avenir ! Nous avons échoué cette fois, mais ça ne veut pas dire que nous ne réussirons jamais, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Espèce de petit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211327,
					"content": "Allons-y Mama Coco, mon père attend ! Merci à vous deux, à la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Ces symptômes me disent quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
