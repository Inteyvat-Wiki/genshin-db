			"dialogs": [
				{
					"id": 750210101,
					"content": "Qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "... Waouh ! Vous m'avez fait peur ! Et si j'étais tombé ? Comment m'auriez-vous dédommagé ? Je n'ai pas encore découvert mes pouvoirs cachés, je ne suis qu'un petit enfant sans défense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Oh, désolée ! Je ne voulais pas te faire peur ! Mais... Des pouvoirs cachés ? Est-ce une sorte de technique ultime ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Mais, c'est un pouvoir caché, comment voulez-vous que je le sache ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "C'est pas faux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Enfin, n'en parlons plus. Pouvez-vous m'aider à trouver les fragments d'étoiles ? J'ai économisé pas mal d'argent de poche en aidant Mama Coco, et vous pouvez tout avoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Eh bien, puisque tu nous demandes de l'aide, tu pourrais au moins nous dire ton nom. D'ailleurs, je m'appelle Paimon, et voici {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "Le nom que j'utilise maintenant n'est qu'un nom de code... Mais tout le monde m'appelle Orqo, alors vous pouvez m'appeler comme ça aussi. Est-ce que vous allez m'aider à trouver les fragments d'étoile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Mais... Qu'est-ce qu'un fragment d'étoile ? Ça ne doit pas être facile à trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Ce sont des fragments d'étoiles tombés du ciel ! Si vous les trouvez et les ramenez à leur source, vous pourrez retrouver le pouvoir perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Regardez ! Une étoile est tombée juste en dessous, il doit y avoir des pistes pour trouver des fragments d'étoile là-bas. Allez, donnez-moi un coup de main, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "D'accord, nous allons vous aider ! Mais des fragments d'étoiles, un pouvoir perdu et ainsi de suite... Ça ressemble beaucoup à un roman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "Vous n'avez même jamais entendu l'histoire de Qoyllor et Ukuku ? Mon père me l'a racontée un million de fois, je l'ai entièrement mémorisée. Je serais heureux de la partager avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Mais commençons par descendre pour jeter un coup d'œil ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Si jeune, et déjà des excuses ridicules.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
