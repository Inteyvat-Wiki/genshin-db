			"dialogs": [
				{
					"id": 750210701,
					"content": "Waouh, super ! Vous avez trouvé tous les fragments d'étoile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "J'ai économisé pas mal d'argent de poche en aidant Mama Coco. Je vous donnerai jusqu'au dernier mora si vous me donnez les fragments d'étoile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Des fragments d'étoile ? À quoi servent-ils ? Euh... Et tout d'abord, qu'est-ce qu'un petit enfant fait ici tout seul ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "... Tout le monde m'appelle Orqo, alors vous pouvez m'appeler comme ça aussi. Même si ce n'est qu'un nom de code...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "Je suis seulement là pour récupérer les fragments d'étoiles ! Vous avez aussi vu le gros rocher en contrebas, n'est-ce pas ? C'est une étoile tombée du ciel !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "Tant que nous pouvons collecter les fragments dispersés et les y restituer, nous pouvons récupérer le pouvoir qui a été perdu... Je vous en prie, j'ai vraiment besoin de ces fragments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Ça m'a l'air un peu louche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Ouais... Mais ça compte quand même comme un indice, non ? Pourquoi ne pas essayer pour voir ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Pourtant, des fragments d'étoiles, un pouvoir perdu et ainsi de suite... Ça ressemble beaucoup à un roman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "Vous n'avez même jamais entendu l'histoire de Qoyllor et Ukuku ? Mon père me l'a racontée un million de fois, je l'ai entièrement mémorisée. Je serais heureux de la partager avec vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Mais descendons d'abord ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Orqo et vous arrivez à côté de l'étoile tombée...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "Allez, dépêchez-vous de remettre les fragments sur l'étoile ! Waouh... Je me demande quel pouvoir va se réveiller ? Peut-être que je pourrai aussi monter vers le ciel... Héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Waouh, ils sont si bien que ça ? D'accord, je ne peux clairement plus vous les donner maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Hé, ce n'est qu'un petit enfant ! Détends-toi un peu. Et même si nous ne savons pas si c'est vrai ou non, pourquoi ne pas essayer et voir ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
