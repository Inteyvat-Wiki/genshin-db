			"dialogs": [
				{
					"id": 750210501,
					"content": "C'est tout ? Cette mission était bien plus facile que ce que je pensais ! De tels pouvoirs miraculeux existent-ils vraiment ? J'étais plutôt sceptique avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Tu veux aussi libérer des pouvoirs cachés, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Bien sûr ! Ce ne serait pas génial et ça ne nous faciliterait pas grandement la vie d'avoir la capacité de trouver des trésors sans effort ou la puissance de vaincre n'importe quel monstre d'un seul coup de poing ? Allez, {NICKNAME}, ça ne te tente pas du tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Je veux plus de puissance !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Oh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "Allez, dépêchez-vous de remettre les fragments sur l'étoile ! Waouh... Je me demande quel pouvoir va se réveiller ? Peut-être que je pourrai aussi monter vers le ciel... Héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "#Je suis déjà assez {M#fort}{F#forte}, je n'ai pas besoin de ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Hein ? Mais ne dit-on pas que la recherche de pouvoir est une quête sans fin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
