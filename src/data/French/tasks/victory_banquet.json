				"objectNames": [
					"Hirai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "L'Île de Watatsumi a enfin retrouvé la paix, et tout cela c'est grâce à Son Altesse, Sangonomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "Il s'est passé quelque chose récemment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Récemment ? Euh, laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Eh bien, la chose la plus importante pour nous, c'est qu'on peut enfin retourner en mer pour pêcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Pendant les affrontements, la haute mer était pleine de navires de guerre. On devait se débrouiller avec le peu de poissons et de crevettes qu'on pouvait trouver près du rivage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Quand la pêche n'était pas bonne, nous avions tous faim. Les pauvres enfants pleuraient toute la journée et toute la nuit, mais je ne pouvais rien faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "On allait se coucher affamés et on se retournait dans notre lit toute la nuit, essayant de tenir jusqu'au matin. Au moins, les choses s'améliorent enfin maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "#J'ai cru comprendre que vous étiez {M#le}{F#la} capitaine de l'Espadon II, c'est cela ? Eh bien, merci pour votre service. Tenez, prenez ce poisson ! Il vient juste d'être pêché, donc il est encore un peu, euh, visqueux, mais ne vous en faites pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Non, non, non, vraiment, nous ne pouvons pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Ah, allez, prenez-le ! Sans vous, on aurait probablement encore faim ce soir. Son Altesse nous enseigne qu'il faut savoir être reconnaissant envers ceux qui sont bons avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#D'accord, eh bien, merci. Allez, {NICKNAME}, allons parler aux autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
