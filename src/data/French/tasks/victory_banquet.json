			"dialogs": [
				{
					"id": 120230601,
					"content": "Bonjour à vous, envie de fruits et légumes frais ? C'est le remède naturel quand on a abusé du barbecue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "Il s'est passé quelque chose récemment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Est-ce que vous faites référence à la question de l'entente entre la Commission administrative et les Fatui ? J'ai entendu quelques rumeurs à ce sujet, mais rien de bien précis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "C'est drôle que vous disiez que les soldats semblent excités, cependant. J'ai eu le même sentiment. Vous voyez ce type, là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "Il se comporte de façon bizarre ces derniers temps. Il n'arrête pas de crier et d'agiter sa lance quand il n'a rien à faire. Il m'a déjà fait peur à plusieurs reprises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Argh... C'est un miracle que les combats aient enfin pris fin. J'espère vraiment qu'on n'aura pas de nouveaux problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "Je suis désolée, j'ai peur de ne pas avoir plus d'informations. Si vous avez encore des questions, vous pouvez aller lui parler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "Ça a l'air prometteur. Allons voir ce qui se passe avec ce gars !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
