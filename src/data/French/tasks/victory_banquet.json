			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "#Vous êtes {M#un bon combattant}{F#une bonne combattante}... Pas étonnant que Son Altesse vous ait {M#choisi}{F#choisie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Vous avez vraiment la volonté du guerrier... Alors, peut-être que vous pouvez nous comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "Capitaine, camarade... Venez vous joindre à nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Vous devez d'abord me dire ce qui se passe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "On l'a inventée. L'histoire de l'entente de la Commission administrative avec les Fatui... Ça n'est pas arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "QUOI !? La pauvre Kokomi est morte d'inquiétude ! Et vous nous dites que vous avez tout inventé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "Qu'est-ce qui vous est passé par la tête ? Vous auriez pu relancer la guerre contre la Commission administrative avec vos histoires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Oui. C'est exactement ce qu'on voulait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Des pourparlers de paix ? Pfft... Tout le monde se laisse avoir. C'est pourquoi l'avenir de l'Île de Watatsumi est en jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "Qu'est-ce qui empêchera la Commission administrative de nous poignarder dans le dos ? Et qu'est-ce qui empêchera la Shogun Raiden de publier un autre décret de saisie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Nous sommes la Résistance ! Tout repose sur notre volonté de guerrier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Nous ne pouvons pas faire confiance à la Commission administrative ou à la Shogun Raiden. Mais nous pouvons avoir confiance en nous-mêmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Vous êtes d'accord avec ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Il a raison dans un certain sens, mais il y a quelque chose qui me dérange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "Vous voulez juste vous battre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Oui ! Tout ce que vous venez de dire n'était que pure spéculation, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Vous êtes prêt à inventer une folle rumeur et à ruiner la paix pour laquelle tout le monde a travaillé si dur, le tout à cause d'une situation imaginaire qui pourrait même ne jamais arriver ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Ne prenez pas ce ton avec moi, comme si vous étiez au-dessus de tout ça ! Qu'est-ce que vous y comprenez, vous, de toute manière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Quand notre but était d'être victorieux, nous étions tous l'incarnation de la volonté du guerrier. Vous comprenez ? Nous étions tous ensemble. Maintenant, on essaye de nous dire que tout cela n'a plus d'importance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Vous voudriez que je dépose les armes et que je commence à vivre comme une personne normale, mais comment pourrais-je ? Comment pourrais-je alors que... chaque fois que je ferme les yeux, je vois les visages des amis que j'ai perdus au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Chaque fois que je les vois, dans mon esprit, cela me rappelle que je ne pourrai jamais pardonner à la Commission administrative, ni jamais pardonner le décret de saisie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "J'imagine que vous n'êtes pas l'un des nôtres... Enfin, peu importe. Allez tout dire à Sangonomiya si vous voulez. Il est trop tard pour nous arrêter à présent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Trop tard ? Qu'est-ce que vous voulez dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "Zut, je ne pense pas qu'il va répondre cette fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#Qu'est-ce qu'on fait, {NICKNAME} ? C'est vraiment grave ! On doit tout raconter à Kokomi tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "... On a découvert deux, trois choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "Toute cette histoire sur un soi-disant complot entre la Commission administrative et les Fatui, c'est fabriqué de toutes pièces ! Ils ont tout inventé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Ils voulaient que les pourparlers de paix soient rompus afin qu'ils puissent continuer à faire la guerre. Et ils ont dit qu'il était trop tard pour essayer de les arrêter, quoi que nous fassions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Mm. Je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Quel est le problème, Kokomi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Je vais bien, ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "C'est ma faute. Si seulement j'avais compris ce qu'ils ressentaient plus tôt, on n'en serait jamais arrivé là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "Je pense que je comprends ce que Kouzen veut dire quand il dit qu'il est trop tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "Les pourparlers ne commencent que demain, mais les deux parties ont déjà envoyé leurs gardes sur les lieux. Ils ont la responsabilité de s'assurer que la zone est sûre et sécurisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Je soupçonne fortement qu'un des complices de Kouzen se soit infiltré parmi les gardes en vue de relancer les hostilités demain lors des négociations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Ah, c'est pas bon. Vous voulez qu'on aille là-bas tout de suite pour changer les équipes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "Ça ne fonctionnerait pas. Premièrement, parce que le fait d'amener une nouvelle équipe de gardes sur un site de négociation neutre mettrait les deux parties en alerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Il y aurait de fortes chances que cela pousse les soldats en faveur de la guerre à passer à l'action. Ils attaqueraient les gardes de la Commission administrative, ce qui risquerait de provoquer un nouveau conflit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "Sans compter que nous n'avons aucune idée du nombre de soldats de l'Île de Watatsumi qui sont impliqués dans ce complot. Si nous changeons de garde à la hâte, nous sommes confrontés au problème de ne pas savoir à qui faire confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Ça a vraiment l'air d'une situation délicate... Il n'y a vraiment rien qu'on puisse faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Ne vous inquiétez pas, ce qui est fait est fait. À présent, il m'appartient de trouver une parade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Ces soldats sont allés trop loin, mais ils ne sont pas les seuls responsables. Quoi qu'il arrive, je trouverai un moyen de m'assurer qu'ils ne soient pas blessés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Retrouvons-nous ici demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "Est-ce que vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
		{
			"id": 1202305,
			"completionStepIds": [
				1202308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
