			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "Pfiou... Ce type sent l'alcool...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230202,
					"content": "#Mmh ? Attendez, laissez-moi deviner... Vous êtes {M#le}{F#la} capitaine de l'Espadon II ! C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230203,
					"content": "#Alors finalement, vous êtes {M#revenu}{F#revenue}. Je pensais que vous aviez abandonné le peloton et que vous vous étiez {M#enfui}{F#enfuie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230204,
					"content": "Non, non, non ! On ne fuirait jamais un combat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230205,
					"content": "Hmpf, vraiment. Tout le monde ne parle que de paix et de stabilité ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "Est-ce que vous vous souvenez de la chose la plus importante pour la Résistance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230207,
					"content": "La volonté du guerrier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "#Exactement. Alors je vais vous mettre à l'épreuve. Il est temps de voir si vous êtes {M#un véritable guerrier}{F#une véritable guerrière} de la Résistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230209,
					"content": "Je ne répondrai à vos questions que si vous arrivez à me battre en duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230210,
					"content": "Argh, ce type... Ça le tuerait d'avoir une conversation normale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230211,
					"content": "Qu'est-ce que tu en penses, est-ce qu'on essaye ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230212,
					"content": "Bien sûr. On n'a rien à perdre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Hmpf... On va voir ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230213,
					"content": "Dans quelques secondes, vous supplierez de parler !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
