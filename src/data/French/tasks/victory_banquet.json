			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "On dirait que tout est en place pour le festin. Mais je dois encore faire un petit discours avant le début des festivités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Oh... Combien d'énergie cela prend ? Vous pensez que vous en avez assez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Ne vous inquiétez pas, j'ai plein d'énergie. Grâce à vous deux, j'ai récupéré plus vite que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "C'est super ! On vous encouragera !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Bienvenue tout le monde. Aujourd'hui est le jour où nous célébrons notre victoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Récemment, notre guerre contre l'armée de la Shogun a pris fin et nous avons finalement assisté à l'abolition du décret de saisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Aucun de nous ne peut savoir à quoi ressemblera l'Inazuma du futur. Mais demain, je rencontre la Commission administrative pour les pourparlers de paix. Je vous donne ma parole que je lutterai pour rétablir la paix de façon durable dans l'Île de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Merci à tous pour vos vaillants efforts. En vérité, ce n'est que grâce à ces efforts que nous avons pu l'emporter dans cette guerre éprouvante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Ce festin est tenu en l'honneur de chacun d'entre vous réunis ici aujourd'hui. J'espère que vous pourrez tous vous détendre et profiter de cette victoire durement gagnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Wouuuh !!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "On dirait que la soirée s'est déroulée sans accroc. Je suis tellement contente que tout se soit bien passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#Les gens ont tendance à être plus ouverts lorsqu'ils sont de bonne humeur. {NICKNAME}, pouvez-vous recueillir des informations pour moi, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Je n'ai toujours pas de piste sur la question d'une entente potentielle entre la Commission administrative et les Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "Et j'ai peur que quelque chose arrive lors des pourparlers de paix de demain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Entendu, bien sûr. On va demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
