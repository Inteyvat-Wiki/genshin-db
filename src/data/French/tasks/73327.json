	"talks": [
		{
			"id": 7332701,
			"completionStepIds": [
				7332701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332701",
							"2"
						],
						"stepId": 7332701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME} ?! C'est... C'est toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270102,
					"content": "Et Paimon est là aussi ! Je n'aurais jamais imaginé tomber sur vous ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270103,
					"content": "Jeht ! C'est vraiment toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "Haha, pas si fort ! Tu vas effrayer mes poissons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270105,
					"content": "Bip bip !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Vous êtes en train de pécher ? Mais pourquoi tu n'utilises pas de canne à pêche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "Bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#Benben, ne dis pas n'importe quoi ! Bon... {NICKNAME}, et si on parlait d'autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270109,
					"content": "Où est ta canne à pêche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "Tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270111,
					"content": "Elle... s'est cassée toute seule. Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270112,
					"content": "*soupir* Je ne savais pas que la pêche était si différente de la chasse. Tss, pourquoi c'est si difficile ! Je n'ai pas eu la patience de rester assise pendant des heures à attendre qu'ils mordent à l'hameçon. Alors je me suis dit, autant plonger dans la rivière les attraper moi-même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270113,
					"content": "Et tu n'as pas réussi à en attraper un seul, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "Hmph, bien sûr que si ! J'en ai attrapé un gros, encore plus grand que toi... Euh, il fait même un demi Benben de plus que toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270115,
					"content": "Bip bip ! Bip bip !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "Je l'ai grillé et l'ai mangé en entier, il n'en reste plus pour toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270117,
					"content": "Bip bip...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "Oui, Benben a aussi eu sa part. Tu es la seule à ne pas pouvoir en manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270119,
					"content": "Pff, j'y crois pas une seule seconde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "Hahahaha ! Tant pis pour toi si tu ne me crois pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270125,
					"content": "Comment vas-tu, ces derniers temps ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "Moi ? Très bien, ne t'inquiète pas pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270127,
					"content": "Et puis, ce n'est pas la première fois que je voyage en solitaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270128,
					"content": "Bip bip ! Bip bip !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "Hahaha, détends-toi ! Je sais que tu es là avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270130,
					"content": "Depuis mon conflit avec les Tanit, les gens du désert ont cessé de me fournir des tentes ou de la nourriture... Je ne suis plus sous la protection d'aucune tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270131,
					"content": "Plus tard... Rukh Shah de la Légion des trente m'a proposé de m'accueillir, mais... La vie en ville me met mal à l'aise. Ça me rappelle ma mère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270132,
					"content": "J'ai donc fait mes adieux à la Ville de Sumeru, et je me suis dit... Pourquoi ne pas aller dans un autre pays pour voir des paysages que je n'ai jamais vus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270133,
					"content": "Et c'est comme ça que je suis montée à bord d'un bateau marchand et que je suis arrivée ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270134,
					"content": "Et ensuite... Haha, il n'y a rien d'autre à raconter ! Il n'y a pas un endroit dans le monde où l'on ne cherche pas de garde du corps, tu sais ? Surtout dans les grandes villes où les caravanes marchandes vont et viennent ! Donc, j'ai la vie plutôt facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270135,
					"content": "Héhé, si les choses doivent se passer ainsi, alors soit... Avoir les quatre coins du monde pour maison n'est pas désagréable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270136,
					"content": "Benben et moi, on est comme Paimon et toi, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270137,
					"content": "Pff, un Benben ne vaut pas une Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "Bip bip !!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#Hahaha, allez, ça va... {NICKNAME}, je ne vous retiens pas plus longtemps. Je voulais vous inviter à manger un grand repas, mais il y a des règles à respecter pour les escortes armées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270140,
					"content": "Ahem ! Ne parlons plus de choses qui fâchent ! Je te fais mille câlins et te souhaite un voyage sans encombre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270141,
					"content": "#{M#Souviens-toi bien que nos chemins se recroiseront à nouveau !}{F#N'oublie pas ce que je t'ai dit à la tribu des Tanit. Si jamais tu te sens fatiguée ou tu veux faire une pause... Nous nous reverrons à ce moment-là.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270121,
					"content": "Je ne m'attendais pas à te voir ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Oui... Je ne pensais pas vous voir non plus. Quelle belle surprise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270123,
					"content": "Héhé... J'espère qu'on ne t'a pas dérangée dans ta pêche... Ou plutôt, ton attrapage de poisson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "Tais-toi un peu, petite Paimon ! Tu parles trop !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				}
			]
		},
