			},
			"dialogs": [
				{
					"id": 741421301,
					"content": "#Oh ! Merci {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "Qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Je ne sais pas... Je voulais juste venir voir les tournesols en fleurs et l'adorable toutou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Mais en chemin, une créature effrayante a soudainement commencé à me poursuivre. Le ciel devenait sombre et j'entendais des bruits étranges que je ne comprenais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "J'étais terrifiée, alors j'ai suivi la lumière dorée et j'ai continué à courir en avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "À chaque fois que la créature s'approchait de moi, le monde devenait un peu plus sombre... Le jardin, le palais, les grands arbres et les fleurs disparaissaient. Ils s'assombrissaient, ne laissant que des ruines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "Ensuite, la créature m'a rattrapée... Snif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Plus besoin de s'inquiéter maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "Toutou, ramène-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Ne revenez plus ici, il y a tout un monde qui vous attend à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "Oh ? C'est le toutou... Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "On pourra se revoir ? Ce monde peut-il redevenir un beau jardin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "Non. Au revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "Et toi. Je vais te poser à nouveau la question, qu'est-ce que je suis à tes yeux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Un chien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "Eh bien, c'est une bonne chose. Tu as chassé quelqu'un qui ne devrait pas être là, ce qui a empêché l'effondrement de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Mais ce ne serait pas sage de rester ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "Je pense aussi. Ramène-moi là-bas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Très bonne décision. Adieu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "Qu'est-ce qui se passe exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Cet endroit était sur le point de s'effondrer complètement. Une personne qui ne devrait pas être là est arrivée, ébranlant les fondations de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "C'est pourquoi j'ai vu ce que j'ai vu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "Je ne peux pas savoir ce que tu as vu. Après tout, je ne suis pas toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "Eh bien, qui es-tu alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "Mon identité n'est pas importante. Ce qui compte, ce sont les propriétaires de ce monde imaginaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Ils croyaient pouvoir sauver le monde, mais ils ne savaient pas si ce monde avait besoin d'être sauvé. Peut-être que le monde qu'ils ont en mémoire n'est rien d'autre qu'un après-midi où les tournesols fleurissaient, un passé perdu à jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Cependant, ce sont leurs histoires, et pas les miennes. Je ne suis que leur souvenir d'un ami. Ils ont cru pouvoir me sauver, mais au final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "La chenille se nourrit jusqu'à devenir un cocon, le cocon se brise alors que la larve émerge, et finalement la larve se dirige vers le néant qui n'est jamais né.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Cependant, tout cela n'a plus d'importance, car maintenant, il ne me reste plus rien. Je suis juste une ombre dans leurs souvenirs, une trace de leur obstination à me sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Cependant, je ne leur en veux pas non plus. Même s'ils ont changé après m'avoir perdu, le moi qui existe dans ce monde, fait de souvenirs et d'illusions, témoigne de leur persévérance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "En tant qu'ancien ami, je suis satisfait. Peu importe l'apparence que je prends désormais, je resterai toujours reconnaissant pour l'amitié que nous avons partagée dans le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "Bon, c'est tout. Ressens-tu l'influence des lieux sur toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Adieu. Nous ne nous reverrons plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
