						],
						"pointId": 6837
					}
				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#Oh ! C'est {NICKNAME} ! Attendez, Paimon n'est pas avec vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Cette fissure... Qu'est-ce que vous regardez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Oh ? Quelle fissure ? Ce n'est pas un miroir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "À ce propos, il y a bien quelque chose que je recherche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Je suis à la recherche d'indices sur le miroir mystérieux... Il ressemble à un tableau et comme le livre des révélations, il permet de « méditer ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "À propos des quatre Orthants et de la peinture dans la Tour de la gestalt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#Oh, je vois ! C'est donc à cet endroit-là. Hmm ! Merci {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
