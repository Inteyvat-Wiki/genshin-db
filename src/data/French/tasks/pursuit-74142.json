			"dialogs": [
				{
					"id": 741421401,
					"content": "Ouah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421402,
					"content": "Paimon, je...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "Ça a été si rapide ! Je n'ai même pas eu le temps de cligner des yeux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421404,
					"content": "Tant mieux alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#Bon, on dirait bien que notre petite fauteuse de troubles est revenue ! Canotila, vous avez vraiment inquiété {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421406,
					"content": "Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421407,
					"content": "*pleure* Pardon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421408,
					"content": "Hé ? Mais ce n'est pas votre faute ! Ne pleurez pas, Canotila, je vais vous donner quelque chose de délicieux à manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421409,
					"content": "(Mais que s'est-il passé ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421410,
					"content": "(Nous avons rencontré des dangers à l'intérieur.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(Je vois...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421412,
					"content": "Ne pleurez pas, Canotila, vous êtes si courageuse ! Venez, voici ma brochette de poulet et de champignons préférée, pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421413,
					"content": "*pleure* ... Merci, Paimon... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421414,
					"content": "*mâche* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421415,
					"content": "Ouah, quelle drôle de saveur ! C'est ça la nourriture que les humains mangent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421416,
					"content": "Hé ! Si vous ne voulez pas la manger, rendez-la-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421417,
					"content": "#Mais... Merci, Paimon. Merci aussi à {NICKNAME}, merci de m'avoir sauvée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421418,
					"content": "Quels sont vos projets ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Je ne sais pas, mais je ne veux plus jamais lire de livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "Ce n'est pas un peu extrême ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "Hmm, mais le livre des révélations est vraiment effrayant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(Qu'est-ce qui s'est réellement passé ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(C'est difficile à expliquer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Tu le saurais si tu y étais.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(Quoi ! C'est vraiment agaçant...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421427,
					"content": "De toute façon, je ne veux pas rester ici. Je veux vivre avec tout le monde au village Mérusea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421428,
					"content": "Oui ! Les autres mélusines s'occuperont bien de vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421429,
					"content": "#D'accord. Merci à vous, {NICKNAME} et Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421425,
					"content": "(Heureusement que tu n'y es pas allée.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
			]
