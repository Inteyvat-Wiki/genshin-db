			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "Ah, c'est vous, ça fait des lustres que j'attends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "Vous êtes devenu ami avec l'Arbre enflammé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "#*soupir* Ne m'en parlez pas. Vous avez « négocié{NON_BREAK_SPACE}» une période de calme... très, très brève.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "Dès qu'il s'est rétabli, il a recommencé à essayer de me cogner ! ... Vous aviez raison. Il n'est pas possible de se lier d'amitié avec cette créature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Pourtant, ses fruits ont plutôt bon goût, un peu comme l'élément Pyro, en fait. Je pense que mes amis de Natlan vont adorer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "Je me demande quel goût ça peut avoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "Vous voulez essayer ? Si oui, je pourrais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "C—Ce ne sera pas nécessaire ! Vous allez essayer avec un Géosaure antique maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "C'est exact. Je pense sincèrement que cette fois, c'est la bonne. Après tout, les Géosaures antiques ressemblent beaucoup aux Tepetlisaures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Si vous vous rendez à Natlan depuis Sumeru comme moi, vous tomberez sur les sauriens en premier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "#Bien sûr. Mais je ne crois pas vraiment en nos chances de succès cette fois-ci non plus... Pourquoi ne pas envisager les Jeunes Géosaures{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "... Ils n'ont pas le ventre rond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "Comment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "Les Jeunes Géosaures n'ont pas le ventre rond. C'est sûrement à force de rouler à toute vitesse, leur corps n'a pas l'occasion d'accumuler de la graisse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "*soupir* Mais la raison principale reste le manque d'impact. Qu'est-ce qu'un Jeune Géosaure aurait de particulier pour mes amis qui vivent aux côtés des sauriens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "#En revanche, un Géosaure antique, c'est différent. Même dans une histoire, l'adversaire doit être suffisamment redoutable pour mettre en valeur {M#le}{F#la} protagoniste, vous comprenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Bon, ne perdons pas de temps. Le Géosaure antique nous attend !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "#Je suis {M#occupé}{F#occupée}. À plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Pas de problème, j'attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}