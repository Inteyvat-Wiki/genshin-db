			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Parlez-moi de ce rocher étrange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Vous avez pris un rocher étrange en photo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "Il faut absolument que je voie ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "Voici la photo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Dites donc, cette photo est si nette ! Les nouveaux modèles de Daguerréotypes fontainois sont aussi bons que les gens le disent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "J'avais acheté des prototypes, mais les photos qu'ils prenaient étaient floues. En plus, il fallait deux personnes pour déplacer un seul appareil. En fin de compte, je n'ai pas eu d'autre choix que de les laisser à l'Académie à prendre la poussière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Ils prennent la poussière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Oui, ça m'a tout de même coûté l'équivalent d'un repas. Hmm... D'ailleurs, il est temps que j'en achète de nouveaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Je m'égare. Voyons voir ce rocher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Pas de doute, il s'agit d'un fossile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "Un fossile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Précisément, et on peut y voir beaucoup de créatures marines... Intéressant. Il y a un proverbe à Liyue qui dit à peu près cela : « Les forêts et les champs finiront engloutis par le vaste océan. ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "Le fait que l'on puisse trouver des fossiles dans le Gouffre prouve que ces créatures ont été enterrées sous terre en un instant. Sinon, leurs os n'auraient pas été conservés de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "D'ailleurs, j'ai entendu dire que cet endroit connaissait de fréquents tremblements de terre. C'est logique, car l'une des conditions préalables à la formation de fossiles est l'existence de mouvements géologiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Voilà une découverte très utile pour étudier les créatures anciennes qui peuplaient cet endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Mais il faudrait disposer de davantage de photographies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Si vous trouvez d'autres fossiles comme celui-ci, prenez-les en photo pour moi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "Combien vous faut-il de photos ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Laissez-moi réfléchir... Si je veux les inclure dans mon rapport, il m'en faudrait quatre ou cinq... Bon, apportez-moi cinq photos de rochers similaires à celui-ci, ça fera l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Je vous les achèterai à bon prix étant donné que c'est une grande découverte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "C'est un peu du gâchis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
			"id": 7105009,
