			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520102,
					"content": "Ça va, Columbina ? Vous avez l'air déprimée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Ah, c'est vous deux. Je vais bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520104,
					"content": "(Serait-elle en train de repenser à la lune ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Peut-on faire quelque chose pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520108,
					"content": "Allez, dites-nous ! Même si ce n'est pas grand-chose, vous vous sentirez mieux après.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "J'aimerais... une boisson de la taverne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520110,
					"content": "... Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520112,
					"content": "Désolée... Ça m'a surprise. Vous parlez rarement de ce que vous voulez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "C'est tout ? Juste une boisson ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "Quoi ? Ce n'est pas assez ambitieux pour toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Je pensais qu'elle allait nous demander un truc du style : « Ramenez-moi la lune. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Mais je comprends. Columbina ne peut pas se rendre où elle veut à l'heure actuelle, alors aller à la taverne est aussi difficile que d'aller sur la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "C'était aussi le cas avant, quand j'étais avec les Fatui et que personne ne voulait me capturer... Tout le monde se tenait quand même à l'écart de moi quand j'allais me promener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520118,
					"content": "(Troisième Exécutrice des Fatui... Un titre qui suffit à effrayer tous ceux qui ne la connaissent pas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Ah, mais c'est beaucoup plus facile que ce que je pensais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Si vous voulez une boisson comme à la taverne, c'est dans les cordes de {NICKNAME} ! {M#Il}{F#Elle} peut vous la préparer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "... Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520122,
					"content": "Mais n'en attendez pas trop non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Une préférence de goût ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Un goût ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520125,
					"content": "Je n'ai jamais vraiment commandé de boissons, alors j'ignore par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520126,
					"content": "Peut-être quelque chose de pas trop lourd ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520127,
					"content": "C'est-à-dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Lourd, comme un manteau de Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520129,
					"content": "Cette comparaison ne nous aide pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Quelque chose de léger et délicat, alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "#Très bien, c'est vous l'{M#expert}{F#experte}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520131,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
