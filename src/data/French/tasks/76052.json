				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520202,
					"content": "Qu'en pensez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Cela me rappelle des souvenirs de l'époque où je vivais avec les Descendants de givrelune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520204,
					"content": "Ils faisaient un thé avec des feuilles de menthe fraîche, des épices et des baies séchées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520205,
					"content": "Quand je passais devant chez eux, il y avait toujours un subtil parfum d'herbes qui émanaient de l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520206,
					"content": "Vous y avez goûté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "J'ai toujours voulu, mais je n'en ai jamais eu l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520208,
					"content": "Oh ? Pourquoi pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Quand une « déesse » arrive au pas de votre porte et vous demande de goûter à votre thé, vous n'oseriez pas lui donner celui que vous préparez pour votre propre consommation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520210,
					"content": "Ah, c'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Ce que je recevais au bout du compte ressemblait davantage à une offrande, très joliment emballée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520212,
					"content": "C'était bon, mais il manquait ce sentiment chaleureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520213,
					"content": "On peut y remédier maintenant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520215,
					"content": "C'est très bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520216,
					"content": "... Ajouter du lait me semble cependant un peu inhabituel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520217,
					"content": "Ah, c'est une recette mondstadtoise. Les gens là-bas aiment ajouter du lait, de la crème et du sucre à leur thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "C'est original... mais d'une bonne manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520219,
					"content": "Pfiou, heureusement que ça vous a plu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520221,
					"content": "On dirait que le clair de lune n'est pas le seul moyen d'entrevoir le passé. Même quelque chose d'aussi simple que l'arôme d'une boisson a réussi à faire resurgir des souvenirs oubliés depuis longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
