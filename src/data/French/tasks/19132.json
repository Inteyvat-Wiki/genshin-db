			"trigger": {
				"objectNames": [
					"Lanyang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "Bonjour, je peux vous aider en quoi que ce soit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "#Je suis {M#venu}{F#venue} récupérer des vêtements pour Ningguang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "Ah oui, je m'en souviens. Attendez un instant s'il vous plaît, je vais les chercher à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Après un long moment à attendre, Lanyang réapparaît enfin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Voilà, c'est tout. Est-ce que vous pourriez apporter ceci à dame Ningguang ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Ça vous a pris un certain temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Oui, cette pièce contient de nombreuses antiquités personnelles de dame Ningguang. Il y a non seulement des vêtements, mais aussi des bibelots et des bijoux en tout genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "Dame Ningguang nous a demandé de redécorer cette pièce, donc tout est un peu en désordre pour le moment. C'est pour ça que ça m'a pris un peu de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Ningguang à l'air de posséder beaucoup de choses...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "#Bien, vous pouvez prendre la tenue. Merci d'être {M#venu}{F#venue} la chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Seules les personnes riches ont ce genre de problème...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
