			"dialogs": [
				{
					"id": 409110301,
					"content": "Vous voilà. Je vous présente mon <color=#00E1FFFF>Fourneau élémentaire</color> !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110302,
					"content": "Pas la peine de passer la journée à discuter. Ne perdons pas de temps et commençons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
		{
			"id": 4091104,
