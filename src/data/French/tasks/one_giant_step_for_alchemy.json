			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "#Ah ! {M#Voyageur}{F#Voyageuse} ! Attendez un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Je suis un peu gêné... J'aurais besoin de votre aide pour quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Comme vous le savez, l'alchimie est ma marotte, mais je n'ai jamais fait de découverte notable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "J'ai compris qu'il fallait que je trouve une autre approche, où je ne progresserai jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Vous passez à la bio-alchimie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Vous passez à l'alchimie antique ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Alors j'ai décidé d'aborder les choses différemment. De faire quelque chose qui n'a jamais été fait jusqu'à maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "Oh ça ? Plein de chercheurs étudient ça, il n'y a là rien de nouveau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "L'alchimie antique ? Pas vraiment ma tasse de thé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Vous savez quel est le facteur le plus important dans une réaction d'alchimie ? Les éléments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Pour un certain nombre de raisons, la plupart du temps l'alchimie utilise des objets concentrés en énergie élémentaire, plutôt que l'énergie pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Mais l'utilisation de ce type de matériau entraîne des impuretés, ce qui influe négativement sur la réaction alchimique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Il n'y a pas d'autre choix pour compenser que d'utiliser une quantité importante de matériaux élémentaires... Mais même là, il convient de faire particulièrement attention : les impuretés peuvent ruiner la réaction entière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Hélas, pour ceux qui ne possèdent pas d'œil divin, ceci représente un coût supplémentaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "Sans compter que le problème suivant demeure : les matériaux de ce type ne sont pas donnés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Et quand les factures reviennent plus cher que le résultat des transformations alchimiques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "Je n'ai pas d'œil divin non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Qu'est-ce que vous attendez de moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "*soupir* C'est peut-être pour ça que je ne fais aucune découverte d'intérêt. Le prix à l'entrée est trop élevé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "En effet, mais... Il paraît que vous maîtrisiez les éléments ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Vous n'avez pas d'œil divin, mais j'ai entendu dire que vous maîtrisiez les éléments, je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "J'ai mis au point un nouveau prototype de four à alchimie. Je l'appelle <color=#00E1FFFF>Fourneau élémentaire</color>. Son fonctionnement est très simple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Enfin, en deux mots, c'est un réceptacle capable de contenir de l'énergie élémentaire pure et de générer des réactions élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Avec un peu de chance, ce fourneau me permettra enfin de progresser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "Tout est prêt. Il me manque juste quelqu'un capable de diriger les énergies élémentaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "Si ça vous intéresse, rejoignez-moi au <color=#00E1FFFF>Temple des Mille Vents</color> ; j'ai déjà fait appel à quelqu'un pour monter l'appareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "J'espère que cette fois-ci je vais progresser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
