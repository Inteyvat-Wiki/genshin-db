			"dialogs": [
				{
					"id": 710960101,
					"content": "Vous avez trouvé des pierres séculaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960102,
					"content": "En voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "Nous voilà avec trois pierres séculaires de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960202,
					"content": "C'est avec une grande gratitude que je prends ces pierres séculaires des mains de ces deux personnes altruistes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960203,
					"content": "Je ne m'attendais pas à ce que vous en trouviez trois aussi rapidement. Et elles sont de bien meilleure qualité que celles que j'ai vues précédemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960204,
					"content": "*soupir* ... Elles ressemblent à celle que j'avais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960205,
					"content": "Vous avez une pierre séculaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960206,
					"content": "Alors pourquoi nous envoyer en chercher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "J'ai dit que j'en AVAIS une...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960209,
					"content": "Un jour, mon vieux père était en train de manipuler un lot de minerais à la Chambre Shenglu. Parmi les débris, il y avait une pierre séculaire de faible qualité, alors il me l'a donnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960210,
					"content": "On se disputait tout le temps à l'époque. Je n'avais pas de travail. Et pour empirer les choses, je passais la plupart de mon temps à la Maison de thé Yanshang. Du coup, j'ai fini par contracter une grosse dette, et à avoir des problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960211,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960212,
					"content": "C'est pas terrible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "Eh bien, qui n'a jamais fait une bêtise ou deux dans sa jeunesse ? Quoi qu'il en soit, quand je n'avais nulle part où aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960214,
					"content": "Quelqu'un a vu que j'avais une pierre séculaire et m'en a proposé un bon prix : une pierre en échange de quelques moras pour me sortir du pétrin. Un échange équitable, en somme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960215,
					"content": "Pourtant, mon père m'en a parlé l'autre jour et m'a demandé : « Muning, où est-ce que tu as mis la pierre que je t'avais donnée ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960216,
					"content": "Tout ce que j'ai pu lui répondre, ça a été : « Ce n'est qu'une pierre. Cela fait longtemps que je l'ai perdue. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960217,
					"content": "Tout en disant cela, je n'ai pas pu m'empêcher de me demander ce qui se serait passé si je n'avais pas vendu la pierre et que je lui avais montrée quand il me l'avait demandé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960218,
					"content": "... Oublions ça. Ça ne sert à rien de se demander ce qui aurait pu arriver maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960219,
					"content": "Au moins, vous êtes revenu sur le droit chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960220,
					"content": "C'est vrai... C'est juste que j'ai encore un long chemin à parcourir pour rembourser mes dettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960221,
					"content": "Mais je m'éloigne du sujet. Apportez-moi les pierres si vous en trouvez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960222,
					"content": "Combien suffiront ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "Trois autres. Trois pierres en plus devraient suffire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960225,
					"content": "La pierre séculaire est un minerai rare. Si le Hall Huishan en veut plus, je doute sérieusement que je puisse en trouver plus ici au Gouffre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960223,
					"content": "Combien en avez-vous besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "Commencez par donner la vôtre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}