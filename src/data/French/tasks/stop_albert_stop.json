					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420703,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "Tant mieux. Mais pourquoi étiez-vous en train de balayer les feuilles mortes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "C'est pas grave. Au moins, grâce à vous, Albert ne reviendra pas traîner ici pendant un moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "Je vous fais cadeau de ces quelques objets. Que Barbatos vous bénisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "Si vous n'avez plus rien à me dire, je vais me remettre au travail. Vous devriez en faire autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
