						200421002
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421002,
					"content": "*soupir* Vous connaissez Barbara ? C'est l'ange de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421003,
					"content": "Beaucoup de gens l'admirent ici, moi y compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421004,
					"content": "Je suis le président de son fanclub !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421005,
					"content": "Les chevaliers de l'Ordre vont bientôt arriver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "Laissez-moi finir au moins ! J'admire vraiment Barbara. J'ai envie de faire quelque chose pour Mondstadt, comme elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421007,
					"content": "Hélas, je ne suis qu'un homme ordinaire et passer le balai autour de la cathédrale a été la meilleure chose que j'aie trouvé à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421008,
					"content": "Mais Sœur Victoria ne veut jamais rien entendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421009
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421009,
					"content": "J'ai essayé de lui expliquer que j'ai décidé de le faire car personne ne balayait les feuilles mortes, mais elle ne comprend pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421010
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421010,
					"content": "Aidez-moi à les balayer. Faites-le pour Mondstadt... et pour Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
