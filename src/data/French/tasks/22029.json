			},
			"dialogs": [
				{
					"id": 220290201,
					"content": "#Vous vous êtes {M#retenu}{F#retenue}, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "Ne vous inquiétez pas pour moi. Utilisez toute votre force, je dois devenir plus fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
