			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Je dois le faire ! Coûte que coûte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Hmm ? Vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "J'ai accepté une mission de votre part.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Oh, vous voulez dire la mission pour un partenaire d'entraînement. Oui, c'est moi qui l'ai publiée. Je voulais que quelqu'un pratique les arts martiaux avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "#C'est donc vous qui l'avez acceptée ? Mais je ne pense pas vous avoir déjà {M#vu}{F#vue} en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Excusez-moi. Je ne remets pas en question votre force, mais je ne connais pas votre niveau en arts martiaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "J'ai terrassé des dragons géants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Hahaha... Vraiment ? À vrai dire, je suis plus curieux de savoir où vous en avez trouvé un. J'en ai seulement entendu parler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "Je me débrouille aussi bien au combat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Haha ! Quoi qu'il en soit, rien ne sert de parler avec sa bouche quand il s'agit d'arts martiaux. C'est avec ses poings qu'il faut convaincre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Mais avec plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Attendez, pourquoi avez-vous publié cette mission de façon anonyme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "C'est pour une raison dont je ne suis pas très fier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "Ahem. Mais puisque vous l'avez déjà acceptée, je vais être franc avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Il y a quelque temps, je suis parti en mission avec d'autres collègues doushins. Sur le chemin retour, nous sommes tombés sur un groupe d'Oni des mers qui s'apprêtait à attaquer une caravane de marchands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Nous nous sommes donc précipités pour sauver la caravane. Au début, nous avions le dessus et ils ont rapidement battu en retraite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Cependant, alors que nous étions sur le point de reprendre notre souffle, un autre groupe d'Oni des mers est soudainement apparu de nulle part, mené par leur chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Mes collègues et moi avons été pris au dépourvu avant même que nous puissions réagir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Nous avions perdu l'avantage, alors la seule chose que nous pouvions faire était de repousser les Oni des mers tout en escortant les marchands vers la ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "Et quand je me suis battu avec le chef des Oni des mers... Eh bien, il m'a pris mon arme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Ce type a même brandi mon arme après me l'avoir prise et s'est moqué de moi... Quelle humiliation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "Qu'est-il arrivé à ce groupe de marchands ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Sur le chemin vers la ville, nous sommes tombés sur d'autres doushins qui étaient en patrouille. Après les avoir vus, les Oni des mers ont battu en retraite également.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Les marchands ont été escortés dans la ville, mais leurs marchandises ont toutes été... *soupir* C'est de ma faute à cause de mes piètres compétences...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Quand je suis rentré, on m'a aussi redonné une arme, mais je n'arrive toujours pas à me remettre de ce qu'il s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "J'ai publié cette mission, car je voulais améliorer mes compétences de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Une fois que je serai assez fort, j'irai régler le compte de cet Oni des mers pour récupérer mon arme et mon honneur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "J'ai été témoin de la chute d'un dieu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Hé, de quoi parlez-vous ? Vous auriez déjà assisté au rituel de la descente à Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Dans ce cas, beaucoup de gens à Liyue ont aussi été « témoins de la chute d'un dieu ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2202902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
