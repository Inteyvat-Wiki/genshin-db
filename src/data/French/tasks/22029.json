					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "#*halète* Vous êtes vraiment très {M#fort}{F#forte}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Je... J'ai beaucoup appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Ce n'est rien. Je dois juste reprendre ma respiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "#Vous êtes si {M#puissant}{F#puissante} que je vous croirais sur-le-champ si vous me disiez avoir vaincu un dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "J'ai vraiment vaincu un dragon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Hahaha... Je vous crois très certainement. Merci de vous être entraîné avec moi, je me souviendrai de notre duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "#Si vous le voulez bien, venez vous entraîner avec moi plus souvent à l'avenir... Avec {M#un}{F#une} partenaire comme vous, je suis sûr d'accomplir cet objectif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "Quel objectif ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Ahem... C'est juste un souhait que j'ai dans le coin de ma tête. Merci pour ce temps, veuillez accepter ceci comme récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Je dois rentrer et me reposer un peu. Vos coups étaient incroyables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "#{M#Désolé}{F#Désolée}, je n'ai pas senti ma force...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
