			"dialogs": [
				{
					"id": 732171801,
					"content": "« Notre compagnie a ouvert une route maritime jusqu'au Port de Dornman. Nous invitons les marchands intéressés à se joindre à notre commerce de fruit. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171802,
					"content": "« Attendez une minute. Il est vraiment possible d'importer des fruits de Mondstadt compte tenu de la longueur d'un tel voyage ? S'il s'agissait de commerce de vin, je serais sans doute intéressé. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171803,
					"content": "« Tout le monde sait déjà qu'il est rentable d'importer du vin de Mondstadt. En revanche, je suis le seul à importer des fruits de là-bas. C'est opportunité commerciale, vous comprenez ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171804,
					"content": "« En plus, il n'est pas impératif de récupérer les marchandises à Mondstadt même... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
