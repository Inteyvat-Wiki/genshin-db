			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Rappel spécial : Les Érémites sont les seuls mercenaires autorisés à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170402,
					"content": "Ne faites pas aveuglément confiance aux inconnus pour éviter de vous faire escroquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170403,
					"content": "Si vous souhaitez engager des gardes du corps, des gardiens, ou si vous avez d'autres requêtes, veuillez contacter Feroz, capitaine de la Légion des trente au Port Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
