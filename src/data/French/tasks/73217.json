					"content": "L'Auberge de Shapur est la plus grande auberge du Port Ormos. Elle fournit les meilleurs services aux marchands et aux voyageurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170802,
					"content": "Nous offrons des tarifs spéciaux pour les étudiants de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
