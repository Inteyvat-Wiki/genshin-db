					"content": "Des bêtes marines ont été aperçues, soyez vigilant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170702,
					"content": "J'ai constaté dernièrement une intensification des activités des bêtes marines. Les navires quittant le port doivent être attentifs aux alertes émises par le Phare de Pharos, ou obtenir des informations maritimes à l'avance via l'Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170703,
					"content": "Si vous avez des questions, veuillez contacter le gardien du phare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
