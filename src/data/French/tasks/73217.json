			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "Ce panneau d'affichage a été mis en place par le capitaine du Port Ormos pour faire connaître les affaires importantes du port. Si vous avez des questions, veuillez les poser ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "« Vous peinez à trouver un plan adéquat pour votre mémoire ? Vous cherchez des idées à droite à gauche ? Il est temps d'essayer de nouvelles méthodes ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170202,
					"content": "« J'ai été formé à l'Hara{RUBY#[S]Sémiotique}vatat et je maîtrise aussi les théories du Span{RUBY#[S]Élémentalisme}tamad et du Kshah{RUBY#[S]Technologie}rewar. Je propose des services de questions-réponses sur la rédaction de mémoires. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170203,
					"content": "« Il est temps de se débarrasser de vos soucis. Demandez monsieur Amandeep à l'hôtel. Tarifs négociables. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170204,
					"content": "« Pouvez-vous rédiger mon mémoire à ma place ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170205,
					"content": "« Non, l'inspecteur ne tolère pas de telles pratiques. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170206,
					"content": "« Effectivement. Concentrez-vous sur vos études et ne trichez pas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Avez-vous entendu parler de l'art de la lévitation ? Avez-vous déjà vu un spectacle de trapèze ? Voulez-vous découvrir les secrets de la bête de somme volante ? Alors ne manquez pas le premier spectacle à Sumeru du Cirque du ciel de Fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170302,
					"content": "Bienvenue à vous ! Notre spectacle artistique unique est toujours là ! Seulement cinq moras l'entrée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170303,
					"content": "« C'était merveilleux. Je n'ai jamais vu un spectacle pareil, même à Fontaine ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
