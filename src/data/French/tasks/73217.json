			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Le port est en train de lutter activement contre les activités de contrebande. Toutes les marchandises passant par le port doivent être enregistrées et inspectées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170602,
					"content": "Toutes les marchandises non enregistrées ou les biens de contrebande seront confisqués.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170603,
					"content": "Le propriétaire de la ou des cargaisons devra assumer toutes les conséquences découlant de ces activités irrégulières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
