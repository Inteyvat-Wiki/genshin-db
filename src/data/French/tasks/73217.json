			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "« Les mahamatas qu'on nous envoie sont de plus en plus mauvais. Ils ne sont pas capables de répondre à la moindre question que je leur pose. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171002,
					"content": "« Maintenant, vu que j'ai accès à l'Akasha, ces amateurs de mahamatas ne font même pas le poids face à moi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171003,
					"content": "« Il n'y a que ce scribe qu'on voit rarement qui nous a aidés à y a quand même un scribe que l'on voit rarement et qui nous a aidés à organiser les horaires des navires la dernière fois. Les académiciens ne sont pas tous des abrutis, dirait-on. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
