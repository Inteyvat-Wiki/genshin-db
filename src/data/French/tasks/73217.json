			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "« J'ai navigué jusqu'à un pays, et il se trouve que le roi de ce pays n'a jamais vu de cheval. Vous y croyez ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171302,
					"content": "« J'ai donc décidé d'y vendre des bêtes de somme en leur disant que c'étaient des chevaux, haha. Si j'arrive à signer un contrat avec eux, je pourrais sans doute devenir un roi ou quelque chose du genre là-bas ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171303,
					"content": "« C'est quoi, un roi ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171304,
					"content": "« Un roi, c'est comme le navbed ou un vizir, mais avec plus de pouvoir qu'eux. C'est un peu comme les 29 deys de la légende. C'est très difficile à expliquer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171305,
					"content": "« Vous avez tout inventé, ça se voit. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
