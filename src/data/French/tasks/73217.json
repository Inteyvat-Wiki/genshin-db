			"dialogs": [
				{
					"id": 732170501,
					"content": "Tous les navires entrant au port doivent renseigner les coordonnées du propriétaire de l'embarcation et le motif d'accostage auprès du capitaine de port.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170502,
					"content": "Les navires marchands doivent fournir des informations détaillées sur leur cargaison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170503,
					"content": "Les navires marchands ne doivent pas décharger leur cargaison ou effectuer des transactions commerciales sans s'être préalablement enregistrés. Toute violation fera l'objet de sanctions sévères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
