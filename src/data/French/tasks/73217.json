			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "La Guilde des marchands de Feiyun est spécialisée dans les gemmes et les minerais précieux de Liyue et dispose de canaux d'approvisionnement stables et suffisants. Nous avons une coopération à long terme avec de nombreuses flottes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171202,
					"content": "En outre, nous vendons une petite quantité de produits de soie et de vêtements à la mode. Venez acheter sans plus attendre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171203,
					"content": "Si vous disposez de bons canaux d'approvisionnement pour des marchandises locales et de bonne qualité de Sumeru, comme des tapis, des pierres précieuses, des herbes ou des brocarts, veuillez nous contacter et négocions entre amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
