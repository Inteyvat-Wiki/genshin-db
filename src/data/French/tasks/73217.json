			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "« Les conférences des sages ne sont qu'ennui. Pourquoi ne pas se procurer du bon vin au miel floral et partir en voyage à travers les sept mers ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
