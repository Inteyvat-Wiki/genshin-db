			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "« Le service à l'Auberge de Shapur est certes excellent, mais l'isolation sonore laisse cruellement à désirer. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170902,
					"content": "« J'avais choisi de séjourner ici parce que les prix au Port Ormos sont abordables. Mais on dirait bien que je vais devoir chercher un endroit dans la Ville de Sumeru. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732170903,
					"content": "« Si je rate à nouveau les examens cette année, je vais devoir rentrer au pays et travailler dans les champs. Si cela arrive, je me demande si je pourrais rapporter un peu de faveurs anahitiennes... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
