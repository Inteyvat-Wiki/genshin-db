			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "« J'ai plus de travail depuis que Cyno est devenu général mahamatra, mais c'est beaucoup plus détendu puisque je n'ai plus à me mêler aux disputes ennuyeuses des darshans. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171102,
					"content": "« Sans ça, je n'aurais pas le temps de venir flâner ici lors de mes missions d'inspection. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171103,
					"content": "« Je me demande où est passé Cyno ces derniers temps. Si j'écris un message ici, il ne le verra probablement pas. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171104,
					"content": "« J'ai tout lu. Venez me voir avant demain midi pour recevoir votre sanction. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 732171105,
					"content": "« Ne me faites pas perdre mon temps. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
