					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "Hein, c'est... Attendez, je dois être confuse. Qu'est-ce que c'est !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130202,
					"content": "Toute cette île est comme une boîte à cadeau géante cachée sous le bouclier d'énergie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130203,
					"content": "On dirait qu'il y a quelque chose là-bas. Allons jeter un œil, voulez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130204,
					"content": "Oui, je veux voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130205,
					"content": "Méchante fille des flammes, tu es enfin arrivée. J'ai attendu bien trop longtemps... Comme c'était ennuyeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130206,
					"content": "Tu oses m'affronter, moi le seigneur du Clan Dodo, le Roi Dodo !? Tu ne manques pas de courage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130207,
					"content": "Mais tu as beau avoir un courage admirable, cela n'a plus la moindre importance parce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130208,
					"content": "Parce que le Roi Dodo, c'est moi, ta maman, Alice !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130209,
					"content": "Hein ? Maman !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130210,
					"content": "Attendez ! Alice ? La personne qui a écrit le Guide de voyage en Teyvat !?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130211,
					"content": "Klee et ses fidèles amis insulaires, bonjour à tous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130212,
					"content": "Alors qu'est-ce que vous en pensez ? Ça vous a plu ? Le ciel d'été et les vagues de l'océan, hmm. Ça donne l'impression d'être en vacances, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130213,
					"content": "Inutile de me chercher, je ne suis pas là en personne. L'appareil qui vous parle sur la plateforme devant vous n'est autre que l'une de mes créations personnelles, le Phonographe d'Alice ! Je m'en sers pour transmettre l'amour d'une mère à sa fille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130214,
					"content": "Oh ? C'est pas vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130215,
					"content": "Hé, je ne vous ai pas fait peur, quand même ? Je suis désolée, Klee aime jouer avec toutes sortes de petits jouets. Alors c'est normal qu'en tant que mère, je la supporte dans cette voie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130216,
					"content": "Ce ne sont pas du tout des petits jouets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130217,
					"content": "M—Maman... de Klee ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130218,
					"content": "Quel dommage que je ne puisse pas être là avec vous, mais je veillerai sur vous, comme toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130219,
					"content": "C'était Alice ! Comment ai-je pu me faire avoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130220,
					"content": "Hein, quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130221,
					"content": "Vous trouvez peut-être tout ça un peu bizarre. Pourquoi une mère si loin de sa maison ferait-elle autant d'effort pour créer un paradis aquatique comme celui-là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130222,
					"content": "Eh oui ! Correct, je suis déjà allée personnellement dans ces îles. Je suis totalement fan de leurs ruines anciennes et de leurs paysages uniques. J'ai tout préparé pour que vous puissiez tous venir en profiter vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130223,
					"content": "La mère de Klee est tout aussi originale que sa fille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130224,
					"content": "Héhé, est-ce que quelqu'un dit du mal de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130225,
					"content": "Hein ? N—Non ! Elle nous entend ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130226,
					"content": "Ne t'en fais pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130227,
					"content": "Qu'est-ce que vous voulez dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130228,
					"content": "La mère de Klee, Alice, est une sorcière très énigmatique et quasi-omnipotente. Ne vous inquiétez pas. Elle est juste en train de vous faire marcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130229,
					"content": "Vous deviez être curieux de savoir ce qui se cachait derrière ces lettres, les bateaux, les bouées, le bouclier d'énergie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130230,
					"content": "Mm-hmm. En fait, c'était beaucoup d'efforts, mais j'ai pensé que c'était le seul moyen de faire venir tout le monde ici, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130231,
					"content": "Les îles regorgent d'histoires en tout genre, sur les habitants d'origine, les naufrages, les machines mystiques... D'innombrables coïncidences convergent ici. Ça aurait été un tel gâchis de ne pas s'en servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130232,
					"content": "À présent, laissez-moi deviner... Tous ceux qui ont reçu une lettre devraient être présents. Kaeya, Diluc, Razor, Jean, Barbara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130233,
					"content": "#Ensuite, il y a ce bon Albedo, et puis... {M#le mystérieux voyageur}{F#la mystérieuse voyageuse} et sa bonne amie, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130234,
					"content": "Je vous ai tous invités pour accompagner Klee. Je vous remercie tous d'avoir permis à ma fille de vivre un été mémorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130235,
					"content": "Tout ce qui se trouve sur ces îles est un cadeau pour vous tous, en gage de remerciement pour avoir tenu compagnie à ma petite Klee. Mais lorsque vous entendrez cet enregistrement, je serai déjà en route pour d'autres contrées lointaines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130236,
					"content": "#La vie d'une voyageuse se vit dans une telle hâte et une telle excitation. Haha, demandez {M#au voyageur}{F#à la voyageuse} à côté de vous ce qu'{M#il}{F#elle} en pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130237,
					"content": "Alors Alice a fait tous ces efforts parce qu'elle était trop occupée pour passer du temps avec Klee ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130238,
					"content": "Non, maman est juste comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130239,
					"content": "Maintenant, si vous cherchez un sens caché à tout cela, je dois vous dire que la situation n'est pas aussi compliquée que vous pouvez le penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130240,
					"content": "La raison pour laquelle j'aime Mondstadt, c'est parce que sa liberté est exactement ce que ma fille et moi pouvions espérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130241,
					"content": "Je n'ai qu'un seul souhait : que Klee grandisse en gardant un cœur pur et un esprit ouvert. À part cela, elle peut faire ce qu'elle veut, et aller où elle le désire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130242,
					"content": "C'était donc cela. Eh bien, je dois admettre que cela correspond assez bien au style d'Alice. Toutes mes excuses pour avoir mal compris de quoi il s'agissait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130243,
					"content": "Ça doit être sympa d'avoir une maman comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130244,
					"content": "Oui ! Maman est la meilleure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130245,
					"content": "Maman, on a attrapé un poisson, on a navigué sur un bateau, on est allés nager, et on a joué à plein de choses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130246,
					"content": "Tout le monde est génial et super gentil avec moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130247,
					"content": "La prochaine fois, tu peux venir avec nous et on pourra jouer tous ensemble à nouveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130248,
					"content": "Il semble que la mère et la fille soient toutes deux des esprits libres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130249,
					"content": "Ahhh, l'été... D'ailleurs, c'était aussi l'été quand je suis venue dans ces îles. Je me suis assise au bord de la plage pour écouter les vagues rouler sur mes pieds, et j'ai pensé à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130250,
					"content": "Klee, tu es une enfant de l'été, un cadeau pour moi de la mer et du vent. Je suis tellement reconnaissante de ta naissance et je voulais t'offrir quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130251,
					"content": "Alors j'ai décoré ces îles, j'ai transformé les anciennes ruines en un parc estival et j'ai utilisé le surnom de Roi Dodo pour t'inviter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130252,
					"content": "Dans un autre monde, on raconte qu'il existe une île miraculeuse dont le nom est inspiré par les pommes dorées. Connue sous bien d'autres noms, elle donne vie aux paysages les plus fous dont un esprit humain puisse rêver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130253,
					"content": "J'adore cette histoire et je voulais que tu puisses profiter de ces merveilles, alors je t'ai offert des eaux saphir, du sable nacré, un paradis fantastique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130254,
					"content": "Pour toi et pour ceux qui t'aiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130256,
					"content": "Alors il n'y avait que trois cristaux... Rouge clair comme des pétales de fleurs, bleu clair comme les vagues de l'océan, jaune clair comme des feuilles d'automne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130257,
					"content": "Peut-être que pour Alice, cet archipel représente le quatrième cristal. Situé au milieu de la mer et couvert de végétation, c'est un véritable « cristal d'été » émeraude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130258,
					"content": "Klee, toi et moi, nous appartenons à une race bénie par la longévité. Pour nous, le temps est comme une rafale de vent : les moments vont et viennent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130259,
					"content": "Au cours d'une vie aussi longue, les parents ne sont rien d'autre qu'une première connexion. Même si nous ne voulons pas nous séparer, un jour viendra où tu devras suivre ta propre route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130260,
					"content": "Klee, je t'aimerai toujours, mais il y a aussi d'autres personnes qui sont là pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130261,
					"content": "Des amis qui t'accompagnent, des professeurs qui t'éduquent, des gens qui sont prêts à rester sur une île pour toi, aussi insolite soit-elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130262,
					"content": "L'été est pour tout le monde. Peu importe comment la vie évolue, peu importe ce qui arrive cette année, l'été sera toujours là, tout comme l'amour entre les gens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130263,
					"content": "À partir de maintenant, peu importe où tu iras, j'espère que tu n'oublieras jamais qu'il y a des gens qui t'aiment dans ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130264,
					"content": "Oh, au fait, écoute bien monsieur Albedo quand tu seras de retour à la maison. Je reviendrai régulièrement vous voir, tous les deux. D'ailleurs, dès que j'aurai un moment de libre, je reviendrai discrètement voir comment vous allez, toi et les autres. Héhé, personne n'a rien remarqué ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130265,
					"content": "Toujours la même tante Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130266,
					"content": "Vous ne pensez quand même pas qu'Albedo était au courant depuis le début, si...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130267,
					"content": "Hein ? Le temps est presque écoulé, je vais devoir m'arrêter là. Oui, oui, j'ai vraiment consacré beaucoup d'effort à cet endroit, alors profitez-en tant que vous voudrez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130268,
					"content": "Tout le monde, Klee, ma chérie, je vous dis à une prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130269,
					"content": "Au revoir, maman !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130270,
					"content": "Klee a l'air particulièrement contente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Héhé... Le Roi Dodo était en fait ma maman. Je ne sais pas pourquoi, mais ça me fait très plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130272,
					"content": "Peu importe que ma maman fasse sauter la porte de Mondstadt ou qu'elle se fasse punir, ou encore qu'elle écrive des lettres bizarres. Je l'aime toujours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130273,
					"content": "Tu ne te sens pas seule sans ta maman ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "Non. Ma maman est la plus forte. Elle peut me tenir compagnie de partout. Elle ne me laisse jamais seule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130275,
					"content": "J'aime ma maman cooooooooomme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130276,
					"content": "Et toi chevalier honoraire, tu aimes Klee ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130277,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "Moi aussi, je t'aime beaucoup ! Il faut qu'on joue ensemble ici, sinon maman sera déçue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130279,
					"content": "J'ai encore plein de bombes rebondissantes et j'ai amené Dodoco avec moi. Viens, on va aller nager et faire sauter des poissons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130280,
					"content": "On s'amuse toujours avec toi, Klee !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130281
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130281,
					"content": "Allez, venez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130282
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130282,
					"content": "Ne la faisons pas attendre. Allez, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001303,
			"completionStepIds": [
				4001310
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001310",
							"2"
						],
						"stepId": 4001310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara",
					"Jean",
					"Klee",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130301,
					"content": "Chevalier honoraire, venez voir ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130302,
					"content": "Comment ça se passe avec les poissons ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130303
					]
				},
				{
					"id": 400130303,
					"content": "Comme nous le suspections, ils ont été attirés par les cristaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130304
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130304,
					"content": "Petit, petit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130305,
					"content": "Ah ! Non, non !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130306
					],
