			"dialogs": [
				{
					"id": 746740101,
					"content": "Des sapèques anciennes... Des sapèques anciennes... Pas mal, pas mal du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740102,
					"content": "#Je vais gagner beaucoup d'argent grâce à ces sapèques anciennes. {NICKNAME} et Paimon, merci infiniment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740103
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740103,
					"content": "Qu'allez-vous faire à présent ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746740104
					]
				},
				{
					"id": 746740104,
					"content": "Eh bien... Je vais réfléchir à la façon d'échanger ces sapèques anciennes contre des moras ou des objets du quotidien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740105,
					"content": "Pour être honnête, je n'ai pas envie d'avoir affaire à l'intermédiaire d'avant, ses commissions sont à chaque fois terriblement élevées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740106,
					"content": "Et en plus, mon argent arrivait toujours tard. Je me demande ce qu'il faisait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740107,
					"content": "Mais à part lui, je ne trouve personne d'assez fiable avec qui faire des affaires, *soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740108,
					"content": "Ne parlons plus de ça ! Prenez ceci en guise de bonus pour notre coopération à long terme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740109,
					"content": "Quand mes affaires à Fontaine seront terminées, je réfléchirai à ce que je ferai ensuite. Je ne peux pas continuer à voyager comme ça, c'est bien trop fatigant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				}
			]
		}
	]
