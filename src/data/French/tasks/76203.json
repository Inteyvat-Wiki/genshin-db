						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "C'est un arbre d'Irminsul ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Oh, ce tableau ? Vous semblez connaître les arbres blancs... Mais saviez-vous que la trahison du premier ange s'est produite sous l'une de leurs branches ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "Je ne pense pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Je suis curieuse maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Hmm, dans ce cas, laissez-moi vous raconter une histoire d'amour... et d'horreur. Voyons, comment pourrais-je protéger au mieux l'identité des personnes concernées...? Voilà, j'ai trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "Il y a bien longtemps vivait un voyageur qui errait parmi les étoiles. Il n'avait rien à voir avec vous... Mais ce n'est pas important pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Un jour, il se rendit auprès d'un arbre d'argent pour rendre visite à la Princesse de l'étoile du matin. Peu de temps après, il commença à l'interroger sur les secrets les plus interdits de son royaume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Ses paroles troublèrent la princesse. Comment pouvait-il connaître toutes ces choses proscrites par les dieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "Le jeune homme lui révéla ses origines et montra à la princesse des choses qu'elle n'avait jamais vues auparavant. Le libre arbitre et l'amour, à la fois nobles et spirituels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Ses paroles éveillèrent en elle un sens de soi jusque-là entravé par les dieux. Son cœur s'éleva, au-delà de limites qu'elle n'avait jamais franchies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "La Princesse de l'étoile du matin confia les secrets du royaume au jeune homme, et entre eux, l'amour grandit et s'épanouit, tout comme la détermination de défier les dieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "C'est juste une histoire d'amour banale ! Vous aviez dit qu'il y aurait de l'horreur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Ne vous inquiétez pas, Paimon, la partie la plus sombre arrive. Ils aspiraient à aider les gens à vivre libres, sans entraves... mais les dieux ne pouvaient pardonner leur trahison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Ils firent tomber le tonnerre et la fureur, détruisant le refuge des deux amants. Et lorsque la grande guerre prit fin, la princesse perdit à jamais son pouvoir et sa sagesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "Même ses amis les plus proches furent maudits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "... Euh, oui... La fin fait plutôt froid dans le dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Mais vous avez dit que vous alliez nous parler du premier ange, non ? Vous n'êtes quand même pas en train de dire que cette histoire est vraie...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "C'est bien le cas, et c'est ça le plus effrayant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Hmm, dans ce cas, laissez-moi vous raconter une histoire d'amour... et d'horreur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Voyons, comment pourrais-je protéger au mieux l'identité des personnes concernées...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "Voilà, j'ai trouvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Ça me dit quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
