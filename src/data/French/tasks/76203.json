							-26.859
						],
						"pointId": 31
					},
					{
						"sceneId": 1156,
						"position": [
							19.488,
							0.278,
							-25.627
						],
						"pointId": 32
					},
					{
						"sceneId": 1156,
						"position": [
							21.366,
							0.278,
							-24.957
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "Oh, vous êtes là ! Je me demandais justement si je devais vous donner des indications plus claires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Mais je me suis dit que si mes indices étaient trop évidents, ça risquerait de perturber vos plans de voyage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "#Et puis, alors que je faisais les cent pas, me tourmentant sur ce que j'allais faire... vous êtes {M#apparus}{F#apparues} ici de toute façon ! On peut dire que tout s'est parfaitement déroulé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "Hé, Nicole, vous avez l'air en pleine forme aujourd'hui ! Et... vous êtes particulièrement bavarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "#Je prends ça comme un compliment ! Bien, êtes-vous {M#prêts}{F#prêtes} à aller voir la pièce suivante ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
