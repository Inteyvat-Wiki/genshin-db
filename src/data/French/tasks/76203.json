					}
				]
			},
			"dialogs": [
				{
					"id": 762030401,
					"content": "Hé, c'est Simulanka ! Euh, mais... pourquoi y a-t-il des romans légers de la Chambre Yae partout sur le sol ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Eh bien, concernant mon éveil littéraire, ma plus grande source d'inspiration... n'est autre qu'Anya elle-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "Elle fut la dernière à rejoindre l'Hexenzirkel, et pourtant la première à le quitter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "J'adorais toutes ses histoires. Qu'il s'agisse d'une simple idée ou d'un manuscrit entièrement abouti, Anya avait toujours ce talent pour surprendre ses lecteurs avec bonheur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Les discussions de l'Hexenzirkel s'éloignent rarement de la magie, et je crois qu'Anya possédait une magie qui lui était propre. Elle savait tisser l'amour ainsi que la compassion dans des mots et des histoires qui touchaient le cœur des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Je lui ai demandé des conseils pour écrire des histoires captivantes. Elle m'a appris beaucoup d'astuces et de techniques. Mais au final, mon plus grand ennemi a toujours été moi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Trop paresseuse pour prendre la plume ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Ah ! C'est une façon de voir les choses. Communiquer par la pensée, c'est tellement plus pratique. Même les anges peuvent céder à la paresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Mais récemment, j'ai décidé de faire un effort, ne serait-ce que pour éviter de me faire réprimander par une certaine amie Fée de longue date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Oh ! Ça veut dire qu'on va enfin pouvoir lire quelque chose que vous avez écrit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Qui a parlé d'écrire ? Je parle d'acheter des œuvres populaires des derniers siècles pour les feuilleter pendant mon temps libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Haha ! C'est une façon de voir les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Communiquer directement par la pensée, c'est tellement plus pratique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "Même les anges peuvent céder à la paresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
