				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "#Q—Quoi ?! J'ai failli avoir une crise cardiaque en étant aspirée dans un tableau comme ça{NON_BREAK_SPACE}! ... Attendez une seconde, cet endroit me dit quelque chose... Oh, c'est la table où les sorcières organisent leurs goûterons{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Tout a commencé la première fois qu'Alice m'a invitée à prendre le thé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "Ce jour-là, je n'étais pas présente en personne. Principalement parce qu'à l'époque, je n'avais pas encore décidé si je voulais vraiment rejoindre l'Hexenzirkel ou non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Alice était la seule présente à connaître ma véritable identité. Elle m'a prévenue de ne pas dire un mot, ni de laisser quiconque découvrir qui j'étais. J'étais seulement censée observer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "... Et ensuite, que s'est-il passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Eh bien... Ensuite, j'en ai conclu qu'elle me punissait pour mon hésitation à les rejoindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Tout le monde parlait de choses tellement intéressantes, comment aurais-je pu rester silencieuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Et bien sûr, quand on est en pleine conversation et que quelqu'un pose une question dont on connaît la réponse, comment voulez-vous rester sans rien dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Ce qui nous amène au pari entre Barbeloth et Alice, aux créations interdites de Rhinedottir, aux machinations politiques d'Ivanovna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "C'était comme une succession de scènes finement jouées, concentrées dans une simple tasse de thé. Leurs paroles seules suffisaient à éveiller en moi l'envie de révéler la vérité devant elles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Alors, vous avez parlé dans leurs esprits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Bien sûr que non ! Même si j'avais l'impression que ma tête allait exploser, j'ai quand même veillé à tout garder pour moi. Je suis un ange responsable, après tout, et je sais parfaitement faire la différence entre « ce que je veux dire » et « ce que j'ai le droit de dire ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Alors j'ai eu une petite conversation privée avec Alice dans sa tête. Juste elle et moi. Et j'ai accepté de rejoindre l'Hexenzirkel, séance tenante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Elle était très contente de ma décision, mais en ce qui concerne la conversation dans sa tête... Eh bien, elle prétend que dans les jours qui ont suivi, elle a eu de tels maux de tête qu'elle a dû aller consulter un médecin à Liyue. Mais elle ne peut quand même pas m'en tenir responsable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620303,
