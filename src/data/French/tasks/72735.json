				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Qui d'entre vous est le chef ? Qu'il m'affronte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Grand chariot Sennichi"
				},
				{
					"id": 727350102,
					"content": "Je suis le Grand chariot Sennichi, l'élite de l'élite. Le Grand Maître Hanakado a demandé la tête du chef du gang Arataki et je vais la lui livrer sur un plateau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Grand chariot Sennichi"
				},
				{
					"id": 727350103,
					"content": "Hé, mais il est violent ! Cette fois-ci, l'adversaire a l'air coriace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "T'as fini, oui ? Et c'est quoi ce nom de guignol ? N'essaye même pas de me voler la vedette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Je vais te faire descendre de ton piédestal, moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "Quelle grande perche ! Et t'es... un Oni !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Grand chariot Sennichi"
				},
				{
					"id": 727350107,
					"content": "T'as une tête à me manger au petit déjeuner ! ... Pourquoi un gars comme toi joue aux combats de scarabées au juste ? C'est un jeu pour enfants... Bon sang, dans quoi je me suis fourré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Grand chariot Sennichi"
				},
				{
					"id": 727350108,
					"content": "Quoi ? Un jeu pour enfants ? Tu n'as pas osé ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Tu ne connais rien aux combats de scarabées, mon gars. En tant que ton aîné dans le domaine, je vais devoir te corriger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "Donne-lui une bonne leçon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Ouais ! Vas-y, vacheron ! Remets-le à sa place !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Je n'ai pas le choix, on dirait... Viens donc !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grand chariot Sennichi"
				},
				{
					"id": 727350111,
					"content": "Baston ! Baston !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}