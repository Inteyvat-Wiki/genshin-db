					"id": 740851904,
					"content": "Magnifique ! C'est son apparence originale ? Si Pahsiv voyait ça, elle serait sûrement très ravie, tu ne penses pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851905,
					"content": "#Paimon ! Pahsiv ! {NICKNAME} ! Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851906,
					"content": "#Pahsiv ? C'est génial de te revoir ! Où étais-tu donc ? Nous étions {M#inquiets}{F#inquiètes} pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851907,
					"content": "Sans trace, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851908
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851908,
					"content": "Ah. Coffre, Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851909
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851909,
					"content": "Hé ? C'est... un coffre ? Tu cherchais des coffres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851910,
					"content": "Pahsiv ! Mais brillant, doré et rond, mélusine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851911
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851911,
					"content": "#Tu ne trouves pas de moras ? Ce n'est pas grave ! Ces coffres sont suffisants{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851912,
					"content": "Je suis touchée que tu te souviennes de ce que j'ai dit. Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851913,
					"content": "Mer... ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851916
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851916,
					"content": "Ça veut dire « Pahsiv » !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851917
					]
				},
				{
					"id": 740851917,
					"content": "#Paimon, merci ! {NICKNAME}, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851918
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851918,
					"content": "#Paimon, gentille ! {NICKNAME}, {M#gentil}{F#gentille} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851919
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851919,
					"content": "Pahsiv ! Gentille !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851920
					]
				},
				{
					"id": 740851920,
					"content": "Pahsiv ! Gentille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851921,
					"content": "#{NICKNAME}, pourquoi ne pas venir jouer plus souvent avec Pahsiv quand on aura le temps plus tard ? Et lui apprendre à parler davantage, comme Lavalette l'a fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851922,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851923
					]
				},
				{
					"id": 740851923,
					"content": "Alors qu'en dis-tu, Pahsiv ? Nous reviendrons jouer avec toi plus tard, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851924,
					"content": "Elle a encore disparu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851925,
					"content": "Pahsiv, sans trace ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "Incroyable ! Je n'ai jamais vu une mélusine comme elle avant... Enfin, elle ne se comporte pas comme une mélusine, mais plutôt comme un mystérieux esprit de la nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851927,
					"content": "Mais c'est peut-être pour ça qu'elle a pu garder un œil sur le méchant truc violet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851928,
					"content": "Hé ! Pahsiv ! À plus tard ! Si nous nous revoyons, nous t'apprendrons à dire au revoir correctement !",
