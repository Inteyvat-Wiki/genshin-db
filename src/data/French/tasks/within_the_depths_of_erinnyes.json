					"nextDialogs": [
						740850242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850242,
					"content": "On dirait que le truc violet est vraiment difficile à contrer. Si les racines sont endommagées, le système d'information ne pourra plus fonctionner et affectera les capacités de perception de Lavalette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850243,
					"content": "Pahsiv, responsable ! Pahsiv, protéger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}, bang bang. Paimon, bang bang.",
