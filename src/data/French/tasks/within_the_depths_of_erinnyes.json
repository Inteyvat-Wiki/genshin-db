						740850239
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850239,
					"content": "Truc violet se faufile, vers racines. Truc violet, très beaucoup fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "Pahsiv"
				},
