					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851703,
					"content": "Mes mains sont juste un peu fatiguées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851718
					]
				}
			]
