			"dialogs": [
				{
					"id": 740851701,
					"content": "#Pfiou ! C'est résolu. Nous avons vraiment énervé les Limiers de faille. {NICKNAME}, tu vas bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
