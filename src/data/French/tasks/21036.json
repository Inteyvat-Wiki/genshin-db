			"dialogs": [
				{
					"id": 210360801,
					"content": "*halète* ... Comment... Comment faites-vous pour courir aussi vite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360802,
						210360804
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360802,
					"content": "C'est vous qui êtes trop lent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "J'admets ma défaite... Je déclare forfait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360806,
					"content": "Ouf... Je peux enfin reprendre mon souffle. Je ne m'attendais pas à ce que le parcours en nature soit aussi éprouvant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360807,
					"content": "#Merci pour cette démonstration, {M#voyageur}{F#voyageuse}. Tenez, acceptez ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360804,
					"content": "Vous avez besoin de vous entraîner davantage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "Vous... avez... raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
