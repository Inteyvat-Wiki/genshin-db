				"points": []
			},
			"dialogs": [
				{
					"id": 210360201,
					"content": "Le combat contre des monstres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Parfait ! Ça fait longtemps que je souhaite mettre en pratique les techniques d'épées que j'ai apprises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "J'ai peur que vous n'arriviez pas à suivre mes mouvements.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "Comment... Êtes-vous vraiment capable de telles prouesses martiales ? Hahaha, dans ce cas, je vous demanderais de ralentir légèrement vos mouvements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Voyons voir... Il y a un endroit pas loin d'ici où des monstres ont l'habitude de se rassembler. Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103603,
