					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "Ouf... C'était laborieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Désolé, j'ai vraiment l'air ridicule. On dirait bien que je n'ai pas beaucoup progressé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "#Il faut que je m'entraîne davantage. Merci, {M#voyageur}{F#voyageuse}. Tenez, je vous donne ceci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "Par quel moyen avez-vous l'intention de quitter Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Hum... Mon plan est de monter à bord d'un bateau marchand et de voyager par les eaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "Pour ma première étape... Je voudrais me rendre à Fontaine. Je vais sans doute rester là-bas un moment avant de réfléchir à la suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "*soupir* Je ne sais pas si j'arriverai à convaincre Que'er de me suivre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
