			"dialogs": [
				{
					"id": 210360701,
					"content": "Ouf... C'était laborieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360702
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360702,
					"content": "Désolé, je me suis encore ridiculisé. Je ne pensais pas être aussi tendu face à de vrais monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360703,
					"content": "#Inutile de dire que j'ai encore besoin de m'entraîner. Quoi qu'il en soit, merci, {M#voyageur}{F#voyageuse}. Veuillez accepter cette récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360704,
					"content": "Vous allez vraiment partir de Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "Je n'ai pas encore totalement décidé. Je dois encore y réfléchir... Et au passage, réessayer de convaincre Que'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
