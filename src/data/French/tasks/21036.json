					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "#{M#Voyageur}{F#Voyageuse}, on se retrouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "#Vous êtes en train de vous entraîner{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Oui, seulement... Je dois avouer que je peine un peu. J'ignore si c'est moi qui manque de talent, ou si je me trompe de méthode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Ne parlons plus de cela. La dernière fois qu'on a fait route commune, j'ai été grandement inspiré par vos techniques et vos mouvements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, entraînez-vous encore une fois avec moi aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "C'est comme la fois précédente. Vous préférez le combat contre des monstres ou le parcours en nature ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Que'er vous ignore-t-elle toujours ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Eh bien... Elle m'a dit qu'elle avait des choses à faire en ville ces temps-ci, et elle n'est jamais revenue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Je suis allé la voir plusieurs fois, mais à chaque fois, elle envoie Zhiruo pour me faire partir. Elle refuse toujours de me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*soupir* Je ne sais vraiment pas quoi lui dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
