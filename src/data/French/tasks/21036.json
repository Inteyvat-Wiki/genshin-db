			"dialogs": [
				{
					"id": 210360901,
					"content": "Le parcours en nature.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "Merveilleux, continuons à nous entraîner là où nous le faisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360903,
					"content": "L'aventurière m'a dit d'atteindre l'arrivée le plus vite possible... Mais je suis trop lent chaque fois que je m'y essaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360904,
					"content": "Pourriez-vous me montrer comment réussir ce parcours rapidement ? Je ferai de mon mieux pour vous suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360905,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "Alors, je vous laisse faire. Allons au point de départ, si vous le voulez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360906,
					"content": "Ne vous laissez pas distancer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "Hum... J—Je vais faire ce que je peux. Mais pour être honnête, je ne suis pas un excellent coureur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
