				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "Le parcours en nature.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Merveilleux, l'aventurière nous a préparé un parcours pour nous entraîner... *soupir* C'est aussi grâce à elle que je peux venir ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Elle m'a dit d'atteindre l'arrivée le plus vite possible... Mais je suis trop lent chaque fois que je m'y essaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Pourriez-vous me montrer comment réussir ce parcours rapidement ? Je ferai de mon mieux pour vous suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "D'accord, pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Alors, je vous laisse faire. Allons au point de départ, si vous le voulez bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Ne vous laissez pas distancer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "Hum... J—Je vais faire ce que je peux. Mais pour être honnête, je ne suis pas un excellent coureur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
