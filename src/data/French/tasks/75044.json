			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "« ... Que la gloire éternelle soit... médiateur... le bienveillant... Och-Kan... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "« ... Les artisans Mahutzintl, Tlanalco, et... les responsables de la construction de la pompe à eau... délibérément ralenti, entraînant des retards... Le bienveillant... n'a imposé aucune punition... seulement suspendu les rations pendant trois semaines... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
