			"dialogs": [
				{
					"id": 750443601,
					"content": "(Un roman d'amour écrit par Dorothy Leeckson. Sur la couverture délavée, une femme est allongée sur un lit entouré de fleurs.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "« Fleur de lavande »"
				},
				{
					"id": 750443602,
					"content": "(Après l'avoir feuilleté, le livre vous met le baume au cœur, mais il ne vous a rien appris d'utile.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "« Fleur de lavande »"
				},
				{
					"id": 750443603,
					"content": "Du coup... C'était le jardinier de sa famille ou le beau-frère de la cousine de sa meilleure amie ? Rah, j'ai mal à la tête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
