		{
			"id": 7504407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Le Saurien en essor est ouvert toute la journée ! Si vous souhaitez rejoindre la formation spéciale de Matahga, venez prendre votre envol ! Important :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Slogan accrocheur"
				},
				{
					"id": 750440702,
					"content": "Tout comme une formation sérieuse et proactive est un motif de grande fierté, la paresse et le relâchement sont une source de honte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Slogan accrocheur"
				},
				{
					"id": 750440703,
					"content": "Si nous ne travaillons pas dur aujourd'hui, nous ne vaudrons rien demain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Slogan accrocheur"
				},
				{
					"id": 750440704,
					"content": "Seuls ceux qui avancent courageusement connaîtront vraiment la grandeur en tant que chevaucheurs de sauriens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Slogan accrocheur"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "L'ordre est le suivant : souffle d'abord dans le cor de gauche, puis dans celui de droite, et encore une fois dans celui de gauche, et enfin celui de droite ! Ne te trompe pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga ! N'oublie pas !"
				},
				{
					"id": 750440802,
					"content": "Nourrir un saurien avec de la volaille est le meilleur moyen de le garder de bonne humeur et d'éviter qu'il nous donne des coups de bec !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga ! N'oublie pas !"
				},
				{
					"id": 750440803,
					"content": "(On dirait un rappel qu'un certain Matahga s'est laissé à lui-même. On peut vraiment ressentir l'intensité de l'émotion dans ses mots.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga ! N'oublie pas !"
				},
				{
					"id": 750440804,
					"content": "(Mais mettre des points d'exclamation à la fin de chaque rappel équivaut sûrement à n'en mettre aucun... Non ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga ! N'oublie pas !"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "« ... Sur ordre du gardien du{RUBY#[D]Yajaw K'ahk'} sanctifeu et du bienveillant et glorieux saint so{RUBY#[D]Ti'sakhuun}uverain, Sa Ma{RUBY#[D]Kalomte}jesté Och-Kan, de la main-d'œuvre est désormais recrutée dans toutes les tribus pour la construction d'infrastructures de conservation d'eau... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "« ... Pas de quotas fixes, ouvert à tous les volontaires... Construire l'alliance... Nous espérons que toutes les tribus y répondront activement... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "« Sur ordre du gardien du{RUBY#[D]Yajaw K'ahk'} sanctifeu et du bienveillant et glorieux saint so{RUBY#[D]Ti'sakhuun}uverain, Sa Ma{RUBY#[D]Kalomte}jesté Och-Kan, la terre maudite est scellée par ce décret, avec effet immédiat. Il est strictement interdit à tous les membres de l'alliance d'y pénétrer. »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "« Tous ceux qui entreront sans autorisation seront officiellement reconnus comme ennemis de l'alliance. Ceci est une déclaration conjointe de (...) des Nanatzcayens, des Meztlis, des Huitztlans et des Teteocans. »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "« Gloire à jamais au gardien du{RUBY#[D]Yajaw K'ahk'} sanctifeu, le grand m{RUBY#[D]Q'atal Tzij}édiateur, le bienveillant saint so{RUBY#[D]Ti'sakhuun}uverain Och-Kan. »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "« Compte tenu de la lenteur générale des travaux de drainage dans cette zone, des ajustements mineurs sont apportés au système de rotation pour assurer la victoire de l'alliance. »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "« Les travailleurs seront répartis en trois équipes. Chaque équipe travaillera seize heures, avec une rotation tous les deux jours. Les équipes ayant réalisé des performances exceptionnelles recevront des provisions de céréales supplémentaires. »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "« La réussite de <color=#00E1FFFF>l'évacuation de l'eau accumulée</color> est proche. Une fois les fossés drainés, la <color=#00E1FFFF>pompe à eau</color> pourra fonctionner normalement. Encore un effort ! »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
