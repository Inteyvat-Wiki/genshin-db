			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "« ... Il y a un petit chemin derrière un mur de pierre au nord qui mène au sommet de la cascade. Il peut servir de <color=#00E1FFFF>zone de stockage</color>... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "« ... J'ai laissé quelques traces, juste au cas où j'oublie le chemin plus tard... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "« ... Les blessures de Sayani se sont aggravées. C'est la faute de l'humidité... Je lui ai dit de se reposer, mais elle a refusé en riant... et a prétexté que cela ralentirait l'escouade et empêcherait les gens d'obtenir des provisions supplémentaires... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "« ... Une fois la nuit tombée, je me suis approché furtivement d'elle avec une torche pour cautériser sa blessure pendant que les autres ne regardaient pas, sinon ses membres pourriraient aussi... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
