			"dialogs": [
				{
					"id": 750444701,
					"content": "(Des écritures d'enfant et des gribouillages sont visibles :)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Notes d'enfant"
				},
				{
					"id": 750444702,
					"content": "Ce jeu s'appelle « Toc-o-toc'toc ». Voici les règles :",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Notes d'enfant"
				},
				{
					"id": 750444703,
					"content": "1. Lorsque le monetoo toc-toc ne fait pas de « toc-toc », montez sur le dos de la statue de saurien pour la faire avancer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Notes d'enfant"
				},
				{
					"id": 750444704,
					"content": "2. Descendez de la statue de saurien lorsque le monetoo toc-toc compte jusqu'à faire « Toc ! », sinon vous perdrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Notes d'enfant"
				},
				{
					"id": 750444705,
					"content": "3. Le premier à courir vers le monetoo toc-toc gagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Notes d'enfant"
				},
				{
					"id": 750444706,
					"content": "Et ne me dites pas : « C'est comme 1, 2, 3, soleil ! ». Les règles sont importantes, et c'est parce que vous ne les respectez pas que vous ne gagnez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes d'enfant"
				}
			]
		}
