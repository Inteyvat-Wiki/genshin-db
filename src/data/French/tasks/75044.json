					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "« ... Compatriotes, famille, frères et sœurs qui avez contribué au triomphe inéluctable de l'alliance... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "« ... Le bienveillant... a envoyé un lot de nouveaux mécanismes de (...) pour aider le transport (...) et la <color=#00E1FFFF>récupération sous-marine</color>... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "« ... Avancez ! Continuez d'avancer ! Avancez à tout prix... Pour l'avenir glorieux de l'alliance, pour notre liberté et notre gloire, pour une patrie libérée de l'oppression des dragons maléfiques... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "« ... Sans autorisation... interdit d'actionner le <color=#00E1FFFF>levier de commande</color>... Des chutes accidentelles... ont déjà causé la mort de trois travailleurs... »",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
