					"nextDialogs": [
						750443702
					],
					"speakerTitle": "« Détective Patteneige »"
				},
				{
					"id": 750443702,
					"content": "(Une grosse empreinte de patte de chat est imprimée sur la page de titre de ce livre. C'est peut-être un souvenir spécial que l'inspecteur a laissé à ses subordonnés ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "« Détective Patteneige »"
				},
				{
					"id": 750443703,
					"content": "Sérieusement... On pourrait aussi écrire un livre sur moi. Il s'appellerait... « La détective à la chevelure blanche » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
