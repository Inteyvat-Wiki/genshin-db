			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "On dirait... que c'est pour Acat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110202,
					"content": "... Le paquet est cassé. Si nous le renvoyons tel quel, l'ensemble de l'article pourrait être endommagé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110203,
					"content": "Je dois encore trier les colis express dans la boutique, alors pourriez-vous m'aider à lui envoyer ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110204,
					"content": "C'est la propriétaire de la Palette de Frida. Ne vous inquiétez pas, vous ne pourriez pas manquer l'enseigne de sa boutique même si vous essayiez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
							"2"
						],
						"stepId": 7511103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Ça... ressemble à l'écriture de Chanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "Si je devais deviner, ce doit être une autre facture pour une commande. Mais l'emballage est cassé, nous ne pouvons pas la livrer comme ça. Cette lettre va devoir être renvoyée à l'expéditeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "Je dois encore trier les colis express dans la boutique, alors pourriez-vous m'aider à renvoyer ceci à Chanca ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "Elle devrait être à l'Auberge Au repos près du Stade du sanctifeu. Vous ne pouvez pas le manquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
