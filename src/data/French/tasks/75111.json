			},
			"dialogs": [
				{
					"id": 751111401,
					"content": "Oui, celui-ci est à moi. Un membre des Enfants des échos voulait acheter de la peinture, mais il était parfaitement incapable me dire ce qu'il voulait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "C'est pourquoi je lui ai envoyé un colis contenant plusieurs petites bouteilles de peinture, afin qu'il puisse connaître ses préférences avant sa prochaine visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Il faut que je renvoie ces échantillons au plus vite, avant qu'il ne revienne avec des références ridicules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Ah oui, voici votre récompense. Merci de m'avoir ramené le colis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
