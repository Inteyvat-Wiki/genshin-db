				"points": []
			},
			"dialogs": [
				{
					"id": 751110501,
					"content": "... Cette lettre vient de Tirda, si je ne me trompe pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Essayait-elle de la faire envoyer à sa tribu ? Mais elle est tout abîmée maintenant... Il va falloir la renvoyer à son expéditrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "Je dois encore trier les colis express dans la boutique, alors pourriez-vous m'aider à rapporter ceci à Tirda ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "Elle chante au Crépuscule doré, vous n'aurez aucun mal à la trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
