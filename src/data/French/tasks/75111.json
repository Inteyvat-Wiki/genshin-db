			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "La Gemmeterie de Muhuru... Imix ? Oh, c'est une facture qu'elle a envoyée, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110402,
					"content": "Si ce colis venait à disparaître, cet enfant va avoir droit à un sermon de mademoiselle Cheven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110403,
					"content": "Je dois encore trier les colis express dans la boutique, alors pourriez-vous m'aider à renvoyer ça à Imix ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110404,
					"content": "La Gemmeterie de Muhuru se trouve sur le territoire des Enfants des échos, elle est très facile à trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511105,
			"completionStepIds": [
				7511105
			],
