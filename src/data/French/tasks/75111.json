			"dialogs": [
				{
					"id": 751110101,
					"content": "J'ai ramassé ça plus tôt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "Ah bon ? Est-ce que quelqu'un l'a encore perdu ? Laissez-moi voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
