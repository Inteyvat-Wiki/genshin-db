					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320906,
					"content": "Pour moi aussi, je ne m'attendais pas à ce que vous nous fassiez monter sur une étoile filante.",
