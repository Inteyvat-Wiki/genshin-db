					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320908,
					"content": "Yoimiya, vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "Vous saviez déjà que c'était un rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "Vous me connaissez. Il m'importe peu de savoir si c'était réel ou s'il s'agissait d'un rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320911,
					"content": "#Je devrais vraiment vous remercier {M#tous}{F#toutes} les deux. Vous avez préparé ça comme plan de secours, car vous saviez que les pluies de météores étaient difficiles à trouver, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320912,
					"content": "Ne vous inquiétez pas, j'ai adoré ! Je pense que c'est le meilleur cadeau que j'aie jamais reçu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320913,
					"content": "Oh, ouf ! J'avais peur que vous soyez fâchée en apprenant la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320914,
					"content": "Pourquoi serais-je fâchée ? J'ai rêvé d'un aranara serviable, amical et adorable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320915,
					"content": "J'ai aussi rêvé qu'on courait et sautait sur de gros champignons, et on a trouvé l'uroc de manière très inattendue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320916,
					"content": "Et quand j'ai cru qu'on s'était réveillé, la suite était encore plus incroyable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320917,
					"content": "Avin a fait apparaître une lentille d'uroc. Nous avons vu des météores décoller du sol, et nous avons même fait un tour en étoile filante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320918,
					"content": "Nous étions dans un rêve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "#Comment savoir si nous nous sommes {M#réveillés}{F#réveillées} ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "C'est vrai. Les rêves eux-mêmes peuvent être imaginaires. Mais ce sont aussi des expériences qui ne peuvent jamais être revécues ni reproduites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320921,
					"content": "Si nous étions plus terre-à-terre, nous aurions raté tant de beauté et d'émotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320922,
					"content": "Haha, vous savez vraiment y faire avec les mots ! Vous venez de gagner quelques places dans le classement de mes meilleurs amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320923,
					"content": "Il y a donc un classement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "En parlant d'aranaras, ils n'aiment généralement pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320925,
					"content": "Oh oui, ils sont si mignons ! Nous devons vraiment remercier ces belles figurines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320926,
					"content": "Les figurines en bois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320927,
					"content": "Oui, si nous n'avions pas vu ces belles figurines, nous n'aurions pas pu rêver d'un aranara aussi mignon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320928,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320929,
					"content": "Yoimiya nous a compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "Je les trouve aussi plus mignons que les figurines.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "Haha ! Ne vous inquiétez pas, j'ai bien compris. Je les trouve très mignons et je suis heureuse de les protéger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320932,
					"content": "Bon, c'est presque l'heure, il est temps de la ramener chez elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321101,
					"content": "Après avoir ramené Avin à la maison, vous passez encore quelques jours à Sumeru avec Yoimiya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
		{
			"id": 1303211,
			"completionStepIds": [
				1303211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303211",
