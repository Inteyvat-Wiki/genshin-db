			"dialogs": [
				{
					"id": 130320601,
					"content": "Le... Le rêve est terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320602,
					"content": "Nous avons fait un rêve magnifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "Ne sois pas triste, il est juste à côté de toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "Arashani ! Tu... Tu es toujours là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320605,
					"content": "Je voudrais m'excuser. Ce n'est pas que je ne voulais pas te retrouver, mais je ne me souvenais pas de l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Je n'ose pas entrer dans la ville. Comme tu n'es pas venue, j'ai pensé que tu t'étais fait de nouveaux amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "C'est tout à fait normal et inévitable. Il faut simplement l'accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "Ce n'est pas grave, je comprends. C'est arrivé, car je n'étais pas arrivée à me ressaisir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320609,
					"content": "Mais je pense que je comprends maintenant. Yoimiya a raison. Tout le monde connaît un peu de malchance, mais nous devons nous soutenir dans ces moments-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320610,
					"content": "Merci à tous de m'avoir aidée à retrouver mes souvenirs et mes rêves, ce ne sera pas en vain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320611,
					"content": "#Haha. Tu nous as beaucoup {M#aidés}{F#aidées} aussi, ce n'est pas la peine de faire tant de manières. Pour être honnête, nous ne savions pas par où commencer avec l'uroc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "Mais maintenant qu'on est sur cette piste, on devrait en trouver facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Yoimiya, tu as besoin de l'uroc pour assister à une pluie de météores, c'est bien ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320614,
					"content": "Oui, une fois que nous l'aurons trouvée, tu devrais venir avec nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "Si c'est comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320616,
					"content": "Je serais heureuse de te prêter mon uroc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320617,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "Qu... Qu'est-ce qui vient de se passer ? Viens-tu de sortir une lentille de ta poitrine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "Je n'en ai aucune idée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "#Haha. Comment savais-tu qu'on en avait besoin{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "Je ne savais pas. Je me suis simplement dit que puisque vous m'aviez aidée à retrouver mon précieux ami, je devrais vous rendre la pareille avec quelque chose qui m'est précieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320623,
					"content": "Et puis voilà. C'est ce dont vous aviez besoin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320624,
					"content": "Merci. Je ne m'attendais pas à ce qu'on résolve notre problème de cette façon. Bon, c'est le moment d'essayer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "Non pas que je sache comment m'en servir, mais voyons ce que me dit mon intuition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "Où es-tu... Où es-tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "Oh, je crois que j'ai trouvé ! Ce n'était pas si compliqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "Allez, je vais faire le guide. Une fois que nous aurons assisté à la pluie de météores, je te ramènerai chez toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "#Merci de nous avoir {M#aidés}{F#aidées}. En réalité, oublions les formalités et laissez-moi plutôt vous faire un compliment sincère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "#Vous êtes vraiment tous des conteurs hors pair{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Oh, quelle coïncidence. Je dirais exactement la même chose que toi, nara rouge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
