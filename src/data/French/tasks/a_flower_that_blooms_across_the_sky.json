			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "*halète* ... Tu es rapide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Haha, encore un peu, et tu me rattrapais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "Avin était au coude-à-coude avec Yoimiya !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "J'ai battu de nombreux adultes auparavant. Il ne suffit pas d'avoir de longues jambes pour courir vite. L'entraînement est primordial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Haha, dans quelques années, je ne pourrai plus rivaliser avec toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Hmm, voyons voir... Où devrions-nous aller maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Oh, regarde ! Il y a quelque chose qui flotte devant nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "Ça ressemble à une... étoile ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Peut-être qu'elle veut qu'on la suive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320210,
					"content": "Peut-être, oui. Suivons-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1303205,
			"completionStepIds": [
				1303205,
				1303214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303205",
							"2"
						],
						"stepId": 1303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avin",
					"Yoimiya",
					"Arashani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "C'est donc notre destination ? Mais je ne vois pas d'aranara, juste cette grosse pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320502,
					"content": "Je suis tellement heureuse... J'avais presque oublié ce que ça fait d'être aussi heureuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320503,
					"content": "Vous savez, quand je ne peux pas courir, j'ai l'impression que mon monde est réduit à un espace minuscule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320504,
					"content": "Mais tant que je peux courir, mon monde continuera de s'étendre devant mes yeux et je pourrai toujours voir de nouvelles choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320505,
					"content": "Même si je ne sais pas vraiment ce qui s'est passé, je sais que c'est uniquement grâce à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320506,
					"content": "Oh, ce n'est pas important. Ce qui compte, c'est que tu te sois souvenue de nombreuses choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320507,
					"content": "Nos souvenirs ne symbolisent pas seulement notre passé, ils peuvent également éclairer la voie de notre avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320508,
					"content": "Ce bonheur reviendra, une fois que tu seras guérie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320509,
					"content": "Merci Yoimiya, merci à tout le monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320510,
					"content": "Continuons de chercher, on dirait qu'Arashani n'est pas ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320511,
					"content": "#Mais pourquoi alors l'étoile nous aurait {M#conduits}{F#conduites} ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320512,
					"content": "Cette pierre sort vraiment de l'ordinaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "Je ne sais pas comment l'expliquer... Je ne sais pas ce que c'est, mais elle me semble familière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320514,
					"content": "Presque comme si c'était une partie de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320515,
					"content": "Je sais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320516,
					"content": "Cette pierre pourrait-elle être ton uroc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320517,
					"content": "Mon u—uroc ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320518,
					"content": "(Yomiya est vraiment douée pour improviser.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(J'avais presque oublié.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "C'est un minerai très rare qui symbolise les rêves et les aspirations d'une personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320521,
					"content": "Puisque tu peux la voir, cela signifie que tu as trouvé ce que tu avais perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320522,
					"content": "C'est comme ça que cela fonctionne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320523,
					"content": "C'est comme dans les contes de fées... Je pensais que j'avais arrêté d'y croire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320524,
					"content": "Mais je suis très heureuse d'avoir retrouvé cette croyance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320525,
					"content": "Eh ? Elle est passée à travers !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320526,
					"content": "Allons-y aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320527,
					"content": "#Hé, Yoimiya ! Bon, je pense que nous n'avons pas le choix, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320528,
					"content": "#Nous sommes {M#passés}{F#passées}, mais rien ne semble avoir changé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320529,
					"content": "Ça fait longtemps, nara Avin... Vraiment longtemps, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320530,
					"content": "Arashani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320531,
					"content": "Pourquoi as-tu l'air si triste ? Oh, je sais. Tu es heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320532,
					"content": "Arashani ! *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320533,
					"content": "Haha. Les aranaras ont vraiment le chic pour les aventures magiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320534,
					"content": "Ils ont non seulement aidé Avin à retrouver son meilleur ami, mais ils nous ont également montré un uroc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320535,
					"content": "Nous devrons trouver le nôtre plus tard afin de fabriquer l'objectif le plus pur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320536,
					"content": "Je ne sais pas pourquoi, mais je pense que nous pouvons y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320537,
					"content": "Quelle aventure !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "Et c'était amusant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "Mais nous devons la ramener à Sumeru, sa mère doit être morte d'inquiétude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320540,
					"content": "La scène qui se dévoile devant vous s'apparente à un rêve. Avant même de vous en rendre compte, vous êtes de retour là où vous étiez.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
