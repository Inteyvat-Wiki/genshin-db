			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya",
					"Niousha",
					"Avin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru est un endroit tellement agréable, je reviendrai à coup sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "Vous serez toujours la bienvenue ici, Avin serait très heureuse de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "Marché conclu, je t'attendrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321108,
					"content": "Haha ! OK, marché conclu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Yoimiya, avant que tu ne partes, je voudrais te parler de mon nouveau rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "J'aimerais voyager seule à Inazuma pour assister à un feu d'artifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Waouh... OK ! Haha, je ne m'attendais pas à trouver de nouveaux clients pendant mes vacances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Pas de soucis, je te préparerai des feux d'artifice que tu n'oublieras jamais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "#Cela s'applique aussi à vous deux. Même si vos aventures vous prennent beaucoup de temps, n'oubliez pas de revenir à Inazuma. Vous serez toujours les {M#bienvenus}{F#bienvenues}, quel que soit le moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "Il faudra absolument venir voir les feux d'artifice que cette pluie de météores a inspirés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "Marché conclu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Prenez soin de vous, Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "#Je n'y manquerai pas. Haha, vous êtes toujours aussi {M#sérieux}{F#sérieuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "Ah, au fait, regardez ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "Une figurine d'aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "En effet. C'est celle que vous m'aviez aidée à choisir, et qui selon vous me ressemblait un peu. Je suis allée en acheter une autre, et celle-ci est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Regardez-la à chaque fois que vous n'avez pas trop le moral. Qui sait, cela vous redonnera peut-être le sourire ? Du moins, vous saurez que je vous soutiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Bien sûr, j'aimerais mieux vous voir en personne. Haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Bon, il est temps de rentrer. Je suis sûre que nous nous reverrons bientôt !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321130,
					"content": "J'ai vraiment adoré le voyage que vous m'avez préparé. En fait, je suis même époustouflée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321131,
					"content": "Où que vous alliez ensemble, je sais que notre amitié et sa force vous soutiendront.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321132,
					"content": "Alors continuez d'avancer, jusqu'à la fin de vos aventures, jusqu'au bout du monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321133,
					"content": "À la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321128,
					"content": "Je la garderai précieusement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "Que vos journées soient remplies de bonheur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "Chaque jour, et pour toujours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321120,
					"content": "Les feux d'artifice sont éphémères, mais l'amitié est éternelle !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "Mais pourquoi vous criez ça tout d'un coup ? C'est gênant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}