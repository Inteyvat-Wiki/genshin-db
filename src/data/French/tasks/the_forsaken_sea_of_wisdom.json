			"dialogs": [
				{
					"id": 751750101,
					"content": "Alors que vous vous plongez dans le phlogistique liquide, des images traversent votre esprit comme des souvenirs chaleureux.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Au bord de ce bassin incandescent, deux ombres blanc argenté couvertes de cendres ont la conversation suivante...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "« ... La deuxième phase de vérification expérimentale est terminée. Je nomme la clé de la purification et de l'évolution Huitzilopochtli, ou la vague de feu céleste... »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "« Ça n'a plus d'importance, les noms finissent toujours par perdre leur sens ici. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "« Les assemblages astraux doivent être activés et équipés comme mesure d'anti-contamination pour se débarrasser de l'Abîme en s'autodétruisant avant qu'il ne prenne tout le contrôle... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750106,
					"content": "Mais comment identifier avec précision les sujets concernés ? Un échantillon contrôlable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750107,
					"content": "Tu veux faire des expériences sur toi-même ? As-tu perdu la tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750108,
					"content": "« Haha. Je pense que c'est une bonne chose. Comme ça, ce corps décrépit servira au moins à quelque chose. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "... Donc, une fois le système activé, c'est toi qui auras le moins de chances de survivre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750110,
					"content": "L'Abîme a-t-il finalement pris le contrôle de ton esprit ? Ou bien... Tu veux que l'ensemble de ton peuple soit sacrifié à tes funérailles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750111,
					"content": "« Tu n'as pas confiance en ton propre peuple ? À part toi, tous les seigneurs ont consenti à ce plan. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "Ils se contentent de suivre aveuglément ton plan sans réfléchir à son véritable sens... Je ne suis pas d'accord avec ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750113,
					"content": "« Ça n'a pas vraiment d'importance. La destruction... fera place à la renaissance. J'ai pris ma décision. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "« Ha... Je crains de ne pas pouvoir rester éveillé plus longtemps chaque jour. Enfin, je l'activerai dès que tout sera prêt. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "N'y a-t-il vraiment pas d'autre moyen ? J'essaye encore de trouver une autre solution... Es-tu certain de ne pas être en train d'enflammer le monde à cause d'une rancune personnelle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750116,
					"content": "« Peut-être bien. Je ne reculerai devant rien pour empêcher cet ennemi tapi dans l'ombre de pénétrer dans ce monde. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "« Ha, tu parles d'une autre solution... Tu penses vraiment pouvoir obtenir ce que tu cherches auprès de ces humains ? Je constate que tu es déjà bien trop impliqué... »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "« J'ai essayé de te faire comprendre... Mais tout comme ceux qui avaient voulu trouver la sagesse dans les bassins incandescents, connaître une chose et véritablement l'accepter sont deux concepts différents. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Plonger dans le bassin"
				},
				{
					"id": 751750120,
					"content": "« Si tu penses que je ne veux que la destruction et que tu souhaites créer un monde toi-même... Viens m'arrêter, tue-moi et prouve-moi ce que tu vaux ! »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "« Mais écoute bien ceci, Kukulkan. Ce n'est pas une prophétie, seulement le conseil de quelqu'un qui a déjà parcouru ce chemin. Un jour... »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "« ... Tu suivras le même chemin que moi. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}