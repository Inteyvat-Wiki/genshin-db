				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Ah, vous voilà enfin. Je vous attendais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240202,
					"content": "Pourquoi donc ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "Allez, ne soyez pas si ronchon. J'ai une tâche importante à vous confier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240204,
					"content": "Je suppose que vous avez vu ces météorites. Bien qu'aucune ne s'est abattue à l'intérieur de la Cité de Mondstadt, la ville est quand même sens dessus dessous là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240205,
					"content": "Et il y en a plus d'un qui tirerait avantage du chaos pour s'y introduire incognito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240206,
					"content": "Vous parlez des Pilleurs de trésors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "#Bingo ! Votre intuition d'{M#aventurier}{F#aventurière} ne vous fait pas défaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240212,
					"content": "Les chevaliers sont sur leurs gardes, mais ils ne peuvent pas avoir les yeux partout. Sans compter, qu'ils doivent aussi envoyer des renforts à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240213,
					"content": "Ces Pilleurs de trésors ont certainement prévu un plan pour s'immiscer dans les failles et « ramasser le pactole », comme ils le disent si bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240214,
					"content": "Qu'est-ce que vous voulez que je fasse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "#Vous êtes bien {M#direct}{F#directe} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240216,
					"content": "Je crois bien que je n'aurais pas besoin d'utiliser les méthodes prévues par « ce monsieur » pour vous convaincre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240222,
					"content": "Pour faire court, « ce monsieur » a appréhendé les Pilleurs de trésors partis en reconnaissance autour de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240223,
					"content": "D'après leurs dires, trois groupes chercheraient à s'introduire dans la cité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240224,
					"content": "Nous allons jouer à leur jeu et créer l'occasion parfaite pour qu'ils réussissent leur coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240225,
					"content": "Où est-ce que j'interviens ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "Votre travail sera très simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240232,
					"content": "Les Pilleurs de trésors s'échangeaient des renseignements par lettre pour éviter de se faire attraper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240233,
					"content": "Ils avaient confié des lettres à trois de leurs membres partis en reconnaissance qui étaient chargés de les déposer à trois endroits différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240234,
					"content": "Mais ils étaient loin de se douter que « ce monsieur » les intercepterait tous les trois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240235,
					"content": "Les autres Pilleurs de trésors étaient sensés planifier leur attaque après avoir reçu ces informations, pour définir le meilleur point d'entrée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240236,
					"content": "Mais nous allons leur faire une fleur cette fois-ci. « Ce monsieur » a déjà tout prévu pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240237,
					"content": "Prenez ces trois lettres et déposez-les à leurs emplacements prévus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240238,
					"content": "Revenez me voir quand ce sera fait et nous discuterons de la suite des choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 411240226,
					"content": "J'espère que ces informations sont fiables...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "Nous ne sommes jamais trop prudents, mais faites-moi confiance, je sais que les Pilleurs de trésors n'ont aucun scrupule à trahir les leurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240228,
					"content": "Ce ne sont que des malfaiteurs dont le but est de s'enrichir personnellement après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240229,
					"content": "« Vous serez récompensés si vous collaborez avec nous, mais si vous tentez quoi que ce soit, vous ne perdrez pas que votre argent. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240230,
					"content": "Et le tour était joué grâce à cette proposition où tout le monde gagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240217,
					"content": "Les chevaliers pourront s'en charger sans problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Haha, je m'attendais à cette réponse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240219,
					"content": "Ne vous en faites pas, « ce monsieur » vous rémunérera très généreusement pour vos services.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240220,
					"content": "Et si vous trouvez des choses au cours de la mission, vous pourrez tout garder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240221,
					"content": "#Vous {M#seul}{F#seule} pouvez mener à bien cette tâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240208,
					"content": "Vous parlez des Brutocollinus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Hahaha ! Bien tenté, mais non. Comment feraient-ils pour ne pas qu'on les remarque ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240210,
					"content": "Les chevaliers seraient déjà prêts à les intercepter s'ils s'approchent trop près des murs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240211,
					"content": "Je parlais des Pilleurs de trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Val"
				}
			]
		},
		{
			"id": 4112406,
