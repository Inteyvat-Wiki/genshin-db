			"dialogs": [
				{
					"id": 411245201,
					"content": "Vous êtes encore là ? Des questions à me poser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411245202,
					"content": "Vous allez me dire qui est « ce monsieur »...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "C'est une de vos vieilles connaissances. Il a dit que vous avez même combattu ensemble pendant un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411245204,
					"content": "Je ne peux pas vous dévoiler son nom ou je vais avoir des problèmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 411245205,
					"content": "Pourquoi on n'en profite pas pour livrer tous les Pilleurs de trésors de la zone ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Vous voulez capturer les autres Pilleurs de trésors qui s'enfuiront après qu'on se soit occupés des trois groupes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411245207,
					"content": "C'est une bonne idée... mais notre objectif était de leur donner un avertissement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411245208,
					"content": "Les chevaliers ne peuvent pas se permettre de déployer les efforts adéquats pour la capture de ces malfaiteurs en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411245209,
					"content": "Leur priorité reste les météorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411245210,
					"content": "Quant aux Pilleurs de trésors, ils ont besoin de comprendre... qu'il faut arrêter les bêtises pendant un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				}
