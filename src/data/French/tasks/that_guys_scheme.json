					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "Vous avez déposé les lettres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240602,
					"content": "Oui, tout est prêt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "Très bien, tout est en ordre alors. Ils devraient se servir de ces informations pour préparer leur plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240604,
					"content": "Ils devraient passer à l'action pendant la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240605,
					"content": "Il n'y aura qu'un point d'entrée idéal, je vais vous le marquer sur la carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240606,
					"content": "Voilà, et maintenant nous avons juste à attendre que les Pilleurs de trésors mordent à l'hameçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240607,
					"content": "Et si on se faisait griller par l'Ordre de Favonius ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Cela nous poserait effectivement un gros problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240609,
					"content": "Mais pas de panique, « ce monsieur » garantit que tout se passera comme sur des roulettes. Faisons-lui confiance sur ce point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240612,
					"content": "Vous n'avez qu'à attendre que la nuit tombe et donner une bonne raclée à ces Pilleurs de trésors qu'on aura piégés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Val"
				},
				{
					"id": 411240610,
					"content": "Comment fait-on si les Pilleurs de trésors ne se montrent pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "Ils vont venir, c'est sûr et certain. Les plans de « ce monsieur » sont infaillibles. Tout ira pour le mieux, je vous l'assure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Val"
				}
			]
		},
		{
			"id": 4112408,
			"completionStepIds": [
				4112408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112408",
							"2"
						],
						"stepId": 4112408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Val"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240801,
					"content": "Est-ce que les Pilleurs de trésors sont hors d'état de nuire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240802,
					"content": "Et comment !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "Je n'en attendais pas moins de quelqu'un estimé de « ce monsieur ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240804,
					"content": "Voici votre récompense. C'était un plaisir de travailler avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240805
					],
					"speakerTitle": "Val"
				},
				{
					"id": 411240805,
					"content": "Nous aurons sans doute l'occasion de le refaire à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
