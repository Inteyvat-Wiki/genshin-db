			"dialogs": [
				{
					"id": 760020701,
					"content": "Héhé, on leur a fichu une belle frousse ! Et dire que ces Pilleurs de trésors pensaient qu'on allait se battre pour eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020702,
						760020704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020702,
					"content": "La justice l'emporte !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020703
					]
				},
				{
					"id": 760020703,
					"content": "C'est vrai ! Même si je suis quand même curieuse de savoir ce qu'ils essayaient de voler...",
