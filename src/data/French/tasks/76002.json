			"dialogs": [
				{
					"id": 760020501,
					"content": "Ha ! C'est enfin réglé. Cet étranger avait la langue bien pendue à faire de grands discours, à parler du fait que c'était trop chaud ou je ne sais quoi. Ça ne m'a pas l'air bien brûlant maintenant que ce truc est congelé, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Pfiou... Ça devrait empêcher les marchandises de contrebande d'arriver jusqu'au Village de Nasha, non ? Ah, et n'oubliez pas notre récompense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hmph, laissez-moi d'abord inspecter la marchandise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Hein ? Inspecter... la marchandise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Ben oui, quoi d'autre ? S'il y a un problème, non seulement vous n'aurez pas votre part, mais mes gars ne recevront pas un seul mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Tsk... Regardez-moi toutes ces éraflures. Il y a même de la rouille ! C'est plus ce que c'était, le Fleuve cendré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Oh, ce serait un Méka horlogoïde de Fontaine ? La technologie fontainoise est impressionnante. Il fonctionne toujours même après avoir été transporté jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Il fonctionne toujours ? Ça fait des plombes que le système d'alimentation de ce truc a été démantelé. Impossible qu'il...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
					"content": "ATTENTION. <color=#FF5E41FF>ANOMALIE</color> détectée lors du mode de démarrage. Module énergétique <color=#FF5E41FF>ANORMAL</color>. Échec de la vérification.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020510
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020510,
					"content": "Échec de la vérification. <color=#FF5E41FF>Échec de la vérification. </color> <color=#FF5E41FF>Échec de la vérification.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation, annihilation, annihilation.</color>",
