			},
			"dialogs": [
				{
					"id": 760020301,
					"content": "Tsk... Autant les laisser faire. Ils ne savent pas ce qu'ils font, et pourtant ils osent quand même se mêler de nos affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Merci pour ton aide. Dès que mes gars auront livré cette « Mademoiselle Belleville » au Village de Nasha, tu auras ta part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Ah oui, la récompense... Attendez, vous faites du trafic d'êtres humains ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Haha, ne raconte pas n'importe quoi, ma petite. On ne fait pas dans les enlèvements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "« Mademoiselle Belleville » est le nom de ce tas de ferraille. Il a été transporté jusqu'ici depuis le Fleuve cendré, ça nous a demandé énormément d'efforts. Si quelqu'un s'en emparait, on serait ruinés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Oh, ce serait un Méka horlogoïde de Fontaine ? La technologie fontainoise est impressionnante. Il fonctionne toujours même après avoir été transporté jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Tu rigoles ? Ça fait des plombes que le système d'alimentation de ce truc a été démantelé. Impossible qu'il...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "ATTENTION. <color=#FF5E41FF>ANOMALIE</color> détectée lors du mode de démarrage. Module énergétique <color=#FF5E41FF>ANORMAL</color>. Échec de la vérification.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020309,
					"content": "Échec de la vérification. <color=#FF5E41FF>Échec de la vérification. </color> <color=#FF5E41FF>Échec de la vérification.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation, annihilation, annihilation.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
