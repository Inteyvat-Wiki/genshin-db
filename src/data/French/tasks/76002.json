			"dialogs": [
				{
					"id": 760020101,
					"content": "#Hé toi là-bas, {M#le blondinet}{F#la blondinette} ! Tu tombes à pic, ce gars cherche la bagarre. Si tu me files un coup de main, je te donnerai une part du butin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#Bon sang, tu appelles des renforts parce que tu es en train de perdre ? À bon chat, bon rat ! Écoute-moi bien, {M#petit}{F#petite}. Si tu m'aides à écraser ce type, je te donnerai la moitié des moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "Une minute, on ne fait que passer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
