				},
				{
					"id": 760020709,
					"content": "Échec de la vérification. <color=#FF5E41FF>Échec de la vérification. </color> <color=#FF5E41FF>Échec de la vérification.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation.</color> <color=#FF5E41FF>Annihilation, annihilation, annihilation.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020710
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020710,
					"content": "#Aaaaah ! {NICKNAME}, attention !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020704,
					"content": "Qui trouve garde ! C'est à moi maintenant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020705
					]
				},
				{
					"id": 760020705,
					"content": "#Tout à fait ! On pourrait tout garder pour nous ! Attends, ça ne va pas ! Ne dis pas ça comme ça ! On est des {M#aventuriers}{F#aventurières} honnêtes... Pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020706,
					"content": "D'ailleurs, je suis quand même curieuse de savoir ce qu'ils essayaient de voler...",
					"roleType": "TALK_ROLE_NPC",
