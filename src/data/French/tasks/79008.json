			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "Ça doit être ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080102,
					"content": "Hein ? Il y a une lettre à côté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080103,
					"content": "À l'ami que le destin aura mené ici,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080104,
					"content": "Je te salue, inconnu. Si tu lis cette lettre, alors c'est que tu as dû trouver l'harpastum que j'avais laissé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080105,
					"content": "L'Archipel de la pomme dorée regorge de jeux d'harpastums, et mes amis et moi avons passé ici un été merveilleux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080106,
					"content": "C'est pour cette raison que j'ai décidé de laisser ici un harpastum que j'ai confectionné, pour que la personne qui le trouve – toi – connaisse les mêmes joies que j'ai connues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080107,
					"content": "Je te souhaite de profiter à fond du soleil, de la brise marine et des jeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080108,
					"content": "— Barbara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "Examiner"
				},
				{
					"id": 790080109,
					"content": "Du Barbara tout craché ! Bon, maintenant qu'on a un harpastum, l'heure est venue de jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Examiner"
				}
			]
		},
