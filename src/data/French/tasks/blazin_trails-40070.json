			"dialogs": [
				{
					"id": 400701701,
					"content": "Nous sommes arrivés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701702,
					"content": "Oh ? Fischl ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701704,
					"content": "C'est vraiment elle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "... Hmph, vous êtes enfin arrivés, imprudents serviteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701706,
					"content": "Oh, ah, ça faisait longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701707,
					"content": "Pas vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701708,
					"content": "Ah... Ma maîtresse et moi-même avons senti une odeur particulière par ici, nous sommes donc venus pour vous attendre et... vous voilà arrivés plus tôt que prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701709,
					"content": "C'est moi ou Oz a l'air nerveux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701710,
					"content": "L'avènement de l'Empire de la nuit éternelle est imminent. Je dois encore me préparer pour la cérémonie de consécration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701711,
					"content": "Mademoiselle, vous allez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701712,
					"content": "Je peux agir seule, Oz. Si tu es las de l'obscurité envahissante, retourne vers la lumière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701713,
					"content": "Mademoiselle, ces paroles ne vous ressemblent pas. Je suis votre serviteur et vos yeux, je ne vous abandonnerai jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701714,
					"content": "... Arrête de me regarder ainsi ! B—Bref, l'heure n'est pas aux explications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701715,
					"content": "Mais enfin, mademoiselle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701716,
					"content": "Je suis vraiment désolé, il semblerait que ma maîtresse soit de mauvaise humeur. Ne le prenez pas mal. Veuillez m'excuser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701717,
					"content": "... Hmph, son humeur est tout aussi exécrable que quand elle est partie de son côté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701718,
					"content": "En voyant Fischl, je pense que l'illusion qui en train de se former doit être la sienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701719,
					"content": "Oui. Quand je me suis approché de mon illusion, j'ai aussi senti une odeur assez familière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701720,
					"content": "Moi aussi. Rien ne l'explique, mais j'ai senti qu'un événement particulier allait se produire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701721,
					"content": "Fischl et Oz peuvent le percevoir, ce qui veut dire que ce sera sans doute le cas... Fischl ne veut pas faire face à son illusion, c'est pourquoi elle est si agitée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701722,
					"content": "Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701723,
					"content": "L'illusion cache peut-être des secrets qu'elle ne veut pas nous montrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701724,
					"content": "Reposons-nous ici d'abord. Nous aurons notre réponse une fois que l'illusion apparaîtra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
