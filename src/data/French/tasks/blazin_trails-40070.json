			"dialogs": [
				{
					"id": 400701901,
					"content": "Nous avons planté le pétale. Est-ce que tu ressens quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701902,
					"content": "Oui. Le soleil brille, l'eau de mer a des reflets semblables à des pierres précieuses, les vagues frappent la plage de sable blanc dont les grains se mêlent à la mer avant d'être ensuite repoussés sur le rivage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Âme gelée"
				},
				{
					"id": 400701903,
					"content": "... Les oiseaux de mer atterrissent sur les rochers, ils les picorent doucement et en rythme... Toc-toc, toc-toc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Âme gelée"
				},
				{
					"id": 400701904,
					"content": "C'est de la musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701905,
					"content": "Et comment ! En fait, cette île est un énorme instrument de musique. Puisque tu es musicienne, tu peux comprendre sa nature profonde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Âme gelée"
				},
				{
					"id": 400701906,
					"content": "Jouer de la musique avec le vent de mer, les vagues et les marées, c'est ce qu'il y a de plus romanesque au monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701907,
					"content": "Allons-y. C'est l'heure de ma prestation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		}
