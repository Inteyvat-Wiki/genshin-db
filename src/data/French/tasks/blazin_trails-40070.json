			"dialogs": [
				{
					"id": 400701801,
					"content": "Nous avons fait ce que nous avons pu, mais que faire pour les deux montagnes restantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Réfléchissons, il doit forcément y avoir une solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "Je viens de voir qu'il y a des cours d'eau et des plantes à l'intérieur des montagnes, c'est un système qui les relie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "Mais les montagnes se sont écroulées, on ne peut pas faire le lien avec les plantes ou les cours d'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "Si tous les cours sont désobstrués, les montagnes pourront être reliées, pour former l'« énorme instrument de musique » et pour « en jouer », comme mentionné sur la note d'Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Oui, je dois le faire pour réaliser mon vœu... Je vais demander à cette fleur, elle devrait avoir une solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
