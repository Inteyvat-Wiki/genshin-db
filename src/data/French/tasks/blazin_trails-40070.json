			"dialogs": [
				{
					"id": 400701601,
					"content": "C'est étrange, on ne fait que tomber sur des monstres depuis tout à l'heure. Pas la moindre trace de Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701602,
					"content": "Il y a des traces d'activité et l'appareil est encore là, mais il n'y a personne. Très bizarre, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701603,
					"content": "(Je crois que ces illusions sont étroitement liées à l'appareil des Fatui. Il a l'air en panne et c'est peut-être la source du problème.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "(... Si leur appareil nous amène dans ces illusions, pourquoi ont-ils disparu ? Y aurait-il des choses que nous ignorons ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "(Les Fatui sont introuvables... Se sont-ils vraiment volatilisés ou nous fuient-ils ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "Bon, je vais faire un peu de divination pour voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701608,
					"content": "Hein ? Une force qui circule ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701609,
					"content": "Je n'arrive pas à retrouver la trace des Fatui et mon disque d'eau redevient trouble, mais cette fois-ci, je sens une certaine force qui est en train de se former.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701610,
					"content": "Elle converge vers... l'île là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701611,
					"content": "À qui le tour, cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701612,
					"content": "Hmm... Allons-y. On trouvera peut-être des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
