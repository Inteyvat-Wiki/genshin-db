			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"« Oni des mers »",
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "S'il vous plaît, épargnez-moi ! Où avez-vous trouvé ce genre d'aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040207,
					"content": "Sale bandit ! Rends-moi mon arme immédiatement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Vous... Vous êtes toujours en colère à propos de ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040209,
					"content": "Je suis juste ici pour récupérer mon arme. Dis-moi et je t'épargnerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040211,
					"content": "Inutile de gaspiller son souffle avec lui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "N—Non, s'il vous plaît ! Arrêtez ! J—je n'ai pas dit que je ne dirais rien ! Vous n'avez pas besoin d'être aussi violents !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040214,
					"content": "Cette arme a été prise par notre chef pour sa collection. Si vous la voulez, vous pouvez simplement aller au camp là-bas pour la récupérer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040215,
					"content": "Au moins, tu as un peu de bon sens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "S'il vous plaît, est-ce que je peux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040217,
					"content": "Dégage !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "« Oni des mers »"
				},
				{
					"id": 728040219,
					"content": "Il n'a pas l'air très doué pour le combat, mais il court plutôt vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Sans parler qu'il a livré ses potes assez rapidement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Les Oni des mers sont un groupe hétéroclite motivé par leur seul profit. La loyauté n'y a pas sa place, la conviction non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "Dès qu'ils font face à des problèmes, ils s'enfuient. C'est normal pour eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Mais heureusement, vous êtes ici pour m'aider. Je doute qu'ils auraient reconnu leur défaite si facilement autrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Notre prochain arrêt est leur camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "Nous suivons toujours le même plan qu'avant. Je vais défier leur chef directement, et vous vous occupez des autres bandits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "#Je peux en battre dix à moi {M#seul}{F#seule}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Allons-y, trouvons quelqu'un d'autre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
