				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef « Oni des mers »"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Toi ? Hahaha, c'est encore toi ? Es-tu venu me donner une autre chose précieuse pour ma collection ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040302,
					"content": "Je suis ici pour récupérer mon arme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "Eh bien, au moins tu es courageux. Mais avec seulement un allié ? Tu me prends pour un imbécile, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040304,
					"content": "Mais tu sais quoi ? Je vais te donner une chance comme tu es courageux au moins. Viens ! Allons ! On va aller régler ça ailleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040305,
					"content": "#Mais je ne vais quand même pas laisser mes gars sans rien à faire, n'est-ce pas ? Pourquoi tu ne demandes pas à ton {M#assistant}{F#assistante} de les occuper un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040306,
					"content": "Dès qu'ils sont prêts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "#Hahaha, tu es trop {M#prétentieux}{F#prétentieuse} ! Eh bien, les gars, vous avez entendu ce qu'{M#il}{F#elle} a dit, attaquez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040309,
					"content": "Et quant à toi, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040310,
					"content": "Je compte sur vous alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "C'est comme si c'était fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Vous avez tous ma reconnaissance. Je m'occupe de lui au plus vite et je reviens vous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Eh bien, tu es un sacré bavard, toi aussi ! Je t'attends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef « Oni des mers »"
				},
				{
					"id": 728040307,
					"content": "J'espère que le meilleur d'entre eux est capable de me battre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "Votre respiration est régulière. Je devine que ces Oni des mers n'étaient pas de taille face à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "Et il semble que vous ayez été victorieux, vous aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "C'est effectivement le cas. Bien que je doive admettre à mon grand désarroi qu'il a pu s'échapper après un seul coup de lance grâce à une feinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Mais sa blessure était profonde. Je pense qu'il ne fera pas de mal pendant au moins plusieurs années.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "Le plus important, c'est que je l'ai vaincu et j'ai récupéré mon arme. Et j'ai effacé cette humiliation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Félicitations, Asakura !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Je vous suis profondément reconnaissant, mais je ne peux pas encore me relâcher !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "La raison d'un tel incident était mon manque d'entraînement. Je vais continuer à m'entraîner dur et à améliorer mes compétences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "D'ailleurs... Je compte également sur vous à l'avenir pour m'entraîner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Ah, oui, voilà pour vous remercier. Ce n'est pas grand-chose, mais je vous prie d'accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Merci encore une fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}