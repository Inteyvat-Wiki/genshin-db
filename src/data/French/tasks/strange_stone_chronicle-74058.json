					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "Ce n'est pas pressant, les artisans sont encore en train de travailler l'échantillon de la dernière fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580405,
					"content": "Mais si nous parvenons à mettre la main sur plus de minerais, les artisans pourraient peut-être retrouver l'inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "Chesil"
				},
				{
