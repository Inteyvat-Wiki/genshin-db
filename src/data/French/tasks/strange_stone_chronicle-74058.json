			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, nous sommes de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#{NICKNAME} et Paimon ! Vous êtes {M#venus}{F#venues} jouer avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Pas vraiment, mais vous nous aviez dit qu'on pouvait vous poser des questions sur les minerais et leurs veines, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Oui ! J'ai collecté toutes les jolies pierres des environs. Que voulez-vous savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "C'est au sujet de la pierre qu'on a trouvée la dernière fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Vous racontez à Puca comment vous avez vendu l'étrange minerai au gemmologue...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Hein ? Les gens de l'extérieur croient vraiment qu'elles ont de la valeur ? Mais je les ai montrées à ma sœur pourtant... Les humains sont difficiles à comprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Mais je connais plein d'endroits où en trouver ! Je peux vous les montrer si vous voulez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca indique les emplacements de l'étrange minerai sur votre carte.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Ce serait super. Merci, Puca ! Oh, c'est vrai, voici l'avance que Chesil nous a donnée. On pourrait vous donner la moitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Oh, ce n'est pas nécessaire. Nous n'avons pas vraiment besoin de ça au village... Sans parler de la façon dont vous m'avez tant aidée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
