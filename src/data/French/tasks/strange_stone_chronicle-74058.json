					"speakerTitle": "Chesil"
				},
				{
					"id": 740580402,
					"content": "Vous avez le minerai que vous deviez m'apporter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "Chesil"
				},
				{
