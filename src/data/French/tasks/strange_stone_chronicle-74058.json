			"dialogs": [
				{
					"id": 740580201,
					"content": "Eh beh, vous en avez trouvé beaucoup... Ça m'aide énormément !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "J'ai déjà envoyé le minerai à l'atelier, mais je n'ai pas encore reçu l'échantillon de mon produit. C'est certainement parce que les artisans ont dû rencontrer des problèmes parce qu'ils n'ont pas l'habitude de travailler avec ce matériau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Mais pas d'inquiétude, j'ai confiance en ma vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "J'ai l'intention de fabriquer des accessoires avec. Tout le monde se les arrachera à Fontaine, j'en suis sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "Vous pourrez voir le produit terminé la prochaine fois que vous viendrez me voir ! Je vous donnerai aussi quelques échantillons en cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Si ça se trouve, vous les verrez sur des aristocrates férus de mode avant même de venir, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "Bon, à la prochaine.",
					"roleType": "TALK_ROLE_NPC",
