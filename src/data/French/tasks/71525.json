			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "C'est merveilleux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662102,
					"content": "Je peux voir que le gang Arataki a transformé les combats de scarabées en une discipline sportive riche en adrénaline par sa compétitivité ! Je décèle les éléments d'une histoire culte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662103,
					"content": "Beau match, Tian ! C'était une horreur de vous affronter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "Roi oni, on dit plutôt : c'était un honneur de vous affronter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716662105,
					"content": "Ah, ce n'est qu'un détail ! En tout cas, merci de soutenir notre programme d'entraînement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Je vous remercie également, monsieur Arataki. J'ai l'intention de rester ici un peu plus longtemps pour observer ce qui se passe pour mes histoires ! Faites comme si je n'étais pas là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662107,
					"content": "Je n'ai jamais combattu contre quelqu'un d'aussi cultivé auparavant ! J'ai la tête qui tourne avec tous ces mots compliqués... C'est comme si j'apprenais à propos d'autres choses que les combats de scarabées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "On dirait que le super entraînement éblouissant aux combats de scarabées d'Arataki démarre fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
