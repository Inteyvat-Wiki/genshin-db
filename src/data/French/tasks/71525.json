				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Bonjour à tous, je suis Tian la langue de fer. Je viens avec le panneau officiel du super entraînement éblouissant aux combats de scarabées d'Arataki. Il s'agit également de votre permis d'organisation de l'événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662002,
					"content": "Ouah ! C'est censé être le vacheron et Titan cramoisi ? Ils abusent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Génial ! Quel dommage que ce ne soit pas mon dessin... Mais regardez-moi cette composition ! Et ces lignes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "C'est classe ! Impressionnant ! L'affiche représente exactement de quoi j'ai l'air en tant qu'expert de combats de scarabées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Hum, vous... Euh, comment s'adresse-t-on aux inconnus ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "Sieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716662007,
					"content": "Voilà ! Sieur Tian ! Votre œuvre me laisse sans voix ! Je vous en suis infiniment reconnaissant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "Vous me flattez, monsieur Arataki. Je ne suis qu'un conteur, pas un peintre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662009,
					"content": "Cette illustration a été réalisée par une jeune fille du Bureau des affaires civiles. Mademoiselle Yanfei se soucie souvent d'elle, alors elle a voulu contribuer à sa façon lorsqu'elle a entendu parler de votre événement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662010,
					"content": "Oh, c'est donc grâce à Yanfei ! Elle a vraiment pensé à tout ! C'est exactement ce dont j'avais besoin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Le Grand Maître Hanakado m'a dit que le super entraînement éblouissant aux combats de scarabées d'Arataki est un événement ambitieux qui pourrait façonner l'avenir des combats de scarabées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662012,
					"content": "Je ne m'y connais pas, mais j'ai beaucoup entendu parler de la discipline. Je voudrais essayer pour voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662013,
					"content": "Qui sait ? Ça pourra peut-être me donner de l'inspiration pour une nouvelle histoire à raconter dans le quartier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Analyste des mouvements"
				},
				{
					"id": 716662014,
					"content": "Il faut avoir une affinité naturelle avec les combats de scarabées. Prenez Melon lavande de fer blanc par exemple : elle s'est très bien débrouillée lors de sa première fois, rien qu'après avoir vu une seule petite démonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716662015,
					"content": "Une fois que Tian comprendra les principes fondamentaux des combats de scarabées et leur intérêt, il pourrait nous faire de la publicité grâce à ses histoires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Grand Maître Hanakado"
				},
				{
					"id": 716662016,
					"content": "Ça serait hyper cool !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Bon, euh... Tian ! Que le meilleur gagne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
