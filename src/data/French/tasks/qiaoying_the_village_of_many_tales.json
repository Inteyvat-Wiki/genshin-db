			"dialogs": [
				{
					"id": 700500801,
					"content": "Est-ce que ce sont des lanternes ? On dirait qu'elles sont en forme de poisson, c'est vraiment fascinant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Est-ce que ces poignées sont utilisées pour les soulever ? Hmm... Cette structure démontable... Quelqu'un qui s'y connaît en ingénierie pourrait facilement lui rajouter une ou deux sections sans que ça se remarque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "L'espace à l'intérieur est assez large. On pourrait en insérer quelques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Chut ! Gardez ces pensées pour vous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Hein ? Oh... Oui ! Hahaha, je ne peux pas m'empêcher de penser à haute voix quand quelque chose m'intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Si je rajoutais des lanternes à mon roman... Il gagnerait certainement en relief !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}, est-ce que vous pouvez prendre une photo de cette grosse lanterne en forme de poisson ? J'aimerais garder quelques références photographiques pour plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "Mes compétences en photographie vont encore s'améliorer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Je vous laisse faire... Ah oui ! Lorsque vous prendrez cette photo, assurez-vous de prendre la lanterne dans son entièreté. C'est très important pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "... Concevoir un schéma lié à ses dimensions serait très intéressant... La question est maintenant de savoir comment résoudre le problème du poids...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
