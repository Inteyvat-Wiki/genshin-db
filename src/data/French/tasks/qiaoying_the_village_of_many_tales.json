			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "... Vous voyez ! Il s'agit d'un chat tout à fait ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "En parlant de ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Miaou ? Miaou... miaou, miaou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Chaton perplexe"
				},
				{
					"id": 700500504,
					"content": "Tu connais les Bêtes de Xuanwen, toi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Miaou...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Chaton perplexe"
				},
				{
					"id": 700500508,
					"content": "Le chaton se retourne et repart, exaspéré.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Mais... Vous croyez que ce chaton est une forme juvénile d'une Bête de Xuanwen ? Il se cache dans les environs du Village de Qiaoying, et à l'âge adulte, il détruira tous les théiers du coin d'un seul coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Mademoiselle Guijarro, c'est encore vous... Je vous ai déjà dit que les Bêtes de Xuanwen n'étaient pas des créatures dociles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ahem, mademoiselle Hung Fan ! Quelle coïncidence ! Qu'est-ce qui vous amène par ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "*soupir* Arrêtez de parler à haute voix d'affaires criminelles ici. Qu'est-ce qui se passerait si des enfants prenaient vos propos au sérieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Vous vous connaissez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Oui. Quand je suis venue dans le coin, c'est cette demoiselle qui m'a aidée à porter mes bagages. Je la consulte également pour des questions sur le folklore local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Je vous l'ai dit à plusieurs reprises que les Bêtes de Xuanwen n'allaient pas apparaître dans le village, mais vous ne vouliez pas me croire. Et qu'est-ce que vous aviez dit déjà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Si elles n'apparaissent pas, j'ai quand même des moyens de récolter des informations à leur sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "Et voilà, ça recommence... Je sais que je ne pourrai pas vous en dissuader, mais ne quittez surtout pas le village comme bon vous semble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Les Bêtes de Xuanwen sont des créatures vraiment féroces, si jamais vous croisez leur chemin... *soupir* Je vous en conjure, ne partez pas du Village de Qiaoying toute seule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan s'en va d'un air dépité. Elle a l'air encore plus épuisée que le chaton de tout à l'heure...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Eh bien, vu tout ce qu'a raconté Hung Fan, on ne peut aller qu'à un seul endroit pour se renseigner sur le folklore local. Allez, suivez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "#{M#Désolé}{F#Désolée}, on s'est {M#trompés}{F#trompées} de chat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Miaou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Chaton perplexe"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
