			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "Hein ? Où est partie Mademoiselle Guijarro ? Elle était là à l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Elle a dû être enlevée par une Bête de Xuanwen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Ne dis pas ces choses horribles ! Elle a sûrement dû s'aventurer quelque part pour trouver de l'inspiration pour son roman. Essayons de la trouver dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Le champ de thé à côté nous donnera une meilleure vue, commençons par là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "Commençons par chercher là-haut, oui ! Très bonne idée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "Le roman qu'elle va écrire serait en train de se réaliser ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
