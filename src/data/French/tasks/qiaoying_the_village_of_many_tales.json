				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Mademoiselle Guijarro ! Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "... Non non. Je ne peux pas leur faire trouver l'indice de cette façon. Et puis, quelqu'un aurait-il la force de réfléchir après avoir été attaché ici toute la nuit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Waouh... Elle est complètement perdue dans ses pensées. Est-ce qu'elle a trouvé son inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Elle est plutôt tombée sur un gros obstacle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#... {NICKNAME}, Paimon, vous arrivez à temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Est-ce que vous pouvez m'attacher sur ce mannequin en bois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "J'ai... J'ai bien entendu ce qu'elle a dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Est-ce que vous pouvez me ligoter les mains et me pendre à un arbre ? Euh... C'est du bois de toute façon, il n'y a aucune différence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "#Je n'ai pas envie de devenir {M#le suspect}{F#la suspecte} de votre roman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Pas de panique, j'ai déjà rempli une décharge de responsabilité en votre nom, j'assumerai tous les accidents qui pourraient m'arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "Il n'est pas question de ça ! Pourquoi voulez-vous qu'on vous attache tout à coup ? Vous n'avez rien fait de mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Mais le personnage de mon roman sera pendu par les mains à un arbre par les villageois et abandonné dans la nature en attendant le jugement de la Bête de Xuanwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Et plus tard dans l'intrigue, le héros, s'étant attendu à cette tournure des événements, survit d'une manière ou d'une autre en endurant la nuit, et révèle la vérité cachée derrière toute cette affaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "... Cependant, je n'ai absolument aucune idée de ce que ça fait d'être attachée toute une nuit, de ce qu'on peut avoir comme intonation dans la voix, comme façon de penser ou de bouger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "C'est pour ça que j'aimerais que vous m'attachiez et que vous me laissiez ici toute la nuit pour que je puisse ressentir ce que ça fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501216,
					"content": "Ça ne sera pas possible, c'est bien trop dangereux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "... Hmm. J'ai bien une autre méthode, mais elle ne sera peut-être pas aussi efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Je pourrais plutôt lever mes mains et rester dans cette posture toute la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Sinon... Vous pouvez laisser tomber l'écriture de ce roman. Nos actions pourraient être mal interprétées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Vous voulez vraiment mettre le héros de votre histoire à rude épreuve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Je vous en prie ! C'est l'étape la plus importante dans la conception de mon roman, et il est presque terminé ! Si vous utilisez cette méthode, vous ne commettrez aucun crime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "On n'a pas besoin de faire ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "Ce n'est pas nécessaire d'agir de la sorte !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ah... Je veux dire que vous n'aurez quasiment rien à faire. Il faudra juste rester à mes côtés pour éviter que des gens... ou des bêtes sauvages ne m'enlèvent pendant ce temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Voyons voir... Vu l'ambiance que je cherche à donner à mon roman, il faudrait que j'aille encore plus haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Hein ? Attendez-nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Guijarro, Paimon et vous atteignez la terrasse la plus élevée du champ de thé...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Pfiou... Il, il fait un peu froid ici... Mais ça nous met vraiment dans l'ambiance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Vous allez vraiment rester ici toute la nuit avec les mains levées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Eh oui, je signe et je persiste. Pour écrire un roman digne de ce nom, il faut en payer le prix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Je vous demanderai donc de rester à mes côtés pour monter la garde, juste pour une nuit... Juste pour une nuit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501217,
					"content": "Vous n'avez pas une façon moins dangereuse d'expérimenter ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
