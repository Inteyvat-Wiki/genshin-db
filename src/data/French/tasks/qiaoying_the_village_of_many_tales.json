				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Qu'en pensez-vous ? Cette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Une bouilloire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "C'est exact ! Et il rend le thé... très spécial ! Quoi qu'il en soit, il se trouve en plein milieu du village, ça m'étonnerait donc que ce ne soit qu'un simple chaudron !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Euh... Vous pensez que cette Bête de Xuanwen habite à l'intérieur de la théière ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Si vous écrivez ça, ce ne sera plus un roman policier mais fantastique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Si vous écrivez ce genre de choses, j'aurai l'impression que des Adeptes vont apparaître dans votre roman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Je ne sais pas si c'est le bon thème à traiter dans un roman policier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "... Oh ! Vos réactions ne sont pas mal du tout ! Vous pensez qu'une histoire de crime centrée sur une Bête de Xuanwen serait trop absurde pour être prise au sérieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Hein ? Euh, c'est un peu l'impression que ça donne. C'est impossible de développer une intrigue autour d'un thème comme celui-là, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Attendez, ne me dites pas que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Hmm, quelle sagacité, {NICKNAME}. Vous êtes à la hauteur de votre réputation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "C'est vrai, je voulais écrire une histoire autour d'« un crime trop absurde pour être commis ». La réaction de mademoiselle Hung Fan et les vôtres sont très intéressantes, je pourrai les inclure dans mon roman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Et quant à la Bête de Xuanwen... C'est le coupable dans mon histoire. Un monstre qui dévore les malfaiteurs d'un village, mais que personne n'a jamais vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "Lors d'une fête quelconque, un villageois a été retrouvé assassiné en pleine nature. On aurait dit qu'une bête féroce l'avait attaqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Mais au deuxième jour des festivités, le personnage principal croisa la route de la victime qui devait être morte. Et ensuite, une autre personne normalement décédée est réapparue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Et ensuite ? Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Je n'y ai pas encore réfléchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "... Je vais m'en aller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "#Ne vous inquiétez pas, quand j'aurai fini de rédiger mon roman, je vous donnerai un exemplaire {M#chacun}{F#chacune}. Mais j'ai encore une faveur à vous demander !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "Mademoiselle Hung Fan m'a dit qu'il ne fallait pas que je quitte le village, pas vrai ? Je vais me montrer sage en écoutant ses paroles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "Cependant... puisque vous êtes là, je ne suis plus toute seule ! Je peux donc partir d'ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "Bien entendu, je ne m'éloignerai pas trop ! Est-ce que vous êtes d'accord pour m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "D'accord... Si c'est pour avoir la fin de votre roman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Alors dans ce cas... Prenons cette direction, il y a un endroit où j'aimerais me rendre là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Versez-nous notre rémunération selon les règles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Bien sûr, ne vous inquiétez pas pour ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
