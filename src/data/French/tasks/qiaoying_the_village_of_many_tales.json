			"dialogs": [
				{
					"id": 700501501,
					"content": "... Dans cette situation, le personnage principal n'aurait aucun moyen de rentrer au village tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501502,
					"content": "Mademoiselle Guijarro !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501503,
					"content": "Aidons-la à se relever...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "Vous aidez Guijarro à se relever afin qu'elle s'assoie par terre.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "Alors c'est ça que l'on ressent... C'est vraiment très inconfortable. Non seulement mon corps est affaibli, mais mon esprit marche aussi au ralenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501506,
					"content": "Alors vous avez réussi à trouver l'inspiration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "Bien sûr que oui ! J'ai réussi, et j'ai finalement compris ce que ça fait d'être ligotée et pendue dans la nature toute une nuit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501508,
					"content": "Alors ça veut dire que le héros de votre roman est un dur à cuire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501509,
					"content": "C'est exactement ça. J'ai également réfléchi à la façon dont mon personnage principal chasserait la Bête de Xuanwen. Si je conclus mon histoire de cette manière, alors elle sera certainement... certainement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501510,
					"content": "Oh ! Quelle méthode il va utiliser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501511,
					"content": "Ça sera... pas mal du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501512,
