			"dialogs": [
				{
					"id": 751870101,
					"content": "#Il n'a pas de motif flamboyant sur sa corne... Ce n'est pas {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870102,
					"content": "D'où vient ce petit gars ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870103,
					"content": "Un œuf de saurien d'Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "Oh ! C'est l'œuf de saurien d'avant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870105,
					"content": "Raouh yaa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870106,
					"content": "C'était donc un œuf de tepetlisaure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870107,
					"content": "Je me souviens que la personne qui a protégé l'œuf doit lui donner un nom... Ce petit s'appelle donc Aguara, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870108,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870109,
					"content": "Oh, on dirait que tu aimes bien ce prénom !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870110,
					"content": "Ouh hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870111,
					"content": "#Tout comme {REALNAME[ID(2)|SHOWHOST(true)]}, ce petit n'a plus de maison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870112,
					"content": "#Et si tu venais avec nous ? {NICKNAME} et moi, on s'entend super bien avec les tepetlisaures !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870113,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870114,
					"content": "Héhé... Je savais que tu dirais oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870115,
					"content": "Vous attachez un foulard rouge sur Aguara, comme vous l'avez fait pour votre ancien compagnon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "Le dernier porteur de ce foulard est devenu quelqu'un d'extraordinaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870117,
					"content": "Aguara ! J'espère que tu le seras, et que tu grandiras heureux et en bonne santé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
