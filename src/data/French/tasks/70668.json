					"Prince"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "#Miaou ! (« Incroyable ! Félicitations pour avoir réussi le défi. Tu es maintenant {M#un joueur}{F#une joueuse} maître ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680202,
					"content": "#Miaou. (« Être {M#un joueur maître}{F#une joueuse maître} signifie que... ta technique a dépassé celle de nombreuses personnes qui étudient ce jeu. Ceux qui ne font pas assez d'efforts ne pourront jamais atteindre ce niveau. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680203,
					"content": "(« Bien sûr, ils ne comprennent pas pourquoi nous consacrons inlassablement des heures à un jeu qu'ils jouent juste pour le plaisir... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680205,
					"content": "Miaou ! (« Si les joueurs que tu invites savent que tu as obtenu le titre de maître, ils prendront leurs parties avec toi plus au sérieux. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680206,
					"content": "#(« Peut-être que certains joueurs ne voudront jouer que les parties qu'ils ont préparées en apprenant que tu es {M#un joueur maître}{F#une joueuse maître}... Il y a aussi des loufoques du genre dans la taverne. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680207,
					"content": "#Miaou... (« Alors, {NICKNAME}... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680208,
					"content": "(« Que le plaisir t'accompagne dans le monde de l'Invocation des Sept ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
