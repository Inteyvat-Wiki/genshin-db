					"nextDialogs": [
						760380902
					]
				},
				{
					"id": 760380902,
					"content": "Une sculpture en sucre... Je crois que j'en ai déjà mangé. Vous pourriez m'en faire une ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380903
