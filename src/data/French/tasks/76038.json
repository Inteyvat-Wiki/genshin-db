					"nextDialogs": [
						760380906
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760380906,
					"content": "(Waouh ! Elle a l'air d'avoir hâte... Ah, réfléchis, réfléchis ! Qu'est-ce qu'elle aimerait ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380907
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380907,
					"content": "(Suis ton instinct... écoute ton intuition... Allez, je peux le faire !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380908,
					"content": "Hum... J'ai terminé. Regardez, ça vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380909
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380909,
					"content": "C'est superbe. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760380910,
					"content": "Héhé, je suis contente que ça vous plaise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380911
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380911,
					"content": "(Mon instinct ne s'est pas trompé. Ce style léger et aérien convient parfaitement à quelqu'un comme elle !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380912,
					"content": "Mmh, c'est vraiment délicieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760380913,
					"content": "Pourriez-vous en faire deux de plus ? J'aimerais les ramener pour que les kuuhenkis puissent aussi les goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760380914,
					"content": "Pour... les kuuhenkis aussi ? Je pourrais, mais je n'ai pas assez d'ingrédients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Dans ce cas, je reviendrai demain avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380916
					],
					"speakerTitle": "Columbina"
				},
				{
