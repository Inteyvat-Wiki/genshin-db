			"dialogs": [
				{
					"id": 760381001,
					"content": "(<color=#FFCC33FF>Illuga</color> serait intéressé par les sculptures en sucre ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Bon, puisque je suis déjà là... Bonjour, une sculpture en sucre, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Oh ! Pourriez-vous en faire une plus petite ? J'ai peur de ne pas pouvoir la finir d'un coup si quelque chose arrive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "Pas de souci ! Ne vous inquiétez pas, même les petites sont tout aussi délicieuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Les Gardiens de lumière sont vraiment débordés... même une sculpture en sucre pourrait rester inachevée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Hum... Ahaha... En fait, ce n'est pas seulement à cause de nos responsabilités. Parfois, c'est parce que je croise quelqu'un qui a besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Comme vous le savez, les sculptures en sucre à moitié mangées sont difficiles à conserver. Tout ce que je peux faire, c'est les envelopper dans un tissu et les glisser dans ma poche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Mais le temps d'aider tout le monde et de la ressortir, tout a déjà fondu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Je vois... Laissez-moi réfléchir. Une petite sculpture en sucre... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Je sais ! Je peux faire une petite sculpture avec plusieurs saveurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Cette saveur en dessous... puis celle-ci par-dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "Et voilà ! Une mini-sculpture en sucre multi-saveurs, rien que pour vous ! Est-ce que cela vous convient, cher client ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Ah, c'est parfait ! Merci, mademoiselle Hunajatta !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Oh, ne me remerciez pas. Je ne peux peut-être pas vous aider dans votre travail de ratniki... mais si vous voulez des sculptures en sucre, je peux en faire autant que vous le souhaitez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "C'est notre travail. Vous êtes trop aimable, mademoiselle Hunajatta... Je vais vous laisser, j'ai encore du travail qui m'attend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "D'accord, prenez soin de vous ! Si vous voulez une sculpture en sucre, venez directement me voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
