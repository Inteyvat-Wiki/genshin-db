					"id": 760380607,
					"content": "Je ne comprends pas. Je n'ai pas besoin d'autant de sucre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "Je soupçonne qu'Aino mangera cette sculpture quand j'aurai le dos tourné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380609,
					"content": "...",
