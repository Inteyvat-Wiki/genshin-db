			"dialogs": [
				{
					"id": 760381109,
					"content": "(<color=#FFCC33FF>Linnea</color> serait intéressée par les sculptures en sucre ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Oh bonjour, mademoiselle Linnea ! Vous venez acheter des sculptures en sucre pour Lumi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Oui, Lumi adore tellement vos sculptures en sucre qu'elle n'arrive pas à se résoudre à les manger. Chaque fois qu'elle en reçoit une, elle se contente de la lécher un peu puis me la rend pour que je la garde en sécurité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Mais comme une sculpture en sucre est faite de sucre... elle finit par fondre de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Pourriez-vous en refaire une pour Lumi s'il vous plaît, mademoiselle Hunajatta ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Pas de problème ! Un instant, s'il vous plaît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Lumi est tellement adorable... J'aimerais tant la caresser ! Mais ce serait plutôt impoli de faire ça. Tant pis...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Voilà, mademoiselle Linnea. C'est prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
