						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Aino ! Ça faisait longtemps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Héhé. Je suis de passage au Village de Nasha pour faire des réparations. Du coup, j'en profite pour faire le plein de sucreries !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Ineffa n'est pas là, alors préparez-moi-en quelques-unes en plus... et faites-les bien sucrées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Aucun problème, mais... n'oubliez pas de vous brosser les dents après les avoir mangées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Je sais, je sais. Je me brosse toujours les dents après avoir mangé des sucreries. Mes dents sont en bonne santé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
