					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(<color=#FFCC33FF>Lauma</color> est peut-être intéressée par les sculptures en sucre ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Pourriez-vous me fabriquer quelques sculptures en sucre, mademoiselle Hunajatta ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Pas de problème, madame Lauma. Les enfants ont-ils aimé celles que vous avez ramenées la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Oui, haha. Certains d'entre eux ne voulaient pas les manger jusqu'à ce qu'elles fondent presque complètement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Je vois... La prochaine fois, je viendrai chez vous avec mes ustensiles pour en faire sur place pour les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Ce serait adorable. Les enfants seront contents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Oh, je m'égare. Je vais me mettre au travail. Une fois que les sculptures seront terminées, je les ferai livrer aux Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Mais avant ça... J'ai une idée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Veuillez patienter un instant, madame Lauma. Je vais vous préparer une sculpture spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
