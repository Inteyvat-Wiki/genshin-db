			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(<color=#FFCC33FF>Nefer</color> serait intéressée par les sculptures en sucre ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "Je vais vous prendre une sculpture en sucre, Hunajatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380103,
					"content": "Quelle surprise de vous voir ici, madame Nefer. Qu'est-ce qui vous amène aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "Une promenade de temps en temps ne fait pas de mal au corps et à l'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380105,
					"content": "Je me suis dit qu'un peu de sucre m'aiderait à mieux réfléchir aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380106,
					"content": "Ravie de l'entendre ! Un instant, je reviens avec votre commande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "Pas de problème. D'ailleurs, prenez cet argent. La prochaine fois que Jahoda vient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380108,
					"content": "Devrais-je lui faire une plus grande sculpture ? La rendre plus sucrée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "... Donnez-le-lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380110,
					"content": "Et dites-lui : « Nefer paie le double, alors revenez vite quand vous aurez fini de tirer au flanc. Prenez une sculpture en sucre pendant que vous y êtes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
