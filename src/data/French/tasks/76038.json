					"nextDialogs": [
						760380702
					]
				},
				{
					"id": 760380702,
					"content": "Une sculpture extra-large, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Ce n'est pas la première fois que vous venez ici, Jahoda. Vous savez bien que la taille de nos sculptures en sucre est fixe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Allez, la chance me sourit aujourd'hui ! Dépêchez-vous, faites-m'en une juste un peu plus grande que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "La chance vous sourit ? J'imagine que votre mission s'est bien passée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Héhéhé, bien sûr. Ce n'était qu'une simple mission d'escorte, rien de plus facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Le client n'a pas perdu un seul cheveu, et la cargaison est intacte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Bon, trêve de bavardages. Accélérez un peu, finissez cette sculpture en sucre. Ce sera à emporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "Pas de problème. Un instant...",
					"roleType": "TALK_ROLE_NPC",
