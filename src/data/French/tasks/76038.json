					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "Excusez-moi. Pourrais-je en avoir une, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Bien sûr. C'est pour Aino ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Non, Aino m'a dit de venir ici pour m'acheter une belle sculpture en sucre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "D'après ses dires, cela fait partie de ma « sociabilisation », et me permettra de faire des achats plus facilement à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Je vois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
