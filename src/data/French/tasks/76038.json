			"dialogs": [
				{
					"id": 760380409,
					"content": "(<color=#FFCC33FF>Flins</color> serait intéressé par les sculptures en sucre ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Mademoiselle Hunajatta, pourriez-vous me faire une sculpture en sucre, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Bien sûr... Vous êtes monsieur Flins, le ratniki ? J'ai l'impression de vous avoir déjà vu dans notre boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Effectivement, je passe faire des achats de temps en temps. Je suis honoré que vous vous souveniez de moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Aujourd'hui, j'ai pu observer votre talent remarquable en passant devant la boutique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "Après mûre réflexion, j'ai décidé de vous demander de me fabriquer une sculpture en sucre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Vous me flattez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Patientez un instant, je reviens avec votre commande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Hmm... Peut-être que je devrais créer quelque chose de spécial pour le ratniki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
