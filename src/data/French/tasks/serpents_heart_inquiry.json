			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "Mon nom est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490302,
					"content": "Aberaku, créateur d'Helios !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490303,
					"content": "C'est quoi « Helios » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490304,
					"content": "Est-ce que c'est impressionnant comme chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490305,
					"content": "Et comment ! J'ai mené sa construction avec la force de tout un peuple pour résister contre les héritiers du dragon abyssal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490306,
					"content": "Cette prouesse n'aurait jamais pu être réalisée par un autre que moi au sein de Byakuyakoku !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490307,
					"content": "Oh, ça a l'air très impressionnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490308,
					"content": "Mais qu'est-ce qu'un illustre personnage comme vous fait enfermé ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490309,
					"content": "J—J'ai été trahi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490310,
					"content": "Lorsque le royaume du ciel s'est écrasé dans les profondeurs abyssales, le peuple a été attaqué par des dragons, et c'est ainsi que j'ai, oui moi, commencé à construire l'Helios pour nous sauver tous d'un destin périlleux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490311,
					"content": "Mais... ces vauriens ! Dès que leurs vies n'ont plus été en danger, ils ont commencé à faire usage de la tromperie et des mensonges. Ils ont même préconisé de placer des enfants sur le trône. Ridicule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490312,
					"content": "Je suis devenu à mon tour la cible de leurs complots ! Ils m'ont laissé pourrir en prison !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490313,
					"content": "Scélérats ! Crapules !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490314,
					"content": "... J'oubliais. Vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490315,
					"content": "Moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "C'est vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490320,
					"content": "Ça ne peut être que vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490321,
					"content": "Mes habits sacrés se trouvaient ici, mais ils se sont désintégrés avec le passage du temps et sont devenus inutilisables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490322,
					"content": "Si vous réussissez l'épreuve, je vous laisserai repartir avec les offrandes qui contiennent mes pensées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490323,
					"content": "J'espère que vous triompherez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490324,
					"content": "#Cette entreprise est périlleuse. Faites-moi savoir lorsque vous êtes {M#prêt}{F#prête} avant de commencer, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490317,
					"content": "Il te parle, Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "C'est clairement à toi qu'il s'adresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490319,
					"content": "(Avec un regard intense, qui plus est.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
