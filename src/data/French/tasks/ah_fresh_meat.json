				{
					"id": 701060201,
					"content": "La viande congelée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Oui, cette viande congelée a l'air succulente... Eh bien, il ne reste plus qu'un ingrédient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Avez-vous entendu parler du Roi sanglier des neiges ? On dit que c'est une bête qui vit au fin fond des Monts Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Beaucoup de recettes vantent la qualité de sa viande, disant qu'elle convient à tout, peu importe la méthode de cuisson...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous m'aider à accomplir cette tâche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Et ma récompense...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Bien sûr, j'ai déjà mis de côte de quoi vous rémunérer. Bon, je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
