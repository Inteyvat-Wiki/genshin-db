			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Encore quelques ingrédients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "#Hmm ? Oh, {M#voyageur}{F#voyageuse} ! Je suis juste en train de réfléchir à une « recette classique ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Il n'y a pas longtemps, une expédition s'est aventurée sur les Monts Dosdragon, et un de mes amis aventuriers en faisait partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Ils ne sont pas allés bien loin, à cause des terribles conditions météorologiques. Mais mon ami m'a raconté qu'ils s'étaient abrités de la tempête dans d'anciennes ruines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Elles étaient remplies de manuscrits et de parchemins, et même... d'une recette de cuisine ! Et en plus, elle était bien conservée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Mon ami m'a transmis la recette, en espérant que j'arriverais à ressusciter cette délicatesse d'antan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Pour être honnête, je n'ai même jamais entendu parler de la plupart des ingrédients qui y sont mentionnés. Même certaines des méthodes décrites me sont inconnues !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Donc, j'ai un peu modifié la recette, tout en conservant les ingrédients de base...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "#Seriez-vous {M#prêt}{F#prête} à m'aider à récupérer ces ingrédients spéciaux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Je m'en charge !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Oh, quel enthousiasme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "J'ai entendu parler de sangliers qui ont fini congelés après s'être égarés dans la montagne. Je me demande... quel goût leur viande peut avoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Donc, j'aimerais que vous trouviez ces bêtes. Si vous pouviez me ramener dix portions de viande congelée, ce serait parfait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Hein ? De la viande congelée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Ah, c'est le nom que j'ai donné à cette viande de sanglier. Comme le sanglier est congelé dans la glace et qu'il conserve toute sa saveur, alors c'est de la viande congelée ? Haha, c'est bien trouvé, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Bon, je vous remercie. Apportez-moi les ingrédients dès que vous mettrez la main dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "De quels ingrédients avez-vous besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
		{
