			"dialogs": [
				{
					"id": 3600101,
					"content": "Pff, ce n'était que du menu fretin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600102,
					"content": "Mais je dois avouer que ton aptitude au combat m'a étonnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600103,
					"content": "Merci pour ton aide. Comment tu as trouvé ce combat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600104,
					"content": "Fastoche !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "Tant qu'on en parle... Comment ça se fait que ces Brutocollinus soient ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600107,
					"content": "Leurs camps sont éloignés des villes en général...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600108,
					"content": "Tout à fait. Normalement ils préfèrent camper dans la nature sauvage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600109,
					"content": "Mais avec les apparitions fréquentes du dragon Stormterror, nos vergers ont été détruits, et les voies commerciales en pâtissent aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600110,
					"content": "Ses attaques font toujours quelques blessés... Les chevaliers de l'Ordre de Favonius ne peuvent rien faire d'autre qu'assurer la défense de la zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600111,
					"content": "Et c'est ce qui a permis aux créatures indésirables de s'installer de plus en plus près ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600112,
					"content": "Voilà. Cela dit... Il y a pas mal d'objets à récupérer dans ce camp !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600113,
					"content": "Suivez-moi ! Je me dois de vous escorter jusqu'en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600105,
					"content": "Un peu plus difficile que prévu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
