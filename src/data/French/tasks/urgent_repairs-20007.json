			"dialogs": [
				{
					"id": 200070401,
					"content": "Vous m'avez encore sauvé ! Ces monstres sont persistants... Qu'est-ce qu'ils peuvent bien vouloir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070402,
					"content": "Draff est vraiment bon... Il a réussi à chasser ce gibier rare. *soupir* Si seulement je pouvais être comme lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070403,
					"content": "Il faut déjà que je ramène tout ça à Mondstadt d'abord.",
