			"dialogs": [
				{
					"id": 200070101,
					"content": "#Merci, {NICKNAME} ! Heureusement que vous êtes {M#passé}{F#passée} par là... J'ai cru que j'allais mourir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070102,
					"content": "Cette charrette transporte tout ce que les chasseurs ont réussi à chasser aujourd'hui. Draff m'a demandé de tout livrer à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070103,
					"content": "Je ne suis pas le meilleur chasseur, mais je pensais qu'une petite livraison serait un jeu d'enfant... Faut croire que je me suis planté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070104,
					"content": "Tout s'est passé si vite ! Ils voulaient la marchandise, c'est sûr... Vous m'avez sauvé la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070105,
					"content": "Je vous en demande sûrement trop, mais... Ma charrette a été abîmée pendant l'attaque, et je n'ai aucun autre moyen de partir d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070106,
					"content": "La forêt regorge de matériaux qui me permettront de la réparer, mais je ne peux pas laisser ma marchandise seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070107,
					"content": "Si ça ne vous dérange pas, pourriez-vous aller me chercher une <color=#00E1FFFF>planche solide</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alan"
				}
			]
		},
