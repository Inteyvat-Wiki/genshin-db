					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070404,
					"content": "Je suis navré, mais les monstres ont causé des dégâts supplémentaires sur la charrette avec cette nouvelle attaque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070405,
					"content": "La situation va empirer si je reste ici ! Je dois la réparer tout de suite. Il y avait de la corde à l'arrière, mais on me l'a volée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 200070406,
					"content": "Pourriez-vous m'aider à trouver de la <color=#00E1FFFF>corde</color> ?",
					"roleType": "TALK_ROLE_NPC",
