			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "Les frères ont bien réfléchi à leurs erreurs. Le Festival Utsava est un jour joyeux. Arapacati ne doit plus être en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Oui, ne te fâche pas, Arapacati. Les jours joyeux doivent être célébrés avec le goût de la joie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "Il est temps de présenter les fruits de l'entraînement culinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Tout est prêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "C'est le festin du Festival Utsava, génial ! J'ai longtemps attendu ce moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "C'est le festin du Festival Utsava ! Chouette !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "L'eau de Vanarana est la meilleure de toutes, avec ça, on peut faire la meilleure des soupes. Les naras vont adorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Si l'on veut offrir le goût de la joie à nara {NICKNAME} et Paimon, il faut les laisser guider les frères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "C'est la seule façon de préparer un plat qui satisfasse les naras. C'est ainsi que les invités doivent être reçus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Nara {NICKNAME}, veux-tu bien guider les frères pendant qu'ils cuisinent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "N'en attends pas grand-chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
