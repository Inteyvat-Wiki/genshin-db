					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "Du « départ » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Le batelier me rend visite régulièrement ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Il vient ici furtivement, vêtu de ses habits en fourrure, de son long pantalon et d'une couronne de soie, tous de couleur dorée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "Tout comme ma mère me l'avait dit, et comme je l'ai dit à Kito et Kina... Il vient pour nous emmener à bord de son bateau argenté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "Le bateau naviguera sur la rivière scintillante, au pays des rêves... Là-bas, plus aucun brouillard, mais un grand hall doré avec soixante-dix berceaux... et encore soixante-dix autres qui se balancent... d'avant en arrière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Là, nous sommeillerons et deviendrons des amas de lumières... ainsi que les rêves des enfants de ce monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Ouah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Le batelier m'a dit qu'il m'avait apporté ceci de la part de Kito et Kina... Ah, ces deux-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Ce n'est pas encore l'heure, non... Pas encore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "Vous voulez donc dire que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#C'est moi, {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
