			"dialogs": [
				{
					"id": 722040401,
					"content": "Allez vous amuser pour l'instant... Je reste ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "Pétales... Petits pétales... De quelle contrée venez-vous ?",
					"roleType": "TALK_ROLE_NPC",
