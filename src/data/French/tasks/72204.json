			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "Abe, c'est toi ? Comment vont tes champignons ? Haha... Ne va pas encore déranger le prêtre. Il peut me le demander autant de fois qu'il le voudra, mais je ne donnerai jamais mon accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040502,
					"content": "Haha ! Désolée, mais je suis déjà très débordée rien qu'en m'occupant de cette maison. Pardon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040503,
					"content": "Je m'excuse... *soupir* ... Désolée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040504,
					"content": "Bonjour grand-mère.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "Ah, c'est toi ! Viens ici tout de suite avant de nous ridiculiser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040507,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Comment s'est passé la pêche ? Rien n'a mordu à l'hameçon ? ... Tant pis, les récoltes de notre jardin devraient être suffisantes. Enfin, il n'y en aura pas assez pour l'offrande à l'Oiselle du tonnerre... Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040510,
					"content": "Qu'est-ce que tu racontes ?! La cérémonie de cette année s'est bien déroulée ! Celle de l'année prochaine ne fera pas exception. Le prêtre a même dit que nous aurons un enfant en bonne santé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040511,
					"content": "Pourquoi faut-il que tu parles de ça ?! As-tu oublié ce qui est arrivé aux Kama ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040512,
					"content": "Calmez-vous !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Si tu veux renier l'Oiselle du tonnerre et te faire engloutir par les vagues, ce n'est pas moi qui vais te retenir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040515,
					"content": "Mon enfant... Mon pauvre enfant... *soupir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040513,
					"content": "Kama ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "Comment allez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
