			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Bonjour, bonjour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "*soupir* Pardonnez-moi, mais ma mémoire me joue des tours avec l'âge. Qui êtes-vous déjà ? Est-ce que je vous connais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Je suis {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "#Je n'ai jamais entendu de nom pareil dans les environs. Êtes-vous {M#étranger}{F#étrangère} à cette île ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "C'est très étrange. Vous n'auriez pas dû pouvoir venir sur l'île sans la permission de l'Oiselle du tonnerre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "L'Oiselle du tonnerre n'est plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "*soupir* Vous me rappelez mon pauvre mari... mais je ne me souviens même plus de son visage à présent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Nos esprits étaient pleins de fantaisies quand nous étions jeunes. Certains ne grandissent jamais. Pas même quand vous avez passé le clair de votre vie avec eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Mon mari m'a quittée et s'est construit un radeau en bois pour traverser la mer dans le but d'atteindre l'île des étrangers... Il m'a dit qu'il voulait chasser en toute liberté et cueillir des fleurs qu'il n'avait jamais vues... de jolies fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "C'est ce qu'il répète depuis toujours... mais il n'a jamais abandonné cette idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Ensuite, le fils du prêtre l'a trouvé gisant sur la plage... aussi silencieux que les coquillages et aussi blanc que le sable, avec ces fleurs dans le creux de sa main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "Le prêtre a pleuré à grandes larmes en disant que... le bateau de nos ancêtres l'avait rejeté et que son âme allait errer sur les terres étrangères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "Notre fils venait de naître à ce moment... Comment allais-je le lui apprendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Plus tard, mon fils a aussi eu des enfants, puis je l'ai envoyé sur ce bateau argenté... pendant que j'ai continué à vivre sur l'île...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Kito et Kina sont les seuls qui me retiennent ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "C'est une longue histoire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Bonjour, vous pouvez m'appeler {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
