			"dialogs": [
				{
					"id": 722040301,
					"content": "*soupir* Rien n'est clair, tout devient de plus en plus flou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Bonjour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "*soupir* Ma mémoire empire de jour en jour. C'est la vieillesse, je suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Mais qu'est-ce que je peux faire ? Je ne sais pas si Kito et Kina ont faim ou s'ils sont en sécurité lorsqu'ils s'amusent dehors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Ils s'en sortiront.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Kito ! Kina ! Vous êtes là... Est-ce que vous êtes tombés sur le chemin ? Ne me dites pas que vous avez encore grimpé sur des arbres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Je me fais vraiment un sang d'encre pour vous ! *soupir* J'ignore ce qu'il se passe sur l'île dernièrement, mais j'ai l'impression qu'il y a de moins en moins d'habitants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "Je ne me souviens plus très bien d'eux aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "*soupir* Que deviendrai-je si je vous oubliais aussi tous les deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "*soupir* Prenez ces pétales de fleurs. Vous me les montrerez si j'en viens à vous oublier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Il y a tant d'histoires que j'aimerais vous raconter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Est-ce que je peux vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Il s'est passé quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
