			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina, vous êtes revenus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "Vous devriez vraiment arrêter de courir dans tous les sens. Mes vieilles jambes n'arrivent pas à suivre ! Et qu'est-ce que je vais faire si vous vous attirez des ennuis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "Bonjour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "Quoi ? Allons, comment pouvez-vous dire une chose pareille à une vieille dame, les enfants ? Vous allez me briser le cœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "Maintenant que vous êtes là, n'allez pas vous aventurer je ne sais où. Tenez-moi un peu compagnie, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "#{M#Désolé}{F#Désolée}, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Où en étais-je dans l'histoire que je vous racontais ? Ah, oui... Votre arrière-arrière-grand-père était encore jeune à l'époque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Au-delà de la mer de brouillard sur une île peuplée d'étrangers, vivait le Clan Sumari. Des rumeurs disaient que la matriarche de ce clan avait l'apparence d'un renard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "On raconte qu'il y avait des fleurs de la couleur de la foudre sur cette île et que le Clan Sumari y avait construit des habitations et qu'il y vivait en parfaite harmonie avec les montagnes et les plaines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "Puis... ces fleurs... Zzzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "*ronfle* Au-delà de la mer de brouillard... Oui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "Hum... Vous allez bien, grand-mère ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Oh ? Kito ? Kina ? Vous vous en allez ? *soupir* Je suis désolée, j'ai dû m'assoupir une fois de plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Prenez ça avant de partir... Je les ai gardées pour vous pendant tout ce temps. Ce sont des fleurs d'au-delà de la mer de brouillard, ne les perdez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(Il vaut mieux ne pas la déranger...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Vous vous trompez de personne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
