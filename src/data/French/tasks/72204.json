			"dialogs": [
				{
					"id": 722040201,
					"content": "Bien, je crois que j'ai besoin de piquer un petit somme... *ronfle*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Una"
				},
				{
