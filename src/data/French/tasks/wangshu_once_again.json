				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Et comme d'habitude, à chaque festival, on ne sait plus où donner de la tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200202,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "C'est l'auberge ! Beaucoup de gens sont rentrés chez eux pour le Festival des lanternes... Alors, on manque de bras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200204,
					"content": "Il faut accueillir les clients, décorer l'auberge, et puis aussi finir les préparations pour les fêtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200205,
					"content": "Sans oublier non plus les tâches quotidiennes... Yanxiao ne va bientôt plus s'en sortir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200206,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pourriez lui donner un coup de main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200207,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "Merci bien ! Vous pouvez aller le voir dans la cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200209,
					"content": "J'ai encore des trucs à finir ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "Qui va là ! C'est privé ici... Oh, c'est toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200302,
					"content": "Il te faut quelque chose ? Si tu as faim, ça va devoir attendre un peu, je suis débordé là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200303,
					"content": "Je suis là pour t'aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "Tu viens m'aider ? Eh bien, c'est pas de refus alors ! Il y a largement de quoi faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200306,
					"content": "Va en bas, sous l'auberge, et apporte-moi les ingrédients qu'on vient de livrer, d'accord ? J'en ai besoin d'urgence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200307,
					"content": "Et puis au passage, accroche ces lanternes aux deux arbres à l'entrée de l'auberge... Avant que la patronne ne me tire encore les oreilles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718200304,
					"content": "Est-ce que je peux t'aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "Alors, comment ça s'est passé ? Vous avez pu tout terminer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718201502,
					"content": "Mission accomplie !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Merci, ça m'aide bien. Bon, je dois vite finir ces plats, il ne faut pas faire attendre les clients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "Vous revoilà ! Et Yanxiao alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "Ça va mieux maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "Bien, bien. Merci de l'avoir aidé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Rien ici non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201605,
					"content": "Oh, Wangya ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Quelle coïncidence, je ne pensais pas vous croiser ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201608,
					"content": "Livrer des lanternes célestes ? Oui, si on veut. Vous avez entendu parler du Village de Qingce ? Il est assez éloigné de la ville, et est habité surtout par des vieux et des enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201609,
					"content": "Chaque année pendant le Festival des lanternes, le Bureau des affaires civiles envoie quelqu'un pour leur apporter des provisions de fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201610,
					"content": "Le premier lot a déjà été livré, mais j'aimerais faire quelque chose de plus pour rendre l'ambiance du village un peu plus festive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201611,
					"content": "Du coup, j'ai demandé à Qingzhou d'utiliser ses talents de poète pour composer des énigmes pour les enfants du village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201612,
					"content": "Qingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Ça ne devrait pas lui poser de problème, il est si doué avec les mots. Et puis, je voulais aussi demander son aide à Bohuanzi, comme il a un vrai talent pour la calligraphie... Ce serait bien s'il pouvait aider les villageois pour leurs lanternes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201615,
					"content": "Mais impossible de le trouver... Quelqu'un m'a dit qu'il était allé au Marais Dihua, alors je viens le chercher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201616,
					"content": "Peut-être que la patronne est au courant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Bohuanzi ? Voyons voir... Il est arrivé à l'auberge il n'y a pas longtemps, en disant qu'il avait des trucs à récolter à proximité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "Mais bon... Avec tous les monstres qui rôdent dans les parages, je ne serais pas surprise s'il avait quitté la zone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "Je vois... Mais je lui ai demandé qu'on se retrouve à l'Auberge Wangshu. Il ne va pas tarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201621,
					"content": "#{M#Voyageur}{F#Voyageuse}, pouvez-vous m'aider à retrouver Bohuanzi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201622,
					"content": "Je m'en charge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Je vous remercie ! Moi, j'attendrai Qingzhou ici, j'ai encore des choses à lui dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201624,
					"content": "*soupir* ... Il y a tellement de choses à faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201617,
					"content": "Patronne, à propos de Bohuanzi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Hein ? Il n'avait pas accepté le duel de Vermeer ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Vous êtes là pour livrer des lanternes célestes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
