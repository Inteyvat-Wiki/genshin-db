				{
					"id": 718202101,
					"content": "Vous avez retrouvé Bohuanzi ? Qu'est-ce qu'il a dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202102
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202102,
					"content": "Il est d'accord, mais il viendra dans un moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "Parfait ! De mon côté, j'ai croisé Qingzhou, mais il avait l'air préoccupé... Il est allé se promener dehors en disant qu'il cherchait de l'inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202104,
					"content": "#Merci pour votre aide, {M#voyageur}{F#voyageuse} ! Je vais attendre Bohuanzi pour lui expliquer plus en détail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202105,
					"content": "Ensuite, je retourne au Port de Liyue pour finir deux trois affaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202106,
					"content": "On dirait que je vais encore devoir faire pas mal d'allers-retours entre l'Auberge Wangshu et le Port de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202107,
					"content": "Quand tout sera réglé, nous irons au Village de Qingce. Si vous voulez, vous pouvez nous rejoindre là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202108,
					"content": "Ah, si seulement je pouvais finir tout ça plus rapidement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				}
			]
