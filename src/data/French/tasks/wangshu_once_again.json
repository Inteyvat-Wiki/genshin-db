					"Bohuanzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Merci, merci ! Oh... Quelle insouciance de ma part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201902,
					"content": "Qu'est-ce que vous faites ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Je suis venu trouver l'inspiration et du matériel... On est en plein festival, j'ai envie d'écrire quelques vers bien trouvés à offrir à mes amis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201904,
					"content": "Je voulais me promener un peu dans les environs pour trouver du matériel qui me permettrait de confectionner une encre spéciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201905,
					"content": "Je ne m'attendais pas à tomber sur un tas de monstres, vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201906,
					"content": "Et la requête de Wangya ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Aider les gens de Qingce, dites-vous, avec leurs lanternes ? Avec plaisir. Vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201908,
					"content": "Le Village de Qingce... Si je me souviens bien, c'est plein de personnes âgées là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201909,
					"content": "Bon, je sais... Vous m'aidez à trouver un morceau de cœur de lapis et une fleur de Qingxin, et je prépare de l'encre avant d'y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201910,
					"content": "On peut faire de l'encre avec ces trucs ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Haha, vous manquez d'expérience, je vois ! En poudre, le cœur de lapis peut se dissoudre dans l'encre pour lui donner une légère teinte dorée, une couleur propice en cette période de fête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201912,
					"content": "Le nectar de fleur de Qingxin, quant à lui, peut se combiner à l'odeur de l'encre pour produire un délicat parfum. Tant que l'encre est de bonne qualité, ces deux odeurs se complètent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201913,
					"content": "On en apprend tous les jours...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Oh, ce n'est vraiment pas grand-chose... Si vous saviez comment certains professionnels préparent leur encre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201916,
					"content": "Mais faisons simple cette fois-ci. Venez me trouver quand vous aurez récupéré ce qu'il faut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201917,
					"content": "Il faut que je me repose un moment. Cette attaque m'a mis tout de travers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201914,
					"content": "Ça a l'air compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
