				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "Une brise venant du sud a soufflé sur l'Île de Watatsumi aujourd'hui. C'était un signe certain que des amis allaient nous rendre visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "À chaque fois que vous dites un truc comme ça, on se retrouve avec quelque chose à faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Oh, ne dites pas ça. Notre collaboration a plutôt été fructueuse jusqu'ici, des plus fructueuses même, je dirais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "Cela dit, j'ai quelque chose à vous demander...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "On raconte dans ma famille qu'en plus du rituel sacré de Watatsumi, nous avons également ajouté une série d'épreuves différentes, sans rapport avec la survie de l'Île de Watatsumi, mais plutôt avec la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "Une autre... série d'épreuves ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Maintenant que l'île n'est plus sous la menace, je voudrais juste vous dire ceci. Vous pouvez considérer cela comme une mission ancestrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "Allez à l'endroit que l'on appelle le Cœur du serpent. C'est là que se cachent les indices sur cette deuxième série d'épreuves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "... Eh bien, quel soulagement ! Je suppose que je peux désormais confier cette responsabilité écrasante à ma future fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "... C'est comme ça que vous honorez votre mission ancestrale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "Même après tout ce temps, je ne vous comprends toujours pas, Tsuyuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}