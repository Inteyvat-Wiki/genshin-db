			"dialogs": [
				{
					"id": 210202001,
					"content": "« Tout ce charabia sur un feu qui exaucerait les vœux ne veut rien dire ! Par contre, le trésor qui s'y trouve lui est bien réel... La Cheffe m'a dit de laisser le message où je l'ai trouvé et d'attendre pas loin. Dès que quelqu'un se pointera et que le feu partira... Héhéhé, un vrai coup de génie, y a pas à dire. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210202002
					],
					"speakerTitle": "Notes rapides"
				},
				{
					"id": 210202002,
					"content": "« Mais il y a tellement de trésors, ça ne sera pas facile à transporter en une fois. La Cheffe m'a dit d'enterrer tout ça <color=#00E1FFFF>au plus haut sommet de la Pente Cuijue</color>. Il y a un arbre tout racorni là-bas, elle ne le ratera pas... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes rapides"
				}
			]
