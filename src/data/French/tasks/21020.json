			"dialogs": [
				{
					"id": 210200001,
					"content": "« ... Voilà à quoi mène la cupidité, j'imagine. À trop en vouloir, on oublie quand il faut s'arrêter... J'aurais pu partir après avoir trouvé le trésor souterrain, mais il a fallu que j'aille voir ce stupide feu soi-disant magique. Je n'ai pas vu le mécanisme, et maintenant me voilà dos au mur avec cet horrible monstre qui me bloque. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210200002
					],
					"speakerTitle": "Lettre abîmée"
				},
				{
					"id": 210200002,
					"content": "« Si vous avez le courage de l'affronter, allez ensuite faire un vœu à ce feu. Je vous aiderais bien, mais... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lettre abîmée"
				}
			]
