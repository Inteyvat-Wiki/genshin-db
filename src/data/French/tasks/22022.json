			"dialogs": [
				{
					"id": 220220301,
					"content": "Liyue est célèbre pour sa viande façon Dubhe. Voyons voir... Hmm, Xudong a encore gribouillé dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "« Éplucher et cuire les pommes de terre à la vapeur avant de les écraser à chaud et de les mélanger à de l'huile et du sel. Les mettre dans un bol, puis napper d'une sauce épaisse à base de farine. La première bouchée a le goût de viande molle. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "La première bouchée... Est-ce que ça veut dire que vous sentez la différence après quelques bouchées ? Allez, ce n'est qu'une astuce pour tromper ceux qui n'ont jamais mangé d'authentique viande façon Dubhe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "#Enfin bon... Dites, {M#voyageur}{F#voyageuse}. Je voudrais savoir de quels autres ingrédients a-t-on besoin pour cuisiner cette viande façon Dubhe, à part la viande crue, le sucre et les matsutake ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
						220220306,
						220220308,
						220220309
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220305,
					"content": "Du muguet bleu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220310,
					"content": "Hmm... Ah bon ? Laissez-moi le noter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220306,
					"content": "Des fleurs de Qingxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220307
					]
				},
				{
					"id": 220220307,
					"content": "Hmm... Ah bon ? Laissez-moi le noter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220308,
					"content": "Des gueules-de-loup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220309,
					"content": "Du lys calla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				}
			]
		},
