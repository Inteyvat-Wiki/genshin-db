					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "Il existe un plat mondstadtois appelé « ragoût de pommes du nord » et Xudong a encore fait des siennes sur la recette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "« Le beurre est cher et la viande crue est difficile à conserver, alors pourquoi ne pas pétrir la pâte, laver le gluten, puis faire cuire le gluten à la vapeur et le parfumer avec des légumes et des fruits pour lui donner un bon goût ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Mais enfin, c'est pas si cher que ça le beurre. Et pourquoi ne pas directement acheter de la viande fraîche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "#Enfin bon... Dites, {M#voyageur}{F#voyageuse}. Y a-t-il un autre ingrédient dans ce ragoût de pommes du Nord en plus des pommes, du beurre et de la viande crue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Des amandes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Hmm... Ah bon ? Laissez-moi le noter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Du poivre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Hmm... Ah bon ? Laissez-moi le noter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Piment de Jueyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Jambon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
		{
