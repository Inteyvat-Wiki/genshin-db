			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Cette recette devrait être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "Que faites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Je suis en train de trier les recettes... Hum, mais je ne me souviens pas très bien de certaines d'entre elles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Pourquoi ne pas demander directement à Xudong ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Xudong... Si je ne me souviens pas de ces recettes, c'est justement à cause de toute la « nourriture créative » qu'il cuisine à longueur de journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Chaque fois qu'il a une nouvelle recette, il ne la suit que pendant un jour ou deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Ensuite, il commence à les « modifier » de différentes manières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Pourquoi fait-il ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Selon lui, c'est pour rendre le coût des plats moins cher ou quelque chose comme ça... mais je ne suis pas vraiment sûre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Mais de toute façon, à en juger par les résultats, il a réussi son pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Ses plats avaient à peu près le même goût que les originaux, mais étaient bien moins chers à préparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "J'ai accepté de voyager avec lui pour sa technique culinaire hors du commun. Et lui était intéressé par mes compétences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Que voulez-vous que je fasse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Oups ! Je parle de Xudong, et j'en ai presque oublié l'essentiel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Xudong me tanne toujours pour modifier ces recettes. Il écrit et dessine directement dessus parfois aussi... Certaines sont quasiment illisibles maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "J'aimerais la version originale de ces recettes pour en garder un exemplaire au cas où on aurait besoin de comparer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "#{M#Voyageur}{F#Voyageuse}, si vous vous souvenez de ces recettes, pouvez-vous m'aider à m'en souvenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Merci. Je vais d'abord trier les recettes qui ont été gribouillées et vous n'aurez qu'à corriger légèrement les parties pas très claires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "On peut dire que j'en ai mangé des plats en Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Vos compétences ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Je ne vous en ai pas parlé avant ? Mon sujet de recherche à l'Académie est l'« assaisonnement suprême ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Pour faire simple, c'est un assaisonnement qui peut rendre n'importe quel plat délicieux, peu importe ce qu'il y a dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "Afin d'effectuer des recherches sur cet assaisonnement, j'ai effectué un voyage d'étude pour recueillir des informations sur différentes cuisines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Hum, revenons à nos recettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Comment les a-t-il modifiées exactement ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Eh bien... Sa démarche est différente de celle des autres chefs. La plupart d'entre eux revisitent leurs recettes pour les rendre plus sophistiquées pour que leurs plats puissent être vendus plus cher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Mais Xudong semble avoir une tout autre idée en tête lorsqu'il transforme ces recettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Par exemple, il a préparé un plat végétarien avec des pommes de terre, des champignons et d'autres légumes bon marché, mais ça avait le goût du poulet pimenté de Jueyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "Puis, il y a eu la version simple de l'attrape-Adepte avec des pommes de terre, du riz, des fruits du lotus, des piments de Jueyun, de la pâte et de la viande crue, qui avait le même goût que l'original...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Vous n'êtes pas l'équipe des « Gourmets suprêmes » ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "S'il vous plaît, arrêtez de prononcer ce nom. Il n'apparaîtra jamais dans ma thèse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "D'ailleurs, si je ne me souviens pas de ces recettes, c'est surtout à cause de toute la « nourriture créative » que Xudong cuisine à longueur de journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
