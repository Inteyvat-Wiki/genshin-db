			"dialogs": [
				{
					"id": 741500301,
					"content": "Vous avez terminé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "On a tout nettoyé, et Molli a nourri le chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Benoît, il y a un tas de caisses très sales à côté de la maison. Est-ce qu'il faudrait les nettoyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Les caisses... Oh, ce n'est pas nécessaire, je les utilise seulement pour stocker des vieilleries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500306,
					"content": "Il y a des meubles et des petits objets d'avant mon emménagement que je ne voulais pas jeter. Vu qu'ils ne correspondent pas au style de décoration intérieure de la maison, je les ai tous entassés dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500307,
					"content": "Je ne les bouge presque jamais, et ceux qui vivent ici ne vont pas me les voler. C'est pour ça que je peux y laisser mes souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500308,
					"content": "Monsieur Leroy, monsieur Leroy, je vous ai été utile ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500309,
					"content": "Tu m'as beaucoup aidé, Molli. N'oublie pas de saluer tes parents de ma part, je t'en serai très reconnaissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500310,
					"content": "J'ai préparé des friandises et votre argent de poche, les enfants. Venez les prendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500311,
					"content": "Ce n'est pas nécessaire, je n'ai pas besoin d'argent. Par contre, j'aimerais juste caresser Nana encore un peu. Est-ce que je peux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500312,
					"content": "Bien sûr, vas-y. Attention à ne pas te faire griffer, et n'oublie pas de venir prendre quelques friandises quand tu auras fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500313,
					"content": "Père, qu'est-ce que vous faites dehors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500314,
					"content": "Puisque mes enfants ne sont pas avec moi à la maison, je me sens esseulé. Sortir me permet de prendre un bon bol d'air frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500315,
					"content": "Morticia, regarde, on n'est partis que quelques jours, et ton père nous en veut déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500316,
					"content": "Je suis sûr qu'il pardonnerait notre absence s'il voyait le cadeau qu'on lui a apporté cette fois-ci. Qu'en penses-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Un cadeau ? Qu'est-ce que vous avez apporté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500319,
					"content": "Quelque chose de superbe. Vous le saurez quand vous le verrez, père. Morticia sait que vous aimez les belles choses qui valent une fortune. Elle l'a spécialement choisi pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500320,
					"content": "Merci, ma fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500321,
					"content": "C'est la moindre des choses que je puisse faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "#Ah, au fait, ces deux {M#invités}{F#invitées} sont les enfants qui sont venus me tenir compagnie lorsque vous vous étiez absentés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500323,
					"content": "Bonjour vous deux, mon père est quelqu'un de très chaleureux et qui apprécie beaucoup les enfants. Merci de lui avoir tenu compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500324,
					"content": "Mais puisque ma femme et moi sommes rentrés, nous allons prendre le relais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500325,
					"content": "Le principal, c'est que vous soyez revenus. Maintenant, laissez-moi voir mon cadeau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500326,
					"content": "Papa, allons à l'intérieur, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "Très bien ! Athos, n'oubliez pas de donner à ces deux jeunes gens leur argent et des friandises. Ils m'ont aidé à nettoyer le sol et à nourrir Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500328,
					"content": "Oh, et donnez aussi quelques-unes de ces friandises à la jeune demoiselle là-bas. Je rentre maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500329,
					"content": "Monsieur Leroy, Nana m'a laissé caresser son ventre... Hein ? Il n'est plus là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500330,
					"content": "Tu cherches mon père, jeune fille ? Je suis son beau-fils. Enfin, c'est comme si j'étais son propre fils. Je m'appelle Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500331,
					"content": "Je sais ce que c'est, un beau-fils. Ça veut dire que vous êtes le mari de sa fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500332,
					"content": "Haha, tu en connais des choses. Mon père est rentré à la maison. Merci de lui avoir tenu compagnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500333,
					"content": "Je t'offre ces quelques friandises. C'est à mon tour et à celui de ma femme de nous occuper de lui. Tu n'es plus obligée de lui rendre visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500334,
					"content": "Tu devrais rentrer chez toi, ça doit faire longtemps que tu es dehors. Ta famille doit sûrement s'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500335,
					"content": "Non, non, monsieur, ça ne me gêne pas. Et en plus, j'ai promis à monsieur Leroy qu'on se reverrait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500336,
					"content": "Je pense qu'il aura encore besoin de mon aide, pour nourrir son chat ou arroser ses plantes, par exemple. Je suis très contente de pouvoir lui rendre service ! Je reviendrai une autre fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500338,
					"content": "Tss, les choses se compliquent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500339,
					"content": "Hein ? Quelque chose vous ennuie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500340,
					"content": "Rien du tout, jeune fille. Mais j'aimerais discuter avec toi. Non, j'aimerais plutôt te demander quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500341,
					"content": "D'accord, que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500342,
					"content": "Si je te donne ces friandises et ces moras, tu ne reviendras plus ici, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500343,
					"content": "Et pourquoi ça ? J'ai fait quelque chose de mal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500344,
					"content": "Non, tu n'as rien fait de mal. Mais mon père est en mauvaise santé, et il a de graves problèmes d'insomnie depuis quelque temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500345,
					"content": "Ma femme et moi voulons qu'il se repose dans un environnement calme afin qu'il puisse guérir. Tu comprends, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500346,
					"content": "Monsieur Leroy n'est pas en bonne santé... Je vois. Eh bien, je lui apporterai beaucoup de fruits bullés la prochaine fois que je viendrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500347,
					"content": "Chaque fois que je mange trop de pâtisseries et que j'ai mal au ventre, mon père me dit qu'il faut manger moins de sucreries et plus de fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500348,
					"content": "Si monsieur Leroy mange plus de fruits, il ira certainement beaucoup mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500349,
					"content": "... *soupir* Peu importe, je n'ai pas d'autre choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500350,
					"content": "Jeunes gens, je vais vous donner quelques friandises et votre rémunération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500351,
					"content": "Laissez-moi être plus clair dans mes propos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500352,
					"content": "Je parle au nom de la famille Leroy : j'espère que vous ne viendrez plus jamais nous déranger à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500353,
					"content": "Je suis sûr que malgré votre jeune âge, vous comprenez parfaitement ce que je dis. Alors, je vous prie de ne plus jamais revenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500354,
					"content": "Tout a été dit, je vais maintenant vous laisser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500355,
					"content": "Pourquoi on ne peut plus revenir ? C'est bizarre, monsieur Leroy est quelqu'un de très sympathique, pourquoi son beau-fils ne veut pas qu'on revienne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500356,
					"content": "C'est vrai. Cet homme parle de manière très distinguée, mais il a l'air assez antipathique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Peu importe ce qu'il dit, j'irai voir monsieur Leroy demain matin. Est-ce que vous viendrez aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500358,
					"content": "Allez, venez ! Nana est trop mignonne, je veux encore la caresser. Et monsieur Leroy nous donnera des friandises !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500359,
					"content": "On viendra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "#C'est décidé, on caressera Nana {M#tous}{F#toutes} les trois et on s'amusera avec monsieur Leroy !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500361,
					"content": "On en reparlera quand on aura le temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "D'accord, alors à la prochaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
