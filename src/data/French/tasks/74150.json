			"dialogs": [
				{
					"id": 741490601,
					"content": "Une livraison de journaux ? Laissez ça devant la porte, je viendrai les prendre plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490602,
					"content": "(Vous avez déjà rendu service à Benoît aujourd'hui, et il semble impoli d'interrompre à plusieurs reprises le repos de quelqu'un. Puisque vous avez convenu avec lui de le voir demain, il serait mieux de patienter jusque-là.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frapper"
				}
			]
		},
