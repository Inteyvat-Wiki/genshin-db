			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(De lourdes caisses poussiéreuses et usées sont empilées, gâchant le paysage lumineux et immaculé de la Cour de Fontaine.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Étranges boîtes"
				},
				{
					"id": 741500702,
					"content": "(On distingue clairement des taches d'eau à la base de ces caisses, ce qui laisse penser qu'elles ont été empilées dans un endroit humide à un moment donné.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Étranges boîtes"
				},
				{
					"id": 741500703,
					"content": "(Ces caisses ont bien besoin d'être nettoyées, bien plus que les taches présentes sur la porte.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Étranges boîtes"
				}
			]
		},
		{
			"id": 7415008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415001",
							"3"
						],
						"stepId": 7415001,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415005",
							"2"
						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500801,
					"content": "Oh, vous aurez beau toquer à la porte à cette heure, Morticia et Athos ne pourront pas vous ouvrir vu qu'ils sont partis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500802
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500802,
					"content": "Pourtant, ils m'avaient dit qu'ils reviendraient aujourd'hui. Peut-être que quelque chose les a retardés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500803
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500803,
					"content": "C'est ça l'inconvénient avec les enfants quand ils grandissent. Ils ont leurs propres occupations et ne sont souvent pas là quand on a besoin d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		}
	]
}