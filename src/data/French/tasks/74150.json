						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoît Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500601,
					"content": "Comme mes enfants ne sont plus chez moi, ça devient difficile de nettoyer les taches sur la porte et à l'arrière de la maison. Je compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		},
		{
			"id": 7415007,
			"completionStepIds": [],
