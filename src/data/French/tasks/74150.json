			"dialogs": [
				{
					"id": 741500101,
					"content": "Merci Molli. Tes beaux yeux violets brillent de gentillesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500102,
					"content": "#Héhé, vraiment ? Vous aimez la poupée que je vous ai apportée la dernière fois{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500103,
					"content": "Je l'aime beaucoup, elle est mignonne. Je lui ai même fait une place pour manger à table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500104,
					"content": "Je suis sûre qu'elle est très contente ! Est-ce que ça va aujourd'hui ? Vous avez besoin que je vous accompagne lors de votre promenade ? Ou que j'aille vous chercher le journal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500105,
					"content": "Je peux aussi vous faire la lecture, si jamais vous ne voyez pas clair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500106,
					"content": "Ma mère m'a dit que je devais faire une bonne action chaque jour, et ma tutrice m'a demandé de faire une rédaction sur des bonnes personnes et leurs bonnes actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500107,
					"content": "Oh, je ne veux pas vous aider juste parce que j'ai une rédaction à écrire. Mais si vous le voulez bien, j'aimerais vraiment le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500108,
					"content": "Haha, pas besoin. Si tu veux vraiment m'aider, dis à tes parents de te laisser venir jouer chez moi plus souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500109,
					"content": "Hmm, monsieur Leroy, je l'ai déjà dit à mes parents, mais ils n'avaient pas l'air très contents de l'entendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500110,
					"content": "Mais tu reviendras quand même me voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500111,
					"content": "Oui, même si mes parents ne veulent pas. On se l'est promis, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500112,
					"content": "Tu es une enfant qui tient ses promesses, Molli. C'est pour ça que je t'apprécie beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500113,
					"content": "#Mais voilà mes deux {M#invités}{F#invitées} ! Bienvenue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500114,
					"content": "*tousse* On ne voulait pas vous interrompre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Est-ce qu'on vous dérange ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "Ce n'est rien. Vous ne dérangez personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500117,
					"content": "Ma jeune amie Molli doit rendre un devoir. Elle courait à gauche et à droite pour trouver sur quoi écrire avant de se retrouver devant chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500118,
					"content": "Elle aimerait pouvoir me rendre service pour avoir des choses à écrire dans sa rédaction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500119,
					"content": "Je ne vous aide pas parce que je veux finir mes devoirs ! Enfin, pas seulement pour ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500120,
					"content": "C'est vrai, je suis certain que tu es une gentille fille. Ce n'est pas juste parce que tu dois rendre un devoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500121,
					"content": "#C'est comme les deux jeunes que nous avons ici, {M#ils}{F#elles} ne viennent pas m'aider seulement parce qu'{M#ils}{F#elles} cherchent du travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Mais ce... Mais on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Ne vous inquiétez pas, c'est juste une blague. Vous n'allez quand même pas en vouloir à un vieillard comme moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500125,
					"content": "#Les jeunes ont beaucoup de temps. Puisque vous êtes {M#prêts}{F#prêtes} à le passer avec moi, et que j'aime bien que la jeunesse me tienne compagnie... Pourquoi pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500126,
					"content": "Je devrais vous donner quelque chose à faire. Il y a beaucoup de gens qui passent par l'entrée, donc la poussière a tendance à s'y accumuler très rapidement et personne n'a nettoyé l'endroit depuis des jours. Si ça ne vous dérange pas, aidez-moi à nettoyer de nouveau ces endroits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500127,
					"content": "Hmm... D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Molli, est-ce que tu veux jouer avec mon chat ? Tu peux lui donner des morceaux de poisson et passer du temps avec lui. Ah oui, il s'appelle Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500129,
					"content": "Il a hérité du nom du chien que j'avais élevé. Mais ma fille est partie avec lui après son mariage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500130,
					"content": "D'accord, monsieur Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500131,
					"content": "Allez-y, les enfants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		},
