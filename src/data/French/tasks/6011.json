			},
			"dialogs": [
				{
					"id": 60111101,
					"content": "#Ah, quelle coïncidence de vous croiser ici, {NICKNAME}. J'ai pensé que des réparations et des entretiens étaient de rigueur, maintenant que la bataille est terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111102,
					"content": "Merci d'avoir gardé mon secret, alors que vous en savez autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111103,
					"content": "Je n'ai pas eu l'occasion de vous poser la question avant, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Parce que je ne voulais pas avoir de problèmes avec le starshyna. S'ils n'avaient pas pu la détecter, mes supérieurs hiérarchiques m'auraient forcé à prendre une lanterne ordinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111106,
					"content": "Imaginez un ratniki avec deux lanternes ! Ce serait étrange à voir, et surtout pas très élégant, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111104,
					"content": "Pourquoi les Gardiens de lumière sont-ils arrivés à détecter votre lanterne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
	]
