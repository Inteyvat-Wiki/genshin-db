			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1547.264,
							258.616,
							9323.938
						],
						"pointId": 11761
					},
					{
						"sceneId": 3,
						"position": [
							1547.072,
							258.854,
							9322.94
						],
						"pointId": 13087
					},
					{
						"sceneId": 3,
						"position": [
							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Cet homme était comme un phare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Il vivait ici, comme si c'était une évidence. Il apportait la lumière à ceux qui l'entouraient et faisait preuve de grâce envers eux. Hélas, quand les gens s'habituent à la lumière, ils finissent par ignorer l'existence de la lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Petit à petit, il s'était mis à penser de cette façon aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "« Je n'ai rien fait d'extraordinaire. Je ne suis pas encore assez bon. Je dois rester patient et continuer d'attendre... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Sa fin a peut-être été tragique, mais je suis fier de la façon dont il a éclairé le chemin pour les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Chaque ombre née de la lumière s'en souviendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "C'est vraiment du gâchis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "J'ai entendu l'histoire de la nivéole de la lanterne un jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Ah, j'en ai entendu parler aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "Et j'aimerais lui dire la même chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "Vous avez raison. On pourrait dire que nos efforts ont été futiles et que Rerir a accompli son but.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Mais nous allons le pourchasser jusqu'au bout, même si cela n'aboutit pas au résultat que nous souhaitons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Ce n'est pas si différent du travail de gardien de tombes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Nous ne cherchons pas à ramener les morts à la vie, mais plutôt à leur apporter la paix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "Tant mieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "D—De quoi vous parlez tous les deux ? Vous pouvez m'expliquer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Pas tout de suite, Paimon. Je le ferai à notre retour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "Après tout, la nivéole de la lanterne ne joue pas un rôle majeur dans ces rites funéraires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "« Porteur de lumière, vous avez pavé votre route vers la gloire et la justice avec votre sang. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "« Même si nous sommes pressés et couverts de blessures, arrêtons-nous un instant pour revoir l'amour et la haine derrière nous. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "« Jusqu'à ce que le monde ferme ses yeux la nuit et qu'une lanterne ne s'allume lentement pour vous seul, invisible aux yeux de tous. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Merci pour tout, sergent-major Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Le résultat importe peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
