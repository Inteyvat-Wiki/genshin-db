			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "Columbina ! Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "Hmm ? C'est vous qui m'aviez recommandé de me promener, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110603,
					"content": "Oui, mais vous n'avez pas peur que les Fatui vous voient ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone n'a pas l'air intéressée par ma capture, et les autres ne vont pas essayer de me trouver non plus. Ils ont d'autres chats à fouetter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110605,
					"content": "(Rerir... représente une menace pour tous les habitants de Nod-Krai.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "C'est toujours une bonne chose de se promener, de toute façon. Qu'en pensez-vous ? Le Village de Nasha vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Hmm... Le flux du kuuvahki est encore perturbé et les gens sont inquiets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110608,
					"content": "Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110609,
					"content": "Mais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "Est-ce ici que vous avez acheté les plats que vous m'avez apportés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110611,
					"content": "(Sérieusement ? C'est ça qui la préoccupe, la fricassée de viande aux baies ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "On peut vous emmener manger un morceau si vous voulez. Il y a plein de délices auxquels vous n'aurez pas l'occasion de goûter chez vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "#... Vous êtes bien {M#silencieux}{F#silencieuse} depuis tout à l'heure. Quelque chose vous préoccupe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110614,
					"content": "Je m'inquiète au sujet de Rerir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Je n'ai malheureusement pas réussi à avoir d'informations sur ses plans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110616,
					"content": "Maintenant qu'il a une forme physique, ce serait une erreur de sous-estimer sa force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110617,
					"content": "Mais cette force renferme une obsession qui frôle la folie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110618,
					"content": "J'ignore si cette obsession est pour les lunes ou autre chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110619,
					"content": "Peut-être qu'on trouvera des pistes pour lui faire face à l'avenir en la comprenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110620,
					"content": "À propos des Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Le quotidien de Sandrone est très imprévisible. Dottore passe son temps à donner des ordres aux autres, et Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110622,
					"content": "Hmm ? Ce n'était pas ce que vous vouliez savoir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110623,
					"content": "#Vous êtes {M#allés}{F#allées} au Bureau d'études expérimentales des Fatui ? L'arme qu'il abrite va jouer un rôle clé dans le plan de la Tsarine. Du moins, c'est ce que j'ai entendu dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110624,
					"content": "Quel est ce plan exactement ? Eh bien, cela ne m'intéresse pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110625,
					"content": "Je pensais au vaisseau spatial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Je pourrais regarder dans l'essence lunaire pour vous, si vous le souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110627,
					"content": "Mais après notre dernière tentative, je soupçonne que le vaisseau spatial a été délibérément caché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110628,
					"content": "Peut-être que quelqu'un souhaite vous cacher la vérité, ou éviter que d'autres ne la découvrent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110629,
					"content": "Je doute que beaucoup de gens soient capables d'accomplir un tel exploit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110630,
					"content": "Je n'ai plus de questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "Je... J'aimerais toujours retourner à la lune qui m'appartient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110632,
					"content": "#Les réponses que je cherche sont enterrées là-bas. C'est ma véritable « maison{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
