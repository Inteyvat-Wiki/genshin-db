			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "Flins ? C'est rare de vous voir aussi souvent ici. Je vous laisse faire un tour. Je suis occupée pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110802,
					"content": "Je suis venu vous voir, mademoiselle Aino. Voici une friandise au beurre traditionnel que j'ai achetée au Village de Nasha. Où devrais-je la poser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110803,
					"content": "Chut ! Ineffa va vous entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110804,
					"content": "... Du coup, qu'est-ce qui vous amène ici ? Allez-vous me dire que les ratnikis vont s'occuper de tous les incidents de la Chasse sauvage après ce qui s'est passé avec le canon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "Et critiquer un génie comme vous pour des événements qu'aucun d'entre nous ne pouvait anticiper ? Nous ne sommes pas aussi malpolis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Si nous l'avions vraiment fait, je pense que nous aurions dû dire adieu aux avancées technologiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Hmph. Vous êtes vraiment un beau parleur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "Je suis ravi de vous avoir rassurée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Allez, dites-moi tout. Pourquoi êtes-vous venu aujourd'hui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Pourriez-vous réparer cette lanterne pour moi ? Je l'avais fait réparer au Village de Nasha, mais elle s'est cassée à nouveau lors du dernier combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Vous demandez à un génie comme moi de réparer une simple lanterne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Toutes mes excuses. Je devrais plutôt demander à Ineffa et lui donner cette friandise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "Ahhh.. Euh, je veux dire, comptez sur moi ! Patientez ici, ce sera rapide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110814,
					"content": "Je vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110815,
					"content": "La prochaine fois que ça se reproduit, venez me voir en premier, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
