			"dialogs": [
				{
					"id": 60111001,
					"content": "Une réparation de lanterne, pff ! Ça ne va même pas me prendre dix minutes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111002,
					"content": "Si seulement chacun savait ce qu'il faisait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111003,
					"content": "Hintsa, par exemple ! Comment a-t-il fait pour créer un contrôleur intégré pour le canon et une barrière à partir de pièces aléatoires que les gens lui ont demandé de réparer ?! J'ai mal au crâne rien que d'y penser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111004,
					"content": "Je lui ai passé un savon avant de lui dire de m'envoyer des rapports réguliers, que je vais aller vérifier plus tard ! *soupir* Je sais que c'est partiellement ma faute, mais bon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
