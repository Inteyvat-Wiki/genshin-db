			"dialogs": [
				{
					"id": 60110501,
					"content": "Patronne, euh... Je voulais avoir votre opinion sur une question, vous vous en souvenez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "Sur une échelle de 1 à 10, pourriez-vous évaluer la contribution que le Curatorium des secrets devrait apporter en cas de coopération avec d'autres parties externes à l'avenir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110503,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110504,
					"content": "Un 1 ? C'est plutôt bas quand même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110505,
					"content": "Devine encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110506,
					"content": "Aucune contribution ?! Mais ça ne revient pas juste à mettre notre nom sur quelque chose sans rien faire ? Dans ce cas, c'est inutile de coopérer, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "*soupir* ... Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "Je veux dire qu'il n'y a pas de minimum ou de maximum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Oh ! Je vous reconnais bien, patronne. Vous avez toujours une longueur d'avance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Hé mais, vous ne répondez pas à ma question en vrai ! Allez, dites-moi un chiffre, patronne ! Je vous en prie !",
