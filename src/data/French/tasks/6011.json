			},
			"dialogs": [
				{
					"id": 60110901,
					"content": "Oh ? Qu'est-ce que vous faites ici ? Je ne m'attendais pas à vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110902,
					"content": "Où étais-tu d'ailleurs ? Tu n'as pas filé la queue entre les pattes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110903,
					"content": "Pas du tout ! J'étais juste ailleurs pour des affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110904,
					"content": "Évidemment, c'est grâce à vous que mon humble boutique a été sauvée. *snif* Je vous en suis infiniment reconnaissante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110905,
					"content": "C'est bon, tu peux arrêter la comédie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "Mais ce n'était pas de la comédie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110907,
					"content": "#Je vous ai dit que mes prix étaient raisonnables, non ? Mais vous êtes quand même {M#allés}{F#allées} voir le Curatorium des secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110908,
					"content": "*soupir* Si mes clients réguliers me lâchent comme ça, je ne peux rien faire d'autre que d'aller en chercher ailleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110909,
					"content": "Tu es trop méfiante vis-à-vis du Curatorium des secrets...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "Comment ne pourrais-je pas ? Gérer une petite entreprise à l'étranger n'est pas facile, d'autant plus quand il y a un concurrent aussi redoutable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110911,
					"content": "Bref, tant pis. La richesse et le destin ne font qu'un, alors ça ne sert à rien de râler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110912,
					"content": "Et ce n'est pas comme si Nefer ne m'avait pas aidée quand je suis arrivée ici parce qu'on vient du même endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110913,
					"content": "S'il faut jeter la pierre à quelqu'un, c'est à moi. Parce que je n'ai pas réussi à faire en sorte qu'elle me soit redevable à son tour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110914,
					"content": "Si elle a besoin de quelque chose, assurez-vous de venir m'en informer en premier, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
