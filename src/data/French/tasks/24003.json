			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "#Hé ! C'est toi qui lui as dit où j'étais caché ? Comment m'a-t-{M#il}{F#elle} trouvé si vite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Je te l'ai déjà dit. Tes cachettes sont trop faciles à trouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030903,
					"content": "Disons que j'ai beaucoup d'expérience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "#C'est vrai ? Vous devriez revenir jouer avec nous alors{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Nos parents travaillent toute la journée, et mon frère passe son temps à lire... Il n'y a personne pour jouer avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Tu pourrais faire comme moi, et lire les livres de l'étagère. C'est beaucoup plus intéressant et utile que de jouer à cache-cache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030908,
					"content": "Mouais... Je préférerais apprendre à coudre avec maman alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "#Je suis {M#un expert}{F#une experte} de ce jeu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				}
			]
		}
	]
