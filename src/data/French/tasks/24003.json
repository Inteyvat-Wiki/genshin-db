			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Cette fois-ci, tu ne trouveras jamais ma cachette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Si tu te caches là-bas, ce sont les parents qui vont venir te chercher, pas moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030103,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Je joue à cache-cache avec mon frère ! Mais... il connaît toutes mes cachettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut, on joue ici depuis longtemps, tu as utilisé toutes les cachettes possibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030106,
					"content": "Et là-bas, je t'ai déjà dit mille fois pourquoi tu ne pouvais pas t'y cacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030107,
					"content": "Pff... Ce n'est vraiment pas si dangereux que ça, il faut toujours que les parents exagèrent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Mais si tu vas te cacher là-bas, tes vêtements vont être salis ou déchirés. Papa et maman travaillent déjà assez dur comme ça, ne leur rajoute pas des soucis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030109,
					"content": "Hmm... D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "Je pourrais jouer avec vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "C'est vrai ? Vous joueriez avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, n'embête pas les gens ! Je suis désolé, mon frère ne pense qu'à jouer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030114,
					"content": "Ce n'est rien, j'ai un peu de temps devant moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "#Trop bien ! Tu vois, frangin ? {M#Il}{F#Elle} veut bien jouer avec nous ! Je suis sûr que je vais gagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "*soupir* D'accord... Dans ce cas, on compte sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030118,
					"content": "Verut, ne va pas te cacher là-bas, on en a parlé, d'accord ? Nos parents reviendront tard ce soir, et si tes vêtements sont abîmés, personne ne pourra t'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030119,
					"content": "Ça, c'est bon... Argh, tu es tellement ennuyeux ! Bon, je vais aller me cacher, maintenant. Et tu ferais bien d'en faire autant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Vas-y d'abord. Je sais déjà où je vais aller me cacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030121,
					"content": "#C'est vrai ? Que de la frime ! {M#Il}{F#Elle} va te trouver en un rien de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurèle et Verut vont se cacher chacun de leur côté...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Ça ne m'embête pas du tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Peut-être que je ne te trouverai pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
