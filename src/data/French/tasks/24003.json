			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "*soupir* Quand va-t-il grandir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030702,
					"content": "Tu ne vas pas te cacher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Je n'avais pas vraiment envie de jouer. Si Verut n'était pas si insistant, je préférerais passer mon temps à lire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030704,
					"content": "Mes parents travaillent tellement dur. Il faut que je grandisse vite pour pouvoir les aider un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030705,
					"content": "Mais Verut n'arrête pas de dire que maman lui manque. Alors, je lui tiens compagnie pour qu'il arrête de pleurer, au moins pendant un certain temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030706,
					"content": "Désolé, j'en ai trop dit. Je vous attendrai au lieu convenu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030707,
					"content": "J'espère juste que Verut ne va pas se salir cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
