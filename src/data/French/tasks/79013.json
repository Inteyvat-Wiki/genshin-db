			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Ooh, alors il n'y avait pas de notes ici parce qu'il a gravé un message sur le pilier. Hein, il a fait tout le chemin jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131902,
					"content": "Mais d'où lui vient sa confiance... Si on ne l'avait pas aidé, il serait toujours coincé dans la salle secrète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131903,
					"content": "Il va finir en viande congelée s'il va à Dosdragon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131904,
					"content": "C'est un peu exagéré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "Hein ? H—Hum, je veux juste dire qu'il aurait de gros problèmes s'il allait à Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131908,
					"content": "Il faut lui dire de ne pas y aller, et vite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131909,
					"content": "Eh bien, on n'a qu'à lui laisser un autre message...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "C'est ce que je pensais... Ah oui, cette fois, préparons-lui un autre poulet mariné aux fleurs sucrantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131911,
					"content": "Peut-être que la chaleur de Mondstadt lui manquera une fois qu'il aura mangé un morceau, et qu'il renoncera à aller à Dosdragon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131912,
					"content": "Le poulet mariné aux fleurs sucrantes ne sera plus bon, tu sais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131913
					]
				},
				{
					"id": 790131913,
					"content": "Oh, allez, c'est l'intention qui compte, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131906,
					"content": "Eh bien, il va avoir des ennuis, ça c'est sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131907
					]
				},
				{
					"id": 790131907,
					"content": "Exactement ! Dosdragon, c'est super froid et ça regorge de Brutocollinus... Sans oublier le Roi sanglier des neiges !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				}
