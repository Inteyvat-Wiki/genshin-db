			"dialogs": [
				{
					"id": 790130201,
					"content": "Héhé, qu'est-ce que c'est bon le poulet mariné aux fleurs sucrantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130202,
					"content": "Je comprends vraiment pourquoi ça manque à Wolfgang !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130203,
					"content": "Le pauvre, piégé ici sans la moindre chance de manger une dernière bouchée de poulet mariné aux fleurs sucrantes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130204,
					"content": "Ce carnet est très vieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#Oui, mais... Tu te rappelles, {NICKNAME} ? On est {M#passés}{F#passées} d'une île à une autre en traversant une sorte de bassin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130217,
					"content": "Les constructions de l'île à l'intérieur du bassin ont l'air bien plus intactes que celles à l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130218,
					"content": "Les constructions sur l'île actuelle ont l'air de ruines en comparaison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130219,
					"content": "Se pourrait-il que les bâtiments situés à l'intérieur du bassin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "C'est très probable ! Les constructions de l'île à l'intérieur pourraient être la forme originale des ruines à l'extérieur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}, est-ce que tu crois que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130223,
					"content": "... Que l'île à l'intérieur du bassin est l'île telle qu'elle était autrefois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130207,
					"content": "Alors, écoute... On peut peut-être sauver ce type si on découvre où se trouve la salle secrète, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130208,
					"content": "Ça ne fonctionnera que dans le cadre des illusions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "Oui, mais... Même si tout est faux, et que cet aventurier n'existe pas... Ne devrions-nous pas au moins essayer de le sauver ? Il a eu un destin tellement tragique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130212,
					"content": "Eh bien, je suppose que tu as raison.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#Héhé ! Je savais que tu serais d'accord, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130216,
					"content": "Allons voir l'île qui se trouve à l'intérieur du bassin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130214,
					"content": "Allons jeter un œil, alors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "Ouais, allons essayer de sauver ce Wolfgang, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130209,
					"content": "Cela ne changera rien à la réalité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "Les constructions à l'intérieur du bassin reflètent leur état d'origine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "C'est arrivé il y a longtemps, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
