			"dialogs": [
				{
					"id": 790132901,
					"content": "(Ces gravures sont anciennes. Voilà ce qui y est écrit...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132902
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132902,
					"content": "« Le vent est très fort ici, je ne peux pas utiliser un carnet de notes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132910
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132910,
					"content": "« Haha, penser que j'ai trouvé un poulet mariné aux fleurs sucrantes ici, et encore chaud avec ça ! C'est pratiquement un miracle. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132903
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132903,
					"content": "« Je ne sais pas qui est la personne qui a laissé ce poulet mariné aux fleurs sucrantes ici ou comment elle a su que j'en voulais. C'est très étrange... Mais je lui suis quand même très reconnaissant. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132904
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132904,
					"content": "« Merci à la personne qui a laissé les inscriptions derrière elle ! Votre poulet mariné aux fleurs sucrantes était le meilleur que j'aie jamais goûté. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132905
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132905,
					"content": "« Et merci. Je sais que Dosdragon est très dangereux... et je connais aussi mes limites. Mais je dois y aller. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132906
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132906,
					"content": "« Qui sait, peut-être qu'un panneau avec inscrit dessus « il y a un piège ici » sera tout ce qui restera de moi à Dosdragon. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132907
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132907,
					"content": "« Mais si quelqu'un d'autre peut éviter ce piège et aller plus loin que moi, ce sera pour moi quelque chose d'encore plus précieux qu'un poulet mariné aux fleurs sucrantes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132908
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132908,
					"content": "« Merci, qui que vous soyez qui avez laissé ces inscriptions. Mais nous autres, aventuriers, existons précisément pour affronter les dangers tels que Dosdragon. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132909
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790132909,
					"content": "« Amitiés, Wolfgang. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscription"
				}
			]
		},
