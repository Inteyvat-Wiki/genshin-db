			},
			"dialogs": [
				{
					"id": 790131201,
					"content": "Ça devrait être assez voyant ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "Message"
				},
				{
					"id": 790131202,
					"content": "Espérons que Wolfgang le verra, et qu'il ne se retrouvera plus dans les salles secrètes de ces ruines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "Message"
				},
				{
					"id": 790131203,
					"content": "Retournons voir. Peut-être que ses notes ont encore changé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message"
				}
			]
		},
