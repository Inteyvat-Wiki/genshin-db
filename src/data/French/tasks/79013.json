			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131801,
					"content": "(Ces gravures sont anciennes. Voilà ce qui y est écrit...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790131802,
					"content": "« Le vent est très fort ici, je ne peux pas utiliser un carnet de notes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790131803,
					"content": "« Le lever du soleil est vraiment magnifique. Cela remplit mon cœur de joie d'avoir bravé tous ces dangers pour arriver jusqu'ici. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790131804,
					"content": "« Je me demande si quelqu'un viendra après moi pour voir cette même vue. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790131805,
					"content": "« Maintenant que j'ai accompli cette épreuve... Prochain arrêt, Dosdragon ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790131806,
					"content": "« C'est vraiment un endroit charmant. La seule chose qui me manque, c'est un peu de poulet mariné aux fleurs sucrantes... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "Inscription"
				},
				{
					"id": 790131807,
					"content": "« Wolfgang. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscription"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
				7901327
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7901327",
							"2"
						],
						"stepId": 7901327,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
