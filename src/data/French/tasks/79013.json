			"dialogs": [
				{
					"id": 790131101,
					"content": "La porte s'est ouverte ! Ouf, c'était pas facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131102,
					"content": "#Hum, on dirait que Wolfgang n'a pas encore écrit de notes ici, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131103,
					"content": "Donc il n'est pas venu ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "On a déverrouillé la salle pour lui dans le passé... Ça signifie qu'il n'est pas coincé dans le présent, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131105,
					"content": "Eh bien, si ce dispositif peut être déclenché plusieurs fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Attends, alors... Hum, pourquoi ne pas lui laisser un message ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131108,
					"content": "Essayons de graver notre message dans un endroit en évidence. On va lui expliquer comment déverrouiller le mécanisme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131106,
					"content": "Même si on l'a déverrouillé une fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
			"id": 7901312,
			"completionStepIds": [
				7901315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
