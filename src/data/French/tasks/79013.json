				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "Qu'est-ce que... Qu'est-ce que raconte ce type ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131602,
					"content": "Ça ne va pas. On doit aller à Dosdragon et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131603,
					"content": "Paimon, ce qu'on a changé dans l'illusion ne changera pas le passé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "Ah... Oui, c'est vrai. Wolfgang n'est « ici » que parce que l'Archipel de la pomme dorée est sous l'effet de ce dispositif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131606,
					"content": "C'est pour ça que je pensais qu'il avait été sauvé... Mais en fait, il était juste coincé dans la première salle secrète, n'est-ce pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131607,
					"content": "Mais quand même, ce Wolfgang est d'un casse-pieds ! ... On n'a pas arrêté de l'aider, et il continue de penser qu'il faudrait qu'il « ouvre la voie » pour les autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131608,
					"content": "Il ne peut pas faire un peu plus attention à sa propre vie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131609,
					"content": "Tout le monde est en quête de quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Argh... J'ai compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131612,
					"content": "Mais quand même, si seulement il avait pu connaître une meilleure fin. Tu sais, comme revenir à Mondstadt, devenir un grand aventurier, aller jouer avec les chats à la taverne, et manger du poulet mariné aux fleurs sucrantes jusqu'à plus faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131613,
					"content": "Pourquoi ça ne se finit jamais bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131610,
					"content": "C'est grâce à des gens comme lui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "Wolfgang n'arrivera jamais à Dosdragon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
		{
			"id": 7901318,
			"completionStepIds": [
				7901318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
