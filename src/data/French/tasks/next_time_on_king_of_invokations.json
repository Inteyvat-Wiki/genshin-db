			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Chut... C'est Cyno ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350302,
					"content": "Regardez sa tenue, sa coiffure et cette couleur de cheveux... Il ressemble en tout point à un héros de roman de cartes à jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350303,
					"content": "Je ne sais pas trop...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "Faites-moi confiance, je m'y connais. Enfin, ce n'est pas le bon moment pour vous expliquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350309,
					"content": "#{M#Voyageur}{F#Voyageuse}, demandez à Cyno de devenir mon modèle... Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350305,
					"content": "Je connais pas mal de gens comme ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "C'est vrai ? Je travaille justement sur le troisième tome de mon roman « Le roi des invocations » et cette fois-ci, je ne vais pas m'inspirer des mécaniques de jeu d'Invocation des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350307,
					"content": "J'ai décidé d'adopter un autre style d'affrontement. Par exemple, les cartes flottent sur le terrain et les joueurs doivent les collecter tout en empêchant leur adversaire de faire de même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350308,
					"content": "Hahaha ! Ça m'amuse rien que d'y penser ! Mais ce n'est pas le moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "... Hmm, cette combinaison de cartes est plutôt pas mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350402,
					"content": "Mais celles-ci sont trop faibles pour contrer une attaque rapide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350403,
					"content": "Qu'est-ce que vous faites, Cyno ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME} ? Je ne pensais pas vous croiser ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350405,
					"content": "Je suis en train de construire un deck offensif lent avec mes cartes d'Invocation des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350406,
					"content": "Le joueur en possession de ce deck aura beaucoup de ressources et de cartes puissantes à sa disposition... En tout cas, j'aimerais bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350407,
					"content": "C'est difficile de constituer ce genre de decks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350408,
					"content": "Les joueurs d'Invocation des Sept préfèrent utiliser des cartes d'attaque rapide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350409,
					"content": "Au début de la partie, ils vont jouer un grand nombre de cartes pour attaquer d'un coup et dominer leur adversaire pour une victoire expéditive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350410,
					"content": "Mais cette stratégie ne me plaît pas trop. Je préfère accumuler des ressources de façons variées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350411,
					"content": "En saisissant chaque opportunité, je continue d'obtenir des avantages pour garantir la victoire finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350412,
					"content": "Absolument ! C'est exactement ça ! Vous êtes le héros de mon roman !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350413,
					"content": "Euh, pardon ! Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350414,
					"content": "Je vous présente Fukumoto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "C'est l'auteur du roman « Le roi des invocations ».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Bonjour, cher général mahamatra. Je ne pense pas que vous me connaissiez, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350417,
					"content": "J'ai déjà lu vos livres. Ils sont très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350418,
					"content": "Vous m'en voyez honoré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350419,
					"content": "À chaque fois que le héros se retrouve dans une impasse, il arrive à obtenir une carte qu'il n'avait pas du tout dans son deck par toutes sortes de moyens et gagne sa partie. C'est un élément qui m'a marqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350420,
					"content": "Je comprends que c'est votre créativité qui parle, mais gagner de cette façon marque une divergence avec les mécaniques de l'Invocation des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350421,
					"content": "À ce propos, hmm... Bien que je joue à l'Invocation des Sept, je suis loin d'être bon... Et puis, si je narrais tout d'un point de vue stratégique, l'histoire serait ennuyeuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350422,
