			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "*soupir* Je veux rentrer à Inazuma... Pourquoi ça n'arrive qu'à moi ce genre de choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350102,
					"content": "Vous allez bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "#{M#Voyageur}{F#Voyageuse} ? *soupir* Ne m'en parlez pas... J'ai l'impression que les gens qui travaillent sur l'Invocation des Sept sont au bord de la crise de nerf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350105,
					"content": "D'après le chercheur avec qui je m'entends bien, ils ont rencontré de nombreuses difficultés qui sont pour le moins incroyables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350106,
					"content": "Par exemple, un chercheur de l'Haravatat avait soulevé un problème un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350107,
					"content": "Il trouvait que la description des effets sur les cartes était trop longue et que cela pouvait décourager les personnes de jouer au jeu si elles n'ont pas l'habitude de lire des gros blocs de texte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350108,
					"content": "Cela ne concerne pas les chercheurs, mais certains joueurs potentiels passeraient à côté de l'Invocation des Sept à cause de ce problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350109,
					"content": "C'est pourquoi, il a suggéré de réduire de moitié la quantité de texte sur certaines cartes pour rendre la tâche plus facile aux joueurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350110,
					"content": "C'est vraiment nécessaire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Je ne pense pas que ce soit un problème non plus... Mais les chercheurs travaillent dur sur la question. Après tout, cela concerne l'expérience des joueurs... Le moins de problèmes il y a, le mieux c'est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350113,
					"content": "Enfin... Le problème est qu'ils avaient promis de m'aider à trouver des modèles et cela ne s'est pas passé comme prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350114,
					"content": "Un chercheur m'a dit qu'ils me mettraient en contact avec Tighnari et Cyno et leur demanderaient de devenir mes modèles, vous souvenez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350115,
					"content": "Eh bien, ils sont trop occupés. Je ne pense pas que je puisse compter sur eux pour l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350116,
					"content": "Qu'allez-vous faire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Le chercheur n'a pas pu m'aider avec cette affaire, mais il m'a donné une piste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350119,
					"content": "D'après lui, Cyno va parfois au Café Puspa pour jouer aux cartes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350120,
					"content": "Je pourrais tenter ma chance là-bas... Ou peut-être qu'ils m'aideront à le contacter quand ils auront le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350121,
					"content": "Vous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "*soupir* J'aurais déjà terminé d'écrire mon roman à ce rythme-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350123,
					"content": "Du coup, je vais prendre sur moi et aller voir Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350124,
					"content": "Si j'arrive à le croiser, comment devrais-je me présenter à lui ? Quelle plaie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350128,
					"content": "Je peux vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Vraiment ? Génial ! Mais comment... Vous savez quoi ? Ça ne me regarde pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350131,
					"content": "Qu'attendons-nous ? Allons au Café Puspa ! J'espère qu'on le verra là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350129,
					"content": "#Je suis {M#ami}{F#amie} avec Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "Comment allez-vous faire pour les contacter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "Le texte n'est pas si long que ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Ça avance, votre roman ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
