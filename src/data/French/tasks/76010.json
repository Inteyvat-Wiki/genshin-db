			"dialogs": [
				{
					"id": 760100201,
					"content": "Vingt-cinq... Vingt-six...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100202,
					"content": "Oh ? Qu'est-ce que vous comptez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100203,
					"content": "Chut ! Faites moins de bruit... Ah, peu importe. Je n'attraperai rien de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100204,
					"content": "Allez, ma petite. Ce n'est pas évident ? Je chronomètre mon lancer. Quoi, tu pensais que j'agitais cette canne pour jeter un sort ou quelque chose comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100205,
					"content": "Vous faites partie des Descendants de givrelune, ce ne serait pas non plus impossible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "#Haha, tu me surestimes, {M#jeune homme}{F#jeune fille}. Je ne vaux même pas un demi Descendant de givrelune. Je ne suis même pas un acolyte. Je ne suis qu'un homme ordinaire qui ne maîtrise pas le pouvoir du kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100210,
					"content": "Enfin bref, c'est la première fois que j'entends quelqu'un chronométrer sa pêche à la seconde près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100211,
					"content": "Ce qui compte, c'est la technique de pêche, pas le temps passé sur le rivage. Le vieil Ilmari n'a jamais compris ça. Pas étonnant qu'il n'ait jamais rien attrapé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100212,
					"content": "#Hm ? J'en déduis que vous êtes des {M#chasseurs}{F#chasseuses} de trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100213,
					"content": "#Non, nous sommes des {M#aventuriers}{F#aventurières}... Mais on peut vous aider si vous avez besoin de quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100214,
					"content": "#En quelque sorte. Tant que vous acceptez de faire le travail et d'être {M#payés}{F#payées}, c'est pareil pour moi. Vous pourriez bien m'aider pour quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100215,
					"content": "Vous voyez, je suis clairement le meilleur pêcheur sur l'Île de Hiisi. Même à travers l'histoire de toutes les Émissaires de chantelune, personne ne me bat quand il s'agit de pêche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100216,
					"content": "Vraiment ? C'est génial... Attendez, ça ne veut pas dire grand-chose ! Pêcher ne fait même pas partie des responsabilités des Émissaires de chantelune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100217,
					"content": "Mais malgré toutes mes compétences, je n'ai pas réussi à attraper un seul poisson récemment. Ça n'a aucun sens !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100218,
					"content": "Le problème ne vient bien évidemment pas de moi, mais de l'environnement. Tout comme le maudit Œil de Kratti, il doit y avoir quelque chose sous l'eau qui affecte les poissons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100219,
					"content": "Q—Quelle étrange déduction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100220,
					"content": "Bref, pourriez-vous m'aider à vérifier dans les eaux aux alentours si quelque chose effraye les poissons ? Ne vous inquiétez pas, je vous dédommagerai pour vos efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100221,
					"content": "Eh bien, puisqu'il est question d'une récompense... Mais on ne vous promet pas qu'on trouvera forcément quelque chose de bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100207,
					"content": "Peut-être que vous allez pêcher un compagnon de voyage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100209,
					"content": "Hé, ne dis pas ça comme si n'importe qui pouvait pêcher son meilleur compagnon de voyage ! Ce n'est pas même la question !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
