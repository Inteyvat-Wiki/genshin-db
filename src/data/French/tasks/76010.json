					}
				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "Hé, vous avez vu ça ? Je ne sais pas ce qui s'est passé, mais j'ai détourné le regard une seconde et cette énorme pierre s'est envolée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100602,
					"content": "Vous expliquez ce qui s'est passé...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "#Eh bien ! Je n'ai aucune idée de tout ce que cela signifie, mais si vous avez réussi à faire quelque chose d'aussi extraordinaire, vous devez être {M#bénis}{F#bénies} par la dame de{RUBY#[D]Kuutar} la lune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100604,
					"content": "Que la Déesse de la lune nous protège ! Que la Déesse de la lune nous protège ! Je peux désormais pêcher ici à ma guise. Enfin, tant que ce barde ne revient pas pour chanter avec son animal de compagnie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100605,
					"content": "Voici votre dédommagement, comme promis. Même si je n'ai pas attrapé de poissons ces derniers temps, j'ai pêché tout un tas d'autres trucs. Certains devraient avoir une certaine valeur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100606,
					"content": "Les moras ne sont pas très utiles sur l'Île de Hiisi, alors prenez tout ça. Merci pour votre aide, maintenant je vais pêcher tranquillement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pekkani"
				}
			]
		}
	]
}