					"nextDialogs": [
						730860206
					],
					"speakerTitle": "Aragita"
				},
				{
					"id": 730860206,
					"content": "Pas de problème, c'est parti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
