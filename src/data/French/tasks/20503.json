				{
					"id": 205030601,
					"content": "Trouvez du minerai d'abord. Ensuite, on pourra parler affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030602,
					"content": "Quand je suis pas occupé, bien évidemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030603,
					"content": "Vous avez l'air de mauvaise humeur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "J'ai besoin d'me concentrer pour faire mon boulot. Pas de papoter avec les clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Dans ce métier, seule la qualité des armes compte. Rien d'autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "Bref, si vous n'avez plus rien à me dire, je retourne bosser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
