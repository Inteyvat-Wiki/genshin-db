			"dialogs": [
				{
					"id": 205030501,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030502,
					"content": "Je vous rapporte les morceaux de fer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "Ah oui, c'est vrai. Ça m'était sorti de la tête, tiens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030505,
					"content": "Bon, ça devrait faire l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030506,
					"content": "J'aimerais faire forger un objet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030503,
					"content": "Vous m'avez dit de le faire, vous vous en rappelez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
