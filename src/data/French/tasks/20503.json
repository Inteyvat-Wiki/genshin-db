				"points": []
			},
			"dialogs": [
				{
					"id": 205030201,
					"content": "Qu'est-ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030202,
					"content": "Je voudrais une arme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "Regardez par là, et faites votre choix. Si vous ne trouvez pas votre bonheur, je peux essayer de vous faire quelque chose sur mesure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030207,
					"content": "Waouh, il fabrique des armes sur mesure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030208,
					"content": "Bien sûr. Je vends des armes, les fabrique sur commande et m'occupe de leur raffinement. Le boulot d'un forgeron quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030209,
					"content": "Ramenez-moi du minerai, et je m'occupe du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030210,
					"content": "Où est-ce que je peux en trouver ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "Partout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030214,
					"content": "#Vous m'avez l'air {M#paumé}{F#paumée}, alors j'vais vous indiquer où trouver des morceaux de fer pas loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030215,
					"content": "Une fois que vous les aurez trouvés, revenez ici que je vous fabrique ce que vous voulez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030216,
					"content": "D'accord, merci !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "Ça ira pour l'instant, j'ai autre chose à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030212,
					"content": "Vous en vendez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "Et puis quoi encore... Tentez votre chance ailleurs. J'en ai à peine assez pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030204,
					"content": "Je voudrais une arme pour Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "Tu veux que je me batte maintenant ? Et puis quoi encore ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030206,
					"content": "Hum... Elle est petite, alors il lui faudra une arme sur mesure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				}
			]
		},
