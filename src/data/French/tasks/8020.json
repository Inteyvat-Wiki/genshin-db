			"dialogs": [
				{
					"id": 80200101,
					"content": "Attends... Mais c'est Dainsleif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Ah, c'est vous deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "C'est votre ami ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200104,
					"content": "Je vais vous laisser alors. Je devrais retourner au village pour voir comment le chef Amadhiah et les autres se portent. À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200105,
					"content": "Oui ! À plus tard, Atossa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "Vous sortez toujours de nulle part comme ça ! C'est fait exprès ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Ce n'est ni intentionnel, ni personnel... Nos chemins sont destinés à se croiser. Après tout, nous sommes tous à la poursuite de l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Ah, vous êtes là pour enquêter sur eux ? Ça expliquerait la présence des monstres que nous venons de combattre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Évidemment. Ah ? Vous n'êtes pas ici pour la même raison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "On est aussi sur leur piste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "En tout cas, même si vous avez mis du temps, vous devez sans doute avoir réalisé qu'il y a quelque chose d'étrange en ces lieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "L'Ordre de l'Abîme mijote quelque chose ici... ou pire : ils ont déjà mis leur plan à exécution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "Vous pensez donc qu'ils sont à l'origine de la présence accrue des Brutocollinus dans la zone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Je pense que ce n'est pas leur objectif premier, mais seulement une conséquence secondaire de leur plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Oui, mais la présence de ces Brutocollinus est une source de problèmes pour les gens du coin. Nous devrions rester un peu plus longtemps pour les protéger, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "La meilleure façon de les protéger est de découvrir ce que l'Ordre de l'Abîme prévoit de faire pour empêcher que des événements tragiques ne se produisent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Voyons ce que les villageois peuvent nous dire sur le sujet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Bien entendu. Je n'ai jamais eu l'intention de vous cacher quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "Ne vous inquiétez pas, nous aurons tout le temps de discuter tranquillement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Ensuite, ce sera à vous de répondre à nos questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Mais c'est une coïncidence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
