				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "Vous retournez au Village de Vimara pour recueillir des informations d'après vos découvertes et interrogez les villageois jusqu'à la tombée de la nuit...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "#Ah, c'est une mission qui vous a {M#amenés}{F#amenées} au Village de Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "« Quelqu'un qui n'existe que dans les souvenirs des autres »... C'est en effet intrigant. Je pense aussi que vous n'avez pas affaire à une simple disparition, mais nous ne pouvons pas faire le lien avec l'Ordre de l'Abîme pour l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "Le seul indice qu'on a est la présence accrue des Brutocollinus dans la zone ces derniers temps, ce qui ne nous aide pas trop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "Eh bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "#Oui ! Cette voix mystérieuse que {NICKNAME} a entendue dans les souvenirs de {F#son frère}{M#sa sœur}... qui parlait de « pécheur »... Qui est-ce ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}, pensez-vous que votre {F#frère vous a trahie}{M#sœur vous a trahi} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "Je veux croire que non.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "Hmm... Je sens une hésitation. Après tout, vous ne savez toujours pas ce qui s'est vraiment passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "Vous pouvez encore vous réconcilier. Votre relation n'est pas endommagée au point d'être irréparable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "Mais les choses sont différentes pour le pécheur dont vous souhaitez découvrir l'identité... Lui et ses semblables m'ont trahi ainsi que leur peuple, il y a déjà bien longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Il s'appelle Vedrfolnir le visionnaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "J'ai honte de le dire, mais il fait partie de ma famille. C'est mon frère aîné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "Votre... frère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "Que s'est-il passé entre vous deux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "Ils étaient cinq... Les cinq pécheurs de Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "Hroptatyr le sage, Vedrfolnir le visionnaire, Rhinedottir l'or, Surtalogi l'infâme et Rerir le rächer de solnari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "Mes souvenirs auront beau s'éroder, je n'oublierai jamais ces noms. Un jour... Je me vengerai d'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "J'ai l'impression qu'on a déjà entendu ces noms quelque part ! Rhinedottir est la créatrice d'Albedo, Surtalogi est le maître de Skirk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "Et Vedrfolnir dont on vient d'apprendre l'existence, est le frère de Dain... Si la voix du pécheur était la sienne, c'est lui qui a poussé Chlothar à créer l'Ordre de l'Abîme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "Tout est lié...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(S'il dit la vérité, les stèles qu'on a trouvées dans les ruines de Fontaine... qui parlaient de la prophétie... étaient sans doute l'œuvre de Vedrfolnir.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Autrefois, c'étaient des personnalités respectées à Khaenri'ah, des espoirs de la nation. Ils étaient les meilleurs dans leurs domaines respectifs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "Nous six aurions dû empêcher le cataclysme de s'abattre sur la nation ensemble, en empêchant le roi vinster de continuer à ébranler les fondations du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Cependant, ils désiraient quelque chose de plus en leur for intérieur et succombèrent à l'appel de l'Abîme pour se répartir un pouvoir capable de détruire le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Ils devinrent des pécheurs, mais aussi des êtres transcendants, chacun en possession d'un pouvoir dévastateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "Lorsque le cataclysme arriva, pas un seul ne fit quoi que ce soit pour empêcher la tragédie... C'est pour cette raison que je ne le leur pardonnerai jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "Ensuite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "... Exactement. Si personne ne les arrête, viendra un jour où ils trahiront aussi le monde entier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Ça a dû être difficile pour vous de parler de ce sujet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "Il n'y a pas de quoi. Comme je l'ai dit, je n'ai jamais eu l'intention de vous cacher quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Du coup, sur quoi avez-vous enquêté depuis tout ce temps, Dain ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "J'ai continué d'enquêter sur les fils du destin. Beaucoup de temps s'est écoulé depuis le début de l'opération initiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "En récupérant l'œil du Laboureur originel, nous avons réussi à empêcher la réalisation de leur plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Oh, je me souviens ! Ils voulaient l'utiliser pour corrompre Ortell et créer une divinité, enfin un truc du genre, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "En effet, mais ce n'était clairement qu'une expérience pour eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "L'œil était un élément crucial de leur plan, mais ils ont réussi à trouver un autre moyen d'avancer en renonçant complètement à l'étape expérimentale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Il y a beaucoup de signes qui l'indiquent, en tout cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "Qu'est-ce qu'on fait alors ? Ce n'est pas trop tard, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "Le plus pressant actuellement est de découvrir l'utilité des fils du destin. Ce n'est qu'à partir de ça que nous pourrons déduire le véritable objectif de l'Ordre de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Selon les informations que j'ai rassemblées jusqu'à ce jour, je pense que les fils du destin sont liés aux lignes énergétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "Les lignes énergétiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, vous avez pu voir les souvenirs de votre {M#sœur}{F#frère} l'autre fois, non ? À mon avis, c'était grâce à l'instabilité des lignes énergétiques de la zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Mes récentes investigations montrent que les activités de l'Ordre de l'Abîme dans une zone sont habituellement suivies d'anomalies au sein des lignes énergétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "Et une chose circule dedans : les souvenirs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Hein ? Dans ce cas, la personne qui n'existe que dans les souvenirs des villageois ici... Cette affaire serait liée à tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(Les souvenirs... Les lignes énergétiques... Les fils du destin... La personne disparue qui n'a pas l'air d'exister...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(Quel est le rapport entre tous ces éléments ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "C'est vraisemblable. Je me joindrai à votre enquête demain. Cette personne disparue pourrait être la clé du mystère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Si on fait encore équipe avec vous, il nous faudra toutes nos forces ! Continuons notre enquête un peu plus loin demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "*soupir* Je suis tellement fatiguée... Mon cerveau a fondu à cause de Dain et des trucs compliqués qu'il nous a racontés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Je n'ai pas bien dormi non plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Allons retrouver Dain. On a du pain sur la planche aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "C'est le bazar dans ma tête.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Merci de l'avoir fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "#{M#Ma sœur est entrée en contact avec votre frère.}{F#Mon frère est entré en contact avec le vôtre.}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "Que s'est-il passé à Khaenri'ah à l'époque ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "Oui, d'une certaine façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "C'est à votre tour de nous dire ce que vous savez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
