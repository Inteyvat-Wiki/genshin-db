			"dialogs": [
				{
					"id": 80200201,
					"content": "Hum, Dain ? Hé oh, Dain ! Pourquoi vous rêvassez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200203,
					"content": "Quelque chose est arrivé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200204,
					"content": "Tout va bien, Dain ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "Cette personne que vous devez retrouver... Pourriez-vous me la décrire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200206,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200207,
					"content": "Euh, un jeune homme qui a la vingtaine... Qu'est-ce qu'il y a au juste, Dain ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200208,
					"content": "Je viens d'avoir des souvenirs qui n'étaient pas là avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200209,
					"content": "Des souvenirs de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200210,
					"content": "Quoi ? Peut-être que vous avez rêvé de lui parce qu'on a beaucoup parlé de lui hier ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200211,
					"content": "Non, ce n'était pas un rêve, mais bien des souvenirs... qui me sont apparus soudainement après mon réveil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200212,
					"content": "Pourtant, je suis sûr de ne pas connaître cette personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200213,
					"content": "De quoi vous êtes-vous souvenu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "Je me suis souvenu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200215,
					"content": "... Lui avoir remis l'œil du Laboureur originel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200216,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200218,
					"content": "... Cette personne disparue a vraiment un lien avec l'Ordre de l'Abîme alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200219,
					"content": "Oui, et il aurait le pouvoir d'implanter des souvenirs dans l'esprit des autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200220,
					"content": "Comment est-ce possible ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "Attendez, ça veut dire que tous les souvenirs des villageois... seraient faux ? Peut-être qu'ils ne le connaissaient pas du tout ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200222,
					"content": "Pourquoi aurait-il fait ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200223,
					"content": "Indépendamment de ce que l'Ordre de l'Abîme prépare, une vérité des plus importantes nous a été révélée ce matin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200224,
					"content": "Quelle vérité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200225,
					"content": "Leur objectif est toujours de mettre la main sur l'œil du Laboureur originel. Ils n'ont pas arrêté de le chercher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200226,
					"content": "Je suis le seul à savoir où il se trouve. Peut-être ont-ils tenté d'implanter ces souvenirs dans mon esprit pour tenter de l'altérer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200227,
					"content": "L'œil est-il encore en sécurité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "Vos craintes ne sont pas entièrement infondées, mais je ne crois pas que l'Ordre de l'Abîme soit encore capable d'altérer la réalité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200230,
					"content": "Cependant, nous devons redoubler de prudence, car ils ne reculeront devant rien pour s'emparer de l'œil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200231,
					"content": "Venez, vérifions si l'œil est encore en notre possession.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200232,
					"content": "Oh, vous allez nous emmener où vous l'avez caché ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200233,
					"content": "(Et si quelqu'un nous suivait ? Ce serait leur dévoiler l'emplacement de l'œil...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(Peut-être que le but de l'Ordre de l'Abîme est de pousser Dain à confirmer le lieu... C'est pour cette raison qu'ils lui auraient implanté ces souvenirs...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200236,
					"content": "(Je le connais, il doit sans aucun doute avoir pensé à cette possibilité. Ça voudrait donc dire qu'il a un plan...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "... Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200238,
					"content": "Je vous suis, Dain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "Et si ces souvenirs étaient vrais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
