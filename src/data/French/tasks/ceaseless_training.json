				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "Vous aviez l'air distrait. Vos déplacements étaient désordonnés et vos attaques ne se valaient pas toutes en puissance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310302,
					"content": "Nous ne pouvons pas continuer comme ça. Préparez-vous d'abord et nous reprendrons plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
