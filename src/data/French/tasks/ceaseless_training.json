				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "*halète* Vos compétences surpassent vraiment les miennes, et de loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310402,
					"content": "Je serai plus sympa la prochaine fois...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "Non ! S'il vous plaît, ne retenez pas votre force. Je ne pourrai pas m'améliorer sans un bon entraînement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310404,
					"content": "Étant donné votre force, je suis certain que vous avez dû vous entraîner très dur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310405,
					"content": "Pardonnez-moi, mais je suis vraiment curieux de savoir comment vous avez fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310406,
					"content": "#Un énorme dragon m'a {M#entraîné}{F#entraînée} à planer un jour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "V—Vous avez plané avec un dragon ? C'est difficile à imaginer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310410,
					"content": "... Rien de spécial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "#Hahaha, vraiment ? Dans ce cas, vous êtes exceptionnellement {M#talentueux}{F#talentueuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310412,
					"content": "#Merci de vous être {M#entraîné}{F#entraînée} avec moi. Je me souviendrai de notre combat. Prenez ceci en remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310408,
					"content": "Un loup géant m'aide à améliorer mes compétences de combat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "C'est très brave de votre part. J'aurais aimé vous voir vous battre avec lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				}
			]
		},
