					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Lance droite... Ha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "#Je suis {M#venu}{F#venue} m'entraîner avec vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Oh ! C'est vous, vous acceptez à nouveau ma mission ? Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "J'ai de la chance que quelqu'un d'aussi doué que vous accepte de s'entraîner avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Votre maniement de la lance s'est beaucoup amélioré depuis la dernière fois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Haha... Ne dites pas de bêtises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "De ce que j'ai entendu dire, les lances ont été créées dans le but de permettre aux gens sans grande maîtrise des arts martiaux de pouvoir combattre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Cette arme est longue et pointue. Même si la personne qui la tient ne sait pas la manier correctement, elle reste intimidante rien qu'en la brandissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Cependant, sur le même principe... Je pense que les fourches de jardinage ont l'air plus imposantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "N'avez-vous pas déjà récupéré votre arme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Oui, mais ça ne veut pas dire que je dois arrêter de m'entraîner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Je suis déjà tombé sur des Oni des mers comme ce type, mais rien ne dit que je ne croiserai pas d'ennemis plus forts à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Je ne permettrai pas que mon arme tombe à nouveau entre les mains de l'ennemi et que mon honneur de samouraï soit à nouveau bafoué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
