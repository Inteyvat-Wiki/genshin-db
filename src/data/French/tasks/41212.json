					"nextDialogs": [
						412120302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120302,
					"content": "Les monstres font aussi des courses ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120303,
					"content": "Devrions-nous faire un tour rapidement avant leur retour ou préfériez-vous vous reposer un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120304,
					"content": "On peut se reposer et discuter un peu. Qu'en dites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "Parfait, ça me va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120309,
					"content": "Alors, on papote ? Moi aussi, je veux me joindre à la conversation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120310,
					"content": "Je sais que vous avez un tas de questions à mon sujet ou sur la situation et j'y répondrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120311,
					"content": "Malgré ça, il y a des choses sur lesquelles je ne peux pas entrer dans les détails. Je ne veux pas vous mentir, alors vous devrez accepter que je sois un peu évasif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120312,
					"content": "Vous pouvez être direct quand vous le voulez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120313,
					"content": "Vous êtes plus sincère que je le pensais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120316,
					"content": "Oui, tout à fait ! ... Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120318,
					"content": "C'est vous qui faites ces bruits bizarres, Albedo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "Vous pensez vraiment que je peux faire ce genre de bruit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120322,
					"content": "Ah ! Un Brutocollinus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "C'est toi, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "Et puis quoi encore ? Pourquoi ce ne serait pas Albedo, d'abord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120314,
					"content": "Vous êtes plus insouciant que je le pensais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "J'ai quelques questions à vous poser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120308,
					"content": "Allez-y, je vous écoute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				}
			]
