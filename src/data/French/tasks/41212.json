			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "Albedo, c'est nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120102,
					"content": "Ah, il discute avec quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120103,
					"content": "Et quelqu'un qu'on connaît en plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "Oui, ce serait trop dangereux que nos nouvelles recrues s'aventurent ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120106,
					"content": "Mais le principe de l'aventure est de repousser ses limites ! Que ferions-nous si tout était facile ? Ça ne serait pas drôle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120107,
					"content": "Cet endroit peut être infesté de Brutocollinus féroces et avec de la neige à perte de vue, mais un aventurier ne doit jamais baisser les bras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120108,
					"content": "Cyrus, je vous prie d'aller droit au but.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120109,
					"content": "Hahaha ! La conversation, c'est comme l'aventure : l'important c'est le voyage, pas la destination !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120110,
					"content": "Même en étant forcé d'abandonner son campement avec rien d'autre que ses vêtements sur le dos, on peut allumer un feu dans la neige pour cuisiner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120111,
					"content": "Cette excursion dans les montagnes sera une expérience inoubliable pour toutes nos jeunes recrues, hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120112,
					"content": "OK.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120113,
					"content": "Ils m'en voudront sûrement et me détesteront même, mais ils m'en seront reconnaissants un jour. Je leur aurai transmis le goût de l'aventure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120114,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120115,
					"content": "Ouh, Albedo ne fait vraiment pas semblant d'être intéressé quand il ne l'est pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120116,
					"content": "L'aventure n'a pas l'air d'être son truc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "Tu penses ? En tout cas, il s'intéresse beaucoup à toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120118,
					"content": "Tout compte fait, j'ignore si ce sont nos recrues qui sont trop inexpérimentées ou si c'est cette montagne qui est trop dangereuse. Cette fois, nos pertes ont été importantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120119,
					"content": "De quoi parlez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120120,
					"content": "Oh, c'est vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120121,
					"content": "Bonjour Cyrus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "Ça faisait un bail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120123,
					"content": "#Ah, {M#le}{F#la} jeune {M#aventurier}{F#aventurière} et son amie ! Je suis ravi de vous voir ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120124,
					"content": "J'en conclus que cette ascension glaciale ne vous a pas posé trop de problèmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120125,
					"content": "Ne vous en faites pas, on gère !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120126,
					"content": "Super ! J'aime votre assurance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120127,
					"content": "Vous avez bravé le vent et la neige, dites donc ! Quelle mission importante vous amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120128,
					"content": "#Je suis venu collecter les dernières données concernant les Brutocollinus, et je lui ai demandé de me servir d'{M#assistant}{F#assistante}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120129,
					"content": "(Depuis quand ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "Je vois. Des jeunes gens à la poursuite de rêves et d'idéaux, n'est-ce pas formidable ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120132,
					"content": "Je vous souhaite bien du succès dans votre quête. Sur ce, je dois aller voir mes nouvelles recrues !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120201,
					"content": "Hoho, je crois qu'on a fait une découverte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120202,
					"content": "Albedo ne semble pas vouloir que Cyrus sache pour l'épée.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "On parle d'une épée magique légendaire, normal qu'il veuille garder ce secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120204,
					"content": "Je vous entends, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120205,
					"content": "Je n'aurais pas dû le mentionner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "Peu m'importe. Je peux vous dire tout ce que vous souhaitez savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120207,
					"content": "Mais pas tout de suite. J'ai d'autres affaires plus urgentes à régler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120208,
					"content": "Des affaires urgentes ? Laissez-moi deviner... Vous avez besoin de nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120209,
					"content": "Vous devenez de plus en plus intelligente, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120210,
					"content": "Quoi ?! Mais j'ai toujours été très intelligente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120211,
					"content": "J'ai découvert de nouveaux habitats avec des monstres différents dans le coin. On pourra récolter des données variées grâce à eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120212,
					"content": "Vous consacrez vraiment votre vie à vos recherches...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "Il faut être persévérant dans ses recherches. C'est la base pour un alchimiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120214,
					"content": "#{M#Prêts}{F#Prêtes} ? Alors, allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120130,
					"content": "(Albedo semble vouloir éviter de parler de l'épée...)",
