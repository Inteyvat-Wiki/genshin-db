			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "On dirait qu'il n'y a rien devant à part cette caverne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120602,
					"content": "Vous croyez qu'il s'est réfugié dedans ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "À en juger par les traces de pas, c'est fort probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120604,
					"content": "Allons-y ! Il ne faut pas qu'on le laisse filer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120605,
					"content": "Une minute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120606,
					"content": "Cette montagne est immense. Même s'il y a un chemin devant, je doute qu'il soit facile à traverser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120608,
					"content": "Pouvez-vous le sentir ? La froideur de la glace et l'odeur de la pierre... J'entends aussi de l'écho. Cette caverne doit être vaste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120609,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120610,
					"content": "Ne nous précipitons pas. Ça ne présage rien de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120611,
					"content": "Mais nous avons fait tout ce chemin ! On ne peut pas repartir bredouille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120612,
					"content": "Vous aviez l'air d'y tenir à ce carnet, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "J'y tiens, mais ça ne veut pas dire que nous devons foncer tête baissée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120614,
					"content": "Bien que ça soit plus long, il y a une autre façon de parvenir à nos fins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120615,
					"content": "Si je ne me trompe pas, la sortie de la caverne doit se trouver de l'autre côté de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120616,
					"content": "#Comme vous êtes plutôt {M#doué}{F#douée} en planeur et que je me débrouille aussi, préparons-nous à planer là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
