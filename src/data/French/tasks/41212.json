			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "Vous avez vu ? Ce Brutocollinus est parti avec un livre dans les mains !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120502,
					"content": "Hum, je suis embêté... C'était mon carnet de croquis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120503,
					"content": "Peut-être qu'il veut devenir artiste ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "Je ne crois que c'était juste un voleur ordinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120506,
					"content": "Il a osé voler mon carnet, quel toupet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120507,
					"content": "Albedo est toujours si calme, même quand il est énervé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120508,
					"content": "Je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "Il est passionné d'alchimie ?",
					"roleType": "TALK_ROLE_PLAYER",
