			},
			"dialogs": [
				{
					"id": 412120701,
					"content": "Comment ça se passe avec votre carnet, Albedo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120702,
					"content": "Quelques pages ont été détruites, mais le reste est intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120703,
					"content": "La température de la montagne est glaciale. Elle peut atteindre des valeurs extrêmement basses, surtout près de la caverne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120704,
					"content": "Puis les Brutocollinus ont bavé partout dessus. Je n'ose pas imaginer ce que ça donne à une température pareille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120705,
					"content": "C'est fragile le papier gelé... Il n'en faudrait pas beaucoup pour le casser, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120706,
					"content": "Encore heureux que vous avez su le réparer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "Quelle ingéniosité digne d'un alchimiste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120708,
					"content": "Vous seriez entré dans une rage folle s'il avait été très endommagé, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120709,
					"content": "Qu'est-ce qui vous fait dire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120710,
					"content": "Bah, vous nous avez dit qu'il y avait un tas de notes et de dessins à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120711,
					"content": "Ce carnet me suit partout, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120712,
					"content": "Mais je ne me serais pas énervé pour autant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120713,
					"content": "J'aurais simplement tout recommencé dans ce cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120714,
					"content": "Vous êtes bien pragmatique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120715,
					"content": "Je ne pense pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "Ah bon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120718,
					"content": "Vous y avez mis du vôtre dans ces croquis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120720,
					"content": "Pensez à tous les souvenirs qui y sont renfermés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "Tout à fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120722,
					"content": "Vous ne pouvez pas laisser ces précieux souvenirs derrière vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "Voilà ! Je n'aurais pas mieux dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120724,
					"content": "Vous avez raison... Tout recommencer serait très pénible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120725,
					"content": "Surtout que vous êtes si talentueux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120726,
					"content": "Vous êtes capable de choses dont tout le monde rêve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120727,
					"content": "Mais vous oubliez parfois les détails. C'est l'un des inconvénients d'être intelligent, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120728,
					"content": "Albedo a aussi complimenté ton intelligence, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "Vous êtes indéniablement une créature très intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120730,
					"content": "Tu oublies aussi les détails, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "Ahhh, c'est pas gentil de se moquer de moi comme ça quand je raconte un truc intelligent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120733,
					"content": "Passons à autre chose : Cyrus m'a raconté que des aventuriers se faisaient attaquer et dépouiller par les Brutocollinus de cette montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120734,
					"content": "L'endroit où nous étions plus tôt doit être un de leurs camps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120735,
					"content": "Les Brutocollinus du coin sont forts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "Ils sont plus puissants que ceux du bas de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120737,
					"content": "Je suis d'accord. Certainement à cause du dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120738,
					"content": "Le pouvoir de corruption émanant des restes de Durin rend les monstres plus puissants, ce qui, en combinaison avec le climat glacial, a contribué à dépeupler certaines zones de la montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120739,
					"content": "Pourriez-vous dégainer l'épée, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120740,
					"content": "L'épée a absorbé de l'énergie à chaque combat pour la stocker en elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120741,
					"content": "Qui plus est, l'influence maléfique du dragon a disparu grâce à votre capacité de purification.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120742,
					"content": "Fascinant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120743,
					"content": "Ce n'est pas la première fois, on s'y connaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120744,
					"content": "C'est à ça que le processus de purification ressemble ? En entendre parler est une chose, mais le voir en est une autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120745,
					"content": "Cette épée absorbatrice d'énergie est dangereuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "Je ne peux qu'être d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120747,
					"content": "Heureusement qu'elle est entre de bonnes mains, on aurait été dans le pétrin si les Brutocollinus avaient mis la main dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120748,
					"content": "Les Fatui ne sont-ils pas plus dangereux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "Les Brutocollinus sont une menace ! L'épée pourrait les transformer en... Super, non, Ultra Brutocollinus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120751,
					"content": "Ultra Brutocollinus !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "Ultra Brutocollinus démoniaque !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120753,
					"content": "Ultra Brutocollinus démoniaque des neiges !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "« Des neiges » ? Nah, ça ne colle pas. Tu as tout gâché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120755,
					"content": "D'ailleurs, cette épée... Si elle est si puissante, ne peut-elle pas aussi absorber votre énergie, Albedo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120756,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120757,
					"content": "Ça vous dit d'essayer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120758,
					"content": "Ouh, quel regard glacial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120759,
					"content": "Paimon plaisantait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "Je ne suis pas en colère. Après tout, j'espère que vous continuerez à l'utiliser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120762,
					"content": "Vous voulez quand même nous confier cette épée dangereuse ? Eh bah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120763,
					"content": "Albedo, vous dites tout et son contraire ! On n'arrive jamais à connaître le fond de votre pensée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120764,
					"content": "Je ne sais pas de quoi vous parlez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120765,
					"content": "Mais si vous voulez savoir pourquoi je vous fais tant confiance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120766,
					"content": "C'est parce qu'on se comprend entre semblables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120767,
					"content": "Semblables ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "Nous sommes tous les deux des êtres solitaires... et différents des autres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120769,
					"content": "(...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "(Que veut-il sous-entendre par là ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "Paimon ne voulait rien dire de mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "Les Pilleurs de trésors ne sont-ils pas plus dangereux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120731,
					"content": "Je ne pense pas que Paimon ait le même problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120716,
					"content": "#J'aurais été {M#furieux}{F#furieuse} à votre place !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				}
			]
		},
