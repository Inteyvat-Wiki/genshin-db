			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "Quoi ? Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200102,
					"content": "#Ah, c'est {M#un}{F#une} nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200103,
					"content": "*tousse* Je suis désolé que tu me voies dans cet état, nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200104,
					"content": "#{M#Gentil}{F#Gentille} nara, je suis Arachatora. Qui êtes-vous, vous deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200105,
					"content": "#Moi, c'est {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "Moi, c'est Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200107,
					"content": "#Nara {NICKNAME} et Paimon, d'accord. Merci beaucoup, si le destin ne nous avait pas fait nous rencontrer ici, il m'aurait fallu plus de temps pour récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200108,
					"content": "« Plus de temps », c'est combien de temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200109,
					"content": "J'ai honte de le dire, mais il m'est arrivé une chose similaire autrefois à cause de mauvais champignons. Ensuite, il a fallu attendre qu'un nilotpalotus ait fleuri et se soit refermé deux fois pour que je sois rétabli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200110,
					"content": "Un nénuphar qui fleurit et se referme... Ça prend deux jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200111,
					"content": "Ah, deux jours. Je vois. C'est donc ça que le mot « jour » signifie. C'est intéressant. Deux jours, c'est long ou court ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200112,
					"content": "#Hmm... Qu'en penses-tu, {NICKNAME} ? C'est long ou court ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200113,
					"content": "Long, je suppose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Hmm. Je ne veux pas imaginer Arachatora pleurnicher sans s'arrêter pendant deux jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200115,
					"content": "Ah oui ? Alors, ça doit vraiment être long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200126,
					"content": "Mais si toi, tu es Arachatora, cela veut dire que... tu es de la famille d'Arapacati ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200127,
					"content": "Non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200128,
					"content": "Hein ? Mais... Tu es le frère d'Arapacati pourtant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200129,
					"content": "Hein, comment le sais-tu ? Arapacati est ma « sœur ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200130,
					"content": "Qu'est-ce que c'est que cette histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200131,
					"content": "Peut-être que les aranaras ont une définition différente de ce concept...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "Bref, voilà ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200133,
					"content": "Vous racontez à Arachatora ce qui s'est passé.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "Le Festival Utsava va à nouveau avoir lieu... Comment faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200135,
					"content": "Je n'ai pas préparé les ingrédients importants. Le Festival Utsava est le moment où je dois prouver à Arasaka, Arapas et Araphala que les plats à base de champignons sont les meilleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200136,
					"content": "D'ailleurs, Aras... Pas... Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200137,
					"content": "Arasaka, Arapas et Araphala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "Ahhh ! Les noms aranariens sont si difficiles à retenir ! Arachatora, où sont tes frères ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200139,
					"content": "On s'est éloignés les uns des autres alors qu'on suivait chacun notre propre voie pour nous entraîner, tout comme une rivière se divise en plusieurs ruisseaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200140,
					"content": "#Alors vous vous êtes séparés, c'est ça{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200141,
					"content": "On s'entraîne pour cuisiner la suprême délicatesse. Mais ils ne veulent pas reconnaître la valeur des plats à base de champignons, alors qu'il n'y a rien de meilleur que le champignon de tête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200142,
					"content": "Quoi qu'il en soit, on a décidé de terminer nos plats chacun de son côté puis d'en faire la comparaison plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200143,
					"content": "Ah, je vois. Se mettre en quête de nourriture délicieuse, c'est tout à fait quelque chose qui me parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200144,
					"content": "Alors il est où, ton champignon de tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200145,
					"content": "La Marana s'est répandue rapidement. Même l'habitat naturel du champignon de tête a été envahi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200146,
					"content": "Ah, la zone de siccité... J'espère que Rana se porte bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200147,
					"content": "Je crains que les précieux champignons n'aient également été arrachés par ses griffes et ses dents desséchées. Je suis sûr que vous avez conscience du danger que représente la Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200148,
					"content": "Faute de champignon de tête, j'ai essayé des champignons bizarres qu'aucun aranara n'avait jamais mangés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200149,
					"content": "Et alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200150,
					"content": "Et alors, on vient de voir le résultat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Je suis vraiment désolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200153,
					"content": "Mais maintenant que j'y pense, on a déjà eu affaire à la siccité, ou plutôt la Marana, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200154,
					"content": "C'était facile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "Ouah, incroyable ! Vous êtes de taille à affronter la Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200157,
					"content": "#Enfin, c'est dans la logique des choses. Puisque nara {NICKNAME} a pu me guérir avec le pouvoir de la Rani Kusanali, il est facile pour {M#lui}{F#elle} d'éliminer la Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200158,
					"content": "#Je voudrais donc te demander, nara {NICKNAME}, si tu pouvais venir avec moi dans l'habitat naturel du champignon de tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200159,
					"content": "#C'est l'occasion de goûter des plats délicieux à base de champignons{NON_BREAK_SPACE}! {NICKNAME}, aidons les aranaras à se réunir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200160,
					"content": "D'accord. Je l'ai promis à Arapacati de toute façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "Bon. C'est dans la grotte devant nous. Venez avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200161,
					"content": "Tu ne penses qu'à manger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "C'est faire d'une pierre, deux coups ! Où est le problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200155,
					"content": "C'était laborieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "Ooooooh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Court, je suppose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "Hmm... C'est vrai. En y réfléchissant, on se connaît depuis longtemps, mais j'ai quand même l'impression que c'était hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200118,
					"content": "Ah oui ? Alors je suis soulagé. Perdre mes moyens dans la forêt pendant deux jours, c'est pas très long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200119,
					"content": "Ce n'est pas ce que je voulais dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200120,
					"content": "Cela dépend de comment ce temps a été utilisé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Oui, tu as raison. Pleurnicher pendant deux jours entiers, c'est long. Mais deux jours dans la vie d'un sanglier des forêts, c'est très court.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200122,
					"content": "Ah oui ? Alors, ça doit vraiment être long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200123,
					"content": "Le temps est un concept subjectif qui n'a pas de sens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Oui. Nara {NICKNAME}, tu saisis bien les lois naturelles de la forêt. Dans la forêt, la vie naît, la vie grandit, et la vie retourne à la terre... On n'a pas besoin d'un concept tel qu'un « jour ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200125,
					"content": "Qu'est-ce que tu racontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "Ahh ! C'est le champignon de tête dont j'ai toujours rêvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "Champignon de tête, serais-tu toujours le même sans ton parfum ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "Héhé... Un champignon. C'est vrai qu'il sent bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "Quoi qu'il en soit, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "#J'ai tellement de chance de vous avoir {M#rencontrés}{F#rencontrées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200302,
					"content": "C'est l'odeur d'un champignon de tête bien mûr. Elle est plus forte que la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200303,
					"content": "On dirait que tu as bien grandi, alors même que ton habitat a été envahi par la Marana. Tu es incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200304,
					"content": "Euh, donc... On peut le goûter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200305,
					"content": "Bien sûr. Hormis le fait que vous m'avez aidé, le but de mon entraînement culinaire est aussi de pouvoir servir des plats à base des champignons les plus délicieux aux naras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200306,
					"content": "Chouette ! Un champignon de tête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200307,
					"content": "Arachatora se met à cuisiner...\\nLa marmite laisse s'échapper une forte odeur de champignon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "#Puis Arachatora vous remet le repas.\\n... Doit-on plutôt dire que c'est décevant, ou alors que vous vous y attendiez{NON_BREAK_SPACE}? En tout cas, c'est un plat sans aucune saveur.\\nEn plus de cela, le champignon est encore tellement vivant et dur qu'il est difficile à mâcher.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "... C'est fini. Mon entraînement culinaire s'achève enfin avec succès. Qu'est-ce que vous en pensez ? Je suis sûr que c'est le meilleur mets que les naras puissent goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200310,
					"content": "*chomp chomp* ... *glou glou* ... Hmm... Comment dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200311,
					"content": "(Mâcher avec force...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "(Avaler avec force...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "C'est comestible. Si on mâche assez fort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Hmm... C'est un champignon très parfumé, mais sa texture et son goût ne nous conviennent pas vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200317,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200318,
					"content": "#Comment ça se fait ? J'avais préparé la même chose pour {M#une}{F#un} nara, et {M#elle}{F#il} a dit que c'était délicieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200319,
					"content": "Auparavant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200320,
					"content": "#J'ai préparé mon plat de champignons à {M#une}{F#un} nara il y a quelque temps, et comme c'était délicieux, {M#elle}{F#il} l'a avalé d'une traite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200321,
					"content": "Ça ne doit pas être mon plat le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200323,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "Ah ! C'est comme le fait que les aranaras ont différentes sortes de feuilles. Peut-être que le goût des champignons ne convient pas à tous les naras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200325,
					"content": "Au fait, en parlant de feuilles... Les aranaras n'ont pas peur du feu ? Vous avez l'air d'être recouverts d'une sorte de feuillage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200326,
					"content": "Bien sûr que ça nous fait peur. Parfois, quand un feu s'allume dans la forêt, il emporte tout sur son passage jusqu'à ce que rien ne reste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200327,
					"content": "Cependant, vaincre la peur du feu et contrôler la vivacité des flammes font également partie de l'entraînement culinaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200328,
					"content": "Alors c'est comme ça... Il est temps de rentrer. Arapacati t'attend !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200329,
					"content": "Oui, je vais retourner immédiatement à Vanarana. Je ne peux pas laisser ma sœur s'inquiéter pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200330,
					"content": "Quant aux autres... Arasaka, Arapas et Araphala sont <color=#00E1FFFF>près de Gandharva</color>, <color=#00E1FFFF>dans les Bois d'Apam</color> et <color=#00E1FFFF>à la Montagne Devantaka</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200331,
					"content": "#Merci à vous. {NICKNAME}, nara {M#flamboyant}{F#flamboyante}, tu rayonnes tel un soleil éblouissant. Paimon, toi aussi, tu es un petit peu impressionnante. Je vous laisse vous occuper de la mission de ma sœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200332,
					"content": "Pourquoi je suis seulement « un petit peu impressionnante » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200333,
					"content": "Euh... Oublie ! En tout cas, je ne sais pas comment vous remercier pour votre aide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200334,
					"content": "#Hmm... J'ai décidé de vous apprendre la recette de la suprême délicatesse. Peut-être que quand vous serez {M#grands}{F#grandes}, vous apprécierez son goût.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}, laisse-moi modifier un peu cette recette... On devrait pouvoir en faire un bon plat bien original !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200314,
					"content": "Au moins, ce n'est pas toxique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "Mon palais n'est pas encore prêt pour ce genre de saveurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
			"id": 7302004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
