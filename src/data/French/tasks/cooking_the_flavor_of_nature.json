			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "#Je suis si heureux d'avoir pu trouver des champignons de tête, d'avoir terminé mon entraînement culinaire et aussi d'avoir fait la connaissance d'{M#un grand nara}{F#une grande nara} sur qui on peut compter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Arapacati, Arasaka, Arapas et Araphala vous seront reconnaissants, eux aussi. Nara {NICKNAME}, tu es {M#un gentil nara}{F#une gentille nara}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Reconnaissants ? Pourquoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Car grâce à votre aide, ils auront la chance de pouvoir goûter au champignon de tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
		{
			"id": 7302005,
			"completionStepIds": [],
