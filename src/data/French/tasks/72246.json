			"dialogs": [
				{
					"id": 722460401,
					"content": "« Le monde est vaste et infini... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460402,
					"content": "C'est une citation de l'« Escadron Joururi » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460403,
					"content": "Exact. Vous avez bonne mémoire, Kama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460404,
					"content": "Vous m'aviez raconté cette histoire.",
					"roleType": "TALK_ROLE_NPC",
