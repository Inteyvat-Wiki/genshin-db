			"dialogs": [
				{
					"id": 722460301,
					"content": "Quelle est notre prochaine destination, dame Sumida ? Des idées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Hmm... J'ai entendu dire que Mondstadt avait une très grande bibliothèque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
