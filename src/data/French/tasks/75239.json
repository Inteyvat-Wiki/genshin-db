			"dialogs": [
				{
					"id": 752390101,
					"content": "#Argh, ce Zhaka... Il a abandonné son poste avant d'avoir terminé son travail{NON_BREAK_SPACE}! Et qui sait où il a caché les poupées{NON_BREAK_SPACE}! Je vais porter plainte{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390102,
					"content": "De quelles poupées parlez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "De poupées fabriquées avec des koholasaures comme modèles. Je m'occupe de les peindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "Mais Zhaka, mon apprenti, n'est pas venu travailler ces derniers temps. Il en avait encore trois à peindre, et je ne sais pas où il les a mises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "#{M#Cher client}{F#Chère cliente}, auriez-vous la gentillesse de m'aider à les chercher ? Elles ne devraient pas être très loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanei"
				}
