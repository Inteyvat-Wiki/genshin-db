					}
				]
			},
			"dialogs": [
				{
					"id": 150250101,
					"content": "#Je suppose que c'est vous qui avez été {M#désignés}{F#désignées} par l'aîné Tlapo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "En effet ! Et vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Vous pouvez m'appeler Toltec. Le chef m'a demandé d'être votre guide pour la journée. Ses messagers m'ont déjà informé de la situation, suivez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#Nous sommes déjà {M#venus}{F#venues} ici, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "#C'est vrai, mais n'oublie pas que nous avons été {M#désignés}{F#désignées}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "Ce qui est étrange, c'est que nos ancêtres n'ont jamais retiré le sceau, même après avoir terminé leur graffiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Depuis que cet espace a été scellé, la seule personne à y être entrée est la grande shamane Huitzilin. Et c'était il y a deux cents ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Selon elle, l'œuvre raconte l'histoire d'un héros du nom de Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "... Mais je m'éloigne du sujet. Désolé, je suis un grand amateur de graffitis. Et une fois que je commence, je peux continuer pendant des heures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Tu ne voudrais pas venir avec nous dans ce cas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Non, merci. J'ai déjà essayé d'entrer, mais le sceau m'en a empêché. J'ai essayé de faire en sorte que mon iktomisaure le lève pour moi grâce à ses pouvoirs, mais ça n'a pas fonctionné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Je suppose que c'est censé être un test imposé par nos ancêtres. Si vous ne réussissez pas le test, vous n'êtes pas digne de voir leurs œuvres d'art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Mais ne vous en faites pas pour moi. Je ne vous accompagnerais pas, même si je pouvais y entrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Contrairement à notre chef, je n'ai pas le courage de remettre en question nos traditions. Cette tâche est spécifiquement confiée à quelqu'un par le grand aîné iktomisaure. Qui sait ce qui pourrait arriver si je vous suivais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "D'accord. Très bien, nous allons essayer de ne pas trop traîner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
