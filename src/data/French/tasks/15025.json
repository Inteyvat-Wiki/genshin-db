			"dialogs": [
				{
					"id": 150251001,
					"content": "Regardez cette vue. Qu'est-ce que vous en dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251002,
					"content": "C'est magnifique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Maintenant, regardez un peu plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251004,
					"content": "Waouh... Ce graffiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "Ces couleurs nous accompagnent depuis la création de notre tribu il y a plus d'un millénaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251006,
					"content": "Vous avez raison, je souhaite insuffler une nouvelle vie à cette ancienne tribu grâce à des changements et des réformes. Mais je sais aussi qu'il y a des éléments fondamentaux que nous ne pouvons pas abandonner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251007,
					"content": "Et le plus important d'entre eux est la façon dont nous consignons notre histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251008,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "Depuis ses débuts, notre tribu a toujours cherché à donner de la couleur à l'histoire. J'ai le sentiment profond que c'est une partie de notre héritage à laquelle nous ne devons pas renoncer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251010,
					"content": "Je dois donc trouver un moyen de continuer à tisser ces rouleaux traditionnels, coûte que coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251011,
					"content": "Vous avez tout à fait raison. Je suis désolée pour ce que j'ai dit tout à l'heure. C'était déplacé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "Ce n'est rien. J'apprécie le fait que vous puissiez comprendre mon point de vue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				},
				{
					"id": 150251013,
					"content": "Nous allons vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "Espérons alors que lors de notre prochaine rencontre, nous réussirons à redonner vie à cette tradition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chef des Maîtres du vent nocturne"
				}
			]
		},
