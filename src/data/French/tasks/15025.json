			"dialogs": [
				{
					"id": 150251801,
					"content": "Les ancêtres de la tribu ont laissé ici de véritables œuvres d'art. Mais d'après ce que nous avons vu jusqu'à présent, l'histoire semble inachevée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251802,
					"content": "Tu crois qu'il y a d'autres œuvres plus loin ? Ça paraît un peu étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251803,
						150251805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251803,
					"content": "On peut aller voir si tu veux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Oh, pas besoin. Je réfléchissais simplement à voix haute. Toltec nous attend et nous avons du travail, nous ferions peut-être mieux d'y aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251807,
					"content": "Allons retrouver Toltec !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251805,
					"content": "Peut-être, mais nous avons du travail. Concentrons-nous là-dessus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251806
					]
				},
				{
					"id": 150251806,
