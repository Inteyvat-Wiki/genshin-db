			"dialogs": [
				{
					"id": 150251501,
					"content": "La teinture est donc quelque part dans cette grotte, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251502,
					"content": "Je ne peux pas vous emmener plus loin. Seules les personnes désignées sont autorisées à continuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251503
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251503,
					"content": "Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251504,
					"content": "C'est une longue histoire. Apparemment, il y a un certain fruit qui pousse dans cette grotte, et son jus peut être transformé pour fabriquer une excellente teinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251505
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251505,
					"content": "Il y a de nombreuses années, nos ancêtres ont entrepris de réaliser une série d'impressionnants graffitis. Ils ont choisi cette grotte, probablement en raison de la disponibilité de la teinture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251506
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251506,
					"content": "Cependant, ils ne voulaient pas que quiconque voie leur travail avant qu'il ne soit terminé. Ils ont donc scellé l'entrée pour en contrôler l'accès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251507
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251507,
					"content": "Pour passer outre le sceau, il faut maîtriser l'art de la perception des couleurs ou quelque chose comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251508
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251508,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
