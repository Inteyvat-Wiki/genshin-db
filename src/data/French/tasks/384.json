						3840203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840203,
					"content": "Pas mal pour des retrouvailles, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840204,
					"content": "Préparons-nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Qu'importe le résultat, au moins les choses commencent à bouger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Mondstadt a tellement souffert ces derniers temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "#En fin de compte, la solution à notre problème était {M#un voyageur}{F#une voyageuse} et un barde. Qui l'eût cru ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "Bon, j'admets que l'Ordre de Favonius a aussi contribué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "On a compris, maître Diluc... Écartez-vous tous, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "Le meilleur barde itinérant du monde des mortels va jouer de la lyre sacrée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 38404,
