			"dialogs": [
				{
					"id": 3840401,
					"content": "Barb... Venti, faites attention à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840402,
					"content": "Haha... Ainsi donc, vous aviez deviné ma vraie identité, Jean... Je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840403,
					"content": "Enfin... Merci d'avoir continué de m'appeler Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840404,
					"content": "Dans quel état est la lyre sacrée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840405,
					"content": "Peut-on encore en jouer ? Ou faut-il la réparer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840406,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840407,
					"content": "Malheureusement, je crois qu'elle est fichue pour de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840408,
					"content": "Nous ne pouvons pas laisser filer ce Mage de l'Abîme !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "Bien dit. Nous ne pourrons jamais sauver Dvalin si on n'éradique pas le mal à sa source.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840413,
					"content": "Je vais demander à Amber de le retrouver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840414,
					"content": "Pas besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840415,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840416,
					"content": "J'ai éliminé l'un des leurs dans les ruines d'un des temples des Quatre Vents l'autre jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840417,
					"content": "Hein ? Quand ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840418,
					"content": "On peut compter sur mon réseau pour retrouver ces créatures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840419,
					"content": "Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840420,
					"content": "Malgré son aversion pour l'Ordre de Favonius, il protège aussi Mondstadt – à sa propre manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840421,
					"content": "Oh ? Te voilà bien affectueuse tout à coup, toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840422,
					"content": "Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840423,
					"content": "Attendez de mes nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840424,
					"content": "Je vais leur montrer qu'il importe peu que l'Ordre de l'Abîme soit une organisation sans foi ni loi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840425,
					"content": "Il y a certaines choses qu'on ne fait pas, à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840410,
					"content": "Dvalin court un grand danger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "Nous devons éliminer le mage en premier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "Diluc"
