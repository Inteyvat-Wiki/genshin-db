			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, nous sommes de retour ! Nous avons trouvé votre jeton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Vous donnez le jeton à Puca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Oh oui, c'est celui-là ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Nous avons également trouvé autre chose pendant que nous cherchions votre jeton...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "C'est un minerai que nous n'avons jamais vu auparavant. Nous avons pensé que cela pourrait être précieux et l'avons ramené !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Si je me souviens bien, vous ramassez souvent de jolies pierres dans cette zone, n'est-ce pas ? Avez-vous déjà vu des pierres comme celle-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Laissez-moi voir... C'est vraiment joli ! Mais ce n'est pas précieux du tout... C'est juste une pierre ordinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "Il est vrai que vous ne trouverez rien de tel ailleurs, mais il y en a partout dans les filons de minerai à proximité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Oh, donc c'est juste une pierre ordinaire ! Ça avait l'air super précieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "On dirait qu'il ne nous reste plus qu'à trouver un endroit pour la jeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Mais si ce minerai ne se trouve pas ailleurs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Oh, tu veux dire qu'on pourrait faire fortune si on l'emmenait ailleurs et qu'on la vendait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Tu marques un point ! Normalement, les gens ne vont pas dans les mines d'un village de mélusines, ce qui signifie qu'ils n'ont probablement jamais rien vu de tel... Excellente idée, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Allez, apportons cette pierre à la Cour de Fontaine et montrons-la aux marchands !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "S'il y a autre chose que vous aimeriez savoir sur les minerais, venez me trouver quand vous voulez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Bien que je ne dirige pas d'atelier de gemmes comme ma sœur, et que je ne connaisse pas grand-chose aux évaluations ou au traitement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Je préfère collectionner toutes sortes de roches uniques que des gemmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Je suppose qu'on peut dire que je connais assez bien les veines de minerai locales !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Haha, j'ai compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Si c'est unique à cette région...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
