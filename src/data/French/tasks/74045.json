			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca, que faites-vous encore là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Il ne devrait plus y avoir de monstres à proximité, mais qui sait quels autres dangers il pourrait y avoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Vous ne devriez pas vous promener toute seule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "Je ne me suis pas enfuie... Je cherche juste mon jeton...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Hein ? Vous avez perdu votre jeton ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Oui... Il devrait être quelque part autour de cet endroit où j'ai l'habitude de ramasser des cailloux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Hmm, peut-être que vous l'avez accidentellement laissé là-bas quand vous y étiez restée coincée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*sanglote* Ouais, vous avez peut-être raison... J'avais trop peur pour me soucier de quoi que ce soit d'autre à ce moment-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "C'est encore un peu effrayant d'y penser, mais mon jeton est très important... Je dois le trouver, je dois juste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Hmm... Je pense que ce serait trop dangereux si Puca y allait toute seule. Dans ce cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, pourquoi n'y retournerions-nous pas pour retrouver le jeton de Puca ? Puca, rentrez chez vous et attendez là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "On s'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Merci, {NICKNAME} et Paimon ! Je vais suivre vos conseils et vous attendre à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "J'avais envie d'explorer cet endroit de toute façon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
