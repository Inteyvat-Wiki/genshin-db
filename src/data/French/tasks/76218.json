			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sandrone"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh ? Vous voilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180102,
					"content": "Salut, Sandrone !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Merci pour l'invitation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Hein ? Votre lettre ne parlait-elle pas de prendre le thé ensemble ? Pourquoi il n'y a rien ici ? Ne me dites pas que c'est une réunion sans encas ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Ha, sérieusement. Vous me sous-estimez, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180107,
					"content": "Ouah ! Cette table est... apparue comme par magie ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Héhé, impressionnant, non ? C'est la nouvelle table à thé portable que j'ai développée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180109,
					"content": "Elle est facile à transporter et à ranger. Elle est même équipée d'un dispositif de lévitation, comme celui de Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180110,
					"content": "Et le plus impressionnant, c'est que... Euh, laissez tomber, je ne veux pas me vanter et transformer ça en argument de vente. Vous pouvez voir par vous-mêmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180111,
					"content": "Tenez, j'ai préparé du thé et des encas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180112,
					"content": "Je vais me servir alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Hmm...! C'est tellement délicieux ! Vous cuisinez vraiment très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Naturellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180115,
					"content": "Mais qu'est-ce qui vous a inspiré pour créer quelque chose comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Je voulais pouvoir profiter d'agréables goûters avec mes amis, où qu'ils soient, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180117,
					"content": "Je l'ai déjà dit. S'accrocher à ce qu'on possède déjà n'est pas la seule façon de préserver ce qui est précieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180118,
					"content": "Dernièrement, j'ai envie de me promener et de rendre visite à mes amis plus souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180119,
					"content": "Mais m'inviter chez les autres en m'attendant à ce qu'ils préparent du thé et des encas, puis les laisser débarrasser ensuite... Ce n'est pas convenable pour une dame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180120,
					"content": "Héhé, je pense que ça ne dérangerait pas vos amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Moi, ça me dérange. De toute façon, une simple invention comme celle-ci ne me pose aucun problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180122,
					"content": "Puisque qu'elle vous plaît autant, autant vous en offrir une.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180123,
					"content": "Hein ?! Vous êtes sûre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Absolument. Je vous ai dit que fabriquer ce genre de choses était un jeu d'enfant pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180125,
					"content": "Dans ce cas, merci beaucoup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Je vous en prie, vous m'avez aussi beaucoup aidée lors du Festival Fontinalia. Considérez cela comme une façon de vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180104,
					"content": "J'espère que nous ne vous avons pas fait attendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}