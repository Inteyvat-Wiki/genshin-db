			"dialogs": [
				{
					"id": 706990101,
					"content": "#Chevalier honoraire ! Quelle chance que vous soyez {M#venu}{F#venue} tester les stands de divertissement. Ça me rassure vraiment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "C'est la première fois que je participe à un projet de développement, alors je suis un peu nerveux. J'ai l'impression que mon cerveau est en train de fondre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Je devais simplement concevoir un boîtier pour un appareil existant. Mais il y avait tellement de choses à prendre en compte pour sa conception, tellement de paramètres à ajuster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Je ne sais pas comment le capitaine Albedo fait pour créer des dispositifs sur mesure à partir de rien... Ça doit être tellement difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Je pense que ça fonctionne très bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "Waouh, euh... M—Merci ! Ça me touche énormément venant de vous, chevalier honoraire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Je... Je vais continuer à faire de mon mieux. J'espère qu'un jour, je pourrai créer des choses utiles pour l'unité de reconnaissance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "Oh, j'ai gagné quelques jouets à l'un des jeux. J'aimerais vous offrir celui-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "J'en ai un autre identique. Chaque fois que je le regarderai, je penserai à tous vos encouragements !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Ne sois pas trop dur avec toi-même. Tu continueras à t'améliorer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
