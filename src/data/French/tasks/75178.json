			"dialogs": [
				{
					"id": 751781401,
					"content": "Oh ? Un petit koholasaure ? Que fait-il ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki'o-ki'o...! C'est ici que tu te trouves... Si vous n'étiez pas sortis à ce moment-là, j'aurais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "Et si tu avais été blessé ? Ne t'enfuis plus comme ça, d'accord ? *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "Hé, ne pleure pas. Regardez, ton petit saurien va bien, non ? Et il est en pleine forme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "Yaa ! Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Ah, hum... Tout va bien maintenant. Oh ! J'ai oublié de me présenter. Je suis Linaha du Peuple des sources. C'est moi qui suis chargée de m'occuper des petits koholasaures en général...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Toute seule ? C'est impressionnant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "Pas vraiment... Si j'étais plus comme vous, Paimon, ils ne se seraient probablement pas enfuis comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "Je me disais qu'ils étaient peut-être tous allés jouer près des cheminées, et j'avais raison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "La source thermale s'est refroidie parce que les petits koholasaures ont bouché les cheminées de phlogistique ? Pas étonnant que le responsable de la source n'ait rien remarqué !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "Il y a deux koholasaures que je n'ai pas encore retrouvés. Je pense qu'ils se cachent aussi dans les cheminées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "On s'en charge ! On les retrouvera pendant qu'on ajuste la température de l'eau, ne t'inquiète pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Vraiment ? Merci ! Heureusement que vous êtes là, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Héhé, mais de rien ! On peut toujours compter sur une aventurière légendaire comme la grande Paimon ! Ce sera du gâteau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Ouah ! Vous êtes incroyable, Paimon ! Je veux être comme vous un jour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
					"content": "Je suis d'accord. La grande Paimon est extraordinaire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Hé, pourquoi tu m'affiches comme ça ? Et si je te laissais manger le meilleur plat ce soir ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "Ahem ! Bref, allons-y !",
