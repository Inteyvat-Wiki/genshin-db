			"dialogs": [
				{
					"id": 751780501,
					"content": "#Comment se déroule votre recherche du « plus fort », {M#guerrier venu}{F#guerrière venue} des contrées lointaines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "#Dites-moi où se trouve le « plus fort{NON_BREAK_SPACE}»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Vous tomberez sur une région montagneuse où coulent les « eaux de l'intensité ». C'est peut-être là que vous trouverez la trace du « plus fort ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "J'y travaille encore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Ah, excellent ! Parfait !",
