			},
			"dialogs": [
				{
					"id": 751780101,
					"content": "Bonjour ! Euh, dites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Cette « intensité » est écrasante ! Pas étonnant de la part des légendaires {NICKNAME} et Paimon ! Ne me dites pas que vous avez fait tout ce chemin pour disputer le titre du « plus fort du Collectif de l'abondance » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "Le plus fort du Collectif de l'abondance ? Ce n'est pas un défi guerrier habituel ? Oh, beaucoup de gens font la queue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Haha, ils ne vous arrivent pas à la cheville. Pour obtenir le titre du « plus fort », il faut vaincre la personne qui le détient actuellement. Les gens ordinaires ne peuvent pas prétendre le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "Votre présence est une bonne chose... Mais je crains que vous n'arriviez pas au bon moment. Le maître n'a pas le temps de s'occuper d'affaires banales, alors vous ne pourrez pas le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "Où est-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "Oh ? Vous allez vous battre contre le maître ? Quelle audace ! Dans ce cas, je veux bien vous dire où il se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "En parcourant le chemin semé d'embûches de l'entraînement, vous tomberez sur une région montagneuse où coulent les « eaux de l'intensité ». C'est peut-être là que vous trouverez la trace du « plus fort ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "D'accord, on attendra son retour.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "En effet, l'intensité attire l'intensité, alors les plus forts sont destinés à croiser le chemin de leurs semblables de toute façon. Vous pouvez attendre si vous le souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
