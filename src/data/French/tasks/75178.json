			"dialogs": [
				{
					"id": 751780201,
					"content": "À l'aide ! Quelqu'un vient de s'évanouir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Oh non, on dirait que c'est le maître ! Allons lui porter secours aussi, {NICKNAME} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Le maître se serait seulement évanoui à cause de la chaleur et n'aurait rien de grave. Avec votre aide, Yoleehe l'emmène alors qu'il est encore inconscient...\\nOn dirait que le maître a encore des progrès à faire dans sa gestion de l'intensité.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
