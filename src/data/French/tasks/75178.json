				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "C'est « froid » ! Tellement « froid » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "Quoi ? Froid ? De quoi vous parlez ? Vous êtes dans une source thermale là, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "Non, non... Ce n'est pas encore assez ! Si je veux devenir le « plus fort » du Collectif de l'abondance... Non, de tout Natlan, je ne peux pas me contenter de ce niveau de froid ! L'« intensité »... est loin d'être suffisante !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "Hein ? Pourquoi vous vous réasseyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "On dirait que l'« intensité » n'est pas encore suffisante !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "C'est quoi cette « intensité » ? Je ne comprends rien à ce que tu dis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Oh, vous devez être les célèbres {M#aventuriers}{F#aventurières} {NICKNAME} et Paimon ! Merveilleux ! Nous sommes sauvés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "Quoi ? Sauvés ? Qu'est-ce qui se passe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "D'accord, je vais tout vous dire. D'après le maître, il est en route pour devenir le « plus fort ». Du coup, il s'est entièrement plongé dans un entraînement à l'intérieur d'une source thermale !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Attendez, un entraînement ? Dans une source thermale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "Oui... Je sais que ça paraît fou, mais il a eu cette idée en lisant un livre d'arts martiaux intitulé « Le livre des cinq sources ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "Le livre dit qu'en suivant ses enseignements, vous pourrez <color=#00E1FFFF>faire bouillir de l'eau froide</color> simplement avec votre propre « intensité ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "Et ce n'est pas tout ! Il est aussi rempli d'histoires folles sur des légendes des arts martiaux, comme celle d'un homme qui a fait un trou dans une montagne avec ses poings en une nuit, puis d'un autre qui pouvait transformer des pierres en gemmes à mains nues !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Je n'aurais jamais imaginé que des arts martiaux aussi extraordinaires existaient en ce monde ! Si seulement tu les apprenais, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "On dirait que c'est tout droit sorti d'un roman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Je sais que ça paraît ridicule, mais ce n'est pas n'importe quel livre. Notre maître l'a trouvé dans la collection des Maîtres du vent nocturne, ça doit donc être vrai, non ? En plus, il croit en ce que cet ouvrage raconte dur comme fer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "C'est pourquoi il a choisi cette source chaude en particulier. Enfin, cette « source froide » plutôt. Son objectif est de transformer l'eau glacée en de l'eau chaude uniquement grâce à l'« intensité » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "Attendez... C'est vrai ! Cette eau est glacée ! Votre maître ne va pas tomber malade à force de rester dedans aussi longtemps, malgré sa force ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Oui ! Et même s'il ne tombe pas malade, il ne peut pas rester dedans indéfiniment. Notre défi guerrier est suspendu depuis des jours ! Tout le monde attend qu'il revienne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Mais le maître ne cesse de répéter qu'abandonner à mi-chemin voudrait dire qu'il n'a pas assez d'« intensité ». Il a juré qu'il ne partirait pas tant que l'eau ne commencerait pas à bouillir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "Le gérant de la source ne sait pas pourquoi l'eau est devenue froide. Si seulement des aventuriers compétents pouvaient nous aider... Regardez, j'ai même préparé une récompense pour la personne qui résoudra le problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Peut-être que vous devriez demander de l'aide à quelqu'un du Peuple des sources...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(Ne refusons pas tout de suite. Voyons combien il nous propose d'abord !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "Ne vous inquiétez pas, nous allons réchauffer cette source. On ne peut quand même pas laisser votre maître dans l'eau glacée jusqu'à ce qu'il tombe malade non plus. Les bons aventuriers aident leur prochain, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Oh, merci ! Je m'en remets à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Ne bougez pas d'ici. On va régler ça en un rien de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Vous essayez sérieusement de me soudoyer avec cette récompense ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Tu n'y crois pas vraiment, hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "C'est sûrement parce qu'être debout lui donne encore plus froid...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Je crois aussi. Pas étonnant qu'il tremble comme une feuille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
