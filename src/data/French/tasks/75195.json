			"dialogs": [
				{
					"id": 751950201,
					"content": "Par les Archons... Une âme charitable qui se présente à l'improviste ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "J'avais prévu de faire venir un tatankasaure pour m'aider à briser et à déplacer les pierres de ce champ stérile. Si des monstres étaient apparus, il aurait aussi pu m'aider à les éliminer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Je n'ai même pas commencé et voilà que quelqu'un s'est déjà occupé de tout pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Ah... Depuis toujours, je fertilise chaque matin les arbres fruitiers qui se trouvent devant ma porte. Ce doit être une récompense des Archons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "Âme charitable, émissaire divin ! Moi, Dutta, vous remercie pour votre générosité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Je n'ai rien de spécial à vous donner, mais voici quelques moras et quelques autres babioles. Je vous prie de les accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
