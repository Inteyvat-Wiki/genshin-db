			"dialogs": [
				{
					"id": 766530501,
					"content": "Hmm... Devrais-je continuer ma recherche ou non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "Le méca-espion zip-zap C1 !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Zip-zap quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "Plus précisément, c'est une plateforme de test pour le méca-espion zip-zap C1, le dernier robot d'infiltration que j'ai conçu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "Elle a récemment acheté une unité de nettoyage abandonnée sur le marché noir. Après l'avoir modifié, elle a créé le méca-espion zip-zap C1 que vous voyez ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "Cette plateforme simule plusieurs environnements hostiles pour tester les capacités du robot à rester discret même sous pression.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Pourquoi fabriques-tu un robot-espion ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "Après le vol de Kniep-clang 70 % sucré, Aino a pris une décision : « Peu importe la puissance de l'ennemi, il faut sauver nos amis à tout prix ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Ensuite, elle s'est empressée de terminer le brouillon de conception du méca-espion zip-zap C1 et a commencé à le construire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "Selon son plan, une fois qu'il sera terminé, il pourra même infiltrer les bâtiments sous haute surveillance comme le Bureau d'études expérimentales du kuuvahki pour sauver nos amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "Ça a l'air génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "Mais Aino a réalisé qu'il lui fallait beaucoup trop de temps pour peaufiner son plan, alors elle a abandonné l'idée à nouveau. Selon ses calculs, ce serait plus rapide de mettre Nod-Krai sens dessus dessous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "Je me suis décidée ! Comme on doit prendre notre temps, je vais continuer à travailler sur le méca-espion zip-zap C1 ! Il nous aidera à sauver nos amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "Dans ce cas, pourrions-nous vous demander de nous aider pour les tests ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "Selon des statistiques antérieures, si des données sont fournies par d'autres testeurs comme référence, la vitesse d'exécution d'Aino augmentera de 30 % au moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "Comptez sur moi ! Ça va être marrant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "Je vais aider aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "#Je vous remercie {M#tous}{F#toutes} les deux, au nom d'Aino. Je vous donnerai accès à la plateforme. Vous pourrez vous en servir pour effectuer les tests que vous souhaitez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
}