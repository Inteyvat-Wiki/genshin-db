				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Comment je vais faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Ma fille, Eileen, veut à tout prix intégrer l'Ordre de Favonius et s'entraîne pour leur examen de sélection...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "*soupir* Je voulais l'entraîner moi-même, mais elle ne me croit pas quand je lui raconte que j'ai été un aventurier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Il n'y a rien que je puisse faire pour le lui prouver non plus... Ça aurait été égoïste de ma part de continuer mes aventures avec une famille à nourrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "Son bonheur vaut toutes les aventures du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Ceci dit, j'ai toujours le cœur d'un aventurier ! Je sais toujours de quoi je parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Un jour, je me rappelle avoir vu des Brutocollinus utiliser des mannequins en bois pour s'entraîner au combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Ils avaient l'air très robustes ! Je pense que ça serait idéal pour Eileen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Vous pourriez aller m'en chercher un ? Dans le respect du code des aventuriers, je vous donnerai bien évidemment quelque chose en échange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Hmm, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "J'aime les gens plein de fraîcheur comme vous ! Vous me rappelez ma jeunesse quand j'étais prêt à tout pour rejoindre la Guilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Je plaisante ! Allez-y, par pitié !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Ce ne sont que des Brutocollinus. Vous pouvez vous débrouiller seul...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Je ne peux pas le faire ! J'ai atteint mon quota d'aventures pour le moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "Peu importe qui on est, la vie après le mariage est une très grande aventure et ne laisse pas de place à une autre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "C'est pour cette raison que je ne peux compter que sur vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
