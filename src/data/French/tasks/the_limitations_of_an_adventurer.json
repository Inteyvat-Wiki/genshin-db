					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Ah, vous n'y êtes vraiment pas allé de main morte... Je ne sais pas comment vous avez fait pour le casser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "On ne retient pas ses coups dans le feu de l'action, je suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "Je ne pourrais pas le donner à Eileen dans cet état, mais je peux le réparer au moins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Voilà, j'ai terminé de le rafistoler ! C'est pas trop mal, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "Merci beaucoup. Voici votre récompense bien méritée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Un aventurier peut partir à la retraite, mais il respecte toujours le code.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
