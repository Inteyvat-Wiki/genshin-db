					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Eileen s'entraîne dur, mais je ne peux rien faire d'autre pour elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Si seulement j'étais encore un aventurier, je l'aurais ramené moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Malheureusement, vu l'état déplorable de la Guilde des aventuriers de Mondstadt, mes collègues sont quasiment tous partis à la retraite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "C'est la vie ! Tous les jeunes veulent rejoindre l'Ordre de Favonius de nos jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "C'est vrai qu'entre ça et risquer sa peau dans la nature sauvage... il n'y a pas photo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
