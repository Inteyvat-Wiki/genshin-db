			"dialogs": [
				{
					"id": 200620501,
					"content": "Comment optimiser mon entraînement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200620502,
					"content": "Qu'est-ce que tu fais ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Je m'entraîne pour l'examen de séléction de l'Ordre de Favonius, mais je n'y arrive pas, et personne ne peut m'enseigner comment faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200620504,
					"content": "Mon père m'a proposé, car il était soi-disant un aventurier... Je suis sûre que c'est du baratin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200620505,
					"content": "Quelqu'un comme lui ne pourra jamais m'aider à réussir la sélection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Eileen"
				},
				{
					"id": 200620506,
					"content": "Ensuite, il m'a dit qu'il allait me ramener du matériel d'entraînement... Franchement, Je ne sais pas ce qu'il a en tête...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eileen"
				}
			]
		},
