			"dialogs": [
				{
					"id": 200620201,
					"content": "Vous avez trouvé le mannequin en bois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620202,
					"content": "Je l'ai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "Oh ! Vous voyez comme il est solide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620204,
					"content": "S'il résiste aux Brutocollinus, Eileen n'aura pas besoin de retenir ses coups !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620205,
					"content": "Merci beaucoup. Voici votre récompense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
