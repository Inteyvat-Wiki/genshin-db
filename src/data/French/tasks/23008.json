			"dialogs": [
				{
					"id": 230080101,
					"content": "Je vais peut-être enfin réussir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080102,
					"content": "#{M#Voyageur}{F#Voyageuse} ! Attendez un peu, s'il vous plaît, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080103,
					"content": "Que se passe-t-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "Je cherche de la bave de Blob !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080106,
					"content": "Le truc, c'est que j'ai fait des expériences ces derniers jours avec la terre que vous m'aviez rapportée en la mélangeant dans des proportions variées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080107,
					"content": "J'ai échoué plusieurs fois... mais j'ai fini par trouver une proportion de mélange utilisable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080108,
					"content": "La polyterre dans cette proportion est à peine plastique avant sa prise, mais après, elle devient solide et durable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080109,
					"content": "Donc je suppose que je dois ajouter plus de terre mélangée à de la bave de Blob...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080110,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, aidez-moi à trouver trois autres portions de bave de Blob !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080111,
					"content": "Avec plus de bave de Blob, je peux à coup sûr faire la terre que je veux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080104,
					"content": "Qu'est-ce que vous cherchez cette fois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
		{
