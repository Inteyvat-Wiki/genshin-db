				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Super ! C'est ça, attendez un peu, juste un instant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Un moment plus tard.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Voilà, j'avais deviné juste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "Aussi adhésive qu'elle soit, la terre humide se casse facilement après s'être solidifiée. Pourtant, après avoir été mélangée à la terre de la Fleur mensongère, la terre solidifiée devient plus flexible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "C'est juste que ce genre de terre est à peine plastique avant qu'elle ne se solidifie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Mais après avoir ajouté la terre de l'habitat des Blobs, la plasticité de cette terre avant de se solidifier s'est soudainement améliorée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "Je ne sais pas pourquoi, mais si je devais le décrire, je dirais que c'est comme si cette terre était devenue similaire à un Blob...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "De la terrablob.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Une des propriétés des Blobs a l'air d'avoir affecté la terre, donc je me suis dit que ce serait plus efficace si j'ajoutais directement de la bave de Blob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "Et il s'est avéré que la plasticité et la stabilité de la terre a changé en fonction de la quantité de bave de Blob ajoutée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Autrement dit, ce n'est pas seulement un matériau de construction, elle peut également être utilisée pour la poterie et bien d'autres choses encore !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "Félicitations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Merci, c'est ce que les hauts dignitaires disent souvent : « Petit à petit, l'oiseau fait son nid ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Ne sous-estimez pas cette terre. Un jour, je pourrai peut-être construire une tour qui ira jusqu'au ciel avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "J'ai décidé d'appeler cette terre hybride « Polyterre ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "Maintenant, il s'agit de voir ce à quoi la polyterre peut servir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Ce problème de logement qui nous préoccupe tous depuis si longtemps a maintenant une chance d'être résolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}. Veuillez accepter cette récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "Vos efforts ont finalement porté leurs fruits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Tu aimes ça, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Je ne mange pas de terre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
