					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Vous lui remettez le carnet et les pages que vous avez trouvés...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Laissez-moi voir... Oui ! C'est bien ça. Merci beaucoup ! Il y a énormément de preuves sur les crimes des Fatui là-dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "... Des preuves ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Regardez toutes les installations qu'ils ont construites sur l'Île de Paha, et les machines qu'ils ont amenées... C'était un endroit rempli d'animaux autrefois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Je viens de revenir des Salines écarlates. Les méduses arrivent à peine à survivre à cause des machines des Fatui... Tout le monde doit le savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Hein ? Vous parlez de Gelée de tombaie et des autres ? Mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Vous lui racontez ce qui s'est passé aux Salines écarlates...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "C'est donc déjà trop tard... mais il faut quand même documenter ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "Je vous laisse ces notes. Je dois me dépêcher d'arranger le reste de mes notes pour en faire un article.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Si vous en parlez à quelqu'un d'autre, n'oubliez pas de dire que c'est moi, Semyon, qui vous ai mis au courant. Après tout, il me faudra encore un peu de temps avant de pouvoir écrire mon article et de le publier dans le journal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "En tout cas, merci beaucoup ! Au revoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
