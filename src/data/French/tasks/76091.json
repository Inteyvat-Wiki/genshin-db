					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Une nivéole volante ! Mes notes... Les Fatui me les ont prises ! Pourriez-vous m'aider à les récupérer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Je ne suis pas vraiment une nivéole... mais ça devrait être facile ! Mais qu'est-ce que les Fatui font avec le carnet d'un enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Peut-être qu'ils ont peur que je dise à tout le monde ce qu'il y a dedans... Si vous m'aidez à le récupérer, je vous dirai ce que c'est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "On peut en parler plus tard. Aidez-moi à récupérer mon <color=#00E1FFFF>carnet</color> pour l'instant. Certaines <color=#00E1FFFF>pages</color> sont peut-être éparpillées... là-bas, où se trouvent les Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
