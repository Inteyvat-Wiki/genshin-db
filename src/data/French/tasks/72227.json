			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "#Vous avez l'air tellement {M#forts}{F#fortes} quand vous vous battez, {M#tous les deux}{F#toutes les deux} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270102,
					"content": "Oh, tu es là, Ruu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270103,
					"content": "Tout va bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "Je vais bien, ne vous en faites pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270106,
					"content": "C'était quoi ces monstres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "Je ne sais pas d'où ils viennent non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270109,
					"content": "Ils n'avaient pas l'air d'être d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270110,
					"content": "Mm-hmm. Autrefois, il n'y avait pas ce genre de monstres sur l'île, ni ces êtres poilus ou ces grosses machines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270111,
					"content": "Il existait des animaux qu'on appelait « Wen Kamuy ». C'étaient des bêtes gentilles... et délicieuses aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270112,
					"content": "On n'a rien croisé de tel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "Ça ne m'étonne pas. Je ne sais pas depuis quand, mais ils ont tous disparu et ces monstres sont apparus à la place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270114,
					"content": "Peut-être qu'ils sont venus de l'extérieur de la mer de brume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270115,
					"content": "Il y a aussi des Brutocollinus dans le monde extérieur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "Ça a l'air vraiment dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270117,
					"content": "Ça peut l'être.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "Mais l'aventure, il n'y a que ça de vrai !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270120,
					"content": "J'adorerais partir à l'aventure, moi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270121,
					"content": "Je suis sûre que tu seras un aventurier célèbre quand tu seras grand !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270122,
					"content": "Tu peux compter dessus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270123,
					"content": "Laisse-nous nous occuper de ce perchoir. Il y a des monstres dans le coin, tu pourrais être en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270124,
					"content": "Laisse-nous faire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "Mais partir à l'aventure, c'est tellement amusant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "Tu n'es pas blessé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
