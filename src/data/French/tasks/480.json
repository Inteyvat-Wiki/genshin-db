			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Je l'ai lu en entier, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Je ne peux pas dire que j'ai tout mémorisé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Salut ! T'as fini de lire le guide ? Tu connais les règles sur le bout des doigts ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "On dirait que ça t'a ennuyé. Je comprends, moi aussi, je suis passée par là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "Le style d'écriture du bouquin est assez sec. Je n'ai jamais pu le terminer... Ne le dites surtout pas à Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Ah bon ? J'ai trouvé les petites histoires du guide plutôt intéressantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Oh, tu dois sans doute parler des cas pratiques en annexe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Je les aime bien aussi. Mon préféré est celui du planage illégal à l'aide d'un Anémoblob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Apparemment, si on éclate un Anémoblob, l'air qu'il relâche peut t'emmener très haut. J'ai trop envie d'essayer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Je ne parlais pas de celle-là, mais plutôt de l'oisillon qui voulait apprendre à voler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Hein ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Laisse-moi voir... Oups. Je vous ai donné un livre que j'aimais lire quand j'étais petite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Pardon ! J'ai dû prendre le mauvais livre en sortant ! Il était dans le même tas que le guide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Je ne vois même pas comment on peut confondre un livre pour enfants avec un manuel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ahhh, c'est tellement gênant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "En réalité, c'est ce conte pour enfant qui m'a vraiment enseigné le planage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "« Ce n'est pas le vent qui vous faisait défaut, mais le courage. Vous êtes les premiers oiseaux de ce monde à savoir voler, parce que vous étiez les plus courageux. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Ce passage m'a donné le courage de planer, de devenir Éclaireuse et de remporter le Championnat de planage de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "Assez discuté ! Où en étions-nous dans notre examen ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "Détends-toi, plane comme tu le fais d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Il faut suivre <color=#00E1FFFF>le parcours indiqué</color> jusqu'à la fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
