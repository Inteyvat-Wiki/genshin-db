			"dialogs": [
				{
					"id": 60080101,
					"content": "Qu'est-ce qui a changé depuis la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080102,
					"content": "Pas grand-chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "On dirait que la situation s'est stabilisée. Lauma est vraiment trop forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080104,
					"content": "#Lauma, on est {M#revenus}{F#revenues} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080105,
					"content": "Comment se sont passés ces derniers jours ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Le travail de nettoyage a été beaucoup plus compliqué que je ne le pensais. C'est difficile de résoudre des problèmes qui se sont accumulés au fil du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080107,
					"content": "Je pense que cela prendra encore quelques semaines. Heureusement, les membres qui sont restés sont sortis de leur doute et sont devenus plus proactifs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080108,
					"content": "C'est comme s'ils avaient retrouvé leur foi d'une manière authentique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080109,
					"content": "Tout ça, c'est grâce à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080110,
					"content": "Non... J'aurais dû agir plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080111,
					"content": "J'ai pris soin de moi ces derniers jours. Je devrais pouvoir vous aider à enquêter sur le passé grâce à l'essence lunaire en votre possession.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080112,
					"content": "Merci de vous en être souvenue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "D'ailleurs, vous avez eu de nouvelles informations sur le fantôme ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080114,
					"content": "J'ai essayé d'interroger quelques personnes, mais rien de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080115,
					"content": "Et vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080116,
					"content": "On n'a pas fait beaucoup de progrès non plus, mais voici ce qu'on a pour l'instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080117,
					"content": "J'ai compris l'essentiel... Vous avez aussi du pain sur la planche. Prenez soin de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080118,
					"content": "#Venez par ici, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "Que voyez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080121,
					"content": "(C'est... Nod-Krai ? Ça me dit quelque chose...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(C'est une étoile dans le ciel ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(...! Ah, mais c'est notre vaisseau spatial !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "C—C'est fini ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080125,
					"content": "Il semble que cela s'est passé il y a très longtemps. Les souvenirs que j'ai perçus étaient turbulents et chaotiques. Mon pouvoir ne m'a pas permis de discerner davantage de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080126,
					"content": "(Au moins, on sait maintenant que le vaisseau a atterri à Nod-Krai... Plus précisément, près des Sablettes d'astre. Du moins, c'est ce qu'il semble.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Ça correspond à ce que {M#Lumine}{F#Aether} m'a dit... Mais je veux en savoir plus...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 60080129,
					"content": "Qu'est-ce qui t'arrive ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080130,
					"content": "La couleur des fleurs a changé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080131,
					"content": "(Ces fleurs sont le reflet des pouvoirs de Columbina. Ça voudrait dire que son corps...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Je me souviens qu'elle avait dit vouloir restaurer une partie de son pouvoir grâce à l'essence lunaire...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Oui, on devrait lui rendre visite, et voir si on peut faire quoi que ce soit pour l'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080135,
					"content": "Je vous la confie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080136,
					"content": "Ah oui, voici le traitement que vous avez demandé au Curatorium des secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080137,
					"content": "Merci de me l'avoir apporté. Vous me rendez un grand service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080138,
					"content": "D'ailleurs... Je crois que Kuu{RUBY#[S]Dame de la lune}tar pourra vous aider à déclencher des souvenirs détaillés du vaisseau spatial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080139,
					"content": "C'est vrai ! Elle en serait bien capable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080140,
					"content": "Mais voyons comment elle se sent d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080141,
					"content": "À plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
