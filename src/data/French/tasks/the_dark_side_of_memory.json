			},
			"dialogs": [
				{
					"id": 60080201,
					"content": "Elle n'a pas l'air en forme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "Pardon de vous déranger, mais tout va bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080204,
					"content": "Votre état s'est-il dégradé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "... J'ai la tête qui tourne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080206,
					"content": "... C'est comme si je retournais à la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080207,
					"content": "À ce point-là ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Hmm ? Je sens le pouvoir de la lune en vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080209,
					"content": "On a récupéré l'essence lunaire des griffes des Fatui. Est-ce que ça peut vous aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Hmm... Que voulez-vous en échange cette fois-ci ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080211,
					"content": "Sérieusement ? C'est ce qui vous préoccupe ? Pensez plutôt à votre santé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080213,
					"content": "(Elle a tellement l'habitude d'entretenir des relations motivées par intérêt mutuel qu'elle trouve ça normal ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "J'aurais besoin de votre aide plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "... Oh, très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080216,
					"content": "Donnez-moi votre main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080217,
					"content": "*expire*... Merci, je suis revenue sur terre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080218,
					"content": "Vous n'avez pas bougé, mais bon... Vous allez mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Beaucoup mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080220,
					"content": "Qu'avez-vous fait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "La lune en vous... est aussi silencieuse qu'un reflet dans l'eau. C'est fascinant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080223,
					"content": "Je n'ai fait qu'emporter un rayon de sa lumière dans l'eau. Assez pour me maintenir les pieds sur terre pendant un moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080224,
					"content": "Je crois avoir perçu certains autres changements aussi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "C'est la faveur de la Déesse de la lune. Tout ce que je touche présente cette marque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080226,
					"content": "C'est inoffensif, et elle s'estompera avec le temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080227,
					"content": "D'ailleurs, voulez-vous reprendre l'essence lunaire maintenant que vous avez retrouvé vos pouvoirs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "C'est quelque chose de divin, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Ce sont les restes d'Aria, la Déesse de la lune éternelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080230,
					"content": "Quel est le rapport avec... Attendez, quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Vous l'ignoriez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080232,
					"content": "Lauma a juste dit que ce vestige était différent des autres et qu'elle sentait une puissance divine dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "Et elle a raison. Lorsque j'ai extrait ce rayon de lune de l'essence, j'ai aussi extrait des souvenirs qui se trouvaient à l'intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080234,
					"content": "C'est pour cela que je sais qu'il appartient à la Déesse de la lune éternelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080235,
					"content": "Mais Lauma a aussi regardé le passé en utilisant l'essence lunaire. Pourquoi n'a-t-elle pas vu la même chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma a dit qu'elle n'arrivait qu'à voir des bribes floues... Peut-être que seule la Déesse de la lune peut percevoir ce genre de choses...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Il y avait autrefois trois lunes dans le ciel. Chacune d'entre elles appartenait à la déesse qui la gouvernait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080238,
					"content": "Mais après la guerre de la crémation, les trois déesses furent tuées, et deux des trois lunes brisées pendant le conflit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080239,
					"content": "Après la mort d'Aria, son pouvoir se condensa en essence lunaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080240,
					"content": "Les vestiges de la lune irisée n'ont jamais été retrouvés. La Déesse de la lune de givre avait bien connu le trépas, mais sa lune ne fut jamais brisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080241,
					"content": "D'après la prophétie, cette lune donnerait tôt ou tard naissance à une nouvelle divinité, l'entité que les Descendants de givrelune appellent « Kuu{RUBY#[S]Dame de la lune}tar ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080242,
					"content": "Je sens que mon pouvoir appartient à la lune de givre, mais elle est située au-delà du faux ciel. C'est hors de ma portée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080243,
					"content": "La « sentir » demande un effort colossal, alors je ne vais même pas essayer de la « contrôler ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080244,
					"content": "Attendez, je vais résumer... On a l'essence de la lune éternelle en notre possession, personne ne peut trouver celle de la lune irisée... Et vous avez l'essence de la lune de givre en vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "Non. Cette essence ne peut se former qu'après la mort d'une Déesse de la lune. C'est comme un noyau d'énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080246,
					"content": "Autant vous demander s'il y a des pierres sur la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080247,
					"content": "Oh, vous êtes en train de nous dire que vous représentez le pouvoir de la lune de givre, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "#Oui. Une divinité avec un Gnosis s'appelle un Archon... L'essence lunaire ferait-elle de vous {M#un dieu de la lune}{F#une Déesse de la lune} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080249,
					"content": "Ce n'est pas pareil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "#Vous ne souhaitez pas en devenir {M#un}{F#une} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080251,
					"content": "Ce n'est pas la question ! Et puis, pourquoi avez-vous autant hâte de vous débarrasser de ce titre ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "#Bref, mettons cette histoire de {M#dieu de la lune}{F#Déesse de la lune} de côté pour l'instant. On se demandait si on devait vous rendre l'essence lunaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "Je n'en veux pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080254,
					"content": "Ah ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Elle ne veut pas de moi non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080256,
					"content": "Que voulez-vous dire par là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Lorsque je suis entrée en contact avec, j'ai ressenti une forme de rejet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080258,
					"content": "Je suppose que c'est parce que je suis une « Déesse de la lune ». Deux lunes ne se lèvent pas en même temps, et ne peuvent pas se consumer entre elles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080259,
					"content": "J'imagine qu'elle va rester avec moi pour l'instant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "#Tu es {M#sûr}{F#sûre} que ça ira ? Lauma a dit que tu avais bien dissimulé son pouvoir, mais Columbina est parvenue à le sentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "La Chasse sauvage n'est pas ordinaire non plus. Si elle détectait l'essence lunaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "Vous parlez de la Chasse sauvage comme si c'était une personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080263,
					"content": "C'est parce qu'il y a l'air d'avoir quelqu'un derrière ce phénomène. Quelqu'un avec un objectif précis. Il n'a pas arrêté de vouloir mettre la main sur l'essence lunaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Cela me rappelle quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080265,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Mes collègues parlaient souvent de quelqu'un quand j'étais encore une Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080267,
					"content": "Il venait de Khaenri'ah et avait obtenu le pouvoir de l'Abîme pendant le cataclysme... Il était obsédé par les lunes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah ? On ne sait pas s'il a un rapport avec le fantôme qu'on a vu, mais les détails correspondent... Comment s'appelle-t-il ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Je sais que les gens l'appellent le « rächer de solnari ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080270,
					"content": "C'est un des cinq pécheurs ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah oui, il portait aussi ce titre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080272,
					"content": "Dain nous a déjà parlé de lui, non ?! Notre ennemi serait Rerir des cinq pécheurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "Si c'était lui, il serait bien plus fort...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "J'ai entendu qu'il a disparu peu après le cataclysme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080275,
					"content": "Quand j'ai demandé à mes collègues où il était parti, ils m'ont répondu : « Tu ne le sais vraiment pas ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080276,
					"content": "Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "On raconte qu'il est tombé dans le « reflet de la lune », un endroit dont on ne revient pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080278,
					"content": "Attendez, stop ! Ça fait trop d'informations d'un coup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "C'est ce que je m'étais dit aussi à l'époque. Ils avaient toujours pensé que je savais tout au sujet des lunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080280,
					"content": "Mais comme je vous l'ai déjà précisé, mon « prologue » prend racine au-delà du faux ciel. Je ne me souviens même plus de mon nom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080281,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "En tout cas, le problème de la Chasse sauvage a empiré après sa disparition, et est devenu un synonyme de catastrophe de l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080283,
					"content": "Le phénomène actuel n'a hérité que du titre. Il surpasse de loin son incarnation passée en termes d'ampleur et de mortalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080284,
					"content": "Dire qu'on va devoir affronter Rerir des cinq pécheurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "#C'est trop pour nous ! On a eu de la chance de s'en être {M#sortis}{F#sorties} aux Sablettes d'astre... ou peut-être qu'il n'était pas au maximum de sa force ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Enfin... Il a quand même gagné contre Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "Enfin, qu'ai-je fait ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Columbina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Pardon ? Vous pouvez répéter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080402,
					"content": "Ah ? Euh, c'est votre... ancienne collègue ? On était aux Sablettes d'astre ensemble quand la Chasse sauvage l'a battue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080404,
					"content": "Vous... venez de sourire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "... Non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080406,
					"content": "(Vous l'avez fait !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Vous ne vous entendez pas bien avec elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "Ce n'est pas cela. J'ai juste imaginé la tête qu'elle ferait après une défaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080409,
					"content": "Elle n'a pas eu l'air de trop bien le prendre à ce moment-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Elle s'en remettra. Elle est douée pour cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080411,
					"content": "#Bref, on s'éloigne un peu du sujet. Maintenant qu'on sait qui en a après l'essence lunaire... Es-tu {M#sûr}{F#sûre} de vouloir la garder en toi, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Si les renseignements des Fatui sont fiables, personne ne pourrait arrêter Rerir, même si tout Nod-Krai s'unissait contre lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080413,
					"content": "Peut-être que quelque chose le retient temporairement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Avant de prendre ma décision, j'aimerais vous demander un service, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Lequel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080417,
					"content": "#Pensez-vous pouvoir me montrer ce qui s'est passé quand {M#ma sœur}{F#mon frère} et moi avons atterri à Nod-Krai avec notre vaisseau spatial ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080419,
					"content": "Vous n'avez pas hésité une seconde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Ce n'est qu'un rayon de lune pour moi. Rien de spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080421,
					"content": "Donnez-moi votre main, et préparez-vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(C'est ce que j'ai vu avant, mais en plus clair...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(On dirait qu'on a au moins atterri relativement en sécurité...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Beaucoup de temps semble s'être écoulé...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(On est encore à bord du vaisseau et ça fait tellement longtemps... Quand {M#Lumine}{F#Aether} en est-{M#elle sortie}{F#il sorti} ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Hein ? C'est... {M#Lumine}{F#Aether} ?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Comment est-ce possible ? Personne n'a quitté le vaisseau après l'atterrissage ! La porte n'a même pas encore été ouverte !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Où... suis-je ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Aether}{F#Lumine}! Viens, on doit quitter cet endroit !",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "... Hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "Hé ! Tu vas bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Notre vaisseau... Beaucoup de temps s'est écoulé après l'atterrissage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Personne n'a quitté le vaisseau pendant ce temps, mais {M#Lumine m'a trouvé}{F#Aether m'a trouvée} depuis l'extérieur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Quoi ? Comment est-ce possible ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "Je ne sais pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Les secrets renfermés dans les souvenirs sont comme des biscuits. Si vous mordez dedans, les miettes se répandent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080439,
					"content": "(Cette affaire est suspecte. Je dois découvrir la vérité.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Mais Nefer a raison. Je ne pourrais pas avancer dans mon enquête si Nod-Krai est réduite en poussière...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Très bien. Je vais garder l'essence lunaire avec moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "Ah ? Hum, d'accord... Si c'est ce que tu veux, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Avez-vous besoin de mon aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080445,
					"content": "Pour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Je peux vous aider à dissimuler l'essence lunaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080447,
					"content": "Vous pourriez faire ça ? Ce serait génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "La détecter n'est pas une chose aisée, mais je peux vous enseigner comment mieux la dissimuler grâce au kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080449,
					"content": "Comme ceci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080450,
					"content": "Ooh ! On dirait un bouclier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(C'est... doux et léger... comme le clair de lune...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Le sentez-vous ? Maintenant, essayez de garder cette sensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Vous apprenez vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080455,
					"content": "Ça a l'air plutôt solide. On peut l'utiliser pour se défendre dans un moment critique, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Merci de me l'avoir appris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Vous êtes toujours ici d'habitude, Columbina ? C'est dangereux à l'extérieur, certes, mais ça ne vous arrive pas d'aller vous promener ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080459,
					"content": "Je n'aime pas les inconnus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080460,
					"content": "Et qu'est-ce qu'on en est à vos yeux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "#Vous êtes un peu plus que des {M#inconnus}{F#inconnues}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080462,
					"content": "Quand cette histoire de Chasse sauvage sera réglée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "C'est vrai ! Les Descendants de givrelune ne sont plus les mêmes qu'avant ! Peut-être que vous les aimerez cette fois-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080466,
					"content": "J'y réfléchirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080467,
					"content": "Elle a l'air fatiguée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Elle n'a sans doute pas autant parlé depuis un moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "#En tout cas, merci de nous avoir {M#aidés}{F#aidées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "... Ce n'était pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080471,
					"content": "#Les fleurs d'ici... apprécient les {M#invités}{F#invitées} comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080463,
					"content": "Allons nous promener...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}