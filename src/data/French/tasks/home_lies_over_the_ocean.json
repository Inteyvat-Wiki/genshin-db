			"dialogs": [
				{
					"id": 728020601,
					"content": "Où est donc passée ma fille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Généralement, elle nous prévient avant d'aller au travail. Mais aujourd'hui elle est partie sans rien dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "Hier soir, après votre départ, Atsuko a dit qu'elle était très fatiguée et est allée directement dans sa chambre pour dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Quand nous nous sommes levés le lendemain matin, elle n'était plus au lit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "Nous l'avons cherchée partout, sans la trouver. Mon mari est même allé voir dans des endroits éloignés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Je l'ai longtemps cherchée par ici, mais je n'ai trouvé aucune trace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "*soupir* Ma fille est-elle repartie pour un autre voyage ? Que pouvons-nous faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Ne t'inquiète pas, ma chérie, je vais aller la chercher plus tard, tu peux aller balayer sa chambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Elle a oublié de fermer les fenêtres quand elle est partie, et il y a plein de feuilles dans sa chambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "#Ah oui, {M#voyageur}{F#voyageuse}, voici votre récompense. Prenez-la, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "*soupir* Où est partie Atsuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "Atsuko est allée au travail ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
