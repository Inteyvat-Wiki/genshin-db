			"dialogs": [
				{
					"id": 728020301,
					"content": "Pourquoi notre fille est-elle revenue avant la date de signature de cette lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Ne pensons pas trop, c'est probablement juste un malentendu. Ce serait mieux si tu m'aidais à réfléchir à ce que je vais faire pour le déjeuner demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
