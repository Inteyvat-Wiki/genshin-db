					"content": "Atsuko n'est pas encore rentrée. S'il vous plaît, revenez dans la soirée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020402,
					"content": "Atsuko sera de retour le soir.",
