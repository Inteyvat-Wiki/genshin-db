					"Yoh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Combien de plats devons-nous préparer pour le déjeuner de demain ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "Notre fille a un appétit d'ogre en ce moment. On doit cuisiner plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Hmm, vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Est-ce que c'est chez Atsuko ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Oui, que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Atsuko m'a demandé de vous apporter cette lettre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Une lettre ? Pourquoi cette enfant voudrait-elle soudainement nous écrire une lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "La lettre est assez longue... Je veux dire, elle est déjà rentrée à la maison, donc si elle veut dire quelque chose, elle devrait nous le dire directement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "... Pardon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "#... {M#Voyageur}{F#Voyageuse}, on dirait que vous êtes surpri{M#s}{F#se} ? C'est vrai qu'Atsuko a voyagé à l'étranger avant, mais elle est revenue maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Pourquoi veut-elle nous envoyer une lettre alors qu'elle est déjà à la maison avec nous ? Vous nous confondez avec quelqu'un d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Attends une minute, chérie. J'ai jeté un œil à la lettre. C'est définitivement l'écriture et le ton de notre fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "La lettre dit aussi qu'elle ne prévoit pas de revenir dans un avenir proche, et elle nous dit de prendre soin de nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "#Que signifie tout cela ? Est-elle revenue seule en demandant à {M#ce}{F#cette} {M#voyageur}{F#voyageuse} de nous donner cette lettre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Je pense qu'il y a peut-être un malentendu. Quand Atsuko rentrera, nous lui demanderons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "Malheureusement, Atsuko avait des affaires à régler aujourd'hui. Après son retour, nous lui demanderons des précisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Si vous êtes d'accord, retrouvez-nous demain soir. Nous demanderons à Atsuko de tout expliquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Où est-elle en ce moment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Elle a dit qu'elle était occupée à travailler. Après le petit déjeuner, elle est partie en toute hâte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Oui, tous les jours, elle part tôt et rentre tard. On ne la voit que le soir, alors on n'est pas sûrs de ce qu'elle fait vraiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Bref, venez demain soir, s'il vous plaît. Si Atsuko a fait quelque chose de mal, nous nous assurerons qu'elle vous présente ses excuses en personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Nous sommes vraiment désolés que vous ayez dû faire un si long voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Atsuko, si seulement elle se comportait mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Pourquoi demain soir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Elle dit qu'elle est occupée à travailler. Elle quitte la maison pour toute la journée après le petit déjeuner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko... est de retour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Vous êtes les parents d'Atsuko ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
