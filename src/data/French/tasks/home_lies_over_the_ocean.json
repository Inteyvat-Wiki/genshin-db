				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Atsuko devrait être de retour maintenant. Allons frapper à la porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Ils sont en train de parler de quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Cela dit, je me demande ce qui a pu arriver au Tanuki que nous avons sauvé avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Tu es trop gentille. Ce Tanuki n'avait qu'une petite égratignure à la patte. Si tu l'avais laissé dans les buissons, il se serait remis tout seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Je ne pouvais pas m'en empêcher. Il me regardait avec des larmes dans les yeux. Il avait l'air tellement pitoyable. Ma conscience ne voulait pas le laisser comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Oublie ça. Il n'y a jamais de mal à faire de bonnes actions. C'est juste qu'il a un peu trop mangé, presque autant que moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "*toc toc* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Qui est-ce ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "#Je suis {M#le}{F#la} {M#voyageur}{F#voyageuse} qui est {M#venu}{F#venue} ici hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "Ah, je vois, attendez un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "B—Bonjour ! Je suis Atsuko, c'est la première... Non... C'est un plaisir de vous revoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Désolée, j'avais le mal du pays. Après vous avoir donné la lettre, j'ai changé d'avis et j'ai pris un bateau pour Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Hahaha... Désolée de ne pas avoir clarifié les choses avant, et de vous avoir fait voyager si loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Comment êtes-vous revenue à Inazuma ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "... Ah, j'avais mes moyens, haha. Vous n'avez pas à vous inquiéter pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Euh, j'ai votre paiement sur moi. C'est ici. Merci pour votre aide. Allez, euh... Euh, allez-y et profitez du reste de votre journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Comment se fait-il que les choses qu'Atsuko nous dit maintenant sont différentes de ce qu'elles étaient avant ? Si retourner à Inazuma était si facile, pourquoi nous avoir demandé de l'aide en premier lieu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "Et vos affaires à Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "Mes affaires ? Quelles affaires ? J'avais des affaires à Liyue ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "... Ah, ce genre de choses est sans importance. Rien n'est plus important que la famille. J'ai déjà tout confié à quelqu'un d'autre... Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "Attendez un peu ! La vraie Atsuko avait même du mal à trouver un travail à Liyue, il n'y a aucune chance qu'elle soit devenue soudainement riche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "J—Je suis Atsuko, bien sûr ! Je ressemble à Atsuko et je parle comme Atsuko. Qu'est-ce qu'il y a de suspect ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "#Écoutez, arrêtez d'être si {F#obstinée}{M#obstiné} ! Laissez tomber... Je ne vous parlerai plus, j'ai du travail à faire demain, je dois y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "Atsuko ! Cette fille... Pourquoi s'est-elle mise en colère tout à coup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "#Désolé, {M#voyageur}{F#voyageuse}. Elle doit être très fatiguée à cause du travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Mais comme vous l'avez vu vous-même, c'est notre fille, et quant à cette lettre... Elle a dû l'oublier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Mais quoi qu'il en soit, nous voulons quand même vous remercier pour la peine que vous vous êtes donnée. Vous pouvez attendre un petit moment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Il y a un problème ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Non, pas du tout. Nous pouvons encore effectuer le paiement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "À propos, Atsuko travaille pendant la journée, n'est-ce pas ? Mais le salaire qu'elle reçoit est assez étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Elle ramène toujours des graines ou des fruits sauvages, mais jamais de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Même si ces trucs ont une certaine valeur, il faudrait d'abord les vendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "#Pour {M#un voyageur}{F#une voyageuse} comme vous, je suppose que des moras seraient plus pratique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Revenez ici demain, s'il vous plaît. Je vous donnerai directement votre récompense en moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Si vous avez des difficultés...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "Et votre manoir à Liyue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Un manoir ? Quel manoir ? J'avais même un manoir à Liyue ? !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
