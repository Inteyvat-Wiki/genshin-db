			"dialogs": [
				{
					"id": 750240822,
					"content": "Après sa défaite en duel, la tepetlisaure connue sous le nom de Souci s'est cachée dans le sol. Personne ne sait où elle est passée. C'est l'occasion d'aller voir les blessés...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240801
					]
				},
				{
					"id": 750240801,
					"content": "Il ne semble pas y avoir de blessures évidentes... Ça va ?? Vous m'entendez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240802,
					"content": "... Hmm, Souci ? Tu t'en es fait pour moi ? Tu as vraiment un grand cœur. Ne t'inquiète pas. Je me suis entraîné dur ces derniers temps pour pouvoir jouer avec toi sans problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240803
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240803,
					"content": "#Je m'appelle Paimon, pas Souci ou je ne sais pas trop quoi ! {NICKNAME}, tu crois qu'il s'est cogné la tête en tombant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240804,
						750240805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240804,
					"content": "Il a peut-être besoin d'un peu de temps pour reprendre ses esprits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				},
				{
					"id": 750240806,
					"content": "Attendez. Vous n'êtes pas Souci... Que m'est-il arrivé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240807
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240807,
					"content": "Vous lui racontez comment vous l'avez vu encerclé par les trois sauriens avant d'être renversé par Souci...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240808
					]
				},
				{
					"id": 750240808,
					"content": "#C'est donc ça qui s'est passé. Désolé pour le dérangement, {M#tous}{F#toutes} les deux... Je m'appelle Icayo, et comme vous pouvez le voir, je suis un aventurier qui aime chasser les sauriens... Et parfois, c'est un peu l'inverse qui se produit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240809
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240809,
					"content": "J'ai eu un petit problème de santé récemment et j'ai dû rester au lit pendant un moment. J'ai donc perdu beaucoup d'endurance et je n'ai pas pu tenir la distance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240810
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240810,
					"content": "Ils m'ont encerclé avant même d'arriver au camp. Ils doivent s'inquiéter pour moi. *soupir* Je suis tellement heureux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240811,
						750240812
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240811,
					"content": "Il semble que vous soyez un vrai optimiste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240813,
					"content": "D'ailleurs, nous avons juste eu un petit... problème avec Souci dans la précipitation pour vous sauver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240814,
					"content": "Ah, ce n'est pas un problème. Pour elle, ce n'était probablement rien de plus qu'un jeu comme un autre. Elle se cache probablement quelque part pour bouder parce qu'elle a perdu contre vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240815
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240815,
					"content": "Malgré son apparence, c'est une créature sensible. Je la retrouverai plus tard pour la consoler, ne vous inquiétez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240816
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240816,
					"content": "#Eh bien, on dirait que vous allez bien aussi. Nous nous sommes {M#inquiétés}{F#inquiétées} pour rien, mais l'essentiel est que vous n'ayez rien de grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240817,
					"content": "Je vous suis vraiment reconnaissant. D'ailleurs, même si ce n'est pas grand-chose... Je vous prie d'accepter ma recette de ceviche en sauce aigre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240818
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240818,
					"content": "#Vagounette aime particulièrement ce plat, peut-être que votre compagnon {REALNAME[ID(2)|SHOWHOST(true)]} l'aimera aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240819
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240819,
					"content": "Raouh... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240820
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240820,
					"content": "#Qu'est-ce qu'il y a ? Tu veux goûter ? Très bien, {NICKNAME} t'en préparera plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240821,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
