			"dialogs": [
				{
					"id": 750240101,
					"content": "Mes amis, votre enthousiasme... me laisse tout simplement sans voix. Mangez d'abord une glace pour vous détendre. Ensuite, nous pourrons discuter, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240102,
					"content": "Grr raouh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "Souci"
				},
				{
					"id": 750240103,
					"content": "Vous entendez d'abord un cri de douleur, suivi du bruit sourd de quelque chose de lourd tombant au sol. Ensuite, il n'y a plus que la complainte des sauriens...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "Hein ?! Est-ce que cette personne va bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Ils l'ont encerclé. Je ne vois pas du tout ce qui se passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "Pourrais-tu regarder d'en haut, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} voudrait essayer. Alors vas-y, petit gars !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "Quelque chose ne va pas, est-ce que cette personne est décédée ? *soupir* Elle a peut-être simplement perdu connaissance... Dans tous les cas, nous ne pouvons pas rester les bras croisés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Euh... Pourriez-vous me laisser passer, tous les trois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "Grr ! Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "Souci"
				},
				{
					"id": 750240113,
					"content": "Raouh... Raouh raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "Vagounette"
				},
				{
					"id": 750240114,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "Jade"
				},
				{
					"id": 750240115,
					"content": "Pff, ils refusent de nous laisser passer... Que se passe-t-il réellement ? D'après ce que cette personne a dit, ces sauriens ne lui sont sûrement pas complètement étrangers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Si seulement nous avions plus d'indices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "... Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#Oh ? Tu as trouvé quelque chose, {REALNAME[ID(2)|SHOWHOST(true)]} ? Suivons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502402",
							"2"
						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "« ... Aujourd'hui, il pleut. J'ai préparé le plat préféré de Vagounette, du <color=#00E1FFFF>ceviche en sauce aigre</color>. Quand je vois le bonheur sur son visage, tous les efforts sont oubliés... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240202,
					"content": "« ... Même si elle est en train de nager paisiblement, dès que je sers du <color=#00E1FFFF>ceviche en sauce aigre</color>, elle saute hors de l'eau. Et avec beaucoup de grâce en plus ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240203,
					"content": "« ... Je ne doute pas de son amour pour moi. Je crains seulement qu'elle puisse aimer le <color=#00E1FFFF>ceviche en sauce aigre</color> encore plus que moi... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240204,
					"content": "Donc... Ce koholasaure s'appelle Vagounette, c'est bien ça ? Le ceviche en sauce aigre cuit dans la marmite au camp devait être pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "« ... Des yeux ronds, une queue bouclée, un rugissement puissant et joyeux... Jade, oh Jade. Y a-t-il une saurienne plus adorable que toi dans le monde...? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240206,
					"content": "« ... Tu n'as jamais été trompée et croit en tout avec une totale confiance. Il semble qu'elle puisse se lier d'amitié avec toutes les créatures de la terre et s'amuser avec elles... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240207,
					"content": "« ... Si je n'avais pas tant de choses à faire, j'aimerais m'amuser avec toi toute la journée. Je te regarderais te précipiter dans la forêt baignée de soleil, telle une enfant du vent, en toute insouciance ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240208,
					"content": "#Hmm, il semblerait que la petite yumkasaure, nommée Jade, soit très jouette. Il est fort possible qu'elle se lie d'amitié avec {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "« ... J'ai parcouru des collines et des vallées juste pour te retrouver. Si tu ne m'aimais pas, tu aurais pu tout simplement partir... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240211,
					"content": "« ... Mais tu as suivi ma progression avec précision, et tu as même ramassé tous ces granifruits pour moi, sans parler de ces pierres brillantes... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240212,
					"content": "« ... Oh, Souci. Je suis le seul à savoir que sous ta coquille se cache un cœur tendre. Ce n'est pas dans ta nature d'être une combattante aussi féroce... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Journal d'un inconnu"
				},
				{
					"id": 750240213,
					"content": "Hmm... Donc Souci est cette tepetlisaure turbulente ? Je n'ai vraiment rien vu de « tendre » dans l'agressivité de ce saurien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Mais alors, ces trois sauriens sont ses... amis ? Pourquoi l'ont-ils assommé avant de l'encercler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Commençons par le sauver, nous poserons les questions après.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "Tu as raison. Si seulement les sauriens nous laissaient passer... Attends un peu, n'était-il pas écrit dans le journal que Vagounette adore le ceviche en sauce aigre ? Il y en a encore au camp, peut-être qu'on pourrait s'en servir pour la faire bouger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#Quant à Jade... Nous pourrions envoyer {REALNAME[ID(2)|SHOWHOST(true)]} devenir son ami ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Bonne idée ! Jade est très jouette. Il suffit à {REALNAME[ID(2)|SHOWHOST(true)]} de l'emmener jouer un peu plus loin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "Yaa ! Yaa yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} déborde également d'enthousiasme ! Mais essayons d'abord avec le ceviche en sauce aigre. C'est la méthode la plus simple, et on évite de gaspiller, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "Nous pourrions attaquer Souci en duel !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Essayons d'abord des méthodes plus pacifiques ! Comme demander à {REALNAME[ID(2)|SHOWHOST(true)]} d'éloigner Jade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
