			"dialogs": [
				{
					"id": 750240601,
					"content": "Grr raouh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "Souci"
				},
				{
					"id": 750240602,
					"content": "Calme-toi, nous voulons juste savoir si cette personne est blessée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "On dirait qu'un duel est inévitable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "N'abandonne pas aussi facilement ! Nous ne vous voulons aucun mal, et nous savons que tu n'as pas l'intention de te battre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Grr ! Raouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "Souci"
				},
				{
					"id": 750240607,
					"content": "Euh... Pourquoi est-elle de plus en plus en colère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "« Oh Souci, ma chère et tendre Souci »...",
					"roleType": "TALK_ROLE_PLAYER",
