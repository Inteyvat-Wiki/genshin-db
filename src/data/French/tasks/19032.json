			"dialogs": [
				{
					"id": 1903203101,
					"content": "*sniff* Hein...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203102,
					"content": "Hum... Tu... Tu... Tu peux m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203103,
					"content": "T'aider ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "Cet exorciste... aux cheveux bleus... fait tellement peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203106,
					"content": "Est-ce que tu peux le faire partir ? Il me fait tellement peur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203107,
					"content": "Tu es affectée par son énergie positive ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Je n'ose pas m'approcher de lui, l'énergie qu'il dégage est tellement horrible, elle me ferait disparaître !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203110,
					"content": "Et je ne veux pas disparaître, s'il te plaît, aide-moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203111,
					"content": "Je me demande si tu comptes comme un mauvais esprit à ses yeux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "Ah, alors faisons comme ça, j'ai une idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203114,
					"content": "Euh... J'ai vu l'exorciste aux cheveux bleus... se disputer avec des gens là-bas, il y a quelques minutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203115,
					"content": "Je peux les faire fuir, mais tu dois demander à l'exorciste de me laisser partir, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203116,
					"content": "Tu dis la vérité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "Bien sûr, je dis toujours la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203120,
					"content": "Alors, qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203121,
					"content": "Je ne peux pas décider pour lui. Je ne peux que lui expliquer la situation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Euh... D'accord... Alors je vais prendre ça pour un « oui » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203123,
					"content": "J'espère que l'exorciste aux cheveux bleus est quelqu'un de gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203124,
					"content": "... Alors... Je l'aide, et tu iras lui parler. Avec un peu de chance, il me laissera tranquille... Ça te paraît correct ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203118,
					"content": "Je pourrais très bien me débarrasser de ces gens moi-même.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "Peut-être, mais ça serait compliqué, et puis j'ai déjà une idée, fais-moi confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203112,
					"content": "Je ne peux pas décider pour lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "Normal que personne ne t'aie vu aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "Pourquoi moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}