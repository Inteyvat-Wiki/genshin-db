				"points": []
			},
			"dialogs": [
				{
					"id": 200250101,
					"content": "Ah ! Vous tombez à pic !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250102,
					"content": "Hier soir, j'étais en route vers Mondstadt pour livrer de la marchandise quand tout à coup, des boules lumineuses sont apparues sur mon chemin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250103,
					"content": "Je me suis retrouvé attiré vers elles... et comme j'étais ivre, je me suis rendu compte trop tard que je me faisais attaquer par des Blobs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250104,
					"content": "J'ai pris mes jambes à mon cou, mais je me suis perdu dans la panique. Ça m'a pris une éternité pour retrouver mon chariot et la cerise sur le gâteau : j'ai perdu ma <color=#00E1FFFF>clé</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250105,
					"content": "Pouvez-vous la retrouver ? Elle doit bien être dans le coin... J'ai vraiment l'impression qu'elle est sous mon nez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250106,
						200250108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250106,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250107
					]
				},
				{
					"id": 200250107,
					"content": "Génial ! C'est tellement grand par ici, je ne sais pas par où commencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250108,
					"content": "J'ai une autre urgence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250109
					]
				},
				{
					"id": 200250109,
					"content": "C'est tellement grand par ici, je ne sais pas par où commencer. Vous êtes la seule personne qui puisse m'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
