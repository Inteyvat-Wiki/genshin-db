			"trigger": {
				"objectNames": [
					"#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "Oui ? Qu'est-ce qui t'arrive ? Ne me dis pas que tu t'es encore fait avoir au jeu de la chasse aux trésors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820102,
					"content": "Je te l'ai dit. Pour ce qui est de ces trésors, <color=#00E1FFFF>plus ils ont de la valeur, plus il y a de tonneaux explosifs autour. Moins ils ont de la valeur, et moins il y a de danger autour.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820103,
					"content": "Tu vas arriver à t'en souvenir cette fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»",
					"Oncle He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Tu n'es qu'un rebut des Pilleurs de trésors ! *halète* Si j'avais pu manger des champignons et avoir des forces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820202,
					"content": "Je t'aurais écrabouillé comme un misérable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820203,
					"content": "Espèce de vieille crapule, qu'est-ce qui te prend à critiquer les lys vern... Fleurs de Qingxin que j'ai plantées, d'accord ? Si c'étaient des champignons, je les aurais fourrés dans ta bouche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820204,
					"content": "*tousse* Non, mais ! Qu'est-ce que c'est que ces histoires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820205,
					"content": "Hein, pourquoi vous vous battez tous les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "Je... Je cherche de la chair de champignons, de la chair de champignons. Hélas, ils refusaient de me laisser descendre dans la mine, et je suis donc venu en chercher ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820207,
					"content": "J'en ai finalement trouvé ici après avoir cherché pendant si longtemps ! Mais ce malotru a frappé la main que je tendais pour les cueillir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820208,
					"content": "#Il ose mettre les pieds sur le terrain d'entraînement des descendants du Clan Guhua ! Cette fleur... Excepté moi, et {M#le valeureux}{F#la valeureuse} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820209,
					"content": "Et la valeureuse Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Et la valeureuse Paimon... Excepté nous trois, personne n'a le droit de les convoiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820211,
					"content": "Tu n'es qu'un rebut des Pilleurs de trésors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820212,
					"content": "Et toi, une vieille crapule !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820213,
					"content": "Allez, ça suffit maintenant ! Oncle He, Tang Wuchou est revenu sur le droit chemin, il ne travaille plus pour les Pilleurs de trésors. De plus, ce sont des fleurs qu'il a plantées, pas des champignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "C'est vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820215,
					"content": "Regardez de plus près ! Ce sont des fleurs de Qingxin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "En effet, c'est bien des fleurs de Qingxin. Je crois que j'ai encore la tête qui tourne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820217,
					"content": "Quant à vous... Ne me dites pas que vous voulez toujours ce « jardin de lys vernis » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Ce serait tellement beau d'en avoir un ici, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				},
				{
					"id": 710820219,
					"content": "Ne vous battez plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*soupir* Pas de champignons... Je m'en vais, c'est bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Oncle He"
				},
				{
					"id": 710820221,
					"content": "Maintenant que ce vieux croûton est parti, je peux enfin réfléchir à comment cultiver mes fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#L'autoproclamé «{NON_BREAK_SPACE}Tang Wuchou{NON_BREAK_SPACE}»"
				}
			]
		}
	]
