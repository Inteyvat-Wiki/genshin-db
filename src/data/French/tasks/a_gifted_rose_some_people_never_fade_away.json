					"Sabbah",
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "« Rose, rose, réalise mon souhait. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "« Elle fleurit de la pierre et chante pour moi, la rose dorée. »",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Les roses d'or sont vraiment jolies. Les voir s'épanouir me met de bonne humeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090402,
					"content": "Je suis si heureuse que tout le travail qu'on a fait ces derniers jours n'ait pas été vain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090403,
					"content": "Le souhait s'est enfin réalisé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "En fin de compte, j'ai réussi à faire quelque chose de bien. Monsieur Shafaqat, on a réalisé votre souhait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090406,
					"content": "Quel dommage qu'il ne puisse voir ça lui-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090407,
					"content": "#Sabbah, ne dis pas ça. Tu te souviens de la dernière partie du chant de la rose{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090408,
					"content": "« Aucune terre ne veut de moi, seuls les chants me portent. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090409,
					"content": "« Les chants triompheront de mon cruel destin, eux seuls triompheront de ma fin. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090410,
					"content": "« Ils triompheront de moi, ils triompheront du temps et triompheront de l'éternel flétrissement. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090411,
					"content": "La vie de monsieur Shafaqat, ses roses dorées et la chanson qu'il a écrite... Toutes ces choses sont restées avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090412,
					"content": "Oui, vous avez raison. Il a vaincu la mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090413,
					"content": "Merci de m'avoir fait connaître Shafaqat. Cela signifie beaucoup pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090414,
					"content": "Il a été exilé avant moi. Quand je vois les marques qu'il a laissées en vivant ici, j'ai l'impression de voyager dans le temps et l'espace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090415,
					"content": "Quand je vois tout ça, je ne vois pas seulement Shafaqat, mais aussi mon propre reflet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090416,
					"content": "Même si je ne peux pas lui parler, je peux prendre ses regrets avec moi et continuer de vivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090417,
					"content": "Si je vis pour lui aussi, alors je suis sûre que je finirai par me racheter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090418,
					"content": "Je vous souhaite d'être heureuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Ce n'est plus aussi difficile pour moi de vivre ici maintenant. Je suis heureuse d'avoir eu la chance de vous rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090421,
					"content": "Les roses sont véritablement des fleurs qui apportent du bonheur aux gens. Monsieur Affan, il faut qu'on en plante davantage à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090422,
					"content": "Haha, d'accord, marché conclu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090423,
					"content": "Oui, je ferai de mon mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090419,
					"content": "Ne vous découragez pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Ça en valait la peine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
