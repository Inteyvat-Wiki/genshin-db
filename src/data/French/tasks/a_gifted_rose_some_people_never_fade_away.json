					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Si ces quelques fleurs poussent bien, on pourra cultiver encore plus de roses dorées à l'avenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Mais d'abord, je dois m'assurer que ces roses dorées fleurissent correctement pour avoir l'esprit tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "J'étais sur le point de perdre espoir. Je ne pensais pas que ces fleurs allaient vraiment pousser. Je suppose que tant qu'on est en vie, des choses merveilleuses peuvent encore nous arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Tu es toujours triste pour Shafaqat, jeune fille ? Ne sois pas triste. Nous qui sommes en vie, nous devons continuer à vivre en respectant les souhaits de ceux qui ne sont plus de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Monsieur... Je ne suis plus une enfant. Tous mes amis d'enfance... Ils ont sans doute déjà des enfants, et ceux-ci vont peut-être acheter leurs épices en magasin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090704,
					"content": "Mais vous avez raison... On doit être heureux d'être en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}