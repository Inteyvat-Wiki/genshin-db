			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "#Ça devrait être suffisant. Merci beaucoup, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Avec cet engrais spécial, la fertilité du sol ne devrait pas être un problème, cette rose pourra pousser normalement sans aucun doute possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "J'espère que cet engrais marchera bien, pas comme les précédents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Vous avez déjà essayé d'utiliser de l'engrais auparavant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "On a utilisé des engrais courants, mais ils ne se sont pas révélés très efficaces... Il serait plus juste de dire qu'ils n'étaient pas efficaces du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Mais ces engrais ont très bien fonctionné dans d'autres champs. Je ne sais pas ce qui cloche avec ce champ-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "#Enfin bon, n'en parlons plus. Tenez, {M#voyageur}{F#voyageuse}, veuillez accepter ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302304,
