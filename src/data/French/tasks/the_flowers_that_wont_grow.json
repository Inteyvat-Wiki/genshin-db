				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "En plus de la fertilité des sols, l'eau peut aussi être un problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Peut-être avons-nous enterré la rose si profondément qu'elle n'a pas pu absorber suffisamment d'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "#{M#Voyageur}{F#Voyageuse}, s'il vous plaît, pourriez-vous nous aider à arroser cette rose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302306",
							"2"
						],
						"stepId": 2302306,
