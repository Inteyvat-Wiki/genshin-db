			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen",
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Ça ne va pas, papa. Les roses ne poussent pas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Il faut trouver rapidement une solution viable, ou l'on ne pourra pas livrer toutes les herbes à temps cette année.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "La terre est bonne et les mauvaises herbes et les parasites ont tous été éliminés. Qu'est-ce qui ne va pas exactement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "De quoi vous inquiétez-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "Hmm ? Vous êtes ici pour acheter des herbes médicinales ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Je vous explique : on fournit régulièrement des plantes médicinales aux médecins du Bimarestan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "Et la plus importante de ces plantes est cette rose sumérienne spéciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "Les roses peuvent être utilisées comme médicament ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Ça, c'est une question pour les médecins du Bimarestan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "Ils m'ont dit qu'utiliser cette rose en combinaison avec d'autres médicaments permettait de traiter les coups de chaleur, de soulager les maux d'estomac, et qu'elle avait d'autres propriétés... Je ne me souviens plus exactement desquelles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "Dans ce cas, je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "Qu'est-ce qui ne va pas avec cette rose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Je ne sais pas pourquoi, mais elle pousse très lentement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "D'après notre expérience, dans ce cas, soit c'est un problème de sol, soit il y a une infestation d'insectes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Pourtant, on a planté des herbes ici auparavant, et elles poussaient sans aucun problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "On élimine les nuisibles tous les jours, donc impossible que ce soit des insectes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Hélas, on n'a plus le temps de réfléchir à cela. Si on ne fait pas de notre mieux pour résoudre ce problème, cette rose ne sera pas livrée à temps au Bimarestan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Pour l'instant, on envisage d'abord de fertiliser le sol avec un engrais spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Mais on doit s'occuper d'autres cultures, et donc on n'a pas le temps de rassembler les matériaux nécessaires à la fabrication des engrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "#{M#Voyageur}{F#Voyageuse}, pour le bien-être des patients du Bimarestan... Pourriez-vous nous aider, s'il vous plaît ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Je vais vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Bon, voyons voir où nous en sommes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
