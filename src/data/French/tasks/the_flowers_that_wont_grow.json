			"dialogs": [
				{
					"id": 230230201,
					"content": "On a besoin de beaucoup d'engrais spéciaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Il nous faut encore d'autres matières premières pour fabriquer cet engrais spécial, mais nous n'avons plus de fruits harras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous nous ramener des fruits harras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
