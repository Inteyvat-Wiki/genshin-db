					"Vardan",
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Ouf... Ça va. Le sol devrait être suffisamment humide pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}. Sans votre aide, on serait épuisés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "C'est bizarre. Il a fallu utiliser énormément d'eau pour arroser le champ cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "J'ai l'impression d'avoir utilisé deux fois plus d'eau que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "Tu es trop fatigué, c'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "Si on avait utilisé deux fois plus d'eau, toute la terre serait inondée, alors qu'elle est juste normalement humide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "Certes, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230608,
					"content": "J'espère que les roses pousseront bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "#Soyez {M#rassurés}{F#rassurées}, on prendra bien soin de cette rose pour les patients et les médecins du Bimarestan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230610,
					"content": "#Tenez, {M#voyageur}{F#voyageuse}, veuillez accepter ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230611,
					"content": "C'est curieux, j'ai vraiment l'impression d'avoir utilisé plus d'eau que d'habitude aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
