			"dialogs": [
				{
					"id": 205160401,
					"content": "Étrange, cette petite n'était pas malade ? Comment peut-elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Excusez-moi, je cherche une petite fille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Ah... Vous parlez sûrement d'Anna, non ? Levez les yeux : elle est sur la Statue de l'Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "J'ai été surprise de la voir courir, n'était-elle pas gravement malade ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "Le temps que je me pose la question, et elle était déjà grimpée tout là-haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "Vous... Vous n'êtes pas en colère ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "En colère ? Ah, si, bien sûr, un peu, mais... elle était si malade auparavant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "De la voir galoper comme ça... Comment dire ? Je n'ai pas eu le courage de me fâcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "Mais le vent souffle fort là-haut, il ne faudrait pas qu'elle prenne froid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
