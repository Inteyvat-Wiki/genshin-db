					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "Sur... Sur la main de la statue ? Mais comment s'est-elle débrouillée pour se retrouver là-haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160304,
					"content": "Bon. Je vais la chercher et lui dire de descendre tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160305,
					"content": "#Encore une fois, merci à vous, {M#voyageur}{F#voyageuse}. Tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
