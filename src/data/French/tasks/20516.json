			"dialogs": [
				{
					"id": 205160201,
					"content": "On a vraiment une vue sur tout Mondstadt d'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160202,
					"content": "Tu vas attraper froid, petite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "Ouah ! Vous m'avez fait peur ! D'où vous sortez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Je parie que c'est mon frère qui me cherche encore. Héhé, je savais bien qu'il ne me trouverait pas ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Bon d'accord, ça va... Je vais rentrer ; je veux pas qu'il continue à s'inquiéter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
