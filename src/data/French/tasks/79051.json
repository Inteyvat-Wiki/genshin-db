			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "Il y a un journal ici, et il a l'air en bon état.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510102,
					"content": "Ouf... Quel soulagement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510103,
					"content": "Il a trouvé la force de se relever et a amélioré ses compétences en peinture ! Je pense qu'il va réussir à percer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510104,
					"content": "Mais il est tout de même parti sans ses amies gouttelettes, je trouve ça un peu triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510105,
					"content": "Il ne pouvait peut-être pas accepter l'idée d'une reproduction de lui-même.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Hmm, je peux comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510108,
					"content": "Il y a encore quelque chose qui me perturbe. Il a mentionné dans le journal que la fresque peut changer de forme et de place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510109,
					"content": "Mais malgré tout ce qui s'est passé, elle est toujours en bon état...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510110,
					"content": "C'est grâce à ces Gouttelettes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Oh, c'est vrai ! Pas étonnant que les Gouttelettes sachent tant de choses sur le projecteur à flux et la restauration de la fresque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510113,
					"content": "C'est tellement émouvant... Les Gouttelettes n'ont peut-être pas l'air très intelligentes, mais ce sont des amies fidèles et attentionnées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790510111,
					"content": "Elles ont protégé l'œuvre de leur ami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Il est important de conserver son authenticité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
