					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800702,
					"content": "Pfiou... Ce manuscrit de mon épopée renferme toutes mes émotions et mes ambitions. Je vous le remets aujourd'hui pour témoigner de ma gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
