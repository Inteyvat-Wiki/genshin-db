			"dialogs": [
				{
					"id": 710800634,
					"content": "#Raconter votre quête pour retrouver votre {M#sœur}{F#frère}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Vous racontez à Taliesin les événements qui se sont passés...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "En effet, c'est fascinant... Un ancien pays oublié, des sacrifices non reconnus, un châtiment d'une bêtise sans nom... Voilà de grands thèmes pour une grande histoire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "Et dire que ces histoires sont des choses que vous avez vécues au cours de vos voyages, et qu'elles sont étroitement liées à votre but ultime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Merci d'avoir partagé tout cela avec moi. Je vais tout noter. Cela dit, je ne vais pas en faire un poème pour l'instant... Parce que ces histoires ne sont que de petits fragments de votre épopée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Mes compétences sont limitées et je ne voudrais pas massacrer votre histoire... C'est pourquoi j'aimerais vous demander de revenir me parler de votre voyage une fois qu'il sera terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Mon intuition me dit que lorsque ce jour viendra, mes oreilles seront bénies par le récit le plus héroïque que ce monde ait connu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
