					"nextDialogs": [
						710800611
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800611,
					"content": "Euh... On peut pas vraiment faire ça, on n'a pas demandé sa permission pour l'inclure dans cette histoire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710800612,
					"content": "Pas de souci, voyons ! Les héros n'agissent pas comme les gens ordinaires, et ne sont pas contraints par des règles aussi banales ! Cela ne dérangera personne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
