			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "... Miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Boule-de-poussière"
				},
				{
					"id": 705430103,
					"content": "... C'est vous. J'étais en train de discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "Discuter... Tu parles à Boule-de-poussière, Razor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Miaou, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Boule-de-poussière"
				},
				{
					"id": 705430106,
					"content": "Boule-de-poussière a l'air... d'être d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "Une odeur familière, à la recherche d'amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "Il va bien, il est content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "Miaou, miaou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Boule-de-poussière"
				},
				{
					"id": 705430110,
					"content": "L'odeur attire mes amis. Vous êtes là aussi, je suis content. Tu sens le vent et la pluie, très familier... L'odeur du chat... Familière aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon a un parfum sucré, ça sent bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "Hein ?! Est-ce l'odeur des crêpes que Valerina nous a offertes ? Haha... J'en ai mangées tant que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "Je t'ai donné la moitié des miennes, tu te souviens ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Je n'avais pas du tout remarqué... C'est qu'elles sont tellement bonnes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Haha, j'ai aussi envie de manger du poulet mariné aux fleurs sucrantes, un steak avec des galettes de pommes de terre... Oh, et boire du cidre de pomme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#C'est bon, on a le menu du prochain repas ! C'est parti, {NICKNAME}, allons passer commande chez Valerina ! Viens avec nous, Razor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "M—Merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Boule-de-poussière m'a apporté beaucoup de... noix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "Et de la viande... Je suis repu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "On dirait que c'est la livraison de Valerina. Est-ce que Boule-de-poussière a livré de la nourriture à Razor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Miaou miaou. Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Boule-de-poussière"
				},
				{
					"id": 705430123,
					"content": "Je ne m'attendais vraiment pas à ce que ce soient les chats qui servent les visiteurs au Château cotonnoux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "On dirait que Razor murmure à l'oreille des chats !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "Tu es capable de manger trois fois plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
