			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "Ah, c'est vous ! Merci de m'avoir apporté ces fragments de gravure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Par contre, leur déchiffrage... n'avance pas vraiment. Leurs similitudes avec les gravures phlogistiques ne sont que superficielles. Leur complexité est donc bien plus grande que je ne l'avais imaginé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Mais il n'y a plus de retour en arrière possible... Je dois à tout prix y arriver de toute façon, hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
}