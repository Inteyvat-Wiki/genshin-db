				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "La torche s'éteint encore... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080001,
					"content": "Quelque chose ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "#Ah, {M#un voyageur}{F#une voyageuse}... Vous voyez les trois tours de garde au loin ? Leurs braseros devraient toutes être allumés en principe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080003,
					"content": "Les Plaines Guili sont difficiles à traverser en temps normal, alors n'imaginez même pas quand des monstres sont dans les parages ! Ces torches servent non seulement à éclairer la voie, mais aussi à signaler qu'il n'y a aucun danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080004,
					"content": "Mais... j'étais tellement occupé à chasser les monstres que j'en ai oublié de raviver les torches. Elles étaient déjà toutes éteintes à mon retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Il y a des inspecteurs qui viendront vérifier si le travail a été fait. Je peux faire diversion ici, pendant que vous vous en occupez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "Vous ne pouvez pas rester ici et je ne peux pas abandonner mon poste non plus. Ça serait la cata !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "S'il vous plait, aidez-moi à allumer toutes les torches !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
