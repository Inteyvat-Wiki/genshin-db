						210080402
					]
				},
				{
					"id": 210080402,
					"content": "Les Plaines Guili sont une formation rocheuse à l'origine ; certains endroits sont plus accidentés que d'autres, comme la pente qui se dirige vers la tour de garde à l'ouest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "En partant vers l'est vers la mer par contre il y a peu de relief. Si l'occasion se présente je vous recommande d'aller voir le Bancs de Yaoguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
