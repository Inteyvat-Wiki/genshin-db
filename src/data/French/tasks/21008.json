					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "Ils s'assurent que les feux ne s'éteignent pas, mais c'est à moi de les allumer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080503,
					"content": "Je sais qu'on dirait du chipotage, mais il est primordial que chacun respecte son rôle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
