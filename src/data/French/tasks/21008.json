					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080203,
					"content": "Il y a trois tours de garde sur la route. Revenez me voir quand vous aurez allumé leurs torches, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080204,
					"content": "Vous tomberez aussi sur une Statue des Sept au bout du chemin. Si ça se trouve, vous recevrez la bénédiction du Souverain de la Roche en lui rendant visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080205,
					"content": "Ce n'est pas une tâche bien difficile, mais il faut s'en occuper... Merci, et n'oubliez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
