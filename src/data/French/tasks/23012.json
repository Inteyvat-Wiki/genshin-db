			"dialogs": [
				{
					"id": 230120101,
					"content": "Miaou... Ahem ahem, ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120102,
					"content": "Qu'est-ce que vous faites...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "Je cherche mes chats, et ils me répondent généralement si je les appelle comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120104,
					"content": "Peut-être que je prononce mal aujourd'hui ? Je les ai appelés plusieurs fois, mais ils ne répondent pas, c'est bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120105,
					"content": "Et pourquoi ne les appelez-vous pas directement par leur nom ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "C'est vrai, normalement si l'on cherche un chat, on l'appelle directement par son nom, vous ne croyez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120107,
					"content": "Mais si l'on appelle les chats par leur nom directement en langage humain, ils ne comprennent sûrement pas, si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120108,
					"content": "Hum ? C'est pas faux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120113,
					"content": "Mais ce n'est pas non plus une bonne idée de continuer à crier comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120114,
					"content": "#{M#Voyageur}{F#Voyageuse}, je veux vous poser une question sérieuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120115,
					"content": "Laissez-moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "... Est-ce que vous voulez apprendre le langage des chats ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120118,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "Quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120120,
					"content": "Vous voulez dire que vous allez nous apprendre à parler comme des chats ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120116,
					"content": "La récompense ne peut pas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "Pourquoi vous dites que vous prononcez mal aujourd'hui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "Eh bien, parce que j'appelais leur nom en langage félin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120111,
					"content": "Après tout, si l'on appelle des chats directement par leur nom en langage humain, ils ne comprendront certainement pas, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120112,
					"content": "Hum ? C'est pas faux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
