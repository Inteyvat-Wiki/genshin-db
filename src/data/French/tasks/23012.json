			"dialogs": [
				{
					"id": 230121101,
					"content": "J'ai déjà eu de vraies conversations avec des chats...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Tu veux parler de Neko ? Mais Neko peut parler le langage humain, je ne pense pas qu'on puisse considérer cela comme parler le langage des chats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "En échange, je vous demande de m'aider à ramener un chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Ça veut dire que vous êtes d'accord ? Merci, merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Ahem, ahem ahem... Alors écoutez bien, ce sont des formules typiques du langage des chats sur lesquelles j'ai beaucoup travaillé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "La façon de trouver un chat est différente pour chaque ville...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Haha, ha... C'est vrai, maintenant que j'y pense, on a aidé à chercher des chats dans de nombreuses villes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "On peut donc dire que tout le monde aime les chats, ou plutôt... que tous ceux qui possèdent un chat ont les mêmes problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
