			"dialogs": [
				{
					"id": 230120301,
					"content": "Oh, vous avez ramené le chat, je vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "On dirait que vous maîtrisez bien le langage des chats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Veuillez accepter ceci comme récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Tout le monde n'apprend pas aussi vite le langage des chats, alors peut-être que j'aurai besoin de votre aide la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Miaou !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Tu peux parler normalement maintenant ! Mademoiselle Sareh n'est pas un chat !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "J'ai deviné à votre expression que vous essayiez de dire « pas de problème », mais... votre prononciation n'est pas tout à fait correcte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "Ce n'est pas grave, je vais continuer à vous apprendre le langage des chats, on va progresser ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
