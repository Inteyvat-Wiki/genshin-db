			"dialogs": [
				{
					"id": 230290101,
					"content": "Il est presque temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Vous travaillez toujours sur les racines de l'arbre divin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous arrivez toujours au bon moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Merci pour tout ce que vous avez fait ! L'arbre divin se porte à merveille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "On en a discuté avec Ladep, et on pense que l'état de l'arbre divin va durer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "Maintenant, on va enfin avoir du temps pour préparer notre thèse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Voilà, j'ai emprunté un Daguerréotype à Pharez, et je vais pouvoir faire des relevés de l'arbre divin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que vous pouvez m'aider à prendre une image complète de l'arbre divin ? Je vais vous indiquer l'emplacement sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Pourquoi vous n'y allez pas vous-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Euh, là-bas... C'est trop haut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "J'ai peur chaque fois que je monte seule en hauteur... J'ai toujours l'impression que le vent va m'emporter... Ou emporter mon manuscrit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "#D'habitude, c'est Pharez qui va faire les relevés, mais aujourd'hui, il a l'air occupé par autre chose, alors je n'ai que vous pour m'aider, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
