					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Tous ces concentrés de connaissances sont ordinaires.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Les concentrés de connaissances liés à la Cour de la désolation sont probablement en quantité limitée, ils ont réussi à tous les emporter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#Ce n'est pas grave, j'ai une idée. {NICKNAME}, repartez par le même chemin. Moi, je vais me cacher ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "Venez me rejoindre un peu plus tard, et nous devrions pouvoir les faire sortir de leur cachette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Je comprends pourquoi vous vouliez que je garde le localisateur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "En partant hâtivement, ils ont dû laisser beaucoup de marchandise derrière eux et je ne pense pas qu'ils vont la laisser indéfiniment ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Une fois que notre départ sera confirmé, ils enverront quelqu'un tout reprendre. Quand le localisateur sera assez loin d'ici, ils penseront que le lieu est sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Je comprends ! Vous voulez qu'on leur serve de leurre pour les amener à se montrer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "D'accord ! Allons-y alors. On compte sur vous pour le reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "Ne vous en faites pas. S'ils osent montrer le bout de leur nez, je ne les laisserai pas repartir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
