			"dialogs": [
				{
					"id": 130101001,
					"content": "Rah, je suis crevée... On devrait être assez loin, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101002,
					"content": "Oui, c'est bon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "Super ! Reposons-nous ici un moment, puis retournons voir Cyno !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101006,
					"content": "Vous vous asseyez non loin de là pour vous reposer un moment...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Je pense que ça va, retournons jeter un œil à la vente aux enchères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101008,
					"content": "Je me demande si Cyno a trouvé quelque chose là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101004,
					"content": "Avançons encore un peu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "Tu veux encore avancer ? Mais je suis complètement à plat... Pourquoi ne pas nous reposer ici un moment ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
