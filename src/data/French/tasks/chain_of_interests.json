			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Il fait tellement chaud... Ce serait bien de trouver un endroit au frais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "Faisons une pause.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Le chemin est encore long, tenons bon. De plus, notre environnement n'est pas vraiment propice au repos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "Bon, d'accord. Cyno, vous n'avez pas chaud ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "Bien sûr que si, mais j'ai l'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "Vous n'avez pas une astuce à nous partager ? Je crois que je ne vais plus pouvoir tenir le coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "Restez concentrée autant que possible et persévérez. Si vous vous détendez, vous n'en serez que plus fatiguée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "Avancez pas à pas et ne laissez pas votre cerveau juger des limites de votre corps. Ne vous reposez que quand vous arrivez à un endroit sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "D'accord, mais qu'entendez-vous par lieu sûr ? Je me sens en sécurité ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "Regardez, le désert s'étend à perte de vue et il n'y a pas un monstre aux alentours... Ouah ! D'où viennent ces Scorpions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "Attention, ils ne sont pas normaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Pfiou... Je ne m'attendais pas à ce qu'il y ait des Scorpions ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "Ce ne sont pas des Scorpions ordinaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "Regardez, il y a des chiffres sur leurs pinces. Ils ont été élevés par des humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "Donc, ça veut dire que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Certaines personnes ne veulent pas que nous arrivions à la vente aux enchères et ont envoyé ces scorpions pour nous arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "Si nous mourons ici, personne ne le saura. Il n'y a que du sable aux alentours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "Ça craint ! Heureusement qu'on a fait attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "Mais quelque chose cloche... Il n'y a pas de chemin dans le désert, alors comment pouvaient-ils savoir que nous passerions par ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#Ne bougez pas, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "Voilà pourquoi... Ils vous ont collé cette chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "Hein, qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "C'est un petit localisateur que le Kshahrewar a créé. Il permet de déterminer la position approximative de son porteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "Si je me souviens bien, la production de masse de cet appareil n'a pas été approuvée. Où l'ont-ils obtenu ? Se pourrait-il que des chercheurs du Kshahrewar soient impliqués ? Ça me paraît bizarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#Pourquoi ce truc s'est retrouvé sur {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "#Les mercenaires ont dû le placer sur {M#lui}{F#elle} pendant le combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "#{M#Désolé}{F#Désolée}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "Ils ont profité du chaos, rien d'étonnant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "Heureusement que Cyno l'a trouvé ! Jetons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100420,
					"content": "#... Non, laissons-le sur {M#lui}{F#elle} pour l'instant, cela pourrait s'avérer utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100421,
					"content": "Dépêchons-nous de rejoindre la vente aux enchères, si nous restons ici plus longtemps, d'autres dangers risques de survenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100417,
					"content": "Je n'avais même pas remarqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Bizarre... La vente aux enchères devrait avoir lieu ici, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "Mais il n'y a personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Oui ! Il n'y a pas un chat. Est-ce qu'ils font une pause ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "Je nous ai fait venir ici immédiatement après avoir vaincu ce groupe de mercenaires, parce que je craignais que quelqu'un vienne et informe tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "Résultat, ils nous ont quand même vus venir... Ils ont probablement observé nos mouvements grâce au localisateur et ont évacué les lieux à l'avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Qu'est-ce qu'on fait maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Fouillons les lieux. Ils n'ont pas eu le temps de s'enfuir avec tous les concentrés de connaissances, on devrait être en mesure de trouver des indices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "Inspectons les environs de fond en comble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Ah ! Vous avez attrapé quelqu'un !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "Alors, c'est vous le grand méchant derrière tout ça ? Dites-nous ce que vous savez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "Il sait quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Quand il s'est montré, je l'ai observé un moment avant de me dévoiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "Ce n'est pas le cerveau des opérations, mais il s'agit tout de même d'un commerçant important. Ai-je tort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Ce n'est pas étonnant venant de vous, Cyno... Si j'avais su que vous n'étiez pas parti, je n'aurais pas sauté sur l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "L'occasion ? C'est-à-dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Quand les commerçants de concentrés de connaissances ont appris que vous veniez, ils ont tous pris leurs jambes à leur cou et n'ont pas eu le temps d'emporter toute leur marchandise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Tous ces produits sont donc temporairement sans propriétaires, et en les récupérant avant les autres, j'aurais pu gagner beaucoup d'argent. Enfin, je peux faire une croix dessus maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Vous devez certainement savoir qui fabrique et vend ces concentrés de connaissances, non ? Vous allez parler ou je vous force à le faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "Je vais tout vous dire. Mais avant, allons discuter ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Ma famille et moi serons en danger si on me voit ici avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Où voulez-vous aller ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "Chez moi, dans le Village d'Aaru. On sera en sécurité là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#Très bien. {NICKNAME}, jettez le localisateur et allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "Est-il suffisamment important ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simin",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Papa, tu es rentré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100802,
					"content": "Ah, ce sont des invités ? Bonjour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100803,
					"content": "Voici ma fille, Simin. Elle est un peu timide avec les étrangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Va lire un livre, ma chérie. Papa doit parler à ses invités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Ah... D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100806,
					"content": "Tout le monde connaît Cyno dans le milieu. Mais vous deux, comment vous appelez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#Je m'appelle Paimon et voici {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "#Pour être honnête, je ne m'attendais pas à ce que quelqu'un de solitaire comme Cyno ait des {M#coéquipiers}{F#coéquipières}. Quand j'ai vu le localisateur s'éloigner progressivement, j'étais persuadé que Cyno était reparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Cependant, même si vous m'avez pris sur le fait, j'espère encore pouvoir vous raisonner... Arrêtez-vous, ne poursuivez pas votre enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "Pourquoi ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Que ce soit la fabrication, la vente ou la répartition des gains... Chaque maillon implique au moins des dizaines de personnes, quand ce n'est pas plus d'une centaine, et nous sommes liés par les revenus colossaux que nous générons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Chacun va faire tout son possible pour protéger cette chaîne établie à la sueur de notre front. Ce sera très difficile de démanteler le réseau, même pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "Et si vous y arrivez, personne ne vous en remerciera. Peut-être même que vous le regretterez... Alors pourquoi vous donner autant de mal ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Nous sommes tous motivés par quelque chose dans cette affaire. Je n'ai pas besoin de m'exprimer là-dessus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Papa... J'ai fait du thé... Et voilà pour les invités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100817,
					"content": "Oh, c'est vrai, j'ai oublié de servir le thé aux invités. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "Je t'en prie... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100819,
					"content": "Le thé de la maison est amer. Alors, j'ai ajouté le sucre que papa m'a donné. Ça sera sûrement meilleur avec...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100820,
					"content": "C'est gentil, ma chérie. Est-ce qu'il t'en reste ? Sinon, papa t'en rachètera la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Hmm... Bon, je vais me reposer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100822,
					"content": "Vous disiez tout à l'heure que les membres du réseau de contrebande gagnaient beaucoup d'argent ? Ce n'est pas l'impression que vous donnez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "... En fait, j'aimerais également vous demander quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Ma fille est atteinte d'une maladie chronique. Elle est née avec un cœur et des poumons plus faibles que la moyenne. L'exercice physique un tant soit peu intense peut provoquer des évanouissements, voire mettre sa vie en danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "À cause de ça, elle n'a aucun ami depuis qu'elle est toute petite et passe toutes ses journées dans sa chambre. De plus, elle doit prendre beaucoup de médicaments au quotidien, ce qui nous revient très cher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "À l'origine, je n'étais qu'un petit commerçant. Je passais mes journées à courir à gauche et à droite pour travailler, mais le peu que je gagnais était insuffisant. Je ne pouvais rien faire d'autre que de la voir s'affaiblir de jour en jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Jusqu'à ce que quelqu'un vienne me voir et me montre un moyen de gagner beaucoup d'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "En vendant des concentrés de connaissances ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Exactement. Grâce à cet argent, j'ai enfin pu la soigner. Voir son état s'améliorer fait de moi le plus heureux des hommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Il y en a beaucoup d'autres comme moi. La contrebande de concentrés de connaissances peut vous sembler impardonnable, mais pour nous, c'est un moyen de survivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "J'espère vous persuader d'arrêter votre enquête avec ces paroles. Maître Cyno, je vous en prie, ne nous retirez pas ce moyen de subsistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Oh non... Si nous mettons un terme à la vente de concentrés de connaissances, ça veut dire qu'elle pourrait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Je dois connaître la vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Je peux trouver quelqu'un pour soigner votre fille, mais je ne peux pas fermer les yeux sur cette contrebande de concentrés de connaissances. Ce sont deux choses différentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "Je savais que vous diriez ça, mais je ne vais pas insister plus. Votre parole d'aider ma fille me suffit. Si vous êtes déterminé à poursuivre votre enquête, allez jeter un œil derrière la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "J'y ai entreposé la marchandise que j'ai reçue récemment, vous comprendrez quand vous la verrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Vous arrivez à l'arrière de la maison avec Cyno...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "Il y en a tellement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Toutes ces caisses soigneusement disposées... Et ce n'est que le repaire d'un seul de ces commerçants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "Une telle quantité ne peut être produite par un petit atelier. L'Académie pourrait-elle être derrière tout ça ? Mais il serait impossible qu'une telle quantité de produits puisse en sortir sans aucune inspection...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "Regardez, ces concentrés de connaissances ont l'air d'être différents. Vous croyez qu'il s'agit des concentrés de connaissances sur la Cour de la désolation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "Ce doit être le cas. Attendez, c'est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Je n'ai jamais vu ces symboles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "C'est le sceau d'approbation des matras. Sa présence signifie que les marchandises à l'intérieur ont été examinées par un matra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "En voyant le localisateur, j'ai commencé à soupçonner l'implication du personnel de l'Académie, mais je n'arrivais pas à imaginer comment autant de concentrés de connaissances auraient pu sortir de l'Académie ni vu ni connu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Maintenant, je vois clairement. Avec ce sceau, le transport des marchandises peut se dérouler sans accroc, car aucune vérification secondaire n'est nécessaire au moment de leur entrée ou sortie de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Hmm, pas étonnant qu'ils ne veuillent pas que je continue d'enquêter. Je n'arrive pas à croire qu'un matra soit derrière tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "C'est peut-être un malentendu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}, pourriez-vous me rendre un service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Étant donné que ces concentrés de connaissances proviennent de l'Académie, il est très probable que ceux liés à la Cour de la désolation soient fabriqués avec des matériaux de recherche scellés au sein de l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Il nous suffit de nous rendre dans la salle des archives pour vérifier le registre et nous connaîtrons les coupables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Ceci dit, je ne ferais qu'alerter ces derniers en me rendant précipitamment à l'Académie à cause de mon statut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "Pourriez-vous enquêter à ma place là-bas ? Je vais écrire à Nabil et lui demander de vous conduire à la salle des archives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "Bien sûr. On s'en occupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Pendant ce temps, je ne resterai évidemment pas les bras croisés. Bien que nos indices nous mènent à l'Académie, nos ennemis n'en demeurent pas moins très puissants en dehors de celle-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Je vais rester ici m'occuper des préparatifs et obtenir des informations sur d'autres commerçants de Bahari. Revenez me voir dès que vous avez du nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Cyno, ça vous dit quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
