			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "*soupir* Je ne comprends pas ce qu'il s'est passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130102,
					"content": "Iaune ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "#Oh, {M#voyageur}{F#voyageuse}, je suis content de vous voir. Vous êtes {M#venu}{F#venue} boire un café ? Laissez-moi vous offrir une tasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130105,
					"content": "#Qu'est-ce qu'il y a ? Vous n'avez pas l'air dans votre assiette. Vous avez encore dû rester debout très tard{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130106,
					"content": "Merci de vous en inquiéter. Mais c'est de ma faute, cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130107,
					"content": "Je me pose des questions... sur la signification de mon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130108,
					"content": "J'ai toujours pensé que la Maison Gestion était une organisation juste et efficace, et que tout le monde était prêt à se soutenir mutuellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130109,
					"content": "J'étais convaincu que sous sa gouvernance, la Cour de Fontaine allait connaître un développement positif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130110,
					"content": "Mais maintenant, on dirait qu'il s'agit d'une maison mécanique cassée. Elle fonctionne, mais de manière chaotique... Elle n'est désormais plus belle que de l'extérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130111,
					"content": "La raison pour laquelle elle fonctionne encore n'est qu'une série de coïncidences et de leçons, il n'est plus question de justesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130112,
					"content": "Je... Je voulais essayer de changer les choses, mais ce n'est pas possible. J'ai peur que si je fais une erreur, elle cesse de fonctionner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130113,
					"content": "Roialte me dit souvent d'essayer de me détendre. Peu importe les erreurs que je commets, la situation ne peut pas empirer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130114,
					"content": "C'est... C'est une étrange façon de réconforter quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130115,
					"content": "*soupir* Désolé, je ne devrais pas me plaindre. La raison pour laquelle je suis ici, c'est justement pour me changer les idées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130116,
					"content": "Je vais vous préparer du café.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Vraiment ? Vous savez faire du café ? C'est incroyable. J'ai toujours eu envie d'apprendre, mais je n'en ai jamais eu l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130118,
					"content": "Je vous laisse faire, alors. Je vais attendre ici... J'espère que mon travail ne reviendra pas occuper mes pensées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130103,
					"content": "Vous ne travaillez pas aujourd'hui ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
