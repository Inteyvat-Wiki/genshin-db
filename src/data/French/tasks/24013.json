				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous... Vous m'avez vraiment fait du café ? Je ne voulais pas vous embêter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "Inutile de me remercier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "... Ce café ! C'est nettement meilleur que celui de la Maison Gestion ! C'est... C'est complètement différent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Si je pouvais déguster ce café tous les jours, je ne somnolerais pas tous les après-midi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Merci pour le café. Après l'avoir fini, je devrai retourner travailler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "Bon courage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Comptez sur moi. Je dois vite apprendre et garder la tête haute comme Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "*soupir* Je me demande juste combien d'épreuves je vais encore devoir traverser avant d'en arriver là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "Il ne faut pas se laisser abattre !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Il faut le boire chaud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
