			"dialogs": [
				{
					"id": 240133101,
					"content": "Bonne idée ! Commençons la préparation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "Vous commencez à préparer le café...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Oh, ça sent bon ! Donnons-le à Iaune. J'espère que ça va lui remonter le moral !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
