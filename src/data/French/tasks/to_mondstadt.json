			},
			"dialogs": [
				{
					"id": 105010301,
					"content": "Allons, ce n'est pas la peine, vraiment. Je ne suis pas en manque à ce point...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010302,
					"content": "Même si j'ai un peu faim, il faut bien le dire... mais ce n'est rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050104,
			"completionStepIds": [
				1050107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050107",
							"2"
						],
						"stepId": 1050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "Enfin, nous voilà à Mondstadt. Pfiou... La route aura été longue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010402,
					"content": "Le chemin du savoir n'est décidément pas de tout repos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010403,
					"content": "Je ne suis pas fatiguée, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010404,
					"content": "Parce que tu flottes dans les airs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010405,
					"content": "Sans vouloir être méchante, les astromanciens n'ont pas l'air d'être si formidables non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010406,
					"content": "C'est parce que tu te fais de fausses idées sur l'astromancie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010407,
					"content": "Vous aussi, vous prenez une pause ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010408,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010409,
					"content": "Mes frères et moi-même sommes des marchands ; on vient de finir une affaire à Liyue, et on rentre à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010410,
					"content": "#Vous avez l'air plutôt {M#fatigués}{F#fatiguées}. Le chariot qu'on a réservé devrait arriver bientôt, pourquoi ne pas vous joindre à nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010411,
					"content": "C'est vrai que je suis un peu sur les rotules...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "Ça coûtera quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "Haha, alors marché conclu ! On pourra discuter en route ; plus on est de fous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010414,
					"content": "Mais non, mais non ! C'est sur notre chemin de toute façon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010415,
					"content": "#Nous ne sommes pas {M#intéressés}{F#intéressées}. Maintenant partez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010416,
					"content": "Eh bien ! Il y a un problème, mademoiselle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010417,
					"content": "Arrêtez vos simagrées, crapule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010418,
					"content": "S'en prendre à des voyageurs à l'air vulnérable, et les dépouiller une fois dans votre chariot pour les abandonner ensuite au milieu de nulle part – je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010419,
					"content": "C—Comment ça ? On vient juste faire la conversation et proposer notre aide, et on est reçus avec des insultes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010420,
					"content": "Si vous ne voulez pas monter avec nous, tant pis. Vous ne tournez pas rond...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010421,
					"content": "D'accord, dans ce cas j'imagine que vous ne verrez aucun inconvénient à ce que je décrive les objets volés en votre possession ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "Si vous n'êtes pas d'accord, je suis sûre qu'on pourra trouver des gens pour corroborer ce que je dis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "Si je me trompe, je veux bien vous donner 20 000 moras. Mais si je gagne, votre prochain repas sera dans une cellule au Port de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "Alors ? Si comme vous le prétendez vous êtes un marchand, voilà une belle aubaine, et de l'argent facilement gagné, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "Espèce de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010426,
					"content": "Tu as été trop loin, sale petite...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010427,
					"content": "Je ne sais pas comment tu sais tout ça, mais une chose est sûre : tu n'auras pas l'occasion de le répéter !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "Taylor"
				},
				{
					"id": 105010428,
					"content": "Mona, attention !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "Ne la touche pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "Ne t'en fais pas. C'est juste quelques bons à rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010431,
					"content": "Tu te rappelles quand tu disais que l'astromancie n'avait rien d'impressionnant ? Voilà une excellente occasion de te montrer de quoi est capable un maître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050105,
			"completionStepIds": [
				1050109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
