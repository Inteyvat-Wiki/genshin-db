			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "Bien le bonjour ! Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010202,
					"content": "On aimerait emprunter votre cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010203,
					"content": "Mon amie aimerait manger un plat un peu spécial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Oh, d'accord, je vois. Bien sûr ! Tant que vous utilisez vos propres ingrédients, la cuisine est à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010206,
					"content": "#Si je peux me permettre... Vous devez être {M#un cuisinier doué}{F#une cuisinière douée}, si je ne m'abuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010207,
					"content": "En effet. Les gens se régalent quand je suis aux fourneaux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Haha, quel talent, quel talent... J'aurais une suggestion à vous faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010211,
					"content": "Je vois à vos habits que vous n'êtes pas du coin. Mais puisque vous êtes à Liyue, pourquoi ne pas essayer de cuisiner à la mode locale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010212,
					"content": "Tenez, voici la recette du crabe doré ; c'est l'une des spécialités locales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010213,
					"content": "Il s'agit de crabe fariné, puis frit et sauté avec de l'ail et du gingembre. Le résultat donne un plat qu'on croirait déposé sur une couche d'or.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010214,
					"content": "Du... Du crabe doré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010215,
					"content": "Ça a l'air compliqué.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Du crabe doré, {NICKNAME} ! Du CRABE DORÉ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010218,
					"content": "Ça va, j'ai compris, on parle de crabe doré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Héhé. Bon, allons voir ça de plus près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010221,
					"content": "Vu comme tu te débrouilles en cuisine, ça devrait être une partie de plaisir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010219,
					"content": "... J'imagine que c'est aussi pour toi qu'il faut que je l'apprenne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Apprendre un nouveau plat juste pour Mona, c'est un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Pas vraiment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Haha, quelle modestie. J'aurais une suggestion à vous faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010204,
					"content": "Mon amie aimerait manger un plat préparé par moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
			"id": 1050103,
