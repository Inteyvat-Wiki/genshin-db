				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "Alors ? Je me suis montrée à la hauteur de vos attentes, j'imagine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010502,
					"content": "Tu te débrouilles sacrément bien en combat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Rien de bien compliqué pour une astromancienne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010505,
					"content": "Les mensonges ne servent à rien face à l'astromancie. Le destin et la vérité sont inscrits dans les étoiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010506,
					"content": "Voir tous les détails peut prendre du temps ; mais un coup d'œil suffit pour avoir une idée générale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010507,
					"content": "Pourtant tu as rencontré quelques difficultés en chemin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010508,
					"content": "C'est parce que les étoiles de Teyvat ne permettent de voir que les destins et les vérités de « ce monde ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "#Tout ce qui a trait à toi, {M#voyageur}{F#voyageur}, est un brouillard que même moi suis incapable de pénétrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "C'est la raison pour laquelle je dois trouver la personne qui a succédée à l'amie de mon maître. J'espère que nos savoirs combinés me permettront de voir plus clair dans ta destinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010511,
					"content": "Tu me redonnes espoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "Peu importe. Dans tous les cas, ce voyage te sera bénéfique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "#Bien, nous nous sommes assez {M#reposés}{F#reposées}, vous ne croyez pas ? Direction <color=#00E1FFFF>Mondstadt</color> à présent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010515,
					"content": "*soupir* Ça aurait été mieux avec un chariot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010516,
					"content": "Je croyais que tu n'étais pas fatiguée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010512,
					"content": "Je n'y crois pas trop...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "Impressionnant, comme tu as démasqué ces bandits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
