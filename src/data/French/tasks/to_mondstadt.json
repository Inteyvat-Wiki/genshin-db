			"dialogs": [
				{
					"id": 105011201,
					"content": "Bon, on va tout prendre alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011202
					]
				},
				{
					"id": 105011202,
					"content": "Tout—Tout prendre ? Mais on n'est que trois... Non, deux et demi ! Ça fait bien trop !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011203,
					"content": "C'est pas comme ça qu'on compte ! Et puis en plus, je n'ai pas encore commandé, moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011204,
					"content": "Alors... Une perche-écureuil, du poulet pimenté de Jueyun, une soupe aux perles et au jade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011205,
					"content": "Très bien. Désirez-vous autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011206,
					"content": "J—Je voudrais juste savoir, combien ça va coûter en tout ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011207,
					"content": "Hum, à vue de nez, je dirais 20 000 moras environ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011208,
					"content": "Dans ce cas, hum... Je prendrai juste un bol de nouilles. Sans accompagnement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "Très bien, un bol de nouilles. Si vous voulez bien attendre un moment, nous vous servirons bientôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011210,
					"content": "J'ai réfléchi pendant qu'on mangeait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011211,
					"content": "Pourquoi est-ce qu'elle n'a commandé qu'un simple bol de nouilles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "Est-ce qu'elle... manque d'argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011213,
					"content": "Je t'ai entendue ! C'est moi qui invite ! L'argent n'est pas un problème !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "L'esprit d'un astromancien est entièrement tourné vers l'étude des étoiles. Comment pourrais-je laisser des sujets aussi triviaux que l'argent obscurcir mon jugement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Assouvir des désirs matériels avec les moras est non seulement vulgaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "*bruits d'estomac* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "... C'est aussi dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "Alors ne pas toucher aux plats qu'on a commandés, c'est aussi une histoire de fierté d'astromancienne ? J'y comprends vraiment rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "#Mais ça ne me paraît pas bien qu'on soit les {M#seuls}{F#seules} à se goinfrer, quand même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
					"content": "Laisse-moi te concocter quelque chose dans ce cas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "Oh, mais oui, bien sûr ! Donne-nous deux minutes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
