			"dialogs": [
				{
					"id": 105011101,
					"content": "La soupe de porc aux pousses de bambou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011102
					]
				},
				{
					"id": 105011102,
					"content": "C'est un plat dont raffolent les habitués. Des pousses de bambou cuits avec de la viande dans une soupe aussi parfumée que délicieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011103
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011103,
					"content": "Mettez-en une ou deux cuillerées dans un bol de riz, et vous verrez : vous n'arriverez plus à vous arrêter !",
