			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Merci, ça devrait suffire. Je vais préparer les fleurs séchées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270302,
					"content": "Ah oui, un petit cadeau pour vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270303,
					"content": "Tenez, prenez cette fleur séchée. Elle est un peu fanée, mais c'est une fleur très précieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270304,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "C'est la première fleur qui s'est épanouie sur ce terrain. Et comme c'est vous qui m'avez aidée à trouver des graines, j'aimerais vous offrir cette fleur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270308,
					"content": "Même si elle n'a pas vraiment une grande valeur... Enfin, je vous remercie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270309,
					"content": "#Je suis {M#sûr}{F#sûre} que tout le monde reviendra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "Oui ! Et c'est pourquoi je dois planter plus de fleurs pour qu'ils puissent contempler un magnifique spectacle à leur retour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270305,
					"content": "Est-ce qu'elle est spéciale ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "Bien sûr ! Sinon je ne vous l'aurais pas donnée exprès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		}
	]
