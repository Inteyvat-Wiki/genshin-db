				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "Hmm... Il faudrait quand même que je sorte chercher un peu d'inspiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360102,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "Je suis en train d'aider quelqu'un à trouver quelques lignes qui conviendraient sur une lanterne céleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360104,
					"content": "Tout le monde veut lâcher des lanternes célestes pendant le Festival des lanternes, pas vrai ? Et dessus, on écrit des souhaits, des messages de bonne fortune, etc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360105,
					"content": "Dans l'esprit des célébrations, certains préfèrent que leurs messages soient, hum... comment dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360106,
					"content": "... un peu plus... poétiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360107,
					"content": "Et donc, Bibo, le contremaître Xiao et Degui m'ont demandé d'utiliser mes talents littéraires pour les aider à trouver des tournures plus élégantes pour leurs lanternes célestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360108,
					"content": "Mais en restant cloîtrée ici, les mots ne me viennent pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360109,
					"content": "Je me suis dit qu'il valait mieux préparer d'abord les lanternes, puis aller observer ceux demandant mon aide pour trouver ce qui leur correspondrait mieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360110,
					"content": "Mais... je ne suis pas vraiment douée pour faire des lanternes célestes, en fait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360111,
					"content": "Laissez-moi vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "Vraiment ? Ce serait bien si vous pouviez me préparer trois lanternes célestes, dans ce cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360114,
					"content": "Ensuite, on pourra aller trouver l'inspiration, et voir comment rédiger au mieux ces messages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360115,
					"content": "Héhé, voilà qui commence à prendre forme. Il ne me manque plus qu'un peu d'inspiration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360112,
					"content": "J'ai plutôt le coup de main pour fabriquer des lanternes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
