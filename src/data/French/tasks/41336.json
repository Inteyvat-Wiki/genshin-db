				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "Oh, bonjour Linling. Qu'est-ce qui vous amène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Contremaître Xiao"
				},
				{
					"id": 413360502,
					"content": "#Vous savez, le message que vous m'avez demandé d'écrire. {M#Le voyageur}{F#La voyageuse} et moi, on l'a terminé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "Voilà, je l'ai déjà ajouté sur cette lanterne céleste. Tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Merci. Laissez-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Contremaître Xiao"
				},
				{
					"id": 413360505,
					"content": "« Les jeunes doivent affronter son regard de dragon », « Mais le plus terrifiant reste son sommeil de plomb »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Contremaître Xiao"
				},
				{
					"id": 413360506,
					"content": "« Puissant comme la montagne qui sommeille »... Héhé, pas mal. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Contremaître Xiao"
				},
				{
					"id": 413360507,
					"content": "Mais il n'y a pas de quoi ! J'avais aussi pensé à un autre poème... Je vais vous le réciter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360508,
					"content": "Euh, d'autres personnes nous attendent !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "Oh, vous avez raison... Bon, allons voir Degui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360511,
					"content": "Vous allez voir ! Je suis plutôt fière de ce que j'ai préparé pour Degui. Allons-y et je vous montrerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360509,
					"content": "Il y a encore des lanternes à livrer !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				}
			]
		},
