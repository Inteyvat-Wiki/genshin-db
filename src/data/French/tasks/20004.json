			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "Ah, c'est toi. Ça fait longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040302,
					"content": "#Qu'est-ce qui t'arrive ? Tu as l'air d'être {M#pressé}{F#pressée}. Tu me cherchais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040303,
					"content": "Mona, où étais-tu ces derniers temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040304,
					"content": "On t'a cherchée pendant plusieurs jours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Oh, vous n'avez pas eu de chance. L'Oiseau de vapeur m'a commandé un article il y a quelques jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040306,
					"content": "Il a pour sujet « la relation entre les mouvements astraux et les changements de destins des individus ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040307,
					"content": "J'ai donc été occupée à rédiger mon article. Cela me demande de sortir observer les astres, donc je rentre très tard le soir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040308,
					"content": "Mona se donne beaucoup de mal pour gagner de l'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040309,
					"content": "En fait, il y a un nouveau type de globe céleste qui vient de sortir à Fontaine, et... j'ai déjà payé la caution pour ma précommande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040310,
					"content": "Quand j'aurai touché ma rémunération pour cet article, je pourrai payer le reste, et ce nouveau globe céleste sera à moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040311,
					"content": "Est-ce qu'il va te rester de l'argent pour payer le loyer à Goth ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "Le loyer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040313,
					"content": "Oh ! Je... Il doit me rester un peu d'argent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040314,
					"content": "Donnez-moi une minute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040315,
					"content": "Mona cherche partout dans son porte-monnaie...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "Il y a ça... et il y a ça aussi ! Voilà, ça devrait être suffisant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040317,
					"content": "(Est-ce que Mona vient de vider ses poches...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "S'il vous plaît, donnez cet argent à Goth pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
