			"dialogs": [
				{
					"id": 200040501,
					"content": "Vous êtes de retour. Vous avez remis le loyer à Goth ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040502,
					"content": "C'est bon. On lui a donné.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Parfait. Heureusement, le loyer de cette maison n'est pas particulièrement cher... J'ai péniblement réussi à trouver assez d'argent pour le payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040504,
					"content": "Mais on dirait bien que je vais devoir me contenter de manger de la salade pour les jours qui suivent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
