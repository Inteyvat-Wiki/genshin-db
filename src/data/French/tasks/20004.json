			"dialogs": [
				{
					"id": 200040401,
					"content": "Alors, avez-vous trouvé cette Astr... Enfin, votre amie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040402,
					"content": "Voici le loyer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Bien, le compte est bon. Merci à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040404,
					"content": "Au passage, est-ce que je peux vous demander ce que votre amie fait dans la vie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040405,
					"content": "Elle a l'air plutôt débrouillarde, et pourtant, elle est tout le temps sans le sou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
