				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#Bonjour {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Alors, Tsuyuko. Comment avancent les préparatifs pour récupérer le corail bidule chouette ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Ah, eh bien, le travail est pour ainsi dire... interrompu pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Pas la peine de faire cette tête Tsuyuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "C'est pas en nous regardant comme ça que vous allez nous convaincre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Ah, je vois. Alors, vous aussi, vous avez réalisé la gravité de la situation. Dans ce cas, pas besoin de vous le cacher plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Mais vous n'avez jamais rien caché !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Nous avons bien obtenu la clé des profondeurs baignées de lune, c'est vrai, et Enkanomiya se réveille lentement. Cependant, nous manquons de main-d'œuvre. C'est pourquoi notre investigation prend du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Les circonstances actuelles sont particulièrement éprouvantes, après tout. On ne sait pas encore si les relations avec l'Île de Narukami vont s'apaiser pour de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Vous savez que je n'ai qu'une paire de mains, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Ah, mais c'est un autre problème. Sachez que selon la tradition, seule une personne brave pourra récupérer le corail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Nous devons mettre en place une base et aider cette personne à révéler la voie de nos ancêtres avant d'affronter l'épreuve finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "De cette manière, on devrait mettre toutes les chances de notre côté...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Ou tout du moins, c'était votre plan... Mais tout tombe à l'eau, comme vous n'avez pas assez de monde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "Tout à fait. Sans compter qu'on n'a pas croisé l'ombre de la personne idéale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "Attendez, je vois de qui il s'agit à présent. C'est quelqu'un qui... Oui, quelqu'un aux cheveux blonds !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Hum, cette expédition a l'air bien embêtante. Je n'ai pas envie de me donner autant de mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Ah, mais l'exploration mène généralement à la découverte de trésors, vous savez. Je veux dire, on les confie généralement au Clan Sangonomiya, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Mais si vous trouviez quelque chose, je suppose que je pourrais fermer l'œil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Vous pouvez même fermer les deux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "#Alors, {M#héros}{F#héroïne} au grand cœur, {M#vaillant chevalier}{F#valeureuse guerrière}, parangon de justice, {M#sauveur du monde}{F#âme salvatrice} ! Est-ce que ça veut dire que vous êtes d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Eh bien, comment on pourrait laisser Sangonomiya dans une période de crise pareille ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Merveilleux ! On dirait que les méthodes recommandées par dame Kokomi se sont avérées efficaces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Elle avait même anticipé le fait que vous reviendriez me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "Pardon, qu'est-ce que vous dites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Oh, rien, rien. Veuillez me suivre. Je voudrais vous montrer quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Retrouvons-nous devant l'autel en bas. Si vous ne le voyez pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Si on ne le voit pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Regardez vers le sud-est et plissez les yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Vous savez que dame Kokomi et moi, on s'entend plutôt bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
