			"dialogs": [
				{
					"id": 722330501,
					"content": "#Avez-vous d'autres questions, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "Parlez-moi de Byakuyakoku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Autrefois, Enkanomiya s'appelait Byakuyakoku. Il n'y avait ni soleil ni lune dans ce royaume souterrain, et les deux seuls phénomènes astronomiques étaient la nuit blanche et la nuit sans fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "L'une de mes ancêtres était une prêtresse du nom d'Eboshi. Ça a été un personnage important dans l'histoire de Byakuyakoku, et c'est grâce à elle que je suis en charge du rituel sacré de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
