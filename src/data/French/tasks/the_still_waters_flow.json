			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Ce sont des « sigils-clés » que nos ancêtres utilisaient communément à Enkanomiya. Ils n'apparaissent que quand la voie est sur le point de s'ouvrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Il est dit qu'un second ensemble de clés serait envoyé aux gens de l'Île de Watatsumi au moment du réveil d'Enkanomiya. Nos annales recensent cinq types de sigils-clés en tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "À l'heure actuelle, nous en avons trouvé trois sur l'Île de Watatsumi. En les ramenant à leurs emplacements originels, nous pourrons briser la barrière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Nous avons retiré les trois sigils-clés que nous avons trouvés de leurs emplacements et les avons disposés à d'autres endroits de l'Île de Watatsumi. De cette façon, la barrière peut être restaurée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "L'objectif est d'empêcher les enfants imprudents, les espions des Fatui, les gens de l'Île de Narukami ou encore les étrangers de s'y rendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "Bien évidemment, vous ne faites pas partie des étrangers dont je parle. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "Nous ne sommes pas en mesure d'établir le contact avec la Guilde des aventuriers. Aucun aventurier n'est donc autorisé à descendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Sinon vous les auriez laissés descendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Ces partenariats gagnant-gagnant étaient courants par le passé. Au bout du compte, l'exploration reste le point fort que vous avez en commun avec eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Hé, mais ça veut dire que personne ne pourra nous devancer cette fois, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Paimon, surveille un peu tes manières...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Comment le dire... Je doute que la barrière que nous avons restaurée ait tenu bien longtemps. Un certain temps s'est écoulé depuis notre enquête sur l'emplacement des sigils-clés et leur retrait des serrures, il se peut que des petits malins se soient faufilés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Nous n'avons pas beaucoup de main-d'œuvre, alors... Si vous tombez sur des Fatui, des Pilleurs de trésors, des Oni des mers et autres, n'hésitez pas à leur donner une bonne leçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "S'ils ont pu pénétrer aussi facilement, quel était l'intérêt d'avoir trouvé la clé de machin truc bidule ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Enkanomiya a besoin de la clé des profondeurs baignées de lune pour se réveiller. C'est la seule manière d'ouvrir ses portes et d'activer le système des épreuves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "Si l'on souhaite se rendre à Enkanomiya pour une raison autre que celle d'accomplir le rituel sacré de Watatsumi, il y a peut-être une voie détournée pour y pénétrer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "C'est pour cette raison que je veux que vous agissiez vite. Partez récupérer les sigils-clés restants sur l'Île de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Nous avons placé les sigils-clés à la « nageoire » et au « cœur » de Watatsumi. Quant à leurs deux autels, ils se trouvent à l'endroit où la ligne qui les relie au sanctuaire Sangonomiya croise le deuxième mur de montagne qui entoure les profondeurs baignées de lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Je vais retourner là où j'étais et attendre de vos nouvelles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
