			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "C'est l'heure de briser le sceau. Voici la clé des profondeurs baignées de lune que vous aviez récupérée auparavant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Vous pouvez répéter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "La clé des profondeurs baignées de lune ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Répétez trois fois pour voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Clé des profondeurs baignées de lune, clé des profondeurs baignées de lune, clé des profondeurs de... Aïe ! Je me suis mordu la langue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "C'est un nom bizarre ! Il faudrait le changer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Même si on le changeait aujourd'hui, personne ne le prononcera avant des siècles, alors faites avec pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "Ahem, bref... Je vais préparer la cérémonie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "#Malheureusement, nous n'avons aucune information sur l'épreuve d'Enkanomiya. Vous devrez vous débrouiller {M#seuls}{F#seules} pour l'accomplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "C'est la faute de ces maudites traditions qui cherchent à préserver le mystère. Je vous souhaite bonne chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Et puis, je vous prie de ne pas faire les têtes brûlées. Il faut avant tout que vous rentriez en un seul morceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
