			"dialogs": [
				{
					"id": 200160101,
					"content": "Livraison de repas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "Ah, vous voilà ! Ça tombe bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Je sais que vous devez avoir l'estomac dans les talons, mais j'ai besoin d'un petit service...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "Le nombre de livraisons a augmenté ces derniers temps. En général, je range les plats selon leur destination avant de coller une étiquette avec le nom du client.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Mais voilà, j'en ai perdu une et je ne sais plus du tout qui a commandé cette <color=#00E1FFFF>soupe au lys calla et aux fruits de mer</color>. Ce client se trouve à Deauclaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Pourriez-vous trouver le client qui a commandé cette <color=#00E1FFFF>soupe</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Je pourrais, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Ne vous inquiétez pas, un délicieux repas bien chaud vous attendra à votre retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Je compte sur vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Je suis ici pour manger, moi. Je meurs de faim !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Une fois que vous aurez terminé la livraison, je vous récompenserai avec un de nos plats spéciaux ! Promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
