		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Al",
					"Petit Chou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "Si nous arrivons à récupérer le trésor de la princesse Lyris, la force de la justice ne fera que de se renforcer avec le temps ! Notre victoire sur Narcissus approche à grands pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002502,
					"content": "... Voilà pourquoi nous n'oublierons pas le sacrifice héroïque de Ney. Narcissus aurait probablement envahi la tour où se trouve la princesse s'il n'avait pas caché le trésor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002503,
					"content": "Ney est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002504,
					"content": "#Les efforts de Ney ne seront pas vains, nous ne le permettrons pas ! Tout comme nous serons à la hauteur de la contribution extraordinaire de {NICKNAME} ! Nous réussirons à sauver la princesse Lyris cette fois-ci grâce à votre aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002505,
					"content": "Oui ! Sauvez la princesse Lyris et puis... Et puis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002506,
					"content": "Et puis, le royaume de Narzissenkreuz retrouvera sa gloire passée ! La princesse te prendra dans ses bras, arrangera tes plumes et caressera ta petite tête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002507,
					"content": "Les souvenirs perdus dans les eaux referont surface et tous nous amis entoureront la princesse en riant ! Ce sera une scène pleine d'allégresse qu'aucun désagrément ou dispute ne pourra interrompre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002508,
					"content": "Comme avant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002509,
					"content": "... Oui, comme avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Al"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#C'est vous, {NICKNAME} ! Le trésor de la princesse Lyris sera la clé de notre victoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002602,
					"content": "Nous aurons enfin une chance de vaincre les envahisseurs et de sauver la princesse ! Ainsi, l'Orchestre Jak va jouer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002603,
					"content": "Le dernier mouvement de l'ouverture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002604,
					"content": "Sérieusement ? On n'en est encore qu'à l'ouverture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "Oh ? Vous croyiez vraiment que tout se terminerait après le sauvetage de mademoiselle Lyris et la reconstruction du royaume ? Que nenni ! Nous ne sommes pas dans un conte de fées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002607,
					"content": "C'est exactement parce que le monde est rempli de naïfs qui pensent comme vous que l'histoire se répète toujours ! La prochaine étape consiste à renverser le système de classes profondément enraciné dans la société et les méthodes de distribution des richesses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002608,
					"content": "L'histoire ne peut se terminer qu'une fois que nous aurons un monde juste et équitable. L'équité représente l'état naturel et raisonné des choses, c'est certainement l'idéal auquel mademoiselle Lyris aspire. Maintenant, la raison pour laquelle ce lien existe s'explique par des éléments du contexte actuel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002609,
					"content": "Je vous laisse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "D'abord, selon... construire... renverser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002605,
					"content": "Je pensais qu'on était plus loin que ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
