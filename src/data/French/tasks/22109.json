			"dialogs": [
				{
					"id": 221090301,
					"content": "La mission est terminée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Bien joué. Les Brutocollinus ne vous ont pas posé trop de problèmes, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "Toujours pas d'indice sur l'épée ? Je m'y attendais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "Bien, voici votre récompense. Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "Pourquoi tenez-vous tant à trouver cette épée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "J'imagine que vous avez le droit de savoir. Cette épée appartenait à mon frère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "mais il ne l'avait pas sur lui lorsqu'il est mort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Je ne comprends toujours pas pourquoi. Mon frère ne s'en séparait jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Ce qui lui est arrivé reste un mystère et l'épée s'est aussi volatilisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "Voilà, c'est tout. Prenez cette récompense et filez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
