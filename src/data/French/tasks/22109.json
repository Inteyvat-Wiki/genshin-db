				{
					"id": 221090201,
					"content": "La mission est terminée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090202,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "#Vous êtes trop {M#prudent}{F#prudente}... ou tout simplement {M#lent}{F#lente} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090204,
					"content": "Peut-être même les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
