					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "Toujours rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "Ah, c'est vous. Les quêtes sont tellement faciles ces derniers temps que ça en est déprimant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "J'ai une nouvelle mission pour vous, ça vous dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "Des voyageurs nous ont signalé que des Arbalétriers Brutocollinus des Plaines Guili les empêchaient de passer avec leurs flèches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Ils ne sont pas futés, mais leur grand nombre et leur position en haute altitude en font des ennemis coriaces pour l'aventurier lambda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "C'est là que vous entrez en scène pour les éliminer et je vous recompenserai généreusement pour votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Comme la dernière fois, si vous trouvez des indices en rapport avec une certaine épée, je vous prie de m'en faire part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "#Hé ben ! Vous avez accepté sans vous poser de question. C'est beau d'être aussi jeune et {M#courageux}{F#courageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "#Vous êtes aussi {M#un aventurier}{F#une aventurière} après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Trêve de bavardages, préparez-vous à y aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "Les Brutocollinus ont-ils un lien avec l'épée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Non, aucun. Gardez juste vos yeux grands ouverts au cas où. Tant mieux si vous trouvez, tant pis sinon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "L'objectif de la mission est d'éliminer ces Brutocollinus, après tout. C'est celui-ci qui fera l'objet d'une récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
