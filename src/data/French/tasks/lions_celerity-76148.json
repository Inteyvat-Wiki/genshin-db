			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Nous revoilà ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "La dernière fois que je suis venu, à l'échelle d'une vie humaine, cela doit remonter à il y a... beaucoup, beaucoup, beaucoup de générations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "On dirait que nous sommes à nouveau dans l'Intervalle apathique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "#Comment sommes-nous censés en sortir{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "La méthode habituelle consiste à méditer, apprendre à maîtriser son esprit et ses pensées, puis se libérer de tout désir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "En résumé, nous devons maintenir un état de vide absolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "C'est simple à dire, mais selon la nature d'une personne et l'intensité de ses désirs, cela peut prendre de quelques années à plusieurs siècles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Pour quelqu'un comme vous, qui porte le destin du monde sur ses épaules, vos désirs ne peuvent probablement pas être mis de côté... et ils ne devraient pas l'être.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "#Qu'est-ce qu'on doit faire{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Retrouvons Zeitlind et on verra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "Qu'est-ce que tu as récupéré ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Attendez, Dex est là aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "Dans ce cas, il y a une possibilité d'améliorer la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Comme Dex est également un veilleur, il pourrait utiliser le pouvoir contenu dans ces fragments pour forcer l'ouverture d'un passage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "On va devoir leur donner un nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "J'ai entendu parler de ces cercueils sophistiqués. Ils ont été créés par l'une des sœurs de la maîtresse du temple... Je crois que ce sont des « cercueils de maranasati ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "Dans ce cas, appelons-les « fragments de nécromuse ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
