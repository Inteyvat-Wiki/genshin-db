			"dialogs": [
				{
					"id": 761480101,
					"content": "#Argh{NON_BREAK_SPACE}! Où étiez-vous{NON_BREAK_SPACE}? J'ai failli avoir une crise cardiaque{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480102,
					"content": "#Je n'arrêtais pas de vous appeler{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480103,
					"content": "#Hmm{NON_BREAK_SPACE}? Pourquoi Paimon n'a-t-elle pas été entraînée dans l'Intervalle apathique{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480104,
					"content": "Eh bien... Peut-être parce qu'à part manger et dormir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "#Elle ne réfléchit pas vraiment à grand-chose{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Hmm. Ça se tient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480107,
					"content": "On dirait que Melanta est vraiment en colère maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480108,
					"content": "#Il est devenu urgent d'envoyer {NICKNAME} pour l'affronter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480109,
					"content": "Allons discuter ailleurs. Cet endroit n'est plus vraiment sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480110,
					"content": "Euh, bon, je sais que personne ne me l'a demandé, mais... Bonjour à tous. Je m'appelle Alara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alara"
				}
			]
		},
