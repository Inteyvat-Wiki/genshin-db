			"dialogs": [
				{
					"id": 761160101,
					"content": "#Mais voilà nos {M#bons amis, et ceux}{F#bonnes amies, et celles} de Bobik aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Qu'allez-vous faire tous les deux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Nous allons rester ici un moment. La porte du laboratoire de Drzislav a été forcée, nous devons rester dans les parages pour empêcher que ces méchants n'entrent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Une fois que nous aurons réparé la porte ou que Slava sera revenu, nous allons faire comme vous et partir à l'aventure avec Bobik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "À propos de Drzislav...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Je n'ai aucune idée d'où il se trouve... Mais si vous le croisez pendant votre voyage, dites-lui bonjour de notre part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "J'adorerais boire à nouveau avec lui toute la nuit au Navire amiral !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "À propos de Bobik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Oh, il vous manque déjà ? Ne vous inquiétez pas, vous pouvez revenir quand vous voulez pour jouer avec lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "#Je suis sûre qu'on se reverra. Nous sommes de {M#vrais amis}{F#vraies amies} qui ont traversé des épreuves ensemble après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
	]
