				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "J'espère que les Statues des Sept se portent bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380102,
					"content": "Pourquoi elles n'iraient pas bien ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Hum, je priais souvent par le passé et il m'arrivait de dépoussiérer un peu ces statues toutes les semaines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380104,
					"content": "C'était ma façon de remercier les Archons pour tout ce qu'ils m'avaient offert dans la vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380105,
					"content": "Mais depuis que Lili est née, je n'ai plus trop le temps pour le faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380106,
					"content": "Les statues doivent être vraiment sales si personne ne prend soin de les laver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380107,
					"content": "Je ne voulais pas vous imposer cette responsabilité, mais pouvez-vous dépoussiérer ces statues pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380109,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Merci beaucoup ! Que Barbatos vous bénisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380115,
					"content": "Je voulais aussi vous préciser une chose. Les statues ont été bénies par les pouvoirs élémentaires des Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380116,
					"content": "La poussière qui s'y accumule ne peut pas être enlevée d'un simple coup de plumeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380117,
					"content": "Vous possédez des pouvoirs élémentaires, alors ça devrait être facile pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380118,
					"content": "Contrairement à moi, qui doit prendre une journée entière pour nettoyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380110,
					"content": "Le vent a sûrement enlevé toute la poussière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Le vent a autre chose à faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380113,
					"content": "On ne peut pas tout le temps compter sur les Archons pour tout. Nous avons aussi notre part des choses à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Gillianna"
				},
				{
					"id": 200380114,
					"content": "Travaillons ensemble pour faciliter le travail de Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Gillianna"
				}
			]
		},
