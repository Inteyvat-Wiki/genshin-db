			"dialogs": [
				{
					"id": 790480101,
					"content": "On dirait des feuilles de papier, serait-ce les notes de quelqu'un ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480102
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790480102,
					"content": "Vu le vocabulaire utilisé, on dirait le journal d'un peintre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480103,
						790480104
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790480103,
					"content": "Très sûr de lui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790480105
					]
				},
				{
					"id": 790480105,
					"content": "Mais je peux comprendre. Sans une telle confiance, quoi qu'on fasse, nos compétences ne s'amélioreront pas rapidement, si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480106
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790480106,
					"content": "Mais il n'y a pas grand-chose dans ce journal, je me demande ce qui lui est arrivé après...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480107
					],
					"speakerTitle": "Lecture"
				},
				{
					"id": 790480107,
					"content": "#On va peut-être trouver le reste du journal quelque part. Restons à l'affût, d'accord, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
