			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "Ouah, quelque chose en est sorti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "Vive la pierre à... Attendez une seconde, vous les avez posées dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "... Haha, est-ce que j'ai l'air de pouvoir faire quelque chose d'aussi stupide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "Grâce aux pierres que vous avez apportées, la pierre à trésors est encore plus énergique qu'avant. Oh, vous l'entendez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Ce son, qui pulse comme le magma qui coule sous la terre, ressemble à... un battement de cœur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Je le savais... Je savais que je devais trouver d'autres pierres pour la nourrir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Je n'entends rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#Tu entends, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "C'est une vieille pierre quoi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "C'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "#Héhé, {M#étrangers}{F#étrangères}... Ou devrais-je dire, honorables {M#invités venus}{F#invitées venues} de loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Si vous le pouvez, trouvez-moi d'autres pierres... Plus belles, meilleures... Le pouvoir de la pierre à trésors ne vous décevra pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910315,
					"content": "Je le sens au plus profond de moi... Je peux dire que ce sera bon pour elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910316,
					"content": "Pourquoi j'ai l'impression qu'on s'enfonce dans un piège...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910317,
					"content": "#Qu'en penses-tu, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910318,
					"content": "Tant qu'on peut avoir de meilleures pierres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Ça vaut la peine d'essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910320,
					"content": "Héhé, super ! Cette fois-ci, vous choisirez des pierres encore meilleures que les précédentes pour me les donner... Avec elles, la pierre à trésors deviendra plus puissante que jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910311,
					"content": "Tu n'entends rien, Paimon ? Elle hurle !",
