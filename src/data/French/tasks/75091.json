					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "Regarde, elle l'a refait et les pierres sont meilleures que celles de toute à l'heure... Ça reste magique, même si on l'a vu deux fois maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "#Haha, {M#étrangers méfiants}{F#étrangères méfiantes}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Maintenant que vous l'avez vue de vos propres yeux, vous ne pouvez plus nier la grandeur de la pierre à trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Grâce aux pierres que vous avez apportées, son pouvoir s'est encore renforcé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Qui sait à quel point elle pourrait devenir puissante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Maintenant que vous le dites, je commence à me poser la question aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Tout ce qu'on doit faire, c'est de lui donner des pierres et elle en créera de meilleures pour nous en retour... Mais comment ça marche ? Et si on l'ouvrait pour voir ce qu'il y a à l'intérieur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "Comment pouvez-vous suggérer ça ? Je ne le permettrai pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Si vous voulez le faire, il faudra me passer sur le corps d'abord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Hum, je disais ça comme ça, vous savez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Hmph, comme vous m'avez apporté toutes ces pierres, je vais laisser couler... Juste pour cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "D'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Je le sens, héhé ! Si je peux nourrir la pierre à trésors avec des pierres de plus grande qualité, je suis sûr qu'elle produira quelque chose d'incroyable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "#{M#Voyageur venu de loin}{F#Voyageuse venue de loin}, un marchand étranger m'a un jour parlé d'une pierre spéciale du désert qui possède un pouvoir extraordinaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Son nom... Oui, ça s'appelle de la trishiraite. Si vous pouviez me l'apporter pour que je puisse la donner à la pierre à trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Je suis certain que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Qu'en penses-tu, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "Essayons !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Je suis curieuse de voir ce qui va se passer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "Si vous arrivez à mettre la main sur de la trishiraite... Un seul morceau devrait suffire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
