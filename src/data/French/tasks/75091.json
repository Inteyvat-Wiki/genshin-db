			"dialogs": [
				{
					"id": 750910401,
					"content": "Mmm... Il faut faire preuve de patience. Lorsque les choses se seront calmées, je les donnerai à la pierre à trésors... Héhé, merci de m'avoir ramené tout ça...",
					"roleType": "TALK_ROLE_NPC",
