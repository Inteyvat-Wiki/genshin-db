			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910201,
					"content": "Mmm... Il faut faire preuve de patience. Lorsque les choses se seront calmées, je les donnerai à la pierre à trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Il suffit de lui donner un peu de temps, et elle produira des pierres encore plus belles... Héhé... Une, deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
		{
			"id": 7509103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
