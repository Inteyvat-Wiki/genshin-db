			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Une, deux... Hmm, trois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Hmm, hmm... Une, deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Paimon, il y a des gens bizarres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "#C'est vous les seules personnes bizarres que je vois ici... Hoho, on ne s'attendrait pas à voir des {M#étrangers}{F#étrangères} dans ce coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "On est dans... un lieu interdit ? Un lieu sacré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "#Non, c'est juste un endroit que j'ai découvert, complètement par hasard... un endroit où se trouve un trésor enterré. Approchez {M#tous}{F#toutes} les deux. Vous entendez ? Cette pierre très spéciale devant vous... C'est... la « pierre à trésors »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "Le petit bruit que ça fait quand elle monte et qu'elle descend, c'est presque comme un bruit de respiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "C'est « dur » d'être une pierre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Ce n'est qu'une respiration... Qu'est-ce qu'il y a de si dur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Une pierre... peut respirer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "Oui, et pas que... Si l'on y tend bien l'oreille, on peut aussi entendre un rythme... Et même le son de la roche qui se frotte contre la roche sous sa surface rugueuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Haha, quels merveilleux sons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "Et puis... si vous lui donnez des petites pierres, elle vous donnera d'autres pierres encore plus belles et plus brillantes en retour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Ah, c'est tout simplement incroyable, vous ne trouvez pas ? Regardez ces pierres précieuses... Regardez ! Une, deux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Oh, vous comptiez les pierres précieuses tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Oui, et je peux dire qu'après avoir englouti toutes ces pierres, la pierre-trésor est devenue encore plus forte, encore plus puissante qu'avant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "C'est sans doute... un miracle ! Ah, ma pierre à trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "C'est suspect ce que vous nous dites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "#Haha... Je ne m'attendais pas à ce que des {M#étrangers}{F#étrangères} me croient. Personne ne me croirait... Avant de le voir de ses propres yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Je l'ai moi-même découvert par hasard en plaçant du minerai que j'avais collecté sur le bord de la pierre à trésors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "D'ailleurs... Pourquoi n'essayeriez-vous pas ? Voir, c'est croire, après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Elle a déjà mangé toutes les pierres du coin. Il faut que je lui en trouve d'autres... Mais je ne peux pas aller les chercher moi-même...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "Et pourquoi pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "Quelqu'un doit rester ici pour s'occuper de la pierre à trésors, non ? Pouvez-vous imaginer ce qui se passerait si elle se cachait sous terre pendant mon absence ? Que ferais-je ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Ça fait si longtemps que je monte la garde ici... Je lui ai donné toutes les pierres que j'avais sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "Trouvez-m'en d'autres, et je vous prouverai que je ne raconte pas de mensonges. Je la nourrirai devant vos yeux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Hmm, on dirait le discours classique d'un escroc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#Qu'en penses-tu, {NICKNAME} ? On essaye ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Ce ne sont que des cailloux de toute façon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "D'accord ! Ramassez des pierres et donnez-les moi pour je nourrisse la pierre à trésors... Je vous garantis qu'elle en sortira des meilleures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "Vraiment ? Vous n'est pas en train de nous mentir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "#Je suis {M#bon}{F#bonne} en respiration aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Oui, qu'y a-t-il de si extraordinaire ? ... Attendez, mais pourquoi est-ce qu'on parle de ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
