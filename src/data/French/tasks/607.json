			"dialogs": [
				{
					"id": 6070201,
					"content": "N'ayez crainte. Ces monstres répugnants sont passés de vie à trépas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "Mademoiselle veut dire que vous devriez éviter d'aller à l'extérieur pour le moment. Nous continuerons à défendre cette zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "Merci ! Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070204,
					"content": "Mais... Hum, je n'ai jamais vu un oiseau parlant de ma vie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070205,
					"content": "Ne vous en faites pas. Je suis l'humble serviteur de ma maîtresse, et je ne représente aucun danger pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "Vous pouvez leur faire confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Ah, bien sûr... Ce n'est pas ce que j'insinuais ! Désolé, je me suis mal exprimé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070208,
					"content": "Hmph, ce n'est rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "#Vous avez d'autres affaires à régler, {M#cher vassal}{F#chère vassale} ? Courez, volez ! Éliminez le mal, votre princesse illuminera votre chemin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
			]
