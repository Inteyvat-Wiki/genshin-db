			"dialogs": [
				{
					"id": 750700701,
					"content": "Haha ! Je savais que nos chemins allaient se croiser à nouveau ! Vous tombez à pic : vous êtes sur le point d'assister à mon deuxième chef-d'œuvre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700702,
					"content": "Hmm... Peut-être pas le deuxième. J'ai beaucoup d'œuvres de qualité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700703,
					"content": "Bref, vous avez de la chance, car vous allez me voir essayer la photographie dynamique pour la première fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700704,
					"content": "Je prenais autrefois des photos de victimes sur des scènes de crime, alors... Euh, peu importe. Pas besoin d'entrer dans les détails...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700705,
					"content": "Avez-vous encore besoin de notre aide cette fois-ci, monsieur Magnifico ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700706,
					"content": "Yaa ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "Non... Hmm. Enfin, ce serait bien si ça ne vous dérange pas ! Venez, je vais vous expliquer la situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700708,
					"content": "Voilà, en gros. Je dois prendre des photos d'un qucusaure qui plonge dans l'eau de cette cascade. Il faut capturer l'image la plus percutante, juste au moment où il entre en contact avec la surface !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700709,
					"content": "J'ai caché de la nourriture susceptible d'attirer les qucusaures dans l'étang situé sous la cascade. C'est juste que... *soupir* Ils n'ont pas encore plongé dans le bon angle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700710,
					"content": "Hmm ? Attendez un peu. Quel est ce grand cercle au-dessus de l'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700711,
					"content": "Ne vous inquiétez pas, même si je ne sais pas trop de quoi il s'agit... C'est juste de la ferraille que j'ai ramassée dans une tribu voisine pour m'en servir comme cible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700712,
					"content": "*soupir* Toutes les photos ratées que j'ai prises jusqu'à présent sont tellement banales que c'en est agaçant. Je pourrais continuer d'attendre, mais puisque vous êtes là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700713,
					"content": "#Peut-être pourriez-vous... Euh, les guider ? Leur montrer comment faire un magnifique plongeon ? Vous êtes {M#un maître-dompteur de sauriens}{F#une maîtresse-dompteuse de sauriens réputée} dans tout Natlan, après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700714,
					"content": "D'accord ? Super ! Je vous ferai signe d'ici. Je vais compter et quand j'arrive à un, il faut que vous soyez à l'emplacement précis de la cible au bord de l'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700715,
					"content": "On peut essayer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "Dans ce cas, allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700717,
					"content": "On ne sait pas si ça fonctionnera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "Ce n'est pas grave. Si on échoue, on aura seulement perdu notre temps et rien de plus. Celui de voyageurs comme nous ne vaut pas grand-chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700719,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
