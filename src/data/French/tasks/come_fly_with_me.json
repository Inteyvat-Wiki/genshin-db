			"dialogs": [
				{
					"id": 750701601,
					"content": "*soupir* Comme vous pouvez le voir, les résultats laissent à désirer... J'ai tout raté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701602,
					"content": "Ah... Ma famille m'a toujours dit que même les petits arbres peuvent projeter de grandes ombres... Mais c'est n'importe quoi ! Ils voulaient juste m'humilier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701603
					],
