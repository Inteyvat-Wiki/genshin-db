			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha, parfait ! Tenez, votre exemplaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Ouah ! Mais c'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Voici votre récompense. C'est la deuxième... Non, la troisième fois que vous m'aidez. Sans vous... Je ne pense pas être en mesure d'aller au bout de ce voyage photographique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "Voici ma destination. Je l'ai indiquée sur votre carte. Encore une fois, je me réjouis de travailler avec vous si ça vous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Ah ! Il est temps. J'y vais ! À bientôt et bonne chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico termine de ranger ses affaires et saute joyeusement dans son ballon.\\nUne fois qu'il est hors de vue, le rire bruyant de son propriétaire n'est plus qu'un écho lointain...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
