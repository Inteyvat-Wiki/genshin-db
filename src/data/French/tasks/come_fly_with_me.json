					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Prenons une pause d'abord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "C'est vrai. Ça demande beaucoup d'énergie de sauter d'une falaise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "#Ah... Désolé, je n'y avais pas pensé. Commencez dès que vous êtes {M#prêts}{F#prêtes}. Je vous attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
