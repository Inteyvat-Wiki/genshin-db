			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "C'est bizarre... Qu'est-ce qui ne va pas avec ce Daguerréotype ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010102,
					"content": "Qu'est-ce qu'il a votre appareil ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "On dirait qu'il est cassé... Quelque chose cloche en tout cas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010104,
					"content": "J'en ai commandé une cargaison de Fontaine, il y a quelque temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010105,
					"content": "Celui qui me les a vendus m'a affirmé que ce type de machine disposait de la toute dernière technologie de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010106,
					"content": "Comme quoi il serait possible d'imprimer des clichés dans une teinte spéciale et d'ajouter des effets, quelque chose dans ce genre. Alors j'en ai acheté un pour essayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010107,
					"content": "Résultat, je n'arrive pas à imprimer normalement... Je ne sais pas si c'est moi qui m'y prends mal, ou si c'est l'appareil qui est défectueux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010108,
					"content": "Peut-être qu'il y a un truc que je ne comprends pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010109,
					"content": "Et sinon, vous vous y connaissez en Daguerréotype ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010110,
					"content": "Un peu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "C'est déjà plus que moi ! Est-ce que vous pouvez m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010114,
					"content": "#Vous m'avez tout l'air d'{M#un voyageur}{F#une voyageuse}, je me trompe ? Vous devez avoir de l'expérience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010115,
					"content": "J'aimerais que vous utilisiez ce Daguerréotype pour prendre des clichés de choses de couleurs spécifiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010116,
					"content": "Revenez ensuite me les montrer, je pourrai peut-être trouver ce qui ne va pas avec l'appareil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010117,
					"content": "Et si je n'y arrive pas, j'amène les clichés au vendeur pour voir ce qu'il a à dire. Il ne pourra pas nier le problème preuves à l'appui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010118,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010120,
					"content": "Qu'est-ce que vous entendez par couleurs spécifiques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Vous savez... Des couleurs distinctes comme le rouge des piments de Jueyun, ou encore le bleu des fleurs de brume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010122,
					"content": "Quand vous aurez pris de bonnes photos, amenez-les-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010112,
					"content": "Pas le moins du monde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Oh... Peu importe, c'est assez simple à utiliser... Est-ce que vous pouvez quand même m'aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Jitong"
				}
			]
		}
	]
}