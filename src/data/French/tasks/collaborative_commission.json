			"dialogs": [
				{
					"id": 761290101,
					"content": "Dame Nefer et mademoiselle Jahoda, merci encore pour toute l'aide que vous avez apportée à la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 761290102,
					"content": "Pas besoin d'être aussi formelle. Après tout, il s'agit d'une véritable collaboration entre nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "C'est vrai, mais je tiens quand même à vous remercier d'avoir accepté d'aider la Guilde lors de ce... travail d'enquête complexe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "La Guilde des aventuriers a également envoyé plusieurs personnes pour nous aider dans notre travail. Nous œuvrons tous ensemble vers le même objectif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "J'espère que nos futures collaborations seront tout aussi agréables, monsieur Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Nefer, soyez rassurée que la Guilde des aventuriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Oh, je tiens à être clair sur ce point. Vous pouvez avoir une confiance absolue en la Guilde des aventuriers de Nod-Krai. Nous y sommes vos partenaires les plus fiables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Héhé, c'est très clair, en effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Bien, bien... Continuez à parler comme ça, patronne. Très chère patronne, ne me regardez pas, je vous en prie... Ne me regardez pas, ne me regardez surtout pas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, pourquoi es-tu si silencieuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(Oh non, elle m'a regardée ! Tant pis, mais ne regardez surtout pas le panneau des missions, par pitié...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Hein ? M—Moi ? Euh, c'est parce que je n'ai rien à dire ! Euh... Merci pour... la mission...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Oh, nous devrions aussi vous remercier pour votre aide, mademoiselle Jahoda. Sans vous, la paperasse à la Guilde se serait déjà accumulée jusqu'à former une montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Pas besoin de me remercier... Je suis payée, je dois donc bien sûr faire mon travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*soupir* On dirait qu'elle a encore oublié tout ce que je lui ai appris...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "D'ailleurs, puisqu'on est tous là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "#(Non ! L'atmosphère était si bonne ambiance, patronne{NON_BREAK_SPACE}! Pitié, laissez-moi souffler un peu{NON_BREAK_SPACE}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Monsieur Sarin, pourriez-vous nous apporter le dernier lot de missions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, choisis la mission qui te semble la plus importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Réfléchis-y bien et prends ton temps, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "D'accord patronne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Argh ! Je suis fichue !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
