			"dialogs": [
				{
					"id": 742530101,
					"content": "Pour être honnête, je suis encore très surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530102,
					"content": "Vous savez, à l'époque, Alain et moi pensions tous les deux que vous n'étiez plus de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530103,
					"content": "Hmm... Si nous nous étions réveillées plus tôt, peut-être aurions-nous pu vous rendre visite, à Alain et à vous. Mais... C'est le destin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Mademoiselle Mary-Ann...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "Le destin agit de manière mystérieuse. Qui aurait pensé qu'Ann et moi tomberions sur une affiche de film à votre effigie pendant nos voyages ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "C'est donc ça qui vous a donné l'idée de me contacter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530107,
					"content": "Précisément !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah... Le parfum du café, cela me rend vraiment nostalgique... Héhé, merci de nous avoir invitées à prendre le thé avec vous, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "Votre jardin est si élégamment aménagé. Parfaitement digne de votre grâce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "C'est la maison qu'Alain et moi partagions autrefois. Je trouve normal d'en préserver la beauté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530111,
					"content": "Vous voyez, vous vous débrouillez déjà bien mieux que mon frère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain n'a jamais même décoré sa chambre. Il ne savait pas gérer les jolies choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "C'est vrai, et René n'était pas différent. Jakob et moi étions les seuls à pouvoir correctement décorer une pièce et préparer le thé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Il était donc déjà comme ça quand il était petit ? J'ai toujours cru que c'était à cause de son âge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530115,
					"content": "Il a toujours été comme ça. Il était peut-être doué pour les études, mais un peu maladroit dans d'autres domaines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "C'est peut-être pour ça qu'il a été le seul d'entre nous à choisir la dure réalité plutôt que l'illusion d'un doux rêve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Je ne pense pas qu'il ait regretté ce choix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530118,
					"content": "Non, car c'était son souhait en tant que héros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "C'est nous qui avons des regrets. Son souhait n'aurait jamais dû rester isolé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "Et vous, mademoiselle Sandrone ? Y a-t-il quelque chose que vous souhaitez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Alain m'a posé exactement la même question un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530122,
					"content": "Hmm ? Lui aussi a posé cette question ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "On dirait qu'il avait vraiment fini par grandir. Avant, il n'aurait jamais dit ce genre de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "« Souhait », c'est un mot bien creux. Peut-on vraiment avoir tout ce que l'on veut ? Ah, si c'était le cas, il n'y aurait pas de malheur dans le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530125,
					"content": "Je fais ce que j'ai envie de faire, ce que je pense juste. Je ne sais pas si cela peut être considéré comme un souhait, mais cela me rend heureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530126,
					"content": "Hmm, c'est une chose merveilleuse. Je vous envie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Est-ce que vous... en voulez à Alain ? Parce qu'il vous a créée à l'image de Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Jamais. Il m'a toujours dit que j'étais ma propre personne, que j'étais unique et que je devais choisir ma propre vie. C'est exactement ce que j'ai fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530129,
					"content": "Haha, que ce soit pour les histoires ou pour le thé, tant que vos choix vous conviennent, ce sont les bons, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Exactement. Alors maintenant, profitons tranquillement de ces douceurs que vous avez préparées avec tant de soin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
