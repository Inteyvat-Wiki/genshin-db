			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "J'espère que ce gamin n'a quand même pas été capturé par les Brutocollinus pour finir dans leur ragoût...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Qui s'est fait capturer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Là-bas, regardez. Vous voyez ce camp de Brutocollinus sur l'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "C'est comme s'ils étaient apparus de nulle part du jour au lendemain. Ils travaillent dur et ne prennent jamais de repos quand il faut. *soupir* Exactement comme Balent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Avec un peu de chance, il n'a pas encore fini dans la marmite. Si ça se trouve, il est en pleine conversation avec ces Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Hein ? Vous voulez dire que vous connaissez quelqu'un qui s'est fait capturer par les Brutocollinus ? Mais comment pouvez-vous rester aussi calme ? Si c'est vrai, il faut aller rapidement à sa rescousse !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Aller à la rescousse de qui ? Je lui ai déjà dit il y a longtemps que ça ne servait à rien de risquer sa vie pour des tâches dangereuses, qu'il fallait simplement signaler ça à Estienne et le laisser s'occuper de trouver de l'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "J'ai eu la gentillesse de lui dispenser des enseignements, mais ce gamin ingrat m'a accusé de ne pas faire mon travail sérieusement et de négliger mes responsabilités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Étant donné qu'il ne prend pas en considération l'expérience et la sagesse de ses aînés, il ne peut que se blâmer s'il lui arrive quelque chose. Les jeunes doivent faire face à des difficultés pour grandir. Sans ça, ils ne pourraient pas apprendre de leurs erreurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "C'est compliqué de porter un jugement en n'écoutant qu'un seul point de vue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Oui, il faut vite aller le sauver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "#C'est très dangereux ! Comment vous allez faire si vous êtes {M#blessés}{F#blessées}, les jeunes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Ne vous en faites pas, {NICKNAME} est très {M#fort}{F#forte}. Attendez-nous ici, ça va être vite fait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Comment peut-on grandir et apprendre de ses erreurs si on perd la vie ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Quel genre de ragoût ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Ce n'est pas la priorité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
