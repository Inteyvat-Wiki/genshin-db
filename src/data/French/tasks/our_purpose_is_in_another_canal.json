			},
			"dialogs": [
				{
					"id": 740910401,
					"content": "#Vous êtes vraiment {M#gentils}{F#gentilles}... Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910402,
					"content": "Comment vous sentez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910403,
					"content": "Ça... Ça va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910404,
					"content": "Vous avez l'air mal en point.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "P—Pouvez-vous m'emmener jusqu'au quai là-bas ? Je... Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910406,
					"content": "Ne vous forcez pas à parler, on vous y emmène !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
