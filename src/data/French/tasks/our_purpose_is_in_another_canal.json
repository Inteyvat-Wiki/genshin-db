				]
			},
			"dialogs": [
				{
					"id": 740910501,
					"content": "Monsieur Aigouy, je... Je suis de retour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910502
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910502,
					"content": "Vous... Vous avez sauvé Balent. Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910503
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910503,
					"content": "Espèce de sale gosse... Je t'ai déjà dit qu'il ne fallait pas risquer ta vie en faisant des choses dangereuses. S'il y a un problème, parles-en à Estienne. Il se chargera de trouver quelqu'un pour s'en occuper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910504
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910504,
					"content": "Je t'ai enseigné des choses de bon cœur, mais en retour, tu as osé m'accuser de ne pas faire mon travail sérieusement et de négliger mes responsabilités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910505
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910505,
					"content": "Je t'avais bien prévenu, non ? C'était beaucoup trop risqué, et tu n'avais pas les épaules pour ça. Tu as douté de moi, alors j'espère que ça t'a servi de leçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910506
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910506,
					"content": "Je... Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910507
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910507,
					"content": "Quoi, tu veux encore faire le malin ? J'ai bien envie de savoir ce que tu as encore à dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910508
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910508,
					"content": "J'ai soif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910509
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910509,
					"content": "Balent boit quelques gorgées d'une bouteille d'eau avant de mordre dans un morceau de pain sec...\\nIl ne pense qu'à boire et à manger, quoi que le vieil homme dise.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740910510
					]
				},
				{
					"id": 740910510,
					"content": "Pfiou... J'ai survécu au moins. C'est grâce à vous deux, merci. Sans vous, je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910511
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910511,
					"content": "Tes parents n'auraient rien eu excepté une allocation décès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910512
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910512,
					"content": "Hmph, c'est toujours mieux que d'avoir été renvoyé pour négligence professionnelle après avoir causé un incident de sécurité gravissime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910513
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910513,
					"content": "Espèce de... *soupir* Tu ne comprendras donc jamais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910514
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910514,
					"content": "Même si ça peut sembler un peu effronté de ma part... J'ai un service à vous demander pour le bien de tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910515
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910515,
					"content": "Est-ce que vous savez plonger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910516
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910516,
					"content": "Oui, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910517,
					"content": "Lorsque j'ai été capturé par les Brutocollinus, j'ai perdu ma combinaison de plongée. Lors d'une vérification de routine, j'avais découvert que les équipements de secours étaient endommagés. J'en ai demandé des nouveaux, mais ils ne sont pas encore arrivés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910518
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910518,
					"content": "Il ne faut surtout pas négliger l'entretien des tuyaux. Si vous avez des compétences en plongée, pourriez-vous aller vérifier les tuyaux de la Forteresse de Méropide à ma place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910519
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910519,
					"content": "Bien sûr, je vous offrirai la récompense à la hauteur de vos attentes. Vous avez ma parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910520
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910520,
					"content": "#Comme ça concerne la sécurité de tout le monde, nous sommes {M#disposés}{F#disposées} à vous aider. Mais la vérification des tuyaux semble être un travail à confier à des professionnels, est-ce que c'est raisonnable de nous laisser faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910521,
					"content": "C'est juste une inspection de routine, mais je pense qu'il pourrait y avoir quelques petits problèmes. Lors de la dernière inspection, nous avons trouvé quatre zones à risque... Mais cela ne devrait pas être trop difficile à résoudre, je vais vous expliquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910522
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910522,
					"content": "Si vous constatez une <color=#00E1FFFF>fuite de gaz</color> dans les tuyaux sous-marins, elles ont été causées soit par des créatures sous-marines... soit par des collisions avec des objets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910523
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910523,
					"content": "L'intervention d'urgence consiste à <color=#00E1FFFF>réguler le flux en utilisant la valve de régulation pour stopper temporairement la fuite de gaz</color>. C'est tout ce que vous avez à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910527
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910527,
					"content": "Réguler une valve demande de la dextérité. <color=#00E1FFFF>Lorsque vous tournez le volant de la valve, surveillez le débit de gaz. Si le débit diminue, c'est que vous êtes sur la bonne voie</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910524
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910524,
					"content": "D'accord... Je crois que j'ai compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910525,
					"content": "Si vous avez des incertitudes, n'hésitez pas à me poser des questions à tout moment avant que l'inspection de routine ne soit terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910526
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910526,
					"content": "D'accord, allons-y alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
