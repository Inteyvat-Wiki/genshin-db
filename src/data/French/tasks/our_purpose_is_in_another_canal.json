						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Merci infiniment, ces petits risques de sécurité devaient être maîtrisés rapidement, sinon ils auraient pu entraîner de graves incidents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "... C'est pour ça que je ne suis pas d'accord avec le vieux Aigouy, même si je sais qu'il prend soin de moi à sa manière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Quoi qu'il en soit, je tiens à vous remercier sincèrement pour m'avoir sauvé et aidé dans mon travail. Je vous ai préparé une récompense, veuillez l'accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Excusez-moi d'avoir retardé votre voyage à cause des ennuis que nous avons ici. Je vous souhaite une bonne route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
