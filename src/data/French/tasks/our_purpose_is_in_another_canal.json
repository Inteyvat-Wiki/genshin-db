						740911608
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911608,
					"content": "Tes parents n'auraient rien eu excepté une allocation décès.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911609
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911609,
					"content": "Hmph, c'est toujours mieux que d'avoir été renvoyé pour négligence professionnelle après avoir causé un incident de sécurité gravissime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911610
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911610,
					"content": "Espèce de... *soupir* Tu ne comprendras donc jamais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911611
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911611,
					"content": "Même si ça peut sembler un peu effronté de ma part... J'ai un service à vous demander pour le bien de tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911612
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911612,
					"content": "Est-ce que vous savez plonger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911613
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911613,
					"content": "Oui, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911614,
					"content": "Lorsque j'ai été capturé par les Brutocollinus, j'ai perdu ma combinaison de plongée. Lors d'une vérification de routine, j'avais découvert que les équipements de secours étaient endommagés. J'en ai demandé des nouveaux, mais ils ne sont pas encore arrivés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911615
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911615,
					"content": "Il ne faut surtout pas négliger l'entretien des tuyaux. Si vous avez des compétences en plongée, pourriez-vous aller vérifier les tuyaux de la Forteresse de Méropide à ma place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911616
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911616,
					"content": "Bien sûr, je vous offrirai la récompense à la hauteur de vos attentes. Vous avez ma parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911617
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911617,
					"content": "#Comme ça concerne la sécurité de tout le monde, nous sommes {M#disposés}{F#disposées} à vous aider. Mais la vérification des tuyaux semble être un travail à confier à des professionnels, est-ce que c'est raisonnable de nous laisser faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911618,
					"content": "C'est juste une inspection de routine, mais je pense qu'il pourrait y avoir quelques petits problèmes. Lors de la dernière inspection, nous avons trouvé quatre zones à risque... Mais cela ne devrait pas être trop difficile à résoudre, je vais vous expliquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911619
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911619,
					"content": "Si vous constatez une <color=#00E1FFFF>fuite de gaz</color> dans les tuyaux sous-marins, elles ont été causées soit par des créatures sous-marines... soit par des collisions avec des objets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911620
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911620,
					"content": "L'intervention d'urgence consiste à <color=#00E1FFFF>réguler le flux en utilisant la valve de régulation pour stopper temporairement la fuite de gaz</color>. C'est tout ce que vous avez à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911624
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911624,
					"content": "Réguler une valve demande de la dextérité. <color=#00E1FFFF>Lorsque vous tournez le volant de la valve, surveillez le débit de gaz. Si le débit diminue, c'est que vous êtes sur la bonne voie</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911621
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911621,
					"content": "D'accord... Je crois que j'ai compris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911622,
					"content": "Si vous avez des incertitudes, n'hésitez pas à me poser des questions à tout moment avant que l'inspection de routine ne soit terminée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911623
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911623,
					"content": "D'accord, allons-y alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7409117,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7409115",
							"2"
						],
						"stepId": 7409115,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7409113",
							"2"
						],
						"stepId": 7409113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "Pourquoi perdre votre temps avec tous ces travaux de maintenance ennuyeux, quand il y a d'autres personnes pour vous aider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911702,
					"content": "À propos de ce quai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "La Forteresse de Méropide compte de nombreux tuyaux. Il faut que quelqu'un les entretienne, n'est-ce pas ? C'est notre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911704,
					"content": "La plupart du temps, il ne s'agit que de réparations mineures, de colmatage. Si quelque chose d'important arrivait, qu'espèrent-ils de quelqu'un comme moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911705,
					"content": "Je me contente de faire ce que je peux. C'est comme distribuer des lettres en ville quand j'ai un jour de congé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911706,
					"content": "Merci pour votre temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "Oh, je ne manque pas de temps. Ce n'est pas comme si j'étais occupé, loin de là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				}
			]
		}
	]
}