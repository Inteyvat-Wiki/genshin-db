						150480303
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480303,
					"content": "Bravo, asha ! Tu m'as époustouflé avec ta performance athlétique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480304,
					"content": "C'est à ton tour Bennett, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "Et pas qu'un peu ! Je me suis échauffé et j'ai terminé mes étirements, alors je suis prêt à passer à l'action. Croyez-moi, je vais y arriver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480306,
					"content": "Fais attention à toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "Oui, ne t'inquiète pas ! Merci de te soucier de moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
