			"dialogs": [
				{
					"id": 150480601,
					"content": "Encore un peu plus loin. Reste calme maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480602,
					"content": "Quoi ?! Où est passée la ligne d'arrivée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480603
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480603,
					"content": "Est-ce que je me suis porté la poisse ? La chance a arrêté de me sourire ? ... Non, je ne peux pas me décourager maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480604,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480605
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480605,
					"content": "C'est vrai, je peux toujours suivre l'asha ! Tant qu'on est sur la même longueur d'onde, on trouvera un moyen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
