					"content": "Parle avec ton cœur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480821
					]
				},
				{
					"id": 150480821,
					"content": "Je suis vraiment heureux de t'avoir à mes côtés... Merci, asha.",
