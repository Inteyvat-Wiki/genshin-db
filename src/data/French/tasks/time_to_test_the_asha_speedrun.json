					}
				]
			},
			"dialogs": [
				{
					"id": 150480101,
					"content": "... Je ne peux pas vous laisser prendre ce risque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Ce n'est pas ce que vous avez dit tout à l'heure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Nos plus sincères excuses. Nous sommes pressés par le temps, mais la sécurité de nos visiteurs doit passer avant tout. Nous espérons que vous comprendrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "#Oh, tu arrives à point ! Peux-tu m'aider à convaincre ce monsieur, {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Ils avaient besoin de quelqu'un pour les tests. J'ai réussi à prouver mon expérience d'aventurier et à faire comprendre que j'étais prêt à accepter tous les risques. Tout se passait si bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Mais dès qu'il a appris que j'avais frôlé la catastrophe toutes ces fois par le passé, il a refusé catégoriquement de me laisser participer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Monsieur, j'apprécie votre enthousiasme, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Si vous avez tendance à tomber dans les rivières même lorsque vous traversez des ponts solides en pierre, il serait peut-être préférable de vous lancer dans quelque chose de moins... périlleux ? Par exemple, que diriez-vous de vous allonger sur l'une de ces chaises longues là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*soupir* Je suis un véritable aventurier, ce qui me qualifie pour faire le test aussi ! C'est juste que... c'était la faute à pas de chance avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Je veux vraiment vous aider. Croyez-moi quand je vous dis que vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "#Je peux me porter {M#garant}{F#garante} de ses capacités.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "#Eh bien, si {M#le héros}{F#l'héroïne} de Natlan le dit... Et si votre compagnon asha effectuait la première série de tests à votre place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Vous pouvez observer le déroulement de l'épreuve depuis les coulisses et vous familiariser avec l'itinéraire. Si tout se passe bien, vous pourrez participer à la deuxième série de tests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Ça te va, asha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "D'accord ! Je compte sur toi, partenaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Il a toute ma confiance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
