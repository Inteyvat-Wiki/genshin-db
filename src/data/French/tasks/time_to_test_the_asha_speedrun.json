			},
			"dialogs": [
				{
					"id": 150480801,
					"content": "Ouh, mon cœur s'emballe... Il va me falloir un peu de temps pour reprendre mon souffle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480802
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480802,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480803
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480803,
					"content": "Bravo, Bennett et asha ! Vous formez une équipe formidable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "La façon dont vous avez travaillé ensemble à la fin était d'autant plus formidable. Votre lien spécial a fait toute la différence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "Ensemble, vous avez renversé la situation qui était à votre désavantage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#Je dois te remercier plus particulièrement, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "Si tu n'avais pas cru en moi ou que tu n'avais pas persuadé le personnel, je n'aurais jamais eu la chance de relever ce défi, ni de l'affronter aux côtés d'Asha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Monsieur Bennett, le dernier test de sécurité a été effectué. L'Asha-ccélération est désormais officiellement prête pour l'ouverture. Votre aide a été très appréciée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "Tu as entendu, asha ? On a réussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "Je me souviendrai de votre nom, monsieur Bennett. Vous êtes un aventurier courageux et au grand cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "Cette aventure n'est pas encore terminée, mais j'ai de plus en plus de mal à me dire qu'il va falloir lui dire au revoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480813
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480813,
					"content": "Tu vas beaucoup me manquer, asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480814
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480814,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480815
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480815,
					"content": "Haha, non... C'est plutôt moi qui devrais te rassurer ! En tant que chef de cette équipe d'aventure, je dois veiller sur toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480816
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480817
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480817,
					"content": "Bizarre, je suis peut-être un peu survolté... J'ai une poussière dans les yeux et je n'arrive pas à parler correctement. Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480818
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480818,
					"content": "Je devrais demander au professeur Venti comment mieux exprimer mes sentiments dans ces moments-là. Après tout, c'est le meilleur poète que je connaisse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480819
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480819,
					"content": "Je suis à peu près sûre que le barde de pacotille dirait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480820
					],
					"speakerTitle": "Paimon"
				},
				{
