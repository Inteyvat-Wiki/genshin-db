						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Un merci ne suffirait pas, je vous dois une fière chandelle. Si jamais vous avez besoin de quoi que ce soit, vous n'avez qu'à demander !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160203,
					"content": "Oh ! Vous êtes très polie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "Je vais aller droit au but, j'ai des petits problèmes d'argent ces derniers temps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Vous voulez des moras ? Haha, c'est une bonne idée, mais il y a juste un petit problème...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160206,
					"content": "C'est le caïd qui a tout notre argent. Nous sommes fauchés comme les blés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160210,
					"content": "Votre caïd ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "C'est le chef de notre Gang de sels-fers. Il est là-bas, sous la falaise, avec des gars de Fontaine. Il nous a laissés ici pour garder le repaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160212,
					"content": "Mais vous avez vu ce qui s'est passé, n'est-ce pas ? Ces grenouilles de Fontaine se sont faufilées pendant que le caïd était absent pour nous poignarder là où le soleil ne brille pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160213,
					"content": "Où le soleil ne brille pas ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Ouah !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Ils pensent peut-être que nous sommes nés de la dernière pluie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160216,
					"content": "Puisqu'ils ont montré leur vrai visage, ce n'est qu'une question de temps avant qu'ils ne trahissent le caïd. Qu'en pensez-vous, partenaire ? Pour les moras ou pour l'honneur, vous n'allez pas abandonner maintenant, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160217,
					"content": "#Si le caïd s'en sort indemne, vous serez {M#récompensés}{F#récompensées} comme il se doit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160218,
					"content": "Où est-il ? Je vais aller voir ce qu'il en est.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "Sur la plage en dessous de la falaise. Vous ne pouvez pas le rater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160220,
					"content": "Je compte sur vous ! Je vous rejoindrai quand j'en aurai fini ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160207,
					"content": "Je me bats pour la justice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Et c'est tout à votre honneur ! Je vais vous dire quelque chose qui devrait vous intéresser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160209,
					"content": "Je pense que notre caïd a des problèmes, et qu'il aurait besoin d'aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Fer-Dou'er"
				}
			]
		},
