			},
			"dialogs": [
				{
					"id": 711160801,
					"content": "#Cette mission est une réussite complète ! Non seulement nous avons arrêté des bandits, mais en plus, on a eu la chance de rencontrer {M#le célèbre voyageur}{F#la célèbre voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160802,
					"content": "Vous nous connaissez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "#Bien sûr. J'ai de la famille au Port de Liyue, et j'ai beaucoup entendu parler de vous. C'est pour ça que je vous ai {M#reconnu}{F#reconnue} tout de suite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160804,
					"content": "Mais il y avait trop d'oreilles indiscrètes, et je ne voulais pas risquer d'être découverte et le laisser filer. J'espère que vous comprenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160805,
					"content": "#Nous ne nous sommes donc pas {M#engagés}{F#engagées} dans une transaction illégale entre gangs, mais dans une arrestation d'escrocs par les Millelithes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "C'est exact. Nous surveillons ces contrebandiers depuis un bon moment. Tout récemment, nous avons reçu de l'aide pour nous infiltrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160807,
					"content": "Après plus d'un mois d'attente, nous en profitons enfin pour attraper ce Gang de sels-fers de Liyue et ces gros poissons de Fontaine d'un seul coup de filet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160808,
					"content": "#Mais nous avons failli nous faire avoir par ces gars de Fontaine. Heureusement que vous étiez là, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160809,
					"content": "Malheureusement, on va devoir remettre ce festin à plus tard. Par contre, veuillez accepter ces moras en récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160810,
					"content": "Et n'essayez même pas de les refuser. Tout travail mérite salaire. C'est un contrat que nous devons honorer, sinon il y aura de moins en moins de personnes prêtes à nous aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160811,
					"content": "Bon, nous allons terminer de régler les derniers détails. Nous ne voulons pas vous retenir plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160812,
					"content": "#Bonne chance à {M#tous}{F#toutes} les deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fer-Chuan'er"
				}
			]
		},
