			},
			"dialogs": [
				{
					"id": 711160601,
					"content": "#Merci, nobles {M#combattants}{F#combattantes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160602,
					"content": "Ce n'est pas la peine ! Peu importe où vous faites des affaires, les contrats doivent être respectés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Haha, la petite héroïne a raison. Mais comment savez-vous tout ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160604,
					"content": "Fer-Dou'er nous a tout raconté. Elle a dit quelque chose à propos de contrebande ou quelque chose comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "Mais c'est quoi la contrebande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Du commerce illégal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "Dans ce cas, je dois vous exprimer ma sincère gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160608,
					"content": "Les gars ! Attachez-les et jetez-les à la mer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160609,
					"content": "#N'oubliez pas de les lester correctement. {M#Ils}{F#Elles} nous ont donné un sacré coup de main, ne les faisons pas souffrir inutilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160610,
					"content": "Quoi ?! Q—Qu'est-ce que vous avez l'intention de nous faire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Chère petite héroïne, je pensais que tu aurais compris maintenant. À Liyue, les contrats occupent une place très importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160612,
					"content": "Quiconque s'immisce dans une transaction entre hors-la-loi doit être réduit au silence. C'est un contrat verbal que tout le monde connaît, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160613,
					"content": "C'est n'importe quoi ! Vous nous remerciez d'avoir aidé en nous envoyant nourrir les poissons, c'est quoi ça comme contrat ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Ne me poussez pas à bout. Si je dois le faire moi-même, vous allez vraiment le regretter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160615,
					"content": "Vous savez qui je suis ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "Taisez-vous ! Fer-Dou'er, Fer-Chuan'er, qu'est-ce que vous attendez ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160618,
					"content": "Vous êtes vraiment sans foi ni loi, chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160619,
					"content": "Mais tant que nous empêcherons des bandits comme vous d'empoisonner Liyue avec leurs activités criminelles, ça vaudra la peine de faire tous ces efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160626,
					"content": "Arrêtons-le !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160620,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160621,
					"content": "Regardez-nous, Fer-Ming ! Qui croyez-vous que nous sommes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Fer-Dou'er"
				},
				{
					"id": 711160622,
					"content": "D—Des Millelithes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160623,
					"content": "Waouh ! Que se passe-t-il ici tout d'un coup ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Je pensais que vous étiez juste des petits nouveaux. Je ne m'attendais pas à ce que vous soyez des maudits Millelithes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160625,
					"content": "Ne comptez pas sur moi pour me rendre ! Je ne vais pas me laisser faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160616,
					"content": "Oh, non, je tremble comme une feuille !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
