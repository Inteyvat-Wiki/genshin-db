			"dialogs": [
				{
					"id": 711160401,
					"content": "Nous sommes amis, Johnnie. Je sais ce que tu as traversé ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160402,
					"content": "Tu aurais dû me dire que tu avais un problème. Au lieu de provoquer ce chaos... Tu m'as brisé le cœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160403,
					"content": "Tu sais que les choses ne sont plus ce qu'elles étaient. La Spina di Rosula a le vent en poupe ces derniers temps, et ça ne plaît pas à certains de mes frères...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Mais je dois continuer à mettre du pain sur la table. Si ça continue, ils n'auront bientôt plus que des miettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Nous faisons de bonnes affaires tous les deux. Mais si tu pouvais encore faire un petit effort... je suis sûr qu'un jour je pourrai te renvoyer l'ascenseur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "Sinon... Haha, ce ne sont pas les occasions qui manquent, Fer-Ming. Je suis sûr que tu te feras de nouveaux amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "J'en déduis donc que c'est ta dernière offre, Johnnie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160408,
					"content": "Tu as un problème avec ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "C'est une plaisanterie, j'espère ? Vous vous moquez de qui, monsieur je viens de Fontaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160410,
					"content": "Ah, silence !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160411,
					"content": "Écoute Johnnie, la famille Don Pesci me paie cinquante-huit mille par boîte, et les De Niro soixante-dix mille. Je ne dois quand même pas te rappeler leur importance au Port de Lumidouce ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160412,
					"content": "Mais pour toi, je demande cent mille pour trois boîtes et la livraison gratuite... Et pourquoi ? Parce que je te considère comme un ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160413,
					"content": "Je n'ai pas besoin d'en dire plus... Je suis sûr que tu aimerais réfléchir un peu plus ! Allons boire un verre quelque part, et on en reparlera après !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160414,
					"content": "Haha, ce ne sera pas nécessaire. Je connais l'importance que les gens de Liyue accordent aux contrats, et que ces contrats doivent avant tout être équitables. Mais je n'ai jamais entendu dire que les inclinations personnelles devaient l'emporter sur l'équité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Haha, Johnnie ! Enfin quelqu'un qui saisit l'importance des contrats... Mes hommes devraient prendre exemple sur toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160416,
					"content": "Cependant... je me demande quelle importance tu accordes réellement à notre contrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160417,
					"content": "Bien sûr ! Tu as tout à fait raison. Les contrats séculaires de Liyue méritent véritablement la plus haute appréciation. Je devrais probablement montrer un peu plus de respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, tu penses qu'on pourrait augmenter le prix de chaque article de... un mora ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "C'est plus qu'approprié, monsieur Johnnie. Ces gens de Liyue travaillent si dur qu'il est normal qu'ils gagnent un mora supplémentaire par article.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "Mais à quoi vous jouez, c'est quoi ces bêtises ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160421,
					"content": "Mes amis, ne sentez-vous pas tout le respect qui émane de moi de là où vous êtes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Johnnie, as-tu vraiment l'intention de ne pas respecter le contrat ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160423,
					"content": "Hein ? Qu'en penses-tu, Walker ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Si vous voulez savoir ce que j'en pense, monsieur Johnnie... Ce ne sont pas les occasions qui manquent, même quelqu'un d'aussi insignifiant devrait savoir ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "#Honte à toi, Walker. Comment oses-tu offenser notre ami de Liyue comme ça{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Nous allons bientôt prendre le contrôle de leur territoire. Ne devrions-nous pas faire preuve d'un peu plus de gratitude ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Je suis désolé, monsieur Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "Espèces de vauriens ! Je n'arrive pas à croire que vous osiez ne serait-ce que penser à ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160429,
					"content": "Doucement avec les insultes, nous sommes des gens civilisés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "Vous êtes qui, vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "Haha, est-ce que tous les enfants de Liyue sont aussi courageux ? Walker !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "#Qu'est-ce que vous voulez, les {M#morveux}{F#morveuses} ?! Prenez ces moras et retournez dans les jupons de vos mères !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "Waouh ! Et où sont passées vos manières ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160435,
					"content": "Nous sommes ici pour gagner un bon repas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Haha ! À vous entendre... vous êtes les renforts de Fer-Ming ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "Donc il avait déjà une idée derrière la tête ?! Hmm, eh bien, ça tombe à pic, car nous aussi. Walker !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Montrez-vous les gars, c'est le moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Fer-Chuan'er"
				},
				{
					"id": 711160441,
					"content": "Oh, voyez-vous ça ? On dirait que nous sommes en supériorité numérique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Mon cher Fer-Ming, je suis désolé. J'ai demandé à ce qu'on s'occupe des hommes qui gardaient votre repaire avant notre petit entretien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Partez l'esprit tranquille, nous allons prendre soin de vos petites affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "Tu ne te débarrasseras pas de nous aussi facilement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Fer-Ming"
				},
				{
					"id": 711160445,
					"content": "Pourquoi ne pas vérifier ça tout de suite ? Emparez-vous de lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Nous sommes ici pour renvoyer certaines personnes pleurer chez leurs mamans.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
