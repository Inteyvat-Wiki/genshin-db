				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "Bonjour ! Envie d'une petite partie de Théâtre mécanique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560102,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "Ah ! Bienvenue. C'est un nouveau jeu que je viens de recevoir de Liyue, ça s'appelle le Théâtre mécanique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560104,
					"content": "En gros, c'est un jeu de société. Il a été inventé à Liyue par mademoiselle Ruijn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560105,
					"content": "Comment expliquer... Selon mademoiselle Ruijin, je suis l'un de ses représentants à l'étranger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560111,
					"content": "Après avoir obtenu les... hum... droits de distribution, mademoiselle Ruijin m'a envoyé le jeu complet, avec une proposition commerciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560112,
					"content": "Malheureusement, le Bureau des affaires étrangères a confisqué le jeu... Alors j'ai dû attendre un moment avant de pouvoir le récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560113,
					"content": "Pourquoi le Bureau des affaires étrangères confisque ce genre de chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "Ils confisquent tout ce qui vient de l'étranger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560115,
					"content": "Peu importe. Ne parlons pas de ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560116,
					"content": "Vous voyez les pièces posées sur la table ? Elles représentent les éléments que vous pouvez utiliser dans le jeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560117,
					"content": "Est-ce que vous trouvez que ça ressemble à la version de Liyue ? Hahaha, j'ai tout fait selon les descriptions de la lettre de mademoiselle Ruijin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560118,
					"content": "J'ai même fait faire cette table spécialement... Ça m'a coûté une fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560119,
					"content": "Et j'ai écouté les suggestions de mademoiselle Ruijin, et ajouté de nouvelles règles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560120,
					"content": "Bon... Vous ne devez pas comprendre tout ce que je vous raconte. Pourquoi ne pas essayer ? Vous comprendrez en jouant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560121,
					"content": "Je voudrais essayer une partie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "#Aucun problème. Amusez-vous bien. C'est la toute nouvelle version. Vous n'allez pas être {M#déçu}{F#déçue} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560123,
					"content": "Je n'ai pas le temps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Très bien, revenez quand vous aurez du temps libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560106,
					"content": "Pourquoi se fait-il qu'il y ait le Théâtre mécanique ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "Bienvenue... Euh, vous savez ce qu'est le Théâtre mécanique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560108,
					"content": "Ah... Je vois. Vous avez dû jouer à ce jeu à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560109,
					"content": "Mademoiselle Ruijin m'a parlé de la promotion qu'elle a faite pendant le Festival des lanternes... Ça a l'air d'avoir bien marché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560110,
					"content": "Selon mademoiselle Ruijin, je représente la branche inazumienne du Théâtre mécanique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				}
			]
		}
	]
}