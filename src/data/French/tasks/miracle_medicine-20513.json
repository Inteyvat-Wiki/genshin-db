					"nextDialogs": [
						205130304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130304,
					"content": "Hahaha, ne me demandez pas pourquoi, mais j'ai le sentiment qu'Anna ira mieux si elle prend ce remède...",
