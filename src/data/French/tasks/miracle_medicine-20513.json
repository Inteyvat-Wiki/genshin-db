						205130306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130306,
					"content": "Enfin, mille fois merci. Tenez, c'est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130307,
					"content": "J'espère qu'Anna se remettra.",
