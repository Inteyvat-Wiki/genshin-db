			"dialogs": [
				{
					"id": 205130101,
					"content": "Tout s'est bien passé cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Alors ? Vous avez l'air plutôt en forme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Oui... Vous aviez raison j'imagine, pas de quoi s'en faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Anna va mieux de jour en jour. Ce médecin est effectivement à la hauteur de sa réputation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Puis-je vous embêter à nouveau ? Cette fois, il me faudrait un « chrysanthème à aubes emporté dans les airs par un Anémoblob ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Ça ne ressemble pas à un médicament...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Ce type de chrysanthème est utilisé parfois en médecine, mais pour des maux sans conséquence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Peut-être que l'élément clé vient des Anémoblobs ? Le problème, c'est qu'on ne voit pas souvent ce genre de bestiole à proximité de ces fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Par bonheur, Jack dit qu'il a déjà vu cela se produire à plusieurs reprises, et m'a indiqué à quels endroits. Laissez-moi vous marquer le plus récent sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Je serais bien incapable de m'occuper de ces Anémoblobs volants, je ne peux que m'en remettre à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "C'est très... Mondstadt, tout ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Ce n'est pas moi qui vous dirai le contraire. Mais le problème, c'est qu'on voit rarement ces bestioles à proximité de ces fleurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Par bonheur, Jack dit qu'il a déjà vu cela se produire à plusieurs reprises, et m'a indiqué à quels endroits. Laissez-moi vous marquer le plus récent sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130114,
					"content": "Je serais bien incapable de m'occuper de ces Anémoblobs qui volent dans tous les sens... Je m'en remets à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130115,
					"content": "Je pourrais me contenter d'attraper un Anémoblob et vous le ramener...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "Vous voulez juste que je me ridiculise devant vous, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130117,
					"content": "Enfin, quoi qu'il en soit, ces bestioles sont rarement vues à proximité de ces fleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130118,
					"content": "Par bonheur, Jack dit qu'il a déjà vu cela se produire à plusieurs reprises, et m'a indiqué à quels endroits. Laissez-moi vous marquer le plus récent sur votre carte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130119,
					"content": "Si vraiment vous ne trouvez pas ce qu'on cherche, alors ramenez-moi un Anémoblob... *soupir* Je ferai tout pour Anna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
