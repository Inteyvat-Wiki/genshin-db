			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "#Hé, {M#mes amis}{F#mes amies} ! J'ai de beaux articles à vendre à de très bons prix ! Vous voulez y jeter un œil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Hein ? On dirait des poupées de koholasaure. J'ai vu les mêmes au Marché de Brisedouce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Exactement ! Sauf que les miennes sont deux fois moins chères.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Comment peuvent-elles être aussi peu chères ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "#Héhé, ne vous inquiétez pas pour ça, {M#mon ami}{F#mon amie}. J'ai mes méthodes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Elles sont peut-être moins chères, mais les couleurs semblent un peu bizarres... Ce ne seraient pas des contrefaçons, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Des contrefaçons ?! Tsk, qu'est-ce que tu en sais, petite ? Allez, ouste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Du balai ! Je ne veux plus rien vous vendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
		{
