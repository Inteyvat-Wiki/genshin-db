					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "#Hé, {M#mes amis}{F#mes amies} ! J'ai de beaux articles à... Hé, mais c'est encore vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650302,
					"content": "Je vous ai dit que je ne voulais plus rien vous vendre. Allez-vous-en ! Hors de ma vue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650303,
					"content": "Hé, c'est votre dernière chance de vous excuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650304,
					"content": "C'est quoi votre problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650305,
					"content": "Vous vendez des contrefaçons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "Oui, et alors ? Mêlez-vous de vos affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
