			"dialogs": [
				{
					"id": 761850101,
					"content": "Mmm, le thé et les pâtisseries sont délicieux. Merci pour de vous être donné cette peine, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Je suis ravie que ça vous plaise. J'ai aussi apporté quelques friandises pour Ashru. Ashru ? Viens ici. Gentil chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850103,
					"content": "Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "J'espère que l'estime que vous portez à Nod-Krai et au Curatorium des secrets sera bénéfique pour notre future coopération.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Je l'espère aussi. Tiens, Ashru, goûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850106,
					"content": "Par ailleurs, à propos de ce dont je vous avais parlé plus tôt, mademoiselle Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Haha, tes petites pattes sont si douces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Mademoiselle Sandrone... Vous n'auriez pas utilisé l'excuse de prendre le thé pour venir caresser mon chat, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Hein...? M—Moi ? Jamais de la vie ! Je prends très au sérieux mes échanges avec le Curatorium des secrets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850111,
					"content": "Ashru, viens ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850114,
					"content": "Alors parlons plus concrètement de nos « échanges », voulez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "... Hmph. E—Et si je voulais caresser Ashru, alors ? Qui ne voudrait pas le faire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850116,
					"content": "Les petits animaux se méfient généralement des machines. Il m'a fallu beaucoup de temps pour gagner la confiance d'Ashru quand je travaillais ici sur la matrice arithmétique. Qu'y a-t-il de mal à lui faire une petite caresse amicale ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850117,
					"content": "Haha... D'accord, d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Vas-y, Ashru. Ce n'est pas à moi de te dire qui tu peux câliner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Miaou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Une fois que vous en aurez bien profité, n'oubliez pas que nous avons des choses sérieuses à discuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Je vous ai dit que je prenais ça très au sérieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
