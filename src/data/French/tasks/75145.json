			"dialogs": [
				{
					"id": 751450101,
					"content": "#Ô {M#élu}{F#élue}, {M#élu}{F#élue} des dragons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "La Montagne sacrée se dresse devant vous... Enfin, si vous parvenez à éliminer l'ennemi tapi dans les ténèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "#Ô {M#Élu}{F#Élue} des dragons... Entrez... Entrez dans la Montagne sacrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Le volcan vient d'entrer en éruption ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "Non... Il a été très calme... Vous l'avez vu entrer en éruption ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#Vous en faites des têtes, {NICKNAME} et {REALNAME[ID(2)|SHOWHOST(true)]} ? Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Vous ressemblez à deux détectives d'un roman léger qui se sont rendu compte de la vérité sur l'identité du tueur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "On a vu une « vérité »...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Vous racontez à Paimon ce que vous avez vu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Quoi ? Tu as vu la même chose qu'à notre arrivée à Natlan, quand on a rencontré {REALNAME[ID(2)|SHOWHOST(true)]} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "Et des images étranges ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "Tu as dit que tu avais vu des mots étranges avant... Moi, je n'ai rien vu, alors je ne saurais rien vous dire, mais... Est-ce qu'ils avaient l'air d'avoir été écrits par la même personne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Je crois que oui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Mais cette fois-ci, tu as aussi vu... d'énormes ruines et l'Abîme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "Et une Montagne sacrée... Hmm, les Natlanois appellent ce volcan par ce nom, pas vrai ? Peut-être que ta vision a un rapport avec ce volcan ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#J'ai vraiment l'impression que la personne qui nous a fait rencontrer {REALNAME[ID(2)|SHOWHOST(true)]} veut vraiment qu'on aille à cette Montagne sacrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Peut-être qu'on y trouvera les réponses aux questions qu'on se pose sur les origines de {REALNAME[ID(2)|SHOWHOST(true)]}, voire rencontrer sa famille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "#Bref... Je pense qu'on devrait rester {M#attentifs}{F#attentives} aux informations sur le volcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Ah oui ! L'une des six tribus de Natlan, le Collectif de l'abondance, se trouve à côté. On peut essayer de demander là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "L'éventreuse de gâteaux... C'était toi, Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "Zut ! Comment avez-vous su ? J'étais pourtant sûre que personne ne m'a vue manger mademoiselle gâteau... Non, je rigole. C'est le ragoût enflammé que j'ai mangé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Du coup, vous... Attendez, qu'est-ce que vous avez vu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
					"content": "(Vous racontez à Paimon ce que vous avez vu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Tu as revu des mots étranges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
