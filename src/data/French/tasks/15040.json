					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#Félicitations, {NICKNAME} ! Et bravo à vous, cher sauveur pour votre merveilleux travail d'équipe avec l'asha !",
