			"dialogs": [
				{
					"id": 150400301,
					"content": "C'est incroyable ! Ce sont enfin des Champs de moussefleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "Beau travail ! Maintenant, on n'a plus qu'à prévenir le personnel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "S'il vous plaît, attendez... *halète*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "Quand on parle du loup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "Pas de panique ! Reprenez d'abord votre souffle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*halète* ... D'accord... Bonjour, je suis l'employé en charge de l'activité principale de la Cascatelle colorée : l'Asha aéroporté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "À l'instant, en regardant d'en haut, j'ai vu la prairie se transformer soudainement en une mer de fleurs. Les couleurs étaient si artistiques, si étonnantes... que j'ai failli laisser tomber mes jumelles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "Vous êtes vraiment les sauveurs de la Cascatelle colorée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "Ce n'était rien, héhé. D'ailleurs, ce sont ces deux-là qui ont fait le plus gros du travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "Aventuriers au grand cœur, souhaitez-vous relever notre défi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "Ou devrais-je dire... Nous feriez-vous l'honneur d'apporter une touche de couleur à nos sites emblématiques ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Ça a l'air génial... Mais êtes-vous sûre qu'on peut faire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Bien sûr que oui ! Nous en serions vraiment ravis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Vous avez rendu un grand service à mon collègue, alors c'est tout à fait normal que je vous remercie. Du coup, j'ai pensé que cette expérience serait plus unique qu'une récompense en moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Si vous me demandez mon avis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "Elle veut dire qu'on serait ravis de vous aider ! Haha... Comment fait-on pour s'y rendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Suivez-moi. Nous allons prendre le ballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
