				},
				{
					"id": 150400709,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400710,
					"content": "Dites donc, il a beaucoup de choses à dire sur le sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400711,
					"content": "Est-ce que tu as tout compris, Chasca ? Pourrais-tu traduire pour nous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400712,
					"content": "Hmm, il y a beaucoup d'informations. Je dois réfléchir aux possibilités...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400713,
					"content": "#Ne vous en faites pas, j'ai compris ! L'asha veut faire équipe avec moi pour jouer contre {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400714,
					"content": "Il aime aider les gens en travaillant avec ses amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "Mais la compétition transforme les activités ordinaires en aventures palpitantes et c'est ce qu'il aime le plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "Il a vraiment dit tout ça ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Haha, plus ou moins ! Il y a sûrement aussi des éléments de ma propre interprétation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400719,
					"content": "Au vu de sa réaction, je crois que tu as raison. Le lien qui vous lie devient de plus en plus fort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400720,
					"content": "#D'accord. J'aime ton idée, mais on ne devrait pas forcer {NICKNAME} à faire quelque chose qu'{M#il}{F#elle} ne veut pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400721,
					"content": "Il faut respecter l'opinion de nos amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400723,
					"content": "J'attendais une occasion d'affronter le chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "J'accepte ton défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400725,
					"content": "Haha... Quand tu me regardes comme ça, je n'arrive pas à le dire sans rire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Bien. Si les deux équipes sont prêtes, je vous prierai de me suivre ! Je serai l'arbitre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "Du moment que l'asha et toi êtes contents, tout me va.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#On ne peut pas être les seuls à s'amuser ! Je veux que tu prennes autant de plaisir que nous, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400728,
					"content": "Allez, faisons ça ! Pas de pression !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400729,
					"content": "Je gagnerai même si je devais vous affronter tous les cinq.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "#Tu es bien {M#confiant}{F#confiante} en tout cas ! Très bien, je ferai de mon mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400731,
					"content": "Hé ! Moi, j'ai toujours été de ton côté !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Paimon"
				}
