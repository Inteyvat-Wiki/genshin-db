						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Quand j'ai entendu interpréter les paroles l'asha tout à l'heure, j'étais perplexe. Après ce match, je dois admettre que vous m'avez impressionnée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "Pareil ! J'étais investie dans le match, comme si j'assistais le Pèlerinage de retour du sanctifeu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Je comprends. Quand le combat atteint son apogée, j'ai tellement envie de m'élever dans les airs et tirer quelques balles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Hé, mais tu peux te servir de tes balles pour peindre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "Oui, mais j'ignore de quelle couleur. L'asha ne sera plus dans les airs non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "Haha ! En tout cas, il ne reste qu'une étape avant l'accomplissement du défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "Nos deux héros pourraient-ils allumer les pinceaux de l'Asha aéroporté ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Chronologie en jouant le site-clé des ashas)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "C'est splendide, n'est-ce pas ? Je peux vous recommander un endroit idéal pour des photos de groupe !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "L'asha et toi formez une belle équipe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
