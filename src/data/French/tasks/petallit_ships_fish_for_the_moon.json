			},
			"dialogs": [
				{
					"id": 400390101,
					"content": "Beidou est en train de récupérer une partie des antiquités de l'ancienne Chambre de Jade tombées dans la mer près de la Forêt de pierre de Guyun. Vous pouvez vous joindre à elle si ce genre d'activité vous intéresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "D'innombrables biens ont disparu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390202,
					"content": "Par exemple ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "Il manque un nombre important d'objets de l'ancienne Chambre de Jade dans la nouvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390204,
					"content": "Toute ma collection de livres, de meubles et de décorations s'est enfoncée dans la mer avec le bâtiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390205,
					"content": "La plupart des objets n'ont pas échappé à la destruction. Seuls quelques-uns sont demeurés intacts, flottant à la surface de la mer. Les récupérer n'est pas une tâche aisée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390206,
					"content": "Il me fallait quelqu'un qui sache comment s'y prendre en mer pour m'aider à réaliser cette tâche... Malgré cela, je ne sais pas si Beidou sera en mesure de tous les repêcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390207,
					"content": "Les repêcher ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "Euh, mais ça veut dire que vous avez ordonné à Beidou de repêcher tous vos objets ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390209,
					"content": "« Ordonner » est un terme inexact. Nous avons simplement conclu un marché, comme d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390210,
					"content": "Vous payez Beidou pour qu'elle fasse des missions pour vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "La rémunération financière est un aspect des contreparties. Je lui offre également d'autres « récompenses » pour ses services... Oui, disons que c'est une manière simple de résumer les choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390212,
					"content": "Bref, Beidou se trouve en ce moment dans les environs de la Forêt de pierre de Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390213,
					"content": "Allez la retrouver si ça vous intéresse de vous joindre à elle. Vous pourrez peut-être même l'aider dans sa tâche, qui sait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003904",
							"2"
						],
						"stepId": 4003904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "Sacrée Ningguang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390402,
					"content": "Si un bâtiment comme la Chambre de Jade a complètement été détruit, on peut en dire de même pour tout ce qui était à l'intérieur. Impossible de repêcher quoi que ce soit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390403,
					"content": "Vous vous en sortez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Qu'est-ce qui t'amène ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390405,
					"content": "Je suis là pour vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "Génial ! Tu tombes vraiment à pic ! Tout mon équipage est occupé avec d'autres tâches en ce moment, alors aucune aide n'est de trop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390407,
					"content": "J'ai même dû traîner Xinyan dans cette affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390408,
					"content": "Xinyan est aussi venue ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "C'est vrai ça, pourquoi ? Il va y avoir un concert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390410,
					"content": "Et ouais ! Rien d'officiel, par contre. Beidou voulait organiser un festin à bord et j'ai accepté de venir pousser un peu la chansonnette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390411,
					"content": "Mais nos plans sont tombés à l'eau quand une secrétaire de Ningguang s'est montrée. Elle s'est entretenue seule avec Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390412,
					"content": "C'était Baiwen... ou bien Baixiao ? Hum, je ne m'en souviens plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390413
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390413,
					"content": "Bref, Ningguang a soudainement eu la très merveilleuse idée de me faire parcourir la mer pour repêcher ses babioles. Elle est prête à débourser une grosse somme pour que je le fasse, d'ailleurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390414
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390414,
					"content": "Hmph, la rémunération était raisonnable pour ce travail, alors j'ai accepté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390415
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390415,
					"content": "Ceci dit, il nous faudrait un plus petit bateau pour mener cette mission à bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390416
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390416,
					"content": "Tous les bateaux disponibles ont déjà été attribués, et il nous en manque un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390417
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390417,
					"content": "J'ai mon propre bateau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390418
					]
				},
				{
					"id": 400390418,
					"content": "Ah bon ? Eh bien, tant mieux. Nous prendrons le tien.",
