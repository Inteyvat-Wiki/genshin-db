						400391104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391104,
					"content": "B—Beidou ?! Que faites-vous ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391105
					],
					"speakerTitle": "Liuliu"
