					"nextDialogs": [
						400391110
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391110,
					"content": "On s'est donné du mal à rassembler tout ce butin, vous allez sûrement nous laisser quelque chose ?",
