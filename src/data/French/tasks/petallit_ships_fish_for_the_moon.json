			"dialogs": [
				{
					"id": 400390801,
					"content": "Stop ! Arrêtez tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390802,
					"content": "Vous êtes aveugles ? C'est la capitaine Beidou, pardi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390803,
					"content": "Héhé... Chère capitaine Beidou, ça fait un sacré bail. Vous combattez toujours aussi bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390804,
					"content": "En effet, Carmen. Je vois que tu as pris un peu de masse depuis la dernière fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390805,
					"content": "Tu devrais faire un peu plus attention à ce que tu manges si tu veux continuer à te cacher derrière les buissons. Histoire de ne pas te faire repérer trop facilement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390806,
					"content": "Quel humour vous avez là, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390807,
					"content": "Plus sérieusement, je dois récupérer tous ces objets. Bas les pattes et je ne vous rendrai pas la vie plus dure qu'elle ne l'est déjà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390808,
					"content": "#O—Oui ! Les gars, vous avez entendu la capitaine Beidou ? Lâchez-moi tout ça{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390809,
					"content": "Et voilà, tout est à vous... Hum, on se retire mes gars et moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390810,
					"content": "Carmen part avec les Pilleurs de trésors...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "Ils se sont rapidement exécuté, dites donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390812,
					"content": "Ils sont très doués pour se rendre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "Pour prendre la fuite aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390814,
					"content": "Ne perdons pas plus de temps avec eux. Il nous reste des objets à récupérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390815,
					"content": "#Tout d'abord, il faudrait charger ces trucs sur le bateau... File-moi un coup de main, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
