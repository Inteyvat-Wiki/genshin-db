					"nextDialogs": [
						400391106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391106,
					"content": "Eh bien, mes gars viennent de trouver des trésors à la dérive. Si c'est pas un sacré pot qu'on a là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391107
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391107,
