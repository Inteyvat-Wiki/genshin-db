							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Compte tenu de votre persévérance, je ne m'attendais pas à ce que vous en restiez là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "Je pensais que vous alliez signaler cette affaire directement à la Maison Gardiennage, mais ça n'a pas été le cas. On dirait bien que vous avez vos propres méthodes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Pourquoi est-ce que vous séquestrez Benoît ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Pour être honnête, je vous admire depuis le début. Si seulement vous vous intéressiez aux choses qui comptent, vous auriez un avenir brillant devant vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "Malheureusement, cette affaire ne vous réussira pas. *soupir* Vous n'avez vraiment pas peur de la mort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "Vous tentez d'intimider la mauvaise personne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Oh ? Vous ne comprenez vraiment pas du tout la situation dans laquelle vous vous trouvez ou vous pensez faire respecter la justice ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "En parlant de l'homme d'affaires noyé mentionné dans le journal tout à l'heure, il s'appelait Brandt. C'était quelqu'un de très éloquent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Et devinez quoi ? Selon le journal, il ne se serait pas noyé, mais il aurait été assassiné, puis on aurait jeté son corps au fond d'un lac.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "La Maréchaussée fantôme a passé beaucoup de temps à enquêter sur cette affaire, avant de découvrir qu'il avait été assassiné, et que son meurtrier mériterait mille fois ce qu'il lui est arrivé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "Enfin, c'est ce que la presse dit... Mais que s'est-il réellement passé ? Lequel des deux méritait le plus de mourir : le meurtrier ou sa victime ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Hmm... C'est une question très complexe, je n'ai pas encore trouvé de réponse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "Oh, je me suis éloigné du sujet ! Ça n'a rien à voir avec ce dont nous parlions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "Qu'est-ce que vous voulez dire, à la fin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Ce que je veux dire, c'est qu'il est insensé d'agir de manière imprudente sans comprendre la situation. Sans parler des conséquences indésirables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "C'est insensé de rester de marbre face à une injustice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha... Si nous nous étions rencontrés dans des circonstances différentes, peut-être bien que nous serions devenus amis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "Même si votre façon de penser me plaît, j'ai d'autres choses à faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "#Ma patience a atteint ses limites. La prochaine fois que je vous vois {M#tous}{F#toutes} les deux fouiner autour de ma maison, j'agirai en conséquence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "Athos part après avoir marmonné des paroles incompréhensibles.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "#Son attitude étrange vous a {M#dérouté}{F#déroutée}. Vous commencez à vous demander quelle position adopter par rapport à cette affaire...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Soudain, vous entendez un léger tapotement provenant de la fenêtre derrière vous. Après avoir entendu un craquement à peine audible, vous voyez une note tomber...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Cette note, qui semble avoir été écrite à la hâte, est de couleur marron, comme si quelqu'un avait utilisé du café...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Regarde, qu'est-ce qu'il y a écrit dessus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "C'est de Benoît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Chut !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "... Désolée. Gardons tout de même un œil sur la gamelle du chat et attendons son signal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Je sais comment réagir face à une injustice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Quelle est votre relation avec Benoît à la fin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
