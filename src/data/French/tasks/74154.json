			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#{NICKNAME}, regarde ! Il y a du poisson frais, et le sol est très propre. Quelqu'un a dû le nettoyer il n'y a pas longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Il y a certainement quelqu'un dans la maison de Benoît. Allons voir ça de plus près.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "... Ce qu'il a dit est logique, il ne peut pas disparaître. Il faut au moins qu'il se montre de temps en temps, pour faire une promenade ou quelque chose du genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "Au moins, les voisins n'iront pas informer la Maison Gardiennage de son absence. Je n'ai pas envie que des mousquetaires se pointent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Papa, tu veux te promener, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "Je... Je peux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540807,
					"content": "Bien sûr que oui ! Et nous serions ravis de t'accompagner !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "#Attention quand même ! Il ne faut pas lui donner l'occasion de s'échapper pour demander de l'aide, les deux {M#gamins}{F#gamines} bizarres passent souvent par ici pour voir ce qui se passe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Mon père ne ferait jamais ça, j'en suis certaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Papa, tu ne veux sûrement pas que la Maison Gardiennage sache que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "Qu'ils sachent quoi... Pourquoi est-ce qu'ils parlent à voix basse ? Je n'arrive pas à entendre ce qu'ils disent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Ils s'apprêtent à sortir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Oui, éloignons-nous un peu. Cette fois, il va falloir trouver un moyen de parler à Benoît, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Tout à fait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Très bien, il faut qu'on y aille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "Alors, papa ? Est-ce que tu as retrouvé le moral ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "C'est vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "Aidez-moi ! Euh non... Ne m'aidez pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540820,
					"content": "Qu'est-ce que tu racontes ? Qui doit t'aider ? Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Oh, c'est vous. Mon père voulait vous dire bonjour. Vous vous connaissez, après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "... Non, pas du tout ! Nous ne nous connaissons pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540823,
					"content": "#C'est vrai ? Comment est-ce possible ? {M#Ils}{F#Elles} sont pourtant {M#venus}{F#venues} exprès pour te voir, papa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "#{M#Ils}{F#Elles} ont eu la gentillesse de nous donner nos journaux, et sont même {M#allés}{F#allées} jusqu'au Fleuve cendré pour parler avec notre ancien voisin, Snodgrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "J'imagine que vous êtes vraiment très proches ! Tu aimes beaucoup les enfants, après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "Moi aussi, j'aime beaucoup les enfants. Mais je ne suis pas aussi altruiste que toi. Je ne peux malheureusement plus être aux côtés de mon enfant, l'être que je chérissais le plus au monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Mais à quoi vous jouez, à la fin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Benoît est notre père, à Athos et à moi. Il nous aime énormément, c'est pour ça que nous l'aimons également en retour. Ce n'est pas assez clair pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia, regarde le temps que nous avons aujourd'hui. C'est idéal pour une promenade !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "Tu as raison, Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Est-ce que tu as lu l'édition d'aujourd'hui de L'Oiseau de vapeur ? Il y a plein d'articles intéressants !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Non, pas encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "L'un de ces articles parle d'un vieil homme qui est malheureusement décédé. Apparemment, il aurait rencontré un voleur quand personne n'était avec lui. Résultat ? Il est malencontreusement tombé d'une falaise, avant de mourir sur le coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Vraiment ? Quelle terrible nouvelle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "Il y a aussi l'histoire d'un homme d'affaires malchanceux qui s'est noyé. Il aurait trop bu avant de plonger dans un lac. Étourdi comme il était, il se serait noyé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Ah oui, quand même ! Vraiment pas de chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "Le dernier fait divers est aussi le plus intéressant. Ça parle d'une bonne personne bien brave qui aime se mêler des affaires des autres. Mais malheureusement, elle a pris de mauvais médicaments par inadvertance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "Elle a ingéré du poison en pensant qu'il s'agissait de son remède, ce qui a entraîné sa mort douloureuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Vraiment ? Il y a tellement de façons de mourir. Continue, je t'en prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "... Désolé, veuillez m'excuser. Je ne recommencerai plus jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540843,
					"content": "Qu'est-ce que tu viens de dire, mon papounet ? On ne t'en veut pas, tu dois être exténué après avoir couru de la sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Athos, rentrons lire le journal à notre père. Tu t'es abonné à plein de journaux, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Effectivement, nous avons assez parlé. Il est temps de rentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Rentrons à la maison, mon papa adoré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Pourquoi faites-vous ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Vous vous demandez pourquoi j'accompagne mon père se promener ? C'est le devoir d'un enfant, comment pourrais-je être digne de recevoir l'amour de mon père si je ne respectais pas ces obligations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}