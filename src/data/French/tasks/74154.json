			"dialogs": [
				{
					"id": 741540201,
					"content": "C'est très louche, quelque chose ne va pas... Même moi, je peux dire qu'il se passe quelque chose d'étrange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, vu que tu es {M#intelligent}{F#intelligente}, qu'est-ce qu'on devrait faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoît a besoin d'aide, mais il nous assure qu'il n'en a pas besoin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Et si on allait faire un tour près de la maison de Benoît ? Il y avait une caisse étrange près de la fenêtre arrière de sa maison, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Il doit y avoir quelque chose de caché dedans qui pourrait confirmer tous tes soupçons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Ce couple vient peut-être du Fleuve cendré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Vu leur réaction, je pense qu'ils nous cachent quelque chose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Je peux avancer quelques théories, mais je n'ai aucune preuve pour les appuyer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
