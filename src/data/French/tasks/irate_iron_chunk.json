			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "#Ouf... J'ai eu une peur bleue. Heureusement qu'Arabalika nous a {M#aidés}{F#aidées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Comme je te l'ai déjà dit, Paimon, tu auras de gros ennuis si tu es négligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "Oui... J'ai compris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Les Gardiens des ruines sont voués à se réveiller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Tu as raison. Ce sont des Gardiens des ruines, après tout. Leur travail est de garder ces ruines des étrangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} et Paimon sont des {M#étrangers}{F#étrangères} dans la vana, mais pas Arabalika. Ce n'est pas un gentil morceau de fer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Quand le gros morceau de fer est méchant, Arabalika doit lui donner une leçon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Ouah... Je vais faire tout mon possible pour ne jamais faire un pas de travers, alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Croix de bois, croix de fer, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Pas de problème ! Je vais commencer demain... Non, maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Seuls les aranaras peuvent éveiller la pierre. Nara {NICKNAME}, Paimon, laissez Arabalika faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Ooooh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "La réparation de l'outil varuna progresse de plus en plus ! Une fois qu'on l'aura réparé, il n'y aura plus de spores flottant dans les Bois d'Apam... Rien que d'en parler, mon nez me gratte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "L'outil purifiera l'eau de pluie. Alors, il n'y aura plus de pluie noire et plus de spores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Quant aux champignons... Il devrait encore y en avoir. J'ai failli être avalé par un champignon. Paimon, fais attention à ce que cela ne t'arrive pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "D'accord... Je resterai vigilante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
