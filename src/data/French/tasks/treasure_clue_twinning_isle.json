			"dialogs": [
				{
					"id": 790290101,
					"content": "Il y a une statue ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "*soupir* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290103,
					"content": "Bonjour, pourquoi soupirez-vous à l'entrée de la grotte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Eh bien, c'est là que je vis en ce moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290113,
					"content": "Comment pouvez-vous vivre dans un endroit pareil !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "Je n'ai pas d'autre solution ! Un groupe d'acteurs est soudainement arrivé sur l'île et ils ont commencé à faire du boucan tous les jours, m'empêchant de dormir... Donc je me suis trouvé un endroit un peu plus tranquille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290104,
					"content": "Mais un groupe de Brutocollinus est arrivé de je ne sais où et a envahi l'endroit où je me reposais, je n'avais donc d'autre choix que de me retrouver dehors dans le froid !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290105,
					"content": "*soupir* ... Je me suis juré que si quelqu'un pouvait m'aider, je lui donnerais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290106,
					"content": "Vous lui donneriez quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "Je lui donnerais l'indice du trésor secret des pirates ! Bien que je n'en connaisse qu'un quart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290108,
					"content": "Un quart d'indice ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "Vous avez l'air d'être ici pour le trésor, vous aussi. Alors qu'est-ce que vous en dites ? Aidez-moi à chasser les Brutocollinus qui se trouvent là-dedans et je vous donnerai l'emplacement de l'indice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290110,
					"content": "Il paraît que si vous obtenez les quatre indices, vous pourrez trouver le trésor que les pirates ont laissé ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Capitaine des corbeaux"
				},
				{
					"id": 790290111,
					"content": "Marché conclu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
