			"dialogs": [
				{
					"id": 708001501,
					"content": "Ah, vous voilà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001502
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001502,
					"content": "J'ai ramené la viande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "Parfait ! Hein ? Et Shute alors ? Il n'est pas en danger, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001504,
					"content": "Il va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "Alors ça va, tant qu'il va bien... Bon, dès que j'ai fini de préparer mon plat, je vous fais goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001506,
					"content": "Cette viande congelée est vraiment différente des autres viandes. Si je l'utilise pour ma recette, j'arriverai peut-être à obtenir le rendu que je cherche !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001507,
					"content": "Mais si je veux vraiment rendre le goût du vent, je vais avoir besoin de graines de pissenlit pour l'assaisonnement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001508,
					"content": "Mais même comme ça, la différence avec un plat de viande ordinaire n'est pas bien grande... J'ai encore besoin d'un ingrédient phare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001509,
					"content": "Oh, je sais ! Après notre duel, j'ai discuté plusieurs fois avec Xiangling, et elle m'a parlé d'un plat, le ragoût de Blob aux champignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001510,
					"content": "Je n'ai jamais utilisé ce genre d'ingrédients nouvelle cuisine avant... Mais, si je veux faire un plat vraiment innovant, alors il me faut des ingrédients innovants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001511,
					"content": "#{M#Voyageur}{F#Voyageuse}, pouvez-vous m'aider à trouver de la bave de Blob et des graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001512,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "Hmm, merci. De mon côté, je vais continuer à réfléchir à ma recette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brooke"
				}
			]
		},
