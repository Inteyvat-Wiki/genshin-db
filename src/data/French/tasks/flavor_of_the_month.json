					"Brooke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "Qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Je veux inventer un tout nouveau plat pour la Fête des alizées, quelque chose qui capture le « goût du vent ». Je suis en train de préparer les ingrédients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000203,
					"content": "J'ai donc demandé à Alan de m'aider à trouver de la viande fraîche au Canyon de Brillecouronne, mais ça fait déjà un moment et il n'est pas encore revenu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000204,
					"content": "#Si ça continue, mes ingrédients vont perdre leur fraîcheur... {M#Voyageur}{F#Voyageuse}, vous m'aideriez à aller voir au Canyon de Brillecouronne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000205,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Merci bien. Je vous ferai goûter ma nouvelle recette ensuite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brooke"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
