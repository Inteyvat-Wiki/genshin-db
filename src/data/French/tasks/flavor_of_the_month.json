				"objectNames": [
					"Brooke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "Ah, vous revoilà. Alors, cette viande ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000702,
					"content": "Tenez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Hmm, voyons voir... Oui, c'est bien frais, ça ira. Ce plat contient beaucoup de viande, assaisonnée au goût du vent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000704,
					"content": "Bien sûr, quand je dis « goût du vent », c'est de pissenlits que je parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000705,
					"content": "#{M#Voyageur}{F#Voyageuse}, pouvez-vous m'aider à en récolter quelques graines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000706,
					"content": "Comptez sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Merci beaucoup. Moi, je vais commencer à préparer la viande. Revenez me voir dès que vous aurez collecté les graines de pissenlit dont j'ai besoin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brooke"
				}
			]
		},
		{
