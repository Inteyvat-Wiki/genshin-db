				"objectNames": [
					"Brooke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Merci. Avec ça, tous les ingrédients sont prêts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000902,
					"content": "Bon travail. Tenez, prenez ceci comme récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000903,
					"content": "Par contre, je me demande comment je vais pouvoir faire pour rendre au mieux le goût du vent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708000904,
					"content": "En cuisant à la vapeur et puis en faisant frire... Hmm... Mieux vaut préserver le goût d'origine des ingrédients, puis saupoudrer avec des graines de pissenlit une fois la cuisson terminée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brooke"
				}
			]
		},
