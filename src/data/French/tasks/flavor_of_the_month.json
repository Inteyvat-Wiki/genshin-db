						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "Ouf, sauvé... Merci beaucoup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 708000602,
					"content": "Je ne savais pas que la chasse aux sangliers de forêt était si compliquée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 708000603,
					"content": "À propos des ingrédients de Brooke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "C'est Brooke qui vous envoie ? Ah... J'ai trouvé la viande qu'elle voulait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 708000605,
					"content": "Mais j'étais tellement concentré sur les sangliers que je n'ai pas fait attention aux monstres du coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 708000606,
					"content": "J'ai attrapé mon sanglier, mais je me suis fait cerné par les monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 708000607,
					"content": "#{M#Voyageur}{F#Voyageuse}, pouvez-vous ramener la viande à Brooke ? Je dois d'abord aller à la cathédrale pour me faire soigner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Alan"
				},
				{
					"id": 708000608,
					"content": "*soupir* S'il me voit dans cet état, Draff va encore en faire tout un fromage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alan"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
