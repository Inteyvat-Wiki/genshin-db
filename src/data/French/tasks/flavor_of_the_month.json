				"objectNames": [
					"Brooke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001001,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "Vous êtes... Oh, je me souviens de vous. Vous êtes le commis de cuisine de Xiangling, c'est ça, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001003,
					"content": "Le duel culinaire de la dernière fois m'a laissé une forte impression, je me souviens parfaitement de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001004,
					"content": "J'ai perdu contre Xiangling la dernière fois, mais cette fois, je vais faire un plat au goût de vent ! Et puis, j'utiliserai cette recette pour la défier à nouveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001005,
					"content": "J'ai d'ailleurs demandé à un aventurier de se rendre à Dosdragon pour me trouver de la viande congelée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001006,
					"content": "Il s'appelle Shute, mais il n'est toujours pas revenu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001007,
					"content": "J'ai entendu dire que la région de Dosdragon était plutôt dangereuse, peut-être qu'il lui est arrivé quelque chose... Est-ce que vous pourriez aller le chercher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "Brooke"
				},
				{
					"id": 708001008,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "Vraiment ? Merci beaucoup ! Il fait extrêmement froid dans les montagnes, n'oubliez pas de vous réchauffer près d'un feu régulièrement.",
					"roleType": "TALK_ROLE_NPC",
