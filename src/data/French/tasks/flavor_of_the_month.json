				"objectNames": [
					"Shute le terrifié"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "Ah... Je revis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001302,
					"content": "#C'est vous qui avez allumé ce feu ? Oh, merci {M#voyageur}{F#voyageuse} ! Vraiment, merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001303,
					"content": "Ça va mieux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "J'ai un peu moins froid maintenant, alors ça va, ça va... Je suis venu ici pour remplir une mission, je dois récupérer de la viande à Dosdragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001305,
					"content": "Au début, je pensais juste chercher un peu dans les alentours, mais j'ai perdu mon camp de vue, et avant de m'en rendre compte, je m'étais complètement perdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001306,
					"content": "Si vous n'aviez pas été là, je n'aurais vraiment pas su quoi faire. Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001307,
					"content": "La mission de Brooke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Alors c'est Brooke qui vous a demandé de venir m'aider ? *soupir* Elle doit s'impatienter, mais franchement, je n'ai plus la force de ramener cette viande en ville...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001309,
					"content": "J'ai honte de demander ça, mais... Pourriez-vous lui ramener la viande qu'elle a demandé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 708001310,
					"content": "Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Merci beaucoup ! Moi, je dois redescendre jusqu'au camp au pied de la montagne pour un bon bol de soupe chaude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shute le terrifié"
				}
			]
		},
