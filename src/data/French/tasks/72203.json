			"dialogs": [
				{
					"id": 722030501,
					"content": "Haha, tu m'as encore trouvée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Tu vas me manquer, mais... Je suis venue te dire au revoir. Le monsieur en doré a dit qu'on devait y aller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Mais ne t'en fais pas pour moi ! Il y aura plein de gens avec qui jouer là où j'irai ! J'espérais que tu puisses venir avec nous, mais le monsieur en doré a dit que ce n'était pas encore le moment pour toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Tant pis, ce n'est pas grave ! Je t'attendrai... Et si je ne peux plus attendre, je me transformerai en étincelles de lumière et je viendrai te voir dans tes rêves !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Bon voyage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Oui ! C'était amusant de jouer avec toi, merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Je suis heureuse, car je ne serai plus toute seule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonno"
				}
