				{
					"id": 706660101,
					"content": "Je suis là pour un défi d'élévation !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#Miaou... (« Oh, un défi d'élévation ? Eh bien, c'est vrai que tu es déjà {M#qualifié}{F#qualifiée} pour participer à cette épreuve. Bon... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660103,
					"content": "#(« Je vais dire à Shuyun de préparer le défi. Et reste {M#prudent}{F#prudente}... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
		{
			"id": 7066602,
			"completionStepIds": [
				7066603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
