			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Prince"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "#Miaou ! (« Incroyable ! Félicitations pour avoir réussi le défi. Tu es maintenant {M#un joueur avancé}{F#une joueuse avancée} ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660202,
					"content": "#Miaou ? (« Pourquoi on peut devenir {M#joueur avancé}{F#joueuse avancée} après un seul défi ? Eh bien, la plupart des gens jouent aux cartes pour s'amuser et ne prennent pas ça trop au sérieux... »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660203,
					"content": "(« En d'autres termes, peu sont ceux qui sont vraiment sérieux à propos de ce jeu. Mais même si c'est juste pour le plaisir, cela demande quand même un certain dévouement. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660204,
					"content": "Miaou ! (« Ah oui. Maintenant que tu as mon approbation, tu peux défier les parties préparées par les autres dans la taverne. Hmm... Ils devraient apprécier de jouer contre toi. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660205,
					"content": "Les autres ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Miaou. (« Oui. Comme moi, ce sont des chats de la taverne... Mais il ne faut pas les sous-estimer. »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660207,
					"content": "Miaou ~ (« À ce moment-là, Shuyun pourra tenir les cartes pour eux. Eh bien, pour faire honneur à la tradition, il y a quelque chose que je dois dire ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660208,
					"content": "#(« {NICKNAME}, que le plaisir t'accompagne dans le monde de l'Invocation des Sept ! »)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
