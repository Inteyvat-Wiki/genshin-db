			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}, Paimon, avez-vous vu deux Bake-danuki ? L'un porte un sac violet, et l'autre un sac jaune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 790350102,
					"content": "Ah ! C'est sans aucun doute Mamesuke et Shibasuke !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350103,
					"content": "On dirait que vous les connaissez déjà, c'est super.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 790350104,
					"content": "Hein ? Il leur est arrivé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350105,
					"content": "Pas vraiment. Mais ils m'ont donné ça après avoir dansé et fait des gestes incompréhensibles pendant un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 790350106,
					"content": "J'ai entendu dire que ces deux Bake-danuki d'Inazuma et vous étiez allés ensemble au Bon Chasseur, donc j'en ai conclu que vous pourriez être amis. Ils voulaient probablement que je vous donne ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 790350107,
					"content": "Ouah ! Un cadeau de la part de Mamesuke et de Shibasuke !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350108,
					"content": "Héhé, leur voyage a bien commencé, dirait-on. Mais je me demande si on aura la chance de les revoir un jour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
