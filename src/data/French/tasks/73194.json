			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Rappel spécial : Les Érémites sont les seuls mercenaires autorisés à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940602,
					"content": "Ne faites pas aveuglément confiance aux inconnus pour éviter de vous faire escroquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940603,
					"content": "Si vous souhaitez engager des gardes du corps, des gardiens, ou si vous avez d'autres demandes, veuillez contacter Rukh Shah, parchamdar de la Légion des trente, ou poster une commission via l'officier de liaison de l'Académie, Effendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
