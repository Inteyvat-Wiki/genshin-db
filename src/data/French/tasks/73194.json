			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Veuillez ne pas porter sur vous trop d'argent dans les endroits à forte fréquentation de la ville pour éviter les vols.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940802,
					"content": "Si vous êtes victime d'un vol, ne cherchez pas l'aide des Érémites qui patrouillent dans les environs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940803,
					"content": "Parce qu'il est très probable que ce soient eux les coupables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
