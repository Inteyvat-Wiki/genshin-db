			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "« Faites attention si vous prévoyez un voyage dans la forêt tropicale. Mon tuteur m'a envoyé là-bas pour récolter des herbes l'autre jour, et j'ai croisé un tigre rishboland. J'ai failli y perdre la vie. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941202,
					"content": "« J'ai eu de la chance d'avoir été secouru par une garde forestière qui se trouvait à proximité. Elle se présentait comme une garde forestière en formation, mais elle semblait vraiment expérimentée. Et surtout, elle m'a donné de la nourriture délicieuse pour m'aider à reprendre mon calme. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941203,
					"content": "« J'ai entendu dire qu'elle était l'élève de Tighnari. C'est comme on dit : tel professeur, tel élève ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
