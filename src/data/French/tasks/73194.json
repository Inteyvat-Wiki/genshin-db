					"id": 731941001,
					"content": "Prime offerte pour : Mustah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941002,
					"content": "Cet homme se déguise en mahamata pour commettre des extorsions et piller les caravanes marchandes autour du port du bazar. La Citadelle de Regzar est actuellement en train d'enquêter sur cet individu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941003,
					"content": "Selon les rapports, il se cacherait dans la forêt. Si vous l'apercevez, veuillez le signaler immédiatement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
