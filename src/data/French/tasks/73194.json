			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Le Bimarestan est un établissement médical dépendant de l'Amurta qui fournit des soins médicaux gratuits aux habitants de Sumeru et aux habitants extérieurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940702,
					"content": "Les médecins d'ici sont agréés par l'Amu{RUBY#[S]Biologie}rta, et nos diagnostics et nos plans de traitement sont réexaminés à plusieurs reprises par l'Akasha. Nous fournissons les services les plus professionnels et les plus sûrs pour tous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940703,
					"content": "Ne faites pas confiance aux médecins non identifiés ou non agréés afin d'éviter d'y perdre votre argent et votre santé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
