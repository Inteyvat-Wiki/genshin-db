				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Étant donné que les mahamatas ne se serviront plus à l'avenir de ce panneau pour poster des annonces, celui-ci servira désormais de panneau d'affichage public pour la Taverne de Lambad. N'hésitez pas à laisser des messages ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941102,
					"content": "« Les dix caisses de vin que j'ai commandées sont-elles arrivées ? Je suis venu hier à l'heure convenue et j'ai appris qu'elles n'étaient pas encore là. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941103,
					"content": "C'est pas possible ! Une personne blonde est venue ici en prétendant être votre colocataire et a pris toutes les caisses de vin. Je me souviens même que vous êtes venus tous les deux ensemble l'autre jour. Est-ce que je me suis trompé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731941104,
					"content": "« ... D'accord, je vois. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
