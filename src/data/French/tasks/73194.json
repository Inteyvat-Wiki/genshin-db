				{
					"id": 731940901,
					"content": "Prime offerte pour : Kasim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940902,
					"content": "Cet homme prétend être un célèbre bandit qui voyage à travers les pays, mais il est en fait un fraudeur dont le nom ne figure dans aucun des classements des Érémites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940903,
					"content": "De nombreux cas de fraude liés à ce personnage ont été signalés dernièrement. Veuillez rester vigilants et éviter de vous laisser piéger par ses escroqueries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
