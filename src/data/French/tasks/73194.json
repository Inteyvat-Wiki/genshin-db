			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Ce panneau d'affichage a été mis en place par les mahamatas pour faire connaître les affaires importantes de la Ville de Sumeru. Si vous avez des questions, veuillez les poster ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "« Vous avez entendu ? Les gardes forestiers ont trouvé un magnifique palais au nord de la forêt. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940202,
					"content": "« Mais il semble que tous ceux qui y sont allés ont fini par se rouler dans la farine. Il ne leur restait que leurs sous-vêtements quand les brigadiers forestiers les ont trouvés. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940203,
					"content": "« Ils pleuraient sans cesse et refusaient de dire ce qui s'était passé. C'est horrible. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940204,
					"content": "« Quand on est dans la forêt, il vaut mieux faire attention où l'on met les pieds. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Les annonces internes et externes essentielles de Sumeru sont désormais diffusées via l'Akasha. Veuillez donc toujours porter votre terminal akashien sur vous à tout moment pour ne manquer aucune nouvelle importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940302,
					"content": "Ce panneau d'affichage sera temporairement conservé pour la commodité des commerçants étrangers, des personnes âgées et des enfants, mais il peut être supprimé à tout moment à l'avenir. Il est recommandé d'éviter d'en devenir trop dépendant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "Les faveurs anahitiennes de cette année sont en cours de distribution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940402,
					"content": "En principe, la distribution sera effectuée selon les mêmes directives et exigences de l'année dernière. Les détails sont disponibles dans l'Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940403,
					"content": "En cas de changement, veuillez contacter à l'avance le mahamata le plus proche afin de soumettre une demande de modification à l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Ces derniers jours, les cas d'éléazar sont en augmentation dans la ville. Si vous ressentez des symptômes tels qu'un engourdissement de la peau ou une faiblesse au niveau des membres, ou si vous remarquez que des écailles grises ou noires apparaissent sur votre peau, veuillez vous faire soigner au Bimarestan dès que possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Panneau d'affichage"
				},
				{
					"id": 731940502,
					"content": "Si vous ratez la meilleure fenêtre de traitement et que vous laissez votre état s'aggraver, cela peut entraîner des conséquences graves telles que la perte de mobilité. Veuillez prendre cet avertissement au sérieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panneau d'affichage"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
