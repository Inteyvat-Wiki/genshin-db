			"dialogs": [
				{
					"id": 736740301,
					"content": "Ma petite, c'est toi qui m'as amené là, non ? Allez, bouge un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740302,
					"content": "*soupir* Bon, tant pis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740303,
					"content": "Ulman ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Oh, ça fait un bail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740306,
					"content": "Oh ? Vous continuez à rouler votre bosse à travers le monde ? J'ai entendu parler de vos nombreux exploits, vous savez... Vous êtes vraiment quelqu'un d'incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740307,
					"content": "Haha, que venez-vous faire à Sumeru ? Quel problème avez-vous prévu de résoudre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740308,
					"content": "Parlons plutôt d'autre chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "#D'accord, un peu de sérieux. D'ailleurs, {M#voyageur}{F#voyageuse}, que diriez-vous de faire à nouveau équipe avec moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740313,
					"content": "Regardez un peu le vaste territoire de Sumeru... Trésors et moras nous attendent partout ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740314,
					"content": "Les Fées sont attirées par moi comme d'habitude, dont les Fées chercheuses que nous connaissons bien tous les deux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740315,
					"content": "Faisons comme la dernière fois, vous vous occupez de chercher les trésors avec la Fée, et moi, je m'occupe de préparer des récompenses pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740316,
					"content": "Du moment que nous unissons nos forces, je suis sûr que nous gagnerons encore beaucoup d'argent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740317,
					"content": "Vous cherchez encore des sapèques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "Non, maintenant je recherche des sapèques anciennes, c'est encore plus précieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740319,
					"content": "C'est quasiment la même chose !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "Pas du tout ! Celles-ci nous feront gagner encore plus de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740326,
					"content": "Bien, c'est décidé ! Unissons nos forces une fois de plus pour gagner le pactole !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740321,
					"content": "Vous n'avez trouvé personne d'autre que moi pour cette tâche ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740322
					]
				},
				{
					"id": 736740322,
					"content": "Vous savez, lorsque l'on cherche un partenaire, mieux vaut s'adresser à quelqu'un qu'on connaît bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740323
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740323,
					"content": "#Et puis vous êtes mon {M#ami}{F#amie}. Comment aurais-je pu proposer une si belle opportunité à quelqu'un d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740324
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740324,
					"content": "Vous ne teniez pas ce genre de discours mielleux lors de notre dernière rencontre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740325
					]
				},
				{
					"id": 736740325,
					"content": "Héhé, c'est comme ça qu'on persuade les acheteurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740310,
					"content": "Je vais d'abord vous régler votre compte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740311
					]
				},
				{
					"id": 736740311,
					"content": "Haha ! Arrêtez, je ne fais pas le poids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740312
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740312,
					"content": "Non, plus sérieusement. Ça ne vous dit pas qu'on fasse à nouveau équipe ensemble ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740304,
					"content": "Que faites-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				}
			]
		}
	]
}