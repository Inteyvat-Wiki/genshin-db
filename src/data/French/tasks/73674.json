			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "Ma petite, c'est toi qui m'as amené là, non ? Allez, bouge un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740102,
					"content": "*soupir* Bon, tant pis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740103,
					"content": "Que faites-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "Arf, on dirait qu'on m'a encore bien eu... Je vais tout vous expliquer depuis le début.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740107,
					"content": "Vous n'allez peut-être pas me croire, et j'ignore pourquoi d'ailleurs, mais j'attire toujours les Fées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740108,
					"content": "Parmi celles qui m'ont suivi, j'en ai découvert une sorte qui aime particulièrement la chasse aux trésors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740109,
					"content": "Alors, je les ai appelées les Fées chercheuses. Oui, bon... Je ne suis pas très doué pour trouver des noms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740110,
					"content": "Elles excellent à la chasse aux trésors et grâce à elles, j'en ai dégoté un bon paquet. Ça m'a permis de me faire un peu d'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740111,
					"content": "Néanmoins, je ne sais pas si elles en ont assez de chercher des trésors ou si elles me trouvent ennuyeux, mais voilà que parfois... Elles se mettent à m'ignorer tout à coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740112,
					"content": "Quand ça se produit, je recherche un assistant qui leur plaît pour m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740113,
					"content": "Je le laisse s'occuper de la recherche avec les Fées chercheuses, tandis que je m'occupe de vendre les trésors en argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740114,
					"content": "J'ai entendu dire qu'il y avait des ruines partout à Sumeru, alors j'ai décidé de tenter ma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740115,
					"content": "Après mon arrivée, j'ai de nouveau attiré tout un tas de Fées et les quelques Fées chercheuses de ce groupe m'ont conduit jusqu'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740116,
					"content": "Mais à peine ai-je donné quelques coups de pelles que ces dernières se sont de nouveau mises à m'ignorer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740117,
					"content": "Ah ? Pourquoi se met-elle soudainement à bouger ? Se pourrait-il que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740118,
					"content": "#{M#Voyageur}{F#Voyageuse}, est-ce que ça vous intéresserait de chercher des trésors avec les Fées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740119,
					"content": "Moi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "Vous n'en avez pas besoin, suivez-la simplement et creusez là où elle s'arrête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740122,
					"content": "Qu'en dites-vous ? Essayez pour voir... Si vous trouvez un trésor, vous n'aurez qu'à me donner les sapèques anciennes et garder le reste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740123,
					"content": "De plus, je vous récompenserai comme il se doit pour ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740124,
					"content": "Je peux essayer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "Super ! J'adore les gens comme vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740130,
					"content": "Enfin bref, nous sommes désormais partenaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740131,
					"content": "Tenez, prenez ce carnet. Vous voyez, ce sont des trésors que je n'ai pas eu le temps de déterrer encore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740132,
					"content": "#Je compte sur vous, {M#voyageur}{F#voyageuse}. Et si vous trouvez des sapèques anciennes, n'oubliez pas de me les ramener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740126,
					"content": "Des sapèques anciennes ? Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Pour faire simple, ce sont des antiquités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740128,
					"content": "Si je parle aux bonnes personnes, je pourrai échanger ces sapèques anciennes contre pas mal de bonnes choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740129,
					"content": "Il me reste simplement... à trouver ces personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740120,
					"content": "Mais je ne sais pas comment leur parler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "C'est... une Fée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "Vous parlez d'elle ? Euh... Oui, en quelque sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ulman"
				}
			]
		},
