					"Daimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "#Je suis Daimon des jibashiri. {M#Héros}{F#Héroïne} de Sangonomiya, je vous considère comme digne de relever ce défi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "La bravoure est la capacité de vaincre tous ses ennemis, peu importe la méthode utilisée. Triomphez de tous vos adversaires pour libérer les flammes de la grande porte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Il est nécessaire de préciser que tous les adversaires que vous rencontrerez ne sont que des apparitions produites par les illusions solaires et les images des puissants ennemis qui habitent votre for intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "#Malgré cela, vous serez quand même {M#anéanti}{F#anéantie} si vous vous montrez {M#imprudent}{F#imprudente}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Je vous attendrai à la Tour des Trois Royaumes située un peu plus loin le temps que vous terminiez l'épreuve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
