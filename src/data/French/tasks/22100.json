					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "Comment vais-je me sortir de là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "Quelle idée d'avoir ouvert une auberge ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "Il y a de tout au Marais Dihua : des herbes, des trésors... et des monstres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "Encore heureux, les Millelithes nous ont débarrassé de la plupart d'entre eux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "Mais j'ai l'impression qu'ils reviennent ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "Ils n'osent pas s'approcher de l'auberge, mais personne n'aime les voir traîner dans les environs ; et puis, ils sont plutôt horribles à regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Pourriez-vous les chasser d'ici pour moi ? Ça me rendrait vraiment service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Haha ! J'apprécie votre franchise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "#N'allez pas croire que ça m'enchante de demander une faveur à {M#un client}{F#une cliente}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "Une fois le travail terminé, je vous récompenserai généreusement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Bon courage, et merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "Tout ça parce qu'ils gâchent le paysage ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "À dire vrai... Oui, c'est là le plus gros problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "Certaines personnes, et tout particulièrement un certain jeune homme, recherchent le calme et la tranquillité, et la vue des monstres leur est intolérable... Et dans le cas du jeune homme en question, mieux vaut ne pas le contrarier, ou c'est tout le Marais Dihua qui en pâtira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
