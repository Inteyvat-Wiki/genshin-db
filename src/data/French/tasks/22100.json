						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Excellent ! Merci infiniment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000304,
					"content": "Voici votre récompense. Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000305,
					"content": "Avec un peu de chance, ils ne reviendront pas de sitôt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000306,
					"content": "Vous voulez savoir de qui je parlais ? Allez demander à la patronne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
