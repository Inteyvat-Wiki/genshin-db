			"dialogs": [
				{
					"id": 221000201,
					"content": "Vous avez terminé ? Il n'y a plus de monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Pas encore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Ce n'est pas grave. Pas besoin de se presser, ils gardent leurs distances en général.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Je m'inquiète juste de ce qu'il se passerait si l'un d'entre eux faisait exception à la règle et dérangeait le jeune homme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "Le Marais Dihua serait plongé dans un chaos pas possible, et nous serions obligés de fermer jusqu'à ce que les choses se calment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
