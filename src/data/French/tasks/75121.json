				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "#Quelqu'un m'a {M#envoyé}{F#envoyée} chercher quelques livres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Vous décrivez à Kuroda les livres que souhaite Citlali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "La 1e édition de « Shogun toute-puissante — Comment j'ai été réincarnée en Raiden aux pouvoirs illimités » et l'édition limitée deluxe de « S'il te plaît, ma Guuji Kitsune » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Je dois dire que votre amie en connaît un rayon. En termes de valeur de collection, rien de ce que la Chambre Yae publie actuellement ne peut rivaliser avec les livres que vous recherchez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "Dire que je ne connais pas une lectrice aussi perspicace... C'est vraiment regrettable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Est-ce qu'on peut encore se les procurer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Vous ne trouverez ni l'un ni l'autre sur le marché libre, et encore moins dans les entrepôts. Tous les exemplaires ont été vendus il y a longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Par contre, il se trouve que je possède justement un exemplaire de chaque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Je peux vous les acheter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "Non, non. Ces livres seraient bien mieux en possession de votre amie, quelqu'un qui saura les apprécier à leur juste valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Sachant cela, je serai plus qu'heureux de vous les offrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
