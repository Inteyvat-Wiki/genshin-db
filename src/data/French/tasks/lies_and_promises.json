			"dialogs": [
				{
					"id": 750220801,
					"content": "Yaa, yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Héhé, bien joué ! Voyons maintenant quels cadeaux se cachent dans le coffre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Ah ? Juste un message, pas de trésor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "Oh, donc celui qui a laissé le message était son véritable maître ? Nous n'avons donc pas été trompés par le saurien, mais par son maître ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Quelle irresponsabilité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Oui, même s'il était vraiment malade, comment a-t-il pu abandonner son yumkasaure dans un endroit comme celui-ci ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "Et il voulait même utiliser l'avidité des gens pour... Non, attends, il voulait profiter de l'empathie des gens pour le saurien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "*soupir* Quoi qu'il en soit, nous ne pouvons pas le laisser rester ici pour tromper les gens en leur privant de leur nourriture. Allons trouver le chef des Êtres des canopées pour lui parler de tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Vous racontez ce qui s'est passé à Wayna, le chef des Êtres des canopées, en le ramenant sur les lieux.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "#Oh, j'ai eu un pressentiment quand vous êtes {M#venus}{F#venues} me voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Je ne m'attendais pas à ce qu'il s'agisse du saurien abandonné par ce type.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "Ce type ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "Ouh hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "C'est quelqu'un qui a commis une erreur. Il a quitté la tribu de son plein gré pour éviter son châtiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Mais je ne vais pas m'étendre sur le nom de ce pécheur. Peut-être qu'il a aussi réalisé qu'il n'y avait rien de glorieux là-dedans. Vous voyez, il n'a même pas signé cette lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Donc son saurien a décidé de l'accompagner...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "Ce n'était pas vraiment un choix. Les sauriens sont des créatures pures qui ne font pas facilement la distinction entre le bien et le mal. La plupart du temps, ils suivent leurs sentiments et font confiance à leur compagnon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "... Comme je m'en doutais, il est resté fidèle à sa nature et a utilisé sa ruse pour tromper les autres. Il se sert d'astuces pour tromper les gens, mais aussi son propre saurien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Nous enverrons quelqu'un pour nourrir régulièrement ce yumkasaure, après tout c'est un enfant de la tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "Quant à ce type... Oh, c'est une fin vraiment tragique, mais je ne compatirai pas. Chacun doit assumer la responsabilité de ses actes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Alors, ceux qui mangent trop sont voués à être abandonnés par leurs amis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Ne plaisante pas avec des choses comme ça ! D'ailleurs, le saurien est innocent, peut-être qu'il attend simplement le retour de son maître, c'est pourquoi il refuse de bouger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
