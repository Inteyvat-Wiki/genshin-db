			"dialogs": [
				{
					"id": 750220703,
					"content": "Le yumkasaure avale la nourriture devant lui en un éclair.\\nÀ tel point que vous avez du mal à comprendre comment il a réussi cet exploit...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "I—Il aspire la nourriture !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "On dirait que tu as de la concurrence, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Je pense qu'une seule portion... ne va pas suffire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Mais qu'est-ce que tu racontes ! Je suis un fin gourmet, très pointilleuse en matière de nourriture, et ne m'empiffrerais jamais comme ça... Il faut profiter du goût !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#Je ne m'attendais pas à ce que ce petit bonhomme soit en réalité un gloutonnosaure... Heureusement que {REALNAME[ID(2)|SHOWHOST(true)]} ne mange pas autant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Mais il doit être affamé ! Le pauvre, donnons-lui une autre portion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Ha raouh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} veut aussi quelque chose à manger ? Nous allons d'abord nourrir cet autre petit saurien, puis ce sera ton tour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "Le saurien affamé dévore tout ce qui se trouve devant lui d'un seul coup.\\nVous clignez des yeux devant cette scène très familière.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Bon, il doit avoir assez mangé maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "Quoi, tu en veux encore ? Deux portions n'ont pas suffi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Waouh, et il va vraiment s'installer pour dormir devant la grotte juste après avoir mangé ? Et il n'a pas l'air de vouloir s'écarter du chemin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#Qu'est-ce qu'on fait, {NICKNAME} ? Je ne le comprends vraiment pas... Même s'il veut faire une sieste après avoir mangé, il pourrait le faire sans bloquer le passage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Je pense que ça n'a peut-être jamais été une option pour lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "J'ai l'impression qu'on s'est fait avoir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Et il a aussi mangé une grande partie de nos provisions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Même {REALNAME[ID(2)|SHOWHOST(true)]} ne le supporte pas ! Allez, {NICKNAME}, nous devons essayer de le réveiller !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
