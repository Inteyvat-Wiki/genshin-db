			"dialogs": [
				{
					"id": 750220606,
					"content": "Qu'est-ce que tu marmonnais tout à l'heure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220607,
					"content": "*gargouillis* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Yumkasaure étrange"
				},
				{
					"id": 750220608,
					"content": "Oh, tu as peut-être faim ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "Un saurien ici tout seul et aucun compagnon en vue... Il doit être incapable de trouver de quoi manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#Trouvons-lui quelque chose à manger, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Quand il aura assez mangé, il sera sympa et libérera la route, et le trésor sera à nous ! Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Mais que devrions-nous lui donner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Laisse-moi réfléchir ! Les sauriens ici ont tendance à manger un peu de tout, mais je ne suis pas sûre de ce que mangent les yumkasaures... À en juger par sa couleur, je dirais qu'il est herbivore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Trouvons-lui d'abord ça et voyons s'il aime. Normalement, on n'est pas trop difficile quand on a faim !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
