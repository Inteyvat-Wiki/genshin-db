			"dialogs": [
				{
					"id": 750220404,
					"content": "On ne peut vraiment pas le réveiller ? C'est très embêtant ! Il fait probablement juste semblant de dormir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220405,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "On dirait qu'il ne fait pas semblant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "(Vous racontez ce qu'il a dit dans son sommeil...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "Tu crois qu'il bloque intentionnellement le chemin pour être nourri ? Il s'agit donc simplement de priver les gens de leur nourriture... On s'est vraiment fait avoir comme un bleu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220410,
					"content": "#Mais si c'est comme ça, nous n'avons pas à rester {M#gentils}{F#gentilles} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220411,
					"content": "#Nous pourrions demander à {REALNAME[ID(2)|SHOWHOST(true)]} de creuser un tunnel pour atteindre le coffre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220412,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "S'il ne joue pas dans les règles, je ne vois pas pourquoi nous devrions !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220407,
					"content": "Par contre, il parle en dormant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
			]
		},
