			"dialogs": [
				{
					"id": 728120201,
					"content": "C'est terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Pfiou, je n'ai jamais été aussi épuisé. Cette histoire a-t-elle toujours été aussi compliquée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Voilà ce qui ce passe quand on ne détermine pas les points centraux de l'intrigue dès le début. Sans eux, tout devient un bazar sans nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "Quand ça arrive, tu perds tout contrôle sur ton histoire. Puis, peu importe ce que tu écrirais, tu n'en verrais jamais le bout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "#*soupir* D'accord, j'ai compris... Je n'ai plus la force de me disputer avec toi. Merci pour votre aide, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "J'ai beaucoup appris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Prenez ceci en guise de remerciement. Je vais bientôt me remettre à ma plume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Qu'est-ce qui est le plus important ? L'intrigue ou son cadre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
