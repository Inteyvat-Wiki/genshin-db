					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Une centaine d'années ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Argh ! Arrêtez de parler avec autant de légèreté de mes malheurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Peu importe. Il y a de l'eau qui a coulé sous les ponts. J'ai aussi une petite idée d'où peut se trouver la barrière près de la forêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "À l'époque où je me battais avec cette Kitsune sournoise, je l'ai vue une fois sur la côte est. On dirait un cerisier tonnerre avec un portail torii, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "À l'époque où ce gars luttait contre les démons, j'avais peur que certains d'entre eux sortent pour nous faire du mal. J'ai donc utilisé la magie pour sceller cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Voyons voir... Un sceau sous la falaise à l'est, vous dites... Kichiboushi, emmène-les là-bas et retire le sceau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Merci, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Très bien. Assez parlé. Allez-y maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "Si vous rencontrez cette Kitsune sournoise, n'oubliez pas de la saluer de ma part. Dites-lui juste... Laissez-moi réfléchir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "« Tu m'as vraiment bien eu cette fois, petite vermine. Reviens te battre : notre concours n'est pas encore terminé ! Et aide-moi à briser ce sceau pendant que tu y es, tu veux bien ? Ce n'est pas que je ne peux pas le faire moi-même ou quoi, mais tu me dois une faveur ! En plus, tu manques à Gyoubu Koban ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Waouh, waouh, ça fait beaucoup à se rappeler !",
					"roleType": "TALK_ROLE_NPC",
