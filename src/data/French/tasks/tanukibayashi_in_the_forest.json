		},
		{
			"id": 7210809,
			"completionStepIds": [
				7210807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210807",
							"2"
						],
						"stepId": 7210807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Héhé, bravo ! Ils ont tous l'air contents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080902,
					"content": "... Hmm ? Oh, pas de problème. Je vais leur demander pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080903,
					"content": "Gyoubu Koban vous demande : « Pourquoi avez-vous l'odeur d'un Tanuki si vous êtes des humains ? »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080904,
					"content": "... À vrai dire, il a raison ! Donnez-moi une explication ! Pourquoi vous sentez le Tanuki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080905,
					"content": "Hein ? Vous nous demandez ça que maintenant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080906,
					"content": "C'est la prêtresse masquée...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "C'est vrai ! C'est ce qui est arrivé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080909,
					"content": "Mademoiselle la prêtresse masquée nous a préparé un bon repas avant de venir et elle a dit qu'elle avait utilisé la magie qu'elle avait secrètement apprise du Bake-danuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080910,
					"content": "Quoi ? Elle a appris notre magie en secret ? Comment ose-t-elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080911,
					"content": "Hum, se pourrait-il que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080912,
					"content": "Oh, allez. Cette Kitsune sournoise ! Si elle était encore en vie, elle aurait au moins pu venir dire bonjour, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080913,
					"content": "C'est une prêtresse qui porte un masque et vous appelle « vieil ami ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080914,
					"content": "Un masque ? Je ne connais personne avec un masque, ni de prêtresse. Mais je connais un Kitsune par contre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080915,
					"content": "... Cela dit, cette Kitsune sournoise est déjà apparue sous la forme d'une prêtresse. À quoi ressemblait la prêtresse dont vous parlez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080916,
					"content": "Elle portait un masque de renard blanc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080917,
					"content": "Rien d'autre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080918,
					"content": "Elle avait les cheveux noirs courts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "Elle portait une robe de prêtresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080922,
					"content": "Hmm... Je ne la connais pas. Je n'ai jamais vu quelqu'un comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080923,
					"content": "Vraiment ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080924,
					"content": "... Hmm ? Oui, laissez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080925,
					"content": "Shousei a dit : « C'était amusant de jouer avec toi. Merci ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080926,
					"content": "Je me suis bien amusée aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080927,
					"content": "Alors, à propos de ce peigne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Évidemment, je suis le célèbre Bake-danuki Ioroi, bien sûr que je tiendrai parole. Vous pouvez avoir le peigne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080929,
					"content": "Mais pourquoi avez-vous besoin de ce peigne ? Pour vous coiffer ? Ça sent probablement le Kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080930,
					"content": "Eh bien, voici ce qui s'est passé...",
					"roleType": "TALK_ROLE_NPC",
