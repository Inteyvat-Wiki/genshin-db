			"dialogs": [
				{
					"id": 721080801,
					"content": "Ooh... J'ai envie de me gratter le ventre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080802,
					"content": "Hmm ? Vous êtes déjà de retour ? Allez, aidez-moi à trouver Shousei, Gyoubu Koban et Kichiboushi, et allez <color=#00E1FFFF>jouer avec eux</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080803,
					"content": "Bon, eh bien, allez-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
