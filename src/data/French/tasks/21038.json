			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. Cette photo convient parfaitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "*soupir* Il va bien falloir partir. Bien sûr, il est toujours encourageant d'entendre les gens me dire que « les grands hommes parcourent le monde pour réaliser leur rêve » ou que « mille lieues parcourues valent mieux que mille livres lus »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Pourtant, quand vient le temps de quitter mes terres pour m'en aller au loin, je ne sens aucune impulsion ni courage. Tout ce que je souhaite, c'est rester ici un peu plus longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "#{M#Voyageur}{F#Voyageuse}, pensez-vous que cette excursion me permettra de trouver ce que je recherche ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Je ne saurais le dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Haha... Pas étonnant. Après tout, qu'est-ce que je cherche ? Même moi, je n'en suis pas sûr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "#Bien, c'est l'heure. Je vais rejoindre ce marchand. Veuillez accepter ces récompenses, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Que'er n'est toujours pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Cela dépendra de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Donc... Vous êtes en train de me dire que le destin en décidera, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
