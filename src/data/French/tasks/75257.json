				"objectNames": [
					"Yiztli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "Ça a l'air amusant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "Parfait ! Alors, qui souhaite commencer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570203,
					"content": "Les dames d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570204,
					"content": "Très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570205,
					"content": "Oh, que vous êtes galants. J'aimerais bien prendre une photo avec des jeunes gens comme vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570206,
					"content": "Hein ? Euh, d'accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570207,
					"content": "Ahem, très bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570208,
					"content": "Hm... Attendez, ça ne suffit pas. Je voudrais encore ajouter trois jeunes hommes pour prendre la photo. Vous pourriez arranger ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570209,
					"content": "Oh, et si possible, quelques feux d'artifice. J'adorais ce genre d'ambiance quand j'avais votre âge, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570210,
					"content": "Ça marche, on s'en occupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525703,
