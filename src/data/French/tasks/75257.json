			"dialogs": [
				{
					"id": 752570801,
					"content": "La dernière était très réussie ! C'est enfin votre tour, jeune homme fringant. Quel genre de photo avez-vous en tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Vous êtes observatrice ! Depuis ma naissance, j'accorde une importance primordiale à ma bonne posture et à ma grâce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Sans bonne posture, on manque d'élégance. Sans grâce, on manque de raffinement. Vous comprenez ce que je veux dire, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Euh... Un instant... Ça y est, on peut y aller !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
