			"dialogs": [
				{
					"id": 752570101,
					"content": "Jeune fille, cet endroit semble être en bon état. Pourquoi n'est-il pas ouvert ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Veuillez nous excuser. Malheureusement, notre décorateur a un peu trop bu hier soir et n'a pas pu se présenter au travail aujourd'hui. Pourriez-vous revenir demain ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Ouh là, je ne suis plus toute jeune. Ça va être difficile de refaire tout ce chemin demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Oui, et puis nous avons d'autres choses à faire demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Je suis vraiment désolée. Le principe fondamental de ce coin-photo estival est de personnaliser l'arrière-plan pour chaque visiteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Mais sans notre décorateur, c'est impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Vous avez besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Vraiment ? Vous accepteriez d'aider ? Ce serait formidable ! Ce n'est pas compliqué du tout ! Il suffit de modifier les arrière-plans des photos en fonction des besoins de nos clients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
