			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "Pfiou, c'était la dernière ! Vous m'avez vraiment été d'une grande aide. Sans vous, j'aurais certainement déjà reçu des plaintes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "#Avec plaisir ! Nous sommes des {M#aventuriers}{F#aventurières} qui adorent donner un coup de main.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "#Vous êtes des {M#aventuriers}{F#aventurières} ? Et si je vous prenais en photos {M#tous}{F#toutes} les deux ? Histoire de capturer votre enthousiasme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Allez, souriez ! Natlan est décontractée comme l'été !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Merci encore. Prenez ceci en guise de remerciement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
