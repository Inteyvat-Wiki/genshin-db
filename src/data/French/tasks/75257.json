			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "La dernière était très réussie ! Le suivant est ce grand gaillard des Fatui. Quel genre de photo avez-vous en tête ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "S'il vous plaît, faites-moi poser comme un tireur d'élite. Un seul coup d'œil et les gens sauront que je ne rate jamais ma cible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Comme ça, je n'aurai pas à m'inquiéter d'être classé parmi les derniers au concours de tir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "Ça marche, on s'en occupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
