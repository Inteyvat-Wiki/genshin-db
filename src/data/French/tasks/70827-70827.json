			"dialogs": [
				{
					"id": 708270101,
					"content": "... Ouaf ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270102
					],
					"speakerTitle": "Petit poisson"
				},
				{
					"id": 708270102,
					"content": "#Hein ? Eh, {NICKNAME}, regarde. Ce chiot a l'air vraiment affamé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708270103,
					"content": "Hmm, mais ça n'a pas l'air d'être un chien errant... Tu crois qu'il s'est perdu et qu'il a été séparé de son maître ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708270104,
					"content": "*pleure* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270105
					],
					"speakerTitle": "Petit poisson"
				},
				{
					"id": 708270105,
					"content": "#Je me sens mal de le laisser comme ça. Avoir faim, c'est vraiment horrible... {NICKNAME}, si on a de la viande en trop, on pourrait peut-être lui en donner un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
