						],
						"pointId": 68
					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Fantastique... On a récupéré pratiquement tous les gros déchets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160102,
					"content": "#Désolé de vous avoir fait travailler si dur, Paimon et {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160103,
					"content": "Ne vous excusez pas ! Franchement, on n'a pas vraiment travaillé si dur que ça, on a récupéré plein de choses au fond de l'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Nous avons aidé à restaurer l'environnement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Merci... Grâce à vous, j'ai passé un moment heureux et enrichissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160107,
					"content": "De rien ! C'était un travail d'équipe ! Et puis, je trouve aussi que vous avez beaucoup progressé, Fréminet. Vous êtes devenu très fiable, aussi bien sous l'eau qu'à la surface !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Pas besoin de rougir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "D—D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160111,
					"content": "Je suis désolé. À part vous remercier, je ne sais pas vraiment quoi dire d'autre dans des moments comme celui-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160112,
					"content": "Peut-être... qu'il faut que je m'entraîne encore un peu plus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160113,
					"content": "Prenez votre temps, inutile de vous presser. Même pour vous exercer, allez-y à votre rythme et faites les choses petit à petit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Si l'occasion se présente, collaborons à nouveau à l'avenir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "D'accord, c'est entendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160117,
					"content": "... Maintenant que le nettoyage est terminé, je comptais retourner sous l'eau pour passer un peu de temps seul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160118,
					"content": "Mais c'est étrange... Après avoir discuté avec vous, même le ciel semble beaucoup plus paisible. J'avais envie de partager ce sentiment avec vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160119,
					"content": "Quoi qu'il en soit... je ferais mieux de rejoindre Lyney et les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160120,
					"content": "Je vous laisse le reste des données d'exploration sous-marine. J'espère qu'elles vous permettront de trouver ce que vous cherchez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160121,
					"content": "Hé, je pouvais vous entendre célébrer depuis en haut. Il s'est passé quelque chose de bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160122,
					"content": "Oui ! Nous avons presque entièrement nettoyé les déchets qui perturbaient la vie des poissons, et nous avons aussi retrouvé les pièces manquantes du piano !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Vraiment ? Laissez-moi voir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160124,
					"content": "... Eh bien, parfait. Avec ça, je vais enfin pouvoir réparer ce piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160125,
					"content": "Il ne sera peut-être plus exactement comme avant, mais il pourra à nouveau produire de la jolie musique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160126,
					"content": "Vous avez l'air vraiment heureuse, Sandrone !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "V—Vous trouvez ? Peu importe, je vais le réparer tout de suite. Ça ne devrait pas me prendre longtemps. En attendant, pourriez-vous vous occuper un peu de la décoration ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160128,
					"content": "Un instrument aussi merveilleux mérite une scène digne de ce nom pour le mettre en valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160129,
					"content": "Elle a l'air vraiment heureuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Ouah ! Quel magnifique piano !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "C'est très élégant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hmph, évidemment. Et puis, c'est moi qui l'ai réparé, je vous signale ! J'ai aussi renforcé les mécanismes internes et retravaillé son apparence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160134,
					"content": "#Vous ne vous en êtes pas mal {M#sortis}{F#sorties} non plus, {M#tous}{F#toutes} les deux. Cette scène est vraiment digne de ce piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160135,
					"content": "Héhé, ce n'était rien ! Bon, assez papoté. Vous n'allez pas nous jouer un morceau maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "... Hein ? Maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160137,
					"content": "Si pas maintenant, quand ça ? Vous avez réparé ce piano pour en jouer, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Et si... on réservait ça pour un autre jour ? J'aurai bien d'autres occasions d'en jouer plus tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160139,
					"content": "Vous avez oublié votre partition ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hmph... N'importe quoi ! Je... Je veux juste rester un moment tranquillement avec lui et me replonger dans les souvenirs du passé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160142,
					"content": "Et ne croyez pas que quelques provocations suffiront à me faire jouer. Hmph, il faut d'abord s'entraîner avant de livrer une performance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160140,
					"content": "Ou alors... Vous avez le trac ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "C'est superbe !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Si vous avez besoin d'aide, vous pouvez toujours compter sur nous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "Et nous avons trouvé plein de trésors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}