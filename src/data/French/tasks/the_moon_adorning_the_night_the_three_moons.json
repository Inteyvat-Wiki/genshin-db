						],
						"pointId": 360300034
					}
				]
			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540302,
					"content": "Hmm, je réfléchis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540303,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540304,
					"content": "Lunes... Lunes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540305,
					"content": "Ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540306,
					"content": "On dirait que j'ai gagné cette partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540307,
					"content": "Mes trois lunes sont alignées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540308,
					"content": "Hm, cela devrait faire l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540309,
					"content": "Mm... Les lunes croissent et décroissent. C'est un cycle sans fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540310,
					"content": "Les deux lignes de lunes refusent de s'éclipser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540311,
					"content": "Est-ce un match nul ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540312,
					"content": "Ah, je vois que vous réfléchissez bien avant d'agir. Prenez votre temps, ce n'est pas ce qui nous manque ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540313,
					"content": "Avez-vous oublié comment placer vos lunes dans le ciel nocturne ? Avez-vous besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540314,
					"content": "Vous n'aimez pas ce jeu ? Je le trouve plutôt amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540315,
					"content": "#Hm ? Vous me fixez ? Vous n'êtes pas très {M#subtil}{F#subtile}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540316,
					"content": "Vous me fixez... La vérité des lunes est-elle écrite sur mon visage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540317,
					"content": "Le plateau est par là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540318,
					"content": "Hm, vos lunes sont alignées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540319,
					"content": "Le ciel nocturne est à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540320,
					"content": "Ah... j'ai dû faire une erreur quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540321,
					"content": "Vous passez un agréable moment en jouant avec Columbina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Les trois lunes, alignées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210203,
					"content": "Hmm ? Vous pensez encore à la dernière partie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Oh, non. C'est juste que... Quand je repense à cette partie, j'ai une drôle de sensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210205,
					"content": "Oh, c'est vrai. Maintenant que vous possédez le pouvoir des trois lunes, vous êtes devenue bien plus que quelque chose qui domine le ciel nocturne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Oui, je pense aussi que... le destin du monde aurait pu être différent s'il n'y avait pas eu de désaccord entre les trois Déesses de la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210207,
					"content": "À quoi ressemblaient-elles ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "La première que j'ai vue était Sonnet, Déesse de la Lune irisée. Elle était plus dynamique que je ne l'imaginais, une petite sœur espiègle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210209,
					"content": "Aria de la Lune éternelle était la plus mûre des trois. C'était une meneuse née, qui se montrait particulièrement douce avec les autres. Ah, comme Lauma, en fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210210,
					"content": "Quant à Canon de la Lune de givre... elle avait l'air à la fois sage et clairvoyante. C'est elle qui m'a confié sa lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210211,
					"content": "On dirait que c'étaient toutes des divinités bienveillantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Oui. Malgré leurs différences, elles aimaient Teyvat, et l'aiment toujours. C'était leur foyer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210213,
					"content": "Quand je leur ai raconté ce qu'il allait se passer, elles avaient l'air soulagées et heureuses que ce monde ait un avenir aussi prometteur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210214,
					"content": "C'est aussi pour ça qu'elles m'ont donné le pouvoir de rentrer « chez moi ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210215,
					"content": "Hum... j'aimerais bien les voir pour les remercier comme il se doit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "J'aimerais beaucoup aussi, mais j'ai bien peur que ce ne soit plus possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210217,
					"content": "Heureusement, ce monde continue d'avancer, et les humains qu'elles ont protégés ont survécu pour transmettre leurs histoires jusqu'à aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210218,
					"content": "Exactement ! Tant qu'on vit et qu'on empêche les méchants de détruire le monde, c'est la meilleure façon de les remercier !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Tu as vraiment un don pour les mots, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Dans ce cas, tu les remercies tous les jours...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "#Bien sûr ! Tu peux être {M#sûr}{F#sûre} que je profite toujours de la vie au maximum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Vous aussi, Columbina ! Mangez bien, dormez bien tous les jours, et venez nous voir quand vous voulez jouer avec nous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210224,
					"content": "Je pense que désormais, ces trois douces déesses me viendront à l'esprit chaque fois que je jouerai aux échecs lunaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
