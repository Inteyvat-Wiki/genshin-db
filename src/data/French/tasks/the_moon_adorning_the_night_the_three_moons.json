			"dialogs": [
				{
					"id": 761210101,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210102,
					"content": "Bonjour, Columbina ! Vous avez l'air de bonne humeur aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Hah... Montez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210104,
					"content": "Vous voulez faire une partie d'échecs lunaires ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Volontiers. Ça fait un moment, et le jeu me manque un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210106,
					"content": "Les règles sont-elles les mêmes qu'avant ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Ou pouvez-vous déplacer plusieurs pièces par tour maintenant parce que vous êtes la Déesse trilunaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Ce serait de la triche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210109,
					"content": "Héhé, je sais ! Je plaisantais juste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "On commence ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
		{
