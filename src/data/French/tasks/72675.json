			},
			"dialogs": [
				{
					"id": 722641401,
					"content": "Hmm ! L'entraînement, très bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641402,
					"content": "Tant mieux si tu es content.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "#Poil jaune très {M#fort}{F#forte}. Boum boum, et grand truc rond plus là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641404,
					"content": "C'est parce que je m'entraîne régulièrement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "Hmm ! Je veux aussi fort que poil jaune !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641406,
					"content": "Alors, entraînement ! Entraînement, devenir fort-fort !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641407,
					"content": "Kichiboushi, que comptes-tu faire quand tu seras devenu fort ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Me venger de Gyoubu Koban, mouhaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641409,
					"content": "Faire en sorte Ioroi plus pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641410,
					"content": "Bonne chance, alors. Quant à nous, on s'occupe de ton parcours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Hmm !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641412,
					"content": "Tant mieux si ça te plaît. On se voit plus tard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
		{
			"id": 7267501,
			"completionStepIds": [
				7267501
