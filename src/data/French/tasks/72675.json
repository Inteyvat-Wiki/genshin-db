			"dialogs": [
				{
					"id": 726750601,
					"content": "Pour la suite, que dirais-tu d'emmener Kichiboushi sur l'Alcor ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750602,
					"content": "C'est pas bien. Si bateau coule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750603,
					"content": "Ce bateau ne coulera pas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "C'est ce bateau-là qu'on a pris pour aller à Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "Oui ! Et c'est comme ça qu'on vous a connus, Ioroi et toi. Ne t'inquiète pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750606,
					"content": "Ah, d'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750607,
					"content": "Et puis, on peut toujours avoir confiance en Beidou et le Crux. Donc ne t'en fais pas, ce bateau est l'endroit le plus sûr en mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750608,
					"content": "Hmm ! D'accord !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
