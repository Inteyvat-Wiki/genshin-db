			"dialogs": [
				{
					"id": 726750301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750302,
					"content": "Pas doré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750303,
					"content": "Hé ? Incroyable, il n'est pas doré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750304,
					"content": "Vous dites ça, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "En y repensant, c'est vrai qu'on a attrapé plein de papillons cristallins en voyageant ensemble. Et pourtant, je n'y avais jamais fait attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "J'ai le sentiment... d'avoir grandi soudainement et que mes illusions ont été brisées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "On dirait bien que c'est aussi un voyage initiatique pour Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "Courage, poil blanc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750310,
					"content": "Hé, ne me souhaite pas bon courage ! C'est toi qui dois suivre une initiation Kichiboushi, pas moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Mais je suis quand même déçue... Comment se fait-il que les noyaux des papillons cristallins Géo ne soient pas dorés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Oui. Les papillons cristallins dorés. Pourquoi ça, pas doré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750313,
					"content": "Peut-être que les papillons cristallins sont tout simplement comme ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Bon... Ça ne fait rien. Continuons notre chemin. Emmenons Kichiboushi voir l'Alcor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "Je ne sais que répondre à cette question...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "Je n'y peux rien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
		{
			"id": 7267504,
