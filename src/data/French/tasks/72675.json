			"dialogs": [
				{
					"id": 726750801,
					"content": "Regarde ! La vue est belle, tu ne trouves pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750802,
					"content": "Hmm, c'est super.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750803,
					"content": "Beaucoup de montagnes là-bas. C'est quoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750804,
					"content": "Ah ? Là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750805,
					"content": "C'est Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "C'est ça ! Là-bas, c'est le Mont Yougou. Et juste en dessous, c'est la Forêt de Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750808,
					"content": "Loin. Ioroi là-bas, à l'autre bout de la mer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750809,
					"content": "Oui, mais on est là pour t'accompagner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750810,
					"content": "Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750811,
					"content": "Où est-ce qu'on devrait aller ensuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750812,
					"content": "Hmm, y a-t-il un endroit qu'on connaît bien avec de bonnes choses à manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750813,
					"content": "Tu ne penses qu'à manger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "Bonnes choses à manger, oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750815,
					"content": "#Tu vois, {NICKNAME} ? Kichiboushi a tout compris, lui. Manger toute la délicieuse nourriture du monde entier, c'est une initiation très importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750816,
					"content": "#Si tu n'es pas capable de comprendre cela, tu vas vite te retrouver {M#dépassé}{F#dépassée} par Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750818,
					"content": "Pfiou, c'est vraiment fatigant d'escalader un mât.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750819,
					"content": "Poil blanc escalade ? Mais tu sais voler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750820,
					"content": "Ne fais pas attention à ce genre de détails !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750821,
					"content": "Bref, on va s'arrêter là pour aujourd'hui. Je vais réfléchir au prochain endroit où nous irons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750822,
					"content": "Hmm !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750817,
					"content": "Tout cela m'a donné faim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "C'est là où tu habites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
