			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "C'est pas comme Dosdragon. Pas froid. Pas de neige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750102,
					"content": "Nous voici dans la Forêt de pierre de Guyun ! La légende raconte que c'est ici que le Souverain de la Roche a vaincu le... serpent aquatique avec plein de têtes, il s'appelle comme déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "Le Dieu du Vortex ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "Ah, oui ! Ortell, le Dieu du Vortex ! C'est donc ici qu'il succomba sous les coups des lances de pierre du Souverain de la roche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "Waouh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750107,
					"content": "Héhé, impressionnant, n'est-ce pas ? On s'est aussi battu contre ce serpent ! On était avec Ningguang à la Chambre de Jade et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "Papillon cristallin doré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750109,
					"content": "Ah, tu t'émerveillais pour ça... Hé, écoute-nous quand on te parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Ils sont différents des papillons cristallins d'Inazuma, après tout...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Il n'a jamais dû voir un papillon cristallin qui ne soit pas violet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Oui, c'est vrai... {NICKNAME}, va lui attraper un papillon cristallin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "Pourquoi tu n'irais pas en attraper un toi-même ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "#Mais, euh... C'est toi qui es {M#le plus habile}{F#la plus habile}, ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "Je peux le faire, mais je ne peux attraper que leurs noyaux cristallins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750115,
					"content": "C'est pourtant toi qui sais voler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Mais c'est toi qui as l'habitude d'attraper des papillons cristallins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750117,
					"content": "Bon, d'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "Ortell ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
