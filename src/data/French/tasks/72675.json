			"dialogs": [
				{
					"id": 726750401,
					"content": "Regardez, c'est l'Alcor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750402,
					"content": "Très fort ! Plein d'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750403,
					"content": "Et puis, c'est grand ! C'est grand et sur l'eau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750404,
					"content": "Si c'est grand, c'est lourd. Pourquoi il coule pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750405,
					"content": "C'est parce que l'Alcor est un bateau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "Mais... Bateaux en boue coulent. Ioroi m'a raconté l'histoire. Histoire du lapin, du Bake-danuki et du bateau de boue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750407,
					"content": "Oui, mais... l'Alcor n'est pas fait de boue, donc il ne coulera pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "Pourquoi bateaux pas en boue ne coulent pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750409,
					"content": "Tu t'exprimes de mieux en mieux, Kichiboushi... Mais je ne sais pas quoi te répondre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#Héhé, {NICKNAME}, testons tes connaissances. Comment font les bateaux pour flotter à la surface de l'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Les bateaux sont faits de bois. L'élément Dendro est puissant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Hein ? L'élément Dendro peut faire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Oh... Mais alors, pourquoi les Brutocollinus avec des boucliers ne flottent-ils pas sur l'eau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Hmm hmm, comprends pas, moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750417,
					"content": "Ce n'est pas grave. Quand tu seras grand, tu seras aussi intelligent que moi ! Tu comprendras pourquoi un bateau peut flotter sur l'eau, ou pourquoi il neige sur les Monts Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "Euh... Toi non plus, tu ne sais pas pourquoi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "Hé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "Passons. On peut voir l'Alcor d'ici. Prends une photo-souvenir de Kichiboushi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "Photo-souvenir ! Portrait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750424,
					"content": "Oui, tu as tout compris. Alors reste ici et ne bouge pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "Ce n'est pas grave de ne pas comprendre certaines choses immédiatement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "Ce n'est pas si grave de ne pas comprendre certaines choses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "La flottabilité d'un objet doit être supérieure à la gravité pour pouvoir flotter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "Ah, c'est donc ça ! Je comprends maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
