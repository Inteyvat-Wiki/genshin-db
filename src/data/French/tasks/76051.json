			"dialogs": [
				{
					"id": 760510301,
					"content": "Ça devrait aller, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "~ ~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Oh ! Elle peint déjà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "#Ahem... {M#Chers}{F#Chères} juges, préparez-vous à être {M#émerveillés}{F#émerveillées} ! Quel chef-d'œuvre notre talentueuse artiste kuuhenki va-t-elle nous montrer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Hein ? C'est déjà fini ? Je n'ai même pas eu le temps de finir mon introduction !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Voyons voir. Oh ! C'est une autre peinture de Columbina. Pas de surprise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "C'est très beau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Est-ce que c'est... une forêt quelque part à Nod-Krai ? Il y a beaucoup d'animaux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "J'ai bien peur que... cela remonte à l'époque avant que je quitte les Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510312,
					"content": "Je suis jalouse ! Ces animaux se sont-ils vraiment rassemblés autour de vous comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Oui, la plupart d'entre eux étaient attirés par le kuuvahki qui m'enveloppait, et ils se sentaient en sécurité en se blottissant contre moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510314,
					"content": "C'est génial ! Vous pouviez les caresser autant que vous le vouliez sans qu'ils s'enfuient !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Hm... Je trouvais les blaireaux chics les plus agréables à caresser. Ils ont une grande queue duveteuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510316,
					"content": "La fourrure du cou d'un cerf aux cornes givrées est également très douce. C'est un oreiller très confortable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510317,
					"content": "Lequel préférez-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510318,
					"content": "On n'a pas vraiment eu ce genre d'expérience, alors c'est difficile de répondre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Mais je pense que je préférerais caresser la queue d'un blaireau chic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Les blaireaux chics sont de nature assez timide. Il faut qu'ils se sentent en sécurité auprès de vous d'abord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510321,
					"content": "Ah... Mais je serais prudente à votre place, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510322,
					"content": "Pourquoi ? Ils mordent ? Je promets d'être douce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "Je voulais parler du danger qui vient du ciel ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510324,
					"content": "Du ciel ? C'est-à-dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Les ibis longplumés chassent souvent ces petits animaux. J'ai dû les avertir d'arrêter de poursuivre les kuuhenkis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510326,
					"content": "C'est maintenant que vous me le dites ?! C'est un miracle que je sois encore là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah... La prochaine fois, je leur dirai de vous laisser tranquille aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510328,
					"content": "La prochaine fois ? Faites-le maintenant, ou j'aurais trop peur de franchir cette porte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Dans ce cas, je m'assurerai de leur dire que vous êtes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510330,
					"content": "La meilleure des meilleures amies du monde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Voilà ! Ils ne peuvent pas emporter les amis des gens comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "Cette petite semble curieuse de savoir à quoi ressemblerait Paimon emportée par un ibis longplumé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510338,
					"content": "Ne pense même pas à peindre la scène...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "La meilleure guide de voyage en Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Euh, ça me touche, mais je ne crois pas qu'ils sachent ce qu'est un guide de voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Une source de nourriture qui pourrait leur donner des maux d'estomac.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "Non, il ne faut pas leur dire ça ! Et s'ils voulaient quand même goûter ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "#Le simple fait de le regarder me rend {M#heureux}{F#heureuse}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
