			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Je pense que je vais rester encore un peu ici. Le spectacle n'est pas tout à fait terminé dans mon for intérieur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Oh, mais si vous vouliez discuter, je serais ravie également.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "Que comptez-vous faire ensuite ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka et les autres comptent toujours sur moi pour aller à la chasse au grand démon mujina. Je suis comme une grande sœur pour eux, je ne peux pas revenir sur ma parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Je veux aussi aller demander à tout le monde ce qu'ils ont pensé du feu d'artifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "Et au cours des prochains jours, j'aimerais également remercier tous ceux qui m'ont soutenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Ce qui vous inclut avec Paimon, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "Est-ce que c'est cher les feux d'artifice ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Pour vous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "C'est gratuit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "#Après tout, c'est moi qui ai insisté pour vous en donner, et je vous ai {M#entraîné}{F#entraînée} avec moi et vous ai causé tout un tas de problèmes. Héhé, je me sentirais mal si je vous faisais payer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Vous êtes sûre ? Ça me met mal à l'aise...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#C'est bon... Écoutez, que diriez-vous de faire un marché : quand vous aurez retrouvé votre {F#frère}{M#sœur}, vous n'aurez qu'à lui dire de venir aux Feux de Naganohara pour tous ses feux d'artifice. Comme ça, j'aurai un client de plus. Ça vous va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "#Et puis, j'aimerais beaucoup {F#le}{M#la} rencontrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "Et si la Commission administrative venait vous causer plus de problèmes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Je leur botterais les fesses à nouveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Hahaha, je plaisante. Ne vous ai-je pas dit que ma famille s'occupait souvent des Commissions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "On s'en sort facilement habituellement. Au pire, on doit s'excuser, sourire et payer une amende. Ce n'est pas la fin du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "#Vous devriez faire attention cependant. Sans les mêmes relations, vous ne pouvez pas vous permettre d'être aussi {M#imprudents}{F#imprudentes} que moi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}