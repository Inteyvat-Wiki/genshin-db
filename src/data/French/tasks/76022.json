			"dialogs": [
				{
					"id": 760220101,
					"content": "Se battre est inutile, vous ne ferez que verser du sang. Laissez vos moras et partez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "Samouraï énervé"
				},
				{
					"id": 760220102,
					"content": "À l'aide ! Au secours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220103,
					"content": "Hé, on doit l'aider !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
