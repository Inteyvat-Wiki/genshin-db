							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Merci beaucoup de m'avoir sauvé ! Je suis Peco, un marchand itinérant. Si vous passez par mon magasin à l'avenir, je vous ferai profiter des meilleures offres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "C'est vraiment pas mon jour aujourd'hui... Il a fallu que je tombe sur cette soi-disant légende dont tout le monde parle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "Une légende ? Ce type est connu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Pas dans le bon sens du terme. Une rumeur circule parmi les commerçants... Quelques collègues ont dit qu'après l'avoir croisé, ils ont juré de ne plus jamais emprunter cette route. Je ne les ai pas crus, j'ai pensé qu'ils exagéraient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Vous êtes plus courageux que vous en avez l'air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "On voit toutes sortes de choses en tant que marchand itinérant, vous savez ? Parfois, certaines histoires sont un peu exagérées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Enfin bref, ils l'appellent « Gonpachi ». La rumeur dit qu'il a commis un délit à Inazuma et a fui jusqu'ici avec sa bien-aimée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Cette « Murasaki » dont il n'arrêtait pas de parler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "C'est vrai ! Ce type bizarre n'arrêtait pas de répéter ce nom pendant le combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Une fois que l'on s'est écarté du droit chemin, c'est difficile de revenir sur la bonne voie, même dans un nouvel endroit. Sans travail honnête, on finit toujours par retourner au point de départ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Ce mode de vie pourrait convenir à un loup solitaire. Mais quand on vit l'épée à la main... Tôt ou tard, on finit par croiser la mauvaise personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "J'ai entendu dire que c'est comme ça que sa bien-aimée a perdu la vie. Depuis, eh bien... Il est devenu fou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "*soupir* C'est horrible de voler les gens, mais... Je me sens un peu mal de savoir comment il en est arrivé là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Ne fais jamais de folie à cause des moras, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "Hé ! Là n'est pas la question !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "Très bien, je ne vous retiendrai pas plus longtemps. S'il vous plaît, prenez ceci en gage de ma gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "Si Paimon se fait voler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Heureusement que tu es toujours à mes côtés, {NICKNAME}, {M#gardien}{F#gardienne} de mes moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}