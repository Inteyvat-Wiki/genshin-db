				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "Hé ! Grand gaillard ! Qu'est-ce que vous pensez faire ? Arrêtez tout de suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Des moras... Non, non ! La personne qui a tué Murasaki... Vous allez payer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Samouraï énervé"
				},
				{
					"id": 760220203,
					"content": "#Waouh ! Attention, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
