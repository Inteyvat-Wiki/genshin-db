			"dialogs": [
				{
					"id": 760540301,
					"content": "Comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540302,
					"content": "Hmm, je réfléchis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540303,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540304,
					"content": "Lunes... Lunes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540305,
					"content": "Ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540306,
					"content": "On dirait que j'ai gagné cette partie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540307,
					"content": "Mes trois lunes sont alignées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540308,
					"content": "Hm, cela devrait faire l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540309,
					"content": "Mm... Les lunes croissent et décroissent. C'est un cycle sans fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540310,
					"content": "Les deux lignes de lunes refusent de s'éclipser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540311,
					"content": "Est-ce un match nul ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540312,
					"content": "Ah, je vois que vous réfléchissez bien avant d'agir. Prenez votre temps, ce n'est pas ce qui nous manque ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540313,
					"content": "Avez-vous oublié comment placer vos lunes dans le ciel nocturne ? Avez-vous besoin d'aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540314,
					"content": "Vous n'aimez pas ce jeu ? Je le trouve plutôt amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540315,
					"content": "#Hm ? Vous me fixez ? Vous n'êtes pas très {M#subtil}{F#subtile}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540316,
					"content": "Vous me fixez... La vérité des lunes est-elle écrite sur mon visage ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540317,
					"content": "Le plateau est par là-bas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540318,
					"content": "Hm, vos lunes sont alignées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540319,
					"content": "Le ciel nocturne est à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540320,
					"content": "Ah... j'ai dû faire une erreur quelque part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540321,
					"content": "Vous passez un agréable moment en jouant avec Columbina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Merci, je me suis beaucoup amusée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540323,
					"content": "Si vous le souhaitez... n'hésitez pas à venir me tenir compagnie à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540324,
					"content": "Voici un souvenir de notre promesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
