			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "#Nous nous retrouvons de nouveau, {M#cher aventurier}{F#chère aventurière}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310102,
					"content": "Tes aventures se passent bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310103,
					"content": "Très bien !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "C'est top ! Continue comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310107,
					"content": "Maintenant que tu as un peu plus d'expérience, je vais t'expliquer le vrai travail de la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310108,
					"content": "Nous recevons des ordres de <color=#00E1FFFF>mission</color> des quatre coins de Teyvat, tous les jours. Ensuite, nous les assignons à nos membres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310109,
					"content": "Ces missions sont leur gagne-pain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310110,
					"content": "Quel genre de missions ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Il y a de tout ! De la livraison de marchandise à de la chasse de monstres. Certaines sont tranquilles mais d'autres peuvent être carrément dangereuses !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310112,
					"content": "Le mieux c'est que tu voies par toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310113,
					"content": "Tu peux voir le détail des quêtes d'aujourd'hui ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310114,
					"content": "Reviens me voir quand tu en auras terminé une. Une récompense t'attendra ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310115,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Excellent, {NICKNAME} ! On peut toujours te faire confiance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310119,
					"content": "#J'attendrai ton retour avec impatience, {NICKNAME}. Vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310117,
					"content": "J'espère que cette récompense sera très généreuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "#Tu verras bien ! En tout cas, je suis sûre que tu ne seras pas {M#déçu}{F#déçue} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310105,
					"content": "C'est fatigant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "C'est toujours comme ça quand on débute. Une bonne préparation avant le départ facilite beaucoup de choses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Catherine"
				}
			]
		},
