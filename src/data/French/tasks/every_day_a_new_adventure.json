			"dialogs": [
				{
					"id": 200310201,
					"content": "#Excellent travail, {NICKNAME} ! J'ai du mal à croire que c'était ta première fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310202,
					"content": "Le commanditaire m'a même demandé de te remercier de sa part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310203,
					"content": "Chose promise, chose due ! Voici ta récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				}
			]
