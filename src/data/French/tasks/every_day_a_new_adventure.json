			"dialogs": [
				{
					"id": 200310301,
					"content": "Merci bien ! Héhé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310302,
					"content": "Prends ça en cadeau de la part de la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310303,
					"content": "Nous recevons des missions tous les jours et c'est grâce à nos membres que nous arrivons à les accomplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310304,
					"content": "Si tu arrives à terminer suffisamment de missions quotidiennes, tu auras droit à des récompenses spéciales de ma part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310305,
					"content": "N'oublie pas, tout est répertorié dans ton Guide de l'aventurier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310306,
					"content": "Récupère tes récompenses quotidiennes le jour même où tu finis les missions. Il y a une quantité limitée de récompenses, donc elles seront perdues si tu ne les réclames pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310307,
					"content": "Reçu 5/5, merci !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "Je t'en prie. Ton aide m'est précieuse après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310312,
					"content": "Ah, si tu aides un autre aventurier à terminer une mission, ça compte aussi pour les récompenses quotidiennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310313,
					"content": "Alors n'hésite pas à coopérer avec les autres. Vers les étoiles et au-delà !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310309,
					"content": "Je ne peux recevoir les récompenses quotidiennes qu'une fois par jour ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "Oui, désolée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310311,
					"content": "En tout cas, on essaye de faire bouger les choses au siège pour que nos aventuriers puissent être davantage rémunérés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Catherine"
				}
			]
		},
