			"dialogs": [
				{
					"id": 200310401,
					"content": "#Salut {NICKNAME}. J'ai entendu dire quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310402,
					"content": "Tu as terminé toutes les <color=#00E1FFFF>missions</color> et je te remercie de la part des commanditaires !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310403,
					"content": "Qui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310404,
					"content": "La personne que tu as aidée à traverser sur ton chemin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310405,
					"content": "Beaucoup de gens que tu rencontres au quotidien nous confient certaines missions à la Guilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310408,
					"content": "Je vais t'expliquer le système de notre Guilde plus en détail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310409,
					"content": "Nous recevons des ordres de mission des quatre coins de Teyvat, tous les jours. Ensuite, nous les assignons à nos membres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310410,
					"content": "Ces missions sont leur gagne-pain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310411,
					"content": "En parlant de ça, nous avons quelque chose pour toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310406,
					"content": "C'était juste ma B.A. de la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 200310407,
					"content": "Toujours fidèle à toi-même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Catherine"
				}
			]
