					"nextDialogs": [
						741930516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930516,
					"content": "Tu prends un peu de ton lendemain pour nous le donner et nous, on t'en donne un peu du nôtre. C'est comme ça qu'on se reverra ! Alors ? Est-ce que tu as compris ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930517,
					"content": "Demain... Échange... Demain ! Pahsiv !",
