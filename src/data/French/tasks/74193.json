			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#Paimon ! {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930102,
					"content": "C'est toi, Pahsiv ! Contente de te revoir ! Qu'est-ce que tu fais ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930103,
					"content": "Pahsiv... travaille ! Pahsiv... fatigué ! Pahsiv... repos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930104,
					"content": "Oh ? Tu travailles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930105,
					"content": "Branches brumeuses... Branches brumeuses... Très beaucoup perdues !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930106,
					"content": "Hmm ? C'est quoi, une branche brumeuse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930107,
					"content": "Branches brumeuses... Informations !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930108,
					"content": "Saule, collecte. Brume, traite. Source, envoie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930109,
					"content": "Branches brumeuses... Informations de la brume !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930110,
					"content": "Ce sont donc des informations à propos du Chemin forestier brumeux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930112,
					"content": "Branches brumeuses... Très beaucoup perdues ! Très beaucoup d'endroits !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930113,
					"content": "Pahsiv... cherche ! Pahsiv... fatigué ! Pahsiv... mange ! Pahsiv... repos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930114,
					"content": "Branches brumeuses... Pas très beaucoup ! Mais boîtes, très beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930115,
					"content": "#Ah... Merci Paimon et {NICKNAME}, voici pour vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930116,
					"content": "Tu nous as encore trouvé un coffre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "Pahsiv ! Boîte, trésor, fleurs, brillantes, sucrées, très beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930118,
					"content": "Ouah, il y a d'autres trucs ? Tu es très gentille, Pahsiv, mais on ne devrait pas accepter tout ça gratuitement. Et si on faisait un échange ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930119,
					"content": "É... change ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930120,
					"content": "#Oui ! Nous sommes {M#amis}{F#amies} et les amis s'échangent des cadeaux de bonté de cœur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930121,
					"content": "Du coup, on va t'aider à trouver tes branches brumeuses en échange de ce que tu nous donnes. Ça te va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930122,
					"content": "On peut aussi t'apporter à manger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "C'est une bonne idée ! Tu as du mal à chercher de la nourriture, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930124,
					"content": "Manger ! Maréalgues ! Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930125,
					"content": "Tu aimes les maréalgues ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "Maréalgue ! Maréalgue ! Maréalgue, maréalgue, maréalgue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930127,
					"content": "Ça veut dire 5 repas par jour ou 5 maréalgues par jour ? Tu es plus gloutonne que moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930128,
					"content": "Et les branches alors ? On peut en trouver en suivant le chemin forestier brumeux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930129,
					"content": "Mélusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930130,
					"content": "Branches brumeuses... Très beaucoup perdues ! Très beaucoup d'endroits ! Très beaucoup Erinnyes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930131,
					"content": "Il y a des branches sur toute l'Île d'Erinnyes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#{M#Intelligent}{F#Intelligente} {NICKNAME} ! Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930133,
					"content": "Chemin brumeux, avec fleurs. Branches, aussi avec fleurs !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930134,
					"content": "Branche, branche, branche, branche, branche, branche... Quantité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930135,
					"content": "Ah... Oh, je comprends. Les branches sont aux endroits où poussent des fleurs identiques, comme le chemin forestier brumeux, et il y en a six ? C'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930136,
					"content": "Intelligente, Paimon ! Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930137,
					"content": "Héhé, je crois qu'on s'est comprises. Repose-toi, Pahsiv. On se charge de la suite !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930138,
					"content": "#Paimon, {NICKNAME}, bonne chose ! Lentement, lentement ! Pahsiv !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
