			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#Oh, mais c'est notre {M#cher}{F#chère} {NICKNAME} ! Ça tombe bien, on voulait prendre un verre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "#Quel plaisir de vous rencontrer ici, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080103,
					"content": "Que faites-vous ici toutes les deux ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Hum, vous êtes venues ensemble ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "Cette grande dame a voulu prendre des congés sur un coup de tête, alors on a décidé de voyager un peu dans le coin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "Par contre, notre vision des vacances n'est pas tout à fait la même. On se repose déjà alors qu'il n'y avait pas beaucoup de montagnes sur la route. Les riches, je vous jure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "Nul besoin de dire des choses aussi blessantes. De plus, j'ai précisément choisi cet endroit car je sais que vous appréciez boire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080108,
					"content": "Mais il semblerait que cette petite taverne ne soit pas au goût de notre illustre capitaine qui a parcouru monts et mers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080109,
					"content": "Ça va. C'est ma tournée aujourd'hui, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "C'est vous qui payez, Beidou ? Est-ce que ça nous inclut aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "#Paimon, nous ne sommes pas des {M#clients}{F#clientes} aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Ah oui, j'avais oublié. Pardon, c'est une de mes habitudes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "Qu'est-ce que je peux vous servir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Je prendrais bien un petit verre de sève d'érable plus acidulée que d'habitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080115,
					"content": "Une grande tasse de crépuscule pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "C'est noté. Je reviens tout de suite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
