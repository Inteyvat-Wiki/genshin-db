			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang",
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080203,
					"content": "A—Alors ? Comment c'est ? Votre silence m'inquiète !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080204,
					"content": "Hmm... Il y a un goût de nostalgie mêlant douceur et amertume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080205,
					"content": "Qu'est-ce que c'est, au juste ? Le goût du passage de la misère à la richesse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080206,
					"content": "Haha... Je veux dire que c'est acidulé avec une pointe de sucre et un arrière-goût durable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080207,
					"content": "Je vois... Du coup, c'est un peu comme ouvrir un petit commerce et se rendre compte que la vente de fruits n'est pas très lucrative ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080208,
					"content": "Il n'est pas nécessaire d'entrer dans les détails. Laissons le passé derrière nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080209,
					"content": "Haha, qui aurait cru que la grande Megrez était autrefois une vendeuse de fruits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080210,
					"content": "Il n'est pas évident de deviner que je viens d'un village de pêcheurs, non plus. Vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080211,
					"content": "Je pense le contraire. Si vous me demandez mon avis, je dirais que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080212,
					"content": "Vos yeux sont capables de percer la mer, capitaine Beidou. Dotée d'un cœur en or, vous êtes prête à braver vents et marées pour avancer courageusement. Je trouve que sont des qualités que l'on retrouve chez les gens qui ont grandi près de l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080213,
					"content": "Hé ! Vous ne vous moquez pas de moi, j'espère ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080214,
					"content": "Je n'ai rien à gagner en vous froissant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080215,
					"content": "Je sais à quel point vous pouvez être cruelle avec vos mots. C'est moi qui paie aujourd'hui, alors ménagez-moi un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080216,
					"content": "Très bien... J'aimerais quelques verres de plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080217,
					"content": "Je peux vous servir autre chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "À votre service !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "#À toi de jouer, {M#barman}{F#barmaid} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080220,
					"content": "J'aime ça ! Un autre verre pour moi aussi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080234,
					"content": "Vous remplissez à nouveau les deux verres...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "Les jus de fruits de Mondstadt sont excellents. J'aimerais bien pouvoir en profiter tous les jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080222,
					"content": "Pour de vrai ? Ne me dites pas que vous allez ouvrir une route commerciale pour des pommes crépusculaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080223,
					"content": "C'est une idée intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080224,
					"content": "Sérieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080225,
					"content": "Non, je plaisante. Il existe déjà tout un secteur pour ça, je n'ai pas besoin de faire quoi que ce soit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080226,
					"content": "#Merci beaucoup, {NICKNAME}. Si vous recherchez un emploi un jour, sachez que je vous embaucherai volontiers comme {M#mon barman personnel}{F#ma barmaid personnelle}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080227,
					"content": "#Tu es aussi {M#le bienvenu}{F#la bienvenue} à bord de l'Alcor. L'équipage aime la boisson, puis on pourrait festoyer ensemble. Je suis sûre qu'on va s'éclater !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080228,
					"content": "#Dites donc capitaine Beidou, êtes-vous en train d'essayer de me piquer le talent que j'ai déniché ? Vous n'aurez qu'à passer à la Chambre de Jade si vous souhaitez une boisson {M#du voyageur}{F#de la voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080229,
					"content": "(J'ai la cote !)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "#On dirait qu'elles t'ont déjà {M#embauché}{F#embauchée}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080231,
					"content": "Dès que j'en aurais l'occasion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "Je viendrai vous voir toutes les deux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}