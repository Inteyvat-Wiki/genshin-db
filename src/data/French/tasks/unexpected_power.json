			"dialogs": [
				{
					"id": 3532801,
					"content": "Oh ! Tu as senti les éléments de ce monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532802,
					"content": "On dirait que tu n'as eu qu'à toucher la statue pour obtenir le pouvoir Anémo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532803,
					"content": "Personne ici ne serait capable d'obtenir ce genre de pouvoir aussi facilement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532804,
					"content": "Je crois que c'est parce que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "Oui ! C'est parce que tu n'es pas de ce monde !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532809,
					"content": "Si on continue encore vers l'ouest, on finira par atteindre Mondstadt, la cité de la liberté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532817,
					"content": "Mondstadt est aussi appelée « la cité du vent » ; ses habitants vénèrent l'Archon Anémo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532810,
					"content": "Peut-être que ton nouveau pouvoir te permettra de trouver des pistes là-bas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532811,
					"content": "#Et puis on y trouve pas mal de bardes, avec un peu de chance l'un d'entre eux aura entendu parler de {M#ta sœur}{F#ton frère}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532812,
					"content": "Alors c'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532813,
					"content": "Les éléments de ce monde ont répondu à ta prière. Génial, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532807,
					"content": "Ça me paraît suspect...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "Quoi ? « Suspect » ? Tu pourrais montrer un peu plus de respect pour ce cadeau des dieux quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}