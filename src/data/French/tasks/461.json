				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "Ah ! Ce problème me donne un mal de crâne fou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610102,
					"content": "Ça va, Kaeya ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#Ah, {NICKNAME} ! Que Barbatos soit loué, tu tombes à pic !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610105,
					"content": "#{M#Cher envoyé}{F#Chère envoyée} de l'Archon Anémo, puis-je demander une minute de ton précieux temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610106,
					"content": "Vous ne vous arrêtez jamais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610107,
					"content": "Je pense que j'ai un petit peu de temps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "Parfait !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610110,
					"content": "Ce que je vais te révéler est confidentiel. Mes collègues ne doivent rien savoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610111,
					"content": "Allons ailleurs pour discuter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610112,
					"content": "Rendons-nous dans la cour près du quartier général.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610113,
					"content": "Qu'est-ce que vous mijotez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610109,
					"content": "Dites-moi tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "Vous êtes si calme d'habitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
