			"dialogs": [
				{
					"id": 721780101,
					"content": "(Cet autel semble ordinaire. Il n'y a aucune trace élémentaire étrange.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780102,
					"content": "Examiner",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(L'autel semble être en bon état et semble avoir été entretenu il n'y a pas si longtemps. Celui qui s'est occupé de cet endroit doit être une personne consciencieuse.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780104,
					"content": "(À part cela, il n'y a pas d'autres traces.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780105,
					"content": "Bizarre... Il me semble que quelqu'un est venu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
