					"speakerTitle": "Paimon"
				},
				{
					"id": 721780502,
					"content": "(Cet autel semble ordinaire. Il n'y a aucune trace élémentaire étrange.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780503
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780503,
					"content": "Examiner",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780504
					]
				},
				{
					"id": 721780504,
					"content": "(L'autel semble délabré, avec la coque en bois piquée et décolorée, montrant des traces de rouge foncé menaçant par endroits.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780505
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780505,
					"content": "Il est terrifiant, cet autel... J'en ai la chair de poule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780506,
					"content": "Il faut qu'on file d'ici sans tarder !",
