			"dialogs": [
				{
					"id": 721780401,
					"content": "C'est probablement l'autel dont Chouji nous a parlé, hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(Cet autel semble ordinaire. Il n'y a aucune trace élémentaire étrange.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780403,
					"content": "Examiner",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(L'autel est simple mais élégant. Son bois scintille légèrement, accueillant les invités et leurs offrandes dans un silence solennel.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780405,
					"content": "(De nombreux pétales de fleurs de cerisier sont dispersés autour de l'autel, mais on ne dirait pas que c'est le vent qui les a apportés ici. Il semble plutôt que quelqu'un les a intentionnellement placés là.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780406,
					"content": "Hmm... Aucune trace non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Regarde ! Des fleurs de cerisier !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Ah oui ! Chouji a mentionné que sa maman avait eu l'habitude de faire ce genre d'offrandes ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "Il y a tellement de pétales en plus... Ce n'est pas une coïncidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Allons vite le dire à Chouji !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "C'est une offrande de la mère de Chouji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
		},
