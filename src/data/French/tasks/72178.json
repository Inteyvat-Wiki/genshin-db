			},
			"dialogs": [
				{
					"id": 721780201,
					"content": "Il y a un autel ici aussi, allons voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(Cet autel semble ordinaire. Il n'y a aucune trace élémentaire étrange.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780203,
					"content": "Examiner",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Cet autel a l'air propre, et dégage un léger parfum de cerisier sacré. Peut-être que quelqu'un a prié ici il n'y a pas longtemps.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780205,
					"content": "(Mais à part cela, il n'y a pas de traces plus récentes.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780206,
					"content": "Parfum de cerisier sacré... Peut-être que la mère de Chouji est venue !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "Et ça devrait être récemment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
