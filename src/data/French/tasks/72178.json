					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(Le bois de cet autel est ancien, mais il est bien entretenu, donc la couleur terne de l'extérieur n'a pas l'air minable, mais plutôt charmante.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Autel"
				},
				{
					"id": 721780305,
					"content": "Il semble que quelqu'un vienne souvent ici... et prenne souvent soin de cet autel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217804,
			"completionStepIds": [
