			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "On a récolté de nombreuses informations pertinentes. Passons-les en revue et trions-les.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530802,
					"content": "Certaines étaient plutôt plausibles, d'autres complètement ridicules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530803,
					"content": "Nous devrions être en mesure d'en savoir plus sur son identité et ses déplacements.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Oui, laisse-moi réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530805,
					"content": "(Calme-toi, Layla. Il y a plein d'informations, mais tu vas y arriver.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530806,
					"content": "(Je vais commencer par deviner l'identité de la Fée de la sagesse avec les indices en ma possession.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530807,
					"content": "(Ensuite, je vais analyser les lieux où elle a été aperçue et ses motivations... Les pièces du puzzle finiront par s'assembler d'elles-mêmes.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530808,
					"content": "(Je devrais être en mesure de prédire ses déplacements. Essayons pour voir...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Je crois que j'ai compris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "Dis-moi tout.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Tout d'abord, on peut supposer que la Fée de la sagesse est une étudiante du Rtawahist, grâce aux informations de Katayoun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "Elle ne peut pas être d'un autre darshan, car elle n'aurait jamais pu emprunter les deux livres sans passer par la bibliothécaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "Ensuite, si l'on oublie les super-pouvoirs pour l'instant, elle a été aperçue dans des endroits propices à l'observation des étoiles qui ont été officiellement recommandés par l'Académie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "En d'autres mots, elle fait des recherches qui sont similaires aux miennes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "La question que je lui ai posée n'était pas simple. Pourtant, elle a su y répondre en seulement une journée. Ça voudrait dire qu'elle s'y connaît dans ce domaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "En suivant ce raisonnement, nous n'avons plus qu'à attendre son apparition au prochain site d'observation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "C'est logique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "Merci, tu me flattes... En fait, il y a d'autres facteurs auxquels je pense depuis le début...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "Enfin, ce n'est pas important pour l'instant. Allons-y. Malgré nos pistes, on ne sait pas si elles aboutiront à quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "Je t'expliquerai tout si la Fée de la sagesse ne se montre pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "#Je suis {M#certain}{F#certaine} que tu pourrais finir ta thèse sans problème si tu continues comme ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}