			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petite Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "#Vous êtes {M#venus}{F#venues} me ramener au village ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150702,
					"content": "Grand-mère Ruoxin se fait un sang d'encre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Pff, je le savais. Bah, je refuse de vous suivre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150706,
					"content": "Dites aux gens du village que je pars rejoindre mon papa à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150707,
					"content": "Quand je l'aurai trouvé, on parlera et je rentrerai. Il ne faut pas qu'ils s'inquiètent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150704,
					"content": "J'ai quelque chose pour toi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Je n'en veux pas. Vous essayez de m'amadouer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Petite Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petite Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Pourquoi vous me suivez ? J'ai dit que j'allais à Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150802,
					"content": "Je vais éviter les monstres sur la route. Ils ne me remarqueraient même pas de toute façon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150803,
					"content": "J'en ai marre qu'on me traite comme une enfant ! Je suis grande maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150804,
					"content": "C'est de la part de ton père...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "Un cadeau de papa ? C'est lui qui vous a demandé de me donner ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150806,
					"content": "Je parie que c'est encore des trucs de gamins, comme un cerf-volant ou des poupées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150807,
					"content": "Tu n'aimes pas ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "... Si, bien sûr. Du moment que c'est mon papa qui me les offre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150809,
					"content": "Mais si je continue d'aimer ces objets, je serai une enfant pour toujours, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150810,
					"content": "Je ne pourrai ni devenir une aventurière légendaire, ni obtenir d'œil divin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150811,
					"content": "Que voudrais-tu faire avec un œil divin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Plein de choses qui me feront gagner des sous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150813,
					"content": "Comme ça, papa n'aura plus besoin de travailler tous les jours au port. Il pourra jouer avec moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150814,
					"content": "Vous voyez, sans œil divin, je peux même pas me rendre à Liyue toute seule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150815,
					"content": "#Mais si papa vous a {M#envoyés}{F#envoyées} pour me donner un cadeau, je ne ferai peut-être mieux de ne pas aller lui rendre visite. Je ne lui apporterais que des problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Petite Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Moi aussi, j'avais un cadeau surprise pour lui</color>... mais je ne peux plus le lui donner.",
					"roleType": "TALK_ROLE_NPC",
