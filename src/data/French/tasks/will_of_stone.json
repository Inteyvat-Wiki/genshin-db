			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Où est-ce que cette enfant est passée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Bonjour. Je cherche Petite Liu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Ah, vous aussi ? *soupir* Malheureusement, je ne sais pas où elle se trouve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150504,
					"content": "Il y a quelques jours, nous avons reçu une lettre de son père qui disait qu'il reviendrait bientôt au village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150505,
					"content": "Petite Liu était si heureuse qu'elle voulait lui préparer un cadeau. Elle était même partie cueillir des fleurs avec d'autres enfants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150506,
					"content": "Et maintenant, voilà qu'il ne vient plus à cause d'une urgence à son travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150507,
					"content": "La petite a piqué sa crise quand elle l'a su, en disant qu'elle irait elle-même à Liyue. Impossible de la raisonner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150508,
					"content": "Nous pensions qu'elle n'était pas sérieuse. Résultat : ça fait un jour qu'on ne la trouve nulle part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150509,
					"content": "*soupir* Tout le monde est déjà en train de la chercher. Si vous pouviez le faire aussi, ça nous serait d'une grande aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150510,
					"content": "Pas de problème.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Merci beaucoup. *soupir* Décidément...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Où pourrait-elle être allée ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Cette enfant n'a pas pu aller bien loin, mais les environs du village sont tout de même dangereux... Trouvez-la, je vous en prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
		{
			"id": 7081506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
