				"objectNames": [
					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150601,
					"content": "Jiayi est aussi fautif dans cette histoire. Comment a-t-il osé faire ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150602,
					"content": "Il ne vient presque jamais voir sa fille. Ce n'est pas un comportement digne d'un père !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150603,
					"content": "C'est pour le bien de tout le monde au Port de Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "C'est ce que Jiayi me rabâche toujours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Ce n'est pas de sa faute, son travail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Il doit quand même s'occuper de sa fille et la voir grandir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Jiayi reviendra définitivement au village que lorsqu'il aura pris sa retraite. Et à ce moment-là, ce sera au tour de Petite Liu de partir chercher du travail en ville !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150608,
					"content": "Ils ne pourront jamais passer de temps ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
		{
			"id": 7081507,
			"completionStepIds": [
				7081505
			],
