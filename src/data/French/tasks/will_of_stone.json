			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "*soupir* Je n'avais que deux ou trois jours de travail avant de pouvoir prendre ces congés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "J'aurais pu passer une semaine entière avec Petite Liu avec tous les congés que j'avais cumulés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Rien avec un seul ordre, tous nos congés ont été annulés. Même ceux qui étaient déjà partis devaient revenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Ça veut dire que je peux dire adieu à mes vacances au village pendant au moins un mois. Quelle poisse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
