					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "#{M#Voyageur}{F#Voyageuse}, vous êtes {M#venu}{F#venue} visiter le sanctuaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "Vous vous en sortez avec vos statuettes en bois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Hahaha ! Oui, je m'en sors plutôt bien, mais il faut que j'ajuste leurs dimensions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "J'avais prévu de les faire assez petites pour tenir dans une main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "De cette façon, il sera plus facile de jouer avec.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "D'ailleurs, je pensais aussi sculpter quelques petites décorations en plus des statuettes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "J'ai vu que certains sculpteurs aiment bien fabriquer des petits accessoires pour celles-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Des choses comme des fleurs, des animaux, des socles avec des motifs, etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "J'aimerais faire des socles décoratifs pour mes statuettes, mais je ne pourrais mettre qu'un accessoire sur une statuette en raison de leur taille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "Et si je les rends amovibles, il me suffira seulement de mettre celle que le client souhaite au moment de l'achat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "Peut-être qu'il vaudrait mieux commencer par des accessoires simples... De l'herbe à sanglots, par exemple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "Eh bien, pourriez-vous me rapporter 3 herbes à sanglots pour que je les étudie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "#Je m'en remets une fois de plus à vous, {M#voyageur}{F#voyageuse}. Revenez me voir une fois que vous aurez trouvé ces 3 herbes à sanglots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Pourquoi trois ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Je pourrais les étudier sous tous les angles et dans différents états.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "Ainsi, je pourrais sculpter une herbe à sanglots réaliste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
