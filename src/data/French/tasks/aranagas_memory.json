					"content": "Merci pour vos efforts, reprenons le même chemin pour le retour... J'ai quelque chose pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
