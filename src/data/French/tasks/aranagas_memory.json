					"id": 730560717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560718,
					"content": "Tu te souviens ? C'est la même fleur que tu nous avais donnée !",
