			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ha ! Regardez ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Quoi ? Une nouvelle plante ? Pourquoi êtes-vous si excité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "Non, encore mieux ! Regardez, c'était notre château secret ! C'est une véritable ruine aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Hein ? Un château secret ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha ! L'érudit Omar est de retour ! Empreint des secrets des étoiles ! Irfan, Siman, où êtes-vous ? Vous ne venez pas me saluer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Ah... Excusez-moi, les enfants. Je... Je me suis emporté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "C'est la vieillesse, le présent s'estompe et le passé devient de plus en plus précieux... Héhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan et Siman sont le nom de mes amis. Nous avons construit ce château ensemble, tous les trois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "À l'époque, Irfan était le musicien accompli, Siman était la générale et j'étais l'astromancien. Nous échangions nos rôles parfois, vous savez... Les enfants changent de jeu après s'être lassés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan était doué pour jouer de la lyre, Siman était grande avec des bras forts et moi ? Haha, j'étais juste un lecteur avide né dans une famille qui gagnait un peu plus de moras que les autres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "C'est ici que vous avez joué dans votre enfance ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Non, c'était notre royaume secret, je suis sérieux. Nous avions fait la promesse de toujours se souvenir les uns des autres, et de lever l'Armée de la reconquête quand nous serions grands pour reprendre le château...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Héhé, 20 ans ont passé déjà. Ils ont peut-être oublié notre promesse... Cet endroit me sert désormais de campement lorsque je fais des recherches dans la forêt. Celui-ci a été opérationnel jusqu'à il y a 30 ans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Après cela, la Marana est arrivée, mais l'Armée de la reconquête ne s'est jamais présentée. Héhé, ce qui est compréhensible... Comment une promesse enfantine pourrait-elle triompher de la mort ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Mais... Si vous vous souvenez encore d'eux, ils ne devraient pas vous avoir oublié ! Ne vous découragez pas, monsieur Khayyam !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Me décourager ? Pas le moins du monde. Les souvenirs d'enfance et les amis imaginaires n'appartiennent pas au monde des adultes. C'est sans doute un peu dommage, mais... le cours du temps ne peut pas être inversé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "Les « amis imaginaires »... Vous voulez dire les aranaras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon ! Chut !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha... J'oubliais, je vous ai demandé de m'aider à prélever des échantillons des nouvelles plantes, pas de bavarder avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Excusez mes radotages. Continuons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Tais-toi, Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Vos amis et vous avez construit tout ça ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Non, pas tout. Nous nous étions promis de mener l'Armée de la reconquête ici pour reprendre le château... Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Par la suite, j'ai fait des études en botanique à l'Académie et je suis revenu ici par hasard pour une reconstruction. J'ai visité cet endroit plusieurs fois en apportant et en emportant pas mal de babioles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
