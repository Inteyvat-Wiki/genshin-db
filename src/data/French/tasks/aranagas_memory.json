			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Haha, intéressant... C'est vraiment curieux. Elle reprend vie, cette forêt... revient à la vie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560102,
					"content": "Bonjour ! Vous êtes perdu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "Hmm...? Poilu ? Ah, c'est à moi que vous parliez ? Haha, perdu, c'est ça ? Non, pas du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560104,
					"content": "Bonjour les enfants. Je suis Giyath Khayyam, dastur de l'Amu{RUBY#[S]Biologie}rta. Haha... Vous pouvez m'appeler Khayyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560105,
					"content": "Hmm... Bonjour monsieur Khayyam !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "Non... Regardez, vous baissez le bout de la langue et arquez le milieu... Khaaa. Après ça, vous arrondissez votre bouche... Yyaaa. Enfin, vous fermez vos lèvres naturellement... Mmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560107,
					"content": "Hum... Khaaa— Yyaaa— Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "#Voilà ! Bravo ! À vous, jeune {M#homme}{F#femme} aux cheveux blonds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560109,
					"content": "Kha— yya— mmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "Haha, génial ! Vous avez fait beaucoup mieux que la petite chose blanche ! Vous voyez ? Je savais que je pouvais enseigner la phonétique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560113,
					"content": "Alors, monsieur Khayyam... Si vous n'êtes pas perdu, que faites-vous par ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "Qu'est-ce que je fais ? Héhé... Je suis un chercheur de la forêt. Je suis chez moi ici. Comment pourrais-je être perdu quand je suis enfin de retour dans ma propre maison ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560115,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "La forêt est profondément troublée par la siccité. Au cours des trois dernières décennies, les plantes ont rapidement diminué en espèces et en nombre, tandis que les fongides malicieux ont continué à se développer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560117,
					"content": "Cependant, la siccité à proximité a disparu ces derniers jours. Les plantes disparues repoussent et la croissance des fongides malicieux est en quelque sorte freinée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560118,
					"content": "Je n'ai rien vu de pareil depuis 60 ans... Je suis en voie de valider mon hypothèse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560119,
					"content": "Je vois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "Votre hypothèse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Haha, ça s'est passé il y a 60 ans... Vous savez, un vieil homme comme moi ne s'en souvient peut-être pas bien. Mais je suis convaincu que la disparition de la siccité est liée à cela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560122,
					"content": "C'est pourquoi je vais entrer dans la grotte pour recueillir des échantillons et voir si j'ai raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560126,
					"content": "Je vois... Mais même sans la Marana dans la grotte, ça reste dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Haha, ce n'est pas ça qui va m'arrêter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560128,
					"content": "Hmm, attendez... Que venez-vous de dire ? Qu'est-ce qu'il y a dans la grotte ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560129,
					"content": "La Marana ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Hum... J'ai changé d'avis, j'aurais peut-être besoin de votre aide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560132,
					"content": "Hmph, je vous l'avais dit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Héhé, excusez-moi... Je n'ai pas demandé vos noms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560134,
					"content": "#Appelez-moi {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "Et moi, je suis Paimon ! Pai—mon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "Paimon ? Paimon... Haha, que c'est intéressant... Vous êtes la première personne... Et même la première créature, que je rencontre avec un tel nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560137,
					"content": "Oh, toutes mes excuses. Je ne voulais pas vous offenser... Enfin offenser cette petite chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560138,
					"content": "Petite chose ?! C'est insultant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Bon, trêve de bavardages. Suivez-moi, javans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560140,
					"content": "« Javans » ? Qu'est-ce que ça veut dire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "C'est un ancien mot dans le dialecte de mon pays natal, qui signifie « jeunes gens courageux ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560142,
					"content": "Ou plus précisément « jeunes gens qui ne ferment pas les yeux devant le mal, ni ne reculent devant l'injustice ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560143,
					"content": "Héhé, c'est nous tout craché, ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "#Oh ? Vous êtes {M#sûrs}{F#sûres} ? Haha, venez avec moi alors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560145,
					"content": "#Hein ? Khayyam, vous pouvez vraiment nous suivre avec vos vieilles guiboles{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "Haha... J'ai vingt ou trente ans d'expérience en forêt, alors ne me sous-estimez pas ! Vous pouvez aller aussi loin que vous le voulez, je vous rattraperai en un rien de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560130,
					"content": "Une zone de siccité ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Vous avez besoin de notre aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "#Haha... Merci à vous, mes {M#chers}{F#chères} enfants. Je suis peut-être vieux, mais je ne suis pas complètement sénile. Ne me sous-estimez pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560125,
					"content": "Je sais comment faire plaisir à la forêt, elle ne me fera aucun mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560111,
					"content": "Que faites-vous par ici, monsieur Khayyam ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Hmm... Votre prononciation était trop rapide, trop hâtive. Mais ce n'est pas grave... Ralentissez, c'est tout ce qu'il vous faut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
		{
			"id": 7305602,
			"completionStepIds": [
				7305606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305606",
							"2"
						],
						"stepId": 7305606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "Je vais concentrer mon investigation sur trois endroits. Haha, j'espère qu'il me reste encore quelques bribes de mes souvenirs d'il y a 30 ans... Je devrais être capable de vous indiquer les lieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
