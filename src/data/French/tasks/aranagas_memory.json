					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560702,
					"content": "Ouah ! Tu m'as fait peur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560703,
					"content": "#Mon nom, vous le connaissez, mais Aranaga ne vous a jamais {M#vus}{F#vues} ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560704,
					"content": "Alors ? Que faites-vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560705,
					"content": "C'est difficile à expliquer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Tu as oublié beaucoup de choses, mais sache que nous ne vous voulons pas de mal ! Nous serons toujours de votre côté, et nous aiderons Mawtiyima !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560707,
					"content": "Vous connaissez... Mawtiyima ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560710,
					"content": "#Hmph, vous ne ressemblez pas à des {M#méchants}{F#méchantes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "#Mais ne restez pas ici, s'il vous plaît. Partez vite. Encore en guérison, la forêt est... Pas séjourner ici, {M#nouveaux invités}{F#nouvelles invitées}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
