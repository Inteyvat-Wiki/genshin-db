					"speakerTitle": "Paimon"
				},
				{
					"id": 3890302,
					"content": "En effet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890303,
					"content": "Regardez en haut, ce <color=#00E1FFFF>toit</color>. Je crois qu'il y a un <color=#00E1FFFF>trou béant</color> ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890304,
					"content": "On devrait peut-être emprunter ce <color=#00E1FFFF>champ de vent</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890305,
					"content": "OK, faisons donc ce détour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890306
					],
					"speakerTitle": "Paimon"
				},
				{
