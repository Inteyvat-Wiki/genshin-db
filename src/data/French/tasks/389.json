				"points": []
			},
			"dialogs": [
				{
					"id": 3890601,
					"content": "Je crois que nous ne pouvons plus avancer. Les ruines ont l'air d'être protégées par des <color=#00E1FFFF>sceaux</color> antiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Est-ce l'œuvre de Dvalin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "Non. Ces ruines faisaient autrefois partie d'une cité antique. Dvalin a juste établi son repaire ici de manière temporaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Les ruines sont en réalité plus anciennes que les Quatre Vents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt est une cité sans roi à présent. Mais autrefois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Elle était gouvernée par un tyran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "Je vous réserve cette histoire pour une prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Ce sceau... Si mes connaissances en archéologie sont encore bonnes, il s'agit d'un <color=#00E1FFFF>activateur de lumière</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Si nous restituons les <color=#00E1FFFF>pièces manquantes</color> du <color=#00E1FFFF>mécanisme</color>, nous devrions être en mesure d'accomplir le <color=#00E1FFFF>rituel de la lumière</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Je crois que nous y sommes presque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Ajoutons la <color=#00E1FFFF>dernière pièce</color> et voyons ce qu'il se passe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
	]
