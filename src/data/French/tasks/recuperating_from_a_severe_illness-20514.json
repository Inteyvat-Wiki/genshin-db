				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "Qu'est-ce que je vais bien pouvoir faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "Ah, c'est vous. Vous arrivez encore au bon moment. Depuis qu'elle a pris les médicaments prescrits par le docteur, Anna va beaucoup mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140104,
					"content": "Sa maladie l'obligeait à rester alitée ; elle a passé beaucoup de temps à la maison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140105,
					"content": "Mais depuis qu'elle se porte mieux, elle n'arrête pas de me tâner pour sortir... J'ai fini par accepter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140106,
					"content": "Mais... Je ne sais pas où elle est partie, et impossible de la retrouver. Aidez-moi, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140107,
					"content": "Hum, OK. Je m'en occupe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Je vous attends ici. Ne perdez pas de temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140109,
					"content": "À peine remise sur pied, qu'elle disparaît comme ça... Et si jamais il lui arrivait quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140116,
					"content": "J'ai déjà fait le tour des environs, sauf vers la Guilde des aventuriers. Je suis épuisé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140117,
					"content": "Commencez par chercher par là-bas. Qui sait, peut-être que Cyrus aura vu quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140118,
					"content": "J'espère vraiment que vous la retrouverez, ou il faudra que je reprenne les recherches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140110,
					"content": "Vous avez l'air plutôt content.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "Content ? Content ?! Ce n'est pas le moment de faire de l'humour ! Elle commence juste à récupérer, et la voilà qui disparaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140112,
					"content": "Je vous garantis qu'elle va m'entendre quand elle reviendra !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140113,
					"content": "Bah, elle reviendra quand elle aura un creux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "Vous la prenez pour un chat ? Et puis elle vient juste de se rétablir, pas question qu'elle ait faim !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140115,
					"content": "Assez perdu de temps. Aidez-moi à la retrouver, je vous en prie. Je vous attendrai ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
