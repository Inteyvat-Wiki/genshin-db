				{
					"id": 205140504,
					"content": "Attendez... Comment vous m'avez trouvée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Je sais ! C'est monsieur Cyrus qui a dû vous dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "Il a toujours été très gentil avec mon frère et moi... Je lui ai fait coucou quand je l'ai vu. Il avait l'air sacrément surpris !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Je devrais peut-être rejoindre la Guilde, et devenir une vraie aventurière ! Ça serait chouette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "Hein ? Mon frère me cherche ? Oh, je suis partie depuis un moment... J'avais pas fait attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
