			"dialogs": [
				{
					"id": 205140401,
					"content": "Tiens, vous ici ? Qu'est-ce qui vous amène ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140402,
					"content": "Vous n'auriez pas vu une gamine...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Une gamine, vous dites ? Ah, vous parlez d'Anna sans doute, non ? Je l'ai vue il n'y a pas si longtemps, elle courait vers le moulin à vent je crois bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "Je me suis même fait la réflexion qu'elle était bien agitée, pour une petite qui était malade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "Elle m'a fait coucou, puis elle est repartie à galoper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "Cette petite... Vous savez quand elle s'est enfin débarrassée de sa maladie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
