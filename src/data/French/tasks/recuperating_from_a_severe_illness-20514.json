			"dialogs": [
				{
					"id": 205140301,
					"content": "Alors, vous avez retrouvé Anna ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "Oui, elle est en haut d'un moulin à vent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Un moulin à vent ?! Comment s'est-elle retrouvée sur un moulin à vent ?! J'appelle les chevaliers de l'Ordre immédiatement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Elle a dit qu'elle rentrerait bientôt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "Ah, euh... Hum, d'accord, dans ce cas. Tant qu'elle n'a rien... Vous m'avez donné une sacrée frousse ! J'avais compris qu'elle était coincée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "#Mille merci, {M#voyageur}{F#voyageuse}. Je m'en vais la chercher de ce pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Disparaître comme ça alors qu'elle vient juste d'aller mieux... Elle va m'entendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
