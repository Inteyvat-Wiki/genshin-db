			"dialogs": [
				{
					"id": 711209101,
					"content": "Encore vous ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Tigre assis"
				},
				{
					"id": 711209102,
					"content": "Arrêtez de fouiner ! Faites comme si vous ne nous aviez pas vus, et on fera de même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711209103,
					"content": "Qu'est-ce que vous gardez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "À votre avis, pourquoi sommes-nous payés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711209105,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "Ahem !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711209107,
					"content": "(Je vais vous le dire juste à vous, mais vous ne devez le dire à personne... Rapprochez-vous...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711209108,
					"content": "(D'accord, je vous écoute !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "Pour nous débarrasser des gens trop curieux comme vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711209110,
					"content": "Aaaah !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "J'ai entendu un bruit étrange venant de la grotte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "J'ai pété !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Tigre assis"
				},
				{
					"id": 711209113,
					"content": "Euh... c'est ça, il a pété.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711209114,
					"content": "Tout va bien alors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
