			"dialogs": [
				{
					"id": 711200101,
					"content": "Hé, n'approchez pas ! C'est le territoire du chef !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Tigre assis"
				},
				{
					"id": 711200102,
					"content": "Waouh, pas très accueillant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Qui êtes-vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Ça dépend de vous. Si vous vous comportez bien, nous pouvons nous montrer amicaux ! Mais si vous fouinez trop, ce sera une toute autre histoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711200105,
					"content": "Je vous conseille de retourner d'où vous venez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Tigre assis"
				},
				{
					"id": 711200109,
					"content": "Vous n'êtes vraiment pas nets !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Pas nets ? Oh... Nous ne sommes que les gardiens ici. La façon dont vous vous mêlez de ce qui ne vous regarde pas est encore plus suspecte !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Serpent enroulé"
				},
				{
					"id": 711200111,
					"content": "Ça suffit, on n'a rien à vous dire ! Laissez-nous tranquille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tigre assis"
				},
				{
					"id": 711200106,
					"content": "Qui est ce chef dont vous parliez ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Qui est le chef ? Hmm... Si je vous le dis, vous allez paniquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Tigre assis"
				},
				{
					"id": 711200108,
					"content": "C'est pour votre bien ! Ne vous mêlez pas de ce qui ne vous regarde pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Serpent enroulé"
				}
			]
		},
