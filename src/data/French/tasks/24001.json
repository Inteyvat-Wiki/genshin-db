				{
					"id": 240010501,
					"content": "Est-ce que Barea n'aime pas mon nouveau roman ? *soupir* Tout le monde le trouve bien pourtant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
