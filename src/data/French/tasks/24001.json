			},
			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea, mon bébé ! Où étais-tu passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Il a simplement trouvé un endroit tranquille pour se reposer. L'envie de faire une pause, vous savez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "#Ah, j'étais tellement inquiète ! Merci, officière Blathine{NON_BREAK_SPACE}! Vous serez dans mon prochain roman à coup sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Merci, mais il serait peut-être préférable que vous économisiez de l'encre. Je doute que quiconque s'intéresse à la vie quotidienne d'un officier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Je n'aurai qu'à dramatiser votre histoire... Ce sera intéressant, je peux vous l'assurer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Cette drôle de promesse est suffisante, je pense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Ah, mais je dois encore travailler sur la conclusion ! Laissez-moi réfléchir... Qui devrais-je désigner pour être votre partenaire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
