			"dialogs": [
				{
					"id": 240010301,
					"content": "Ah, le voilà, et il a l'air plutôt bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Je me demande quand mademoiselle Staelle se rendra compte que les chiens n'aiment ni l'opéra, ni ses romans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Retournons la voir, elle est probablement morte d'inquiétude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
				}
