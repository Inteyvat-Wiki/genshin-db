				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "*soupir* ... Après mille ans, le gardien du Clan Guhua doit tromper les gens pour avoir quelque chose à manger... Mais que pouvons-nous y faire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Wen le quatrième"
				},
				{
					"id": 711092502,
					"content": "*soupir* Arrête tes pleurnicheries. Je fais ça pour que tu ne meures pas de faim en gardant notre siège.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Huang le troisième"
				},
				{
					"id": 711092503,
					"content": "#Et ne fais pas cette tête, tu as toujours l'air déprimé. Tu étais aussi content de la performance de {NICKNAME}, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Huang le troisième"
				},
				{
					"id": 711092504,
					"content": "#{M#Ce pseudo héros}{F#Cette pseudo héroïne} ? De quoi devrais-je me réjouir ? {M#Il}{F#Elle} a pu visiter notre siège en échange de riz et de bacon ! Si j'étais quelques années plus jeune, je te donnerais une bonne leçon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Wen le quatrième"
				},
				{
					"id": 711092505,
					"content": "Hé ! Il y a quelques années, tu n'avais pas encore mon niveau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Huang le troisième"
				},
				{
					"id": 711092506,
					"content": "Bref, il ne reste plus que quelques vieux comme nous. Nous devons continuer à chercher la relève. Nous ne pouvons pas emporter les livres dans la tombe, si ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Huang le troisième"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Wen le quatrième"
				},
				{
					"id": 711092508,
					"content": "Haha, changeons de sujet, ça ne sert à rien de parler de choses aussi déprimantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Huang le troisième"
				},
				{
					"id": 711092509,
					"content": "Tiens, pourquoi n'essayerais-tu pas le plat que les jeunes m'ont préparé ? Haha, je pense que c'est encore meilleur que celui du Restaurant Wanmin ! Tiens, prends-en une bouchée... Oh allez, juste une bouchée !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang le troisième"
				}
			]
		}
	]
}