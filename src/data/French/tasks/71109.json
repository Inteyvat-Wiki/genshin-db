				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "Waouh ! Qui aurait pensé qu'il y aurait un si grand secret dans cette Salle de la montagne céleste délabrée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Je ne m'attendais pas à ça non plus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Huang le troisième ne semblait pas non plus connaître cet endroit... Attends, ça voudrait dire que ce pourrait être la légendaire salle des trésors de Guhua ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#{NICKNAME}, regarde ! Il y quelque chose qui brille sur cette plateforme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Ce doit être le trésor !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Allons voir ce que c'est !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Serait-ce un mécanisme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "C'est peut-être pour ça qu'on dit qu'il ne faut pas juger un livre à sa couverture...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "« Les cieux sont traîtres et rares sont ceux qui cherchent une audience. Le destin est imprévisible, et rares sont ceux qui parviennent à avancer sans faillir... Ceux à qui le ciel a donné des yeux pour voir ne voient souvent pas le chemin. Que devraient faire ceux qui n'ont pas été dignes du regard du ciel ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Inscription gravée"
				},
				{
					"id": 711090502,
					"content": "« ... Ce monument a été laissé pour poser cette seule question. Lorsque vous atteindrez la fin de votre voyage, que ferez-vous ? »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Inscription gravée"
				},
				{
					"id": 711090503,
					"content": "(Toucher la stèle...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Partir...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
