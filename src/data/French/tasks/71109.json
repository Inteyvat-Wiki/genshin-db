				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Hein ? À ton avis, qu'est-ce qui est écrit sur cette épée ? Laisse-moi regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "« ... Je caressais mon épée, en chantant que je pourfendrai les dragons et étalerai leur sang sur mes lèvres. La lumière divine, telle la foudre vagabonde, menaçait de s'abattre sur les montagnes... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Inscriptions de l'ancien épéiste"
				},
				{
					"id": 711090603,
					"content": "« Sous les Monts Tianheng, je pourfends des tigres et j'empale la bête écaillée au milieu de la mer des nuages... Quand je reviendrai, couronné de succès, nous vivrons paisiblement... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Inscriptions de l'ancien épéiste"
				},
				{
					"id": 711090604,
					"content": "Je pense qu'il y a une autre stèle à côté... Tu ne trouves pas que le texte ci-dessous est un peu différent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "« ... Je pensais mettre du poisson et de l'agneau, mais ils pourriraient probablement avec le temps. Je laisse donc ici la recette au lieu des ingrédients. C'est magnifique. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Gravure ancienne"
				},
				{
					"id": 711090606,
					"content": "« ... Il n'y a rien ici à part une épée et un vaste paysage. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Gravure ancienne"
				},
				{
					"id": 711090607,
					"content": "« ... Et que faire face à une impasse ? La réponse devrait être évidente. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Gravure ancienne"
				},
				{
					"id": 711090608,
					"content": "« ... Ne prenez pas... trésor, n'en laissant qu'un seul... désormais... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Gravure tordue"
				},
				{
					"id": 711090609,
					"content": "« Dans le désespoir... J'espère que vous lirez ceci... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Gravure tordue"
				},
				{
					"id": 711090610,
					"content": "Pff... Je ne comprends rien à ce qu'il est écrit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Ça veut probablement dire qu'il n'a rien pris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "Il n'y avait aucun trésor de valeur, on a fait tout ça pour rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "C'est clair !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Cependant, je ne m'attendais pas à voir un paysage comme celui-ci dans une situation aussi désespérée... Ça valait le coup, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Ne t'en fais pas, je vais te préparer quelque chose de délicieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "Vraiment ?! Attention, je te prends au mot !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Je ne sais pas non plus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
