			"dialogs": [
				{
					"id": 207411001,
					"content": "Alors, vous avez trouvé des graines de pissenlit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411002,
					"content": "Oui, tenez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "Ça devrait suffire. Attendez ici un instant, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411004,
					"content": "... Ô Barbatos, écoute mes prières...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411005,
					"content": "Eh bien, elle est sacrément dévouée... Tout ce qu'elle a pu raconter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411006,
					"content": "... Je me demande si le barde de pacotille l'a entendue, tiens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411007,
					"content": "Bien, tenez, prenez ces graines de pissenlit, et aidez-moi à les jeter au vent d'en haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411008,
					"content": "À vrai dire, c'est moi qui devrais m'en charger, mais... Quand bien même j'arriverais à grimper là-haut, je serais bien incapable de redescendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411009,
					"content": "Alors, je m'en remets à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2074120,
