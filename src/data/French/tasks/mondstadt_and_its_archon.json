			"dialogs": [
				{
					"id": 207412001,
					"content": "Ça y est ? Vous avez jeté les graines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412002,
						207412003
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412002,
					"content": "Ça y est.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412005
					]
				},
				{
					"id": 207412005,
					"content": "Quoi qu'il en soit, j'espère que l'Archon Anémo entendra mes prières.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412006
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412006,
					"content": "Merci pour votre aide. Tenez, veuillez accepter ceci en remerciement, et que Barbatos vous bénisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412003,
					"content": "Elles doivent être loin maintenant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412004
					]
				},
				{
					"id": 207412004,
					"content": "Ah, parfait, parfait. Le seigneur Barbatos n'y fera que plus attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412005
					],
					"speakerTitle": "Grace"
				}
