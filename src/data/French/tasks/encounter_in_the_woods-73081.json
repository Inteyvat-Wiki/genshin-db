			"dialogs": [
				{
					"id": 730810401,
					"content": "#Ravi de vous avoir {M#rencontré}{F#rencontrée} ! Quand viendra le temps du Festival Utsava, nous chanterons joyeusement ensemble !",
					"roleType": "TALK_ROLE_NPC",
