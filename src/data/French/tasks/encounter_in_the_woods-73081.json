			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "#Oh, Arama et {M#le nara doré}{F#la nara dorée}. Tu es vraiment {M#un grand}{F#une grande} nara. Par contre, cette petite argentée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hein ? Qu'est-ce qu'elle a, la petite argentée ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Comment dire... Tu dois pouvoir passer à travers des tout petits creux d'arbre, pas vrai ? Très pratique ! Trop bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Bon, selon les coutumes des naras, on commence toujours par les présentations. Voici nara {NICKNAME} et Paimon. Et lui, c'est Arakavi. Serrez-vous la main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "Sans savoir trop quoi faire, vous serrez la main d'Arakavi...\\nVous n'osez pas y aller trop fort.\\nC'est une sensation... assez spéciale.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "#Intéressant. J'ai entendu dire beaucoup de choses à propos des naras, mais c'est la première fois que j'en touche {M#un}{F#une}. C'est surprenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "#La dernière fois qu'un nara est venu, c'était il y a longtemps. Beaucoup de graines sont devenues de grands arbres, beaucoup d'histoires sont devenues des légendes. Il paraît que c'était {M#une nara très gentille}{F#un nara très gentil}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} est également {M#un nara très gentil}{F#une nara très gentille}, {M#courageux et costaud}{F#courageuse et robuste}, comme un petit arbre qui pousse au bord d'une falaise. En plus, tu es {M#venu}{F#venue} ici pour aider Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Arana... Je ne l'ai pas vue depuis longtemps. J'espère que tout va bien, pour elle et aussi pour les petits naras du Village de Vimara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Tu connais les enfants de Vimara ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "On les connaît tous ! Quand elle est revenue, Arana nous a raconté l'histoire des petits naras. Donc, nara Iotham, nara Bahram et nara Rana sont nos amis nariens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "On peut difficilement dire que vous les connaissez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "#Ah, ça veut dire quoi « connaître » ? Est-ce qu'il faut, comme les naras, se «{NON_BREAK_SPACE}présenter{NON_BREAK_SPACE}» et puis se « serrer la main » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "#Je comprends ce que Paimon veut dire. Si des naras mangent et trouvent des «{NON_BREAK_SPACE}trésors{NON_BREAK_SPACE}» ensemble, alors ils se connaissent mutuellement, c'est bien ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "Ce n'est pas aussi simple que ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Tant qu'on connaît mutuellement nos histoires, on se connaît. Parce que le monde des aranaras est un monde de chants et de rêves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Oui, Arakavi a raison. Pour les aranaras, entendre une chanson décrivant nara {NICKNAME} et voir nara {NICKNAME} dans un rêve signifie qu'on connaît nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "#Je pense qu'on peut laisser tout ça de côté... Parce qu'après tout, on est déjà les {M#amis}{F#amies} des aranaras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "#De {M#bons amis}{F#bonnes amies} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama et Arakavi"
				},
				{
					"id": 730810325,
					"content": "#Oui, de {M#bons amis}{F#bonnes amies} !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Le Festival Utsava va bientôt avoir lieu, il faut que tu te prépares, Arakavi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Je le savais, vous êtes ici pour le bija, n'est-ce pas ? J'ai envoyé Arayasa, Aradasa et Arasudraka chercher les Halls d'Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Bien vu... Comment se fait-il que vous ne sachiez pas où se trouvent les Halls d'Ashvattha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Les Halls d'Ashvattha sont des endroits vraiment sacrés, on s'y rend rarement. On laisse les arbres vasaras dormir tranquillement dans le rêve jusqu'à ce que tous les souvenirs puissent être rassemblés dans Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "La forêt se souvient de tout. Toutes les belles choses ne disparaîtront pas. Toutes les peines viendront nourrir l'apparition de belles choses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "Quoi qu'il en soit, Arayasa, Aradasa et Arasudraka sont en train de chercher les Halls d'Ashvattha. Va les aider, Arama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#D'accord, je vais y aller. Nara {NICKNAME} et Paimon, si vous me croisez dans la forêt, on pourra faire cette aventure ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Très bien. Nara {NICKNAME} et Paimon, ravi d'avoir fait votre connaissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Revenons-en aux choses sérieuses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Comment l'expliquer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Paimon et moi, on mange ensemble, et on trouve des trésors ensemble aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "#Oui ! Non seulement on se connaît, mais en plus on est {M#meilleurs amis}{F#meilleures amies} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#C'est bien ça, nara {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
