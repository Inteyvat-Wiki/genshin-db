		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "C'est le dernier coffre. Il n'y a pas besoin de créer d'énigmes pour lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Mais que pourrait-on mettre dedans ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Quelque chose d'assez précieux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Je suis d'accord avec vous. L'objet devrait être gratifiant pour récompenser la réflexion approfondie de la personne qui a résolu ces énigmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Ce sont les moras qui me viennent à l'esprit... Je vais en mettre là-dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "#Voilà, c'est fini pour cette énigme. Merci de votre aide, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Tenez, c'est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "J'aurais voulu discuter plus en profondeur des énigmes avec vous, mais je dois retourner à l'Académie pour m'occuper de certaines affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "Si vous découvrez de nouvelles énigmes intéressantes lors de vos voyages à l'avenir, ou s'il y a des énigmes que vous ne pouvez pas résoudre, n'oubliez pas de venir me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "Nous pourrons en discuter ensemble en détail et ensuite... demander aux aventuriers de les résoudre, haha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "#Je vous dis donc au revoir, {M#voyageur}{F#voyageuse}, et vous souhaite tout le meilleur pour la suite de votre voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "J'espère que cette Pilleuse de trésors nommée Narzam ne causera pas de problèmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Il nous faut quelque chose qui ait une valeur pratique.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Une valeur pratique ? Euh... Qu'est-ce que ça pourrait être ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Ah oui ! On m'a donné une recette l'autre jour, je vais la mettre dans ce coffre en guise de récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "Le cheminement de la réflexion est le meilleur trésor qu'il soit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Haha, vous avez raison ! En effet, c'est une expérience précieuse et inestimable ! À côté de ça, le reste paraît sans valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "Ah mais non, ce n'est pas bon du tout ! Mettons des moras ou une recette ! Même des fruits et des légumes feraient l'affaire. Il ne faut pas que ce soit vide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Je plaisante, je vais mettre quelque chose dans le coffre en récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
