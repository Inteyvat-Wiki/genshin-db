				]
			},
			"dialogs": [
				{
					"id": 760680101,
					"content": "Ah, Aria. Il semblerait que tu aies également choisi une forme « humaine » pour toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Héhé, tu ressembles à ce que j'imaginais, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Cela dit, je ne m'attendais pas à ce que tu prennes l'initiative de créer une telle forme pour ces adorables petites créatures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "C'est tout à fait naturel, Aria. Ces vies fragiles me font confiance et s'adressent à moi, alors je me dois de répondre à leur appel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Nous sommes nées pour préserver le monde. Si les êtres que l'on appelle « les humains » sont prêts à s'y installer, écouter leurs supplications nous permet également d'accomplir la mission que notre roi nous a confiée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Oui. Après tout, il a bien dit que toutes les formes de vie au-delà du ciel étoilé sont nos alliées. Elles se battent à nos côtés contre les ténèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Mais ce n'est pas ce dont je parlais. Je ne m'attendais pas à ce que toi, la Lune de givre, tu puisses avoir un côté aussi sentimental. C'est très mignon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "... Je vois que ces petits humains ont déjà commencé à influencer le langage que tu utilises, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "Leurs mots sont toujours si ambigus. Ne les utilise pas. Je ne comprends pas ce que tu veux dire quand tu dis « mignon ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "Oh, allez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Mes sœurs, maintenant que nous nous sommes façonné un corps, ne devrions-nous pas commencer par nous éclipser discrètement pour aller nous amuser avec les gens qui vivent sur la surface ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Sinon, nos efforts auront été vains ! Dépêchons-nous, avant que quelqu'un ne nous découvre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Héhé. On dirait que notre chère sœur est vraiment impatiente, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Je me souviens bien que, lorsqu'ils ont commencé à bâtir leur civilisation sur la surface, tu avais même dit : « Cet étranger n'augure rien de bon, et ses créations ne valent pas mieux. » Tu ne leur as même pas accordé un regard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "C—C'est différent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Je reste convaincue que vous n'auriez pas dû laisser cet étranger entrer, mais les gens qui vivent là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "*soupir* Du moment que vous vous amusez. Allez-y, et n'oublie pas de rester toujours ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "Hein ? Tu ne viens pas avec nous, Canon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "La servante de ce descendeur a dit qu'ils avaient des choses à discuter avec moi concernant le potentiel gravitationnel et le tenseur{RUBY#[D]les lois du temps} métrique de ce monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "Istaroth ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Je crois que c'est ainsi qu'elle s'appelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "Tu devrais vraiment te souvenir du nom des gens, ma sœur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "Et ce n'est peut-être que mon imagination, mais j'ai comme un... pressentiment sur la façon dont elle perçoit ce descendeur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "Je ne vais pas tirer de conclusions hâtives, Aria. Mais je resterai vigilante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Ah, ça me rassure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Héhé, ce n'est rien. Bon, alors allons-y, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "Ne t'inquiète pas, Sonnet et moi te rapporterons un cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "... Je n'ai pas besoin de cadeau. Faites juste attention à ne pas vous faire repérer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}