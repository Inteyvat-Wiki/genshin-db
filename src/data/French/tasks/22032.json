			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320401,
					"content": "Hmm... Ce plat n'a pas le goût d'un plat liyuéen, ni d'un plat inazumien... C'est assez nouveau pour moi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320402,
					"content": "Ce n'est pas celui que je voulais manger, mais je suis satisfaite d'avoir pu y goûter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320403,
					"content": "#Merci, {M#voyageur}{F#voyageuse}. C'est pour vous, prenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203205,
			"completionStepIds": [
				2203205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203205",
