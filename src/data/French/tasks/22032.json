			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "Ah, si seulement je pouvais manger des plats liyuéens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320102,
					"content": "Qu'est-ce qui ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "#Qui êtes-vous ? Cette tenue... Vous êtes {M#le voyageur}{F#la voyageuse}, non ? Désolée, j'ai juste un peu le mal du pays...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320104,
					"content": "Vous venez de dire que vous vouliez manger des plats liyuéens, n'est-ce pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "Hé ? Vous savez cuisiner des plats liyuéens ? Génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320119,
					"content": "Alors, aidez-moi à en préparer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320120,
					"content": "Laissez-moi réfléchir... Ce que j'aimerais manger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320121,
					"content": "Je sais ! Je veux manger du poisson ! Je pense au poisson que ma mère faisait quand j'étais petite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320122,
					"content": "Il faut laver le poisson, l'entailler des deux côtés, le farcir d'épices, le faire mariner légèrement dans du vin et le faire frire dans une poêle jusqu'à ce qu'il soit doré des deux côtés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320123,
					"content": "Ensuite, faire bouillir l'eau, laisser mijoter la sauce, puis l'assaisonner à feu vif et l'épaissir avant de présenter et servir... Ah ! C'est un vrai régal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320124,
					"content": "Mon petit frère sentait souvent le plat sur le côté. Il aurait sauté et tapé dans ses mains en disant : « C'est parfait ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320125,
					"content": "Ma mère cuisine tellement bien le poisson, mais quand pourrai-je retourner à la maison pour en manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320105,
					"content": "Avez-vous besoin d'aide ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "Tout d'abord, laissez-moi me présenter. Je m'appelle Tang Wen, je suis une historienne de Liyue et je faisais des recherches de terrain sur les coutumes et le folklore d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320107,
					"content": "J'étais sur le point de retourner à Liyue, car j'avais presque fini ma collecte d'informations. Mais j'ai été obligée de rester ici depuis un certain temps à cause du décret de confinement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320108,
					"content": "Ce n'est pas une mauvaise chose, parce que j'ai le sentiment qu'Inazuma est en train de vivre un moment historique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320109,
					"content": "Je suis certaine que cette période laissera une empreinte dans les annales de l'histoire de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320110,
					"content": "Une historienne se doit d'être témoin de cette histoire de ses propres yeux, puis de la consigner de manière fidèle, complète et claire pour la postérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320111,
					"content": "Mais... Aussi excitante que soit une telle entreprise pour moi, elle ne satisfera pas mon estomac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320112,
					"content": "Vous avez faim ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "Je ne peux pas dire que c'est de la faim... Hahahaha ! La nourriture d'Inazuma est aussi tout à fait délicieuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320114,
					"content": "J'aime particulièrement les tempuras, bien qu'ils ressemblent à... des trucs recouverts de pâte frite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320115,
					"content": "Mais après avoir mangé de la nourriture d'Inazuma pendant si longtemps, celle de Liyue me manque. Cependant, je n'ai pas trouvé de restaurant qui propose des plats liyuéens authentiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320116,
					"content": "Je suis même allée à la Guilde des aventuriers il y a quelques jours pour y déposer une mission de cuisine, mais je n'ai pas encore eu de réponse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320117,
					"content": "Je peux essayer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
		{
