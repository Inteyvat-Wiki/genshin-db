			"dialogs": [
				{
					"id": 220320201,
					"content": "Vous revoilà déjà ? Vous n'êtes pas un chef qui cache son identité, par hasard ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320202,
					"content": "Hmm... J'ai hâte ! Laissez-moi goûter, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Bon appétit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Voyons voir... de quels plats a-t-on parlé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Hmm... De la perche-écureuil, de la marmite de perche à dos noir et du poisson grillé mondstadtois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Décidons lequel cuisiner et donnons-le à Tang Wen !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
