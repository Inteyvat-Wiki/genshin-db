			"dialogs": [
				{
					"id": 220320701,
					"content": "Alors, quel plat à base de poisson devrions-nous préparer ? Et si on le choisissait pour elle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
