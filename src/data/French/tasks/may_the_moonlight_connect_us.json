			"dialogs": [
				{
					"id": 760310201,
					"content": "... Oui, je demanderai à Kunegunda de me ramener quelques fruits tout à l'heure. Elle aura besoin de repos pendant ces deux prochains jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Oh, on dirait que Lauma est occupée pour l'instant. Attendons un peu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "J'ai réalisé il y a des années que les Émissaires de chantelune sont des personnes très importantes au sein des Descendants de givrelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310204,
					"content": "Il m'arrive de penser que leur travail est encore plus difficile que celui d'une divinité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310205,
					"content": "Enfin, elle est libre. Allons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Dame Lauma. Il y a des structures de défense ici qui demandent votre attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Bien sûr, j'arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "Et c'est reparti ! Elle ne se repose jamais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Suivons-les prudemment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
