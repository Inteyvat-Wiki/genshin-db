			"dialogs": [
				{
					"id": 760310101,
					"content": "Columbina ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310103,
					"content": "#Ah ! On dirait qu'elle fait une sieste. Revenons plus tard, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Blaireau chic"
				},
				{
					"id": 760310105,
					"content": "Hé, ne va pas là-bas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "... Mmph !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310107,
					"content": "Aïe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Blaireau chic"
				},
				{
					"id": 760310109,
					"content": "Tu as glissé ? Ah, je vais bien. Hmm ? Vous êtes là aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310110,
					"content": "Une Déesse de la lune peut aussi ressentir de la douleur quand les animaux lui rentrent dedans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Ce n'est pas grave, du moment que leur kuuvahki n'est pas malveillant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310112,
					"content": "Quelque chose est arrivé ? Pourquoi as-tu peur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Blaireau chic"
				},
				{
					"id": 760310114,
					"content": "D'accord, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310115,
					"content": "Vous pouvez comprendre ce qu'il dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "La lune brille au-dessus de Nod-Krai. Tous les animaux qui ont grandi sous sa lumière du kuuvahki sont considérés comme les familiers de la Déesse de la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310117,
					"content": "Qu'est-ce qu'il a dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "Des monstres sont apparus là où il habite. Il cherchait Lauma, mais les monstres l'ont pourchassé jusqu'ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310119,
					"content": "Oh... Pas étonnant qu'il ait pris peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Devrait-on le ramener ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Oui. Lauma est la personne idéale pour cela. Elle saura quoi faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310122,
					"content": "On dirait qu'on va devoir repartir. Cachez-vous bien, on se rend chez les Descendants de givrelune, après tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
