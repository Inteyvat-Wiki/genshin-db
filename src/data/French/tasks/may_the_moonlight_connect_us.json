			"dialogs": [
				{
					"id": 760310301,
					"content": "... Cela fera l'affaire. Merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310302,
					"content": "Que le clair de lune nous unisse, de jour comme de nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310303,
					"content": "... Hmm ? La salutation a changé depuis la dernière fois que je l'ai entendue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310304,
					"content": "Ah ! Ils sont partis. Allez, c'est le moment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310305,
					"content": "Dame Lauma !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 760310306,
					"content": "Sérieusement ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310308,
					"content": "... Merci pour ton travail. Excuse-moi un instant. Je reviendrai te voir après.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310310,
					"content": "Il n'y a personne. Vous pouvez sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310311,
					"content": "Vous saviez qu'on était là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310312,
					"content": "Comment pourrais-je ne pas remarquer Kuu{RUBY#[S]Dame de la lune}tar et son kuuvahki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310313,
					"content": "Puis-je vous demander pourquoi vous me suivez ? C'est comme si vous me regardiez travailler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310314,
					"content": "#Hum, à ce propos... D-{M#Désolés}{F#Désolées}, on voulait vous parler de quelque chose, mais ce n'était pas le bon moment... Heureusement qu'on ne vous a pas mis de pression inutile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310315,
					"content": "Je vois... Très bien, je m'en occuperai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310316,
					"content": "Honnêtement, je me sens mal de vous rajouter une tâche après vous avoir vue travailler toute la journée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310317,
					"content": "Ne vous en faites pas. C'est mon devoir en tant qu'Émissaire de chantelune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310319,
					"content": "... Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310320
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310320,
					"content": "... Après avoir assisté à tout cela, que pensez-vous des Descendants de givrelune d'aujourd'hui, Kuu{RUBY#[S]Dame de la lune}tar ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310321
					],
					"speakerTitle": "Lauma"
