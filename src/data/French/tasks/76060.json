			"dialogs": [
				{
					"id": 760600301,
					"content": "D'accord, ça devrait faire l'affaire. Qu'en penses-tu, Maalaus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Elle a l'air contente ! Héhé, je me demande quel genre de tableau elle va peindre cette fois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Oh ? Tu as déjà fini ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus a l'air un peu triste. Est-ce à cause du tableau ? Regardons-le...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Oh, c'est Columbina... qui se promène au clair de lune et qui contemple le ciel nocturne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Ah... Je dois être en train de regarder la vraie lune au-delà du faux ciel. J'avais l'habitude de faire des promenades la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600310,
					"content": "Vous aviez l'habitude ? Ah, c'est vrai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Columbina est quasiment confinée dans ce jardin... même si elle est née à Nod-Krai...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Oui, je regardais le ciel et je me demandais... ce qui se cachait vraiment là-haut sur la vraie Lune de givre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600313,
					"content": "C'est peut-être comme ici, avec plein de petits animaux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600314,
					"content": "Ou peut-être... qu'il n'y a rien du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600315,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Vous pourriez toujours en emmener quelques-uns avec vous, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ah... C'est une idée intéressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600318,
					"content": "Mais la lune se trouve au-delà du faux ciel, alors je préfère ne pas les emmener dans une telle aventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600322,
					"content": "(L'un est un « foyer » où elle ne peut pas se déplacer librement... L'autre est un « foyer » dont elle ignore tout...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Vous allez vraiment manquer à Maalaus et aux autres kuuhenkis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Elles me manqueront aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600327,
					"content": "Hélas, c'est un voyage que je suis la seule à pouvoir faire... et c'est aussi à moi seule de chercher la réponse à son issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600328,
					"content": "Et qui sait ? Peut-être que cette réponse sera quelque chose de magnifique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600329,
					"content": "Eh bien... On n'aura qu'à venir vous rendre visite ! Avec Maalaus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Nous pourrions organiser cette exposition d'art sur la lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600331,
					"content": "Bonne idée ! C'est promis, alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600333,
					"content": "J'espère que cela se fera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600319,
					"content": "Il pourrait y avoir d'autres créatures mignonnes là-haut...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Hm, je l'espère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600321,
					"content": "Si c'est le cas, j'espère aussi que ces créatures accueilleront favorablement le retour inattendu de leur « déesse ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Columbina"
				}
			]
		},
