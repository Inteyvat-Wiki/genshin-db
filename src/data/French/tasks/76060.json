			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Hein ? C'est Maalaus, non ? Est-elle encore allée à la recherche d'inspiration ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Oui, mais elle est dans cet état depuis qu'elle est revenue... Comme si elle était perdue dans ses pensées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600104,
					"content": "Hum, peut-être que le thème de cette fois est profond... Un peu comme quand un grand artiste se rend compte d'une vérité fondamentale du monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "D'ailleurs, Maalaus nous a peint tout un tas de tableaux. On pourrait organiser une exposition entière à ce rythme !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Je suis impatiente de raconter à tout le monde comment notre petite peintre est devenue une star ! Ah, mais il nous faudrait d'abord la permission de Columbina, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hm ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600108,
					"content": "Parce que ce sont quasiment toutes des peintures de vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Oh... Cela ne me dérange pas. C'est intriguant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600110,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Oh, on dirait que Maalaus a décidé de ce qu'elle allait dessiner ! Vite, voyons ce que nous avons comme couleurs de peintures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Cette fois-ci... Optons pour des couleurs foncées et tranquilles !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
