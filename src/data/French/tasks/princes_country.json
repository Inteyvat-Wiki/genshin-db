			"dialogs": [
				{
					"id": 401290801,
					"content": "Zuria, Fréminet, on pourrait peut-être commencer par dessiner les nouvelles pages ? J'ai hâte de mettre à jour le livre illustré !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290802,
					"content": "Tu veux surtout que quelqu'un dessine la déesse Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290803
					]
				},
				{
					"id": 401290803,
					"content": "Hé ! Tu n'avais pas besoin de dire ça à voix haute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290804,
					"content": "Haha, c'est d'accord. Alors, voici le récit de la journée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290805
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290805,
					"content": "Après avoir surmonté de nombreux obstacles, le prince Thelxie et ses courageux compagnons arrivent enfin aux portes du Royaume des Diableautins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290806
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290806,
					"content": "C'est ce moment-là que Paimon, la petite fée du groupe, a choisi pour révéler à ses compagnons qu'elle est en réalité une déesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290807
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290807,
					"content": "Trop bien ! C'est mon moment ! Je félicite tous les aventuriers pour leur pureté, et leur accorde un grand nombre de bénédictions pour les récompenser. Je souhaite aussi que le prince réussisse pleinement son objectif !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290808,
					"content": "Encouragés par les bénédictions de la déesse, le prince et ses compagnons chargent vers le repère des ennemis, vainquent tous les monstres qui s'y trouvent, et libèrent les adorables Diableautins de leur prison. Le prince parvient enfin à reconquérir son royaume, mais sa couronne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290809
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290809,
					"content": "Oh non, la couronne n'est pas encore prête !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290810,
					"content": "Non... Le prince ne parvient pas à récupérer sa couronne, car les monstres l'ont emportée avec eux dans leur fuite. Ils n'ont pas abandonné, et comptent bien revenir se venger, mais le prince est certain qu'il pourra récupérer sa couronne lors de la prochaine bataille. Et lorsque ça arrivera, un arc-en-ciel de lumière brillera à nouveau sur le royaume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290811
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290811,
					"content": "On s'y croirait vraiment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290812,
					"content": "Waouh, c'est magnifique... Zuria est vraiment douée en dessin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290813,
					"content": "Merci à tous. Nous avons fini la deuxième page du livre illustré. L'aventure de Thelxie touche à sa fin, il va bientôt devenir roi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290814
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290814,
					"content": "Mon fils, tu pourras alors aussi te réjouir, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290815
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290815,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290816
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290816,
					"content": "Je suis sûr que oui, Zuria ! Qui sait, le docteur aura peut-être déjà de bonnes nouvelles à votre retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290817,
					"content": "Puissiez-vous avoir raison, ô grande déesse. Fréminet, à propos de la fabrication de la couronne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290818
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290818,
					"content": "Ne vous inquiétez pas, je devrais pouvoir finir demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290819
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290819,
					"content": "Merci de travailler aussi dur. Rencontrons-nous ici dans deux jours pour le grand final de notre aventure, d'accord ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290820
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290820,
					"content": "D'accord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290821
					]
				},
				{
					"id": 401290821,
					"content": "À dans deux jours, chers amis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290822
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290837,
					"content": "♪ ♫ ♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290822,
					"content": "Bon, on ferait bien d'y aller aussi. Je pense que vous avez encore du travail, Fréminet ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290823,
					"content": "Oui, je dois aller en ville pour acheter des pièces pour la base de la couronne. Je voudrais essayer différents modèles avant de choisir celui qui conviendra le mieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290824,
						401290825
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290824,
					"content": "Fréminet est vraiment investi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290825,
					"content": "Fréminet se donne vraiment à fond.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290826,
					"content": "Oui, je savais que Fréminet n'acceptait pas souvent de commandes, mais je ne m'attendais pas à ce qu'il s'investisse autant quand il le faisait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290827,
					"content": "... C'est... peut-être parce que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290828
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290828,
					"content": "Parce que ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290829,
					"content": "Parce que... j'espère que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290830
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290830,
					"content": "Qu'y a-t-il ? Et pourquoi faire cette tête ? J'ai l'impression que vous rougissez et que vous allez remettre votre casque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290831,
					"content": "Ah bon, je rougis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290832
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290832,
					"content": "Arrête d'embêter Fréminet, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290833
					]
				},
				{
					"id": 401290833,
					"content": "Haha, d'accord... On ne vous dérange plus, Fréminet. Retrouvons-nous après-demain !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290834,
					"content": "... Merci. À dans deux jours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290835
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290835,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290836
					]
				},
				{
					"id": 401290836,
					"content": "... J'espère que tous ceux qui ont connu des moments difficiles pourront voir le bout du tunnel et connaître le bonheur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréminet"
				}
			]
