			"dialogs": [
				{
					"id": 401290901,
					"content": "Voici donc les ruines sous-marines que Fréminet a trouvées... Elles sont remarquables, mais ce n'est pas exactement ce à quoi je m'attendais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "C'est le Royaume des Diableautins, Paimon, pas des ruines...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Oui, je sais, c'est juste que... je pensais vraiment voir un monde de conte de fées, avec les maisons colorées et le pont couleur arc-en-ciel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Désolé... J'avais l'intention de les décorer, mais je travaillais seul et j'ai manqué de temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290905,
					"content": "Ce n'est pas grave, on n'a qu'à imaginer !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "#Waouh ! On dirait que tu es déjà dans le monde imaginaire, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#On dirait que {NICKNAME} a tout compris. Vous devriez faire de même, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290908,
					"content": "Hé, ne dites pas ça ! Je peux le faire aussi. Dès maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "Ahem... Jeunes aventuriers ! Je suis Paimon, la déesse protectrice de ce royaume. Qui êtes-vous, et que venez-vous faire ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290911,
					"content": "Nous sommes les compagnons du prince Thelxie, et nous sommes venus l'aider à retrouver sa gloire perdue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290912,
					"content": "Retrouver sa gloire perdue ? Votre déesse a de la gloire d'or, de la gloire d'argent et de la gloire de bronze. Quel genre de gloire le prince a-t-il perdu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290914,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290915,
					"content": "Es-tu sortie de ton personnage, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Pas du tout ! C'est le test divin ! J'en déduis de vos réponses que vous êtes tous de courageux aventuriers, sans une once de cupidité ! Vous méritez donc le respect !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Comme récompense, je vous offre la gloire d'or, la gloire d'argent et la gloire de bronze !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "Quant au prince... Je vous offre la gloire arc-en-ciel pour que votre avenir ne connaisse plus jamais l'obscurité !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Merci pour ces bénédictions divines, je sens que je déborde désormais d'énergie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290921,
					"content": "Moi... Moi aussi... Serait-ce l'inspiration divine de la légende ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290922,
					"content": "La déesse Paimon est vraiment remarquable !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Haha ! Aventuriers, poursuivez votre quête, et chassez les monstres qui occupent le royaume ! Cette victoire est la clé de ce que vous cherchez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
