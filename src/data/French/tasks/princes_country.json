			"dialogs": [
				{
					"id": 401290601,
					"content": "C'est enfin fini ! Alors, avons-nous vaincu les monstres maléfiques et réussi à reprendre le Royaume des Diableautins ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Oui, c'est maintenant l'heure de la cérémonie d'intronisation de Thelxie... C'est juste que... je pensais qu'il serait plus difficile d'arriver au cœur des ruines. Je ne m'attendais pas à ce que tout se passe aussi bien aujourd'hui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290603,
					"content": "C'est ma faute, j'aurais dû demander plus tôt à Fréminet de fabriquer une couronne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290604,
					"content": "#C'est parce que {NICKNAME} et la déesse Paimon sont trop {M#forts}{F#fortes} ! Les monstres n'ont eu aucune chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "Ne vous inquiétez pas, Zuria. Nous reviendrons quand la couronne sera prête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290606,
					"content": "Merci à tous pour votre aide. Et toi aussi Thelxie, mon enfant, tu as été génial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "Thelxie s'est révélé être un combattant redoutable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "C'est un vrai prince maintenant, rien ne pourra plus l'arrêter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290610,
					"content": "Vous avez raison, Fréminet !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290611,
					"content": "#Retournons au campement. J'ai demandé à {NICKNAME} de trouver des matériaux en cours de route afin que je puisse terminer la couronne le plus vite possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290612,
					"content": "Et nous pouvons également mettre à jour les aventures fantastiques de Thelxie ! Maintenant que nous avons repris le Royaume des Diableautins, nous pouvons remplir une nouvelle page du livre illustré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
