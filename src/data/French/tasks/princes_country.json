			"dialogs": [
				{
					"id": 401290101,
					"content": "Est-ce que votre enfant va mieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290102,
					"content": "C'est gentil de demander. Son état est stable. Le docteur a dit qu'il pouvait sortir se détendre aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290103,
					"content": "Zuria, Fréminet ! Nous sommes là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Ah, tout le monde est là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290105,
					"content": "J'ai l'impression qu'il manque encore quelqu'un. Mais je pense savoir où il se trouve !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "Hé, Thelxie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... .-- -... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290108,
					"content": "Waouh ! Il a même une épée et un bouclier maintenant, quelle allure !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "C'est vrai qu'il a fière allure comme ça. Vous vous êtes vraiment surpassé, Fréminet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290110,
					"content": "On a participé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "Oui, les matériaux que vous avez trouvés étaient tous de très bonne qualité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290112,
					"content": "En parlant de ça, Zuria vient de me dire qu'elle souhaiterait terminer l'aventure sur une cérémonie d'intronisation. Pourrais-je encore vous embêter en vous demandant de trouver des matériaux pour la couronne ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290113,
					"content": "Vous en trouverez sûrement sur le chemin vers les ruines. J'avais l'intention de m'en occuper, mais je me suis dit que vous en trouveriez de bien plus beaux que moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290114,
					"content": "Vous pouvez compter sur moi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "On dirait que tout est prêt. On se mettrait en route ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Attendez un peu. Puisque Thelxie a déjà révélé sa nouvelle apparence, on pourrait peut-être remplir une nouvelle page du livre. Qu'est-ce que vous en pensez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290117,
					"content": "Oh ! J'ai hâte de voir ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "Vous pensez à quoi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "Hmm, pourquoi ne pas utiliser l'histoire que nous connaissons comme référence ? Le dessin serait déjà moins triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290120,
					"content": "Vous voulez dire retirer les parties tristes pour les remplacer par des choses plus gaies ? C'est une bonne idée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Très bien, je vais essayer. Je ne suis pas très douée en dessin, mais j'ai vu beaucoup d'œuvres d'art avec mon travail. Quant au contenu réel du dessin... Dites-moi simplement ce que vous aimeriez y voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290122,
					"content": "À mon avis... On devrait dessiner l'arme. Le prince ramasse l'épée du courage et le bouclier de la persévérance, démontrant qu'il a surmonté ses doutes et qu'il est prêt à affronter les ténèbres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290123,
					"content": "D'accord, je vais ajouter son arme... Autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290124,
					"content": "Je pense qu'il faut ajouter des compagnons ! Thelxie a des compagnons de confiance à ses côtés cette fois. Il n'est plus seul à combattre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "Va pour les compagnons... Autre chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290126,
					"content": "Il faut des couleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Oh oui, des couleurs ! C'est très important. La route devant lui n'est plus sombre et triste, elle est désormais colorée et pleine d'espoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290128,
					"content": "Je ne m'attendais pas à tant d'inspiration... Très bonnes idées, tout le monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290129,
					"content": "Super ! Tout le monde a l'air motivé, et particulièrement Thelxie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290130,
					"content": "T'as vu ça, mon garçon ? Est-ce que ça t'inspire aussi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290132,
					"content": "Je suis sûr que oui, Zuria. Et ce n'est que la première page !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290133,
					"content": "J'ai vraiment hâte de voir le livre une fois qu'il sera terminé ! Essayons de le terminer le plus vite possible en le remplissant d'espoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290134,
					"content": "Moi aussi, j'ai hâte ! Alors, mettons-nous en route vers le Royaume des Diableautins !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290135,
					"content": "Les aventures fantastiques de Thelxie commencent maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
