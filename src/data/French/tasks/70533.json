			"dialogs": [
				{
					"id": 705330101,
					"content": "Quelle surprise de voir mon invention utilisée de cette manière...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330102,
					"content": "#Oh ! Bonjour, {M#voyageur}{F#voyageuse}. Nous nous retrouvons... *tousse* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330103,
					"content": "Je pensais que vous aviez quitté Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "C'était prévu, mais les choses ont changé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330108,
					"content": "Ahem, revenons-en au sujet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330109,
					"content": "Cette fois-ci, j'ai été invité par la Guilde des aventuriers de Mondstadt pour créer plusieurs cadres mécaniques inspirés par des illustrations de cartes qui peuvent être assemblés et désassemblés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330110,
					"content": "Quel était le nom de ce jeu de cartes déjà ? Ah oui, l'Invocation des Sept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330111,
					"content": "La Guilde m'a dit que les cadres seraient exposés pendant un Grand prix comme un mini-jeu pour animer l'ambiance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330112,
					"content": "*soupir* Toutes ces choses sont trop compliquées pour moi, je devrais me concentrer sur mes inventions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330113,
					"content": "Ah oui, j'ai les cadres que j'ai fabriqués à Mondstadt avec moi. Si vous voulez jouer un peu avec, n'hésitez pas à me le dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330105,
					"content": "Encore un problème avec votre invention ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "Pas du tout ! Pas cette fois, en tout cas... Non, il n'y a jamais eu de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330107,
					"content": "Quand je vous ai demandé votre aide la dernière fois, c'était pour les monstres ! Pas mon invention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				}
			]
		}
	]
