			"dialogs": [
				{
					"id": 20185301,
					"content": "Tant qu'on a le Kendo d'insouciance avec nous, les habitants d'Inazuma n'ont rien à craindre. C'est une évidence, mais Sara est aveugle... Hmpf.",
					"roleType": "TALK_ROLE_NPC",
