		},
		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Signora",
					"Paimon",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "La façon dont les gens débarquent ici à leur guise, quel manque d'éducation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190102,
					"content": "Si je ne savais pas qu'on était au Tenshukaku, je me croirais dans un marché de rue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190103,
					"content": "Vous avez appris votre leçon maintenant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190104,
					"content": "Oh non, qu'est-ce qu'elle a fait à Kujou Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "Le droit de punir les Inazumiens pour leurs crimes est mien et mien seul, Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190106,
					"content": "... Toutes mes excuses, Shogun toute-puissante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190107,
					"content": "Signora !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Je sais que vous n'arrivez pas à me sortir de votre tête. Mais vous n'avez pas besoin d'appeler mon nom en permanence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190109,
					"content": "Ne pensez pas que je sois surprise de vous voir ici. Je sais bien que vous me détestez, vu la façon dont vous me suivez comme une ombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190110,
					"content": "Vous distribuez secrètement des yeux maléfiques...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "#Ah, alors vous êtes {M#venu}{F#venue} exposer mes crimes à la Shogun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190113,
					"content": "Héhéhé... Je ne suis qu'une diplomate snezhnayienne. Je crains de ne pas savoir de quoi vous parlez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190114,
					"content": "Elle ne nous prend pas au sérieux du tout...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Pour tous ceux qui ont perdu leur œil divin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Arrêtez de parler de gens et de choses dont je me fiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190118,
					"content": "Ils n'étaient personne de toute façon et leurs noms seront oubliés. Mais à présent, au moins, ils contribuent à la grande révolution pour réaliser l'éternité...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190119,
					"content": "N'est-ce pas là le plus grand honneur qu'ils pouvaient espérer au cours de leur misérable vie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190120,
					"content": "Shogun toute-puissante... Corrigez-moi si je me trompe ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190122,
					"content": "Pour le Gnosis de Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "#C'est de l'histoire ancienne. Vous avez du mal à passer l'éponge, {M#cher ami}{F#chère amie}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190125,
					"content": "Le rêve de la Tsarine est la chose la plus noble et la plus pure au monde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190126,
					"content": "Ces autres détails sans importance sur lesquels vous insistez... Ce ne sont que des sacrifices nécessaires. C'est tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190127,
					"content": "Il est temps pour moi de vous arrêter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "Vous ? M'arrêter ? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190129,
					"content": "De toute façon, je commençais à en avoir marre de vous. Mais je ne pensais pas que vous étiez aussi téméraire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190130,
					"content": "#Avant de dire quoi que ce soit que vous pourriez regretter, rappelez-vous que vous êtes {M#le criminel le plus recherché}{F#la criminelle la plus recherchée} d'Inazuma... Je vous suggère d'examiner la situation très attentivement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190131,
					"content": "#Débarquer au Tenshukaku sans y être {M#invité}{F#invitée} et me faire la leçon devant la Shogun n'était pas ce qu'il y avait de plus intelligent. Vous ne pensez pas qu'il est temps d'arrêter de vous enfoncer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190132,
					"content": "Je ne suis pas sûre que vous réalisiez la distance qu'il y a entre nous, que ce soit en termes de statut... ou de force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190133,
					"content": "Je vous défie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "... en duel devant le trône !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190136,
					"content": "Faites donc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190137,
					"content": "#Eh bien, vous êtes {M#plein}{F#pleine} de surprises aujourd'hui... alors vous aussi, vous avez appris à tirer profit des lois de ce pays, hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190138,
					"content": "#J'admets que je n'aurais jamais pensé me retrouver dans une situation où nous serions {M#tous}{F#toutes} les deux sur un pied d'égalité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190139,
					"content": "#Vous êtes au courant... que le perdant doit mourir, n'est-ce pas ? Vous êtes {M#sûr}{F#sûre} que c'est ce que vous voulez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Héhéhé... alors je daignerai partager cette dernière danse avec vous... jusqu'à ce que la mort nous sépare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190123,
					"content": "Pour les habitants de Liyue que vous avez mis en péril...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Pour tous ceux qui ont souffert des yeux maléfiques...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Vous essayez de prendre le contrôle d'Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}