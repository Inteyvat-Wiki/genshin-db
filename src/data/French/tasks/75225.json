			"dialogs": [
				{
					"id": 752250101,
					"content": "Ah, quel beau défi à relever. Dommage qu'il ne soit pas possible de le faire en dehors des cycles d'éruption...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250102
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250102,
					"content": "#Bonjour, {M#guerrier des contrées lointaines}{F#guerrière des contrées lointaines}. Je peux voir la détermination dans votre regard ! Ça vous dirait d'essayer ce parcours de rochers roulants ? Les règles sont simples ! Passez à travers les rochers roulants et atteignez l'arrivée de la piste !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250103
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250103,
					"content": "Ce ne sera pas de la tarte. Alors ? Ça vous tente ?",
