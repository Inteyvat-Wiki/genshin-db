			},
			"dialogs": [
				{
					"id": 240020201,
					"content": "Mademoiselle Isadora, puis-je vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Officière Muirne, j'ai une question pour vous. Vous souvenez-vous de la pile de comptes que j'ai apportée au bureau ce matin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Je m'en souviens, oui. Vous avez également été attaquée par des goélands ichthyaètes or-violet, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "C'est exact ! Une fois que ces goélands ennuyeux se sont envolés, je me suis précipitée vers mon bureau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "Savez-vous si j'ai fait tomber des pages dans la précipitation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Hmm... Je ne saurais pas vous dire. J'étais occupée à ce moment-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Mais si vous en avez besoin tout de suite, nous pouvons « reconstituer » votre trajet vers le bureau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "Hein ? Vraiment ? Je... ne veux pas trop vous demander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Nous devons juste trouver des pages, c'est bien plus facile que de travailler au Palais Mermonia, c'est certain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Je me souviens que vous aviez lié vos documents en piles. Est-ce exact ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Oui ! Vous êtes très observatrice ! Nous devons être très précis dans nos rapports d'examen des coûts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Tout doit être répertorié, des grandes tâches comme l'entretien des murs extérieurs du Palais par des artisans, aux plus petites comme changer le verrou d'un tiroir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "C'est pour ça qu'il y a tant de documents tous les mois, et que nous devons les attacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Dans ce cas, il est impossible qu'une seule feuille se soit envolée. Si vous aviez perdu des documents, vous auriez perdu toute une pile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Vous n'étiez pas arrivée au bureau depuis longtemps, partons maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
