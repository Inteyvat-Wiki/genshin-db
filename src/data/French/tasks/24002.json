			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isadora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Hein. Où est-il allé ? Quelle malchance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Argh. Je ne pourrais plus écrire une ligne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "Vous avez perdu quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Hmm, j'espère que je les ai « seulement » perdues, je suis une optimiste, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "Vous appelez ça de l'optimisme ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Haha... Si ce que vous avez perdu est le registre des dépenses semestrielles du bureau, peut-être bien, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Je dois bientôt remettre les comptes à mademoiselle Keiser... Mais je viens de découvrir qu'il manquait cinq pages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Ces cinq pages proviennent de cinq mois différents et contiennent un grand nombre de dépenses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Ce n'est que lors de l'examen final que j'ai remarqué qu'elles avaient disparu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Si je ne les avais pas égarées, et que je ne les avais jamais écrites du tout... Alors comment sommes-nous arrivés à ce montant final pour nos dépenses officielles ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Argh, je n'ose pas y penser. Si j'ai vraiment oublié de les écrire, mademoiselle Cadme risque de me forcer à déterrer les registres des dix dernières années pour les faire vérifier à nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Ça a l'air plutôt grave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "C'est parce que ça l'est ! Si les documents n'ont pas été rédigés ou qu'ils ont été perdus, ce sont pas mal de bureaux qui auront des problèmes de financement le mois prochain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Quelle malchance... Je me souviens seulement d'avoir passé une nuit blanche à faire les comptes pour les amener au Palais Mermonia aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "En arrivant ici, j'ai été surprise par une volée de goélands, et j'ai lâché prise l'espace d'un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "*soupir* J'ai dû perdre les pages à ce moment-là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Je vais vous aider à chercher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "#Vous seriez {M#prêt}{F#prête} à m'aider ? Merveilleux ! Venez, commençons par cette route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "Les données contenues dans ces pages ne sont pas confidentielles, donc vous pouvez les ramasser sans problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "Ah, oui, j'ai aussi rencontré l'officière Muirne ! Elle m'a même aidée à chasser les goélands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "On peut lui demander si elle a vu le registre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "Cherchons ensemble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Vous trouvez ça bien de perdre quelque chose ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
