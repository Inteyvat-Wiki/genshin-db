				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Ah, ce sont les documents que je cherchais ! Oh, merci, merci beaucoup, ils sont tous là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Pourquoi faisiez-vous les comptes au café ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "E—Eh bien, j'ai besoin de beaucoup de café pour être sûre de bien compter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Il s'agit des dépenses de tous les bureaux du Palais Mermonia. C'est normalement le travail de cinq personnes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Mais à part moi, tout le monde au bureau doit souvent aider un autre bureau, travailler à l'extérieur ou s'occuper de visites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Alors, quand est venu le temps de faire les comptes, il n'y avait que moi pour le faire. Je n'ai pas dormi depuis des jours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Et ce n'était pas seulement faire les comptes, je devais aussi régler des factures. Mes yeux sont tellement fatigués que je ne vois plus clair...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Enfin, c'est bien que nous ayons trouvé ces pages. Si vous me le permettez, mademoiselle Isadora, je vais vous raccompagner au Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "#Merci, officière Muirne. *soupir* {M#Le voyageur}{F#La voyageuse} et vous êtes les deux seules bonnes âmes que j'ai rencontrées ces trois derniers mois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "Tous les autres me crient dessus ou me rappellent de travailler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "Argh, non, non, je dois arrêter de me plaindre. Je dois y aller, ou mademoiselle Keiser va encore me crier dessus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}