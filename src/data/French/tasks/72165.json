			"dialogs": [
				{
					"id": 721650101,
					"content": "Vous êtes de retour. Y a-t-il quelque chose que je peux faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650102,
					"content": "S'il vous plaît, faites-moi une prédiction !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#Moi aussi, je veux savoir si {NICKNAME} aura de la chance aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650104,
					"content": "Hmm... D'après le motif des feuilles de l'herbe spirituelle... Vous aurez de la chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650105,
					"content": "Votre chance vous accompagnera au point culminant de l'Île de Watatsumi, dans un ancien lieu dédié aux dieux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650106,
					"content": "Hmm... Pourquoi je ne vois rien de tout ça, moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650107,
					"content": "Héhé, c'est ce qu'on appelle la sagesse des anciens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650108,
					"content": "Vous ne seriez pas en train de me faire marcher ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
