			},
			"dialogs": [
				{
					"id": 221020101,
					"content": "Je n'en peux plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Regardez-moi ces cernes ! Je n'ai pas fermé l'œil depuis plusieurs jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020104,
					"content": "Les clients de l'auberge sont tous aussi fous les uns que les autres... Il y a même un écervelé qui a essayé de sauter du haut du bâtiment ! Du haut du bâtiment ! À quoi ça rime ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020105,
					"content": "Enfin... Je viens de passer une commande en ville qui devrait bientôt arriver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020106,
					"content": "Les monstres qui rôdent sur la route voudront sûrement passer à l'action, alors pourriez-vous m'en débarrasser ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020107,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Je m'en remets donc à vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020108,
					"content": "Quelle idée aussi bien d'avoir monté une auberge ici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Eh bien... J'aime à penser qu'à ouvrir ses portes à tout le monde, on est un peu la croisée des chemins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020111,
					"content": "On s'en sort ; c'est juste qu'on est un peu plus à l'écart et qu'on accueille un peu plus de monde que d'autres auberges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020112,
					"content": "Merci de votre aide. Bon courage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
