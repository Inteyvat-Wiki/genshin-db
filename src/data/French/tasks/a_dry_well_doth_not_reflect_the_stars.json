			"dialogs": [
				{
					"id": 100040601,
					"content": "Pfiou, c'est terminé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040602,
					"content": "Bon, la vieille a dit d'ouvrir la troisième lettre quand ce sera fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040603,
					"content": "Mais je n'y suis pas arrivée. Hum... Je l'ouvre quand même ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040604,
					"content": "Hmm. Tu sais, je crois que je comprends beaucoup mieux votre dynamique maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040605,
					"content": "Elle n'a pas dit que tu devais réussir la cérémonie, juste la faire. Du coup, tu peux ouvrir la lettre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040606,
					"content": "C'est vrai. Enfin, je ne crois pas que la vieille ait écrit quoi que ce soit de sympa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040607,
					"content": "« Si tu lis cette lettre, c'est que tu as tenté d'ouvrir le signe de vérité. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040608
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040608,
					"content": "« Sérieusement, je n'arrive pas à croire que tu l'as vraiment fait ! Hahahahaha... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040609
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040609,
					"content": "Qu'est-ce qui vous fait autant rire ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040610,
					"content": "« Khaenri'ah était le foyer de plusieurs lacs d'étoiles, ce qui rend l'espace instable dans la zone. Par conséquent, les tentatives de franchir le firmament par des moyens non physiques avaient plus de chances de réussir. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040611
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040611,
					"content": "« En tout cas, je savais que cet endroit était bien caché et pas fréquenté. Les conséquences négatives liées à l'échec de l'ouverture du signe de vérité resteraient donc minimes. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040612
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040612,
					"content": "« Tu es mon apprentie, alors évidemment, je suis convaincue que tu étais capable de t'occuper des créatures de l'Abîme qui rodent au-delà du faux ciel. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040613
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040613,
					"content": "« Même si tu ne pouvais pas à les éliminer, tu serais arrivée à les semer. Tu as toujours été très rapide pour t'enfuir. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040614
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040614,
					"content": "« Ah, arriver à faire le lien entre l'hydromancie et la sagesse qui étanche la « soif »... Mon génie est vraiment sans limites. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040615
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040615,
					"content": "« L'utilisation du disque d'eau a également permis de réduire les perturbations causées par le faux ciel. J'aimerais bien voir Alice essayer de faire mieux ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040616
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040616,
					"content": "Mona s'arrête de lire. Apparemment, la « vieille » continuait de se jeter des fleurs pendant longtemps.\\n\\nAprès avoir réfléchi aux résultats de votre observation, vous rentrez à Mondstadt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
