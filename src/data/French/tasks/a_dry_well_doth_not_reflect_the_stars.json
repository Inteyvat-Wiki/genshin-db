			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona, on a quelque chose pour toi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Oh, {NICKNAME} et Paimon. Vous avez l'air bien en forme aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "Vous avez quelque chose pour moi ? Est-ce que c'est... un moyen facile et rapide de gagner des moras ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "À vrai dire, c'est une « tâche » de ton maître.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "Je n'en veux pas ! Ugh, mais je suppose que je n'ai pas le choix... C'est important d'être entreprenante et tout, mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "Je sais que ça va être de la torture. Je connais très bien la vieille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Et si tu regardais d'abord de quoi il s'agissait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Ce livre n'a pas l'air vraiment spécial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Ouah, des lettres sont tombées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Oh ! Peut-être qu'elle essaie de se réconcilier avec toi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "Aucune idée. En tout cas, on dirait que je suis censée ouvrir ces trois lettres dans l'ordre. Commençons par la première.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "Si c'est une « tâche » de sa part, il n'y a pas de raison que vous ne puissiez pas la lire. Allez, voyons voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "« Cela faisait longtemps, mon apprentie. Malheureusement, mes vieilles jambes sont fatiguées, et se lever devient de plus en plus pénible ces derniers temps... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Elle n'a pas perdu de temps avant de jouer la carte de l'émotion. Peut mieux faire... Elle aurait pu amener ça de manière plus sincère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "« Souviens-toi quand je te poursuivais et que tu courais à toute vitesse pour sauver ta peau, en essayant de te servir de ton mirage Hydro pour me distraire ? Ah, c'est comme si c'était hier... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "« Maintenant, tu n'es plus là et je passe mes journées assise sur mon fauteuil à bascule. Je devrais me remettre au sport... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Bah, bouge-toi les fesses autrement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Hum, je crois qu'on devrait arrêter d'écouter. Ça a l'air assez personnel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "« Tu dois te demander pourquoi je t'ai écrit, alors je vais te répondre ceci : si tu souhaites apprendre à prédire l'avenir d'un royaume, ou même celui du monde entier... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "« Rends-toi à Sumeru et cherche la porte qui mène au royaume souterrain. Une fois que tu seras là-bas, ouvre la deuxième lettre. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Cette vieille sait comment attirer l'attention des gens. Est-ce qu'elle veut vraiment m'enseigner sa technique secrète ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "C'est vrai qu'elle n'est plus toute jeune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "Vous avez une dynamique bien bizarre toutes les deux. Quand vous parlez de choses sentimentales... ça éclate en dispute, mais quand il s'agit de choses académiques, tu deviens émotive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Bref, cette « porte vers le royaume souterrain » me dit quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Vous en avez déjà entendu parler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "Oui, c'est sûrement la même qu'on connaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Parfait ! Je n'ai même pas besoin de m'embêter à trouver ! Pas de guide à engager ou de logement à trouver, j'économise des moras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "En route ! Pas une seule seconde à perdre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "Et tu n'as pas parlé de frais de transport, alors j'imagine que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Oui, on utilisera le même moyen que d'habitude ! C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
