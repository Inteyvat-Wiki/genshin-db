					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "Ça me rappelle des souvenirs de l'été. C'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040202,
					"content": "C'est donc ici la porte qui mène vers le royaume ancien de Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040203,
					"content": "Je suis sûre que beaucoup de secrets et de tragédies se cachent derrière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040204,
					"content": "Bon, ouvrons la deuxième lettre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040205,
					"content": "Voyons voir... Oui, c'est celle-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040206,
					"content": "« Comme le dit un ancien proverbe sumérien : « Le savoir appris par cœur ne porte pas ses fruits tant qu'il n'est pas arrosé par la pluie de la sagesse. » Dans cette optique, il existe en ces terres un phénomène connu sous le nom de « signe d'Apaosha ». »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040207,
					"content": "« C'est un symbole céleste qui brûle en réaction à un désir trop ardent de connaître la vérité. Il serait presque plus adapté de l'appeler le signe de la vérité... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040208,
					"content": "« Les archives de ce royaume ancien indiquent l'existence de plusieurs lacs souterrains à Khaenri'ah, aussi calmes et limpides que des miroirs. À leur surface se reflètent les vraies étoiles. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040209,
					"content": "« C'est parce que le « signe de vérité » créé dans l'eau est capable de contourner le faux ciel et de se connecter à l'univers extérieur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040210,
					"content": "Je ne savais pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040211,
					"content": "« Afin d'observer les forces gravitationnelles et l'influence des corps célestes, il faut être capable de voir au-delà du faux ciel. Ce n'est qu'avec ces paramètres cosmiques qu'il est possible de prédire le destin de ce monde. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040212,
					"content": "« Maintenant, la tâche que je te confie est la suivante : Ouvre un « signe de vérité » devant la porte vers Khaenri'ah. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040213,
					"content": "Le reste de la lettre, c'est tout un tas d'informations sur la cérémonie que la vieille a imaginée pour invoquer ce truc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040214,
					"content": "Trajectoires planétaires, runes... Bon, je ne vais pas m'embêter à comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040215,
					"content": "Est-ce que tu vas tenter, Mona ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040216,
					"content": "Je n'aime pas l'admettre, mais on dirait que les paramètres de la vieille pourraient bien fonctionner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040217,
					"content": "Franchement, cette perspective m'enthousiasme. Rentrer ne me coûterait qu'une nuit supplémentaire. Alors... c'est le moment idéal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040218,
					"content": "Émissaires des étoiles éternelles, vagabonds des plans écliptiques et équatoriaux, frères célestes radieux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040219,
					"content": "Traversez les chemins sinueux du vide caverneux. Moi, l'astromancienne Mona Megistus, j'invoque le pouvoir de l'élément Hydro pour équilibrer la balance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040220,
					"content": "Que la sagesse et la vérité apaisent cette soif. Moi, l'astromancienne Mona Megistus je vous en conjure, ô étoiles, de vous présenter à moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040221,
					"content": "Ç—Ça a marché ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040222,
					"content": "Ah ! Des monstres ? Comment ça se fait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040223,
					"content": "Ce n'était pas une franche réussite. Le signe de la vérité est resté ouvert assez longtemps pour que des monstres s'y faufilent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040224,
					"content": "Zut ! Je n'ai même pas pu voir les vraies étoiles. Tant pis, je vais devoir me défouler sur vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
