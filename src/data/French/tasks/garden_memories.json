	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Catherine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "Pour résumer, la zone contaminée s'est avérée être une fuite des lignes énergétiques au cœur de la forêt. Et les choses sont revenues à la normale maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "D'accord, je vois. Merci à vous pour votre travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 130030103,
					"content": "Une fois que l'excès d'énergie des lignes énergétiques dans l'air se sera dissipé, nous pourrons poster une annonce pour dire aux habitants qu'ils peuvent à nouveau librement accéder à la zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 130030104,
					"content": "Voici la récompense promise. Tenez, c'est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Catherine"
				},
				{
					"id": 130030105,
					"content": "Après avoir quitté la Guilde des aventuriers, Paimon vous amène dans un endroit calme...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Est-ce que Karkata... va être renvoyé à l'Académie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "Certes, il est cassé, mais quand je pense qu'il va être désassemblé, ça me rend triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Moi aussi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "Oh ! Alors dans ce cas, est-ce qu'on n'irait pas voir Tighnari demain pour lui demander de ne pas le faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "#J'ai très envie d'y aller maintenant, mais Tighnari a dit que l'on «{NON_BREAK_SPACE}verra demain pour le reste ». Si on y va maintenant, il va sans doute se mettre en colère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Probablement, oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Alors c'est décidé : on ira voir Tighnari demain et on lui dira de ne pas démonter Karkata !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tighnari !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "Chut, moins fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030303,
					"content": "Daphné lilas, de la famille des thyméléacées. Possède des propriétés anticonvulsives notables. Peut être utilisé pour créer de la poudre anesthésiante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030304,
					"content": "Si l'on se fie aux deux ensembles de données expérimentales, elle serait la plante la plus efficace contre des agents comme les toxines marines... Continue d'enregistrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030305,
					"content": "Goulou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "Karkata ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "Goulou ! Goulou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "Je croyais vous avoir dit de parler moins fort. Les plantes n'ont pas peur du bruit, mais vos cris font siffler mes oreilles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030309,
					"content": "V—Vous n'avez pas démonté Karkata ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "Non, pourquoi le ferais-je ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030311,
					"content": "Vous avez dit que « les règles de l'Académie veulent que »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "#C'est donc pour ça que vous êtes {F#venues}{M#venus} de bon matin pour perturber ma tranquillité. Bon, je n'ai pas été très clair hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030313,
					"content": "Ce que je voulais dire, c'est que selon la politique de l'Académie, tous les produits de la recherche doivent être détruits. Et c'est la raison pour laquelle on ne peut pas laisser l'Académie découvrir cet endroit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030314,
					"content": "Alors si vous êtes resté là-bas, c'est en réalité pour...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "J'ai commencé par réparer Karkata. Pendant mon séjour à l'Académie, j'ai suivi un cours facultatif au Spantamad. Qui aurait cru que cela me serait utile un jour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030316,
					"content": "Ensuite, lui et moi, on a enterré Abattouy. J'ai fait le tri dans les données de recherches. Je vais en garder une petite partie en souvenir et brûler le reste pour éliminer toutes les preuves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030317,
					"content": "Je ne suis pas de l'Académie, alors pourquoi leurs règles me concerneraient-elles ? Au contraire, maintenant que je suis brigadier forestier, j'ai le devoir de protéger toutes les formes de vie de la forêt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030318,
					"content": "Toutes les vies qui naissent en ce monde ont une raison d'être, et Karkata ne fait pas exception à cela. Tout ce qui existe ne peut être abandonné ou détruit à la légère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030319,
					"content": "Héhé ! C'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "Gouloulou ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Par contre, vous venez de dire « toute forme de vie ». Ça veut dire que vous considérez Karkata comme une véritable créature vivante ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "C'est une possibilité. Après tout, il est difficile d'expliquer pourquoi il a cherché à « réparer » Abattouy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030323,
					"content": "Abattouy n'a laissé derrière lui qu'une petite partie de ses notes de recherches. Qui sait combien de modules il a réellement installés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030324,
					"content": "Peut-être qu'un conflit entre toutes les commandes est ce qui a donné lieu à un tel comportement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030325,
					"content": "Strictement parlant, il est impossible de conclure que Karkata est une forme de vie réelle, mais c'est une possibilité qui existe, et je suis prêt à y croire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030326,
					"content": "Goulou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "Soit dit en passant, continuer ces recherches ne m'intéresse pas. Si je le laisse ici, c'est parce que c'est un endroit relativement bien caché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030328,
					"content": "Dans l'état actuel des choses, ce ne serait pas une mauvaise idée d'en faire mon assistant de recherche. Au moins, il est capable d'enregistrer mes observations expérimentales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030329,
					"content": "Qu'est-ce que tu en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030330,
					"content": "Goulou ! Goulou !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
