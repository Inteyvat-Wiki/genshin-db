			"dialogs": [
				{
					"id": 747000101,
					"content": "Héhé, je m'amuse comme une folle à remplir cet aquarium !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Puisque Sandrone n'y voit pas d'inconvénient, on devrait continuer d'attraper des poissons pour rendre cet endroit encore plus joli !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Hé, vous deux. Venez par ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000104,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Tenez, c'est pour vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000106,
					"content": "... Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "C'est un équipement de mobilité sous-marine sur lequel je travaille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000108,
					"content": "Hein ?! Oh, merci beaucoup, Sandrone ! C'est très gentil de votre part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "Ce n'est qu'un simple appareil mécanique. J'ai vu comment vous attrapiez des poissons la dernière fois et... Comment dire... C'était franchement assez pénible à regarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000110,
					"content": "C—C'était vraiment si terrible que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "C'était inefficace, maladroit et complètement dénué d'élégance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000112,
					"content": "#Je suis... {M#désolé}{F#désolée} de vous avoir infligé ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Ce n'est rien. Chacun a sa propre façon de faire. Mais puisque vous comptez continuer à remplir cet Océanarium, il vaudrait mieux que vous utilisiez cet appareil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000114,
					"content": "Les eaux de Fontaine abritent bien plus que de simples poissons d'ornement inoffensifs. Il y a aussi de nombreux prédateurs qui peuvent vous blesser gravement. Cet appareil ne vous aidera pas seulement à pêcher, il vous aidera aussi à fuir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000115,
					"content": "Merci beaucoup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Bien. Si vous voulez aller nager, allez-y. Et n'oubliez pas de me dire ce que vous pensez de cet équipement. Je pourrai l'ajuster davantage en fonction de vos retours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000116,
					"content": "Je ne manquerai pas de m'en servir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}