				{
					"id": 220020301,
					"content": "Tu as trouvé un fruit du lotus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020302,
					"content": "Tiens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020304,
					"content": "Petit Meng, Fei, venez manger des fruits du lotus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020305,
					"content": "Hé, mais je croyais qu'on jouait ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh, c'est vrai. Bah, vous pouvez prendre cet argent et ces objets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020307,
					"content": "#Tu es drôlement {M#doué}{F#douée} pour jouer les pirates ! Pas beaucoup de gens auraient le cran de voler des enfants comme nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020308,
					"content": "J'ai comme l'impression qu'on se moque de toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Merci d'avoir joué avec nous ! N'hésite pas à revenir t'amuser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				}
			]
		},
