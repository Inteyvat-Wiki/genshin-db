			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "#Je suis {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "C'est parti !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020203,
					"content": "C'est toi qui commences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020204,
					"content": "Aboulez la thune ! Et que ça saute !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Vous osez nous voler en plein jour ? Heureusement que les Millelithes ne sont pas loin !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, dépêche-toi ! Nous devons nous sauver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220020207,
					"content": "#Bonjour {M#monsieur le pirate}{F#madame la pirate}, que voulez-vous nous voler ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020208,
					"content": "Euh, de l'argent ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Je n'ai pas d'argent à me faire voler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020213,
					"content": "Mon père dit que sur un bateau, ce sont les marchandises à bord qui ont le plus de valeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020214,
					"content": "Bah, tu n'as qu'à trouver un objet de valeur alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020215,
					"content": "Quelque chose qu'on pourrait vouloir me voler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020216,
					"content": "Je sais ! Ramène-moi un fruit du lotus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020217,
					"content": "#On aime tous les fruits du lotus ! Ça serait l'objet idéal à nous voler, comme tu es {M#un méchant}{F#une méchante} pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020209,
					"content": "#Je suis {M#venu}{F#venue} vous kidnapper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Ce n'est qu'un jeu, mais il faut rester sur nos gardes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020211,
					"content": "Les soldats des Millelithes sont en train de nous regarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Lulu"
				}
			]
		},
