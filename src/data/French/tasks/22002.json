			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Petit Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, pourquoi c'est encore moi le capitaine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Petit Meng"
				},
				{
					"id": 220020102,
					"content": "Parce que c'est plus marrant quand c'est toi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020103,
					"content": "Si ça te fait plaisir, ça me va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220020104,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "On va jouer à un jeu ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020106,
					"content": "Petit Meng est le capitaine, Fei est le matelot et je suis une riche marchande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020107,
					"content": "Il nous manque juste un pirate qui viendra nous voler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020108,
					"content": "#Tu es d'accord pour être {M#le}{F#la} pirate ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020109,
					"content": "Bien sûr !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020113,
					"content": "#OK, reviens me voir quand tu seras {M#prêt}{F#prête} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020111,
					"content": "#Je veux être {M#un gentil}{F#une gentille}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "#C'est qu'un jeu ! On sait que tu es {M#gentil}{F#gentille} dans la vraie vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
