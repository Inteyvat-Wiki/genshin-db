				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "Les étranges pièces d'aujourd'hui et cette illusion... Et puis euh... Un bonsaï ? En tout cas, c'était vraiment bizarre ! Je me demande si on devrait en parler à Venti ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671402,
					"content": "J'ai pensé à la même chose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "Dodoco... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "Dodommunicateur"
				},
				{
					"id": 400671405,
					"content": "Dodoco... Dodoco... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "Dodommunicateur"
				},
				{
					"id": 400671406,
					"content": "Pas de réponse... Étrange, pourquoi il ne décroche pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671407,
					"content": "Ce n'est pas normal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "Est-ce qu'il est distrait par quelque chose ? Ou peut-être qu'il est encore ivre et qu'il fait la sieste sous un arbre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671409,
					"content": "Hum... C'est très étrange... Essayons de le recontacter demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671410,
					"content": "#{M#Voyageur}{F#Voyageuse}, Paimon, vous êtes là !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671411,
					"content": "Mona ! Tu as fini de parler à Fischl ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671412,
					"content": "Hahaha, en quelque sorte... Elle est un peu mélancolique, je suppose... Ça doit avoir un rapport avec les illusions que nous avons vues aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671413,
					"content": "Fischl est très enthousiaste à propos de ce voyage, mais j'ai l'impression qu'elle ne veut pas faire face à sa propre illusion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671414,
					"content": "Pourquoi ? Ça ressemble pourtant à une activité qu'elle aurait hâte de faire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671415,
					"content": "... Je ne peux pas tirer de conclusion pour l'instant, mais je garde un œil sur tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671416,
					"content": "Je voulais aussi te parler d'autre chose. Je viens de réaliser une nouvelle séance divinatoire sur la plage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671417,
					"content": "Mon disque d'eau est toujours flou, mais contrairement à la fois dernière, j'ai pu sentir une certaine force. Je ne peux pas voir son emplacement, mais je peux la sentir. Elle est en train de changer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671418,
					"content": "Comment peux-tu la sentir sans la voir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671419,
					"content": "Comment expliquer ça à quelqu'un qui n'y connaît rien... Ah ! C'est comme s'il y avait une fissure dans une pièce. On ne sait pas où elle se trouve, mais on peut sentir le vent s'y infiltrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671420,
					"content": "Et la température de la pièce n'arrête pas de chuter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671421,
					"content": "Oh ! Je comprends mieux, expliqué de cette manière. Tu essayes de localiser cette fissure, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671422,
					"content": "En quelque sorte. J'ai besoin de voir cette fissure avant de prendre une décision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671403,
					"content": "Contactons-le.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
