					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "Une plante morte aurait dû se trouver dans ce pot, mais aucune trace d'elle ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "... Lors de votre absence, j'y ai beaucoup réfléchi et j'ai finalement compris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "Dans cette illusion qui est mienne, ce pot à bonsaï vide n'est que le reflet de mon état d'esprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "Quand le cœur est pur, toute chose l'est également. Lorsque le cœur est vide, il en va de même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "« Pur et vide », ces mots représentent mon état d'esprit actuel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Néanmoins, ce n'est pas forcément un mal. Ce « vide » dans mon cœur signifie aussi que j'ai perdu quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "Ce bonsaï est apparu dans mon illusion pour me donner la chance de réaliser mon ambition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "Je n'aurais jamais imaginé avoir au fond de moi le désir de cultiver mon propre bonsaï... Cela me permettra de continuer la tradition des Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
