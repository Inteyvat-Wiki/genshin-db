					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "Vous avez donc fini de faire ce que vous vouliez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670602,
					"content": "Oui, on peut dire ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670603,
					"content": "Vous avez rencontré la personne que j'étais et vous lui avez dit au revoir. Tout cela appartiendra à l'histoire ancienne une fois que vous aurez tout vu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670604,
					"content": "Le plus important dans la vie est de former des liens avec les autres, et non d'être dur envers soi-même. Il n'y a pas d'avenir pour ceux qui restent enfermés dans le passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670605,
					"content": "Alors s'il vous plaît, croyez-moi quand je dis que j'ai déjà fait tout ce chemin et que je continuerai d'avancer. Votre soutien compte beaucoup pour moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
