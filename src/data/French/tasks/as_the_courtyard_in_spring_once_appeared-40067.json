			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodommunicateur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "... Les choses se passent toujours de la même manière à chaque fois que je te rencontre. Divination, interprétation, ciblage d'objectif, puis résolution du problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "#Tu es {M#entouré}{F#entourée} par beaucoup d'amis, de secrets et de destinées. C'est incroyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "Oui, nous avions résolu l'incident de Léonard avec l'aide de Mona et Fischl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "C'est bon signe pour les astromanciens, non ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "Tout juste. Espérons que cette fois, nous pourrons également unir nos forces et résoudre le problème rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "Nos forces ? Qui ? Vous deux ou nous trois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Pfft...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "On ne t'écarte pas, bien entendu. Parfois, ta vision perspicace et aiguisée m'est d'une grande utilité, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "Vraiment ? Je commence à bien t'apprécier, Mona. Quelle génie tu es !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "N'est-ce pas ? Une astromancienne aussi intelligente et charmante que moi, il n'en existe pas d'autre ! Hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Tu es géniale et tout, mais est-ce que... tu pourrais ne pas rire comme Fischl ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "Ahem ! Désolée... Je suis son amie depuis longtemps, c'est difficile de ne pas se laisser influencer... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#Dans les jours à venir, je vais continuer d'observer les étoiles. On se tient au courant, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006702,
			"completionStepIds": [
				4006714
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006714",
							"2"
						],
						"stepId": 4006714,
						"stateName": "QUEST_STATE_UNFINISHED"
