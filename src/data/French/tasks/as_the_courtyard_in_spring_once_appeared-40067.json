			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Kazuha, on vous a trouvé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671202,
					"content": "Vous tombez à pic, ni en avance ni en retard. Permettez-moi de terminer l'introspection de ma vie jusqu'à présent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671203,
					"content": "Comment trouvez-vous le bonsaï familial du Clan Kaedehara ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671204,
					"content": "Ancien et plein d'histoire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Les choses anciennes sont souvent accompagnées par leur lot de regrets. Le Clan Kaedehara ne fait pas exception à cette règle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "Mais peu importe. Une séparation donne aussi lieu à des retrouvailles, où qu'elles soient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "Cet endroit est intéressant. C'est comme une pièce de théâtre : chaque scène est plus spéciale et saisissante que la précédente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "Les astromanciens sont très perspicaces. Cette illusion n'aura pas été vaine si elle a pu vous donner ce ressenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "Hum... Qu'en est-il de votre humeur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "Ma maîtresse s'inquiète de votre état, elle espère que vous ne vous sentez pas trop mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "Cela doit être douloureux de se remémorer de tels souvenirs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Haha, en effet. Merci de vous en inquiéter. Heureusement, toutes ces choses appartiennent au passé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "Quand j'ai vu le bonsaï pour la première fois, une hypothèse m'est venue à l'esprit... Si j'ai été laissé tout seul ici, c'est parce que je devais vous attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "Il n'est pas parfait, mais vous en êtes digne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Vous croyez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006713,
			"completionStepIds": [
				4006713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
