			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Écouter"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "C'est toi Kaedehara ? Monte vite sur le bateau, je t'emmène.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "Écouter"
				},
				{
					"id": 400670402,
					"content": "Vous... Pourquoi m'aidez-vous ? Je suis un criminel recherché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "C'est la Commission cultu... Ahem ! Quelqu'un m'a payé et m'a demandé de t'emmener en toute sécurité en dehors d'Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Écouter"
				},
				{
					"id": 400670404,
					"content": "Cependant, ce que les autres peuvent faire pour t'aider est limité. Pour pouvoir avancer, tu ne peux compter que sur toi-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Écouter"
				}
			]
		},
		{
			"id": 4006705,
