			"trigger": {
				"objectNames": [
					"Fischl",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "Qu'est-ce qui s'est passé ici ? Pourquoi tout est cassé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670302,
					"content": "... Est-ce le signe d'une puissante famille qui sombre dans le déclin ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400670303,
					"content": "Tout est sens dessus dessous et il n'y a personne ici. Je pense qu'elle a déjà fini de sombrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670304,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
