				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodommunicateur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "... Je ne pensais pas devoir faire face à un événement aussi inimaginable sur une si belle île.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "Comment te sens-tu ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Ça va, mais ça irait encore mieux si tu pouvais m'aider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "Que devons-nous faire exactement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "Hmm... Oups, je crois que n'avais rien de spécifique en tête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "Quoi ? Tu nous sous-estimes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "#Non, je viens juste de me rendre compte que tu en fais beaucoup pour nous malgré le fait que tu ne sois pas très {M#bavard}{F#bavarde}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "#Tu es {M#un ami}{F#une amie} indispensable. Tout est plus rassurant en ta présence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "Les attentes peuvent mettre une certaine pression, mais je pense... que les astromanciens doivent être observateurs. Voir les aspects positifs d'autrui est une bonne manière de s'exercer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "Tu voulais juste nous complimenter ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "Je ne fais que constater des faits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "Je vois, tu refuses de l'admettre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "Mona n'ose pas admettre qu'elle a fait un compliment !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "Q—Qu'est-ce qui te fait rire ? C'est purement objectif, je ne te complimente pas ! Pas du tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#Dans les jours à venir, je vais continuer d'observer les étoiles. On se tient au courant, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006703,
