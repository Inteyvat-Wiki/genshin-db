				"objectNames": [
					"Écouter"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "Hé, mon gars ! Est-ce que ça va ? Tu cherches l'asile politique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Écouter"
				},
				{
					"id": 400671002,
					"content": "Des pirates ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Écouter"
				},
				{
					"id": 400671003,
					"content": "C'est exact ! On n'est pas des marins d'eau douce ! Tu veux nous rejoindre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Écouter"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
