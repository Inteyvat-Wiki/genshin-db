			"dialogs": [
				{
					"id": 200150301,
					"content": "Biat ye, ye pupu dada mosi ! Plama ye upa dada !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150302
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150302,
					"content": "Dala beru yo ?! Kundala muhe, kucha ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150303
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 200150303,
					"content": "Kundala gusha ! Hahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150304
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150304,
					"content": "Biat ye, plata ye pupu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150305
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 200150305,
					"content": "Movo unta nye kucha, mi dada tiga mitono !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150306
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 200150306,
					"content": "Oh, je vois qu'il m'a compris ! Il veut nous montrer quelque chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150307
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150307,
					"content": "#Nom de Barbatos ! C'est une arme ! Aide-moi, {M#voyageur}{F#voyageuse} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
