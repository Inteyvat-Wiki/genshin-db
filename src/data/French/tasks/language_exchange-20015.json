					"nextDialogs": [
						200150608
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150608,
					"content": "Mes efforts ont payé cette fois ! Mon niveau de Brutocollinus s'est amélioré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
