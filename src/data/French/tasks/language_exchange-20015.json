			"dialogs": [
				{
					"id": 200150701,
					"content": "Qu'en penses-tu ? Je m'en suis bien sortie, non ? Maintenant qu'il est tout à fait possible de communiquer avec eux, il nous faut juste du temps pour se comprendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150702
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150702,
					"content": "En tout cas, j'espère que c'est tout ce qu'il nous faut. Mon rêve est de devenir l'amie des Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150703,
					"content": "Avant que j'oublie, prends ça. C'est un cadeau de la part du Brutocollinus de tout à l'heure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150704,
					"content": "T'y crois à ça ? Je parie que tu ne l'as pas vu venir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150705,
					"content": "Je ferais mieux d'y aller. Tant d'aventures m'attendent ! Nos chemins auront peut-être la chance de se croiser de nouveau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
