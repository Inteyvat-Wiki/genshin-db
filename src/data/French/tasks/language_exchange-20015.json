			},
			"dialogs": [
				{
					"id": 200150101,
					"content": "Par ici ! S'il te plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150102,
					"content": "Ne fais pas peur à ces Brutocollinus. Tu fonces souvent dans leurs camps comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150103,
					"content": "Peu importe. J'étudie la langue des Brutocollinus depuis un bon moment, mais j'aimerais la pratiquer à l'oral plutôt que d'avoir le nez dans les bouquins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150104,
					"content": "Maintenant que je suis près d'un camp de Brutocollinus, il ne faut pas que je rate cette occasion en or !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150105,
					"content": "J'aurais besoin de ton aide pour trouver un Brutocollinus qui voudrait bien discuter avec moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
