					"nextDialogs": [
						200150605
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 200150605,
					"content": "Mi ? Dada ! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150606
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150607
					],
					"speakerTitle": "Brutocollinus"
				},
				{
					"id": 200150607,
					"content": "Héhé, regarde-le. Il a l'air si joyeux !",
