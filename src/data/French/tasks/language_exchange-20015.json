					"nextDialogs": [
						200150202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150202,
					"content": "C'est lui. Allons lui dire bonjour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150203,
					"content": "Fais gaffe à ne pas réveiller les autres. Ça serait malpoli de notre part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150204,
					"content": "Il ne faut surtout pas qu'ils croient que nous voulons attaquer leur camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150205,
					"content": "Sinon, mon plan sera fichu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
