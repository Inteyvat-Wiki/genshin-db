			"dialogs": [
				{
					"id": 750761201,
					"content": "#Ah, enfin... {M#Héros venu}{F#Héroïne venue} de loin, sans votre aide, nous aurions pu être dépassés par nos ennemis noirâtres depuis longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Manifestation affaiblie de Wayob"
				},
				{
					"id": 750761202,
					"content": "... Il y a longtemps, les membres de la tribu ont été charmés par le mirage de l'ennemi, et de nombreuses noctâmes se sont retrouvées coincées par l'Abîme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Manifestation affaiblie de Wayob"
				},
				{
					"id": 750761203,
					"content": "À l'endroit où se trouve le sceau, même le pouvoir de l'incarnation de la nuit est lentement détruit... Ce sceau a rompu les liens avec le monde extérieur et la source de la foi de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Manifestation affaiblie de Wayob"
				},
				{
					"id": 750761204,
					"content": "Ce sceau doit être brisé si nous voulons avoir la moindre chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Manifestation affaiblie de Wayob"
				},
				{
					"id": 750761205,
					"content": "#Merci, {M#héros venu}{F#héroïne venue} de loin... Les noctâmes peuvent retourner vers leur maison des rêves en évitant la peste qui menace le royaume du seigneur de la nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Manifestation affaiblie de Wayob"
				},
				{
					"id": 750761206,
					"content": "Ah, retrouver la quiétude de la nuit, enfin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manifestation affaiblie de Wayob"
				}
			]
		}
	]
