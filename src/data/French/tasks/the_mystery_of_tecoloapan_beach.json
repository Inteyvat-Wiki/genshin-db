			"trigger": {
				"objectNames": [
					"Sakaw"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "La brume de mer s'est épaissie ces derniers temps. C'est inquiétant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760404,
					"content": "La légende serait-elle donc vraie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760405,
					"content": "Quelle légende ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Euh... Ah, ça dépend de la légende que vous souhaitez entendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760407,
					"content": "Il existe deux histoires de l'origine de cette île flottante et de cet immense graffiti. L'une ressemble à un conte tandis que l'autre s'apparente davantage à une véritable légende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760402,
					"content": "#Lequel aimeriez-vous entendre, {M#guerrier venu}{F#guerrière venue} d'ailleurs ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760408,
					"content": "À propos du conte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Hmm, il y a toujours une touche romantique avec les contes... L'origine des graffitis sur l'île flottante entourée de brume fait partie du Conte de Qoyllor et Ukuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760403,
					"content": "On dit que la jeune fille nommée Qoyllor a laissé un immense graffiti sur la plage afin de contacter son père-soleil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760410,
					"content": "Son père-soleil a vu les graffitis depuis le ciel et l'a emmenée loin de la terre... C'est à peu près ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760417,
					"content": "On dit que la brume troublante a été accordée par le père-soleil aux habitants de la surface, en guise de punition pour avoir volé le pouvoir de sa fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760415,
					"content": "*soupir* Légende ou pas, depuis son apparition, cette brume n'a jamais été un bon présage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760416,
					"content": "#{M#Héros venu}{F#Héroïne venue} de loin... Cet endroit regorge sûrement de dangers, vous devez donc faire attention à ne pas vous approcher trop près...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760411,
					"content": "À propos de la véritable légende...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "La véritable légende... On raconte qu'il y a bien longtemps, il y avait un mage maléfique qui se déguisait en Wayob pour charmer les héros de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760413,
					"content": "Plus tard, les héros tribaux ont dû utiliser cet énorme graffiti pour y enfermer le mage maléfique à l'essence noirâtre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760414,
					"content": "On dit que l'apparence de la surface de l'océan est un présage du moment où le mage maléfique brisera le sceau et s'échappera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				}
			]
		},
