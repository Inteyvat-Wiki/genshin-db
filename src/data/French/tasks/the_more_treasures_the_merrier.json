				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "C'est la catastrophe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590102,
					"content": "Qu'est-ce qu'il se passe ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "#Parfait ! Vous tombez bien, {M#Voyageur}{F#Voyageuse} ! Vous voyez, ce magasin de souvenirs appartient à ma famille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590104,
					"content": "Quand mon père le gérait, il avait l'habitude de racheter le butin des aventuriers après leurs expéditions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590105,
					"content": "Malheureusement, à cause de la baisse d'activité de la Guilde, je n'arrive plus à renouveler mon stock...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590106,
					"content": "Pour couronner le tout, les objets que j'obtiens ne valent quasiment rien. Personne n'en veut !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590107,
					"content": "Vous partez à l'aventure aux quatre coins du monde, n'est-ce pas ? Ça ne vous dérangerait pas me ramener des trésors que je pourrais vendre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590108,
					"content": "Entendu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "Merci ! Je vous les rachèterais à un prix imbattable, promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590110,
					"content": "Vous pouvez prendre Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "Merci, mais je crois que personne ne voudrait l'acheter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590112,
					"content": "Mes clients préfèrent les objets... inanimés ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
