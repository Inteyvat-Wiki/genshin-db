			"dialogs": [
				{
					"id": 2005910001,
					"content": "Qu'est-ce que c'est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Bonjour ! Vous avez bon œil ! Il s'agit de l'objet le plus précieux de tout le magasin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "#C'est un objet qui a été obtenu par {M#ce voyageur}{F#cette voyageuse} ici {M#présent}{F#présente} sur un Brutocollinus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Qui sait pendant combien de temps cette vile créature a menacé Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "#Et n'allez pas croire que parce que {M#ce voyageur}{F#cette voyageuse} sait se battre, ça n'a pas été un combat difficile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "Sérieux ? Ce Brutocollinus devait être costaud alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "... Je devrais peut-être l'acheter et le montrer à Cyrus ou Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Ils arrêteront peut-être de me traiter comme un gamin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "En tout cas, nous savons garder un secret ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Si vous ne l'achetez pas maintenant, je ne peux pas vous garantir qu'il sera encore ici la prochaine fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "#Laissez-moi y réfléchir encore un peu... {M#Voyageur}{F#Voyageuse}, elle dit la vérité ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
