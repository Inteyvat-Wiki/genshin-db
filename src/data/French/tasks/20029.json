					]
				},
				{
					"id": 200290906,
					"content": "Les ordres ne sont pas encore arrivés, mais j'ai déjà préparé mes affaires. Je vais bientôt aller séjourner au Grand Hôtel Goth pour être prêt à partir à tout moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290907,
					"content": "C'est quoi, cet air sérieux ? Tu t'apprêtes à me faire tes adieux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Victor"
