			"dialogs": [
				{
					"id": 200290101,
					"content": "Pfiou... Je peux enfin rentrer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290102,
					"content": "Tu t'en vas, Victor ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "Ah ? C'est toi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290104,
					"content": "Oui, j'ai reçu des ordres de mes supérieurs. Je dois retourner à Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290105,
					"content": "Selon eux, j'ai été transféré sous le commandement d'un autre Exécuteur. Il n'y a plus besoin que je reste à Mondstadt pour attendre des ordres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290106,
					"content": "Je ne sais pas sous les ordres de quel Exécuteur j'ai été transféré. J'espère vraiment que ce n'est pas Scaramuccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290107,
					"content": "Quand dois-tu partir ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Mes supérieurs ne me l'ont pas précisé. Il faut juste que je fasse mes affaires pour être prêt à partir immédiatement quand j'en recevrai l'ordre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290109,
					"content": "Ouf... Je vais enfin pouvoir partir d'ici. Je n'aurai plus à supporter le regard atterré de ces nonnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290110,
					"content": "#Au fait {M#voyageur}{F#voyageuse}, ça fait longtemps qu'on se connaît, toi et moi... Est-ce que tu pourrais me rendre un dernier service ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290111,
					"content": "On fait comme avant : tu me rends un service et moi, je te paye. Je ne te ferai pas bosser pour rien. Alors, qu'est-ce que t'en dis ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290112,
					"content": "Quelle histoire vas-tu me raconter cette fois-ci ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Hahaha, je t'ai déjà raconté toutes les histoires sur les Fatui que je connais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290115,
					"content": "Si tu m'aides, je te paierai en moras sonnants et trébuchants. Alors, ça t'intéresse ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290116,
					"content": "À moins que tu ne préfères écouter les contes que je raconte à Lili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290117,
					"content": "#De quel genre de service as-tu besoin{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Hum... En vérité, le service que je vais te demander a justement un rapport avec Lili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290121,
					"content": "Dans tout Mondstadt, il n'y a que Lili qui aime écouter les histoires du « vilain monsieur Fatui »... et toi, bien sûr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290122,
					"content": "Si je pars, je n'aurai plus l'occasion de revenir à Mondstadt. Je voudrais donc offrir un petit cadeau à Lili pour qu'elle garde un souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290123,
					"content": "Mais tu sais aussi bien que moi que tout le monde va me regarder de travers si j'apparais dans la rue pour acheter quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290124,
					"content": "#C'est pourquoi je compte sur toi, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290125,
					"content": "Va voir à la boutique de Marjorie s'il n'y a pas de cadeau que l'on pourrait offrir à un enfant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290118,
					"content": "Tu joues toujours avec Lili ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Euh... Ça m'arrive de jouer avec elle... parfois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290113,
					"content": "Tu ne manques pas d'histoires sur les Fatui à raconter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
			"id": 2002902,
			"completionStepIds": [
				2002902
