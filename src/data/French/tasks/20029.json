					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Hein ? Pourquoi monsieur le Phatoui il va partir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 200290812,
					"content": "Pfiou... Tant mieux s'il s'en va. Il venait tous les jours parler à Lili, je n'arrêtais pas de m'inquiéter pour elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Papa, je veux dire au revoir au Phatoui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lili"
				},
