			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "Alors, tu as trouvé un cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290402,
					"content": "Que vas-tu faire quand tu seras rentré ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Qu'est-ce que je vais faire ? Eh bien... Je devrai attendre que mes supérieurs effectuent mon transfert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290404,
					"content": "*soupir* Si la chance n'est pas de mon côté, il se pourrait bien que l'on m'envoie encore une fois je ne sais où en attente de recevoir des ordres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290405,
					"content": "Tant que je ne suis pas envoyé à Inazuma, tout me convient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290406,
					"content": "Pourquoi ce transfert soudain ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Il ne peut y avoir qu'une seule raison à cela... C'est bien entendu Signora et son... sacrifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290408,
					"content": "Mais bon, quelqu'un de mon rang ne devrait pas se soucier de tout ça. J'écoute les ordres de mes chefs, pas besoin de trop réfléchir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290409,
					"content": "Où est passée Lili ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "J'ai entendu Rudolf dire qu'il allait l'emmener jouer sur la place, ou quelque chose comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290411,
					"content": "Hmph. J'imagine qu'il ne veut pas que Lili parle avec le « méchant monsieur Fatui ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290412,
					"content": "Au revoir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Au revoir. Je compte sur toi pour le cadeau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
