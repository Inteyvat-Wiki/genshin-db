					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 200290817,
					"content": "#Lili, écoute papa. Les choses ne sont pas aussi simples... *soupir* Tu sais quoi{NON_BREAK_SPACE}? Papa t'expliquera quand tu seras grande.",
