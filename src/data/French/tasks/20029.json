			"dialogs": [
				{
					"id": 200290601,
					"content": "#{M#Voyageur}{F#Voyageuse}, avez-vous trouvé Shute ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290602,
					"content": "Il m'a demandé de vous remettre ces baies à crochet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "Oh, merci. Je vais les garder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290604,
					"content": "Je donnerai sa rétribution à Shute quand il reviendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290605,
					"content": "Ah oui, vous vouliez un cadeau que l'on peut offrir à un enfant, c'est ça ? Attendez un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290606,
					"content": "Marjorie s'occupe du cadeau...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "Et voilà ! Voici votre cadeau. Merci de m'avoir ramené ces baies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290608,
					"content": "C'est une poupée parfumée. Un cadeau que les enfants adorent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
