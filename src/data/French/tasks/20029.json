			"dialogs": [
				{
					"id": 200290701,
					"content": "Alors, tu as récupéré le cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290702,
					"content": "Oui, je l'ai ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "#Oh, tu es plutôt {M#doué}{F#douée}. Laisse-moi voir ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290704,
					"content": "Qu'est-ce que... c'est que ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290705,
					"content": "Une poupée toute déformée et teinte d'une manière grotesque... Par contre, elle sent plutôt bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290706,
					"content": "Dis-moi, tu crois vraiment qu'on peut offrir ça à un enfant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290707,
					"content": "C'est Marjorie qui m'en a fait la recommandation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "Bon, on va dire que ce cadeau fera l'affaire. Par contre, où vais-je mettre la lettre ? Ah, je sais. Je vais la mettre en dessous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290711,
					"content": "Tu as aussi écrit une lettre à Lili ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Pas grand-chose, des trucs sans importance. Ne t'occupe pas de ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290714,
					"content": "Bon, je te confie le cadeau. Va le donner à Lili pour moi, tu devrais pouvoir la trouver <color=#00E1FFFF>près de la place</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290715,
					"content": "Hmph. Si j'y vais moi-même pour lui donner son cadeau, je vais encore subir le regard accusateur de Rudolf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 200290712,
					"content": "Qu'est-ce qu'il y a d'écrit dans la lettre ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "Si tu n'es pas content, tu peux toujours acheter un cadeau à Snezhnaya puis le faire envoyer ici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "J'aimerais bien. Mais si un Fatui comme moi envoie un colis à Mondstadt, c'est sûr que celui-ci se retrouvera bloqué par les types de l'Ordre de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
