					"Shute le terrifié"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "#M—Merci, {M#voyageur}{F#voyageuse}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290502,
					"content": "Ces monstres sont tenaces ! Ils m'ont poursuivi jusqu'ici sans jamais s'arrêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290503,
					"content": "Vous êtes venu récolter des baies à crochet ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Hein ? Oui, c'est ce que Marjorie m'a demandé de faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290505,
					"content": "Pourquoi n'avez-vous pas cherché quelqu'un pour vous accompagner ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "Qui donc aurait accepté de m'accompagner pour une mission aussi triviale que celle de récolter des plantes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290508,
					"content": "Je vois bien ce que vous voulez dire, mais on ne trouve des baies à crochet qu'au Territoire des Loups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290509,
					"content": "Et les baies qui poussent dans des zones sûres ont déjà été ramassées par d'autres personnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290510,
					"content": "Donc, si je veux arriver à en ramasser, je n'ai pas d'autre choix que de m'aventurer plus loin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290511,
					"content": "Enfin bon, passons à autre chose. Pourriez-vous donner ces baies à Marjorie pour moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290512,
					"content": "Je dois me reposer un moment. J'ai couru comme pas possible, je suis épuisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shute le terrifié"
				},
				{
					"id": 200290507,
					"content": "Vous ne devriez pas vous aventurer si loin tout seul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
