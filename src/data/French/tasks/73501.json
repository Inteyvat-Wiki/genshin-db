	"talks": [
		{
			"id": 7350101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350101",
							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qasit",
					"Alia",
					"Mamdouh",
					"Fayez",
					"Ruhi",
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "Oh... J'ai encore eu le même... Je voulais celui qui est joufflu et tout doux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010102,
					"content": "Il ne me reste plus qu'à économiser pour tous les obtenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010103,
					"content": "Mais je croyais que tu venais tous les jours ici ? Pourquoi tu ne les as pas encore tous eus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010104,
					"content": "Tu aurais dû les acheter en set. Ça fait sept figurines différentes d'un coup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010105,
					"content": "Ça manque de surprise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010106,
					"content": "C'est nul les surprises ! Je veux tous les modèles qui existent, moi ! Ça montre à quel point j'aime les aranaras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010107,
					"content": "J'ai économisé assez pour acheter le set entier aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010108,
					"content": "Je suis désolé, mais le petit Qasit a acheté la dernière figurine qu'on avait en stock. Nous n'avons plus aucun produit pour aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010128,
					"content": "Nous sommes en train de recruter de nouveaux sculpteurs, revenez à la boutique demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010109,
					"content": "D'accord, je reviendrai demain... Et puis les figurines d'aranaras en bois ne sont pas de simples « produits » !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010110,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010111,
					"content": "Oui, désolé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010112,
					"content": "Désolé, nos figurines d'aranaras sont en rupture de stock pour aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010113,
					"content": "En rupture ? Oh non... Je voulais en acheter pour mon cousin qui vient demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010114,
					"content": "Tu habites à côté de chez Razi, n'est-ce pas ? On peut te livrer les figurines demain, qu'en dis-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010115,
					"content": "Merci, monsieur Fayez ! Vous n'oubliez pas, hein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010116,
					"content": "Je te le promets, la boutique ne te décevra jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010117,
					"content": "Ah, d'autres clients. Désolé, mais nos figurines d'aranaras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010118,
					"content": "Oh, mais c'est vous. Merci pour votre aide. Nous avions prévu de venir vous remercier en personne, mais nous étions occupés, comme vous pouvez le voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010119,
					"content": "Sans vous, l'anniversaire de la boutique aurait été compromis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010120,
					"content": "On dirait que les affaires vont bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "On dirait que les aranaras sont très appréciés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "Nous devons tout ça à Razi. Sa créativité est prolifique à un si jeune âge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010123,
					"content": "D'ailleurs, je vous offre le prototype d'aranara en guise de gratitude. Ça vous fera un souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010124,
					"content": "Ouah, ce truc est... Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010125,
					"content": "Incroyable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "Oui, incroyable... Il dégage quelque chose de... particulier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010127,
					"content": "Hum, c'est très gentil, mais pourriez-vous nous donner un peu de temps pour réfléchir si l'on veut le garder ou non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010129,
					"content": "Maintenant que le problème des fabricants de jouets est résolu, vous allez voir comment vont monsieur Tanger et Razi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
			"completionStepIds": [
				7350101
			],
			"beginWay": "TALK_BEGIN_NONE",
