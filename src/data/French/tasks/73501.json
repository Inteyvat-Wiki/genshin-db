				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "Le papa aranarien a reconnu ses torts et a été pardonné par son fils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010202,
					"content": "Hmm... Je pense que tout le monde aimera la direction de l'histoire, mais le conflit a été résolu un peu trop vite à mon goût.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010203,
					"content": "Et si on les faisait affronter une épreuve ensemble ? Ça ne ferait que les rapprocher. Le papa aranarien pourrait montrer des remords après avoir vu les efforts de son fils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010204,
					"content": "Le papa aranarien devrait parler plus doucement ou plus vite quand il éprouve des remords ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010205,
					"content": "Ça dépend du fils. Ce serait intéressant de les entendre parler à des rythmes différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010206,
					"content": "Monsieur Tanger et Razi ! Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010207,
					"content": "Papa et moi discutions de notre nouvelle histoire. C'est moi qui la conterai cette fois-ci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010208,
					"content": "Mais je suis un peu nerveux à l'idée de faire ça devant tant de gens. C'est pour ça que j'ai demandé conseil à papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010209,
					"content": "Oh ! Un jeune conteur entre en scène à Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010210,
					"content": "Sans votre intervention, Razi m'aurait abandonné pour de bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010211,
					"content": "Je suis contente que vous vous soyez réconciliés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010212,
					"content": "Mais quelque chose me chiffonne !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010213,
					"content": "Qu'est-ce qu'il y a ? Tu as besoin de mon aide ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010214,
					"content": "Pourquoi une personne de Mondstadt laisserait une note dans ce creux d'arbre dans la Forêt d'Avidya ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010215,
					"content": "Pourquoi reviens-tu sur le sujet ?! Euh, je pense que ce n'est qu'une simple coïncidence ! Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010216,
					"content": "Plein de gens écrivent leurs secrets et les cachent dans des creux d'arbre ! Pas de quoi en faire tout un plat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010217,
					"content": "Tu as l'air troublée, Collei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "Bon, d'accord... J'avoue tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010220,
					"content": "J'ai aussi mon lot de problèmes et de secrets que j'ai l'habitude de raconter aux creux d'arbre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010221,
					"content": "Mais une idée m'est venue à l'esprit en voyant monsieur Tanger et Razi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}, est-ce que tu voudrais bien devenir mon « creux d'arbre » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010223,
					"content": "Avec plaisir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "Bien sûr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "C'est une pratique fréquente ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
