			},
			"dialogs": [
				{
					"id": 726920201,
					"content": "#Avez-vous ces photos, {M#mon cher}{F#ma chère} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920202,
					"content": "Les voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Laissez-moi voir... Oui, c'est très bien ! Comme je l'imaginais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920204,
					"content": "#{M#Mon cher}{F#Ma chère}, cette fois encore, j'ai composé plusieurs vers et j'aimerais vous laisser choisir ceux que vous préférez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
