			"dialogs": [
				{
					"id": 726920501,
					"content": "Puisqu'Ootomo et vous semblez apprécier ce vers, je vais l'inclure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920502,
					"content": "Le poème de Lenne complémente à merveille les photos. Elles rendent les vers vivants lorsqu'on les regarde en lisant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920503,
					"content": "#{M#Jeune homme}{F#Jeune femme}, je suis aussi en train d'écrire un poème ces derniers temps. J'aimerais solliciter votre aide demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920504,
					"content": "Vous avez aussi besoin de photos, Ootomo ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Haha, reparlons-en demain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
