					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "#Vous tombez bien, {M#jeune homme}{F#jeune femme}. Nous sommes en train de travailler sur un nouveau poème avec Lenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "Besoin d'aide pour trouver l'inspiration ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Haha, vous avez lu dans mes pensées. Ces deux derniers jours, je m'essaye à la poésie de style inazumien sous la supervision d'Ootomo. Hélas, ma technique est encore trop immature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "J'ai vraiment l'impression d'avoir connu Ootomo toute ma vie. Le poème que j'écris est sur le thème de l'amitié, et j'aimerais décrire la compagnie d'animaux entre eux dans un vers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Comme il s'agit d'un poème de style inazumien, je ne peux m'inspirer que d'<color=#00E1FFFF>animaux qu'on ne trouve qu'à Inazuma</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "J'ai l'impression qu'on en voit pas mal d'habitude, sur terre, dans les airs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#Mais ces animaux vivent dans la nature, mettons-nous en route pour les trouver, {NICKNAME} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "#{M#Mon cher}{F#Ma chère}, j'aimerais <color=#00E1FFFF>quatre</color> photos d'animaux d'Inazuma différents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269202,
