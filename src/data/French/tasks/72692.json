					"nextDialogs": [
						726920702
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920702,
					"content": "Je ne pensais pas que vous seriez capable de composer un vers aussi intelligent à partir d'une photo d'animal, Lenne.",
					"roleType": "TALK_ROLE_NPC",
