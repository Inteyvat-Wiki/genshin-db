			"dialogs": [
				{
					"id": 701140101,
					"content": "C'est une occasion rare de vous voir trouver le temps de venir à Mondstadt, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Vous m'avez apporté une aide si précieuse lors de mes recherches sur la matrice arithmétique. Je voulais vous remercier en personne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140103,
					"content": "C'est trop d'honneur. Ce genre de choses dépasse largement mon domaine d'expertise. Le mérite de cette réussite vous revient entièrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "C'était un travail d'équipe. Hmm... En y repensant, où est Durin ? Vu que vous êtes pratiquement son tuteur, je pensais qu'il ne pourrait pas s'éloigner beaucoup de vous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140105,
					"content": "Vous n'avez pas entièrement tort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Mais récemment, il a fait des progrès au niveau de ses compétences sociales, alors je lui ai donné plus de liberté pour gérer son propre emploi du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Vous ne vous inquiétez pas pour lui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140108,
					"content": "Un peu. Avant, quand il était seul et qu'il interagissait avec quelqu'un ayant une personnalité... disons « forte », il avait tendance à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Faire des choses bizarres ? Imiter des tics de langage inhabituels ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140110,
					"content": "Précisément. Je suppose que vous avez vécu quelque chose de similaire, mademoiselle Sandrone ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hmph, avez-vous vraiment besoin de poser la question ? Je suis pratiquement une experte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140112,
					"content": "En général, après une réunion avec le Grand Maître Varka, j'emmène Durin voir Sucrose pour l'aider dans ses recherches. Ça lui permet de se recentrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Mais s'il passe trop de temps avec la Grande Maîtresse suppléante Jean, on va voir Klee pour qu'il réapprenne à se détendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Ça en fait du travail...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140115,
					"content": "Je veille simplement sur ma famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Comment géreriez-vous de telles situations ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Moi ? Je n'ai pas l'énergie pour ce genre de complications...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140118,
					"content": "Mais il me semble que si quelqu'un est fondamentalement bon, peu importe à quel point il est influencé, il retrouvera toujours sa véritable nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140119,
					"content": "Hmm... Voilà un point de vue intéressant. Peut-être devrais-je moi aussi essayer d'adopter cette façon de penser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
