			"dialogs": [
				{
					"id": 701140201,
					"content": "Je vous remercie pour tout ceci, mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140202,
					"content": "(Rester encore ici un moment.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "Très bien, nous nous reverrons.",
					"roleType": "TALK_ROLE_NPC",
