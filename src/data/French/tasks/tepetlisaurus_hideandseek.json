					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Oh, tu veux aller jouer avec eux ? Hmm, c'est vrai que {REALNAME[ID(2)|SHOWHOST(true)]} a très rarement des contacts avec d'autres petits tepetlisaures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250107,
					"content": "Fais attention, d'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "Yaa !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Je suis quand même un peu inquiète... Enfin, trouvons un endroit pour nous asseoir, manger quelque chose et discuter en attendant {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250111,
					"content": "#Paimon et vous trouvez un bel endroit pour vous reposer à proximité et attendre que {REALNAME[ID(2)|SHOWHOST(true)]} revienne d'avoir joué.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Mais l'attente commence à devenir un peu longue...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#... Pourquoi {REALNAME[ID(2)|SHOWHOST(true)]} n'est-il pas encore revenu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250114,
					"content": "J'espère qu'il ne lui est rien arrivé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250115,
					"content": "Peut-être qu'il s'amuse trop et qu'il n'a pas vu le temps passer ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "Si c'est le cas, nous allons devoir avoir une sérieuse discussion. Il fait pratiquement nuit et il n'est pas encore revenu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250117,
					"content": "Allons vite le chercher !",
