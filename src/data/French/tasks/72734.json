			"dialogs": [
				{
					"id": 727340101,
					"content": "Indiscipliné, grossier, quelconque, insipide... et complètement désorganisé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Sorcier « plein aux as »"
				},
				{
					"id": 727340102,
					"content": "De quoi tu te plains ? De tes coéquipiers qui ont reçu une bonne correction de notre part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Sorcier « plein aux as »"
				},
				{
					"id": 727340104,
					"content": "Je parlais de votre style de combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Sorcier « plein aux as »"
				},
				{
					"id": 727340105,
					"content": "Quoi ? T'es tombé sur la tête ? C'est pas un spectacle ici ! Une puissance suprême, volonté de fer et des scarabées au top ! Voilà ce qu'est mon style de combat ! Je te montre un peu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Tu me rappelles des mauvais souvenirs... Je n'aime pas les types désagréables et bruyants de ton genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Sorcier « plein aux as »"
				},
				{
					"id": 727340107,
					"content": "#Hum, mais {M#le blondinet}{F#la blondinette} a l'air d'une proie facile. C'est décidé ! Je {M#le}{F#la} défie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Sorcier « plein aux as »"
				},
				{
					"id": 727340108,
					"content": "Pfft ! Pouhahahahahaha !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "#T'as entendu ça, l'{M#ami}{F#amie} ? Il croit qu'il peut te battre ! Montre-lui comment on accueille les invités ici !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Haha ! Et comment !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Je ne comprends pas pourquoi ces gens ne cherchent pas à connaître leurs adversaires avant de venir ? Ils ne font que se jeter dans la gueule du loup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Les membres de l'équipe du Grand Maître Hanakado sont vraiment nuls ! Ils ne font pas le poids face à nous, stratégiquement parlant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Bouh, ne me fais pas de mal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
