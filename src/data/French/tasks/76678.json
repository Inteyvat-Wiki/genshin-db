					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830406,
					"content": "J'ai bien peur que cette énigme ait été un peu trop simple pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760830407,
					"content": "Une unagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Hé, quelque chose cloche avec sa taille, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "#Vous possédez {M#tous}{F#toutes} les deux des connaissances impressionnantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760830410,
					"content": "La bonne réponse est « la lune ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760830411,
					"content": "Revenez maintenant. Vous avez fait du bon travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760830412,
					"content": "Un arc.",
