			"dialogs": [
				{
					"id": 730670601,
					"content": "C'est ça ! C'est bien ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "C'est l'amulette du courage d'Arashakun, même si la couleur de la fleur s'est un peu ternie après quelques jours loin d'Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Ce n'est pas grave, Arashakun va la protéger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "« C'est du courage que tu as là, Arashakun. Tu es un gentil aranara, pas un lâche ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Merci beaucoup, nara {NICKNAME} et Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "L'Arashakun d'aujourd'hui est l'Arashakun qui a retrouvé le courage, rien ne peut l'arrêter. Le misérable Démon masqué au visage poilu n'a aucune chance face à Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Ouah, même sa voix a changé.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#Le Démon masqué au visage poilu a fait tant de mal. Venez avec moi, nara {NICKNAME} et Paimon. Avec votre aide, je pourrai l'éliminer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun sent qu'aujourd'hui, c'est le jour d'aller dans sa grotte pour lui régler son compte une bonne fois pour toutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Oh. {NICKNAME}, allons-y, nous aussi... Et voyons ce qu'est vraiment ce Démon masqué au visage poilu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
