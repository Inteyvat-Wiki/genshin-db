				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Je m'en doutais, le Démon masqué au visage poilu est en fait un Brutocollinus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "Un Brutocollinus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Oui, le Démon masqué au visage poilu était un Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Les Brutoboulinus sont tous des Démons masqués aux visages poilus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Euh, non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Tu peux le voir comme ça, si tu veux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Oui, Arashakun comprend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Ah, avec l'aide de nara {NICKNAME} et de Paimon, Arashakun était invincible. Même le rusé Démon masqué au visage poilu n'a pas fait le poids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Aujourd'hui, Arashakun va écrire des grosses notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Des grosses notes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Oui, j'écris en très gros pour laisser des grosses notes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Arashakun avec du courage et Arashakun sans courage ont l'air d'être deux aranaras différents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Arashakun sans courage est faible et ne peut rien faire correctement. Arashakun avec le courage sait tout faire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "Le courage n'est donc pas seulement le meilleur cadeau que l'ami narien a offert à Arashakun, mais aussi une chose très, très importante pour Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670715,
