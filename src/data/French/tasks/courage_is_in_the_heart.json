			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "Hmm... Arashakun doit être l'aranara qui a écrit ces notes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Mais pourquoi l'écriture est parfois grosse, parfois petite comme ça ? Quand c'est écrit en gros, ça va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Mais quand c'est écrit tout petit, ça fait un peu mal aux yeux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Ah bon, tu as du mal à lire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Je sais lire des mots qui ont une taille normale ! Je n'ai pas l'habitude de lire quelque chose d'aussi rikiki !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Hmm, cet Arashakun, il n'est jamais revenu après avoir fini les dernières pages de ses notes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Allons à la grotte à l'est pour voir. Il a écrit que son courage a disparu... Je suis curieuse de savoir ce que ça veut dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
