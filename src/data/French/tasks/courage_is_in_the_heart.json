			"dialogs": [
				{
					"id": 730670101,
					"content": "Regarde, les Brutocollinus ont laissé un truc étrange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "Ça semble avoir été fait avec des fleurs... C'est bizarre, on voit bien que ce sont des fleurs banales et qu'elles ont été cueillies il y a longtemps... Et pourtant, elles ne sont pas fanées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Je sens qu'il y a une grande quantité d'élément Dendro dessus... et que ça a été jeté ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "C'est probablement à un aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Oui, sûrement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Hmm, ce truc fait avec des fleurs contient tellement d'élément Dendro qu'il ne s'est même pas fané dans les mains des Brutocollinus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Peut-être que c'est la possession de quelqu'un...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Oui, il vaut mieux qu'on aille le rendre le plus vite possible à l'aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Entrons dans la maison, {NICKNAME}. Peut-être que l'étourdi qui a laissé cette chose ici est en train de se morfondre à l'intérieur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Peut-être que c'est précieux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Ça doit venir d'un Brutocollinus Dendro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Hein ? Ça doit plutôt être à aranara qui habite dans le coin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
