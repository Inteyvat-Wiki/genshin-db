			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(Il y a des mots écrits en tout petit sur les premières pages...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670202,
					"content": "« ... Bouhouhou, un nara veut être l'ami d'Arashakun. C'est vraiment un gentil nara ! Il n'a pas été dérangé par la lâcheté d'Arashakun, et il apprend à Arashakun l'écriture des naras... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670203,
					"content": "« Le gentil nara a réconforté Arashakun quand Arashakun a été effrayé par une feuille tombant sur sa tête. Le gentil nara est le meilleur ami d'Arashakun pour toujours ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670204,
					"content": "(L'écriture devient petite et chaotique dans les pages qui suivent...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670205,
					"content": "« Bouhou, l'ami narien a été capturé par le Démon masqué au visage poilu. Le Démon masqué au visage poilu est très effrayant, il a de longs bras... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670206,
					"content": "« Il faut sauver le nara, bouhouhou... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670207,
					"content": "(L'écriture devient grosse et appuyée dans les pages suivantes...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670208,
					"content": "« Le Démon masqué au visage poilu a été battu et l'ami narien a été secouru. L'ami narien a donné du courage à Arashakun, Arashakun n'est plus le lâche qu'il était. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670209,
					"content": "« Avec son courage, Arashakun s'est battu avec bravoure contre les monstres masqués au visage poilu. Les naras n'ont plus à s'inquiéter d'être harcelés par les monstres masqués au visage poilu ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670210,
					"content": "(L'écriture redevient toute petite dans les dernières pages...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670211,
					"content": "« Bouhouhou... Qu'est-ce qui se passe ? Le courage d'Arashakun a disparu, le courage que le nara a donné à Arashakun... Il a dû être volé par le Démon masqué au visage poilu. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Notes écrites de manière inconsistante"
				},
				{
					"id": 730670212,
					"content": "« Le Démon masqué au visage poilu avec de longs bras est effrayant. Arashakun ne peut rien faire sans son courage... Bouhouhou, Arashakun doit aller le chercher dans la <color=#00E1FFFF>grotte à l'est</color>... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes écrites de manière inconsistante"
				}
			]
		},
		{
