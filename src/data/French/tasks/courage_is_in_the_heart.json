			"dialogs": [
				{
					"id": 730670401,
					"content": "Tu es Arashakun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "*sanglote* Bouhouhou... Arashakun est bien mon nom. Ouah, ne vous approchez pas comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "#Je vous suis reconnaissant à {M#tous}{F#toutes} les deux de m'avoir sauvé du danger, mais veuillez garder vos distances... *sanglote* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Arashakun se sentira plus à l'aise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Quoi ? On t'a pourtant sauvé !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Aah, Arashakun est désolé, désolé ! Arashakun vous a demandé quelque chose de pas raisonnable et vous a mis en colère...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Mais Arashakun s'est fait piéger ici et est encore sous le choc, Arashakun espère que vous pourrez le pardonner s'il a été impoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Ce n'est pas grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Tant mieux. Arashakun se demande s'il peut connaître vos noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Je m'appelle Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Je suis {NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#Oh, {M#le nara doré}{F#la nara dorée} {NICKNAME} et Paimon. Alors... Comment connaissez-vous le nom d'Arashakun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Nous avons lu le carnet qui était dans la maison...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#{M#Le nara doré}{F#La nara dorée} {NICKNAME} a lu les notes, est {M#venu}{F#venue} chercher Arashakun et l'a aidé. {M#Il est si fort et si gentil}{F#Elle est si forte et si gentille} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "Oh... Si seulement Arashakun n'avait pas perdu le courage, il n'aurait pas été piégé comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Ah oui, on a lu ça dans tes notes, Arashakun. Tu as dit avoir perdu ton courage, qu'est-ce qui s'est passé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "C'était il y a longtemps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Il y a quelques lunes, tout comme maintenant, Arashakun était Arashakun sans courage... À l'époque, même le bruit d'une branche qui se cassait empêchait Arashakun de dormir toute la nuit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "#Mais même peureux, Arashakun avait un ami narien qui lui tenait compagnie. Ce n'était pas {M#la grande}{F#le grand} nara Varuna, mais c'était un gentil nara quand même !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Il ne se moquait jamais de la lâcheté d'Arashakun et il tenait la main d'Arashakun quand Arashakun avait peur... C'est un ami qu'Arashakun n'oubliera jamais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Un jour, l'ami narien a été capturé par le Démon masqué au visage poilu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Une seconde, c'est quoi ce Démon masqué au visage poilu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "Le Démon masqué au visage poilu, c'est un démon, masqué, avec un visage poilu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "... D—D'accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Tu as une idée de ce que c'est, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Comment le saurais-je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Donc pour résumer, ce Démon masqué au visage poilu a capturé l'ami d'Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "Le Démon masqué au visage poilu est très effrayant. Juste le fait d'y penser fait trembler tout le corps d'Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "Bouhouhou, Arashakun était terrifié quand son ami narien a été emmené. Si Arashakun avait peur d'être battu par le Démon masqué au visage poilu, il avait encore plus peur de ne plus jamais revoir son ami narien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Alors Arashakun a essayé très fort ! Il a fermé les yeux ! Il a serré les dents ! Il a frappé des mains ! Et il a sauvé son ami narien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Après ça, l'ami narien a fait une amulette du courage avec des fleurs et a dit à Arashakun : « C'est du courage que tu as là, Arashakun. Tu es un gentil aranara, pas un lâche ! »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "C'est à ce moment-là qu'Arashakun a obtenu le courage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "Pourtant, « fermer les yeux, serrer les dents et frapper les mains », ce sont déjà des actes courageux, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "Non, non. Arashakun a reçu du « courage » de la part de son ami narien après avoir fait ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Mais c'est le fait d'avoir sauvé ton ami qui est très courageux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "Non, non, non. Arashakun était effrayé et avait les mains qui tremblaient quand il a secouru son ami narien. Mais après avoir obtenu le courage, Arashakun n'a plus eu peur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "L'amulette ne symbolisait qu'un tournant !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#Bouhou... Les paroles de nara {NICKNAME} sont compliquées. Tout ce qu'Arashakun sait, c'est qu'avec l'amulette du courage, Arashakun a du courage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Lorsque le courage d'Arashakun a été volé, Arashakun est allé à la grotte du Démon masqué au visage poilu pour le chercher, espérant trouver des traces du courage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Et c'est comme ça que tu t'es retrouvé dans une grotte entourée de Blobs... Heureusement que ce Démon masqué au visage poilu ne t'a pas remarqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#Ah, en parlant de ça... {NICKNAME}, souviens-toi de l'objet qu'on a pris sur les Brutocollinus... Ça devrait être l'amulette d'Arashakun, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Arashakun, on a peut-être trouvé le courage que tu as perdu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Vraiment ? Nara {NICKNAME} et Paimon, vous avez trouvé le courage d'Arashakun ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "Le courage est dans ton cœur, Arashakun !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Une réponse digne d'un aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Oui, je ne vois pas du tout ce que ce Démon masqué au visage poilu désigne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
