				"points": []
			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "Qu'est-ce que je veux ? Des droits du travail ! Quand est-ce que je les veux ? Maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Eh, j'ai apporté les noyaux que vous vouliez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Hmm ? Laissez-moi voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Pourquoi manifestez-vous ici ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Nous devons nous relever là où nous sommes tombés, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "Que voulez-vous que je fasse ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Argh, qu'est-ce que je vais faire de vous ? D'étranges machines comme celle-ci ont été installées à la surface et sous l'eau. Elles sont faciles à repérer grâce à la lumière particulière qui les entoure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Mettez-les hors service et ramenez-moi le noyau qui se trouve à l'intérieur d'elles. Il y en a <color=#00E1FFFF>sept</color> en tout. Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
