			"dialogs": [
				{
					"id": 740430301,
					"content": "Hmm, et voilà. 7 noyaux, le compte est bon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "Pourquoi en avez-vous besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "Comment saurais-je ? Mon patron a simplement dit qu'il avait besoin de 7 noyaux mystérieux contenus dans ces étranges machines. Et que si je les lui ramenais, j'aurais droit à une belle récompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "Et on dirait que tout est là ! Je me suis arrangé pour le rencontrer ici et lui faire un rapport sur la situation. Vous pourrez donc lui demander vous-même. De toute façon, je vais avoir besoin qu'il me paie avant de pouvoir vous donner votre part...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Hmm, très bien, si vous le dites... Nous allons attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Vous attendez un peu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Cher Henri, comment ça va ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430308,
					"content": "#Très bien, patron ! J'ai rassemblé les 7 noyaux mystérieux que vous avez demandés. Laissez-moi vous présenter {M#mon}{F#ma} partenaire... Euh, comment vous appelez-vous déjà ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430311,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "Attendez ? Vous vous connaissez ? Super ! Alors, c'est comme ça que les choses se sont passées...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#« Agh ! C'est {NICKNAME} ! Pourquoi est-{M#il}{F#elle} ici ? »\\nLe « Patron » se retourne pour fuir, mais est soudainement capturé par Hunter et Turner, qui sortent de nulle part.\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "Argh ! Pitié, épargnez-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430316,
					"content": "Euh, ces deux-là sont plutôt doués...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "Ne vous inquiétez pas, patron ! Il n'y a pas de danger mortel ici, j'en suis sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "En effet, en effet. Personne n'est en danger du tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430319,
					"content": "Pour l'instant, en tout cas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430320,
					"content": "P—Pour l'instant...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430321,
					"content": "Quant à la suite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430322,
					"content": "Que vous vous retrouviez en poulet rôti ou autre chose... Eh bien, c'est à vous de décider... Patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430323,
					"content": "Hiii !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430324,
					"content": "Comment vous êtes-vous retrouvés ici tous les deux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "Après avoir eu l'honneur de vous rencontrer précédemment, nous avons décidé de suivre Henri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430326,
					"content": "Hein ? Attendez. Pourquoi moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "En fait, pourquoi étais-je la cible en premier lieu ? Je faisais juste mon travail !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "Les machines que vous avez démontées étaient des appareils utilisés par l'Institut de recherche de Fontaine pour surveiller et optimiser la qualité de l'eau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430329,
					"content": "Hein ? N'étaient-ils pas destinés à produire de la pollution ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "Les noyaux que vous avez démantelés contenaient les composants centraux et les données hydrologiques les plus avancés de Fontaine. C'est pour ça que nous espérions... faire la connaissance de votre partenaire commercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430331,
					"content": "Hein ? Pourquoi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "Vous m'avez menti, Henri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "Oh non ! On s'est fait avoir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "#Non, non, vous êtes {F#ma grande bienfaitrice}{M#mon grand bienfaiteur} ! Pourquoi est-ce que je vous mentirais ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "Vous m'avez menti, patron ! Saviez-vous que vous me faisiez détruire des choses si importantes ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "Je... Je ne voulais pas ! Je ne suis que le plus bas échelon du...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430337,
					"content": "Hmm ? Qu'est-ce que j'ai entendu ? Vous venez de dire que vous « ne vouliez pas » faire quelque chose ? Vous pourriez répéter ? Je ne pense pas vous avoir bien entendu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430338,
					"content": "Ahhhh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "« Patron »"
				},
				{
					"id": 740430339,
					"content": "Ce patron doit être fatigué. Il s'est même endormi les yeux ouverts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430340,
					"content": "Euh, ce... Ce n'était pas notre intention non plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "Eh bien, à ce sujet, nous avons décidé de ne pas poursuivre l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430342,
					"content": "Vraiment ? Il n'y a pas de problème ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "Nous avons juste besoin que les noyaux et les données qu'ils contiennent soient complets. Les machines elles-mêmes sont auxiliaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430344,
					"content": "Nos supérieurs disent que ça va. Et que nous ne devrions pas vous embêter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430345,
					"content": "Hmm ? Que voulez-vous dire par ne pas nous embêter ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Ah, non, rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430347,
					"content": "Nous ne faisons que nous promener !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430348,
					"content": "Quelle coïncidence, n'est-ce pas ? Il fait beau, et c'est une belle rencontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430349,
					"content": "Hélas, toutes les bonnes choses ont une fin, et cette rencontre aussi. Il est temps de se dire au revoir, je le crains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430350,
					"content": "Laissez simplement la beauté d'une telle rencontre s'attarder dans votre cœur, ou peut-être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430351,
					"content": "Oubliez ça. Qui sait ? C'est peut-être mieux ainsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430352,
					"content": "Hein ? ... Alors tout va bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "Vous préférez que les choses se passent autrement ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430354,
					"content": "Oh, non, certainement pas ! Ça nous va parfaitement bien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "*soupir* Je pensais avoir rencontré une bonne personne avec qui je pourrais changer ma vie par le travail. Hélas, la majorité des personnes sont mal intentionnées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "... Ah, Henri, on aurait besoin d'un coup de main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430357,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "C'est vraiment dommage, mais votre patron au bon cœur semble avoir perdu la raison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430359,
					"content": "On va avoir besoin de quelqu'un de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430360,
					"content": "Travailleur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430361,
					"content": "Fiable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430362,
					"content": "Vous savez, un bon ami qui espère changer sa vie grâce à un travail honnête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430363,
					"content": "C'est ça, un ami pour nous aider à emmener ce bon gars dans notre planque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430364,
					"content": "Là-bas, nous pourrons... parler avec lui à notre guise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430365,
					"content": "Bien sûr, nous allons... exprimer notre gratitude en moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430366,
					"content": "Oh, bien sûr ! Comptez sur moi, alors !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "Merci, merci à vous deux. Et merci aussi, euh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#{NICKNAME}. Et voici Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#Merci à vous, {NICKNAME}, Paimon. Ma vie semble vraiment avoir changé depuis que je vous ai {M#rencontrés tous}{F#rencontrées toutes} les deux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "Inutile de nous remercier ! Contentez-vous de travailler dur, et de ne plus vous faire avoir, d'accord, Henri ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "D'accord, ça n'arrivera plus ! Je vais travailler dur et devenir riche. Et alors, j'aurai d'autres personnes qui travailleront pour moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Hunter, Turner et Henri déterrent le Fatui inconscient et l'emmènent.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Eh bien, j'espère qu'Henri va pouvoir reprendre sa vie en main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "Attendez une minute. Et la paie qu'Henri était censé nous donner ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}