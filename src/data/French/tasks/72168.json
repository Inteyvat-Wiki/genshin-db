			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, il n'y a vraiment pas d'autres moyens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "C'est le seul que je vois dans mon livre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Si seulement il n'y avait qu'une bande de monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "Ce sont ces fleurs de cerisier dont vous avez besoin ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Ah ! Oui, c'est ça. Elles ont une couleur magnifique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "Waouh ! On va enfin pouvoir manger maintenant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "#Attendez une minute, comment êtes-vous {M#entré}{F#entrée} ? Avez-vous utilisé la méthode dont je vous ai parlé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "Est-ce que vous pouvez me dire où vous avez trouvé la branche de cerisier tonnerre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "Quand vous avez touché cette branche, comment se fait-il qu'un Électrogranum vous ait accompagné ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "Excusez-moi, je dois sortir mon cahier... Je suis prête. Alors, avez-vous ressenti quelque chose de spécial quand l'Électrogranum s'est approché de vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "#S'il te plaît, Parvaneh, accorde un moment à {M#ce voyageur}{F#cette voyageuse}. {M#Il}{F#Elle} vient de nous aider... Je pense que tes recherches peuvent attendre un peu, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "#Merci beaucoup, {M#voyageur}{F#voyageuse}. Comme convenu, vous serez {M#payé}{F#payée}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "Mais avant ça, attendez un moment ici. Je crois que je vais pouvoir préparer un plat avec les fleurs de cerisier que vous avez apportées.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "J'ai entendu dire qu'à Inazuma, il y avait une spécialité locale appelée tempuras de sakura, faites à partir de fleurs de cerisier. C'est le moment d'essayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Donnez-moi un petit moment pour en préparer. Ça ne devrait pas prendre trop longtemps, venez me voir dans un instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
							"2"
						],
						"stepId": 7216804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "Comme ça... Puis comme ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680302,
					"content": "Vous avez terminé ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "Attendez un instant... Je les roule dans la farine, puis je les mets à sécher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680304,
					"content": "Ça y est ! Essayez ce tempura de sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680305,
					"content": "Hmm ! C'est délicieux ! Mais ça... ça brûle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680306,
					"content": "Xudong, dans le livre, il est dit que ces tempuras doivent être servis avec une sauce d'accompagnement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680307,
					"content": "Une sauce d'accompagnement ? Eh bien, je dois dire que je n'en ai jamais préparé. Je regarderai ça la prochaine fois, si j'en ai l'occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680308,
					"content": "#Ces tempuras de sakura sont pour vous, {M#voyageur}{F#voyageuse}. Merci pour votre aide !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680309,
					"content": "Ah oui, je vais aussi vous écrire une copie de la recette. Donnez-moi juste un instant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680310,
					"content": "Essayez d'en préparer vous-même à l'occasion ! C'est tellement amusant de cuisiner, vous ne trouvez pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680311,
					"content": "Merci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "De rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680314,
					"content": "Nous allons rester à Inazuma pendant un moment, donc je pense que nous irons à <color=#00E1FFFF>Kannazuka</color> plus tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680316,
					"content": "De plus, Julie dit qu'elle veut aller voir le cerisier sacré au Sanctuaire de Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680317,
					"content": "On dit que toutes les fleurs de cerisier de l'île proviennent de cet arbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680318,
					"content": "Je me demande quelle taille peut faire cet arbre pour qu'il y ait autant de fleurs qui en tombent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680319,
					"content": "Vous devriez aller voir si ça vous intéresse, vous aussi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680320,
					"content": "#Je tiens à vous remercier encore une fois pour votre aide, {M#voyageur}{F#voyageuse}. Eh bien, je vais manger un morceau moi aussi. Je meurs de faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680313,
					"content": "Quelle est votre prochaine étape ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
