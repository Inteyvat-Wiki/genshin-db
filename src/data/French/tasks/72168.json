						721680404
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680404,
					"content": "Pouvez-vous répéter cette méthode ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "La méthode spécifique est la suivante : vous devez trouver une « branche de cerisier tonnerre » dans les environs et la toucher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "Ensuite, une chose appelée « Électrogranum » devrait vous accompagner et vous permettre de passer cette barrière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
