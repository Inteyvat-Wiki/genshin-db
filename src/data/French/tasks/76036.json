			"dialogs": [
				{
					"id": 760360301,
					"content": "Est-ce que ça fera l'affaire ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360302,
					"content": "Oui, elle a l'air satisfaite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360303,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Je ne savais pas du tout que les kuuhenkis pouvaient peindre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "Elles nous ressemblent plus qu'on ne le croit. Chacune a sa propre personnalité et ses loisirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360306,
					"content": "Vous voulez dire que vous reconnaissez chaque kuuhenki de Nod-Krai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Celles que j'ai rencontrées, oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360308,
					"content": "Impressionnant ! Toutes les autres kuuhenkis se ressemblent pour moi, à part les luonnotars...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Comment s'appelle cette petite peintre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Pardon ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360311,
					"content": "Vous ne leur avez pas donné de noms ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Je les reconnais et vice versa. Il n'y a pas besoin de les nommer... Je n'ai pas de nom, moi non plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360313,
					"content": "Ce n'est pas une raison pour perpétuer cette mauvaise tradition !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hmm... Je réfléchis... « Luonnotar » signifie « créature née sous la faveur de la Déesse de la lune »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "Comment dit-on « peinture » dans la langue des Descendants de givrelune ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Je crois que c'est Maa...naus ? Maalaus ? Oui, Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360317,
					"content": "Oh, c'est sympa ! Appelons-la Maalaus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "Qu'est-ce qu'il y a, Maalaus ? Tu as fini de peindre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "Oh ! Voyons... Hein, mais... !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "C'est super beau !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Je m'attendais à quelque chose d'enfantin... Un peu comme les dessins des mélusines ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Les kuuhenkis sont capables de sentir leur environnement. Lorsqu'elles recréent ce qu'elles ont vu, elles ont tendance à restituer leurs sentiments tels qu'ils sont.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360326,
					"content": "Tu as peint Columbina, Maalaus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360328,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360329,
					"content": "... On dirait la naissance de Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360330,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360331,
					"content": "Je me souviens que d'après Lauma, votre naissance avait été représentée par les Descendants de givrelune... même si cette peinture a l'air un peu différente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360332,
					"content": "Et les kuuhenkis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Cette petite... Enfin, Maalaus a été l'une des premières kuuhenkis à naître. Elle s'est peut-être servie d'un mélange de sensations perçues pour visualiser comment les choses se sont passées à l'époque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360335
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360335,
					"content": "On te sent impatiente de nous présenter ta déesse, hein, Maalaus ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360336,
					"content": "~ !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360338
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360338,
					"content": "#Ne t'inquiète pas, Maalaus. On deviendra {M#amis}{F#amies} avec Columbina, tu verras !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360339,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360340
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360340,
					"content": "Ouah, c'était rapide. Tu as déjà terminé un autre tableau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360341,
