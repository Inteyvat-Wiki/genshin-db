					"nextDialogs": [
						760360342
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360342,
					"content": "Ça représente sûrement les Descendants de givrelune qui vénèrent Columbina comme leur déesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360343,
					"content": "Hmm ? Qu'est-ce qu'elle fait près de l'autel ? Les détails sont un peu trop petits pour bien les distinguer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360344
					],
					"speakerTitle": "Paimon"
				},
