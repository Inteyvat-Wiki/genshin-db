			"dialogs": [
				{
					"id": 740660301,
					"content": "La réception... C'est ici ! Tentons notre chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "Bonjour mademoiselle Monglane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(Oh là là, elle n'a pas l'air d'être très amicale.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(Pourquoi ne pas appliquer les connaissances acquises grâce à « L'art de la négociation » ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(Ah oui, c'est vrai ! Je ne m'attendais pas à ce que ce livre soit utile maintenant.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Laisse-moi voir... J'ai trouvé ! « Si vous prenez le dessus en montrant votre force et submergez votre adversaire d'une manière imposante... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "C'est ça ! Il faut écraser l'adversaire de manière imposante ! Je vois ! Il suffit de parler plus fort, c'est ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "Hé, mademoiselle Monglane. Bonjour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "... Je vous ai entendue. Que puis-je faire pour vous ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "Hein ? Ça a marché !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "#Héhé, mademoiselle Monglane, nous sommes ici pour l'enquête de satisfaction ! Ah non, je suis venue pour accompagner {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(Ne t'inquiète pas, {NICKNAME}, nous avons le livre. Je vais y jeter un coup d'œil pour te rappeler ce que tu dois faire ! Hum... Bref, suis mes instructions.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "Vous êtes ici parce que vous avez aussi vu la note dans le livre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "Oui, c'est ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "Combien y en a-t-il ? *soupir* ... Peu importe. Très bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "Ahem, attendez un peu... Je vais d'abord vous expliquer les règles. Il y a 5 questions au total, alors répondez rapidement selon votre intuition. Attention, il me faut des réponses rapides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "#Est-ce que c'est clair ? Nous commencerons quand vous serez {M#prêt}{F#prête}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
