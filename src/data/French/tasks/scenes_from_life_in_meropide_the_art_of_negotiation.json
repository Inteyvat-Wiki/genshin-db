			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(Je suis prête ! Allez-y !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "Première question : pensez-vous qu'il soit raisonnable de maintenir les prix bas de la Cantine à coupons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Hmm... Comment répondre à cette question ? Attends... Je l'ai trouvé ! Essaye cette formule universelle.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(Le livre dit que « Je suis d'accord avec vous, mais... » peut être utilisé dans n'importe quelle situation. Même un Mage de l'Abîme serait enclin à dialoguer poliment avec toi. C'est génial !)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "C'est raisonnable. Paimon aime bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "Quoi...? Je ne voudrais pas cette mauvaise nourriture, même si c'était gratuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "Et si on n'a plus de coupons de crédit pour la nourriture ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Hmm... Tu as raison... Mais quand même ! Je préfère mourir de faim plutôt que de manger ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "Ahem, excusez-moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "Selon les règles, les réponses doivent être rapides. Passons à la question suivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "D'accord... Puisque ce sont les règles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "Deuxième question : l'approvisionnement de la Cantine à coupons est-il suffisant pendant les heures de repas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "La nourriture ne manque pas... Mais elle est vraiment mauvaise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Oui, il y en a plus que des menthes en tout Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Je préférerais même manger de la menthe directement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "C'est vrai ? Alors nous mangerons de la salade de menthe aujourd'hui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "Non ! Je ne veux ni l'une ni l'autre ! Bouhouhou, je veux un poulet mariné aux fleurs sucrantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Bref... Revenons à l'enquête. Je vais écrire « oui ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "*soupir* ... Je suis fatiguée, passons à la question suivante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Avant la troisième question, j'aimerais vous rappeler à nouveau que cette enquête exige des réponses rapides. Donc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Troisième question : le système actuel de repas aléatoires est-il vraiment intéressant ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "Il faut accorder plus d'attention à la saveur !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "Je suis d'accord avec vous, mais... un repas aléatoire vous apporte une agréable surprise, non ? C'est palpitant de ne pas savoir à quoi s'attendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "#C'est vrai, ça sonne plutôt pas mal sous cet angle{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "Quoi ? Mademoiselle Monglane a raison, c'est difficile de ne pas être d'accord avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "Ahem. Répondez rapidement, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "C'est intéressant. J'aime bien les bandelettes de chance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "C'est vrai ! On en obtient une à chaque fois, comme à la loterie. C'est génial !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "« Travaillez dur ; la réussite répondra ! » C'est super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "Le travail de guide est vraiment difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Quatrième question : pensez-vous qu'il soit raisonnable de vendre des denrées addictives à la Cantine à coupons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(Hein ? Quoi ? Pourquoi parle-t-elle si vite tout à coup ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(Prendre les devants ? Orienter la discussion ? Non, aucun n'a l'air de convenir. Sinon... La formule universelle ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(Ces questions... Je les trouve un peu bizarres...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "Ahem, ne réfléchissez pas trop et ne déviez pas du sujet. Comme je vous l'ai dit, suivez votre intuition et répondez rapidement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "C'est raisonnable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "D'accord, merci pour votre réponse. Enfin, la dernière question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "Elle nous ignore ? Notre réponse n'a pas d'importance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "#Selon les réponses aux questions précédentes, êtes-vous {M#satisfait}{F#satisfaite} de l'état actuel de la Cantine à coupons ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "C'était quoi les questions précédentes ? On ne s'en souvient pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "#Ce n'est pas grave. On n'a qu'à dire que vous êtes {M#satisfaits}{F#satisfaites} de tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "D'accord... Mais je ne peux m'empêcher de penser que quelque chose cloche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "Au fait, je vous préviens que vous n'obtiendrez pas de coupons de crédit si les réponses sont négatives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "Mais c'est n'importe quoi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#Et vous, {M#monsieur}{F#mademoiselle} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "Ne m'ignorez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "#Oui, j'en suis très {M#satisfait}{F#satisfaite}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Très bien. Merci de votre coopération, votre soutien est précieux pour notre amélioration. Veuillez signer ici et récupérer vos coupons de crédit. Vous pouvez aussi signer pour le petit Méka horlogoïde volant à vos côtés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "#Hein ? J'en ai moi aussi ? Mais j'ai à peine participé ! Je peux vraiment les prendre ? Hé, mais je ne suis pas petit Méka horlogoïde volant{NON_BREAK_SPACE}! Je suis Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Très bien. Quoi qu'il en soit, notre principe est de prendre en compte les suggestions de tous... Humains ou mékas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "Je viens de vous dire que je ne suis pas petit Méka horlogoïde volant ! Je suis Paimon ! Ne m'ignorez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "D'accord... Pour vous faire gagner un temps précieux, je peux remplir le questionnaire pour vous. Ne vous inquiétez pas, vous recevrez le même nombre de coupons de crédit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "Je suppose que toutes vos réponses seront positives, n'est-ce pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "Oui ! Pour les coupons de crédit !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "Dans ce cas, il vous suffit de signer ici et je m'occupe du reste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "Tant mieux ! On peut obtenir des coupons de crédit sans s'embêter. Merci, mademoiselle Monglane !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Je vous remercie pour votre soutien, prenez ces coupons de crédit. Nous nous reverrons lors de la prochaine enquête.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "Après avoir récupéré les coupons de crédit, Paimon et vous dites au revoir à mademoiselle Monglane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#{NICKNAME}, en y repensant... J'ai l'impression que mademoiselle Monglane se fichait de nos réponses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "Il y avait un problème avec les questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "... Tu as raison. Ces questions étaient vraiment étranges. Mademoiselle Monglane avait aussi l'air fatiguée...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "« L'art de la négociation » n'a pas marché.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "« L'art de la négociation », mon œil ! Ce livre est vraiment inutile !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "Oui, ce livre est nul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Pas vrai ? Toi aussi, tu trouves qu'un truc cloche avec ce livre ! Tant pis, au moins on a eu des coupons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "Non, c'est toi qui n'as pas été efficace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Hein...? Mais j'ai suivi toutes les instructions de ce livre. Regarde, « J'ai donc vendu mes produits haut et fort... » C'est vraiment la faute du livre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "Je suis d'accord avec toi, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "#Hé... Ne me prends pas pour une imbécile ! «{NON_BREAK_SPACE}L'art de la négociation » n'a servi à rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "#Non, je n'en suis pas du tout {M#satisfait}{F#satisfaite}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "#Attendez ! Non, on est {M#satisfaits}{F#satisfaites}. Juste pour les coupons de crédit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "#Vous en êtes {M#satisfaits}{F#satisfaites} ? D'accord, je vois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "#J'en suis très {M#satisfait}{F#satisfaite}, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "Ce n'est pas raisonnable, il faut...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Je suis d'accord avec vous, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Est-ce qu'il s'agit... d'orienter la discussion ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Ce n'est pas intéressant, parce que je ne peux pas du tout manger ce que je veux.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "... Les repas ont toujours des saveurs bizarres. Il n'y a pas de surprise !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "Je suis d'accord avec vous, mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Mais ce serait bien si on pouvait obtenir un plat délicieux après dix-huit repas consommés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "Pourquoi dix-huit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "J'ai entendu quelqu'un d'autre le dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "Parce que... Hum... Parce qu'il y a trois repas par jour et six jours avant le dimanche. Ça fait donc dix-huit repas en six jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "Et quand le septième jour arrive, on peut manger quelque chose de délicieux et être de bonne humeur chaque semaine !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
