			"dialogs": [
				{
					"id": 740660201,
					"content": "« L'art de la négociation » ? Hmph, en voyant le titre, je peux dire d'emblée que ce sera ennuyeux ! Ça ne m'intéresse pas... Hein ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "#Ah ? Il y a une note là-dedans ? Euh... «{NON_BREAK_SPACE}Participez à l'enquête de satisfaction interne sur la Cantine à coupons à la réception pour tenter de gagner des coupons de crédit... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "Des coupons de crédit... Ouah ! Tu as vu ça ? Il y a des coupons de crédit à gagner ! Je ne m'attendais pas à cette aubaine. Allons-y !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
