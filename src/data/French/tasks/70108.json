			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Bonjour, puis-je vous aider ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Là, j'ai une lettre pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Une lettre ? Oh... C'est elle qui l'envoie. C'est encore à propos de l'expédition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "Hélas, je n'y peux rien. On trouve peu de gens disposés à aller explorer les Monts Dosdragon. Cet endroit est bien trop dangereux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Je vais lui écrire sans tarder une réponse pour lui expliquer la situation. Merci de m'avoir remis sa lettre !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Oh, en parlant de ça, voici la récompense qu'elle m'a demandé de vous préparer. Je vous en prie, tenez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Et puis... Permettez-moi de vous donner un dernier conseil. Même si vous avez l'air de savoir vous sortir de périlleuses situations, faites très attention si vous vous aventurez dans les Monts Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ah, les Monts Dosdragon... Si seulement j'avais la chance d'y mener moi-même une expédition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
