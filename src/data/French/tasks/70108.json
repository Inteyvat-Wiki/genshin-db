				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "Est-ce que la balise est en place ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Génial ! Merci. Comme ça, je peux enfin mesurer la hauteur des Monts Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Oh, et pour votre paiement, j'ai demandé à Cyrus de préparer quelque chose. Vous pourrez le trouver en ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "Profitez-en pour lui remettre cette missive. Il avait promis de m'informer quant à la deuxième expédition à destination des montagnes, mais je n'ai encore rien reçu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Quand toutes mes balises seront réparées, je devrai retourner en montagne pour les placer. Il y a tellement de choses à analyser dans les Monts Dosdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
