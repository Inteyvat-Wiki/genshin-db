			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#{NICKNAME}, j'ai remarqué que les missions te fatiguaient de plus en plus ces derniers temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510102,
					"content": "En tant que guide compétente et attentionnée, mon devoir est de t'aider à te détendre... Tada ! Devine où on est ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510103,
					"content": "Ça dit « Galerie Damoville » sur le panneau là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "Ah, voilà le repaire des voleurs de moras et le cimetière des portefeuilles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "Bonjour et bienvenue à la Galerie Damoville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510106,
					"content": "#{M#Cher client}{F#Chère cliente}, je vous prierai de ne pas dire de telles choses. La Galerie Damoville s'engage à proposer des produits de qualité à un prix abordable. Vous pouvez voir cela de vous-même.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510107,
					"content": "Ce n'est pas un magasin ordinaire. Ici, les travailleurs viennent se détendre en dépensant de l'argent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510108,
					"content": "Tout à fait ! D'ailleurs, nous venons de lancer une promotion « Un acheté, un offert » pour tous nos clients !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510109,
					"content": "J'y perds et vous y gagnez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510110,
					"content": "Héhé, j'ai vu l'affiche en passant ! C'est comme ça que je m'en suis souvenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510111,
					"content": "Deux produits pour le prix d'un, c'est une sacré bonne affaire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510112,
					"content": "J'ai l'impression qu'il manque quelque chose à ma vie si je ne dépense pas mes moras... Alors on va y remédier aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510113,
					"content": "Que voudrais-tu acheter, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "Comment aimerais-tu y remédier, Paimon ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "Héhé, c'est un secret pour l'instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510116,
					"content": "Je ne paie pas alors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "Ne t'inquiète pas, j'ai pris mon propre argent aujourd'hui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510118,
					"content": "#Patron, vous avez reçu le colis ? C'est aux noms de « Paimon et {NICKNAME} ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510119,
					"content": "Nous l'avons bien reçu. Un instant, je vous prie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510120,
					"content": "Boucicaut, le gérant de la boutique, sort un colis emballé dont on ne peut pas deviner le contenu. Paimon sort un tas de monnaie. Vous voyez un peu de tristesse sur son visage quand elle s'en sépare.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "Vous déballez le colis ensemble. Il y a deux albums photos dedans.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "Héhé, enfin ! J'ai attendu longtemps pour les avoir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510123,
					"content": "On peut mettre nos photos là-dedans, vu qu'on en prend plein !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510124,
					"content": "Je ne te vois pas souvent utiliser un Daguerréotype.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "Peut-être, mais ça ne veut pas dire que je n'en ai jamais utilisé un ! J'ai pris plein de photos de toi quand tu ne regardais pas, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510126,
					"content": "J'ai envie de les voir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "Oh, montre-moi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "Pas tout de suite ! Il faut que je remplisse tout un album photo avant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510129,
					"content": "T'es pas drôle, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "T'es méchante, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "Ce n'est pas vrai ! Bref, prends cet album photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510132,
					"content": "Il est fin, mais on peut mettre beaucoup de photos dedans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510133,
					"content": "On a voyagé dans tellement d'endroits et pris de nombreuses photos, mais pas vraiment pour nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510134,
					"content": "Je me suis dit que ce serait bien de pouvoir garder des souvenirs, alors j'ai acheté ces deux albums.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510135,
					"content": "C'est un cadeau ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510136,
					"content": "Oui ! Comme il y en avait deux pour le prix d'un, ça nous en fait un chacun. J'avais tout prévu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510137,
					"content": "Tu vas l'utiliser maintenant, hein ? On pourrait prendre des photos des endroits qu'on a visités pour se rappeler quelques souvenirs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510138,
					"content": "D'ailleurs, tu veux utiliser mon Daguerréotype ? Tu ne l'as jamais fait, je crois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510139,
					"content": "C'était difficile de commander un modèle fait sur-mesure, alors ce serait dommage de ne pas s'en servir plus souvent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510140,
					"content": "Ça marche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "Merci, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "Je suis contente que tu aimes ! C'est ce qu'une bonne guide est censée faire, après tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510143,
					"content": "Allez, prenons des photos !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}