			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "Alors, c'est livré ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321402,
					"content": "Oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Très bien ! J'ai bien fait de vous demander de l'aide. Et pour Wang le costaud, Guanhai et Zhihua, vous savez ce qu'ils veulent manger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321404,
					"content": "Wang le costaud et Marteau Li veulent de la soupe de porc aux pousses de bambou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "Ah bon ? Ils ont plutôt les mêmes goûts ces deux-là. Par contre, la soupe de porc aux pousses de bambou prend du temps à préparer, mieux vaut que je m'y mette pas trop tard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321407,
					"content": "Guanhai veut de la perche-écureuil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "Pas de problème ! C'est une de mes spécialités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321409,
					"content": "Zhihua veut des beignets lotus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "Oh, je ne pensais pas que Zhihua aimait les pâtisseries. Bon, des beignets lotus, c'est facile à faire en plus !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321411,
					"content": "#Merci de vous être {M#renseigné}{F#renseignée} pour moi ! Bon, je dois m'y mettre sans tarder. Tenez, pour vous remercier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321412,
					"content": "Vous n'accrochez pas de lanternes célestes ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "*soupir* Malheureusement, pas le temps ! Je suis occupé en cuisine, et Xiangling vient de repartir livrer des commandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321414
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321414,
					"content": "Aucun de nous n'a le temps pour ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321415,
						413321416
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321415,
					"content": "Je peux m'en occuper pour vous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321417
					]
				},
				{
					"id": 413321417,
