						413320322
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320322,
					"content": "Et voilà votre commande !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "Ah, enfin ! Ça fait un moment que j'attends... Je suppose que ça doit être compliqué de livrer toutes ces commandes pendant le festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320324
					],
					"speakerTitle": "Atsuko"
				},
				{
