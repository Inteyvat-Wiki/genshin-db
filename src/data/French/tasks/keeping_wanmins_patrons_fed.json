			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "Encore quelques assiettes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320202,
					"content": "Qu'est-ce que vous faites ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Qu'est-ce que je fais ? Je prépare les plats pour le restaurant, bien sûr !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320204,
					"content": "C'est le Festival des lanternes, et pas mal de clients viennent dîner au restaurant, sans compter les touristes venus profiter des festivités.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320205,
					"content": "Même si Xiangling est revenue pour donner un coup de main, il y a beaucoup à faire. D'ailleurs, elle vient de sortir pour livrer quelques commandes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320206,
					"content": "Les autres établissements ont déjà accroché leurs lanternes célestes pour le festival... Mais nous, on n'a même pas encore trouvé le temps d'en fabriquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320207,
					"content": "#Hum... {M#voyageur}{F#voyageuse}, vous pourriez peut-être m'aider si vous avez le temps ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320208,
					"content": "Vous connaissez Atsuko, non ? Cette jeune fille d'Inazuma qui traîne sur les quais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320209,
					"content": "Elle nous a passé une commande. Alors, pourriez-vous m'aider à la livrer ? C'est les fêtes, alors je lui ai mis double ration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320210,
					"content": "Et puis, il y a aussi ceux qui sont toujours occupés sur les quais, <color=#00E1FFFF>Wang le costaud, Marteau Li, Guanhai, Zhihua</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320211,
					"content": "Ils ont toujours été de bons clients du restaurant... Même pendant les festivités, ils restent sur les quais. Je suppose qu'ils ont trop de travail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320212,
					"content": "Alors, j'aimerais aussi leur préparer quelque chose de spécial. Après tout, c'est une période de fête ! Mais comme le restaurant est très occupé, je n'ai pas encore eu le temps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320213,
					"content": "#{M#Voyageur}{F#Voyageuse}, pourriez-vous leur demander quels plats leur feraient plaisir ? Je veux leur préparer quelque chose de spécial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320214,
					"content": "Je m'en occupe !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "C'est bien gentil de votre part ! Revenez vite me voir quand vous saurez ce qu'ils veulent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
