			},
			"dialogs": [
				{
					"id": 413320301,
					"content": "Mais où est passée ma commande du Restaurant Wanmin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "Et voilà votre commande !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "Oh, merci ! Je me disais bien que ça n'allait pas tarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "Ah, l'ambiance du Festival des lanternes me donne un peu le mal du pays, mais... je ne pourrai pas rentrer à Inazuma pendant un moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "Je me demande comment vont les choses à Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
		},
