			"dialogs": [
				{
					"id": 732441901,
					"content": "Les condensateurs de transformation d'énergie... J'espère qu'une fois qu'on aura mis la main dessus, Benben se rétablira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "#Si vous n'êtes vraiment pas {M#sereins}{F#sereines}, je peux y aller avec nous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "Reste ici avec Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "D'accord. Alors j'attendrai de vos nouvelles. Faites bien attention à vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "On sera de retour très vite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
