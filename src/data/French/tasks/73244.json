				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Benben"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Regardez, c'est Benben !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "Par chance, Aderfi n'a pas eu le temps de prendre Benben avec lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441003,
					"content": "Mais tout est exactement pareil qu'avant ici, rien n'a changé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441004,
					"content": "Pensait-il vraiment qu'il allait réussir à renverser la matriarche et retourner à sa tente sain et sauf ? Ce crétin se surestime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441005,
					"content": "Enfin bon, il y a un bon côté à son idiotie : au moins, Benben n'a rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441006,
					"content": "Tu trouves vraiment qu'il n'a rien ? Oh, pauvre Benben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "Comment a-t-il fini dans cet état...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Oui, qu'est-ce qu'il fait par terre ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "Qu'est-ce qu'il lui est arrivé ? Il était en pleine forme la dernière fois qu'on l'a vu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "Après qu'on est tous sortis du Khaj-Nisut, Benben a commencé à faiblir. C'est comme s'il y avait quelque chose de cassé en lui, et les sons qu'il produisait étaient de plus en plus faibles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441012,
					"content": "Ensuite, il n'a plus du tout fait de bruit, et il ne pouvait même plus bouger. On aurait dit qu'il perdait sa vitalité petit à petit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441013,
					"content": "À ce moment-là, personne dans la tribu ne savait ce qui se passait avec Benben, sauf Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441014,
					"content": "C'est pour ça que j'ai laissé Benben chez lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441015,
					"content": "Oh non... Benben... Il ne va pas rester comme ça pour toujours, pas vrai ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441017,
					"content": "Benben est toujours là, c'est déjà ça. On finira par trouver un moyen de le réparer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441018,
					"content": "Mais on ne sait pas du tout comment s'y prendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Hmm, laissez-moi réfléchir. Je me souviens que la dernière fois, Aderfi m'a dit qu'il n'y avait rien de grave et qu'il pouvait le réparer en deux jours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Le connaissant, s'il a fait des recherches, il a certainement laissé des traces écrites de ses travaux. Jetons un œil aux alentours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "#Si ce n'est « rien de grave », alors peut-être qu'on peut résoudre ce problème {M#tout seuls}{F#toutes seules} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441008,
					"content": "Qu'est-ce qui est arrivé à Benben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
