			"dialogs": [
				{
					"id": 732441701,
					"content": "A—Arrêtez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441702,
					"content": "Ayez pitié... Si vous continuez, vous allez nous tuer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441703,
					"content": "C'est convaincant quand ça sort de la bouche de quelqu'un qui se fait battre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "Parle !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "Crache le morceau !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "J—Je vais parler ! Je vais tout vous dire !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441707,
					"content": "Commence par nous dire ce que tu sais !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "On fait affaire avec Aderfi depuis un certain temps maintenant... Et on a entendu dire que la matriarche des Tanit faisait du favoritisme envers Azariq... et envers sa nouvelle fille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441709,
					"content": "Je ne sais pas ce qu'il s'est passé, mais Azariq semble avoir disparu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441710,
					"content": "Cette femme est cruelle. Elle n'a aucune indulgence pour tous ceux qui ne sont plus utiles à la tribu... C'est pour ça qu'Aderfi nous a contactés. Il voulait maintenir son statut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441711,
					"content": "Notre travail dans le désert ne se passait pas très bien, jusqu'à ce que... On fasse affaire avec Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441712,
					"content": "Ceux qui ne sont plus utiles à la tribu... Qu'est-ce que tu veux dire ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "Je ne sais pas... Je ne sais vraiment pas ! Ce sont les affaires internes des gens du désert... Mais si je devais faire une supposition, je dirais que c'est parce que cette femme trouve qu'on n'est plus dignes de confiance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441714,
					"content": "C'est pour ça qu'elle a pris ses distances et qu'Aderfi, qui est régulièrement en liaison avec nous, n'était pas serein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441715,
					"content": "Nous, on peut toujours quitter ce misérable endroit en cas de besoin. Aderfi, par contre, il sera utilisé par la tribu jusqu'à ce qu'il n'ait plus de valeur. Ensuite, qui sait ce qu'ils vont faire de lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441724,
					"content": "Mais il est extrêmement rusé. Il nous a obligés à satisfaire toutes ses demandes, mais on n'a jamais vu la couleur des objets qu'on lui a demandés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441725,
					"content": "Depuis, on a entendu dire qu'il avait eu des ennuis... On ne sait pas ce qui lui est arrivé, mais on s'est dit que c'était peut-être une chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441726,
					"content": "Une chance ? Quelle chance ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "On pensait qu'on n'aurait plus beaucoup d'occasions de commercer avec Aderfi à l'avenir, alors on lui a demandé d'apporter cette fameuse Structure primale dont il nous a parlé plusieurs fois dans ses lettres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441728,
					"content": "Si on arrivait à s'en emparer, on ne partirait pas les mains vides quand il s'agirait de quitter complètement cet endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441729,
					"content": "Quoi ? Vous aussi, vous êtes venus ici pour voler des trucs ? Pas étonnant qu'on n'ait trouvé ni marchandise ni condensateurs de transformation d'énergie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Comment ça, « vous aussi » ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441731,
					"content": "#Tu nous as bien {M#compris}{F#comprises}. Donne-nous les condensateurs de transformation d'énergie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "Grr... Ne me dis pas que ces condensateurs de transformation d'énergie ne sont qu'une invention de ta part !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "Non, les condensateurs de transformation d'énergie existent réellement. Par contre, il y en a plein, et vu que ce sont des objets anciens, on ne sait pas s'il y en a qui sont encore fonctionnels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441735,
					"content": "Dis-nous où ils se trouvent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Ouah, tu sais t'imposer, Paimon !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#Héhé, n'est-ce pas... Mais ne changeons pas de sujet, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Dis-nous où se trouvent les condensateurs ! Plus vite que ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "... Ils sont dans une planque pas loin d'ici. Tenez, c'est la clé pour y accéder. Je vous ai dit tout ce que je savais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441740,
					"content": "Fiche le camp !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "D'accord, d'accord ! Je file.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441741,
					"content": "Je ne veux plus te voir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "#Tu n'as pas de chance de nous avoir {M#croisés}{F#croisées}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "C'est quoi, ce travail que vous faites dans le désert ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "... C'est confidentiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#Ouh là, tu as mis {NICKNAME} en rogne ! Et quand {M#il}{F#elle} se met en colère, c'est pas beau à voir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "Ah...! Bon, d'accord ! Ne vous énervez pas, s'il vous plaît. Je vais parler ! Enfin bon... Je ne sais pas grand-chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441721,
					"content": "Notre mission est d'enquêter sur la situation actuelle de diverses tribus du désert. Après les avoir infiltrées en leur faisant des offres commerciales, nous essayons d'attirer l'attention des sages... Et à partir de là, nous travaillons dans l'intérêt de notre Exécuteur qui se trouve dans la Ville de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441722,
					"content": "Le professeur Froderock cherchait des spécimens vivants dans le désert. Il a toujours défié les ordres de Dottore... Si vous voulez mon avis, c'est par pure jalousie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Négociateur des Fatui"
				},
				{
					"id": 732441723,
					"content": "Ahem, je divague... En tout cas, Aderfi est notre contact ici. C'est lui qui s'occupe de nous échanger notre matériel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Négociateur des Fatui"
				}
			]
		},
