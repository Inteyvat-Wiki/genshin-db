			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "Ce n'est pas possible... Comment ai-je pu oublier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440102,
					"content": "J'espère qu'il n'est pas trop tard. Il faut au moins que j'aille voir dans sa tente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440103,
					"content": "Jeht ! Qu'est-ce qu'il y a ? Tu vas quelque part ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440104,
					"content": "#Paimon et {NICKNAME}... Vous arrivez au bon moment. Il y a quelque chose que je dois faire immédiatement... Je dois aller à la tente d'Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440105,
					"content": "Aderfi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440106,
					"content": "C'est ce traître qui collabore avec les Fatui ? Oh, j'ai compris ! Tu veux aller fouiller sa tente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440107,
					"content": "Non, je ne m'intéresse pas à ses affaires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440108,
					"content": "La tribu a ses propres règles pour gérer les biens des traîtres comme Aderfi. Hmph... Sans quoi, j'aurais tout brûlé à la première occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440109,
					"content": "Si je veux aller à sa tente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440110,
					"content": "C'est pour Benben, pas vrai ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "Ah, c'est vrai ! Benben est toujours chez lui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440112,
					"content": "Jeht ! Pourquoi as-tu confié Benben à un type pareil ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440113,
					"content": "*soupir* J—Je ne savais pas que c'était un traître !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440114,
					"content": "En tout cas, il faut vite que j'aille là-bas pour vérifier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, allons-y avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440116,
					"content": "Le temps presse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "Oui. J'espère qu'il n'est rien arrivé à Benben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440117,
					"content": "Partons tout de suite !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Regardez, on dirait qu'il y a quelque chose ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "Par contre, ça ne ressemble pas à des notes d'observation. On dirait plutôt une lettre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "Une lettre ? Laissez-moi regarder ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440304,
					"content": "D'après ce qu'il y a écrit, Benben est seulement tombé à court d'énergie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "#Maintenant que j'y pense, Benben nous a beaucoup {M#aidés}{F#aidées}, autant pour ouvrir les portes du Mausolée du roi Deshret que pour y activer les autorisations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "Même Benben peut fatiguer... Peut-être qu'il a perdu son énergie parce qu'on a fait plein de choses avec lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440307,
					"content": "Il est fait mention de « condensateurs de transformation d'énergie », mais je n'ai rien vu de la sorte à l'intérieur de la tente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440308,
					"content": "Se pourrait-il que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440309,
					"content": "... Que ça soit caché quelque part ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Je ne pense pas. Si c'est juste pour réparer Benben, il n'aurait aucun intérêt à les cacher, il les aurait utilisés directement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440311,
					"content": "J'ai compris ! C'est parce que l'échange n'a pas encore eu lieu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440314,
					"content": "Aderfi n'a pas amené Benben sur le lieu de l'échange, donc c'est logique qu'il n'y ait pas de condensateurs de transformation d'énergie ici... Une question subsiste : avec qui a-t-il fait ce marché ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440315,
					"content": "Ah, c'est une question idiote. Il n'y a qu'un seul genre de personne avec qui il puisse faire affaire en dehors de la tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440316,
					"content": "Des chercheurs de Sumeru ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "Les Fatui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440320,
					"content": "Qu'est-ce qu'on doit faire, alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "#À ton avis ? On ne peut pas négocier avec les Fatui. On va sur le lieu de l'échange et on leur arrache leurs condensateurs de transformation d'énergie{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440322,
					"content": "Ouais ! On va tout leur piquer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "Par contre, pour Benben... Vu l'état dans lequel il se trouve, on ne pourra pas le prendre avec nous, et bien entendu, pas question de l'amener sur le lieu de l'échange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440324,
					"content": "Et si on le met ailleurs, il ne sera pas en sécurité. Je ne veux plus le laisser seul dans un endroit dangereux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440325,
					"content": "#Alors on n'a qu'à faire comme ça : {NICKNAME} et moi, on va voler les Fatui, et toi, tu restes ici avec Benben !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "Ouais !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Ouais ! On va dépouiller les Fatui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#J'aurais aimé y aller moi-même, mais... {NICKNAME} et Paimon, je dois compter sur vous pour aider Benben à retrouver ses forces !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440331,
					"content": "Aussi, même si ce n'est que quelques Fatui, faites attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440332,
					"content": "Ne t'en fais pas, on s'en occupe ! Tu peux avoir l'esprit tranquille !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "D'accord. Quant à moi... Je ne veux pas rester avec Benben dans la tente de ce traître d'Aderfi. Je vais l'amener chez moi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440334,
					"content": "Quand vous aurez mis la main sur ces condensateurs de transformation d'énergie, venez me retrouver dans ma tente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440328,
					"content": "On va dépouiller les Fatui !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Héhé, ça sera pas la première fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "Ce sont les Fatui !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Précisément. Ça ne peut être qu'eux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440312,
					"content": "... Qu'il ne les ait pas encore reçus ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Ah, je vois où tu veux en venir ! L'échange n'a pas encore eu lieu !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				}
			]
		},
