						732441507
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441507,
					"content": "Benben se connecte aux condensateurs de transformation d'énergie et puise à vive allure l'énergie qu'ils contiennent.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732441508
					]
				},
				{
					"id": 732441508,
					"content": "Bip bip... Bip bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441509
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441509,
					"content": "Ouais ! Benben est revenu à la vie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441510,
					"content": "Arrête de dire des bêtises ! Benben n'a fait que se réveiller d'une longue sieste, voilà tout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441511
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441511,
					"content": "Bip bip... Bip Bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441512
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441512,
					"content": "Non, je n'étais pas inquiète ! Je savais que tu allais te rétablir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441513
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441513,
					"content": "Ahem... « Je ne veux plus le laisser seul dans un endroit dangereux »...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441514,
					"content": "Arrête de répéter ce que je dis, Paimon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441515
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441515,
					"content": "Bip bip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441516
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441516,
					"content": "#Ah oui ! {NICKNAME}, Benben te dit merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441517,
					"content": "Même en étant par terre et incapable de bouger, Benben a pu voir tout ce que vous avez fait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441518,
					"content": "Je t'en prie, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
				{
					"id": 732441519,
					"content": "Bip bip !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441520
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441520,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441521,
					"content": "Qu'est-ce qu'il y a, Jeht ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441522,
					"content": "Même s'il s'est réveillé, Benben a visiblement encore besoin de récupérer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441523,
					"content": "D'accord. Repose-toi bien, Benben !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441524,
					"content": "Bip bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benben"
				}
			]
