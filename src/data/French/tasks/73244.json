			"dialogs": [
				{
					"id": 732440801,
					"content": "Jeht !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440803,
					"content": "Comment c'était ? Vous n'avez pas eu de problèmes ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440802
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440802,
					"content": "Tout s'est passé comme sur des roulettes ! Regarde ! On a les condensateurs de transformation d'énergie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7324410,
			"completionStepIds": [
				7324419
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324419",
							"2"
						],
						"stepId": 7324419,
