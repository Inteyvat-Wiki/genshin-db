			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "Très grande ville, mais... un peu sinistre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780102,
					"content": "#C'est ici que {NICKNAME} et moi, ainsi que plein d'autres compagnons, avons combattu Stormterror autrefois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "Un dragon très très grand qui fait peur avec des ailes flip-flap et des dents pointues ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780104,
					"content": "Il ne fait pas si peur que ça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Kichiboushi, tu te souviens de la statue de l'Archon Anémo que l'on est allés voir à Mondstadt ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "Statue de l'Archon Anémo ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780108,
					"content": "Oui, la grande statue de pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "Hmm ! Je me souviens. L'Archon Anémo, grandes mains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780110,
					"content": "Stormterror et l'Archon Anémo sont en fait de bons amis ! L'Archon Anémo vient aussi de la ville où nous nous trouvons actuellement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "Oh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780112,
					"content": "Mais Stormtréffor si grand, comment il fait pour rentrer ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780113,
					"content": "Tiens donc, je connais quelqu'un qui avait posé la même question...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "Hé, je connais la réponse à cette question ! En fait, il n'a pas besoin de passer par là-bas, contrairement à nous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Ah, Kichiboushi a compris. Stormtréffor sait voler, donc pas besoin marcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780117,
					"content": "M—Mais ! Comment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "Hmm ? Paimon pas contente ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780119,
					"content": "Hum... Passons pour le moment. Allez, on va prendre une photo ici. Kichiboushi, ne bouge pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "Kichiboushi pas bouger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780114,
					"content": "Il s'appelle Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "Il est assez charmant, en réalité.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
