		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "Ioroi, on est de retour !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Oh, vous voilà ! Comment s'est passé votre voyage initiatique ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Clac-clac, boum boum !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726790104,
					"content": "Hahaha, excellent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Ouah, ça y est, on ne comprend plus Kichiboushi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "On a pris plein de photos. Regardez, Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "Vous remettez à Ioroi toutes les photos que vous avez prises durant ce voyage.\\nVous lui racontez également toutes les choses que vous avez vues et qui vous sont arrivées sur le chemin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "... Et voilà comment nous avons amené Kichiboushi visiter huit lieux différents pour son initiation, comme vous nous l'aviez demandé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "Bien ! Je ne me suis pas trompé à votre sujet, vous ne m'avez pas déçu. Si vous étiez des Tanukis, vous pourriez devenir de redoutables Bake-danuki dont le nom ferait trembler la terre entière ! À vous deux, vous pourriez peut-être même avoir la moitié de ma puissance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(Ce n'est pas très impressionnant...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "Enfin bon. Maintenant que notre tâche est terminée, nous devons nous en aller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Bouhouhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726790113,
					"content": "Allons, allons, Kichiboushi, ne sois pas triste. Je vais t'enseigner une dernière chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "Quand tu dis au revoir à des amis, il faut que tu aies le sourire ! Comme ça, tu seras encore plus content de les revoir la prochaine fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "... Hmm ? Très bien, j'y veillerai. Il n'y a pas de problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi vient de dire : « Oui, poil blanc ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "Hein ? Se pourrait-il que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "Kichiboushi ne peut plus parler ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Après tout ce temps, les effets de la nourriture de Bake-danuki se sont estompés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "Hmph, si je n'étais pas enfermé dans ce rocher, je pourrais aisément vous donner le pouvoir de comprendre le langage des Bake-danuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "... Oui ? D'accord, je vais leur dire, Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "« Kichiboushi s'entraînera dur. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "« Pour devenir un grand Bake-danuki comme Ioroi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "... Hmm ? Sacré garnement. Tu ne manques pas d'ambition ! Hahaha, j'avais la même vigueur quand j'avais ton âge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "« Comme ça, poil blanc et poil jaune pas besoin de manger la nourriture Bake-danuki pour parler avec Kichiboushi. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "D'accord ! Je t'attendrai, Kichiboushi. On repartira en voyage initiatique ensemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Continue comme ça, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "Attention à ne pas te faire sceller par des humains !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Hmm ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "Hmm !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726790132,
					"content": "Bon, oublions cela. Vous avez emmené Kichiboushi pour qu'il suive son initiation, donc je n'en tiendrai pas compte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Ah, oui. Il y a un type appelé Utamarou qui est venu dans la Forêt de Chinju pour peindre les Tanukis qui ont été scellés. Il a laissé ici quelques-unes de ses ébauches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "Je vous les donne. Vous n'aurez qu'à les contempler quand les Bake-danuki et leur beauté légendaire vous manqueront !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "Ah, si seulement vous étiez des Bake-danuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "#... On aurait déjà été {M#changés}{F#changées} en pierre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Hmph, peut-être bien. Si vous n'avez rien d'autre à me dire, alors vous pouvez partir. Je dois enseigner la magie à Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "On ne peut de nouveau plus comprendre Kichiboushi ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}