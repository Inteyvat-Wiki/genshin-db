			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Brr... Beaucoup de vent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780402,
					"content": "Il y a des barrières de vent ici, on ne peut pas passer. Il faut les contourner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Suis-nous, Kichiboushi. On va passer à côté doucement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "On est enfin arrivés !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "Il y a une bien meilleure vue ici. Regarde, là-bas, c'est l'endroit d'où on est venus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "Paimon aime hauteur ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780504,
					"content": "Il y a toujours une belle vue dans les endroits en hauteur, et puis c'est pratique pour faire du planeur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Stormtréffor dort ici ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780508,
					"content": "Oui, il a dormi très longtemps ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Même si {NICKNAME} s'est {M#battu}{F#battue} avec lui, en réalité, Stormterror n'est pas un méchant dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "C'est juste qu'il lui est arrivé quelque chose de triste. Il a été blessé, et de mauvaises personnes l'ont dupé. Donc il a cru que son ami, l'Archon Anémo, ne voulait plus de lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Hmm... Et ensuite ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780512,
					"content": "#Ensuite... {NICKNAME}, tu te souviens ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "On a purifié son sang empoisonné pendant la bataille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Mais la plateforme sur laquelle on se trouvait s'est écroulée. On a failli tomber avec l'Archon Anémo dans un endroit très sombre et très profond...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "#Hmm ! Ça fait peur ! Alors, comment vous avez fait ? Vous vous êtes envolés{NON_BREAK_SPACE}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780516,
					"content": "Dvalin nous a sauvés. Il nous a portés sur son dos et nous a amenés ailleurs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "Dva...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780518,
					"content": "Oui, c'est Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "Stormterror a un vrai nom, comme nous. Toi, tu t'appelles Kichiboushi. Moi, Paimon. Et lui, c'est Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "#Au tout début, Dvalin a été blessé et de mauvaises personnes se sont jouées de lui. Ça l'a mis très en colère, alors il est allé semer le chaos à Mondstadt. Les gens ont cru qu'il était un méchant dragon, alors ils l'ont surnommé «{NON_BREAK_SPACE}Stormterror{NON_BREAK_SPACE}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Plus tard, on a battu les méchants, et on a purifié le sang empoisonné par lequel il avait été contaminé. Ce n'est qu'à ce moment qu'il a découvert que l'Archon Anémo ne l'avait jamais abandonné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "Oh ! Dva... Stormtréffor devenu gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780524,
					"content": "Oui ! Si je t'ai amené en initiation ici aujourd'hui, c'est pour te raconter l'histoire de Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "Quand tu seras grand Kichiboushi, toi aussi, tu vivras des malentendus, des choses blessantes ou des événements qui te rendront triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "Cependant, cela ne doit pas être une raison pour devenir quelqu'un de mauvais. Car « le vent finit toujours par changer de direction ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "Un jour, il soufflera vers un avenir meilleur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Hmm ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780529,
					"content": "Kichiboushi, tu ne dois sans doute pas comprendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Compris, mais pas trop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780531,
					"content": "#Mais Kichiboushi sait l'important. J'oublierai pas ce que Paimon et {NICKNAME} ont dit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780532,
					"content": "Tant mieux ! Au moins, je n'aurais pas passé tout ce temps à raconter cette histoire pour rien !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "Mais attention, il ne faut pas que tu sois trop joueur ou trop espiègle, sinon tu vas te faire sceller par les humains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "On dirait bien qu'ici s'achève le voyage initiatique de Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780537,
					"content": "Ne sois pas si triste ! Tu dois rentrer en ayant le sourire, ça fera plaisir à Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "#Bien, maintenant, on doit terminer notre dernière mission en tant que guides, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "On doit ramener Kichiboushi auprès d'Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "Allons-y.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780541,
					"content": "Allons-y, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "On a mené à bien la tâche que nous a confiée Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Stormterror nous a sauvés en nous portant sur son dos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "« Il n'y a que les idiots et la fumée qui... »",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "Hé ! Ce n'est pas du tout vrai. En hauteur, il y a une très belle vue et l'air est frais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
