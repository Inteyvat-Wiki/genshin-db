			"dialogs": [
				{
					"id": 726780301,
					"content": "Hmm... Très joli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780302,
					"content": "Kichiboushi, ça ne va pas ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "Cette ville, un peu sinistre. Très triste, sais pas pourquoi. Bizarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780304,
					"content": "Je suis d'accord avec toi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Maintenant, marchons vers le centre de cette « ville ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "C'est bizarre, Kichiboushi !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
