						],
						"pointId": 322001353
					}
				]
			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "#Ah, mes potes ! Mon petit doigt m'a dit que vous êtes {M#allés}{F#allées} aux Bains Aisa hier soir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Je rassemble l'équipe et nous y allons pour faire la fête ! Ça vous dit ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Mais, on en revient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Euh, ouais... Mais, il y a plein de monde qui n'a pas pu venir hier, non ? Comme Shinobu, Gorou et... Ayato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Pour faire simple, le patron en a entendu parler et il veut vraiment y aller maintenant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "E—Enfin bref ! Une fois que vous aurez fini de papoter, venez me trouver et nous irons faire trempette !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
