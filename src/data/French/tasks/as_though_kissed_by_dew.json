			"dialogs": [
				{
					"id": 401930301,
					"content": "Patronne ! Le Festival des mikawas a été un énorme succès pour nous ! Nous avons eu trois fois plus de visiteurs que d'habitude !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "D'après ce que nous avons fait comme recette jusqu'à présent, je pense que nous pourrons gagner... tout ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "C'est une excellente nouvelle ! Nous pourrions même battre la Chambre Yae ce mois-ci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "Oh ? Quelque chose a l'air de te rendre heureuse... Tu fais la fête sans moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Oh, héhé... Ce n'est rien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "J'ai oublié de t'annoncer la bonne nouvelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Trente pour cent des recettes du Festival ont été versés à la Chambre Yae. Nous nous attendons à un bénéfice record ce mois-ci... Ne crois-tu pas que des félicitations sont de mise ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "Quoi ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "E—Eh bien, patronne... Je pense en effet que des félicitations sont de mise... C'est la 333e fois que nous sommes en compétition avec la Chambre Yae en termes de ventes, et c'est notre meilleure performance jusqu'à présent : la deuxième place !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Héhéhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "... Que tout le monde soit bercé par de doux rêves en cette nuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
