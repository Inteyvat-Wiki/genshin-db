				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Vous tomberez inconscient si vous touchez ces météorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Ah, vous avez raison. J'ai entendu ces rumeurs aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310403,
					"content": "Mais il doit bien exister un appareil ou un équipement pour éviter cela, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310404,
					"content": "Ah, je crois qu'il est en train d'y réfléchir à deux fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310405,
					"content": "Continue comme ça. Il faut vraiment le convaincre qu'il fait mauvaise route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113105,
			"completionStepIds": [
				4113105
			],
