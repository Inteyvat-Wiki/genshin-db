				{
					"id": 411310201,
					"content": "Il y aura des tas de monstres dans les environs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "Je sais et c'est pourquoi je fais appel à vos services.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113103,
