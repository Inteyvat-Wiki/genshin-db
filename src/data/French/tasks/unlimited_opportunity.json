					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310501,
					"content": "Vous êtes sûr de pouvoir obtenir les autres matériaux qui servent dans la production ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310502
					]
				},
				{
					"id": 411310502,
					"content": "Pas d'inquiétude ! J'y arriverai sans aucun problème.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310503
					],
					"speakerTitle": "Ivanovich"
