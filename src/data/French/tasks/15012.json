			"dialogs": [
				{
					"id": 150121301,
					"content": "Je me souviens que Xilonen travaille également dans ce secteur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121302
					]
				},
				{
					"id": 150121302,
					"content": "Oh, vous connaissez Xilonen ? Haha, vous devriez prononcer ce nom devant Tlazolli. Le soleil se couchera avant qu'elle ait fini de chanter les louanges de Xilonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121303
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121303,
					"content": "#L'experte ultime de la tradition des antiques noms, « l'avenir de notre tribu », « l'artisane suprême{NON_BREAK_SPACE}»... Vous entendrez tout cela et bien plus encore, je suis prête à le parier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121304
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121304,
					"content": "Même si Tlazolli regrette l'époque où elle créait des antiques noms, elle ne le dira jamais... Mais moi, je le peux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				}
			]
