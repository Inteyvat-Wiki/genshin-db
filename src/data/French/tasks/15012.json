					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "Serait-ce un antique nom ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "Hé, même l'Archon Pyro a dit qu'elle avait demandé l'aide de Xilonen à ce sujet. Pas besoin de rendre les choses plus compliquées qu'elles ne devraient l'être !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Nous n'avons pas besoin de quelque chose de fantaisiste comme ça. Un cadeau normal sera plus que suffisant, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120826
					],
					"speakerTitle": "Paimon"
				},
				{
