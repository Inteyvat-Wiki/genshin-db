			"dialogs": [
				{
					"id": 150120401,
					"content": "Eh bien, ils ne se sont pas beaucoup battus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Je suppose qu'ils savaient à quoi ils s'exposaient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Ouf... Merci à vous deux. J'ai cru que je n'arriverais pas à descendre de cette montagne en vie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Sauvée par {NICKNAME}... J'ai vraiment eu de la chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Je ne me suis pas présentée, désolée. Je m'appelle Cheven, je travaille les pierres précieuses. Je n'ai généralement pas de chance, mais on dirait qu'elle est en train de tourner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "#C'est Imix qui nous a {M#envoyés}{F#envoyées} vous aider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Cette enfant... *soupir* On dirait qu'elle s'est encore inquiétée à cause de moi. Je ne pensais pas que je serais partie plus de deux jours tout au plus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Mais je ne m'attendais pas non plus à découvrir une nouvelle veine de cristal volcanique près de l'épingle d'ombre... D'une pureté remarquable et en quantités substantielles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "J'en ai déterré une bonne quantité et je m'apprêtais à repartir, mais le phlogistique contenu dans les cristaux a attiré des monstres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "Notre réputation a ses avantages, je suppose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
