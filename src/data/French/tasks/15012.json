				]
			},
			"dialogs": [
				{
					"id": 150120501,
					"content": "#Les monstres m'ont fait peur, alors j'ai fait un détour par un chemin étroit pour les éviter... Tout ça pour tomber sur ces bandits. Une chance que vous soyez {M#arrivés}{F#arrivées} à ce moment-là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Et vous portiez toujours ces cristaux pendant que vous couriez ? Pourquoi ne pas les avoir laissés tomber si vous étiez en danger ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Oh, j'en ai jeté beaucoup, croyez-moi. En fait, il ne reste plus que la partie la plus pure du lot. Je suis déterminée à la ramener coûte que coûte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "Je dois le faire pour Tlazolli et la pauvre petite Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "De qui s'agit-il ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ah, c'est vrai, vous ne pouvez pas le savoir. Tlazolli... était autrefois une artisane des antiques noms, et Nechca est sa fille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "Cheven"
				}
			]
		},
