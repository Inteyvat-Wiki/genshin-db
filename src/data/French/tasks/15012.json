			"dialogs": [
				{
					"id": 150120101,
					"content": "E—Elle n'est pas encore revenue... Est-ce qu'il serait arrivé quelque chose à maître Cheven...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Il y a une enfant qui pleure là-bas. Il s'est passé quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "Allons vérifier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Bonjour. Quelque chose ne va pas ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*sanglote* Maître C—Cheven, elle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "E—Elle a dit qu'elle allait chercher des cristaux volcaniques... Mais elle n'est pas encore revenue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "J'en ai parlé aux gardes, mais ils ont dit qu'ils n'avaient pas assez de personnes disponibles en ce moment. Ils ont aussi dit que le terrain était très dangereux dans cette direction parce qu'il y a des monstres et des méchants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Ils doivent terminer leurs préparatifs avant de tenter de la sauver... Mais il sera trop tard !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "Ne t'inquiète pas, nous allons nous en occuper !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Ça veut dire que vous allez m'aider ? Super ! Attendez, je vais dessiner l'endroit où les gardes sont allés plus tôt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Ils ont dit que c'est peut-être un endroit où elle se serait arrêtée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Elle aurait même pu être forcée de s'approcher de l'épingle d'ombre. Si c'est le cas... Alors... *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "Aidez-moi à sauver maître Cheven, je vous en prie !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "On dirait que c'est le moment pour d'autres exploits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
