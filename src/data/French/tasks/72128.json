					"nextDialogs": [
						721280502
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280502,
					"content": "Et sinon... Vous collectionnez ce genre de conques ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "Héhé, bien vu. Oui, je les collectionne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280504,
					"content": "Mais je ne peux pas vous dire pourquoi pour le moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280505,
					"content": "Ont-elles quelque chose de spécial ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "Bien sûr que oui ! Enfin, d'un point de vue commercial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280507,
					"content": "« Une conque affectée par le Tatarigami »... Haha, c'est sûr que ça va se vendre à bon prix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280508,
					"content": "Ahem ! Quoi qu'il en soit, vous fournissez des conques, je fournis des coffres. Marché conclu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280511,
					"content": "Eh bien, c'était votre occasion pour cette fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280512,
					"content": "Si vous voulez ouvrir un autre coffre, revenez plus tard avec d'autres conques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280509,
					"content": "C'est quand même louche tout ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
				},
				{
					"id": 721280510,
					"content": "Ce sont juste des conques, voyons ! Allez, ne soyez pas paranoïaque comme ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
