			"dialogs": [
				{
					"id": 721280401,
					"content": "Joli ! C'est exactement le genre de conques que je cherchais. Allez-y, choisissez un coffre et ouvrez-le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280402,
						721280403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280402,
					"content": "Seulement un ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Désolé, vous ne pouvez en ouvrir qu'un seul à la fois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280405,
					"content": "Bon, faites votre choix ! Et bonne chance hein, héhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280403,
