			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "Hé, minute papillon ! Vous ne pouvez pas ouvrir ces coffres comme ça, à votre guise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280103,
					"content": "Ils sont à vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "Bien sûr ! Et je les ai placés ici spécialement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280106,
					"content": "Ils sont remplis de toutes sortes de trésors que j'ai soigneusement rassemblés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280107,
					"content": "Si vous voulez en ouvrir... Eh bien, on peut s'arranger. Cependant, vous devez d'abord me donner un petit quelque chose en échange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280108,
					"content": "Des moras ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "Hahaha, en fait, je ne veux pas de moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280111,
					"content": "Ce que je veux, c'est une sorte de conque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280112,
					"content": "Vous devriez pouvoir en trouver beaucoup vers la plage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280113,
					"content": "Si vous voulez ouvrir ces coffres et mettre la main sur ce qu'il y a à l'intérieur, apportez-moi quelques-unes de ces conques en échange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280114,
					"content": "Mais... Je ne vais pas vous dévoiler ce qu'il y a dedans. Les trésors avec lesquels vous vous retrouverez dépendront de votre chance !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280115,
					"content": "Qu'en pensez-vous ? Si vous voulez ouvrir ces coffres, donnez-moi des conques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280110,
					"content": "Que voulez-vous alors ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "Qu'est-ce qu'il y a à l'intérieur ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
