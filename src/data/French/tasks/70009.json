						700090604
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090604,
					"content": "#Hmm, Lili ? Qu'est-ce que tu fais avec {NICKNAME} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090605
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090605,
					"content": "#Papa et maman sont en train de faire quelque chose de très impotent ! Donc c'est {M#le monsieur}{F#la dame} qui m'emmène jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090606
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090606,
					"content": "« Quelque chose d'important », hein ? J'ai bien une idée sur ce que ça pourrait être...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090607
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090607,
					"content": "Enfin, passons... Est-ce que vous avez besoin de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090608
					],
					"speakerTitle": "Flora"
				},
