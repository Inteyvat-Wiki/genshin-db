			"dialogs": [
				{
					"id": 700090502,
					"content": "#Ah, Lili, {M#voyageur}{F#voyageuse}, vous revoilà. Est-ce que vous avez trouvé les chiots ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
