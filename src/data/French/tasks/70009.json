					"nextDialogs": [
						700090610
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090610,
					"content": "Pour de vrai ? Merci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090611
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090611,
					"content": "C'était... inattendu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090612
					]
				},
				{
					"id": 700090612,
					"content": "Eh bien... Sieur Rudolf vient de commander un énorme bouquet pour dame Gillianna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090613
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090613,
					"content": "Alors, un petit pissenlit en cadeau, ce n'est pas grand-chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090614
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090614,
					"content": "Ce pissenlit est trop zoli... Mais je dois vite rentrer chez moi, sinon papa et maman vont s'inquiéter si je suis pas là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090615
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090615,
					"content": "Oh ! Avant de rentrer... Est-ce que tu sais où on peut trouver une super grande poêle ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090616
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090616,
					"content": "J'ai vu maman faire des pancakes une fois, alors je veux en faire pour toi aussi, pour te dire merci de m'avoir accompagnée aujourd'hui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lili"
