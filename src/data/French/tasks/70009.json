				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Monsieur, c'est vrai que les Phatoui comme vous ne célèbrent pas la Fête des anisées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090102,
					"content": "Moi... Euh, je pense que je ne peux pas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090103,
					"content": "Qu'est-ce que tu manigances encore ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "Qui, moi ? Oh, c'est toi. Allez, pourquoi tu me traites toujours comme ça ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090105,
					"content": "Je parlais juste à cette gamine. J'ai rien fait de mal !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090106,
					"content": "Alors les Fatui ne célèbrent vraiment pas la Fête des alizées...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "Et vous alors ? Vous allez pas profiter de la Fête des anisées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090108,
					"content": "#Eh bien, tu sais, c'est le chevalier honoraire de Mondstadt, après tout. Je suis sûr qu'{M#il}{F#elle} a beaucoup de choses à faire, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090109,
					"content": "Pas la peine de prendre cet air suffisant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "*tousse* C'est rien, laisse tomber. À propos, si tu n'as rien d'autre à faire, tu pourrais me rendre un petit service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090111,
					"content": "Les parents de cette gamine sont partis faire des courses pendant la fête, alors ils l'ont laissée avec les sœurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090112,
					"content": "Mais comme tu le sais, tout le monde est débordé de travail pendant cette période, même les sœurs. Elles n'ont donc pas le temps de l'emmener jouer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090113,
					"content": "Et c'est comme ça qu'elle s'est collée à mes basques. Mais bon, tu sais bien que je ne peux pas quitter la cathédrale comme ça, alors la seule chose que je peux faire, c'est de discuter avec elle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090114,
					"content": "Quelle honte... Même lorsque je ne fais que papoter, je me fais fusiller du regard par cette sœur là-bas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090115,
					"content": "Je parie qu'elle se dit « Oh, je me demande ce que ce sale Fatui manigance cette fois » ou quelque chose dans le genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090116,
					"content": "Tsss. Donc, pour que cette sœur me laisse tranquille et pour le soi-disant bien-être psychologique de cette gamine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090117,
					"content": "Je t'implore, ô glorieux et juste chevalier honoraire, d'accompagner cette enfant au-dehors pour jouer. Accepterais-tu ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090118,
					"content": "Ça va, j'ai compris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "Oh oh, du premier coup, voilà qui est bien digne du chevalier honoraire ! C'est idiot de ma part, je pensais que tu allais chipoter et me demander une compensation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090120,
					"content": "Bon, prends la gamine et vas-y. Je vais rester ici, à me faire transpercer du regard par ces sœurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090121,
					"content": "*soupir* Quand est-ce que j'en aurai fini de rester ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090122,
					"content": "En fait, tu veux simplement que Lili puisse sortir et s'amuser, hein ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "Tu... Ah, peu importe. Je suis avec les Fatui. On est les méchants, compris ? Aucune bonté dans notre cœur, tout ça tout ça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090124,
					"content": "Allez, file. Prends cette gamine et va jouer. Elle me tue à rester dans la cathédrale à rien faire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090125,
					"content": "Quant à moi... Je vais rester ici, à me faire transpercer du regard par ces sœurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Victor"
				},
				{
					"id": 700090126,
					"content": "*soupir* Quand est-ce que j'en aurai fini de rester ici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victor"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000904",
							"2"
						],
						"stepId": 7000904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lili"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "Pourquoi monsieur le Phatoui ne peut pas aller à la Fête des anisées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090202,
					"content": "Il a du travail très important.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "Un travail impotent ? Encore plus impotent que la Fête des anisées ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090207,
					"content": "Même si ce Phatoui a fait des trucs méchants, il peut toujours changer et devenir gentil, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090208,
					"content": "Je vais lui dire que s'il devient gentil, il peut participer à la Fête des anisées !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090209,
					"content": "Il est très occupé pour le moment. Et si on allait jouer un peu d'abord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "Ah... D'accord. Vous pouvez m'emmener jouer alors ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090211,
					"content": "Bien sûr, mais bon... Pas trop loin, d'accord ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "Youpi ! On y va, on y va !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090204,
					"content": "Les Fatui ne peuvent pas participer à la Fête des alizées.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "Pourquoi pas ? C'est parce que les Phatoui sont des méchants ? Papa m'a dit qu'ils ne se brossent pas les dents avant de dormir et qu'ils mangent avec les mains...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090206,
					"content": "Hmm... C'est vrai que c'est pas gentil de faire ça, quand même. Et puis, je suis sûre que ça doit mettre leurs papas en colère aussi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lili"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "#{M#Voyageur}{F#Voyageuse} ? Avez-vous besoin de quelque chose ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090303,
					"content": "Et... c'est toi, Lili ? Qu'est-ce que tu fais là ? Où sont tes parents ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090304,
					"content": "#Papa et maman sont en train de faire quelque chose de très impotent ! Donc c'est {M#le monsieur}{F#la dame} qui m'emmène jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090305,
					"content": "Quelque chose d'important ? Ah, Rudolf et Gillianna, non mais vraiment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090306,
					"content": "Grande sœur, où sont passés les petits toutous de tout à l'heure ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090307,
					"content": "Oh, les chiots ? Euh, je ne suis pas sûre, en fait. Ils se cachent généralement dans leur coin, sauf si je mets un peu de nourriture dans leur bol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090308,
					"content": "C'est sans doute tout le bruit qui les a effrayés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090309,
					"content": "Pourquoi, Lili ? Tu veux jouer avec eux ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090310,
					"content": "Oui ! Je veux jouer !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090311,
					"content": "Hmm... Laisse-moi réfléchir... Je pense que les chercher ne servira à rien... Peut-être qu'on peut essayer de mettre un peu de nourriture dans ce bol pour voir si ça les fait sortir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090312,
					"content": "Hmm, voyons... Je pense qu'un peu de volaille fera l'affaire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090313,
					"content": "Ah bon ? Mais où on va trouver ça...",
					"roleType": "TALK_ROLE_NPC",
