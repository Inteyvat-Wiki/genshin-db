	"talks": [
		{
			"id": 7000901,
			"completionStepIds": [
				7000903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000903",
							"2"
						],
						"stepId": 7000903,
						"stateName": "QUEST_STATE_UNFINISHED"
