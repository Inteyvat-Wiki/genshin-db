					"nextDialogs": [
						700090504
					]
				},
				{
					"id": 700090504,
					"content": "Oui ! Merci, grande sœur ! C'était vraiment super amusant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090505
					],
					"speakerTitle": "Lili"
				},
				{
					"id": 700090505,
					"content": "#C'est bien. Oh, au fait, si vous avez du temps {M#tous}{F#toutes} les deux, vous pouvez aller voir Flora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090506
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090506,
					"content": "C'est la Fête des alizées après tout. Ce serait bien de ramener un bouquet de fleurs, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090507
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090507,
					"content": "Oh... C'est vrai ! On y va, dis...",
