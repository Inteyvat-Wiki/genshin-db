			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Liang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Héhé... Par ici le trésor !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "Quels imbéciles... Mes deux frères sont des idiots, à penser avoir trouvé la solution après avoir lu deux lignes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "Honorer la volonté du père ? La seule partie intéressante dans tout ce charabia était la mention du trésor se trouvant dans la mine. Et qui sera bientôt à moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Liang"
				}
			]
		},
