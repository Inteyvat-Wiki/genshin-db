			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Ils... Ils sont tous partis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Qing, Yuan Liang, Yuan Cheng... Pauvres enfants, il vous faudra être plus observateurs et plus malins que ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Hé, ce sont les types de l'autre fois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "« L'arbre esseulé n'a pas de congénères ; à la brise levante, où sont passés tes frères ? » Ha, on n'arrive vraiment à rien tout seul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070603,
					"content": "« Luxuriantes feuilles carmin, se désunissant là où le vent n'est point... » Si seulement je pouvais croire mes frères et mon père...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "« Abondantes feuilles carmin, que la brise emporte au loin... » Le trésor... Tout perdu, à cause du trésor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "« Les arbres leurs racines s'emmêlent ; car ainsi la famille se révèle... » Mes enfants, nous sommes censés être une famille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Vous avez tous cru que j'avais caché le trésor dans la mine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Il existe bien un trésor pourtant... Vous ne vous rappelez donc pas l'arbre qu'on avait planté quand vous étiez encore tout petits ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Je m'y rends tous les ans, et y enterre à chaque fois un petit quelque chose. J'espérais qu'une fois adultes, nous pourrions tout aller déterrer ensemble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "Je me disais qu'on pourrait alors aller manger et boire un morceau, passer un bon moment ensemble et parler du passé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Ah, mes enfants, mes enfants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
}