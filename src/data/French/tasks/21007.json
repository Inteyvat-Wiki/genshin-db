				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "Oh non ! Qu'est-ce que j'ai fait pour mériter ça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070202,
					"content": "J'ai enfin réussi à m'éclipser pendant qu'ils étaient occupés pour arriver en premier à la mine et récupérer le trésor... Mais d'où sortent tous ces monstres ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070203,
					"content": "Malheur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Qing"
				}
			]
		},
		{
