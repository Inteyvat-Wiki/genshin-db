			},
			"dialogs": [
				{
					"id": 210070101,
					"content": "« L'arbre esseulé n'a pas de congénères ; à la brise levante, où sont passés tes frères ? ... Mais solide, le roc a un cœur en or, et sa bénédiction est de tous partagée... À toi qui connais cette fortune, je dis : honore la volonté de ton père... »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notes perdues"
				}
			]
		},
		{
			"id": 2100702,
			"completionStepIds": [
