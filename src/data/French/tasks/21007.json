			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Cheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Tsss, quelle bande de faux-frères ! Tout ce qui les intéresse, c'est garder les meilleures trouvailles pour eux-mêmes !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "Et père qui perd la vue avec l'âge... trop content de ne rien voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "Ils n'ont sans doute pas encore compris que le trésor était dans la mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "J'ai intérêt à mettre vite les mains dessus et prendre la tangente aussi loin que possible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Cheng"
				}
			]
		},
		{
			"id": 2100704,
