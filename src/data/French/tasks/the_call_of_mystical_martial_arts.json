						],
						"pointId": 9409
					}
				]
			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine demande au gérant ce qu'il y a au menu et commande plusieurs plats aussi chers que célèbres...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "J'ai entendu dire que la cuisine de Liyue se concentre sur trois choses : la présentation, l'arôme et le goût ! Ça a l'air tellement différent !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "La regarder suffit à me faire saliver !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Vous appréciez les spécialités de l'Auberge Wangshu à leur juste valeur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Waouh, ce plat est vraiment délicieux, et celui-là... Je suis sur le point d'imploser !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "C'était délicieux !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "La fatigue du voyage a totalement disparu !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Merci beaucoup pour tout ce que vous avez fait. Sans vous, je ne serais jamais arrivée jusqu'ici aussi facilement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Je viens d'entendre un membre du personnel dire que <color=#00E1FFFF>Liyue</color> n'était plus très loin d'ici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Je vais me reposer ici pendant quelques jours. Je vais en profiter pour demander aux autres voyageurs comment trouver les maîtres légendaires avant de décider où aller ensuite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "J'ai été heureuse de voyager avec vous, mais je ne peux pas vous retenir plus longtemps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "#Je veux travailler dur pour renforcer mes compétences et devenir {M#un grand aventurier}{F#une grande aventurière} comme vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "#Héhé, même si nous n'avons pas passé longtemps ensemble, nous nous sommes bien {M#amusés}{F#amusées} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "J'espère que nous nous reverrons !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Au plaisir de te revoir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "Que tes souhaits se réalisent !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "Merci ! Je vous souhaite également un agréable voyage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine vous dit au revoir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Pendant que nous sommes ici, explorons la région.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Peut-être que nous vivrons quelque chose de palpitant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine a dit que <color=#00E1FFFF>Liyue</color> était juste là. Allons y faire un tour quand nous aurons le temps !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
