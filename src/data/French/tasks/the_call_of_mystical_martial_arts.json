						],
						"stepId": 7068107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gesine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "#Une photo avec des {M#aventuriers chevronnés}{F#aventurières chevronnées}, un trésor que je chérirai pour toujours !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Oh, je n'avais pas réalisé à quel point j'avais faim jusqu'à ce que je me détende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Maintenant que tu le dis, c'est vrai que mon estomac gargouille...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Allons quelque part pour nous reposer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Trouvons un endroit pas trop loin pour manger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "Il semble ne pas y avoir de restaurants décents dans le coin... Par respect pour vous et l'aide que vous m'avez apportée, je ne peux pas accepter que vous ne profitiez pas d'un repas digne de ce nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "En parlant de ça, ce bâtiment sur le rocher en face, c'est la célèbre <color=#00E1FFFF>Auberge Wangshu</color>, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "J'ai entendu dire par un commerçant de Liyue venu à Mondstadt que la nourriture y était excellente !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "Je vous y invite en guise de remerciement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Trop bien, on va se régaler !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Paimon, allume un feu et cuisine-nous quelque chose !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Hé, tu aimerais que je te commande comme ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "En plus, tu devrais connaître les limites de mes compétences culinaires...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068108,
