						],
						"pointId": 9406
					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "C'est le <color=#00E1FFFF>Marais Dihua</color> devant nous, n'est-ce pas ? Il n'y a pas plus beau paysage à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "Je savais que partir en voyage était la bonne décision !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "Oh, c'est une rare occasion ! Immortalisons-la !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
		{
