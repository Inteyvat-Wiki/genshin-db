						706811214,
						706811215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811214,
					"content": "Au plaisir de te revoir !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "Que tes souhaits se réalisent !",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "Merci ! Je vous souhaite également un agréable voyage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811217,
					"content": "Gesine vous dit au revoir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "Pendant que nous sommes ici, explorons la région.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811219,
					"content": "Peut-être que nous vivrons quelque chose de palpitant !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068131,
			"completionStepIds": [
				7068103
