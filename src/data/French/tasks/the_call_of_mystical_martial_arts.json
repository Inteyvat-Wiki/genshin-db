			"dialogs": [
				{
					"id": 706810301,
					"content": "Pfiou, je suis enfin sauvée... Merci beaucoup !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "Je m'appelle Gesine. Comme vous le voyez, je suis une aventurière.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "#Avec vos compétences, vous ne devez pas être des gens ordinaires ! Êtes-vous un chevalier au grand cœur ? Ou peut-être {M#un héros errant}{F#une héroïne errante} qui parcourt le monde ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "#Je suis {M#un voyageur}{F#une voyageuse} de passage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Je m'appelle Paimon, et voici {NICKNAME}. {M#Il}{F#Elle} fait aussi partie de la Guilde des aventuriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "#Ah, vous êtes donc {M#un aventurier chevronné}{F#une aventurière chevronnée} ! Vous avez réussi à vous débarrasser d'un monstre aussi redoutable comme si de rien n'était. C'est vrai qu'on trouve toujours plus fort que soi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "Tandis que moi... Je sais parfaitement ce que je dois faire à l'entraînement. Mais si je dois vraiment me battre, mon corps ne m'écoute tout simplement plus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "Vais-je réellement encore devoir m'entraîner pendant trois à cinq ans, comme l'a dit mon maître ? Ce serait trop gênant de rentrer sans avoir réussi... *sniff* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "#Oh... Ce n'est probablement qu'une question d'expérience. Nous avons traversé de nombreuses difficultés et autant de combats pour devenir aussi {M#forts}{F#fortes} !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "Tu dois d'abord apprendre à garder ton calme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "#{M#Il}{F#Elle} a raison ! C'est fréquent pour les {M#débutants}{F#débutantes} de paniquer lorsqu'{M#ils}{F#elles} sont {M#confrontés}{F#confrontées} à un réel danger. Et, par conséquent, {M#ils}{F#elles} se débrouillent beaucoup moins bien qu'à l'entraînement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "Même si les ennemis ont l'air puissants, tu dois garder ton calme et trouver leurs points faibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "Comme ça, tu peux gagner le combat plus rapidement !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "C'est donc ça... On sent vraiment toute l'expérience qui parle ! On dirait que je vais devoir continuer à m'entraîner en voyageant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "Tu es aussi en voyage en ce moment ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Oui... Je me prépare à aller à <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "Vous avez entendu parler des arts martiaux de Liyue ? J'ai entendu dire que les pratiquants sont capables de sauter par-dessus les toits et d'escalader les murs. On dit même qu'ils sont invulnérables et qu'ils coupent le fer comme du petit bois !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "Si je pouvais apprendre quelques trucs auprès d'un grand maître, mes aventures futures seraient bien plus faciles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "Mais pour être honnête, même si je fais partie de la Guilde des aventuriers depuis un moment, c'est mon premier long voyage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "*soupir* Dès que j'ai quitté la ville, des monstres m'ont attaqué. Vais-je seulement arriver à Liyue en un seul morceau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "Nous aussi, on va à Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "Vraiment ? Vous aussi, vous cherchez un grand maître ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "Pas tout à fait, non. Nous parcourons toutes les nations de Teyvat pour... différentes raisons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "Nous ne savons pas encore grand-chose de Liyue, mais nous voulons absolument la visiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "Puisque nous allons dans la même direction, autant faire un bout de chemin ensemble !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "Waouh, partir avec des gens aussi expérimentés... J'ai de nouveau de l'espoir pour mon voyage !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "Laissez-moi vous montrer le chemin. J'ai étudié attentivement la carte avant de partir. Nous ne nous perdrons pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "Tu veux te joindre à nous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "Il est également crucial d'évaluer correctement la situation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Oui, si tu te rends compte que l'ennemi est plus fort que toi, il vaut mieux battre en retraite. Continuer à se battre pourrait être dangereux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "Je préfèrerais garder ça pour moi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "Je comprends ! Vous devez être en mission et celle-ci doit rester secrète...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "C'est à peu près ça, oui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "Oh, arrête de nous faire languir !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
