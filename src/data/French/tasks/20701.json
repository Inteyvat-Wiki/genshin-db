			"dialogs": [
				{
					"id": 207010101,
					"content": "J'ai encore faim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010102,
					"content": "Oh, c'est toi ! Ça tombe bien ! Tu te souviens de moi ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010103,
					"content": "Xiangling et le duel de cuisine ? C'est moi, Siegfria !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010104,
					"content": "Héhé, tu arrives juste au bon moment... Tu me donnerais un coup de main ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010105,
					"content": "Qu'est-ce qu'il y a ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "Tu te souviens des aumônières de jade que tu avais cuisinées la dernière fois ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010107,
					"content": "Elles étaient vraiment délicieuses, je me souviens encore de leur goût.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010108,
					"content": "J'aimerais bien savoir les cuisiner comme toi, mais... je n'y arrive pas, il manque quelque chose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010109,
					"content": "Mais je suis sûre que si j'y goûte encore, je devrais pouvoir trouver ce qui manque !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010110,
					"content": "Est-ce que tu accepterais de m'en cuisiner ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
