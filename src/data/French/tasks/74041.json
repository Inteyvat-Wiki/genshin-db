			"dialogs": [
				{
					"id": 740411401,
					"content": "#Nous y voilà ! {M#Cher monsieur}{F#Chère demoiselle}, c'est la station centrale de traitement qui sert à analyser les données de nos recherches hydrologiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411402,
						740411403
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411402,
					"content": "On dirait qu'il n'y a personne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				},
				{
					"id": 740411404,
					"content": "À quoi on sert s'il n'y a pas de Fatui ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411405,
					"content": "Ce n'est pas sûr. Et s'il y avait des messieurs de Snezhnaya à l'intérieur ? Je ne pourrais plus revoir mes madeleines de conque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411406
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411406,
					"content": "#Ahem, je veux dire que je ne pourrais plus faire des recherches hydrologiques ! S'il vous plaît, mes deux {M#bienfaiteurs}{F#bienfaitrices}, accompagnez-moi dedans !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411407
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411407,
					"content": "*soupir* D'accord, ouvrez la porte...",
