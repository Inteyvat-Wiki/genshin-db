			"dialogs": [
				{
					"id": 740410101,
					"content": "Broglie, on a obtenu les données des deux stations d'observation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Vraiment ?! C'est super ! Montrez-les-moi !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Voilà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Vous donnez les rubans ramassés à Broglie.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "Ah oui ! Ce sont bien mes données ! Vous êtes des anges ! Je peux enfin mener la belle vie à nouveau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "Vous exagérez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "Ne perdez pas de temps. Je vais demander au superviseur la clé de la station centrale de traitement ! Attendez-moi, s'il vous plaît.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "*soupir* ... Dépêchez-vous !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Peu après, Broglie est de retour, tout sourire...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#{M#Cher monsieur}{F#Chère demoiselle}, j'ai obtenu la clé ! Il faut aller à la station centrale de traitement pour organiser les données. Ensuite, la surveillance hydrologique sera de nouveau possible !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Oh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Vu la situation de la Station Pâte de fruits et de la Station Crêpes Suzette, des messieurs venant de Snezhnaya pourraient se trouver également à la station centrale de traitement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Accompagnez-moi, s'il vous plaît !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Euh... N'oubliez pas notre récompense !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "On doit y aller avec vous ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "Et notre récompense ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "Ne vous inquiétez pas. Tant que mon superviseur approuve la restauration de la recherche hydrologique, je vous paierai comme promis !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Héhé... Tant mieux !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
