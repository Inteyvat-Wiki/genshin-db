					"content": "En organisant les données rassemblées, on pourrait obtenir de bons résultats... Ce n'est qu'une question de temps avant la reprise de la surveillance hydrologique !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Ah, c'est super !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "Hein ? J'ai l'impression qu'il manque une partie des données... Est-ce que j'hallucine ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "Pourquoi vous doutez ? Ce sont des données dont vous étiez responsable, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410608,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "Euh... Pardon, je me suis trompé d'endroit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410610,
					"content": "Le Commandant Fatui s'enfuit à une vitesse qui ne correspond pas à sa taille...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "A... Attends, qu'est-ce qui vient de passer ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Il était rapide ! Encore plus rapide qu'un Élémentosaure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Non, ce n'est pas le moment de s'intéresser à ce genre de chose ! Ce type est un Fatui, non ? Pourquoi il est là ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, attrapons-le pour l'interroger !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "C'est un type agile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
