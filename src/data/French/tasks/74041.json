						],
						"pointId": 6370
					}
				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "Ne me frappez pas ! Je me rends ! Je me rends !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411302,
					"content": "Vous... Vous venez pour ces rubans, non ? Je vous donne tout ça ! Ne me frappez pas !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411303,
					"content": "Le Commandant Fatui vous remet toutes les données de recherche...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Vous avez tout, Broglie ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Euh... Peut-être ? Oui, c'est tout !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Laissez tomber, faites comme si je n'avais rien demandé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "Quel est votre but ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Oui, dites-nous tout ! Pourquoi occuper les stations d'observation ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411310,
					"content": "Pour... Pour ne pas travailler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411311,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Je m'appelle Malinovskyi, capitaine de la 34e équipe d'enquête indépendante des Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411313,
					"content": "Les premiers jours de notre expédition à Fontaine étaient agréables. Tout le monde était content, et il n'y avait rien de difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411315,
					"content": "Euh... C'est quoi le rapport ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "Cependant, en raison d'un remaniement de l'organisation il y a quelques mois, Snezhnaya a envoyé un type qui s'appelle Shumilov pour qu'il devienne mon adjoint !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411317,
					"content": "Shumilov ? Ah, c'est celui qu'on a rencontré à la Station Crêpes Suzette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "Oui, c'est lui ! J'en ai marre de ce type ! Mais je n'ai pas de moyen de le faire disparaître... Alors je trouve des excuses pour l'éviter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411319,
					"content": "Attendez, vous m'avez perdue... Shumilov, c'est votre adjoint ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Oui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411321,
					"content": "Du coup, c'est votre subordonné, non ? Pourquoi vous devez lui obéir ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Ce maudit type est bien mon subordonné, mais il prend toujours des airs sérieux pour faire travailler les autres !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411323,
					"content": "Ses paroles ne sont pas discutables et je ne peux pas lui dire devant les autres que personne ne veut travailler, vous savez ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411324,
					"content": "J'ai vu des tours bizarres à proximité. De ce fait, je lui ai dit que nous serions ici pour une enquête et j'ai contrefait la lettre de la Maison Gestion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411325,
					"content": "Hmph, c'est vous qui l'avez contrefaite ! Je me disais que c'était louche que la Maison Gestion vous confie la gestion des stations d'observation hydrologiques !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Broglie, avez-vous des choses à lui demander ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Je vois. Vous essayez donc simplement de vous la couler douce... Enfin, je veux dire, de profiter de ces stations d'observation pour avoir un peu de paix dans ce monde bruyant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Alors ? Comment trouvez-vous les lieux ? C'est bien de s'y reposer, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Euh... C'est très confortable ? Le cadre est très beau et une sieste suffit à me revigorer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411331,
					"content": "Pas vrai ? Surtout lorsque l'on se réveille tranquillement sans travail urgent à faire ou qu'il n'y a personne pour surveiller nos faits et gestes. Il est donc possible de profiter du soleil et de la brise de l'après-midi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "C'est comme si on se réveillait d'un rêve et qu'on entrait dans un autre rêve dans lequel les problèmes n'existent pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411333,
					"content": "Oui ! C'est ça, la vraie vie ! Dommage que vous n'ayez pas encore essayé le thé noir en édition limitée vendu au Passage Vasari. Si vous avez l'occasion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Attendez, il n'y a rien qui va dans cette conversation !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "#Bon, suivez-nous ! C'est l'heure de dénoncer vos crimes à l'Institut de recherche de Fontaine{NON_BREAK_SPACE}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "Ahhh !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411337,
					"content": "Attendez !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "#{M#Mes deux bienfaiteurs}{F#Mes deux bienfaitrices} ! Ce monsieur n'a fait aucun mal à nos recherches hydrologiques, non ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Objectivement, il nous a même aidés à collecter des données.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "Il veut tout simplement ne pas travailler et mener une vie agréable !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "O—Oui !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411342,
					"content": "Il n'y a pas de quoi être fiers de ce comportement, même si vous le tournez de cette façon !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#S'il vous plaît, {M#monsieur}{F#mademoiselle} ! Pour le bien de la science, soyez {M#généreux}{F#généreuse} et laissez-le partir cette fois-ci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "#Je ne suis pas {M#sûr}{F#sûre} de voir le rapport avec la science...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Merci monsieur, et vous deux ! Je jure que je ne le referai plus jamais ! Désormais, je ferai de mon mieux pour éviter de travailler tout seul !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411347,
					"content": "Voilà ! J'aime votre détermination !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "Ne soyez pas aussi enthousiaste pour ça !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "Le capitaine des Fatui part en étant reconnaissant...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Bon ! Le problème est désormais complètement réglé, alors je dois rentrer pour organiser les données.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "Merci à vous deux ! Prenez ceci !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "C'est complètement réglé ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
					"content": "Bref... Les stations d'observation recommencent à fonctionner et les Fatui se sont retirés, alors je suppose que c'est bien réglé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411345,
					"content": "Puisque vous le voulez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				}
			]
		},
