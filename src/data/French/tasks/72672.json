				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "Est-ce que vous avez trouvé Wakamurasaki ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "Alors, voilà comme ça se passe avec l'Omnifilet d'ubiquité...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "Un « Omnifilet d'ubiquité »... Vous savez quoi ? Ce n'est pas si mal comme nom. Mais cette technique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "Est-ce que cette technique peut vraiment capturer une essence humaine ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Euh, non. Ce n'est pas possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Il n'y a que quelques archives à propos d'une telle technique onmyoudou. Et la pratique s'est perdue depuis longtemps dans les méandres du temps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "La technique que j'ai apprise à Wakamurasaki ne fonctionne que pour les petits animaux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Attendez, pourquoi vous ne lui avez pas dit ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Oh, ça ? Je voulais juste que Wakamurasaki m'aide à répandre la nouvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "« Le président de l'Agence de détectives Bantan Sango a demandé à quelqu'un de fabriquer un filet qui fait dire la vérité aux gens en utilisant la magie onmyoudou de Kamuna. »",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "La magie onmyoudou perdue de Kamuna, l'Agence de détectives Bantan Sango et un filet qui peut capturer l'essence de petites créatures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Mettez ces trois éléments ensemble et vous avez une légende urbaine qui est à la fois impressionnante et renferme une part de vérité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Aux yeux de la plupart des gens, ces légendes urbaines ne sont que de simples histoires... Mais pour les criminels qui ont déjà peur, ce n'est pas rien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Alors c'était donc ça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "D'un autre côté... Wakamurasaki commençait à me taper sur le système avec ses histoires de « trouver la technique onmyoudou la plus puissante au monde ! ».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Je lui ai déjà dit à de nombreuses reprises que ça n'existait pas, mais elle n'écoute pas ! Alors je n'ai pas eu le choix que de lâcher du lest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "Et si Wakamurasaki n'en parle à personne ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Im—pos—sible. Elle est incapable de garder un secret. Croyez-moi, je sais comment elle fonctionne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "#Dans tous les cas, merci d'être {M#allé}{F#allée} la voir pour moi. Prenez ceci. Considérez-le comme un dédommagement pour le déplacement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "J'espère qu'elle ne va pas revenir m'embêter avec ses histoires. Je suis détective moi... pas onmyoji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
