			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "Comment ça s'est passé ? Bien ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720402,
					"content": "Ça a été assez rapide...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Hmm... Je suppose que c'était inévitable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720404,
					"content": "Comme je l'ai dit, cette technique peut capturer l'essence d'un petit animal, mais si vous voulez conserver cette essence et recréer l'animal, il vous faut un support.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720405,
					"content": "J'ai intégré ces techniques dans le filet, de sorte qu'il serve également de moyen de rétention de l'essence et de création de la forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720406,
					"content": "Ça a l'air... compliqué...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Eh bien, en gros, chaque filet ne peut être utilisé qu'une fois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720408,
					"content": "C'est un problème que je n'ai pas non plus réussi à résoudre. Si on ne peut pas l'utiliser plusieurs fois, le coût de cet appareil va devenir faramineux...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720409,
					"content": "Je vais continuer à faire des recherches sur ce filet et essayer de résoudre ce problème au plus vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720410,
					"content": "Si vous avez besoin d'autres Omnifilets d'ubiquité, vous pouvez venir me voir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720411,
					"content": "Et puis... Bien que ces filets ne puissent attraper que des petits animaux pour le moment, leur processus de fabrication est vraiment compliqué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720412,
					"content": "Alors la prochaine fois que vous en voulez un, il y aura des « frais de production », haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720413,
					"content": "#Mais pas de panique ! Vous êtes {F#une amie}{M#un ami} de Sango, alors je vous ferai un bon prix !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				}
			]
		},
		{
			"id": 7267205,
			"completionStepIds": [
				7267205
			],
