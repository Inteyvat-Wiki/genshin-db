			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hat Guy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "We each have our own paths to walk. There's no need to say anything more. This tea is quite good, by the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Hat Guy"
				},
				{
					"id": 733560202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560204,
					"content": "Alright, goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hat Guy"
				},
				{
					"id": 733560203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
