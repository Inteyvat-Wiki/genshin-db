			"dialogs": [
				{
					"id": 733560101,
					"content": "This really is hard to believe. I never imagined I'd be sitting here drinking tea with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560102
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560102,
					"content": "Is it really that strange? I just wanted to thank you for the core processing unit you provided for the numerological array.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560103,
					"content": "And why do you keep talking like you know us inside out? You make it seem like you have a deep understanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560104,
					"content": "I told you, I'm a good judge of character.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560105
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560105,
					"content": "Still... Haha, you said it right. I shouldn't keep assuming I understand you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560106,
					"content": "Oh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560107,
					"content": "Even compared to our last meeting, I feel like you've changed a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560108,
					"content": "Hmph! It doesn't matter how far back you want to \"compare,\" the only changes I've undergone are to accept the errors in my core and open my eyes to see a few things clearly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560109,
					"content": "And what about you? As a fellow \"puppet\" of sorts, do you ever experience computational errors in your heart?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560110,
					"content": "Hah... I experience far more than just errors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560111
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560111,
					"content": "Do tell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560112,
					"content": "I don't think we know each other well enough for that just yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560113,
					"content": "Heh, have it your way. I was merely asking out of courtesy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560114,
					"content": "Regardless, it takes a good many detours before a puppet can find its heart. At least, it did for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560115,
					"content": "You seem to have a good relationship with your creator...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560116
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560116,
					"content": "I did. He gave me a lot of help and guidance, both in life... and after.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560117,
					"content": "In that regard, there's a fundamental difference between us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560118
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560118,
					"content": "...Oh. Is that so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560119,
					"content": "I'm sorry. Even though we share some similarities as puppets, I shouldn't have assumed to know anything about you based on that alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560120,
					"content": "Don't worry about it. To borrow a phrase from you, I, too, have accepted my past errors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560121,
					"content": "It's just that I've taken too many detours already. I need to walk an even longer path to make up for them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560122,
					"content": "In that case... good luck? To borrow a phrase in return, I don't know you well enough yet to give any further advice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560123,
					"content": "Haha... Well said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
