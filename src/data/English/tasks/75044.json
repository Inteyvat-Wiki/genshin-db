			"dialogs": [
				{
					"id": 750443801,
					"content": "(A work by Fontainian playwright, Jean Brooklyn. A book this thick can totally be used by shorter people to increase their height.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"History of Teyvat: Part I\""
				}
