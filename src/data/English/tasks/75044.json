			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750444701,
					"content": "(Childish, scribbled writings are visible:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "A Child's Notes"
				},
				{
					"id": 750444702,
					"content": "This game's called \"Bing Bong Ding Dong,\" and here's the rules:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "A Child's Notes"
				},
				{
					"id": 750444703,
					"content": "1. When the Bing Bong Monetoo isn't ding-donging, ride on the Saurian statue's back to make it move forward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "A Child's Notes"
				},
				{
					"id": 750444704,
					"content": "2. Get off the Saurian statue when the Bing Bong Monetoo counts down to a \"ding!\" or you'll lose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "A Child's Notes"
				},
				{
					"id": 750444705,
					"content": "3. First one to run to the Bing Bong Monetoo wins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "A Child's Notes"
				},
				{
					"id": 750444706,
					"content": "And don't give me that \"isn't this just Red Light, Green Light?\" crap. Rules are important, and it's precisely because you don't respect the rules that you can't win!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Child's Notes"
				}
			]
		}
	]
