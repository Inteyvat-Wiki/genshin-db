					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444402,
					"content": "On closer inspection, it does seem odd that the only empty jar is the one in front of this Monetoo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "Did the other Monetoo find what they were looking for but this one didn't?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Poor thing... C'mon, {NICKNAME}, let's help it find the stuff that was meant to fit in this jar... Hmm. What would that be, though?",
