			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "\"...May glory eternal be... Peacemaker... Most benevolent... Och-Kan...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "...Artisans Mahutzintl, Tlanalco, and... those responsible for the construction of the water pump... deliberately slowed down, causing delays... The benevolent... imposed no punishment... only suspended rations for three weeks...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "\"...The <color=#00E1FFFF>stone key</color> that activates the <color=#00E1FFFF>water pump mechanism</color>... is kept at... no one is allowed to use it without permission... until other artisans are assigned...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
