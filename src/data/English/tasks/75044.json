		{
			"id": 7504407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "The Soaring Saurian is open all day! If you wish to join Matahga's special training, then come lift off from the Soaring Saurian! Note:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Eye-Catching Slogan"
				},
				{
					"id": 750440702,
					"content": "Up with serious, rigorous training! Down with sloth and slacking!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Eye-Catching Slogan"
				},
				{
					"id": 750440703,
					"content": "Laze about today, and be as trash tomorrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Eye-Catching Slogan"
				},
				{
					"id": 750440704,
					"content": "Only those who push forward boldly shall truly know greatness as Saurian riders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eye-Catching Slogan"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "The code is: Blow the left horn first, then the right one, then the left again, and finally the right... but blow 'em at your own peril!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga! Remember!!!"
				},
				{
					"id": 750440802,
					"content": "Feeding a Saurian some Fowl is the best way to keep one in a good mood and avoid getting pecked!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga! Remember!!!"
				},
				{
					"id": 750440803,
					"content": "(Seems like a reminder that someone called Matahga left for themselves. You can feel the intensity of the emotion in their words.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga! Remember!!!"
				},
				{
					"id": 750440804,
					"content": "(But surely putting exclamation marks at the end of every reminder is the same as putting none... Isn't it?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga! Remember!!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "\"...By the order of the Guardian of the{RUBY#[D]Yajaw K'ahk'} Sacred Flame, and the most benevolent and glorious Holy Sov{RUBY#[D]Ti'sakhuun}ereign, His Ma{RUBY#[D]Kalomte}jesty Och-Kan, labor is now being recruited from all tribes for the construction of water conservation infrastructure...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "\"...No fixed quotas, with all being based on voluntary participation... Building the alliance... We hope all tribes will actively respond...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "\"By the order of the Guardian of the{RUBY#[D]Yajaw K'ahk'} Sacred Flame, and the most benevolent and glorious Holy Sov{RUBY#[D]Ti'sakhuun}ereign, His Ma{RUBY#[D]Kalomte}jesty Och-Kan, the cursed land is hereby sealed off, effective immediately. All members of the alliance are strictly prohibited from entering.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "\"Those who enter without authorization will be officially recognized as enemies of the alliance. This is the joint declaration of (...) Nanatzcayan, Meztli, Huitztlan, and Teteocan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "\"Glory forever unto to the Guardian of the{RUBY#[D]Yajaw K'ahk'} Sacred Flame, the Great Pe{RUBY#[D]Q'atal Tzij}acemaker the most benevolent Holy Sov{RUBY#[D]Ti'sakhuun}ereign Och-Kan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "\"Given the slow overall progress of the drainage works in this area, minor adjustments are being made to the rotation system to ensure the alliance's inexorable triumph.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "\"Workers will be divided into three teams, each team working sixteen hours, rotating every two days. Teams with exceptional performance will receive extra grain provisions.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "\"The triumphant victory of <color=#00E1FFFF>draining the accumulated water</color> is close at hand. Once the ditches are completed, the <color=#00E1FFFF>water pump</color> can operate normally. Push a little harder!\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "\"...Compatriots, family, brothers and sisters who have dedicated themselves to the alliance's inexorable triumph...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "\"...The most benevolent... has allocated a batch of new mechanisms from (...) to support transportation, (...) and <color=#00E1FFFF>underwater salvage</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "\"...Forward! Forward! Move forward at all costs... For the glorious future of the alliance, for our freedom and glory, for a homeland free from the evil dragons's oppression...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "\"...Without permission... it is forbidden to operate the <color=#00E1FFFF>control lever</color>... Accidental falls... have already caused the deaths of three workers...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "\"...There's a small trail behind a stone wall to the north that leads to the top of the waterfall. It can be used as a <color=#00E1FFFF>storage area</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "\"...I left a few marks, just in case I forget the way later...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "\"...Sayani's injuries took a turn for the worse. The humidity's to blame... I told her to rest, but she laughed it off... saying it would slow the squad down, resulting in everyone missing out on extra provisions...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "\"...Once night falls, I'll sneak up to her with a torch to cauterize her wound while the others aren't watching, or her limbs will rot, too...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
