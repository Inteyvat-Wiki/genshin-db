			"dialogs": [
				{
					"id": 750443601,
					"content": "(A romance novel written by Dorothy Leeckson. On its faded cover, a woman lies on a bed surrounded by flowers.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"Lavender Flower\""
				},
				{
					"id": 750443602,
					"content": "(After skimming through the book, you feel warm and content, but haven't gained any useful insights.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"Lavender Flower\""
				},
				{
					"id": 750443603,
					"content": "So... Was it her family's gardener or her best friend's cousin's brother-in-law?... Ugh, Paimon's head hurts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
