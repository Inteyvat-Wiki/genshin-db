					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444602,
					"content": "Ah, so this is what we're looking for — something with red in it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444603,
					"content": "Wait... Huh? The stuff we threw in is gone... We did chuck something in, right? Something doesn't feel quite right here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444604,
					"content": "Is there something else in the jar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444605,
					"content": "(Knock on the jar)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
