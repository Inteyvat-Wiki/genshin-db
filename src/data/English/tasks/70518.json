			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Bernhard"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "Wait! Honorary Knight! And Paimon, the best guide in Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180102,
					"content": "I humbly beg for your assistance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180103,
					"content": "Whoa! Did Paimon hear that right? Is Paimon finally starting to make a name for herself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180140,
					"content": "Oh, wait... haven't we met...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180104,
					"content": "Yes, in the main hall of the Knights of Favonius Headquarters.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "That's right. I am Bernhard, a member of the Logistics Company under Captain Hertha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180106,
					"content": "Normally, I would hope to become better acquainted before asking for a favor like this... but time's running out, so I really have no choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180107,
					"content": "Please help me rescue the charity event!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180108,
					"content": "\"Rescue\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "The charity event? Oh right, Master Jean mentioned that. So what's happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180110,
					"content": "Well, the Knights of Favonius wants to run a stall during the festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180111,
					"content": "The idea is for all profits from the sales to go to charity. Specifically, the funds will provide support to disadvantaged children and elderly citizens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180112,
					"content": "We drew lots to decide whose job it would be, and as it happened... I was the lucky winner. I really didn't want to screw this up, so I asked all around for advice, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180113,
					"content": "My experience is in inventory and shipping. Now I'm supposed to run a whole shop, but it took me forever just to think of what to sell... I'm already completely out of my depth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180114,
					"content": "And that is why I humbly beseech you to render your assistance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180115,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "Yeah! Also, no need to be so formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180118,
					"content": "So, you said this is to help out the kids and old folks of Mondstadt, right? Sounds like a great cause!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180119,
					"content": "#{NICKNAME} is an Honorary Knight, and Paimon's a longtime friend of Favonius. We'll be more than happy to do our part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180120,
					"content": "As Paimon says, we are happy to help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "Oh, I can't thank you enough! Right, let me get down to brass tacks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180123,
					"content": "Before we can open shop, we need to amass a supply of <color=#00E1FFFF>Fairbrew Jellies</color>. This is the basic currency that we will use when running the stall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180124,
					"content": "The wine merchants in the area are in dire need of raw ingredients for wine-making. Sell them raw ingredients, and they will pay you generously in Fairbrew Jellies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180125,
					"content": "Also, there are some international customers looking to purchase beverages in bulk during the Weinlesefest period. They're on the market for an agent to handle their purchase orders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180126,
					"content": "In the interests of establishing a long-term business relationship, these customers are usually willing to offer a generous price, and there's also room for negotiation with the wine merchants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180127,
					"content": "The price difference is ours to keep as commission, and you can cash that amount in for Fairbrew Jellies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180128,
					"content": "So to sum up, our job is to sell ingredients to the wine merchants, and place orders for international customers, making sure to negotiate the price. Right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180129,
					"content": "Sounds much easier than Paimon imagined!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180130,
					"content": "We're pretty good at this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "R—Really? Well, that's wonderful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180132,
					"content": "I have one order here with me already: A Mr. Shevirme from Sumeru wishes to purchase <color=#00E1FFFF>50 crates of Fruits of the Festival</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180133,
					"content": "These beverages can be bought from the <color=#00E1FFFF>Angel's Share's stand</color>. The shopkeeper's name is <color=#00E1FFFF>Georg</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180134,
					"content": "He's a very nice man, but he won't be pushed around. Please consider the price carefully and try to reach a good deal with Georg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180135,
					"content": "I should carry on setting up the stall now. Once you've gathered enough Fairbrew Jellies, come back here and we'll take it from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180136,
					"content": "You won't need to worry about the supplies for the shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180137,
					"content": "I'm already in contact with the suppliers, and they'll send everything over once the funds are in place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180138,
					"content": "Alright, sounds good! We'll find the funds and you sort out the shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180139,
					"content": "This is an enormous help. Thank you both ever so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180121,
					"content": "What do you need from us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "Everyone has things that they struggle with.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "Hi there, Georg. We're Shevirme's agents. He's asked us to order 50 crates of Fruits of the Festival for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180202,
					"content": "Oh? Did you say Shevirme? He's a regular customer of mine. Always orders around the same amount each time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705180203,
					"content": "But I digress — what price are you offering this year?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "#{NICKNAME}, Paimon! You're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180302,
					"content": "Hey! It's Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180303,
					"content": "Hi, Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "Thanks! And happy Weinlesefest to you, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180306,
					"content": "This festival is one of the most popular ones in Mondstadt. I'm so happy I ran into you guys here. I hope you have a great time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180307,
					"content": "Oh, also, I heard from Georg that you're collecting Fairbrew Jellies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180308,
					"content": "I'm just curious, are you helping out with the Knights of Favonius charity event?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180309,
					"content": "We sure are! Everybody's gotta do their part, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180310,
					"content": "The stall isn't up and running yet. We're busy raising funds so they can open for business!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180311,
					"content": "There's sure to be a bunch of other problems to deal with once it's open, but whatever comes up, we'll deal with it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180312,
					"content": "Wonderful! Heehee... they're lucky to have you. Now that you've joined the team, I just know it'll be a huge success!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180313,
					"content": "Thanks for your encouragement!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "I helped out at a small charity sale for the Knights once, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180315,
					"content": "Although... my only contribution was standing out front and singing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180316,
					"content": "Oh! And I also met the bard, Venti there! He even persuaded me to perform an impromptu song with him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180317,
					"content": "The music he plays is quite refined and elegant. At first, I didn't want to sing too loudly, in case I ruined the style he was going for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180318,
					"content": "But he sang a harmony to guide me in, and before long, we were sounding great.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180319,
					"content": "In the end, the audience loved it, and we sold a lot at the event.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180320,
					"content": "So Barbara's worked with the Tone-Deaf Bard before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180321,
					"content": "I wish I could have been there to hear it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "Yeah... too bad we couldn't fit it into the schedule this year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180323,
					"content": "The Church of Favonius wants to hold a sung poetry event somewhere with a nice view during the festival, which means I have to go to rehearsal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180324,
					"content": "Go do what you have to do, it's alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "Yup, sounds like we've each got our own important work to do. Let's give it our all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180327,
					"content": "Thank you both! Well, maybe I can't stay here and sing, but I still wanna do a little something to contribute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180328,
					"content": "I can, um... I can help promote your stall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180329,
					"content": "Hmm... Should I make some big posters? Or maybe some flyers to hand out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180330,
					"content": "I'll have to pick a memorable slogan, too! And maybe it'll seem more sincere if I sign them...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180331,
					"content": "Then again, maybe telling people in person would be more effective...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180332,
					"content": "Wow, with Barbara helping out on the marketing side, this charity event will get loads more attention!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180333,
					"content": "Sounds like a lot of effort...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "It's fine, really! It won't take me too long. Now I feel a little embarrassed, heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180336,
					"content": "#Let me think about it a little more and talk to some other people about their marketing experience! {NICKNAME}, Paimon, I'll see you later~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180337,
					"content": "And, um... the Knights and the Church of Favonius are really proud of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180338,
					"content": "Aww, thanks! We'll do our best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180339,
					"content": "#Paimon's even more motivated than ever now! {NICKNAME}, we gotta make sure we do a really great job here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180334,
					"content": "You have so much on your plate already.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "We'll take care of the charity event.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "Happy Weinlesefest!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
