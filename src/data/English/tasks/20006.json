					"nextDialogs": [
						200060402
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060402,
					"content": "You're back! Did the delivery go okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060403,
					"content": "Here's the fee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "Let me check... Yep! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060405,
					"content": "Here, this <color=#00E1FFFF>Delicious Crab, Ham & Veggie Bake</color> is for you. It's fresh out of the oven, eat it while it's hot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
