				"objectNames": [
					"Lively Orlean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "Thanks! Ugh, these slimes are such a pain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Lively Orlean"
				},
				{
					"id": 200060202,
					"content": "If I hadn't had such low blood sugar, I'd have taught them a lesson myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Lively Orlean"
				},
				{
					"id": 200060203,
					"content": "Your meal, ma'am.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Mmm... Smells carroty and meaty... It's a shame it didn't get here sooner, I would have sent those slimes flying if I'd been fighting on a full stomach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Lively Orlean"
				},
				{
					"id": 200060205,
					"content": "Can't be helped I suppose. Here's the money, take it back to Sara for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lively Orlean"
				}
			]
		},
