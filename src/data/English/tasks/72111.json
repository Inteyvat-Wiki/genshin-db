					"nextDialogs": [
						721110302,
						721110304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110302,
					"content": "Downstream of the gully.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110306,
					"content": "How can you prove that these two items are related?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110307,
					"content": "Oh, they're related alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110308,
					"content": "Ridiculous! How can that be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "Unless... there's some kind of secret code on the Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "There's nothing on the Mora, but we did find something elsewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "We found this near the remains of a cart...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "We found it on the tree branches at the entrance to the village.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "How could that be... You'll get nowhere, testing me like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
