			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110601,
					"content": "What is this? I can't read it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110602
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110602,
					"content": "Don't you try to fool me with some random things, youngster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110603
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110603,
					"content": "We found this near the remains of a cart...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211107,
			"completionStepIds": [
				7211107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
