						],
						"stepId": 7211101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211102",
							"3"
						],
						"stepId": 7211102,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211103",
							"3"
						],
						"stepId": 7211103,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211107",
							"2"
						],
						"stepId": 7211107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "This is... This is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "I can't believe that I was so careless when I was damaging the cart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "Hey now, you finally admitted it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "Since you have already gotten this far in your investigation, there's nothing for it. I can't hide it anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "In that case, you should have a pretty good idea of what happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "A very good idea indeed! Grandpa Densuke, you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Tried to rob a Shogunate cart, didn't you? And in the midst of the struggle, you destroyed the cart with a single punch, causing the goods to go flying into the gully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "Hoping to save themselves, the Shogunate's people threw their coin pouches into the well to distract you! And then, you locked the well up to prevent others from stealing the Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "Is that right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Ah? No, that's not what happened at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Really? Paimon was gonna ask for your key and to have that Mora at the bottom of the well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "...Surrendered to the Shogunate! That's right! They were definitely going to be surrendered to the Shogunate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "*sigh* Well, this is what actually happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "There was originally a group of young people in the village who got too bold after getting drunk, and actually robbed one of the Shogunate's cargo carts. These goods and the bag both belong to the Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "I couldn't let others know that this shameful incident occurred in our village. That's why I tried to cover it up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "What about your confession regarding the coin pouch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "He did that to cover up the truth.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "That's right. I thought that you would stop the investigation once I confessed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "If it was just me... As long as no one else was affected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "Please don't report this to the Shogunate. This isn't about me saving face. I just don't want the entire village to be dragged down in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "I'm not interested in reporting you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Yeah, that's not why we came here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "Oh, thank goodness! Thank goodness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "My conscience kept bothering me because of this cover-up, so I recorded everything in a diary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "I threw the diary onto the roof. If you really want to read it, help yourself, but please don't ruin my recently renovated roof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "About the lock on the well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Yes, it was me who locked the well up. I also wrote down where I hid the key. Go read for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Grandpa Densuke, do you know anything about the Konda Village barrier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "Barrier? Oh, so people still know about that old legend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "They say that in ancient times, underneath the ground we are standing on right now, lay the roots of the Thunder Sakura. Indeed, this was one of the five roots that protect the peace on Narukami Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "And guarding it and its barrier was said to be a responsibility assigned to us, the Konda Clan, by the Kitsune Saiguu herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "But this was a long, long time ago. I hardly recall anything about the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "I just want to know the truth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Yeah, we didn't come here to report you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "The truth? Hehe... You young people these days are so interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
