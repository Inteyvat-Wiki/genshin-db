			"dialogs": [
				{
					"id": 100031301,
					"content": "That's right. Just channel Mr. Nine. How would he write this particular essay, hmm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031302
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 100031302,
					"content": "Hey, Chang the Ninth! We have something for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100031303,
					"content": "Oh? What is—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031304
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 100031304,
					"content": "What? Where did all this Mora come from!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031305
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 100031305,
					"content": "About that... So, um, the thing is... Right! Mr. Nine really admires your work, so he decided to fund your writing career!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100031306,
					"content": "Wait, what? So... channeling Mr. Nine actually worked!? I can't believe it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031307
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 100031307,
					"content": "Of course, for Chang the Ninth, wealth pales in comparison to his craft. The matter of Mora is swiftly forgotten as he puts pen back to paper. \\n\\nThus, you continue on back to Mondstadt...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
