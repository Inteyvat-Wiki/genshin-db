			"dialogs": [
				{
					"id": 740820701,
					"content": "A glittering pearl of water appears on the altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "Um, that drop of water... That can't be the treasure, can it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820703,
					"content": "It doesn't look like treasure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "That's what Paimon thought. It can't be that easy. But what is it, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820705,
					"content": "Maybe it is key to containing the Demon King.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "What? But that means catastrophe! Quick, put it back. Paimon hopes we're not too late!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820707,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820708,
					"content": "Oh no! It's the Demon King!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820709,
					"content": "The Demon King? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820715,
					"content": "Gah, you gave Paimon a fright there... A Melusine, huh? What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820716,
					"content": "Key.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820717,
					"content": "Key? What key? Is this drop of water a key?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820718,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820719,
					"content": "Err... The drop of water is Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820720,
					"content": "Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820721,
					"content": "Ugh! What do you mean? Is the drop of water a Melusine? Paimon's getting dizzy. What on earth is this? Aren't you the Melusine here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820722,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820723,
					"content": "Err... You're a Pahsiv? Or is your name Pahsiv? Wait... No, don't answer. You'll just make Paimon dizzier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820724,
					"content": "Anyway, Paimon's decided to call you Pahsiv. Is that okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820725,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}... What should we do? Paimon can't understand a thing she's saying. What is she trying to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820727,
					"content": "You can understand what we're saying, can't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820729,
					"content": "This drop of water is a key, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820731,
					"content": "You're not a human, are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820733,
					"content": "Er... Let's not be rude all of a sudden, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820734,
					"content": "I'm not a human, am I?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "M—Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820736,
					"content": "Oh! Wait! Paimon thinks she's starting to understand. \"Pahsiv\" is yes and \"Melusine\" is no. Could that be it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820738,
					"content": "So you're not called Pahsiv. Sorry, Paimon got your name wrong earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820739,
					"content": "Pahsiv... likes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820740,
					"content": "You like the name?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820742,
					"content": "#Wonderful! Then that's what Paimon's gonna call you, hehe. This is {NICKNAME}. We're glad to meet you, Pahsiv. Paimon's never met a Melusine like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820743,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820744,
					"content": "Erinnyes... Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820745,
					"content": "...So you mean Erinn-no? Or... Err...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820746,
					"content": "Something wrong with Erinnyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Erinnyes, Melusine, now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820748,
					"content": "Pahsiv, Erinnyes, protect...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820749,
					"content": "So, something bad is happening to Erinnyes, and you want to protect it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820750,
					"content": "#Paimon, {NICKNAME}, Erinnyes, ka-pow, ka-pow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820751,
					"content": "#Err... So that's five words now. So... you want Paimon and {NICKNAME} to punch Erinnyes? Like KA-POW?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820752,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820753,
					"content": "You want us to help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820755,
					"content": "Okay, so she wants help from us. That's good. Paimon didn't know how we could punch Erinnyes, with it being a whole island and all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820756,
					"content": "Ka-pow, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820757,
					"content": "Will there be any rewards?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "Re... ward?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820759,
					"content": "#Oh come on, {NICKNAME}! Pahsiv can barely talk! She won't be able to find anyone else to help her, so we should just do it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820760,
					"content": "What do we need to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "Key, key, key, number.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820763,
					"content": "And then? How many keys is that, now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820764,
					"content": "Key! Key! Key!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820765,
					"content": "Three keys?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Pahsiv! Key, foggy path, south...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820767,
					"content": "Key, spring, north...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820768,
					"content": "Key, willow, east...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820769,
					"content": "Oh, that's what you mean... Let's make a note real quick... Three keys in total, one in the southern foggy road, one in the northern spring, and one in the eastern willows... Is Paimon right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820770,
					"content": "Key, key, key, square, west.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820771,
					"content": "And there are three keys in the square to the west?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820772,
					"content": "Collect three keys and go to the square?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820774,
					"content": "#Oh c'mon, Pahsiv, do you have to always make it sound like {NICKNAME} is cleverer than Paimon? We're clearly of more or less equal intellect!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820775,
					"content": "Anyway, we've already got one key, so all we need to do is find the remaining two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820776,
					"content": "Erinnyes, Melusine... Pahsiv, protect!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820777,
					"content": "Relax. Paimon doesn't know what's happened, but we're going to help you protect Erinnyes for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820778,
					"content": "But if Paimon could add one small point, Pahsiv, Paimon would like to say that if you happen to see anything shiny, round, and unwanted, or some expensive-looking chest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820779,
					"content": "Well, it would be just wonderful if you could let us know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv scratches her head as she tries to understand, then gives two more happy jumps and leaves in a bit of a hurry.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#Oh, she ran straight off. Guess she must have something really urgent to work on. {NICKNAME}, shall we go looking for those two keys now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820761,
					"content": "What do we need to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "Maybe someone else put it here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "What? Oh no, that makes us thieves. Ohh, Paimon's sorry... Let's put it back, quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820712,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820713,
					"content": "Oh no! The boss is back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820714,
					"content": "The boss? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				}
			]
		},
