			"dialogs": [
				{
					"id": 740820401,
					"content": "(Most of the inscription has been scratched out, but you can make out \"...clear dew... three...\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Mysterious Altar"
				},
				{
					"id": 740820402,
					"content": "Ugh! The words here have been scratched out too! Someone must be hiding something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "\"Clear dew\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "What does clear dew represent? Crystal clear dew? But there's water all over the place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "As for the word three, does that represent three drops of water? Ugh, this is such a headache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Come on, Paimon, let's ask your super keen treasure-detecting senses!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Paimon's done that! A—Anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Anyway, it says the answer is linked to three and water, so let's look around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Three?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Does it represent three things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "And as for clear dew, does it represent crystal clear dew? But there's water all over the place! Ugh, this is such a headache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
