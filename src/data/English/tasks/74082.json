				{
					"id": 740820901,
					"content": "A glittering pearl of water appears on the altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820902
					]
				},
				{
					"id": 740820902,
					"content": "Awesome! Now, we have the third key.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820903,
					"content": "Key, key, key!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820904
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820904,
					"content": "Disappeared, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820905
					]
				},
				{
					"id": 740820905,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Key, key, key!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820906,
					"content": "Square, west!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820907,
					"content": "Hehe. Is this what you're trying to say? Don't worry, we're going there now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
