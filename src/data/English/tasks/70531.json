				"points": []
			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "Please wait! Are you also here for the King of Invokations Grand Prix?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "If you have a minute, I'd like to tell you a little about this event hosted by the Adventurers' Guild called \"A Tour of Wonders.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Um... sure?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Thank you! Then I'll go ahead and introduce the basics of this event.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "Simply put, the Adventurers' Guild has placed multiple Scenic Checkpoints in various locations across Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "All you have to do is find these Scenic Checkpoints and mark your Sightseeing Handbook with the commemorative stamps at each location.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "The challenge will be considered completed once you find every Scenic Checkpoint and collect all the stamps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Sure sounds like something the Adventurers' Guild would host.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Hehe... We put a lot of thought into the placement of these Scenic Checkpoints.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "However... some of them are located in remote areas, and I can't guarantee they're entirely clear of monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "But I'm sure that dealing with those monsters would be a walk in the park for someone as experienced as you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "And that's all from me! Here's your Sightseeing Handbook. Have fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Okay, let's hear it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}