			"dialogs": [
				{
					"id": 732572901,
					"content": "Done. The path to the depths has opened, and our mission is completed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572902
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572902,
					"content": "Huh, that was quick. You kept talking about \"rite\" and stuff, so Paimon thought it'd take a whole bunch of complicated incantations to conduct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "Hmph, only humans need such things, as they can't even wield the power of the elements on their own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "We Pari are different, for our power and that of the Khvarena hail from the same source. It's like how you humans don't need to recite incantations to walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Um... Although you don't walk, you float.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572906,
					"content": "Like Paimon said, your logic is weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572907,
					"content": "Anyway, let's not waste our time on this irrelevant topic. I'll leave what's next up to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572908
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572908,
					"content": "\"May the eternal Khvarena guide us on the upward path.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
