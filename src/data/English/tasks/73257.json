						732571702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571702,
					"content": "It seems that some flowers have grown on the tree. But what do we do next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571703,
					"content": "Ah, don't look at me. I'm as clueless as you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571704
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571704,
					"content": "Now that Sorush has already put on the Twin-Horned Chaplet, she can connect to the memories and wisdom of the Harvisptokhm using the Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571705
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571705,
					"content": "Give it a try, Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571706
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571706,
					"content": "I know, but I'm not yet used to the Chaplet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571707,
					"content": "Um... I think I see new shoots sprouting, but the filth hasn't been fully cleansed yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571708
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571708,
					"content": "We still need to purify these flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571709,
					"content": "Then the pure power of Khvarena will thrive again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
