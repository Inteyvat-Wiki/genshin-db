					"nextDialogs": [
						732573002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732573002,
					"content": "These trees were originally cultivated with Khvarena to resist the corrosion of the cataclysm. It's just that their power has ebbed away with the passage of time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573003
					],
					"speakerTitle": "Mihir"
				},
				{
