	"talks": [
		{
			"id": 1104501,
			"completionStepIds": [
				1104501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104501",
							"2"
						],
						"stepId": 1104501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "I imagine you must have encountered more than a few conundrums during your travels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450102,
					"content": "I'd like to observe your intelligence by means of a practical test of your capabilities — much as we did for the physical test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450103,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "I'd like you to explore these ruins and return with your findings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450106,
					"content": "There are two puzzles located at the far ends of the ruins. After completion, you should be able to activate the mechanism in the center.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450107,
					"content": "As with the physical test, there are no restrictions. Everything you do is an action I wish to observe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450108,
					"content": "I'm getting good at these.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "A tried and tested adventurer I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450112,
					"content": "So, let's see you in action. Start wherever you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450110,
					"content": "Where there's a will, there's a way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "Remember that this is a test of intellect. So should you get lucky in any way, that won't be factored in as part of the test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450104,
					"content": "Wouldn't a written test suffice...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "What's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450462,
					"content": "Unfamiliar patterns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "To the best of my knowledge, these belong to a script of some kind. They can be found all over Teyvat, but they've never given up their secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450402,
					"content": "There's still a lot to learn about them, and as for why they should ever have come to rest here... A true mystery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450403,
					"content": "Let me make a copy first. I'll make time to go over them in greater detail after our research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450404,
					"content": "*sigh* Another thing for the \"don't understand\" list. Unsolvable mystery this, weird experiment that... It'd be nice to get some cool results for once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450405,
					"content": "Seems like if you want the reward, you gotta pay the price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450406,
					"content": "I've truly gained a lot from all this. Comparatively, the little reward I can offer is too small to mention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450407,
					"content": "Let me return to the campsite first. By the time you get back, I may just have a fleeting miracle for you to witness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450408,
					"content": "See you soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "Paimon's kinda looking forward to seeing the result of all this brain ache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450411,
					"content": "Unless you can think of anything better to do, let's head back to the campsite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450413,
					"content": "Not so fast. You're not leaving until I'm convinced that nothing dangerous is going on here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450414,
					"content": "Wah! You! You didn't leave the mountain!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450415,
					"content": "I most certainly did not. And I've witnessed everything that you and Albedo have been up to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450416,
					"content": "I must say, you let your guards down. Or maybe you were drawn in by his compelling-sounding hypothesis and friendly demeanor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450417,
					"content": "What do you mean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Taking orders from a complete stranger, drinking anonymous potions, participating in all kinds of strange experiments?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450420,
					"content": "I'd sooner believe you were tricked than that you would be so naive. Or perhaps... you were colluding from the beginning?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450421,
					"content": "Sister Rosaria's guard's so high, she can't even see over the top of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450422,
					"content": "I was just helping him with his research.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "It doesn't matter what you think, he could be a saint for all you know. But I understand him a little better than you, Outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450425,
					"content": "I'm only concerned with one thing: whether his alchemy has transformed you into something more sinister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450426,
					"content": "No way! Paimon would've sensed it. And anyway, he didn't even use any alchemy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450427,
					"content": "With an alchemist of his level, you wouldn't sense a thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450428,
					"content": "In any case, I'm not about to let a potential threat back into Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450429,
					"content": "So, what're you gonna do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450430,
					"content": "You came here to be sure, so you must have your ways of assuring yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "I've gotta hand it to you, you have your moments. If I can be sure that nothing you came into contact with is dangerous, that's good enough for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450432,
					"content": "I've investigated everything else. The only items left on the agenda are these symbols.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450433,
					"content": "But we don't even know what they mean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450451,
					"content": "Hmm... That much is true, not to mention... Seems like there's nothing more to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450452,
					"content": "But for insurance purposes, I'd better make a copy... Hmm. This is now a location of interest — regular patrols should be set up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450434,
					"content": "Now then. All things considered, I deem that you pose no immediate threat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450435,
					"content": "Which is what I was hoping. I would have been one very unhappy Sister if you'd made me work overtime on your account.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450436,
					"content": "...Overtime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450437,
					"content": "Before we go our separate ways, Outlander, a word of advice. Don't be so quick to trust Albedo, and don't repeat the same mistakes that you did this time. You made a lot of rash decisions today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450439,
					"content": "She's gone. So stubborn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450440,
					"content": "Mondstadt doesn't have many people like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450441,
					"content": "Maybe she just lacks security.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Huh, never mind her. Let's go see Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450442,
					"content": "Maybe she's just sensitive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "I don't think he's a bad person.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "He has ulterior motives?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "(I take it I passed the intelligence test.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "I feel like I've seen these before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "You're back! Good timing, I've just about reached a conclusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "You took quite a while. Did you get held up on the way back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Not really.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Time for the results. We got a myriad of data today, and it was very difficult to finish all the research in one go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "But the integral preliminary conclusion that I can offer you is... You're very much like a human from this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "You couldn't tell that just by looking?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "We spent all day working our butts off for that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Please, I understand that this may have seemed self-evident to you, but in fact nothing in this world should be taken for granted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Have you ever considered that the world of Teyvat may have a natural hostility to outlanders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Only the gods would know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "I mentioned the natural laws of this world. You're able to converse with me here without consequence, and nothing seems amiss. But it's arguably a small miracle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "The only other life form that, like you, has come here from afar, is the seed that I mentioned. Under the effects of Teyvat's natural laws, it isn't even able to sprout, let alone bloom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "But after I observed you, I had another idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "Imitating you helped to inspire my alchemy, and so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Whoa! It looks like — something's appearing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "The transition from nothing into something, from shoot to stem... And now to fruition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Is not nurturing otherworldly life also nurturing the world itself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "Aww...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "It was beautiful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "*sigh* It would seem that that's as far as we go. A transient bloom of incomparable beauty... Life's proudest achievement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Paimon thought, with all our efforts, it might have bloomed forever. And it didn't even have any fruit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "Life is a manifold tapestry of free entities, its value shouldn't derive from how long it stays with us. Even a momentary burst is precious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "A short life can be well-lived. A life lived efficiently, lived to perfection, is necessarily one unburdened by loneliness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "So, do you understand what I meant about us conversing here arguably being a small miracle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Well, I haven't withered just yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "Eh? Things feel a little heavy right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Hehehe, don't be sad, {NICKNAME}, you've got Paimon to look after you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Albedo, Paimon really wants to be your friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "...Thank you both. Even if dispelling loneliness is not essential for life, it certainly doesn't hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#Your help inspired me to discover the means to make a flower bloom, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "So I'm a helpful specimen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "I mean that the time that I've spent traveling with you in the mountains was a valuable journey for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450540,
					"content": "In the future... If the need arises... Can I solicit your help again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450541,
					"content": "Sure, even if you just want some company, find me anytime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "Well... Glad I can count on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450544,
					"content": "#I made a point throughout of telling {M#him}{F#her} how ordinary the results were...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450545,
					"content": "But what was that sediment I saw forming at the bottom of the vial? It should not have been there... What could it mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450546,
					"content": "Those born of earth are bound by its imperfections, but those born of chalk are free of impurities... You and I are alike, both composed of a substance that has yet to be fully defined...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450547,
					"content": "If one day, I lose control... destroy Mondstadt... destroy everything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450548,
					"content": "Can I rely on you to stop me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450532,
					"content": "#(I wonder how my {F#brother}{M#sister} is...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "It was so short-lived.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "Perhaps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "That's it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "Quite literally, by a sister no less.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "Aha, I wouldn't worry, she's just doing her job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "Sorry, there's been a lot of issues with the research, many of the inferences I collated just don't tally with the data from the experiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450622,
					"content": "On the other hand, some of the conclusions that Albedo derived from his own intuition have been borne out by the facts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450623,
					"content": "I'm just glad that we've seen some progress, so uh... No reason to be dejected! Albedo said I did a good job!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450624,
					"content": "If you want to hear the results in detail, you'd be better talking to him. I've got work to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}