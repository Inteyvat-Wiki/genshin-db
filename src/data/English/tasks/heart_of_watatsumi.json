			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490302,
					"content": "Miss Tsuyuko...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "Oh— Sorry, I was quite lost in thought just then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490304,
					"content": "Thanks to your help, we have the Key of the Moon-bathed Deep in hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490305,
					"content": "The Key of the Moon-shaved what now? ...And what is that, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490306,
					"content": "Haha, just call it the \"Key of the Deep.\" We're not going to insist that outlanders use all the proper names for every last thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490307,
					"content": "This is something we will need to open the entrance to Enkanomiya. It was forged from the very spilled blood of our Omikami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490308,
					"content": "...Or at least, that's what the legends say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490309,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490310,
					"content": "Curiouser and curiouser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "Haha! It isn't mysterious at all! In fact, it's just the opposite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490312,
					"content": "Well, now we just need to report to the Divine Priestess, await her approval, and then wait for the spirit vein flow to be correct...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490313,
					"content": "And then, we can head down to Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490314,
					"content": "Wait, then what did we do all this for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490315,
					"content": "Well, it's not as if you gained nothing during this journey, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490316,
					"content": "I mean... You've secured the lasting friendship of the Sangonomiya Shrine! Watatsumi Island will welcome you back any time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490317,
					"content": "How about something a bit more concrete than that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490319,
					"content": "The records do say that the Spirit Pearls will answer the summons of someone pure, and that the Key will only come together for one whose heart is as clear as the waters themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490320,
					"content": "I don't generally believe what those texts say, but I do believe that you can turn Watatsumi Island's situation around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490321,
					"content": "Well then, when the time comes to go down to Enkanomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490322,
					"content": "We'll meet again then, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "Well then, see you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490323,
					"content": "You'll draw another fortune slip?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "Hehe, my fortune slip luck is pretty good. I'm certain that we'll meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
