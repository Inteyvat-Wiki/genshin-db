			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#Welcome back, {NICKNAME}. Is there something I can do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490202,
					"content": "So, about your commission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "We got the four Spirit Pearls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490204,
					"content": "Is that so? I knew I could count on you, thank you very much! Then, we are only one step away from unlocking the final seal of the \"heart.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490205,
					"content": "Sorry, I have to ask you both to come along with me — I hope you don't mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490206,
					"content": "#Since we're already here, a little more's no biggie! Right, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490207,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "There's no time to lose. Let's head off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490208,
					"content": "I'm fine with it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
			"completionStepIds": [
				7214906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214905",
							"3"
						],
						"stepId": 7214905,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
