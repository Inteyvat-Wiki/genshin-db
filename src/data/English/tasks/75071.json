			"dialogs": [
				{
					"id": 750711101,
					"content": "Have you noticed? Our little fellow seems to have taken note of something... Family, perhaps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711102,
					"content": "It's heading over on its own! Come now, let's follow — we can't afford to lose it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
