				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "After having experienced the land of the absentee archon, Traveler, how does it feel to know that our archon and adepti are here all around you in Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "I prefer the atmosphere in Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "I see, so you're that sort of person. It's not a bad thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "But I suppose you have yet to experience the substance of Liyue's three thousand and seven hundred years of divinity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "Organizing the Rite of Parting should prove to be an enlightening part of your travels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "Liyue is the most prosperous of the seven nations, defended by deities and ruled by the Qixing. As such, the diplomatic maneuverings of the Fatui have gained no purchase here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Ningguang of the Qixing has always been on her guard against the Fatui. That is in all likelihood why Childe wants to make use of the Wangsheng Funeral Parlor's connections.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Huh... what would Childe get out of us doing the Rite of Parting anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "I neither know nor do I wish to know. As far as I am concerned, the Fatui are merely financial sponsors. I only wish for Liyue's traditions to endure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli hands the player a bag of money)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "These are the advance funds that Childe has provided. If you use them up, you can go to him to apply for any subsequent funding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "Well then, let us be off. The first step in our preparations shall be to obtain some prize <color=#00E1FFFF>Noctilucous Jade</color> worthy of a deity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Liyue is the better place.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "Indeed. The weight of three thousand and seven hundred years' worth of history runs deepest in the true divinity of Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
