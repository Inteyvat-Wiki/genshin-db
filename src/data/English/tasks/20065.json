			"dialogs": [
				{
					"id": 200650201,
					"content": "How are you getting along? Had a eureka moment yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650202,
					"content": "Still thinking it over...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650203
					]
				},
				{
					"id": 200650203,
					"content": "Huh. I've met a few other Adventurers before. They were the same way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650204,
					"content": "They fight monsters like pros, but they're hopelessly lost when it comes to trying to break a few wooden sticks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650205,
					"content": "And they reinforce the wood like it's for building a storm shelter or something... Way overestimating their own strength.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650206,
					"content": "If they want a challenge so desperately, why don't they just go off into the wilderness and pick a fight with the biggest monster they can find?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
