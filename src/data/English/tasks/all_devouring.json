			"trigger": {
				"objectNames": [
					"Skirk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365001,
					"content": "He'll know something about Master, I'm sure of it... Next time, I need to be ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "How's the shoulder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "Fine. It was just a scratch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "It'll take time to recover my strength, of course, but adapting to situations like this is nothing new for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "Your outfit looks different...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "Oh, this? It's a \"Starcrystal Suit.\" Abyssal energy is scarce in Teyvat. Wearing this helps me access it more freely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "It stores concentrated Abyssal energy that I can draw from on the go. When the energy runs out, it reverts back to its original form.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Let's go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "Ah, found somewhere to rest? Well, lead the way then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
		{
			"id": 1503651,
