				"objectNames": [
					"Baizhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "#You look much better, {NICKNAME}. Should I take it that your health issues are resolved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Hm, your case was a tricky one. Seems slightly too early to celebrate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "Very true, Changsheng. Further observation is in order, I think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365104,
					"content": "We haven't had many patients recently, so we have several vacant rooms. Feel free to stay a few more days if you need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365105,
					"content": "Awesome! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}