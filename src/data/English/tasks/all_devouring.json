			},
			"dialogs": [
				{
					"id": 150360101,
					"content": "Wait... This is near The Chasm, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360102,
					"content": "Yes. If we enter from here, we'll be able to reach that place from your dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360103,
					"content": "You have some experience with Abyssal domains by now, but still, this is someone else's territory. Best to proceed with caution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360104,
					"content": "Don't worry! Paimon's an expert at hiding behind other people for safety!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360105,
					"content": "#Oh, but, uh... That means you need to stay safe, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360106,
					"content": "I will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "Alright. Remember your training. Time to put it to use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360107,
					"content": "Let's teach this thief a lesson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
		{
			"id": 1503602,
