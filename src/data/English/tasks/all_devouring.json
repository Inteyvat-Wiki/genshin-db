			"trigger": {
				"objectNames": [
					"Skirk"
				],
				"points": [
					{
						"sceneId": 20272,
						"position": [
							4605.405,
							-0.626,
							-180.467
						],
						"pointId": 49
					},
					{
						"sceneId": 20272,
						"position": [
							4604.115,
							-0.626,
							-180.605
						],
						"pointId": 50
					},
					{
						"sceneId": 20272,
						"position": [
							4606.537,
							-0.626,
							-180.436
						],
						"pointId": 51
					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Oh... Looks like this is a dead end. Did we make it to his hiding place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "Ugh, this fog is making it impossible to see anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "#This should be the place where you were attacked, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "The missing part of your soul should be nearby. Can you sense where it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(If I close my eyes and focus on the light that came from my wound back then... Yes, I can sense something, and it is nearby. But I can't tell the exact location.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Nothing exact...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "Hmm. Our opponent must have covered his tracks just in case. Otherwise, you should have sensed it much more strongly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Hold on, look! The spikes are back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Stay calm. Let's hold back a little, give our enemy some wiggle room so we can see what we're dealing with. If we're too reckless, we might be playing right into his hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "Our enemy took part of your soul for a reason — it's likely he integrated it into his attacks somehow. If we're smart about this, we can track it down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "But, I know it's nearby.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
		{
			"id": 1503603,
