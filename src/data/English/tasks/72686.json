			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasuhiko Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "Might I ask for your name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860102,
					"content": "#I'm {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "Good, I've written it down. May I ask if you are willing to put your honor as a warrior on the line?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860104,
					"content": "Wait, what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "Mm? Are you not, then, a warrior who has come forth to take part in this contest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860107,
					"content": "Never heard of such a thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "Have you not heard of the \"Clash of Lone Blades\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860109,
					"content": "That can't be, I should have put up notices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860110,
					"content": "Where did you put them up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860111,
					"content": "Here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860112,
					"content": "C'mon, that's no use at all! No one's gonna see that, much less come over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860113,
					"content": "Hmph! This is all the Yashiro Commission's fault, what with their \"no weapons or fighting during the Irodori Festival\" nonsense. I applied to organize duels on Ritou, but they refused, and wouldn't let me put up advertisements, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860114,
					"content": "So I could only put the arena here and place the sign nearby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860115,
					"content": "That said, we have already had 4 applicants. If we also include you, that makes 5.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860116,
					"content": "#Huh, so people actually joined. That's odd. Speaking of which, Paimon can't quite remember why you came here either, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860117,
					"content": "The way I see it, you were able to find this place without any prior hints. This must mean that you are a warrior with a formidable spirit indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860118,
					"content": "Those who hanker after martial prowess will always be attracted to one another. This is the way of the world — and there is little need to be surprised by it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860119,
					"content": "Paimon has no idea what world you live in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860120,
					"content": "Hehe. But still, would you be willing to take part?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860121,
					"content": "If you can defeat each of the four challengers, you will receive a reward, as a matter of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860122,
					"content": "I'll give it some consideration.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "Well then, please do take your time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860105,
					"content": "Oh, no, no, have a nice day.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}