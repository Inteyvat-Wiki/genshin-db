				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001501,
					"content": "Oh, you're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001502
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001502,
					"content": "Back with the meat, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "Oh, that's great! Wait... what about Schuster? He isn't in trouble, is he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001504,
					"content": "No, he should be alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "That's good. It's good that nothing serious happened. Once I've finished this dish, I should bring him a serving too, I think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001506,
					"content": "Speaking of that, this Chilled Meat really is different from normal meat. Perhaps a dish made from it really will have that certain... boom shaka-laka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001507,
					"content": "Still, I think that Dandelion Seeds will be needed to make something that bears the \"taste of the wind.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001508,
					"content": "But if we only do that, I feel that the result wouldn't be much different from any normal meat-based cuisine. We need some sort of decisive condiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001509,
					"content": "Oh right! That's it! In truth, I've actually met Xiangling a few more times since our contest, and I heard about a dish known as Mushroom Slime Stew from her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001510,
					"content": "I've never used such strange and curious ingredients before... However, amazing dishes require equally unique ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001511,
					"content": "Traveler, if I might trouble you again, could you help me look for some Slime Condensate and some Dandelion Seeds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001512,
					"content": "Sure thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "Great, I'm counting on you, then. I'll continue to ponder my recipe here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
