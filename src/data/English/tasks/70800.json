			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "Is something wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Actually, I was planning to create a new dish based on the theme of the Windblume Festival — specifically, the \"taste of the wind,\" and I'm currently preparing the necessary ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000203,
					"content": "I commissioned Allan to help me go to Brightcrown Canyon to hunt for the freshest meat, but he hasn't returned yet, even after so long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000204,
					"content": "At this rate, my ingredients won't be fresh any longer. Could you help me go to Brightcrown Canyon to see what the situation's like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000205,
					"content": "I've got you covered.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Thanks! I'll let you try out my new dish once you return!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080006",
							"2"
						],
						"stepId": 7080006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "I... I'm saved... Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000602,
					"content": "I never thought that hunting one forest boar could get this hairy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000603,
					"content": "So, about the ingredients Brook wants...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "Oh, did Brook send you? Well, I do have the fresh Raw Meat she wants with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000605,
					"content": "But I got careless while pursuing the boar and alerted the nearby monsters by mistake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000606,
					"content": "I got what I came for, but I was also surrounded by monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000607,
					"content": "Could you deliver the meat to Brook, Traveler? I need to go into the city and get my wounds treated at the Cathedral first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000608,
					"content": "*sigh* Ah, Draff is going to give me an earful again, I just know it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080007",
							"2"
						],
						"stepId": 7080007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "Ah, you're back. Have you brought the Raw Meat with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000702,
					"content": "Got it right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Hmm, let me see... It does seem very fresh indeed. I think this will do. This meat will serve as our main ingredient... Now we just need some condiment that brings out the \"taste of the wind\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000704,
					"content": "And when we're talking about that... We can only be speaking of \"Dandelion Seeds.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000705,
					"content": "Could you help me gather some Dandelion Seeds, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000706,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Great! I'll leave it to you then. I'm going to prepare this meat in the meantime. Once you've gathered those Dandelion Seeds, just bring them straight back to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
