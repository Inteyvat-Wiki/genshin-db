			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001001,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "You're... Oh, I remember you. You were Xiangling's assistant, weren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001003,
					"content": "The memories of our culinary duel are still fresh in my mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001004,
					"content": "I may have lost to her the last time, but this time, I will create a dish that has the \"taste of the wind.\" Then I'll take it and ask her for a rematch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001005,
					"content": "I specially commissioned an adventurer to help me go to Dragonspine and obtain some Chilled Meat for this dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001006,
					"content": "However, that adventurer — Schuster was his name, I think — has yet to return...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001007,
					"content": "I've heard that Dragonspine is a very dangerous place. I wonder if he might have run into some trouble... Could you help me search for him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001008,
					"content": "I could do that, no problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "Thanks for your willingness to help. Make sure to light some fires to keep warm. Dragonspine is very cold, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
