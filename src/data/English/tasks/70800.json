					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001702
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001702,
					"content": "With this Chilled Meat and these two ingredients, I will surely be able to make a dish with true boom shaka-laka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001703
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001703,
					"content": "Ah, yes, here's something. Take it as thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
