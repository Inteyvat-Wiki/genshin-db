			"dialogs": [
				{
					"id": 708001101,
					"content": "C—Cold... Why is it s—so cold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001102
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001102,
					"content": "C—Can someone... Can someone help me make a fire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				}
			]
