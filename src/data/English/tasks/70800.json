					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Thank you. Everything's ready now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000902,
					"content": "Ah, right. This is for you. Please consider it my thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000903,
					"content": "But how should we prepare this food such that it will take up the \"taste of the wind\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000904,
					"content": "Cooking, frying... Hmm, no, perhaps we should place the original flavor of the ingredients front and center, before scattering the Dandelion Seeds on once the dish is ready...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080010,
