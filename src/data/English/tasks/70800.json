			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terrified Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "I—I've been revived...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001302,
					"content": "Y—You lit the fire... Th—Thank you, good-hearted traveler... Thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001303,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "A little warmer, that's for sure. I'll be fine... I was originally commissioned to come here to obtain some Chilled Meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001305,
					"content": "I started out trying to look for some on the outskirts of Dragonspine, but as I walked, I misplaced my tinder — and that was before I also got lost by mistake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001306,
					"content": "If you hadn't arrived, I don't know what I would have done. You have my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001307,
					"content": "So, what're you going to do about Brook's commission?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Ah, so Brook sent you to find me, huh... *sigh* She must be beside herself right now, I imagine. But as it stands, I haven't the energy to travel all the way to give her this meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001309,
					"content": "I'm sorry to ask this of you, Traveler, but could you help me deliver this Chilled Meat to her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 708001310,
					"content": "You can count on me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Thank you so much. As for me, I need to head down to that campsite in the foothills to get a bowl of hot soup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				}
			]
		},
		{
