			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "So how do we find out whether Gentry Maocai really is colluding with the Fatui or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010202,
					"content": "We need to find a smoking gun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "So... shall we just go look for him? Best-case scenario, we'll catch him red-handed; if not, we can try threatening him and see if he squeals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010205,
					"content": "Let's speak to the guards first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "Okay, boss! Whatever you say, boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010203,
					"content": "We need to catch him red-handed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200103",
							"2"
						],
						"stepId": 1200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sturdy Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Who goes there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010302,
					"content": "A Mondstadt merchant here for a meeting with Gentry Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Really? He didn't mention anything about a meeting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010306,
					"content": "The Master is dealing with some urgent business today. All prior appointments have been canceled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010307,
					"content": "Urgent business? ...What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "The Master has been working on a major business deal recently. He left early this morning to meet with a VIP client.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010309,
					"content": "So where is he now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "I'm sorry, the Master has stressed that we must not disclose that information to just anyone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010311,
					"content": "\"Just anyone\"? Are you saying we are not his VIP clients?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "N—No! I mean yes, yes you are! Ah... I—I meant no offense, please believe me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010313,
					"content": "Take me to Gentry Maocai or suffer the consequences!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "I'm sorry, I'm sorry! Master is currently in business negotiations at Xinyue Kiosk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010316,
					"content": "I beg for your mercy! Please, my master will show me no leniency if he finds out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010317,
					"content": "Well, MY master has much more important things to do than talking to rude guards like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "Luckily for you, your bad attitude will be the last thing on our minds when my master's busy negotiating a big business deal with your boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "Th—Thank you, thank you! May your business forever be blessed by the Lord of Geo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Sturdy Wu"
				},
				{
					"id": 120010320,
					"content": "#Nice work, {NICKNAME}! Paimon never knew you were such a tough negotiator.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "I was just bluffing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "Is that so? Now Paimon knows not to let your wily ways get the better of her in future!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Anyway, seems like the VIP client in question must be one of the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "I think you're right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "In that case, let's get ourselves over to the Xinyue Kiosk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "This could work in our favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "You did great too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Tee-hee! Paimon loves compliments and all... but treating Paimon to some tasty snacks would show that you really mean it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Would you like to explain these extra fees you are incurring to your boss, or shall I?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#I'm {NICKNAME}, a VIP client of your boss'!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "How strange, you're not on the guestlist...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Sturdy Wu"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gentry Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "I understand. I do. Please do not worry, you have my word that the order will be completed as promised.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010702,
					"content": "Hmm... The subordinate I sent was not quite so optimistic in his appraisal. Is somebody being uncooperative?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120010703,
					"content": "Ah... We just ran into a minor procurement problem is all. We haven't managed to purchase the Cor Lapis yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010704,
					"content": "But it's nothing for you to worry about. If Chang the Ninth won't sell, I can buy from someone else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010705,
					"content": "That would be most ideal. I remind you again that the Fatui care only about the result.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120010706,
					"content": "We are willing to lend a certain degree of support to this transaction. But if it is not completed in time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120010707,
					"content": "You may suddenly find our good will comes at a price you cannot afford.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120010708,
					"content": "I understand... I am indebted to you for your protection. You know I would not dream of disappointing you, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 120010709,
					"content": "We shall see when the time comes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Agent"
				},
				{
					"id": 120010710,
					"content": "*sigh* Darn that old man Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gentry Maocai"
				},
				{
					"id": 610045701,
					"content": "So, Mr. Gentry Maocai is colluding with the Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "Who knows if Guhua Geek has made any progress. Should we go tell him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Hmph! You said you had other things to look into, as if you're some sort of man of mystery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "When actually all you meant was you wanted somewhere new to park your backside while you read your book!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "We know what Gentry Maocai's up to now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "I see. I guessed as much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010805,
					"content": "Did you really guess, or are you just saying that to sound clever?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "The course of action we must take is now clear. To start with, please deliver this letter to the Feiyun Commerce Guild. They will know what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010807,
					"content": "My liege, for reasons that I cannot explain, I will be unable to join you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010808,
					"content": "There is no need for you to read the contents of the letter, when the time comes—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010809,
					"content": "Whew, this writing is super hard to read! Paimon can't make heads or tails of it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "It's in an ancient script, perhaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010813,
					"content": "Hence why I said there's no need for you to read it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010814,
					"content": "The Feiyun Commerce Guild will have someone who can understand it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "But why do you wanna get them involved? They're one of the bigwig commerce guilds in Liyue — why would they wanna help us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "What is the Feiyun Commerce Guild?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Since we got to Liyue, Paimon keeps hearing people mention it. Seems they oversee a lot of business that goes on around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Having such big backing would be great and all... But are you sure they'd wanna help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "No need to worry about that. From what I know, they share my sense of chivalry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "Once they have read the carefully reasoned and passionately argued case I put forth in this letter, they will certainly be moved to action.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "How can you be sure?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Gentry Maocai must be taught a lesson he will never forget. This is something we cannot do on our own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Also, I do not wish for anyone else to know of my involvement in this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Why not? You're only doing this to try and help Chang the Ninth, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "\"To silently disappear at the matter's conclusion, concealing one's name and contribution,\" this is the chivalrous thing to do. To savor the memory is ample reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Each droplet of kindness I receive I am duty-bound to repay with a welling spring of gratitude. I seek neither praise nor reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "That sounds very lovely. But be honest — you just want them to do it so you can carry on reading your book, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Thank you in advance for delivering this letter to the Feiyun Commerce Guild. Someone from the guild should be able to receive you near Liuli Pavilion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010830,
					"content": "Hey! Stop ignoring Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "Why get them involved anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "A secret text that needs a cipher perhaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}