			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "Over here, Traveler, over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "You're the artist who made an arrangement with Qingzhou earlier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Yes, that's me. That poet and I agreed that we would each create a work of art that sums the Lantern Rite up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "You even helped me to find my paints and brushes back then, remember?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Yes, I recall that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "My painting... Ahem, well... I have actually painted a lot already — scenes, people, even animals...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "I'm confident that these works accurately portray their subjects, but... I can't say any of them really sums up the Lantern Rite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "*sigh* I haven't been able to eat or sleep for days with this hanging over my head. I've practically used up all my paint, and still none of my paintings really capture the spirit of the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "So, I want to go find that poet and see how his poem is coming along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "Traveler, do you know where he headed off to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "He went to Qingce Village.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "Qingce Village? What did he go there for? ...Poetic inspiration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "Quick, Traveler, we must get to Qingce Village and find him! Perhaps I may also be able to find some inspiration there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "Ahem! Anyway, let's set out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "So, your painting...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "This is Qingce Village, then... Where's that poet? Has he gone to look for inspiration somewhere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "Last time we met, he was playing lantern riddle games with the children...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "L—Lantern riddles? What is the meaning of this...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "Did he fail to find inspiration for his poem and give up altogether?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Anyhow, regardless of what he is up to, the Lantern Rite is almost over — there's no time to waste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Let's go ask the person in charge around here. Today I absolutely must see where our competition stands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Granny Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "Why, if it isn't the Traveler. Thanks to you, our village finally has some festive cheer to it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Oh, you've brought a new face with you, I see? If I may ask...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710330403,
					"content": "He's an artist, and he's here to look for Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Looking for Mr. Qingzhou, is he? Hmm, that's just as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710330405,
					"content": "When Miss Wang'ya left several days ago, Mr. Qingzhou said that he would like to stay here for a while longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710330406,
					"content": "He should still be making up lantern riddles for the children. If my memory serves, he's taken them outside...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710330407,
					"content": "You'll probably have to find him outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710330408,
					"content": "He really is playing lantern riddle games... Traveler, if you could do me a favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "Go tell that poet that I've come. I will be here getting ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "No matter what, today I must see where our competition stands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Hahaha, I think you're all getting the hang of it. You're getting the answers faster and faster every time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer's here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Vermeer... Ah, yes, that artist. Let me see... by my count, this is indeed the agreed date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330505,
					"content": "Pity, then, that my poem remains as yet unfinished. Nor have these children yet had their fill of these lantern riddles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330506,
					"content": "Well, perhaps this is the uttermost limit of my poetic skill, then... Would you, perchance, accompany me to gather some inspiration once again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330507,
					"content": "Hmm, perhaps I should say not that it is \"gathering inspiration,\" rather, let us walk together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330508,
					"content": "Uncle Qingzhou! Does this mean we're not solving lantern riddles anymore? I still want to give them a try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710330509,
					"content": "I wanna solve some lantern riddles too, Uncle Qingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710330510,
					"content": "Hmph, I want to solve a few more, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710330511,
					"content": "Hahaha, settle down, children. I shall just go for a short stroll with this friendly traveler here. I shall return soon to give you all a new lantern riddle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330512,
					"content": "Go on back to Qingce Village and I will find you there when I get back. How's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330513,
					"content": "Okay! You're amazing, Uncle Qingzhou — you can come up with so many riddles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710330514,
					"content": "You read tons of books, don't you, Uncle Qingzhou...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710330515,
					"content": "I want to grow up to be just like you, Uncle Qingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710330516,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330517,
					"content": "Well, let us go then, Traveler. Let us bring this trivial matter to an end, can't leave those children waiting too long now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330503,
					"content": "Still remember your agreement with Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
		{
			"id": 7103309,
			"completionStepIds": [
				7103309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
