			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Liu",
					"Little You",
					"Little Zuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "Uncle Qingzhou's back! Uncle Qingzhou, have you finished writing a new lantern riddle for us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710331002,
					"content": "I'll get it right this time... I think!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331003,
					"content": "I'll think this one through carefully...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710331004,
					"content": "Hahaha, yes, I've already written down the lantern riddle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331005,
					"content": "My liege, please help me hang this Xiao Lantern up... A little higher, if you would.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7103311,
			"completionStepIds": [
				7103311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103311",
							"2"
						],
						"stepId": 7103311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "You're here at last. Have you written that poem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331102,
					"content": "No, I have not penned anything suitable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331103,
					"content": "S—So you too... Ahem, so you haven't, have you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331104,
					"content": "Liyue is large and its households are many. I pondered the matter long, yet I could not find an appropriate summation for Lantern Rite. Have you, then, finished your painting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331105,
					"content": "I... I haven't either. Liyue's too large! How could I paint it all, unless the sky itself were to be my canvas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331106,
					"content": "So in the end, neither of us was able to create a poem or an artwork that could encompass Liyue Harbor and the Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331107,
					"content": "I suppose, then, that this may be considered a draw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331108,
					"content": "Uh... fine, alright then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331109,
					"content": "Uncle Qingzhou, Uncle Qingzhou! We've figured that lantern riddle out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331110,
					"content": "L—Lantern riddle? What lantern riddle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331111,
					"content": "It's nothing, really. I just came up with some lantern riddles to entertain these kids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331112,
					"content": "Oh? What is it? Can you tell me one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331113,
					"content": "\"Countless ships over the waves do glide, their lamps lighting up Guyun's stones. They float along with the ocean tide, till with dragon and fish they rest at last their bones.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331114,
					"content": "You wrote this riddle for kids? It's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331115,
					"content": "Uncle Qingzhou, who's this other uncle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331116,
					"content": "He's that painter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "If this poet didn't want to compete with me, then why would he make that agreement?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331119,
					"content": "You're mistaken. At first, I indeed saw it as a competition... I spent much energy going everywhere in search of inspiration... wanting to compose the perfect poem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331120,
					"content": "But, as you may have realized as well, it's impossible to encompass Liyue Harbor and the Lantern Rite in just a few lines of words. So...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331121,
					"content": "So, you came here to play lantern riddle games with children?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331122,
					"content": "Exactly, so I came to play with children, hoping I would find some poetic inspiration in these delightful lantern riddle games.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331123,
					"content": "Hehe, though I never found inspiration for my poem, I was able come up with a number of lantern riddles. The children have certainly enjoyed it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331124,
					"content": "Perhaps... this experience is the very poem I sought. But alas, where would I begin writing it? Thus, with no poem, I have no way of competing with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331125,
					"content": "You people of Liyue... are so strange! Then what about our competition? Who won and who lost? A draw is simply unacceptable to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331126,
					"content": "This other uncle sure likes to talk a lot... of course the winner is Uncle Qingzhou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331127,
					"content": "He's awesome. He came up with so many lantern riddles, and I bet you can't even guess the answers to them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331128,
					"content": "This poet... Hmm? Hold on, I have an idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331129,
					"content": "How about this — let's have a new competition!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331130,
					"content": "Oh? And how do you propose we commence this new competition?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331131,
					"content": "You created a lot of lantern riddles for these kids, right? Well, when I was searching for inspiration for my painting, I saw lots of Xiao Lanterns and their decorative patterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331132,
					"content": "You write the riddle, and I'll paint the Xiao Lantern. The children will serve as judges, and whoever's work they like more will be deemed winner. Is that fair?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331133,
					"content": "Okay! It suits me just fine, and also suits the spirit of the Lantern Rite. A very suitable competition indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331134,
					"content": "Then it's settled. Let me first prepare my painting supplies, and then let our new competition commence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331135,
					"content": "You guys sure have a lot of energy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "Gather 'round, children. Show me the riddle this poet fellow writes, and I'll paint you a beautiful Xiao Lantern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331138,
					"content": "Hehe, I only fear that you won't be able to keep up with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331136,
					"content": "Give it your all, you guys...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "He's that guy competing with Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
		{
			"id": 7103312,
