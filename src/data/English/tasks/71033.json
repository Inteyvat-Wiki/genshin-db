			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Granny Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331201,
					"content": "Oh, do you need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710331202,
					"content": "About Qingzhou and Vermeer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Oh, those two? Don't worry about them. As long as they're willing to accompany the children, I'm fine with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710331204,
					"content": "This is a festive season, after all. It's good for things to be lively.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710331205,
					"content": "You are always running around helping out Qingce Village. Thank you, child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710331206,
					"content": "It's nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "You sure are a kind-hearted child... Here, take these as thanks. You must have yourself a happy festival as well, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710331209,
					"content": "I hope that future Lantern Rites here will be this exciting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 710331207,
					"content": "Don't mention it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
			"id": 7103314,
			"completionStepIds": [
				7103314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103314",
							"2"
						],
						"stepId": 7103314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "Children, look at this Xiao Lantern. The riddle's answer is a \"thing\" at the Lantern Rite. Go on, guess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331402,
					"content": "I must go tend to a matter with this here traveler. I'll be back to play with you once I'm done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331403,
					"content": "Aww! Uncle Qingzhou, what have you gotta go do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710331404,
					"content": "I must go find a certain painter to settle a certain... competition. I write the best poem and he creates the best painting, and we see whose work is better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331405,
					"content": "Well, you're going to win for sure, Uncle Qingzhou. All of those lantern riddles you made were great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331406,
					"content": "Is that so? Thank you for your praise. Take this Xiao Lantern to Qingce Village first and try to guess it. It's not safe alone in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331407,
					"content": "Don't worry, Uncle Qingzhou! We're familiar with around here, we can make it back on our own. Go and show that painter what you got!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331408,
					"content": "Then... Uncle Qingzhou, after you finish your competition with that painter, hurry on back to play with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710331409,
					"content": "Of course. I will go find you as soon as I'm done tending to the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331410,
					"content": "A great poem indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "We've got a winner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Hehe, that's not even a poem, my liege. Nothing more than a lantern riddle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331413,
