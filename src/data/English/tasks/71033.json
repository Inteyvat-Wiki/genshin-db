					"id": 710330801,
					"content": "Hmm... Alright, I've got it — one sentence for the lantern riddle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330901,
					"content": "Alright then, the lantern riddle is all done. Let us go to Qingce Village now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330902
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330902,
					"content": "I will tell you the riddle once we arrive.",
					"roleType": "TALK_ROLE_NPC",
