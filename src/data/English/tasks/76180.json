					"The Damselette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "It's a lot of fun playing games. I look forward to doing it more often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800802,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800804,
					"content": "Leaving already? Alright, see you next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800803,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
