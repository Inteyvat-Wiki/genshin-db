			"dialogs": [
				{
					"id": 761800401,
					"content": "We always used to gather in your garden, Sandrone. Now you're the one visiting me for tea. It's such an odd feeling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800402,
					"content": "I'm still the one getting everything ready. Doesn't feel so different to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800403,
					"content": "Mmhmm, and your food is every bit as delicious as I remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800404,
					"content": "#Hmm... I hear {NICKNAME} visits you quite often. What do you usually do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800405,
					"content": "Sometimes we chat, sometimes we play games with the kuuhenki, and we also like to watch them draw. Oh, and we play Moon Chess, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800406,
					"content": "Moon Chess? Is that the one where you try to get three pieces in a row? Who usually wins?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800407,
					"content": "#I don't keep count, but I must say {NICKNAME}'s a very skilled player.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800408,
					"content": "Heh, I'll show you what real skill looks like. Care for a game? If we draw, it counts as a win for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800409,
					"content": "Sure thing. Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7618004",
							"2"
						],
						"stepId": 7618004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Damselette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "Wh—What? That's impossible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800602,
					"content": "Looks like you lost, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800603,
					"content": "I... I let you win!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800604,
					"content": "Really? Then why do you seem so worked up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800605,
					"content": "Darn it... I want a rematch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800606,
					"content": "Hmph, piece of cake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800607,
					"content": "You win. You really are quite skilled, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800608,
					"content": "Let's play something more challenging next time. I know a lot of fun math-based games.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800609,
					"content": "Sounds exciting! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800610,
					"content": "Huh? What's so funny?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800611,
					"content": "I can barely remember seeing you this happy before. You hardly ever invited me to play games. Usually, you'd just chase me away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761800612,
					"content": "Hey... Don't make me out to be some sort of bully! I'll invite you to more tea parties from now on, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800613,
					"content": "I'd like that, Sandrone. I enjoy these little gatherings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
