			"dialogs": [
				{
					"id": 718230701,
					"content": "Wait a second... now doesn't seem to be the right time to be picking Lotus Heads.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718230702,
					"content": "Hmm... Zhi wanted us to pick Lotus Heads between midnight and 06:00, right? We'll have to wait for the right time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
