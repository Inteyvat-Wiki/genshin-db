					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "You're back! Were you able to find the herbs I asked for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230902,
					"content": "Got 'em right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Thanks for all your help. I've also asked Ms. Bai to help me with handling the herbs. Let's go and take them to the mill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ms. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "Oh, allow me to take care of these herbs. Once I'm finished, you can take them back and start concocting the medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718231002,
					"content": "Thank you. Now, I just need to find a way of making the medicine a little sweeter, otherwise, there's no way the kids will be willing to take it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "Are you always this busy at this time of the year?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Yes, more or less. There aren't many young people in Qingce Village these days, so we have to help out wherever we can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718231005,
					"content": "Being busy for these few days every year is not a problem. Besides, things have already been much easier this year thanks to all your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "In previous years, I'd have to spend many days gathering herbs, to say nothing of the amount of time it would take to make the medicine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "Alright, thanks for your help. I'll go to process these herbs now, and then I'll prepare my Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "I almost forgot to release one last year. Have to make sure I don't forget this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "What would you like to wish for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Hmm... For everyone in Qingce Village to stay in good health? Yeah, I'll probably wish for something like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "But wishes lose effect if you say them out loud, so you're not getting anything more out of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "These are for you — thanks for your help today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
