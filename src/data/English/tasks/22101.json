						221010302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010302,
					"content": "All clear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010303
					]
				},
				{
					"id": 221010303,
					"content": "Great. Thanks a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010304,
					"content": "Here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010305,
					"content": "These days, honestly... If I hadn't done martial arts since I was a kid, I wouldn't dream about working in the hospitality sector.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
