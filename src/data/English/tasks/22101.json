				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "*sigh* It's just one thing after another...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "This location... It's a real challenge to run an inn here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010104,
					"content": "It could just be me, but I feel like we're seeing more and more monsters around these parts recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010105,
					"content": "They wouldn't dare come anywhere near the inn itself, but guests need to get in and out and the Millelith can't be here all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010106,
					"content": "If you're free, do you think you could take a look around and clear out any monsters nearby?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "Haha... Ah, I must say I do find your forthrightness refreshing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010113,
					"content": "Speaking of tiring jobs... I do feel bad making you do this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010114,
					"content": "But I promise I will make it worth your time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010115,
					"content": "Best of luck, and thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010108,
					"content": "This issue seems self-inflicted...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Yes, we should have known what we were getting into when we chose the location.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010111,
					"content": "But then, where would passing travelers stay if it weren't for us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010112,
					"content": "It's a tiring job, but a necessary one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2210102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
