					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221010201,
					"content": "How's it coming along? All clear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Okay. Well, take your time. These monsters may be no end of trouble to people coming and going, but they wouldn't dare set foot in the inn itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "And in the highly unlikely event that a few of the gutsier ones did venture inside... I'm sure I could, ahem, persuade them to leave. My guests' safety would not be at risk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "No one runs an inn this far out of town unless they know a bit of self-defense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
