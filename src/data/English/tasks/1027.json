				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Who could've ever guessed we'd get trapped in a place like this. It's quite the predicament...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "For all the studying I've done in my life, all I know is how to land people in prison... I don't know the first thing about breaking out of one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "I've even made a contract with my father to \"live a happy life\"... I can't give up hope now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "Try and stay positive... At least I've explored a new place and seen more of the world while reuniting with some old friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Uh-huh... Yeah, there's still a silver lining. I guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
