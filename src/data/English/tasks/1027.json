			"dialogs": [
				{
					"id": 10280701,
					"content": "Our situation is grim. There doesn't appear to be a way out for now. We should be prepared to stay for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Fortunately, we don't seem to lack supplies, and even our motley crew has people who can keep their cool when the stakes are high.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
