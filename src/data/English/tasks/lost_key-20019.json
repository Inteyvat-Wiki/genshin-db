				"points": []
			},
			"dialogs": [
				{
					"id": 200190101,
					"content": "Traveler! You couldn't have picked a better time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190102,
					"content": "Last night, I was on my way to the city to deliver these goods, when suddenly, some shining orbs caught my eye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190103,
					"content": "I—I'd had too much to drink, and... I just felt drawn to them, you know? I went to check it out and it turned out to be a huge group of slimes. They even bumped into me really hard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190104,
					"content": "I panicked and ran, but lost my way. It took me forever to find my cart again. Then, this morning, I found out my <color=#00E1FFFF>key</color> was gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190105,
					"content": "Could you help me look for it? It's got to be around here somewhere... I feel like it's right under my nose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190106,
						200190108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190106,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190107
					]
				},
				{
					"id": 200190107,
					"content": "Great! It's such a huge area, I just wouldn't know where to start looking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190108,
					"content": "I have some pressing business to attend to.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190109
					]
				},
				{
					"id": 200190109,
					"content": "This is such a huge area. I just don't know where to start looking. Please, you're the only one that can help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
		},
