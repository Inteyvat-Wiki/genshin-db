						200190403
					]
				},
				{
					"id": 200190403,
					"content": "Yes! That's the one. I can't afford to let that happen again... I really must rein in my drinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190404
					],
					"speakerTitle": "Wyatt"
				},
				{
