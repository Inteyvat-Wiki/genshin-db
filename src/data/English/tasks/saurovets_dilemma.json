					"nextDialogs": [
						750181008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750181008,
					"content": "#Haha, it's nice hearing people praise {REALNAME[ID(2)|SHOWHOST(true)]} — even better than hearing them praise Paimon, in fact!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181009,
					"content": "I'm impressed at how well you two get along with this little guy too. I could stand to learn a thing or two from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "Truly amazing, am I not?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "I'd love to say that there's something I could do to help you, or do for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "But I think I'll settle for wishing you the best of health. Best you never need my help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
