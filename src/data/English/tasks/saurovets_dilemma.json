			"dialogs": [
				{
					"id": 750180101,
					"content": "—Shwaaaargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "\"Kururuk\""
				},
				{
					"id": 750180102,
					"content": "Come on kiddo, come on now, quit fooling around. If you don't take your meds, you won't recover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180103,
					"content": "#Oh no, she's in danger! We've gotta help her, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7501803,
			"completionStepIds": [
				7501803
