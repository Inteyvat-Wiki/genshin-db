					"nextDialogs": [
						750181005
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181005,
					"content": "Either way, it's a good thing that he took the medicine! And now that I know how he reacts, I can adjust the formula accordingly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181006
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181006,
					"content": "#Yup, don't worry, we should be fine. Thanks for your help — especially you, {REALNAME[ID(2)|SHOWHOST(true)]}! What an amazing little Tepetlisaur you are!",
