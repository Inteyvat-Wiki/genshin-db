					"nextDialogs": [
						718110603
					]
				},
				{
					"id": 718110603,
					"content": "Ah, right, right. I did go to Feiyun Commerce Guild to request that they take a picture of me here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110604
					],
					"speakerTitle": "Tea Master Liu Su"
				},
				{
					"id": 718110604,
					"content": "How is it? Has the picture been printed already? Let me have a look at it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110605
					],
					"speakerTitle": "Tea Master Liu Su"
				},
				{
					"id": 718110605,
					"content": "Oh, this is not bad at all. Thank you for making the trip here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tea Master Liu Su"
				}
