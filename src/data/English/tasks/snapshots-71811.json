			"dialogs": [
				{
					"id": 718110412,
					"content": "About the Kamera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "Have you managed to deliver the pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Done deal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Thank you, thank you. I'm sorry for troubling you, but we're barely keeping our heads above the water here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Ah, yes. Please take this Kamera as thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "I couldn't...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "It's no problem. I mean, you did help us, didn't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "This is not an exceedingly expensive object, either. It's just a sample that our partners in Fontaine gave us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "There are some differences between it and the official model... but the basic functions are all there. It'll definitely be enough for your needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "And if you take a liking to it, you can also help us with some advertising here and there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "Ahem... Regardless, thanks for your help, and please, take this Kamera with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "This must be very expensive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
