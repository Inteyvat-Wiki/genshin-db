					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "Kamera... Ah, yes, I did go to the Feiyun Commerce Guild a few days ago — asked them to come here to take a picture of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Granny Shan"
				},
				{
					"id": 718110504,
					"content": "Did you come here specially to deliver my picture? Why, thank you. Thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Shan"
				}
			]
		},
