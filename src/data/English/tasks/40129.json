					}
				]
			},
			"dialogs": [
				{
					"id": 401290601,
					"content": "Phew, it's finally over! So, have we defeated the evil monsters and reclaimed the Kingdom of Water Imps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Yes, it should now be time for us to attend Thelxie's coronation ceremony... The only thing is, I didn't expect this to go so smoothly. I thought it would have taken longer for us to reach the heart of the ruins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290603,
					"content": "It was my mistake. I should have told Freminet earlier that we would also need a crown...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290604,
					"content": "#It's all because {NICKNAME} and Goddess Paimon were too strong! We just eradicated all the monsters in one go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "It's okay, Zuria. We can come back again once I've made the crown.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290606,
					"content": "Then I must thank all of you again for taking the time. And you too, Thelxie, my child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "Thelxie's turning out to be a real expert at fighting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "I don't think there's anything that will be able to stop him... He's like a true prince now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290610,
					"content": "Yes, I agree as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290611,
					"content": "#Let's head back to camp for now. I asked {NICKNAME} to search for some materials on the way because I want to make the crown as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290612,
					"content": "We can add an update to Thelxie's Fantastic Adventures as well! Now that we've reclaimed the Kingdom of Water Imps, it's time for us to draw some new scenes in the picture book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4012908,
			"completionStepIds": [
