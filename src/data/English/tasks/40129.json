			},
			"dialogs": [
				{
					"id": 401290901,
					"content": "So these are the underwater ruins that Freminet found... They're pretty amazing, but still not exactly the kind that Paimon was imagining...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "This is the Kingdom of Water Imps, Paimon, not ruins...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Oh yeah, Paimon knows, it's just... Paimon thought we'd actually see a fairytale world, like with the Water Imps' colorful houses, and the rainbow bridge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "I'm sorry... I was hoping to put up some decorations but ran out of time to do it by myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290905,
					"content": "It's okay, it's fantasy time now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "Whoa! Someone's already switched into fantasy mode!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#Seems like {NICKNAME}'s already got the gist of things. You should do your best too, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290908,
					"content": "Ah, don't underestimate Paimon! Paimon can flip the switch, too. Now entering... Paimon Fantasy Mode!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "Ahem... Young adventurers! 'Tis Paimon, Guardian Goddess of this land. State your goals and intentions for visiting this nation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290911,
					"content": "We are the companions of Prince Thelxie, Your Divine Highness. We have come to help him reclaim the glory that he has lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290912,
					"content": "Ooh! Reclaiming your glory! Thy goddess here has golden glory, silver glory, and bronze glory. Which is it that the prince has lost?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290914,
					"content": "Uhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290915,
					"content": "Did you break character, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Not at all! This is the goddess's test! From your responses, the goddess has concluded that you're all brave adventurers without the taint of greed in your hearts! As such, you are worthy of everyone's respect!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
