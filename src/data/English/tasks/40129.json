			"dialogs": [
				{
					"id": 401290101,
					"content": "Is your child feeling any better?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290102,
					"content": "Thank you for your concern, Freminet. His condition is fairly stable. The family doctor said we might be able to take him out for a stroll today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290103,
					"content": "Zuria! Freminet! We're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Hehe, seems like everyone's arrived now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290105,
					"content": "Not quite, aren't we missing someone? But Paimon has a guess where he might be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "Hey! Thelxieeee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... . -- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290108,
					"content": "Whoa! Thelxie's got himself a sword and a shield now! He's lookin' sharp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "Indeed, with his weapons in hand, Thelxie looks more formidable than ever. You've really outdone yourself, Freminet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290110,
					"content": "We helped, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "Yes, you really had a good eye for materials. Everything you found was high quality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290112,
					"content": "Speaking of which, Zuria just told me that she wants to end the adventure with a coronation ceremony. So, could I also trouble you with finding some materials for the crown?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290113,
					"content": "You can just keep an eye out for them on our way to the ruins. I was planning to collect the materials myself, but then I realized you might be able to find some prettier ones than what I could get my hands on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290114,
					"content": "Consider it done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "Seems like everything's ready to go. Shall we head out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Please wait a moment. I was just thinking... Since Thelxie has already shown us his brand-new appearance, we may already be able to draw a new page in the picture book. What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290117,
					"content": "Ooh! Paimon's excited now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "What should we draw on the page?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "Hmm, why don't we use the story we know as a reference? Just make the atmosphere a bit less grim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290120,
					"content": "So we'll take out the sad parts and replace them with happier stuff? Sounds great to Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Alright, I'll give it a try. I'm not very adept at drawing, but I've seen a lot of art during my work. Now, as for the actual content of the drawing... please tell me what you'd like to see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290122,
					"content": "Let me think... We can draw the weapon. The prince has picked up the sword of courage and the shield of perseverance, which proves he has crossed the mire of doubt, and is now ready to wage war against the darkness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290123,
					"content": "Okay, I'll add the weapon... Anything else?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290124,
					"content": "Paimon wants to give him some friends! Thelxie's got some friends by his side now, so he's no longer fighting alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "Okay, I'll also draw some companions... Anything else?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290126,
					"content": "Don't forget to add some color.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Color. Ah, color... Yes! That's really important. The road in front of him now will no longer be just greyscale, but bursting with color and hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290128,
					"content": "Who would've thought the page could have become so inspiring... How wonderful. Splendid ideas, everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290129,
					"content": "Great! Everyone looks super pumped up, Thelxie most of all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290130,
					"content": "Are you seeing this, my son? Are you feeling inspired by this as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290132,
					"content": "I'm sure he is, Zuria, and this is still just the first page.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290133,
					"content": "That's right, Paimon can't wait to see the picture book when it's all finished! We should finish it as soon as possible, and keep up the belief and hope in our hearts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290134,
					"content": "Mhm! I'm starting to look forward to it as well, so let's get this show on the road and head towards the Kingdom of Water Imps!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290135,
					"content": "Yay! Thelxie's Fantastic Adventures begin now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
