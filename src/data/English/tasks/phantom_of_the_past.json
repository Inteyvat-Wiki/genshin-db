	"talks": [
		{
			"id": 7051202,
			"completionStepIds": [
				7051201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051201",
							"2"
						],
						"stepId": 7051201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "Good day to you both. It's been quite a long time. You're looking well, as ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "Hi, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "To what do we owe the honor today? Important business to discuss with Master Diluc, I presume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Grape juice, actually...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "That's right. Adelinde, since we've run into you, maybe we could just get you to help us with this one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "We always miss the Winery's discount grape juice, so this time we decided to come here early...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "Can you reserve a bottle for us? We'll pay a deposit, just name the price!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "Of course I can, and no deposit necessary!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "But I'm afraid you may be in for quite a wait. Dawn Winery's discount grape juice takes a long time to make.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Every summer, Master Diluc hand-picks two barrels of the finest grapes to turn into juice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "What? Why sell the good stuff at a low price? Shouldn't the best grapes be the most expensive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "Master has never explained his reasoning. If I had to guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "The discount could be a marketing technique. Special deals always attract customers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "Perhaps Master hopes to increase the popularity of fruit juice, so that people have more options when it comes to drinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "It makes an ideal alternative for the heaviest drinkers, because they won't get drunk and start causing mischief. At the same time, those who don't drink alcohol get the chance to try something new.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "Wouldn't that harm the Winery's business...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Master Diluc isn't all about money. I think he would prefer to see people drinking in moderation than chase bigger profits at any cost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Imagine if everyone could just enjoy a nice glass of wine and have a good time while keeping their wits about them and not creating trouble for others... Now wouldn't that be a miracle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Wow, Master Diluc's such a thoughtful guy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "So, is Diluc picking out this year's grapes right now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Not just yet. He has a few more issues to sort out first. He'll start the process as soon as those are out of the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "If you're interested, I'm sure Master Diluc would be delighted to see you and hear your thoughts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "What \"issues\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "As you know, whenever Master Diluc catches wind of any unsavory guests showing up in Mondstadt, he takes it upon himself to go and, ahem, \"greet\" them in person. It's the same story today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "He should be somewhere near Falcon Coast. I'm not sure how long he'll be... In the meantime, would you like to take a seat inside?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "I have to stay here and wait for some other guests, but Hillie and Moco will be glad to take care of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "\"Unsavory guests\"? What is that supposed to mean...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "Guessing it has something to do with Diluc's part-time job.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "Huh? You mean the Darkn—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "Uhhhh... the dark 'n' evil Abyss Order are up to no good again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "In that case — Master Diluc's our friend, we can't sit here and do nothing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "If you're happy to help, that would be wonderful. Master trusts you, after all, and you're both very capable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "I know he'd appreciate a helping hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "No biggie! The sooner Master Diluc is free, the sooner we can get a taste of that delicious grape juice, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#Come on, {NICKNAME}, let's go to the Falcon Coast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Alright, we'll wait inside until Diluc gets back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "Ummm... But Paimon will feel kinda bad if we're sitting in Diluc's house twiddling our thumbs while he's out there hard at work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "Let's go to Falcon Coast and help Diluc sort out his issues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Although Diluc is super strong, surely he'd appreciate a little support.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "It still doesn't sound like the most profitable venture.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "Not quite \"important business\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Ha... This tent doesn't look like it belongs to Diluc. Maybe it's an adventurer camp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Oh, there's a piece of paper and a notebook over there. Let's read them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "\"Dear Darknight Hero, we are seeing a repeat of the phenomenon we encountered many years ago.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Investigate"
				},
				{
					"id": 705120404,
					"content": "\"Although you fully resolved the issue last time, the ley lines seem to have been stimulated in some way and are releasing the monsters they recorded once more.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Investigate"
				},
				{
					"id": 705120405,
					"content": "\"I'm sure you'll want to deal with those that pose the biggest threat immediately.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Investigate"
				},
				{
					"id": 705120406,
					"content": "\"So I'm notifying essential individuals, per the operating procedures.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Investigate"
				},
				{
					"id": 705120407,
					"content": "Hmm... judging by the tone, it seems like this was written by someone Diluc knows well. Let's call him \"Diluc's friend\" for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "He saw something bad happen, wrote a note for Master Diluc, and then left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "Huh... Isn't that pretty irresponsible? What if someone else had seen it? Also, he left his notebook behind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Mmm... Now that Paimon thinks about it... you know that strange ley line deposit on the beach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "I bet that's the \"phenomenon\" he was talking about.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Other than that, everything seems fine here... not a monster in sight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, do you wanna read Diluc's friend's notebook, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "If not, let's head over and take a closer look at the ley line deposit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7051205,
			"completionStepIds": [
				7051205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051205",
							"2"
						],
						"stepId": 7051205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "Whoa! Where did all these monsters come from!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120502,
					"content": "Uh.. Wait a second... Is that Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120503,
					"content": "Huh... He looks kinda different than usual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "Look at him go! So focused and full of energy! So this is Captain Pyro when he's in top form, huh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120505,
					"content": "It must be Diluc from when he fought here in the past.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "Hey, you're right! Now that Paimon looks more closely, this Diluc does look younger than usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120508,
					"content": "But what happened back then? Why was he fighting here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120509,
					"content": "Hmm. Guess we can just ask him about it when we see him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120510,
					"content": "#What should we do now, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120511,
					"content": "We shouldn't act rashly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "Okay, let's see how young Diluc used to fight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120512,
					"content": "Let's observe for now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "The ley lines are showing the scene they recorded at that time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
		{
