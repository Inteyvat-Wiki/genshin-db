			"dialogs": [
				{
					"id": 706510101,
					"content": "Drat. Running out of ores, are we...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510102
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510102,
					"content": "Can I ask you some questions about finding ores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706510103
					]
				},
				{
					"id": 706510103,
					"content": "Ores? What do you want to forge? Weapons or armor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510104
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510104,
					"content": "If you're looking to mine ores, I do know some good spots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510105
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510105,
					"content": "There are all sorts of ores, though. Iron Chunks are the most common, followed by White Iron Chunks, and then Crystal Chunks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510106
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510106,
					"content": "And there's Magical Crystal Chunks, which are of very fine quality, and can be used to forge excellent items.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		},
		{
			"id": 7065102,
			"completionStepIds": [
				7065101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
