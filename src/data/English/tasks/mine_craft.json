			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wagner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706510201,
					"content": "However, they are very difficult to work with. If you want to make anything with them, you'll have to expend a significant amount of other resources as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510202
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510202,
					"content": "Still, I've just come back from a trip outside, and it seems that most of the ore veins have already been mined. If you go out now, I doubt you'll get anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510203
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510203,
					"content": "Hmm, how about this? Come find me later, and I'll mark all the veins I know of on your map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		}
	]
