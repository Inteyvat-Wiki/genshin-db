	"talks": [
		{
			"id": 201802,
			"completionStepIds": [
				201802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201802",
							"2"
						],
						"stepId": 201802,
						"stateName": "QUEST_STATE_UNFINISHED"
