				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara",
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Lady Guuji. Here I am, as promised. Rest assured I came here alone and told no one about this trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "I knew you would keep your promise, after all... I'm sure you've barely been able to take your mind off it these past few days — have you managed to get any sleep at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "I—I... You're quite mistaken. I would never doubt the leaders of my clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "So. Where is your proof?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ah, how wonderful. Everyone's keeping their promises today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "You wouldn't believe what we had to go through to get our hands on this stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Hand them to Sara. She can examine them for herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "What is this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "...I see this document bears the official seal of the head of the Kujou Clan. And it doesn't look like a forgery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "I don't understand... Not a single word about the resistance, Sangonomiya, or the situation on the front line...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "What about the soldiers who gave their lives on the front line, or the hardship endured by the people? Do they deserve no mention!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "Utter disregard for human life. Why would they want to hide it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "For the sake of the Vision Hunt Decree, of course. Don't you think the Shogun might reconsider her policy if all of the things you just mentioned appeared in this report?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "So the Tenryou Commission... They are deliberately deceiving the Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Yes. Now... who else do you think might be benefiting from the Vision Hunt Decree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "I also have a confidential letter here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "This is a letter from the Tenryou Commission to the Fatui. The head of the Kujou Clan kept this a secret from the Shogun, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "Well? The things you wanted to see, but also wished not to see, are here before you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "Surely... you aren't planning to turn a blind eye to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "So everything I've ever held on to... it's all... How could they... Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "This betrayal is unforgivable... Takayuki, you've got some explaining to do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara seems pretty angry, huh. Looks like our Tenryou rebellion is successfully underway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "The Shogun's Army is without a leader for now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Yup yup, let's catch up with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "Hold on, Traveler. There's something else we need to discuss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "Last time you entered the Plane of Euthymia, it was in front of the Statue of the Omnipresent God, correct?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Correct.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "You must find a way to recreate the circumstances of that day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "If you can get the Raiden Shogun to \"open her heart\" to you once more before the Statue of the Omnipresent God, you will have the opportunity you need...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "I will do my best.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Take this with you as a farewell gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "The omamori from the Grand Narukami Shrine are very potent indeed. I thought I'd put one aside for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Thank you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Hehe, if you find yourself at your wits' end, take it out and see what happens. Maybe your prayers will be answered, and all your problems will disappear in the blink of an eye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "Or, if you ever think about me during your journey, take it out, won't you? Who knows, maybe I'll just end up appearing right in front of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "Cut it out, Fox Lady. This isn't the time or place to be poking fun at the Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Hehehe... I'm sorry. Well then... time for you to face my hopeless fool of a friend. I'm counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "I will treasure it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "If we follow her, we might meet the Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201805",
							"2"
						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "You followed me here? You've got guts, I'll give you that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "Since you are witnesses, I suppose I can shield you from arrest — at least until I have received an explanation from Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "But... if it turns out that you have been deceptive in this matter, then not only will you be arrested immediately, but you'll also be charged with one more crime. Do I make myself clear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Perfectly clear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Hmph. Good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180305,
					"content": "Lead the way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Takayuki",
					"Kujou Sara",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "Stop! Sara, have you gone insane!? How dare you disregard my orders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180404,
					"content": "M—Master, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180405,
					"content": "Go on, ask him! Don't let him intimidate you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180406,
					"content": "...Master Takayuki, I've seen the report to the throne and the letter to the Fatui... Please, tell me why!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "So this is how my documents went missing from headquarters? You stole them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "Should I take your words to mean that... these documents were not forgeries? They were really penned by your own hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Please tell me, Master, I need to know... Has the Tenryou Commission really... betrayed the Shogunate!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "Hmph... Yes, I have dealings with the Fatui. And yes, the report you saw was penned by my hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Heh, he just came right out and admitted it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "The diplomats from Snezhnaya promised a very generous reward indeed... and all they requested of me in return was to see that the Vision Hunt Decree is upheld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "For too long, the Kujou Clan's position has been coveted by so many. There is no shortage of clans who would tear us down at the first opportunity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "So, when the chance arose to gain the backing of another powerful nation and crack down on our enemies at the same time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "It appeared to me to be an excellent deal. I simply saw no need to inform you, Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "But... you worship the Shogun. How can you betray her after all this time and act like it's nothing!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "Betrayal? How can you call this a betrayal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "The Fatui may think they are using me, but the reverse is true. What could they possibly hope to achieve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "When the lightning strikes in Inazuma, they shall fall to their knees and tremble, paralyzed by fear and trepidation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "After all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "None can contend with the supreme power of the Almighty Raiden Shogun and the Musou no Hitotachi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "His intention wasn't to betray the Raiden Shogun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Yeah... he doesn't worship the Raiden Shogun herself, but her power as a warrior — especially the Musou no Hitotachi. In fact, he seems to be way too into it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "But Master... what about loyalty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Ever since I was adopted by the Kujou Clan, you taught me the importance of loyalty from servants to their superiors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "But it's clear to me now that you wanted my loyalties to stop with the Kujou Clan. So you were scared that I would betray you one day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "You hypocrite! Preaching about virtue just to mask your own wretched selfishness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "Selfishness? I am but safeguarding the eternity of the Kujou Clan. I'm quite sure the Almighty Shogun would be sympathetic to that, as would the former head of our clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Hate to say it, but his ego is getting in the way. If he thinks the Kujou Clan is a match for the Fatui, Paimon thinks he's in for a nasty surprise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "There is no point trying to argue with him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "I've doubted the Vision Hunt Decree in the past. I asked myself, is this truly the correct thing to do? Even though it goes against what I know in my heart to be right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "But I chose to obey the Shogun. For as long as she leads the way, who among us is qualified to judge between right and wrong when we have not yet reached the end of the path?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "But now I realize that the path of eternity is one without end, while this path... it has long since been defiled by your selfish ways.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "So, I'm going to tell the Shogun the truth about all this. If nothing else, my conscience will be clear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "Stubborn and futile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Report to the Shogun if you so wish. The Kujou Clan's position is now unshakable, and nothing you can do will change this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "The Shogun is at <color=#00E1FFFF>Tenshukaku</color> receiving a Snezhnayan diplomat — the Harbinger by the name of \"Signora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "Signora's the one behind all this? Ugh, not her again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "Way back in Ritou, Lady Hiiragi said something about the Kanjou Commissioner meeting with an arrogant-sounding woman... We should have known.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "A diplomat from Snezhnaya? Well! If she thinks she's leaving Inazuma in one piece, she's got another thing coming!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara stormed off... Do you think she's gonna go barge into Tenshukaku right now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "Either way, we have a score to settle with Signora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "You can say that again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "Alright then! Let's do this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "We shall go up to <color=#00E1FFFF>Tenshukaku</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Let's see what Kujou Sara thinks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "He's just over-confident in her power.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
