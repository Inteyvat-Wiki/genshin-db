			"dialogs": [
				{
					"id": 191079801,
					"content": "Great job, keep it up. We'll definitely be able to hire Diona as resident bartender here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "I hope it works. I was out there for weeks waiting for this chance... We mustn't let this opportunity go to waste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "You really outdid yourself this time, Connor. As long as we can get Diona to come work here, all our hard work will have paid off. This is just the first step.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Now don't forget, Diona must feel our sincerity and our passion! Oh, and remember, try not to overdo it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "No problem. We've already gone over this many times before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "What are you guys talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Huh?! Oh, hehe... nothing. We're just uhh... just discussing some winery business matters, yeah... hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Y—Yeah, we're talking about business. Let's go over the recent upkeep costs of the winery again, shall we, Elzer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
