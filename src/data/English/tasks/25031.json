			"dialogs": [
				{
					"id": 250310301,
					"content": "Worst comes to worst, can't you just... not finish writing the thesis? Aaaah—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
