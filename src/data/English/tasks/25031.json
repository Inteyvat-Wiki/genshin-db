							-1332.094,
							163.56,
							7673.491
						],
						"pointId": 350400084
					}
				]
			},
			"dialogs": [
				{
					"id": 250310501,
					"content": "So, how did it go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani's safe and sound.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "Phew... I was worried sick. If you'd have taken any longer, I'd have set off searching myself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310505,
					"content": "Couldn't that fool have picked a slightly simpler topic? With her ability, I'm sure she'd still get a high enough grade to graduate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310506
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310506,
					"content": "She always chooses such huge topics, does heaps of preparation, then ends up with nothing to show for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310507
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310507,
					"content": "Apologies... I'm letting myself get carried away. Thank you for your help. Please, take these as payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310508
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310508,
					"content": "*sigh* That halfwit... Why does she always make things so difficult for herself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310503,
					"content": "She's still not done gathering materials.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				}
			]
		}
	]
}