			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "After a while, you and Paimon arrive at the Lil' Fungi's Fun-Tastic Fiesta booth...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "Mmm! I love these soft, bouncy, smooth, squishy Fungi! Hehe, I want to keep playing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "And you are...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "I'm Enghiene, and I was Turenna's drillmaster before she entered the Special Patrol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "I'm nothing like her, you hear? Nothing! I'm not going to grovel before you just because you're Super Zenith Boss-Level Forces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "Uh, so this super arrogant Melusine... used to be Turenna's drillmaster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "Don't worry, Golden Comet, Silver Companion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Ms. Turenna received new orders not long ago, and has returned to the Special Patrol's base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Before departing, she asked Ms. Enghiene to watch the event area in her place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "She loves Lil' Fungi's Fun-Tastic Fiesta, and we're always playing it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "That's right! I love both the tabletop game, and those round Fungi in real life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "They're soft, bouncy, smooth, and squishy... just like Tidalga... Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "Why are you drooling?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "I won't! I just want to hold them and rub my face against them. Haniyyah didn't mind when I pinched Kindlejoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "That's... That's the most you can do! Only we can hold Bongo-Head!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "You're so stingy! I want them both!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "Haniyyah said you're experts at the game. How about a round against me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "If I win, I'm going to hold and pinch Bongo-Head!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "Grr, she's looking down on us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#Let's do this, {NICKNAME}! As early adopters of the game, we need to show her what we're made of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "We're also the first champions of the Nilotpala Cup!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "We didn't earn these titles just to be this easily defeated!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "And the Twin Stars of Brilliant Valor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "You can't eat them! No eating Fungi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}