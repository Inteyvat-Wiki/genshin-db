			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Congshen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762130201,
					"content": "Dreams, illusions, bubbles, and shadows — why labor to grasp them? Even if you study the principles for a thousand years, if you keep your mind completely still and \"unborn,\" you simply won't understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130202,
					"content": "So... are you looking for a book?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "Have you ever been here before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130204,
					"content": "What?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Then you understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130208,
					"content": "Understand... understand what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "When you need to sleep, sleep. When you need to understand, understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130211,
					"content": "You should head back now. When the world ends, just go with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130209,
					"content": "And how could I understand that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "Yes, I have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "No, I haven't.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "You're talking in riddles. I'm leaving. Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "Go ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		}
	]
