			"dialogs": [
				{
					"id": 762130101,
					"content": "Huh? Looks like the books are in the way over here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130102,
					"content": "Are you looking for a book?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130103,
					"content": "Um... Not really. We're just wondering a teensy-weensy bit about what's inside there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130104,
					"content": "It seems we could get in there from the side...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "You can't go in there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130106,
					"content": "I move the books, and I move the books. If that is not so, then it is yet to be complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130107,
					"content": "I don't get it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "I move the books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130109,
					"content": "And what do you mean by \"move the books\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "If the books aren't here, then they must have been moved. All I do is cast my eye on them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130111,
					"content": "Then let me give it a try with Dex.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Go straight to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		},
		{
			"id": 7621302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
