			"dialogs": [
				{
					"id": 737130101,
					"content": "Ta-da! We're here! Let's go in from this shallow bit. It'll feel like we're walking into a painting — one that unfolds right before our very eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah... It's you. And you've brought some new companions? Are they... Fungi? I've only ever read about them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "What a lovely surprise, a Melusine's hanging out here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "Good to see you again, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "I'm not \"hanging out,\" I'm picking Tidalga for this year's pickled batch. A lot of the others have returned to the village to help too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Enghiene and little Roxane both took leave to come back and help. They're hard at work right now, and I'll be heading into the water myself in a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "You know... Enghiene wasn't wrong. The blue Fungi really do look a bit like Tidalga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Not in a food sense! I just meant they're cute. Nothing else...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Bongo-Head"
				},
				{
					"id": 737130111,
					"content": "Hehe~ You've got a good eye for cuteness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Our Fungi friends really are adorable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Anyway, really nice meeting you. I should get going — enjoy the rest of your time here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Okay, shall we head out too? We're gonna get some amazing underwater shots in Fontaine with our Fungi friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Melusines are just as lovely.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Hi, new Melusine friend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
