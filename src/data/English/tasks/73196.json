			"dialogs": [
				{
					"id": 731961601,
					"content": "Pursue happiness in life! Set sail from home to explore the world! Join the Adventurers' Guilt now! Membership for the first month only costs five Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961602,
					"content": "True knowledge can only be obtained from real practice. Losing your life in an arduous traverse is much more meaningful than lazing all your time away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961603,
					"content": "\"Look closer! This is from the Adventurers' Guilt, not Adventurers' Guild.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961604,
					"content": "\"What!? I paid for a year's membership! Can I get my money back?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
