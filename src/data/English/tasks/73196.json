			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "We sell a vast assortment of daily necessities. All of our items have been personally inspected by the owner. Quality guaranteed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960702,
					"content": "\"Dad, can you lend me a little more Mora? I heard the price of Ajilenakh Nuts will be skyrocketing soon. I'm certain I'll make a bundle this time.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
