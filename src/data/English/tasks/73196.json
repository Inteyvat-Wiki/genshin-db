			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "\"I once possessed endless wealth, but splurging could not calm my heart.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961002,
					"content": "\"After this trip, not one Mora is left in my pocket, yet I feel at peace.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961003,
					"content": "\"If you would like to hear my story, then come to my vegetable shop. Of course, it's best if you buy some vegetables while you're here.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319611,
			"completionStepIds": [
