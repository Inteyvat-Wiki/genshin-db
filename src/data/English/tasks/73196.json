			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "Hand-knitted carpets, a masterpiece of Sumeru art!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960502,
					"content": "Every resident of Sumeru should have one such carpet in their life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960503,
					"content": "Carpets may be priced, but art is priceless!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
