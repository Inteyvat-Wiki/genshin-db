			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "Ani's Dyes provides the most professional way to add exquisite new colors to your clothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961102,
					"content": "\"When can I collect the clothes I sent here last month?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961103,
					"content": "\"Our sincere apologies! My wife gave birth to our baby yesterday, so I didn't have time to work. Please return tomorrow. I'll make sure to have them ready by then.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961104,
					"content": "\"It's been three months. Just return my clothes. I don't want them dyed anymore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731961105,
					"content": "\"Sorry! Your clothes were stolen by a thief while being dried after the dyeing process. Please hunt down the thief if you want them back.\"",
