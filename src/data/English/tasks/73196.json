			"dialogs": [
				{
					"id": 731960201,
					"content": "This exchange makes every effort to ensure the accuracy and reliability of all provided information, but does not guarantee its accuracy and integrity in any form.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960202,
					"content": "All clients may not claim for losses arising from the usage of market information published on this Bulletin Board, whether in whole or in part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Have you heard of levitation? Have you seen someone flying? Would you like to discover the secrets of the flying Sumpter Beast? Then don't miss out on the Fontaine Flyers' first performance in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960302,
					"content": "Welcome, show's on! Don't miss out on this unique art show. Only five Mora for a ticket!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960303,
					"content": "Due to reports from the public, we have found that this performance has not been approved by the Akademiya. We have revoked their permission to perform and this ad will be taken down immediately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
