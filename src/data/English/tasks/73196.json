			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Our bank is about to open an office in Sumeru! Please look forward to it, our esteemed future customers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960402,
					"content": "If you have any business to take care of, please contact Viktor to have it done in our Liyue branch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960403,
					"content": "If you're thinking about taking out a loan, come consult our agent today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
