			"dialogs": [
				{
					"id": 731960901,
					"content": "Authentic desert barbeque! Using King Deshret's secret sauce and roasted with locally produced Spice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731960902,
					"content": "Great food and great drinks that everyone can enjoy!",
