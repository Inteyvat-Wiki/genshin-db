				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250221201,
					"content": "Ah, yes! Please, take these for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221202
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221202,
					"content": "Thanks to your help, I'm positive I'll be able to come up with the best recipe for Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221203
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221203,
					"content": "Hora, start eating properly again, alright? That's how you'll grow into a big, strong Tepetlisaurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221204
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221204,
					"content": "Rrooh, oroooo! Rrroooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				}
			]
		}
