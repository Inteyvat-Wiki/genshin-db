					"Hora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250220401,
					"content": "Whoa, that's one big fruit! It should be enough to fill him up, from the look of it. Fancy a go at it, Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220404,
					"content": "Wroo, rrooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220405,
					"content": "(Hora starts chomping away, and before long it's all gone.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220406,
					"content": "Oroooo! Rrroooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220407,
					"content": "Hahaha, gone in a flash. You must have liked that a lot, huh, kiddo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "Wroo, rrooh! Hroooo—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220409,
					"content": "Great! I'll go find someone to ask in a bit, see if anyone knows where to find Inazuman merchants. I need to get my hands on more Lavender Melons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
			"id": 2502205,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
