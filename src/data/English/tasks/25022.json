				"objectNames": [
					"Hora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250220501,
					"content": "This one smells pretty good. Real refreshing aroma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "Hora? You... Well, would you look at that! He's only gone and eaten it whole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Hora swallows the Qingxin in a single gulp, then blinks at you...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220506,
					"content": "Hora suddenly turns around and eats up the half bowl of fruit next to him, all in one go...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Hora's appetite seems to have returned all of a sudden... How did that happen? Was it really all thanks to this Qingxin thingamajig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "I—I have to talk to the vet about this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
