				"objectNames": [
					"Hora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250220301,
					"content": "Now that's a pretty flower. Nice-sounding name, too... Hora, fancy a bite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "Wroo, rrooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora chews it carefully, as if savoring the flavor of the petals.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220306,
					"content": "R—Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Oh! From the way he looks, I'd say he likes it a lot. But flowers on their own won't be enough to fill him up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Plus, this type of flower sure doesn't look cheap... Anyway, I'll just go ahead and write it down for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "How do you make flowers into food? Oh, maybe we can... mix them into some kind of cake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
			"id": 2502204,
