			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Thank you! Let's try the first type, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390502,
					"content": "#Don't drink too much of it, {NICKNAME}! Just spit it out if something feels off, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Don't worry, Paimon, I'll be fine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Hmph. Paimon's just worried, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "I'm ready. Pass me the potion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "This one's called the Super-Duper Potion, and it'll make you super strong! Well... in theory, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390507,
					"content": "You take the potion from Verenata and drink it in one go.\\nIt has a pungent odor that's hard to bear, but it tastes sweet and sticky, and isn't hard to swallow.\\nOtherwise, however, your body has no reaction to it.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "At her direction, you then wait until some Breacher Primuses become active.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
