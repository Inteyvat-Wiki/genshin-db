				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "U—Um, so, did you defeat those creatures so easily because of the Super-Duper Potion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "Exactly! You could even say it gave me Super-Duper Powers!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "What kind of awful advertising slogan is that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Ah, thank you, thank you! So it was due to the potion's effects, then. I guess that's a Master Potioneer's recipe for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390609,
					"content": "Alright then. Let's bring the Super-Duper Potion testing to a close first. Next, let's test this Coasty-Toasty Potion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390610,
					"content": "Did you, uh, come up with these names yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "No, I'm no good at making up names, so I just let others help me come up with much better ones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390612,
					"content": "Well, don't say that... Really, and for something like potions, the name should let you know what it does right away anyway, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Hmm. I've never heard that before... But you're right! That's what a Master Potioneer should be like!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390614,
					"content": "#*cough* A—Anyway, are you ready to test this potion, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390615,
					"content": "Sure, let's start.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Oh boy, this one smells like a disaster too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "Theoretically, this Coasty-Toasty Potion will spare you from the effects of the cold and keep you warm! Yeah. Probably.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390618,
					"content": "You take the potion from Verenata. It smells like dusty, musty old leather...\\nYou hesitate for a moment before drinking it all in one gulp. It's not a bad tasting drink, being spicy with hints of cinnamon and ginger... It reminds you of a crackling fireplace on a rainy day.\\nOtherwise, however, your body has no reaction to it.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Afterwards, you rest for a while at her instruction.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "I didn't feel much, but it was pretty sweet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Eh? But it smelled terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Huh... Is that so? Did I get something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390608,
					"content": "Don't be so down. At least it wasn't poisonous... We can take that as a win, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403907,
			"completionStepIds": [
				7403906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403906",
