						"rawParams": [
							"7212305",
							"2"
						],
						"stepId": 7212305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "P—Please don't kill me! I had nothing to do with the Thunder Sakura, I swear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "Aaaand how did you know that we were here about the Thunder Sakura stuff? Guilty conscience, much?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Paimon bets you got this Electro Hypostasis-like thingy from some dirty business, didn't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "Y—You... What's that got to do with you, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "Well, it's my job.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "That's right! We've been asked to right wrongs and see justice done! Out with it, then! We'll have you tell us everything the Treasure Hoarders intend to do with the Thunder Sakura, and where you got this thing from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "If you don't talk, hehe, well, you'll taste the super formidable bite of this Traveler's sword!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "I—I'll talk! B—But it's not as if anyone cared about these trees anyway! Can't a man and his brothers make some money off their power?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "We had a big-shot buyer who was interested in these trees, and they even provided us with the means and tools to extract their power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "As long as we did as they said and opened up a gap in those trees, we could use those tools to collect the Thunder Sakura's power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Then all we'd need to do was to direct that power into this crystal, and hey presto, we'd have something worth three Tenryou Commission mansions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "They gave us a huge sum of money, too! Not a sum you small-timers could ever spend in your life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "If you'll just let me go, I'll give you a share! Ten percent to you, and ninety to us. How's that sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Too little, buddy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "What? You know what, I'm done letting you get off easy. Once our buyer gets here, you'll be the one begging for mercy from Lord Hideaki over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "You sure know how to talk big, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Listen, you cocky little imp! My brothers are coming here to rescue me any time now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "It doesn't matter who you call or how many. You won't touch a hair on Paimon's head before the Traveler sends you all running.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Yamada, did you hear that? This little pipsqueak said that you can't hurt her! You gonna take that lying down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "Yamada? Who's that? Traveler, quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "Eh? There's no one there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Dream on, kiddo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Have you made any discoveries?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "About Hideaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "So that's what's going on... But Treasure Hoarders are just petty thieves. Could their juvenile antics really cause this much havoc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "I suspect there must be other reasons why the Thunder Sakura are withering... I have my suspicions, but I can't say for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "What do you mean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "This is Kannazuka, where neither the Inazuman faith nor Sangonomiya's has any influence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Ever since the Vision Hunt Decree was promulgated, conflict often breaks out here between the Shogun's Army and the rebels. I don't think either side cares whether the Thunder Sakura become collateral damage in their war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "To quote Lady Miko, \"Honors and accolades are all these military types care about.\" They will not listen to reason.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "We were well prepared for this, but we hadn't expected the Thunder Sakura to be in quite as terrible a condition as they now are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "Anyway, here and now, the most pressing matter is to put a stop to the Treasure Hoarders' juvenile antics. Traveler, can I entrust this to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "You got it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "Please don't get careless. The Thunder Sakura being weakened makes the situation very dangerous indeed. After all, these trees serve to suppress the one who lies beneath...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "Ah, I've said too much... P—Please forget you heard me say that. In short, please exercise extreme caution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "I also need some time to work through my findings. One major outstanding question is: Who is directing the Treasure Hoarders behind the scenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "This case is becoming more and more complicated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Sounds straightforward enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "I fear it may not be as straightforward as you presume. The Thunder Sakura being weakened makes the situation very dangerous indeed. After all, these trees serve to suppress the one who lies beneath...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212314",
							"2"
						],
						"stepId": 7212314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "How is the situation with the Thunder Sakura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230402,
					"content": "The \"juvenile antics\" have been dealt with.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Wonderful, that will at least stabilize the condition of the Thunder Sakura. I'm sure Lady Miko will also be relieved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "How dare these crooks brazenly seek to steal the power of the Thunder Sakura for their own gain. Their actions are unforgivable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "You also mentioned that the Treasure Hoarders have some sort of crystal cube at their camp with which they're trying to collect the Thunder Sakura's power? That is incredibly dangerous... It must be dealt with as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "You've already helped me out enormously, so I couldn't possibly ask you to deal with this all by yourself once again. I will join you this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "There's no time to delay. Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
