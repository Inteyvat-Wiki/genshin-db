			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "Ugh! Just my luck, bumping into this kind of opposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "You shameless villains. Conspiring with the Fatui... the Great Narukami will strike you all down sooner or later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "Huh! Don't you go thinking you've got the best of me just because you successfully interfered in my business. I still have an ace up my sleeve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212319",
							"2"
						],
						"stepId": 7212319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "S—Stop chasing me, please... We've run this loop three times, I can barely walk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "You lowlifes, consorting with outlanders for profit! There would be no mercy for you, even if we ran another ten rounds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "Phew... From the relaxed look on your face, Traveler, I assume you've dealt with that little problem. Thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "The Thunder Sakura's power cannot be allowed to fall into the hands of these types, much less be handed over to the Fatui in the shadows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "It is hard to say what the Fatui have planned, but since we've captured this little lackey of theirs, I will be sure to get some answers from him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Leave the cleanup to me. The Shogun's Army's positions are well known to me. This man will not escape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
