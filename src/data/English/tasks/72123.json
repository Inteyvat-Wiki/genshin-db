							"7212315",
							"2"
						],
						"stepId": 7212315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Hmph. So, it's a meddling maiden from the shrine getting in the way of our money-making.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "Money-making? You scoundrels. How dare you have designs on the Thunder Sakura. Lady Miko will not let you off easy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Pah! Big talk, but you're forgetting who you're messing with!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "Master, that Traveler over there's the one who's been getting in your way. Our deal's gonna be in jeopardy if you don't help us out here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Hehe. You're going to act tough in front of me, small fry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Skirmisher"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212317",
							"2"
						],
						"stepId": 7212317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
