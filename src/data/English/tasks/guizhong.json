			},
			"dialogs": [
				{
					"id": 10151101,
					"content": "Well, as it stands, we've hired helpers, and we've acquired the Everlasting Incense. The completion of our preparations is not far off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151102,
					"content": "Whew... Finally!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151103,
					"content": "Well, Traveler, have you gained anything from our adventure so far?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151104,
					"content": "It's been... odd.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151105
					]
				},
				{
					"id": 10151105,
					"content": "Odd?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151106,
						10151107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151106,
					"content": "I'm not sure if we've been living the high life...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				},
				{
					"id": 10151108,
					"content": "Haha, which is it, I wonder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151109,
					"content": "The questions that such travels raise are ever so complicated. Well, I'll leave you to ruminate over it yourself. As to remuneration for your help, I've decided...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151110,
					"content": "...to treat you to a meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151111,
						10151112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151111,
					"content": "Zhongli... treating?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151113,
					"content": "Oh? Ah yes, don't worry. I will remember to bring the Mora this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151114
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151114,
					"content": "Tonight, I shall take you both to an old hole-in-the-wall, praised throughout Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151115,
					"content": "Hole-in-the-wall? As in... a cool restaurant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151116,
					"content": "Indeed. Let us meet near the harbor at \"Third-Round Knockout.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151112,
					"content": "Wow. Amazing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151107,
					"content": "Or experiencing the struggles of the poor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				}
			]
		},
