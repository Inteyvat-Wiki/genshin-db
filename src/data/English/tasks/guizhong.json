					"nextDialogs": [
						10151404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151404,
					"content": "A search using the Guizhong Ballista revealed no significant life forms nearby, save for the usual wildlife.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151405,
					"content": "What's more, a contraption built using adeptus technology should have no trouble detecting an \"adeptibeast\" as Qiqi put it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151406
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151406,
					"content": "Which means...",
					"roleType": "TALK_ROLE_NPC",
