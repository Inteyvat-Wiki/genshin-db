					"nextDialogs": [
						10151410
					]
				},
				{
					"id": 10151410,
					"content": "We won't solve anything while standing here and racking our brains. Let's return to Bubu Pharmacy, explain that we could not find a Cocogoat, and review our next step.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151411,
					"content": "Good idea. We did our best, and that's what counts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151408,
					"content": "Repairing this was a complete waste of time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151409
					]
				},
				{
					"id": 10151409,
					"content": "Paimon wouldn't go that far. We did something positive, right?",
