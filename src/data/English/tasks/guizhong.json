	"talks": [
		{
			"id": 101503,
			"completionStepIds": [
				101503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101503",
							"2"
						],
						"stepId": 101503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "It's huge! Paimon can totally believe it took an adeptus to build this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "But... how do you operate this thing? Just think how much strength you would need...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "Hmm... It is currently inoperable, in any case. This device is broken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "Aw, what? It broke!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "After millennia of wear and tear, even adepti contraptions are difficult to maintain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "So what're we gonna do? Quick, Mr. Zhongli, use your unlimited high-society knowledge powers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Hmm. You almost make it sound like I'm some sort of... bourgeois parasite, whose only utility lies in providing quaint pieces of trivia on demand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "That said, let me think for a moment... Ah yes. Spare parts were made for the Guizhong Ballista when it was first built, in case it was damaged in battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "As I recall, there is a military supply post from that period somewhere inside the Pass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "If we can retrieve the spare parts from where they are stored, we may be able to repair the Guizhong Ballista. One just needs to understand the basic working principles of the device.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "So... what you're saying is that you actually understand the working principles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "I have a smattering of knowledge on the topic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "With the <color=#00E1FFFF>parts</color> in hand, I could at least tinker with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "These parts look useful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "One moment, I will try to repair the device...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "It is done. The Guizhong Ballista is more intricately designed than I thought.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Woo! Now how do we turn it on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "It's easy enough. We simply need to do this... Look, it even has a scope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Over here we have... Nothing. And over there... More nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "Hey! Just what do you think you're doing!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150607,
					"content": "So, you've fixed up this turret... because you're planning to do what, exactly!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150608,
					"content": "Not a turret. A Guizhong Ballista. Also, kindly state your name before you ask a question, it's just good manners.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Hah! Are you blind or something? You're looking at the leader of the Treasure Hoarders, old man!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150610,
					"content": "This area's supposed to be chock-full of hidden treasures, but you can't get anywhere near them with this thing keeping watch. It might look like any other mechanical device, but trust me, it's got a mind of its own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150611,
					"content": "Last time we approached the mountain, it nearly skewered one of our guys...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150612,
					"content": "A few of us risked our lives to disarm it — which, amazingly, we managed — and then we turn our backs for two seconds and you've ALREADY GONE AND REPAIRED IT!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150613,
					"content": "The next thing you'll be repairing is your faces, and that's if you get out of this alive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150614,
					"content": "Tut-tut. Vandalizing the legacy of an adeptus for selfish gain. Disgraceful behavior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "It is not we who need reprimanding, but you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Quite right! Let's get 'em, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Forgive us, we were unable to fulfill our end of the contract. We found no trace of the Cocogoat adeptibeast of which you speak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Ah. What a disappointment. Don't worry about it. But I feel very disappointed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Aw, poor Qiqi... Why does Paimon feel so guilty all of a sudden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi, do you have any other clues?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Cocogoat milk is tasty. So tasty. Much better than normal goat milk. Only an adeptibeast could make such tasty milk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "I'm sorry. I have a poor memory. I cannot remember the name of the milk. That's why I wrote it down. Where did I put it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ah. Here. This is the name. \"Coconut milk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Ehh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "I owe you both an apology. I hastily agreed to what appeared to be an equitable agreement with this zombie child, when perhaps I should have undertaken further due diligence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Never mind Zhongli, you didn't know. As the Liyue proverb goes, \"All things are random, and... so how are you supposed to predict anything.\" Literally no one could have seen this coming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Excuse me, everyone. Did Qiqi say a bad thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#Ooh... Sorry, {NICKNAME}, but Paimon's gonna leave the job of shattering this poor kiddo's world to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "It's time to tell you where coconut milk comes from...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "No... Im—Impossible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Seems Qiqi took this pretty hard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "She just needs time to work through it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Haha, someone learnt a valuable life lesson today, then? Thank you all for looking after my little Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Might I ask, who...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Ah, how rude of me. I'm Baizhu, boss of the Bubu Pharmacy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Paimon thought Qiqi was the boss... turns out it's some wacko who wears medicinal ingredients around his neck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "What a sorry state of affairs... This little mascot is even more of a simpleton than Qiqi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "Ah! The medicine— The snake is s—speaking!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Wow, a talking snake!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Hmph! I prefer to stay silent. But faced with strangers, I must speak, lest you mistake me for an escapee from the medicine cabinet, for I am a living, breathing, serpent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Hahaha, don't mind Changsheng, she's a good girl, really. As for you three... Communal chaos-causing with Qiqi aside, what business brings you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Do you sell Everlasting Incense in this fine establishment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Everlasting Incense? Why, of course we do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Phew, at last! Things are finally starting to come together—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Three million Mora, top quality, guaranteed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "Three million!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "You might as well just rob the Golden House! Oh, but the Qixing have taken it over for now... Security will be tighter than usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Hmm... Three million... An innocuous number in and of itself, though practically speaking, it could be a hard sum to come by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "It's a crazy number! We'd never be able to make that much Mora, and as for Mr. Zhongli... he's around three million short.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "This is correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "No shame...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "What're we gonna do? Is this the part where we go crawling back to Childe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "Bwahahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150745,
					"content": "Cocogoat! Cocogo— Ahahaow my sides hurt... Oh my goodness, I cannot BELIEVE you fell for that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150746,
					"content": "Hey! Less laughter, more sympathy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "I'm almost in tears over here... Ah, thank you, that was the best laugh I've had in a long time. In return, I'm more than happy to sort out this mess you've managed to get yourselves into...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150748,
					"content": "Excuse me, sir... Dr. Baizhu, isn't it? Truly honored, I'm Childe, one of the Fatui Harbingers. Forgive my audacity, but I see a great many opportunities for us to collaborate in the future...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150749,
					"content": "If Bubu Pharmacy needed a stable supply of, say, coconut milk, the Fatui could help by setting up a robust and speedy distribution network.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150750,
					"content": "Strange... I knew the Fatui infiltrated businesses with seductive deals, but... So much fuss over coconut milk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Coconut milk. Baizhu. Quick. Qiqi wants coconut milk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Ah... Yes, of course, Qiqi, anything you want... Th—Thank you, Childe. I look forward to a successful collaboration in the future. I can give you a discount on that Everlasting Incense too, let's say... 2,990,000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "That's like, zero difference from three million!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Hmm... 2,990,000... Also an innocuous number in and of itself, though practically speaking it is a whole ten thousand less than the original sum of three million.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Well, now that this is settled, we must head back to Yujing Terrace. Mr. Childe, Dr. Baizhu, Little Miss Qiqi, see you soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "That lot is an absolute riot. Honestly, I can't remember the last time I laughed so hard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150757,
					"content": "So. You've been eavesdropping, I hope. What have I missed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150758,
					"content": "Yes, Master Childe. They spoke of the Qixing taking the Golden House...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Well, well, well. Ningguang and her Qixing cronies. What else would they be hiding in the Golden House... if not the Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150760,
					"content": "#I apologize, {NICKNAME}. But I warned you, didn't I? As the old Liyue saying goes: \"The walls have ears.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150737,
					"content": "You might as well just rob the Golden House!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Too bad, the Qixing have taken it over for now... Security will be tighter than usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Nothing in Liyue surprises me anymore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "They all need to grow up sometime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "It all begins with the fruit of the coconut tree...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "What do you need this Cocogoat for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "Oh, there you are! But you can't even reach the counter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "Is she... a zombie!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "Ah... Paimon thinks you might be right! Look at the talisman on her forehead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Welcome to Bubu Pharmacy. I am Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Once upon a time, Qiqi died. Then, Qiqi was saved by the adepti. Now, Qiqi is a zombie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Such nonchalant delivery for a bombshell revelation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Something like this would be unimaginable in Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Hello... little girl. Do you sell Everlasting Incense here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Excuse me, sir. Did you bring your prescription?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "I... Surely no prescription is needed to purchase Everlasting Incense? It's not a controlled substance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Qiqi can get your medicine. But only if you show Qiqi your prescription. These are Qiqi's orders, from Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "\"Orders\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Zombies are limited to acting within the confines of their orders. And somehow, in this case, the zombie issues her own orders to herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "My dear Qiqi, we didn't bring a prescription, I'm afraid. But we do hope that you can still help us find some Everlasting Incense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "Okay then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "How did you manage that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "But. Qiqi helps you, you help Qiqi. Only fair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Since when do customers need to do favors for customer service staff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Never mind, just think of it as a peer-to-peer transaction. That way everybody wins. Sometimes, in Liyue, the art of the deal is simply about victory via mental gymnastics.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Go to Mt. Tianheng. Find the Guizhong Ballista. And hunt a Cocogoat. Please and thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Hunt the what with the which at where?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "Guizhong Ballista... I have heard of this device before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "It is a kind of crossbow turret, installed on Mt. Tianheng by an adeptus in the distant past. An early mechanical device.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Located in Tianheng Pass, it was designed to automatically fire at large monsters, protecting Liyue from external threats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "Mr. Zhongli really knows Liyue inside out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Apparently, not quite... This is the first I have ever heard of the \"Cocogoat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "The Cocogoat is a legendary animal. An adeptibeast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "Did you wanna add anything else, or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150938,
					"content": "No. Just that the Cocogoat is a legendary animal. An adeptibeast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "What it looks like: don't know. Where to find it: don't know either. Where it came from: also don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Do tell us if you remember anything else you don't remember...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Very well then... Let's start by investigating near the <color=#00E1FFFF>Guizhong Ballista</color>. Perhaps we will find some clues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "What the heck is a Cocogoat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "This isn't much to go on...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "She's playing games with us...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "I don't believe so. The Guizhong Ballista, at least, I have heard of before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150918,
					"content": "Why is she being so difficult?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "I'm afraid that she's probably right — it's to do with her orders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "Do zombies also count as adepti...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Paimon, if we're going to talk about height, you ahh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "Joke's on you — Paimon floats, so height is no restriction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150906,
					"content": "Anyway, there's something weird about this one over here. What's that talisman doing on her forehead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150907,
					"content": "It can't be... she's... a zombie!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
