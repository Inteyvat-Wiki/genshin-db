			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "Hello there! I'm Daya from Kshahrewar. Are you here to take part in the Wisdom Gala too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "This is the new game that our Darshan has put forth: \"Project Connectivity\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "Would you like to have a go at it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "If I recall, Kshahrewar's specialty is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "We study mechanics and architecture, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "Uh, seems like I've gone off-topic. So, to take part in this Gala, many of our students put their heads together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "...And the result was \"Project Connectivity!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Basically, players will need to use the various objects that we have prepared to... well, create a pathway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Laying down bridges, setting up stairs... The eventual goal is to create a path for people to travel on that can reach its destination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Once you have finished constructing that road, we will conduct a final verification, just like how we would test completed buildings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Essentially, you just need to set up a safe road to attain success.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "That sounds rather complicated...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Don't worry, don't worry! You're not being asked to construct anything in real life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "If something goes wrong and the road collapses, we'll just have to rebuild it. We're not putting limits on the number of tries you have either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "Just let your imagination run free and build as beautiful as a road can be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Alright. In that case, if you'll look over this way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "Sorry, I'm a little busy right now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Ah, is that so... It's alright. Our booth will be open for the entire duration of the Gala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Whenever you feel like having a go, you can just come to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "I haven't much of a knack for architecture.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}