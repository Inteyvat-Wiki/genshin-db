			"dialogs": [
				{
					"id": 730980401,
					"content": "Hmm... Let's take a look. It seems like a new treasure map!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "Aren't we going to help \"the trapped Aranara\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#Ahem! We haven't found the house owner. This is worrying! So, {NICKNAME}, why don't we check some other places shown in the painting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "After we get there, we could...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Find more treasure?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Yes! Wait, Paimon means... no! Find the trapped Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "And what an interesting \"mailbox.\" It may receive some new paintings later. We should keep an eye on it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Find \"the trapped Aranara\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Yes! We might even find some treasure!",
