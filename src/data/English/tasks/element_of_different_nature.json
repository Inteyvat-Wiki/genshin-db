			"dialogs": [
				{
					"id": 3180201,
					"content": "Did... did you just feel the power of Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180202,
					"content": "Your connection to the elements is so different from the Vision bearers'! Seems like you can physically switch between elements...",
