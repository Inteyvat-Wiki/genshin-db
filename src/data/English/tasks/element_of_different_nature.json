					"nextDialogs": [
						3180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180203,
					"content": "If so, then you just need to make an offering to a Statue of The Seven and the elements will respond — just like they did in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180204,
					"content": "We're now in Liyue, which is ruled over by the Geo Archon. That's why the statues here look a bit different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180205,
					"content": "If you ever miss using your Anemo powers, you can just get them back from a Statue of The Seven in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
