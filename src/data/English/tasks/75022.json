				]
			},
			"dialogs": [
				{
					"id": 750220404,
					"content": "Ehh, it won't wake up? Ugh, so annoying! D'you think it's just pretending to be asleep?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220405,
					"content": "Ehrrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "It does seem to actually be asleep...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "(You relate the contents of the sleep-talk...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "Are you saying it's intentionally blocking the way just to get food, cheating people out of their grub... Ugh. We fell for it hook, line, and sinker...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220410,
					"content": "Hmph! But if that's how things are, then we don't have to play nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220411,
					"content": "#Let's just have {REALNAME[ID(2)|SHOWHOST(true)]} tunnel over and get to that chest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220412,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "If it's gonna take the low road, we can't be expected to play fair either!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220407,
					"content": "And sleeptalking, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
			]
		},
