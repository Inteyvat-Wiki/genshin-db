			},
			"dialogs": [
				{
					"id": 750220606,
					"content": "What were you mumbling about just now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220607,
					"content": "*grumble*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Strange Yumkasaurus"
				},
				{
					"id": 750220608,
					"content": "Hey, could it be you're really hungry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "A Saurian here all by itself, and no master in sight... It probably isn't even able to find its own food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#C'mon, {NICKNAME}, let's go help find it some food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Once it gets full and moves out of the way, the treasure will be all ours! Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "What should we feed it, though?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Let Paimon think for a sec! Saurians here tend to eat a bit of everything, and Paimon isn't sure what Yumkasaurs eat... Looking at its color, it feels kinda like it should eat leaves and grass and that kinda thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
