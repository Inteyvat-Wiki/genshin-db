					],
					"speakerTitle": "Strange Yumkasaurus"
				},
				{
					"id": 750221009,
					"content": "#Looks like that didn't work... *sigh* And even if they could understand each other, it's not like we could talk with {REALNAME[ID(2)|SHOWHOST(true)]} either.",
					"roleType": "TALK_ROLE_NPC",
