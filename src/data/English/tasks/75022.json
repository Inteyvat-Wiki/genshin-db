					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220703,
					"content": "The Yumkasaur downs the food in front of it in a flash.\\nYou almost don't even manage to see just how the feat was accomplished...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
