				{
					"id": 761870401,
					"content": "Hehehe... This food is delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870402,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870404,
					"content": "Huh!? So soon? Thank you, Miss Sandrone! I hope to see you next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamere"
				},
				{
