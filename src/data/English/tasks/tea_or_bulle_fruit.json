			"dialogs": [
				{
					"id": 761870301,
					"content": "Please accept my gratitude, Miss Sandrone, on behalf of Miss Mamere, for your kind invitation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Mmhmm, this food is delicious. Thank you, Sandrone. Your culinary skills are amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870303,
					"content": "I'm glad you like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870304,
					"content": "But Prototype 4ACV07, I believe this is the first time we've met? How did you recognize me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870305,
					"content": "Whoa, that's the first time I've heard anyone call Seymour that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870306,
					"content": "Affirmative. Although I am familiar with your gentleness and radiance, I have never seen you in the flesh before, Miss Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "I can recognize you because your appearance is an exact match of my master, Miss Mary-Ann Guillotin. Her image is permanently recorded in my memory unit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Miss Mary-Ann told me about you. Since your appearance matches hers, the logical reasoning required to recognize you is quite simple, Miss Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Hah, even Alain's earliest work is so impressive. Though it appears you've had a few enhancements made... I suppose I should address you as Seymour now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870310,
					"content": "Were you confused when you saw me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870311,
					"content": "Negative. My primary directive is to accompany and protect Miss Mary-Ann on behalf of Alain Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "As such, my knowledge of Miss Mary-Ann is complete. And based on a logical analysis of finite-dimensional vector spaces, you and Miss Mary-Ann are totally different, Miss Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Like the difference between the tea leaves of Chenyu Vale and the Beryl Region's Bulle Fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Is Sandrone the tea or the Bulle Fruit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870315,
					"content": "Searching... Insufficient data. Unable to answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*sigh*... I'm glad Alain improved his language module design by the time he created me.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
