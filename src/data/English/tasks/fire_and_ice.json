			"dialogs": [
				{
					"id": 761830201,
					"content": "It's important to find time to relax now and then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830204,
					"content": "Very well. I'll see you in Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761830203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
