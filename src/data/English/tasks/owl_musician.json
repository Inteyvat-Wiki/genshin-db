				]
			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#Welcome to Constellation Metropole, {NICKNAME}, Ms. Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710102,
					"content": "My colleagues have apprised me of your names and deeds, and have confirmed that you are valiant indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710103,
					"content": "Were I not in charge of training the guards, I should have liked to spar with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710104,
					"content": "So you're a guard yourself, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "In sooth, I am. On the orders of our liege, we are to defend Constellation Metropole and keep the peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710106,
					"content": "My work, specifically, is to train the guards, that their skills may prove worthy of their duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710107,
					"content": "So the door behind leads to the training grounds?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "Keen-eyed indeed! It leads to a Domain that we just finished remodeling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710109,
					"content": "Within those grounds, the trainee must swing their blade to a specific rhythm, and the arena's lighting will constantly change throughout the battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710110,
					"content": "Sounds like some pretty rigorous training...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "Sounds complicated, more like... Do you have to follow that specific rhythm while fighting as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790710112,
					"content": "This part of the regimen is actually derived from a story titled \"The Owl Musician.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710113,
					"content": "It was popular amongst the guards some time back. Many enjoyed it to the point where they'd forget to take part in training, and their daily patrols were delayed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710114,
					"content": "But I had a thought. Since everyone liked it so much, adding elements of the story into our training would make it more enjoyable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710115,
					"content": "It has had a visible effect on training... if nothing else, there have been no further delays in our patrols due to personal reasons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710116,
					"content": "Hehe... Would the two of you be interested in said training?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710117,
					"content": "The challenges within should be a piece of cake for those with valor such as yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710118,
					"content": "I'd love to give it a try!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "Such commendable courage! Excellent. Please, then, step into the Domain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710120,
					"content": "I've got other things going on right now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "Understandable. Come back whenever you have the time — I will be standing guard here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				}
			]
		}
	]
}