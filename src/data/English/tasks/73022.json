			"dialogs": [
				{
					"id": 730220501,
					"content": "*snore* *snore*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220502
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220502,
					"content": "Araphala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220503,
					"content": "Huh? Oh, it's Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220504,
					"content": "#Yeah, we are here to tell you that {NICKNAME} has taken down the huge monster outside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220505,
					"content": "#Whoa! I didn't expect Nara {NICKNAME} who looks smaller than the monster to be so strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220506,
					"content": "It was alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "Alright, then let's go. Good Nara, let's eat fruits together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220507,
					"content": "It was quite difficult.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
			"completionStepIds": [
				7302204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302204",
							"2"
						],
						"stepId": 7302204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araphala",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "Okay, let's start cooking with the Unrivaled Fresh Fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220602,
					"content": "What's the difference between this \"Unrivaled Fresh Fruit\" and ordinary fruits?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220603,
					"content": "I understand. To Nara, all fruits may be the same, but they are different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220604,
					"content": "Only strong trees can bear Unrivaled Fresh Fruits. Strong trees sing first when the wind blows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220605,
					"content": "The bearings of the strong trees, these Unrivaled Fresh Fruits, are a blessing to us. That Nara friend said these fruits are so tasty they sing in your stomach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220606,
					"content": "Paimon can't wait to see what kind of delicacy will be made from them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220607,
					"content": "Araphala starts cooking right away...\\nHe divides the fruits equally...\\nThen, he gives a few portions to you and Paimon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "You try the fresh fruits together.\\nIt sort of lives up to your expectations. They do taste like fresh fruits.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "So good. Thank you, strong trees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220610,
					"content": "Wait! You call that cooking?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220611,
					"content": "The Unrivaled Fresh Fruit itself is the best Supreme Delicacy. It doesn't need any extra processing to present its best taste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220612,
					"content": "Just taste it and you will understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220613,
					"content": "It is tasty, but it's just... it's just like eating fruits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220614,
					"content": "It is a fruit after all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "Yeah, Paimon guesses so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220616,
					"content": "Don't you Nara have a dish where you cut fruits and serve them on a wooden board too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220617,
					"content": "Huh? Do we? Wait! Are you talking about a fruit platter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220618,
					"content": "Is a fruit platter considered a dish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220619,
					"content": "I think so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "It still seems a bit strange to Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220623,
					"content": "Oh, don't be a stickler for things like that. Finding better ingredients is a form of cooking too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220624,
					"content": "While searching for ingredients, I can travel the forest and get closer to it. That's the true meaning of my cooking training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220625,
					"content": "Is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220626,
					"content": "It sure is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220627,
					"content": "I've picked Unrivaled Fresh Fruits and made my Supreme Delicacy. My cooking training is complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220628,
					"content": "I can return proudly to Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220629,
					"content": "#Oh, I would've missed Festival Utsava if Nara {NICKNAME} and Paimon didn't take care of that huge monster that blocked me here in this cave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220630,
					"content": "Alright, hurry back to Vanarana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220631,
					"content": "Indeed, indeed... Sister will scold me if I miss Festival Utsava... Just the thought of it is scary enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220621,
					"content": "I don't think so...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "Right? It's kinda strange to call something that hasn't been, y'know, processed... a dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Paimon"
				}
			]
		},
