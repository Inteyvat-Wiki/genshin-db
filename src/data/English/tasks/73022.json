			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "Oh? It's you. Long time no see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220302,
					"content": "Whoa, where am I? Is this a cave? Ugh... I'm feeling dizzy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220303,
					"content": "Who are you? Why are you sleeping here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220304,
					"content": "Who am I... Ugh, so dizzy. Let me think... My name is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220305,
					"content": "My name is Araphala! Hehe, I remember now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220306,
					"content": "So you're Araphala! We were wondering where you'd gone... and here you were, sleeping in this cave the whole time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220307,
					"content": "Araphala... You know my name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220308,
					"content": "Eh? Nara!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220309,
					"content": "He's wide awake now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220310,
					"content": "Indeed he is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "*sob* I'm not ready yet. Don't make porridge out of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220312,
					"content": "Huh? Why would anyone want to make porridge out of you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220313,
					"content": "M—My sister said that if I'm always half asleep like this, a bad Nara will take me and make porridge out of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220314,
					"content": "You do look pretty tasty!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "Waaaaaah!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220316,
					"content": "#Hey! {NICKNAME}, don't make jokes like that! Araphala, no one will cook you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220318,
					"content": "...Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220319,
					"content": "Really!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220320,
					"content": "Not kidding?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220321,
					"content": "#No kidding! Anyway, Paimon's name is Paimon, and this tall Nara is {NICKNAME}. Arapacati sent us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220322,
					"content": "Arapacati? Is she doing well? How long have I been here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220323,
					"content": "\"How long,\" you say? Well, if Paimon recalls correctly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220324,
					"content": "Uhh... Many, many moons ago, the seedlings sprouted from the earth, and became trees... How many Arapacatis tall were they again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220325,
					"content": "Seven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#Whoa! As expected of {NICKNAME}! What an amazing memory!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220329,
					"content": "Oh, it's been so long. Oh no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220330,
					"content": "Anyway, let's bring you up to speed. Festival Utsava is coming up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220331,
					"content": "You bring Araphala up to speed on the events so far...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "Ah, it's time for Festival Utsava, is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220333,
					"content": "Yeah, so Arapacati wants you back in Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220334,
					"content": "Ugh... But I haven't completed my cooking training yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220335,
					"content": "Huh? Weren't you sleeping? Paimon thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220336,
					"content": "\"Sleeping\"? Oh, I was just thinking about the past. It wasn't that serious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220337,
					"content": "Huh? Is sleeping something serious for Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220338,
					"content": "Hmm... How should I put this... We hibernate when we are in grave danger, and we compress our memories and dreams into a seed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220339,
					"content": "If the crisis is averted and the time is right, the seed will return to the forest and grow into Aranara again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220340,
					"content": "It sounds really tough...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "But I know that all Nara must sleep. I had a Nara friend once, a Golden Nara just like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220345,
					"content": "#I once came here with {F#him}{M#her} to gather the Unrivaled Fresh Fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220346,
					"content": "#So, I've been picking them here since then. If {F#he}{M#she} returns, or if I make new Nara friends, we can eat them together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220347,
					"content": "I've picked so many of them this time... Eh? Where did they go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220348,
					"content": "So, it's you who dropped those Sunsettias we saw all along the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220349,
					"content": "Did I drop that many? But it's okay, hehe... I've kept the freshest and tastiest with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220350,
					"content": "But still... How did I drop so many...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220351,
					"content": "I remember leaving with my brothers for cooking training. But they didn't know that fresh fruits are the best ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220352,
					"content": "But while I was picking fruits... Yes, while I was picking fruits, a really huge monster appeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220353,
					"content": "That huge monster was five Araphalas tall and had a long tail. Even the ground quaked beneath its stomps. Besides that, I think I sensed Marana's aura inside it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220354,
					"content": "And it was so tough! Even if Arama and Arabalika were there, it would take them some effort to tear it apart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220355,
					"content": "Wait!? They are that strong!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220356,
					"content": "Yes, but I'm not. So, I had to hide here. I was thinking about the past as I waited for it to leave, and the next thing I knew, you two were standing in front of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220357,
					"content": "I don't want to go outside while such a scary and huge monster is roaming the area. I'm sorry, my \"sister.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220358,
					"content": "Oh, Paimon sees. But Festival Utsava is coming, you should return home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220359,
					"content": "Festival Utsava is meant to be carefree, but I'll care for my life if I leave this place. *snore* I can't do that for Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220360,
					"content": "*snore* *snore* Nara Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220361,
					"content": "Ugh... This guy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220362,
					"content": "#What do we do, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220363,
					"content": "Let's deal with the big scary monster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "...Paimon doesn't think anything can be scarier than Stormterror. In fact, Paimon wonders how Aranara would describe Stormterror?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220366,
					"content": "\"A million Araphalas tall!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "\"To walk from its tail to the head, the moon will rise and fall!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220368,
					"content": "C'mon, let's help him deal with that monster outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220364,
					"content": "Ah, that huge monster! So scary!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "It sounds so convenient!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "Paimon, can you turn into a seed?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "Hey, do you have any problem with Paimon!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220327,
					"content": "Your memory is amazing as well, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "Hee—hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220317,
					"content": "No one will make you into porridge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
		{
