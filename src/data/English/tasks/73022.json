			"dialogs": [
				{
					"id": 730220101,
					"content": "Hi there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220102,
					"content": "*snore* *snore*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220103,
					"content": "Hey! Hello—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220104,
					"content": "Mmm... Tasty fruits... *snore*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220105,
					"content": "Ugh, he's in deep slumber. Oh, right. Arapacati mentioned that <color=#00E1FFFF>the power of Dendro</color> should do the trick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220106,
					"content": "#Paimon will leave it to you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"73022"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "Oh? It's you. Long time no see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220202,
					"content": "Whoa, where am I? Is this a cave? Ugh... I'm feeling dizzy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220203,
					"content": "Who are you? Why are you sleeping here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220204,
					"content": "Who am I... Ugh, so dizzy. Let me think... My name is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220205,
					"content": "My name is Araphala! Hehe, I remember now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220206,
					"content": "So you're Araphala! We were wondering where you'd gone... and here you were, sleeping in this cave the whole time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220207,
					"content": "Araphala... You know my name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220208,
					"content": "Eh? Nara!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220209,
					"content": "He's wide awake now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220210,
					"content": "Indeed he is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "*sob* I'm not ready yet. Don't make porridge out of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220212,
					"content": "Huh? Why would anyone want to make porridge out of you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220213,
					"content": "M—My sister said that if I'm always half asleep like this, a bad Nara will take me and make porridge out of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220214,
					"content": "You do look pretty tasty!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "Waaah!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220216,
					"content": "#Hey! {NICKNAME}, don't make jokes like that! Araphala, no one will cook you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220218,
					"content": "...Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220219,
					"content": "Really!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220220,
					"content": "Not kidding?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220221,
					"content": "#No kidding! Anyway, Paimon's name is Paimon, and this tall Nara is {NICKNAME}. Arapacati sent us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220222,
					"content": "Arapacati? Is she doing well? How long have I been here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220223,
					"content": "\"How long,\" you say? Well, if Paimon recalls correctly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220224,
					"content": "Uhh... Many, many moons ago, the seedlings sprouted from the earth, and became trees... How many Arapacatis tall were they again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220225,
					"content": "Seven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#Whoa! As expected of {NICKNAME}! What an amazing memory!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220229,
					"content": "Oh, it's been so long. Oh no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220230,
					"content": "Anyway, let's bring you up to speed. Festival Utsava is coming up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220231,
					"content": "You bring Araphala up to speed on the events so far...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "Ah, it's time for Festival Utsava, is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220233,
					"content": "Yeah, so Arapacati wants you back in Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220234,
					"content": "Ugh... But I haven't completed my cooking training yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220235,
					"content": "Huh? Weren't you sleeping? Paimon thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220236,
					"content": "\"Sleeping\"? Oh, I was just thinking about the past. It wasn't that serious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220237,
					"content": "Huh? Is sleeping something serious for Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220238,
					"content": "Hmm... How should I put this... We hibernate when we are in grave danger, and we compress our memories and dreams into a seed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220239,
					"content": "If the crisis is averted and the time is right, the seed will return to the forest and grow into Aranara again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220240,
					"content": "It sounds really tough...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "But I know that all Nara must sleep. I had a Nara friend once, a Golden Nara just like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220245,
					"content": "#I once came here with {F#him}{M#her} to gather the Unrivaled Fresh Fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220246,
					"content": "#So, I've been picking them here since then. If {F#he}{M#she} returns, or if I make new Nara friends, we can eat them together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220247,
					"content": "I've picked so many of them this time... Eh? Where did they go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220248,
					"content": "So, it's you who dropped those Sunsettias we saw all along the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220249,
					"content": "Did I drop that many? But it's okay, hehe... I've kept the freshest and tastiest with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220250,
					"content": "But still... How did I drop so many...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220251,
					"content": "I remember leaving with my brothers for cooking training. But they didn't know that fresh fruits are the best ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220252,
					"content": "But while I was picking fruits... Yes, while I was picking fruits, a really huge monster appeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220253,
					"content": "That huge monster was five Araphalas tall and had a long tail. Even the ground quaked beneath its stomps. Besides that, I think I sensed Marana's aura inside it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220254,
					"content": "And it was so tough! Even if Arama and Arabalika were there, it would take them some effort to tear it apart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220255,
					"content": "Wait!? They are that strong!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220256,
					"content": "Yes, but I'm not. So, I had to hide here. I was thinking about the past as I waited for it to leave, and the next thing I knew, you two were standing in front of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220257,
					"content": "Speaking of which, we did see a Ruin Drake on the way here. Is that the huge monster you mentioned?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220258,
					"content": "Is that how Nara call it? Perhaps. Very likely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220259,
					"content": "We've taken care of it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#Whoa! I didn't expect Nara {NICKNAME} who looks smaller than the monster to be so strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220265,
					"content": "Alright, then let's go. Good Nara, let's eat fruits together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220260,
					"content": "Ah, that huge monster! So scary!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "...Was it that scary though?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220262,
					"content": "Yes, looks like Nara understands that it's very scary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220263,
					"content": "#Don't worry. {NICKNAME} had defeated that huge monster before we met you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220241,
					"content": "It sounds so convenient!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "Paimon, can you turn into a seed?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "Hey, do you have any problem with Paimon!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220227,
					"content": "Your memory is amazing as well, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "Hee—hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220217,
					"content": "No one will make you into porridge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
		{
			"id": 7302203,
