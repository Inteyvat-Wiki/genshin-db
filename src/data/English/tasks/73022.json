			"dialogs": [
				{
					"id": 730220901,
					"content": "(A huge leaf. Someone has written on it with neat handwriting...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220902
					],
					"speakerTitle": "Leaf With Careful Penmanship"
				},
				{
					"id": 730220902,
					"content": "\"...Leaves turned yellow. I picked a fresh and tasty Sunsettia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220903
					],
					"speakerTitle": "Leaf With Careful Penmanship"
				},
				{
					"id": 730220903,
					"content": "\"...Branches turned green. I didn't find any fruits...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220904
					],
					"speakerTitle": "Leaf With Careful Penmanship"
				},
				{
					"id": 730220904,
					"content": "\"Leaves are growing again, and 40 moons have passed. I picked Sunsettias outside the campsite and brought them back to Vanarana, but sister said they were still very unripe...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leaf With Careful Penmanship"
				}
