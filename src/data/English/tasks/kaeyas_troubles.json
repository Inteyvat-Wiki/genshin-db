			"dialogs": [
				{
					"id": 4610612,
					"content": "I'd like to ask...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610602
					]
				},
				{
					"id": 4610602,
					"content": "Hey! Do you have any intel on the Arcadian Ruins?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610603,
					"content": "Arcadian... Can't say I've heard of it. Sorry, I'm still new here, so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610604,
					"content": "Really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610605,
					"content": "But you can try posting a commission and see if there are any adventurers who know about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610606,
					"content": "That's a no-no! No way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610607,
					"content": "We can't afford them beating us to the treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610608,
					"content": "(Now she's done it...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610609
					]
				},
				{
					"id": 4610609,
					"content": "Really!?",
					"roleType": "TALK_ROLE_NPC",
