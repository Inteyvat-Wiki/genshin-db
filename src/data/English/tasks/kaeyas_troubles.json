						],
						"stepId": 46104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610404,
					"content": "Hmph! We're not here for something that boring!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610405,
					"content": "We're looking for a sword that fell from Celestia... One that can kill eight-headed banshees and silver-haired hydras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610407,
					"content": "It's eight-headed hydras and silver-haired banshees...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "You've said too much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "It's super, mega, uber powerful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
