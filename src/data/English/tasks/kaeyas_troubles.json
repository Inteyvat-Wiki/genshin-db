				{
					"id": 4610513,
					"content": "No. We're here for...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610502
					]
				},
				{
					"id": 4610502,
					"content": "Nope. We just want to know if you've been to the Arcadian Ruins?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610503,
					"content": "Arcadian Ruins? Imagine that... So there are places that I haven't been to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610504,
					"content": "Oh? Even the great Stanley doesn't know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610505,
					"content": "Never mind this Arcadia... You need to know what happened to me on the Mare Jivari and in the Geyser Realm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610506
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610506,
					"content": "We don't have time for your stories. Think hard, please. We need clues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610507,
					"content": "The Mare Jivari... It was a place of death...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610508
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610508,
					"content": "Gosh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610509,
					"content": "When we find the Arcadian<color=#00E1FFFF>treasure</color>, our story will definitely be better than your stupid stories!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610510,
					"content": "(Now she's done it...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610511
					]
				},
				{
