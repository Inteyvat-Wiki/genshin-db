			"dialogs": [
				{
					"id": 4610801,
					"content": "Oh, you're back. Do you have news for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610802
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610802,
					"content": "Listen, we asked around the Adventurers' Guild and found... Well, nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610803,
					"content": "Haha... That much is expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610804
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610804,
					"content": "Why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610805,
					"content": "Oh, I only mean that, what's the fun in finding it without the hard work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610806,
					"content": "However, I do have some clues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610807,
					"content": "I sent someone to collate black market intel. It seems that someone does know about the Arcadian Ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610808
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610808,
					"content": "Really? Where's the guy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610809,
					"content": "Now, now, as per the black market's rules, they will send someone to meet us to prevent leaks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610810,
					"content": "We will be meeting the informant at the Whispering Woods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610811,
					"content": "Then, what are we waiting here for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610812,
					"content": "It's not ideal for Kaeya to show his face.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "That's right. You read my mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610814,
					"content": "I am a knight... so I shouldn't have any dealings with the black market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610816,
					"content": "You have my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610817,
					"content": "Of course, you'll be compensated for your troubles... by the Knights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610818,
					"content": "Ooh, no problemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610815,
					"content": "We'll get the intel back to you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
			]
