					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "So, Cyrus, do you know where the Lost Arcadian Ruins are supposed to be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610414,
					"content": "Arcadian Ruins... Never heard of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610415,
					"content": "Thanks for your intel anyway. If you do find these ruins, I'd love to see them.",
					"roleType": "TALK_ROLE_NPC",
