			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "This is bad... Such a hassle... What am I going to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610102,
					"content": "What's wrong, Kaeya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#Oh, thank the Thousand Winds! {NICKNAME}, your arrival must be the grace of the gods!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610105,
					"content": "If I may ask — envoy sent by the Anemo God to save this mere mortal — could you spare a moment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610106,
					"content": "Ewwww, cut it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610107,
					"content": "Can't say I don't have time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "Marvelous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610110,
					"content": "I cannot let my peers hear about this! I cannot seek help from anyone else but you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610111,
					"content": "Please, let us move to somewhere more fit for such conversations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610112,
					"content": "Let's talk in the courtyard just outside headquarters. Come with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610113,
					"content": "What's with the sneakiness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610109,
					"content": "Tell me what happened.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "You don't usually lose your chill.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "This place will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610202,
					"content": "Tell us what it's about already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610203,
					"content": "How should I begin... Oh, right, let me tell you a secret first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610204,
					"content": "It's a secret of my past, and I confide in you to keep it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610205,
					"content": "Don't worry, Paimon's lips are sealed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610206,
					"content": "As a matter of fact, my grandfather was a pirate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610207,
					"content": "Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610208,
					"content": "...Wait, why do you sound so blithe? Do you think I'm making it up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610209,
					"content": "Look at my eye patch! I inherited it from my grandfather and this is solid proof that we are related by blood!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610210,
					"content": "I never knew you could inherit eye patches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#My! {NICKNAME}, how could you not know such common knowledge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610212,
					"content": "This is no different from children inheriting their hairstyles from their parents!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610214,
					"content": "Yesterday I was glancing through the notes my grandfather left and stumbled upon records that spoke of a <color=#00E1FFFF>treasure</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610215,
					"content": "...Treasure!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610216,
					"content": "According to his notes, the treasure is buried in the \"Lost Arcadian Ruins.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610217,
					"content": "Treasure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610218,
					"content": "But the location of the ruins is currently unknown. I've tried searching for clues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610219,
					"content": "Treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610220,
					"content": "Kaeya! What kind of treasure is it? Gold? Or better yet, gems!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610221,
					"content": "Hmph! Treasures that consist of nothing but gold and gems are third-rate treasures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610222,
					"content": "My grandfather's treasure is a sword!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610223,
					"content": "A magic sword that grants the wielder unrivaled power!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610224,
					"content": "Oh wowwwww!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610225,
					"content": "The sword was dropped from Celestia into the sea by a god. It was later salvaged by my grandfather's crew by pure coincidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610226,
					"content": "The moment he gripped the sword, thunder roared, billows howled, and the clear skies were suddenly swallowed by raging winds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610227,
					"content": "With the might of the magic sword, my grandfather went on to defeat a hydra, a silver-haired banshee, a wicked abyss dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610228,
					"content": "But the immense power of the sword enticed many more greedy pirates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610229,
					"content": "To avoid meaningless conflicts, my grandfather hid the magic sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610230,
					"content": "Eight-headed hydras, silver-haired banshees... Do they really exist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "The world we live in is fascinating, full of unknown and inexplicable wonders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610233,
					"content": "These incredibly thrilling adventures are romances that could only be told by pirates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610234,
					"content": "Holy moley! That's just insane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610235,
					"content": "A gang of <color=#00E1FFFF>Treasure Hoarders</color> has been very active lately and many ruins have had their relics stolen by them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610236,
					"content": "I'm afraid that they will soon discover the Arcadian Ruins and the magic sword will be lost...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610237,
					"content": "We won't let it fall into the wrong hands! We must get the sword before them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610238,
					"content": "#You just rest assured that Paimon and {NICKNAME} are here to help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610239,
					"content": "Wow~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610240,
					"content": "Great! Please keep it a secret. I'll wait for your good news!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610241,
					"content": "#Hey! So whatcha think, {NICKNAME}? Isn't it exciting? We're talking about a super-duper powerful sword!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610242,
					"content": "Is it true?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "Well... let's go to the <color=#00E1FFFF>Adventurers' Guild</color> and see if we can find out more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610245,
					"content": "The adventurers should know more about the ruins, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610243,
					"content": "Is it really, really true?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
					"content": "How surprising.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610214
					]
				}
			]
		},
		{
			"id": 46104,
			"completionStepIds": [
				46103,
				46104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46104",
