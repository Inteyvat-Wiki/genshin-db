			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710101,
					"content": "How are the flowers that we stored away on Dragonspine earlier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "I only managed to retrieve one of them...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "The others couldn't be retrieved? Um... Well, alright then. It is quite hard to predict conditions on that mountain, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "But if we only have one, then we can't make any comparisons. I suppose we'll just have to wait for another opportunity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Thank you for taking the trouble, though. Here, I prepared these as compensation — I might need to call upon your help in the future as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007102,
			"completionStepIds": [
				2007109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007109",
							"2"
