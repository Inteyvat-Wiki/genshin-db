			"dialogs": [
				{
					"id": 718120201,
					"content": "So, did you find anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120202,
					"content": "I found this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "What's this...? I've never seen anything like it, where did you find it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120205,
					"content": "Near Dunyu Ruins...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "Dunyu Ruins? What would such an item be doing there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120207,
					"content": "Thank you for getting to the bottom of this for us. As per the adventurers' code, this item is all yours now. Along with your reward, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120208,
					"content": "I'll arrange for someone to head over to Dunyu Ruins to conduct a more thorough search.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120209,
					"content": "So strange... The Dunyu Ruins area has been combed countless times... How did we miss this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
