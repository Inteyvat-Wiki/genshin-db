				"points": []
			},
			"dialogs": [
				{
					"id": 741871101,
					"content": "God King Above, thank you, Dominus Cassiodor. In any event, it seems that this issue has been resolved for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				}
			]
		},
		{
			"id": 7418712,
