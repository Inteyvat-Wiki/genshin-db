					}
				]
			},
			"dialogs": [
				{
					"id": 741870901,
					"content": "It seems that you've resolved our previous problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "I suppose that means you'll be rushing ahead toward your next goal, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "Yes. I'll be counting on you to take care of this place, Este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870904,
					"content": "Also, remember that it is better to trust the wisdom of your heart rather than handing all judgment of right and wrong over to Phobos or any Harmost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "The Sebastos created Phobos to free us from our servitude to destiny, but the people's blind faith has led us into enslavement more frightful still.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "In the future, you may encounter a similar choice once more. I hope you will make the right decision when the time comes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Dominus Cassiodor, why are you suddenly speaking of such things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Still, I shall keep your words in my heart. I, Este, shall uphold my own sense of justice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "That is good. Farewell, Este. I believe we shall meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		},
