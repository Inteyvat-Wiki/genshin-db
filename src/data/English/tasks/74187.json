				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Ahem, legionnaires of Legio IX!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "Huh? Who are you? Este's little helpers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870603,
					"content": "That we are.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "We're no ordinary helpers! Mighty are we who have come with Dominus Cassiodor, to attend and aid him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "(It seems you two have quite the penchant for acting.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Dominus Cassiodor, you say... I heard that the Sebastos had sent him to Aremorica. Has he returned so soon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870611,
					"content": "Well, the one next to us is, in fact...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "Wh—Whatever the case, we have come to survey the frontline legions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Right. I figured as much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870615,
					"content": "I mean, we haven't gone to Fort Charybdis with the main body of troops...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870616,
					"content": "But we are the rearguard, so some final \"cleanup\" is well within our range of duties, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870617,
					"content": "Is this also a command from Phobos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Well... It should have guided our every move, but since coming here, there have been many times when we could not hear its melody.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870619,
					"content": "As such, we've fallen back on Dominus Boethius's directives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870620,
					"content": "Ah, that impudent fellow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Who do you think you are!? How dare you impugn Dominus Boethius's name so flagrantly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870622,
					"content": "A Harmost as esteemed as he follows the directives of the Sebastos in all things. His word is as the word of Phobos itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870626,
					"content": "Phobos could have made a mistake as well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Hah! Are you sure you're Remurian? Do you not know that Phobos was fashioned by the omnipotent Sebastos and the infallible oracle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870628,
					"content": "Yet you are not receiving the melody.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Well, that is true enough. But in what can we place our trust, if not Phobos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870630,
					"content": "Surely it would not stand idly by, were we to diverge from the correct path?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870623,
					"content": "The Sebastos does not permit the harm of innocent people.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Innocent, you say... Yes, he did task us with helping these vulnerable humans before the war began.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870625,
					"content": "But our actions have the tacit approval of Phobos. Could its decrees ever be in conflict with the sacred word of the Sebastos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870605,
					"content": "We are special envoys of the Imperator, our Sebastos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "What kinda rank is that... Well, that's not completely wrong. We're with Dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "We are Cassiodor's retainers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "That's right! Dominus Cassiodor's retainers, that's who we are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7418707,
