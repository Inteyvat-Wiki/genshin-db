					"Este"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741871201,
					"content": "Phobos is a perfect creation. I counsel you, as a Remurian, to not doubt its directives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871202,
						741871204
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741871202,
					"content": "Perfect? Nothing is truly perfect.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871203
					]
				},
				{
					"id": 741871203,
					"content": "What are we doing now, debating sophistry? Take it up with those musical erudites in the capital. A soldier's duty is to obey. Complex matters are not my strong suit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				},
				{
					"id": 741871204,
					"content": "Phobos's silence signifies rejection.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871205
					]
				},
				{
					"id": 741871205,
					"content": "Yes... That is possible. How did I not consider that? Could our rash actions have caused Phobos to cease guiding us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871206
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741871206,
					"content": "If so... Then it bodes very ill...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				}
			]
		}
	]
