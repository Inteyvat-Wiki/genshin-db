				]
			},
			"dialogs": [
				{
					"id": 741870801,
					"content": "You... Come to think of it, you could be barbarians in disguise, attempting to deceive us! You are, aren't you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870802
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870802,
					"content": "You damnable worms, I shall slay you where you stand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				}
			]
		},
