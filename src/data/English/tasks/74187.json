					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"0",
							"74187"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Osse",
					"Leader",
					"The Dude They Call \"Idiot\"",
					"Este"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741870701,
					"content": "Very well... You speak true. We must reconsider our actions. I... In truth, I do not know how things came to this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870702,
					"content": "There's been a strange feeling in my heart since this war broke out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870703,
					"content": "We were meant to pursue freedom and happiness, but Phobos led us here instead, step by step...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870704,
					"content": "Has something gone wrong? What could it be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870705,
					"content": "If you meet with the Sebastos upon your return, please apprise him of our circumstances and our doubts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870706,
					"content": "You'll be doing us a truly great favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870707,
					"content": "Don't worry, we will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
