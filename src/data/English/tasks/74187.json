						"pointId": 106
					},
					{
						"sceneId": 11,
						"position": [
							1640.558,
							588.447,
							4628.447
						],
						"pointId": 15
					},
					{
						"sceneId": 11,
						"position": [
							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					},
					{
						"sceneId": 11,
