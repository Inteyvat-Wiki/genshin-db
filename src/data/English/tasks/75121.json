			"trigger": {
				"objectNames": [
					"Kuroda"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "Someone sent me to find a couple of books...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "You describe the books that Citlali wants to Kuroda.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "The first edition of \"Shogun Almighty: Reborn as Raiden With Unlimited Power\" and the limited deluxe edition of \"Pretty Please, Kitsune Guuji?\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "I must say, your friend clearly knows a thing or two. In terms of collection value, nothing the Yae Publishing House is currently putting out can rival the books you're after.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "To think I'm not acquainted with such a discerning reader... Truly regrettable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Are they still available?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "You won't find either of them on the open market, and certainly not in storage. Every copy was snapped up long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "However, I do happen to have a copy of each...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "I can pay you for them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "No, no. These books would be far better off in your friend's possession, someone who can appreciate their true worth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Knowing that, I'd be more than happy to give them to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
}