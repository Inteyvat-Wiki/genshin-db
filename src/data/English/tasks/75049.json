				"points": []
			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "What, ho... To think you could find this entrance. Long has it been since any have come hither...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Nightsoul Spirit"
				},
				{
					"id": 750490402,
					"content": "This... Mm, yes, this is where the Nightsouls roam, though afeared am I that none now live on the sun-kissed earth who recall their names or deeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Nightsoul Spirit"
				},
				{
					"id": 750490403,
					"content": "Ah, Nightsouls... While our mistress slumbers, we are her dreams. When our goddess awakens ever and anon, we are but single strains of her mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Nightsoul Spirit"
				},
				{
					"id": 750490404,
					"content": "That a living person should set foot here... Haha, those overcome by their battle-craving can hold back no longer... Outlander warrior, you who are much beloved...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Nightsoul Spirit"
				},
				{
					"id": 750490405,
					"content": "Still these unquiet souls to slumber soundly with the blaze of battle and triumph, and be rewarded... What say you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nightsoul Spirit"
				}
			]
		},
