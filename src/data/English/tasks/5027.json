			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mualani",
					"Kinich",
					"Ajaw",
					"Kachina",
					"Citlali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "Whoa, our Archon really is amazing! And super brave, too. She even went toe to toe with Lord Xbalanque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270102,
					"content": "Don't be so modest. You'd have done the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270103,
					"content": "Hah, like any of us wouldn't! I'd have jumped at the chance! What about you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 50270104,
					"content": "I... I wouldn't dare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50270105,
					"content": "Fighting is in a warrior's nature. If the opportunity was presented to you, I'm sure your instincts would make that choice for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270106,
					"content": "*sigh* I swear, you're all just brimming with energy over here... This is Lord Xbalanque we're talking about. Our greatest ancestor! Are you really that into sparring with your elders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50270107,
					"content": "Granny Citlali! Let's spar sometime, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270108,
					"content": "No, no, we're absolutely not doing that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mausau",
					"Ororon",
					"Iansan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Say, what kind of vegetable do you think I'll become? A red one, or... a green one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270202,
					"content": "You? I have a feeling... that you might turn into an onion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270203,
					"content": "An onion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270204,
					"content": "Someone who looks ordinary, but who can make anyone who attacks you break down and weep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270205,
					"content": "Really? That sounds super strong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270206,
					"content": "What are those two even talking about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270207,
					"content": "Onions are super powerful. One of my friends happened to be cutting onions when I came over to his house. He began to cry, and the Saurians also began to cry, and eventually, nearly every living creature in the room was crying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270208,
					"content": "What about you? Did you cry too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270209,
					"content": "I was also in the room, but I shielded my eyes with my cloak just in time. Cacucu and Ifa couldn't see my face, so they thought I cried too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270210,
					"content": "I'd like to become an onion-man, and make people cry too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270211,
					"content": "Sure, no problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270212,
					"content": "I really want to interrupt you, but I have no clue what to say to derail this line of conversation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270213,
					"content": "Well, Iansan, you're a tiny... mushroom. Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270214,
					"content": "No one asked you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270215,
					"content": "Although... mushrooms are pretty resilient, I guess... Okay, I approve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270216,
					"content": "Then you must be full of life too, right, Miss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270217,
					"content": "Yes she is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270218,
					"content": "Yeah... Sure, why not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		}
	]
}