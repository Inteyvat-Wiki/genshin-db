				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "You're here, adventurer. We were just about to make the necessary installations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "If all goes well, we'll be able to give that monster a good lesson to remember today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "During the formal charging process, there may also be monsters who will try to disrupt the process. When that time comes, please keep an eye out for the charging progress and durability of the device.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "Thank you very much, adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "Ah, I've got an idea! You've been busy running around helping with the Wenutslayer Cannon. The honor of testing it for the first time... should be yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "You don't want to do it yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "I'll be happy enough to watch the shots land! Besides, to let someone else light the fire, so that we can see the firing in all its glory... Ah! It speaks for itself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "All you have to do is protect the charging device from the monsters and wait for the energy to fill up. Watch for the moment when the Wenut reveals its vulnerable spot and then fire at it with all you've got!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "The ignition and auto-correcting mechanisms will take care of the rest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Sounds impressive. {NICKNAME}, Paimon also wants to watch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Okay, I'll handle it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Alright, that's a deal, then! Let me tell you how it works...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "I have no idea how this thing works...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Relax! Its design perfectly follows the principles of user-friendliness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}