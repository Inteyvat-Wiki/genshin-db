					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330601,
					"content": "#Aw, I lost again. Even after all that practice, I still lost to {M#him}{F#her}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330602,
					"content": "I told you this ages ago. There's no end to thinking about winning. Gotta admire your drive to just charge ahead without fear, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330603,
