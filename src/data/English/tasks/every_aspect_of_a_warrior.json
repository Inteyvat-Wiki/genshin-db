			"dialogs": [
				{
					"id": 750330501,
					"content": "Haha! Sorry, but I pulled ahead this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330502
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330502,
					"content": "Gah, Matahga, you annoying little... You've been like this since forever, always going all out in the second half!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330503
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330503,
					"content": "Feeling bitter? Catch me if you can, then! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7503306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
