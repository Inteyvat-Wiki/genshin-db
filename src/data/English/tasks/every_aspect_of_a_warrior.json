			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "Come and fly with my kids, young one. It's not every day you get to compete with the Flower-Feather Clan's finest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330202,
					"content": "Chase after the <color=#00E1FFFF>flying torch</color> on the course. Whoever catches it first wins. That's how I trained them when they were little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>The torch is held by a balloon decorated with red feathers</color>, symbolizing the responsibility and honor that a warrior should bear. I made it for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330204,
					"content": "You'll recognize it once you see it. So, are you up for the contest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330205,
					"content": "I'm ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Haha, great! Let's head to the starting point and get ready then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330207,
					"content": "I need a little more time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "Let us know when you're ready then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
