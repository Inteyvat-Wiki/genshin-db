						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "D—Did the volcano just... erupt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "No... It's been super duper quiet... D—Did you see it erupt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#{NICKNAME}? {REALNAME[ID(2)|SHOWHOST(true)]}? What's up? What's with those faces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "You look like a pair of detectives from a light novel who've suddenly realized the truth about the killer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "We saw some sort of \"truth,\" alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(You explain what you saw to Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Huh? You saw the same stuff you did when we first arrived in Natlan and met {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "And some strange images?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "Ehrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "You said you saw some strange words before... Umm, Paimon didn't see anything, so she can't be sure, but... might they have been written by the same person?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "I think that's the case, yes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "But, this time you also saw... a giant section of ruins, and the Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "And some \"Sacred Mountain\"... Hmm, don't the Natlanese call that volcano the \"Sacred Mountain\"? Could it be that what you saw has something to do with the volcano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#Paimon can't shake the feeling that the person who united us with {REALNAME[ID(2)|SHOWHOST(true)]} really wants us to go there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Maybe that's where we'll find the answers to {REALNAME[ID(2)|SHOWHOST(true)]}'s origins... We might even meet his family...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Anyway... Paimon thinks we should keep an ear out for information about the volcano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Hmm. Come to think of it, one of the six tribes of Natlan, the Collective of Plenty, lives beside it, don't they? Maybe we can ask them for help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
