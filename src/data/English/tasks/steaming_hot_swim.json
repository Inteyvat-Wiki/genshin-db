			"dialogs": [
				{
					"id": 250250101,
					"content": "Could you please come ashore, just for a bit? I need to clean up the springs over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Lazy Koholasaurus"
				},
				{
					"id": 250250103,
					"content": "Come on now, be a good boy! If not, I'm going to have to pick you up myself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Lazy Koholasaurus"
				},
				{
					"id": 250250105,
					"content": "And he's gone in a flash, just like that. Ugh, how am I going to get a hold of him now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "Hmm? You here for a hot spring bath? Sorry, but I'm in the middle of cleaning this pool here, so you might have to wait a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Also, this lunk won't come up and out no matter what I say. *sigh* And I've got so many more pools to clean, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Could he be throwing a tantrum because I carried him out a few days earlier? Seriously, what a pain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
