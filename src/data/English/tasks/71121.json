			"dialogs": [
				{
					"id": 711215101,
					"content": "#G—Great Chivalrous {M#Hero}{F#Heroine}! Please, spare my life! I'm not with them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711215102,
					"content": "And just who are you!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Me!? I'm... Uh... It's a long story...? They stole some stuff, and I was asked by my master to register them and return them, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711215104,
					"content": "Well, since you drove away all the thieves, and my work here is done, I'll just skedaddle for now, if you don't mind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711215105,
					"content": "A moment...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "No need, after all, we'll definitely meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Merchant"
				}
			]
