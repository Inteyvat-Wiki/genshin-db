			"dialogs": [
				{
					"id": 711210201,
					"content": "Thank you so much, I am so grateful! Haiyaa, the entire cargo would've been lost without you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711210202,
					"content": "I don't have much money on me, but please, take this as your reward. Don't be shy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711210203,
					"content": "Wow, you're too kind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711210204,
					"content": "This is farewell then. I hope we'll meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Merchant"
				}
			]
