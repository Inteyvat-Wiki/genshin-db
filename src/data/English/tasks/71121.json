			"dialogs": [
				{
					"id": 711210301,
					"content": "P—Please spare me, O magnanimous heroes... Wait, it's you guys!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711210302,
					"content": "It's you!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Hey hey, what a coincidence, eh...? Ehehe, why don't you guys go back to what you're doing. Now, if you'll excuse me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711210304,
					"content": "I suggest you see what valuables they left behind. Oh, don't mind me, I've already made notes of everything.... I'll return everything that needs to be returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Strange Merchant"
				},
				{
					"id": 711210305,
					"content": "Wait...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "No need, after all, we'll definitely meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Merchant"
				}
			]
		},
