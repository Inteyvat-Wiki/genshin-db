			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "Albedo! We're back~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120102,
					"content": "Oh, hey, does he have a guest over?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120103,
					"content": "Yes, and a familiar one at that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "Yes, perhaps it is too soon to ask our greenhorns to come adventuring here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120106,
					"content": "But adventure is nothing if it is not about pushing our limits! What is a journey without struggle, without excitement?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120107,
					"content": "This place may be infested with wicked hilichurl bandits and knee-deep snow, but an adventurer must never stop pressing forward!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120108,
					"content": "Cyrus, to the point, please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120109,
					"content": "Hahaha! Come, come! The beauty of a chat lies in the journey, not the destination — just like an adventure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120110,
					"content": "Even if you are robbed blind and must give up on your encampment, you can start a fire and cook a meal in the frigid snow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120111,
					"content": "This journey up the mountain will be an unforgettable one for all our newcomers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120112,
					"content": "Mm, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120113,
					"content": "They may resent me, or even hate me. But in the future, they will think back upon this moment with hearts full of gratitude — for this was the day that the spirit of adventure was passed on to them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120114,
					"content": "Oh yes, go on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120115,
					"content": "Oh brother... Albedo's at it again. He's always so cold when the topic doesn't catch his fancy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120116,
					"content": "He isn't interested in adventurers in the slightest, is he?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "He sure is interested in you, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120118,
					"content": "Still... should we say that our newcomers are too green, or that the mountain is too mighty? We have taken great losses this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120119,
					"content": "What? What do you mean, \"great losses\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120120,
					"content": "Oh, you must be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120121,
					"content": "What's up, Cyrus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "Long time no see—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120123,
					"content": "#Ah, yes! The young adventurer and {M#his}{F#her} companion! It is my pleasure to see you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120124,
					"content": "I trust these frigid ascents have not given you too much trouble?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120125,
					"content": "Ha, we can take anything it has to throw at us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120126,
					"content": "Hahaha! Good, good! I love your confidence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120127,
					"content": "But you must be here on some important duty, braving the wind and snow like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120128,
					"content": "#I came here to gather the latest data on hilichurls, and asked {M#him}{F#her} to serve as my assistant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120129,
					"content": "(Huh. Is that how it went?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "Ah, I see. A gathering of people chasing their dreams and ideals, is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120132,
					"content": "Then I wish you all the best. Farewell for now — I must go see to our new recruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120201,
					"content": "Haha, looks like we've made a discovery!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120202,
					"content": "Albedo is keeping Cyrus in the dark.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "Well, it is a magical sword after all. It's understandable that he doesn't want other people to know about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120204,
					"content": "I am listening, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120205,
					"content": "Should I not ask?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "There is no \"should\" or \"shouldn't\" here. I can answer your questions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120207,
					"content": "But not right now. Right now, I have more pressing matters on hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120208,
					"content": "\"Pressing matters\"? ...Let Paimon guess, we've got a part to play in it too, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120209,
					"content": "Hehe. You're getting smarter, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120210,
					"content": "Hey! Paimon will have you know that she's always been smart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120211,
					"content": "I have discovered some new habitats nearby with different monster types. I believe they will provide us with similarly varied data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120212,
					"content": "You sure love your research, don't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "Perseverance is key to research, and persistence is the basis of the alchemist's art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120214,
					"content": "So, are you ready? Then let us go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120130,
					"content": "(Quite reluctant to let people in on the matter of that sword, isn't he?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "Now, where have we seen this face before?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
		{
			"id": 4121202,
