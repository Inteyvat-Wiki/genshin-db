					"id": 412129801,
					"content": "The paths we may venture are not limited to those the eye can see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121203,
			"completionStepIds": [
				4121221
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
