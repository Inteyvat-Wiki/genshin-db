			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "Did you see that? That hilichurl ran off while holding on to something that looks like a book!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120502,
					"content": "That's... not good. That was my sketchbook.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120503,
					"content": "Perhaps it dreams of becoming a grand-master artist someday?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "Paimon thinks it's just your run-of-the-mill thief, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120506,
					"content": "To think that it dared to steal my sketchbook. Quite bold, this one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120507,
					"content": "Hmm, looks like Albedo's got a frosty temper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120508,
					"content": "I'll lend you a hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "Did it want to learn alchemy too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
		},
		{
			"id": 4121206,
			"completionStepIds": [
				4121210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121210",
							"2"
						],
						"stepId": 4121210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "Looks like it's a dead end. You know, except for this huge cavern entrance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120602,
					"content": "Did it run in there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "Judging from the tracks, that seems to be the case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120604,
					"content": "Then what are we waiting for!? We can't let it escape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120605,
					"content": "Wait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120606,
					"content": "This mountain is incredibly large. Even if there was a path within its bowels, such a road would not be easy to walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120608,
					"content": "Can you feel it? The wind carries the scent of ice and stone with it... and the sound of echoes. The space within must be massive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120609,
					"content": "R—Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120610,
					"content": "As such, rash moves are of no benefit to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120611,
					"content": "But... But we've come all this way — we can't just let it leave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120612,
					"content": "Isn't that sketchbook very important to you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "It is. But that doesn't mean that we should act recklessly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120614,
					"content": "There is another way. It just requires some extra work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120615,
					"content": "If my guess is correct, this cavern's exit is on the other side of the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120616,
					"content": "You are quite the expert glider, and I'm a fair hand myself. So prepare yourself, and we'll glide across in one go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121207,
			"completionStepIds": [
				4121215
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121215",
							"2"
						],
						"stepId": 4121215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120701,
					"content": "Albedo, how's the sketchbook situation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120702,
					"content": "It's alright. A few pages were destroyed, but most of it is intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120703,
					"content": "The temperature in the Snowy Mountain is subzero. It can reach extremely low temperatures, especially near that cavern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120704,
					"content": "What makes matters worse is that the hilichurls have drooled all over the pages. To leave wet paper in such low temperatures, it's too dreadful to imagine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120705,
					"content": "Frozen paper is so brittle. It doesn't take much for it to fall apart, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120706,
					"content": "Fortunately, you knew how to piece it back together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "No wonder you're an alchemist! Such an ingenious mind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120708,
					"content": "If the sketchbook had been severely damaged, you'd be furious, wouldn't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120709,
					"content": "What leads you to believe that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120710,
					"content": "You told us there's a lot of drawings and notes inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120711,
					"content": "I must admit, I bring this sketchbook everywhere I go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120712,
					"content": "However, I wouldn't fly into a rage over such a thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120713,
					"content": "Had I not been able to salvage it, I would just draw everything again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120714,
					"content": "Eh... How pragmatic of you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120715,
					"content": "I don't think so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "Is that so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120718,
					"content": "After all, you've put a lot of effort into your drawings.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "That's right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120720,
					"content": "Think of all the memories you've committed to paper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "Yep yep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120722,
					"content": "Such mementos shouldn't be easily abandoned.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "#Absolutely! All well said. You took the words out of Paimon's mouth, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120724,
					"content": "Hmm... You're right. Redrawing everything would be a tedious endeavor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120725,
					"content": "Especially since you're so talented, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120726,
					"content": "You've mastered so many skills and gathered so much knowledge that other people can only dream of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120727,
					"content": "But such talented people sometimes forget about that. It's one of the downsides of being smart, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120728,
					"content": "Albedo's also praised your smarts, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "Without a doubt, Paimon is an interesting creature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120730,
					"content": "Paimon forgets about the little things, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "Ahhhh! Don't put Paimon on the spot when it comes to wisdom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120733,
					"content": "Changing the subject... Cyrus told me that the hilichurls from this mountain attack and rob adventurers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120734,
					"content": "The place we visited should be one of their camps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120735,
					"content": "The hilichurls in this area are strong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "Yeah, the hilichurls here are way stronger than the ones at the bottom of the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120737,
					"content": "I can't disagree. I assume... this must be related to the dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120738,
					"content": "The corruptive power emanating from Durin's remains is making the monsters stronger, which, in tandem with the frigid climate, depopulated some mountain areas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120739,
					"content": "Can you take out the sword, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120740,
					"content": "Each time you fought in the mountains, this sword was absorbing power and storing it within itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120741,
					"content": "Moreover, thanks to your purification, the corruptive power of the dragon's blood seems to be all gone now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120742,
					"content": "It's a very interesting phenomenon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120743,
					"content": "It's not the first time we've done something like that. We're experts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120744,
					"content": "I always wondered what purification was capable of... I knew you were capable of doing it, but seeing it with my own eyes is a unique experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120745,
					"content": "A power-absorbing sword must be quite dangerous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "Indeed, I can't say it's the safest of weapons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120747,
					"content": "Lucky that it wasn't snatched away by those hilichurls, otherwise we'd be done for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120748,
					"content": "Aren't Fatui a bigger threat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "Hilichurls are a threat, too! What if that power could turn them into... super, no, ultra hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120751,
					"content": "Ultra hilichurls!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "Ultra demon hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120753,
					"content": "Ultra demon snowman hilichurls!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "\"Snowman\"? Now you've ruined the game...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120755,
					"content": "Anyway, about the sword... If it's so powerful, can't it absorb your energy as well, Albedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120756,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120757,
					"content": "Would you like to try it out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120758,
					"content": "Yikes! Such a cold gaze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120759,
					"content": "Paimon was just joking...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "It's fine. After all, I still hope you'll continue to use this sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120762,
					"content": "You still trust us? Even though this sword is so dangerous? Well that was unexpected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120763,
					"content": "Albedo, you say one thing but do another... Paimon can never tell what's really on your mind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120764,
					"content": "I have no idea what you're talking about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120765,
					"content": "But if you want to know why I trust you... It might be because...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120766,
					"content": "The \"unusual\" ones like us share a certain degree of understanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120767,
					"content": "Unusual ones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "Lonely individuals... Those who aren't like ordinary people. Just like... you and me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120769,
					"content": "(...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "(Is he implying something?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "Paimon didn't mean anything bad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "Aren't Treasure Horders a bigger threat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120731,
					"content": "I don't think Paimon has the same problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120716,
					"content": "If that happened to me, I'd get mad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				}
			]
		},
