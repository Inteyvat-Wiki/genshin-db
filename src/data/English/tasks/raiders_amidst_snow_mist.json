			]
		},
		{
			"id": 4121205,
			"completionStepIds": [
				4121208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121208",
							"2"
						],
						"stepId": 4121208,
						"stateName": "QUEST_STATE_UNFINISHED"
