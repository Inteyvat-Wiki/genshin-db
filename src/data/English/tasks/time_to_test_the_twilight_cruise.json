			},
			"dialogs": [
				{
					"id": 150470101,
					"content": "You're here! Looks like the staff had to step out for a bit, but I've pretty much figured out how to take it for a spin... ahem, yeah, for testing purposes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Great, then show us the ropes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Basically, one person rides the boat while the other sends signals to the saurian staff. Working as a team, the aim is to safely guide the boat to its destination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#So I'm pretty confident — 'cause when it comes to teamwork, {NICKNAME} and I have it down to a T!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Oh really? Well, don't get too confident, or you might end up capsizing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Whoa, Paimon, don't go around jinxing people!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Okay, okay... Then Paimon wishes you... smooth sailing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Hehe, that goes without saying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "I'm actually kind of in the mood to ride the boat. I'm used to tough surfing challenges, so it'll be fun to switch it up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "I'm kinda tired of the Waverider too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "See, we're in perfect sync already! That's gotta be proof of our bond, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Can't wait to pump up my inflatable swimsuit and bounce right onto the boat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "I'll take care of the signals.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
