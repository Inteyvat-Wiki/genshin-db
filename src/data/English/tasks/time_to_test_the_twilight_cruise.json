			"dialogs": [
				{
					"id": 150470501,
					"content": "You return, having indwelt an iktomisaurus...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "Mualani, we're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470503,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#Oh, hey there! Aww, aren't you just the cutest? Wait, where'd {NICKNAME} go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "#Uh, {M#he}{F#she}... {M#His}{F#Her} stomach started acting up, so {M#he}{F#she} had to run to the bathroom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(Seriously Paimon, that's such a lame cover story. Never mind, as long as Mualani buys it...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "My, you're a friendly one! Wanna try a Glowing Hornshroom? Here, have at it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470509,
					"content": "(A curious flavor, indeed. Thick, juicy, and surprisingly delicious, for a mushroom...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Haha, glad you liked it! Here, they're all yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470512,
					"content": "C—Can I pet you? C'mon, let's be friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470514
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470514,
					"content": "Also, could you... do me a favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
