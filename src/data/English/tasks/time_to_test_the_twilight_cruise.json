			},
			"dialogs": [
				{
					"id": 150470401,
					"content": "...Oh, so the facilities here are still under construction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470402,
					"content": "Look, there's an iktomisaur employee! Should we ask him for help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470403,
					"content": "Hi there! Any chance you could give us a hand getting these built?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470405,
					"content": "Um... Put... here... and build...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470407,
					"content": "Doesn't look like he understands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470408,
					"content": "Yeah... Hmm, what should we do now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470409,
					"content": "...Ohhhhh, hold on! A stroke of genius just came to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470410,
					"content": "Eee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470412,
					"content": "Eee! Eee! Eee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470413,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470414,
					"content": "Hah, nope... Well at least we know he doesn't speak koholasaur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470415,
					"content": "Why don't we just—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "Oh, I've got another idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470417,
					"content": "What now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470418,
					"content": "I once heard Ifa mention that iktomisaurs go wild for Glowing Hornshrooms, and guess what I happen to have on me...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470419,
					"content": "This has gotta be it! Once he eats this, we'll totally be on the same wavelength!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470420,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470421,
					"content": "There's no such thing as packing too much when you're heading out on a long trip... Kachina was spot on. Gotta remember to thank her for this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470422,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150470423,
					"content": "Uhhh, whatever that was, it's definitely not the wavelength Paimon's on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470424,
					"content": "What a disaster... Day one, and there goes my dream of conquering all the challenges in Wavey Bay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470425,
					"content": "#Got any ideas, {NICKNAME}, o great hero of Natlan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470426,
					"content": "Well, there's always one option...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "#Okay, let's try that. Appreciate it, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470427,
					"content": "I can fetch another iktomisaur to help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
