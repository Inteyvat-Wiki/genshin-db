				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Guys, thank you so much! I can't believe I actually found them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121002,
					"content": "Mom! Dad! Check out the legendary weapons I found!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121003,
					"content": "Hey, wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121004,
					"content": "The wine, you promised! Ugh, and I actually helped a lot this time—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121005,
					"content": "Hmm? What're you doing here, Stanley? Out for a stroll?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121006,
					"content": "Ah... haha, ah— hey...! What're you doing here, bard! Fancy that, huh? You, uh... out for a stroll, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121007,
					"content": "That's right, an after-dinner stroll to be precise. We were also helping a friend look for something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121008,
					"content": "(Paimon's starting to think Stanley might be a fraud...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121009,
					"content": "(I'm seriously starting to think so, too.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(Did Stanley plant the sword and shield here in advance so as to not hurt Jack's feelings?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121012,
					"content": "Adventurers must be pretty familiar with Dadaupa Gorge? You've fought battles here before, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121013,
					"content": "You'd better believe it! I could navigate this whole area with my eyes closed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121014,
					"content": "Wow. Then I admire your perseverance, and your memory too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "It's only to be expected of a great adventurer like me! You guys had better watch out though. This place is crawling with hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "I, ah— I'll get back to my, um... ah... stroll now. Goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121017,
					"content": "Guilty conscience, much?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121018,
					"content": "Well, he shouldn't have gotten so carried away bragging to Jack, should he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121019,
					"content": "Although... on further reflection, I must say I'm intrigued.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121020,
					"content": "Someone who can't let go of the past, and gives up on the present instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121021,
					"content": "I wonder... if such a person was forced to take their first step towards the future, which way would they go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121022,
					"content": "What are you talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121023,
					"content": "Haha, I'm just musing to myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121024,
					"content": "#Anyway, {NICKNAME}, I propose we take a trip to <color=#00E1FFFF>Angel's Share</color> tonight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121010,
					"content": "(He's definitely a fraud. No question.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
		},
