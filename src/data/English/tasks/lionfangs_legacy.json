					"Hilichurl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Lo and behold, the <color=#00E1FFFF>Shield of Magnificent Honor</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "Liar, liar, pants on fire! It's a chunk of wood!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "A chunk of scrap wood with a handle attached... Who in their right mind would use this as a shield!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "There's also wine stains on it... Yeah, I'm pretty sure this was just taken from a wine barrel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "And yet, my bard's intuition tells me that this is none other than the Shield of Magnificent Honor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "Warriors wear their battle scars with pride, and shields are no different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Surely, an intact shield is one that has shied away from the battlefield. Is not the broken and splintered shield the one that has fought in countless wars and lived to tell the tale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Though the soldier's body be tired and torn, still they fight till the very end, till they have no blood left to bleed. Such magnificent strength of will... is that not the true meaning of honor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "I agree with Venti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "You do have a point... Shiny new shields don't stay new and shiny for long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "Okay then... Well, maybe if we ask nicely, he'll just let us take the Shield of Magnificent Honor for free?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "*clears throat* Excuse me, Mr. Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120616,
					"content": "#Welp! Okay, you take it from here, {NICKNAME}! Hope you've picked up some Hilichurlian by now. If not, there's always body language...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "I'll pay good Mora for that shield.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120623,
					"content": "Uh-oh... He <color=#00E1FFFF>did not seem to appreciate</color> that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Please take this sweet flower I picked.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120628,
					"content": "Seems <color=#00E1FFFF>cheerful</color> enough. Maybe negotiating will work after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti sing song, you give shield, okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Hmm? Well, if you insist, a tune I shall strum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
