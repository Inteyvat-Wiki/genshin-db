					"Grandmaster Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Splendid, splendid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360102,
					"content": "I did not expect the Arataki Gang to defeat so many mighty beetle fighters. It seems that you are well-versed in this art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360103,
					"content": "I take back what I once said. You are respectable and worthy opponents, and I must face you as such — with my full strength!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727360104,
					"content": "Alrighty! Bull-Chucker, you're our leader. It's your time to shine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "And, uh, don't take what was said earlier seriously!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "You're up, Bona-Fide Beetle Battle King!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Hahahahahaha! Oh, it's on! The final showdown, and my soon-to-be final victory!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "I don't know how you've been leading your crew, but the results speak for themselves: The Arataki Gang rules!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Grandmaster Hanakado, get ready to battle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "The King versus the Grandmaster! This will be legendary!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
