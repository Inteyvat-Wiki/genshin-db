						190941402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190941402,
					"content": "I think the song should express the joy of being together with family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190941403
					],
					"speakerTitle": "Barbara"
				},
				{
