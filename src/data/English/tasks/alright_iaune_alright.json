			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arouet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "Traveler, have you come to help us out? You're most welcome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130202,
					"content": "No, no, we're just here to help a friend make some coffee. He's just... Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130203,
					"content": "He's feeling a bit down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "By \"a friend,\" do you mean Iaune — you know, the fellow sitting over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130206,
					"content": "You know him?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "Roialte and I are old friends. He mentioned that a bright, hardworking fellow came to their office recently, and that's Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130208,
					"content": "Don't you worry too much about him — young people who've just started at the Maison Gestion will always find themselves a little dejected at first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130209,
					"content": "They'll be fine once they find a place for themselves there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130210,
					"content": "You sound very experienced. Why's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130211,
					"content": "Well, I was once a radish planted in the field that is the Maison Gestion, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130212,
					"content": "But I wasn't satisfied with being a mere radish, and so I left my lot and... opened this café some time later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130213,
					"content": "Sounds like a lot happened...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "Hahaha, perhaps! But nowadays, I'm just a café owner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130216,
					"content": "Alright, weren't you going to make Iaune a cup of coffee? I'll go adjust the device — come find me once you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130214,
					"content": "Sounds like a real trove of stories to be told...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "He's feeling the pressure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
