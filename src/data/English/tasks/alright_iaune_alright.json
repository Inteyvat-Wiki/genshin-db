			"dialogs": [
				{
					"id": 240133101,
					"content": "That sounds great! Time to start blending, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "You start brewing coffee...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Ooh, that smells good! Now let's hand it to Iaune. Paimon sure hopes it cheers him up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
