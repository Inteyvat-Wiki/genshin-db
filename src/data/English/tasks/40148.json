						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Uh... Food's here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Oho, so this is Humbly Enough? You guys don't mess around! Love me that portion size!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Come on, compadre, grab a seat. We're all friends here, so don't hold back! I'm just gonna dig right in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Ahem! Boss, we should respect the local customs. Here in Liyue, it's polite to let the guests eat first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "Polite? Uh... Shinobu, I thought old-timey traditions weren't your style...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "Now that I've finished in the kitchen, I'm a guest too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "Huh? Are you kidding me, compadre? ...Ohh wait, I get it. The food smells so dang good, now everyone's dying to go first! Well, guess I only got my own good taste to blame. Go on, dive in, I'll wait till last!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "You, Paimon, Ayato, and Shinobu help yourselves, leaving very little \"meat\" behind...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "...Hah, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "Finally, it's my turn! Hoohoo, I spy a big chunk of deliciousness with my name on it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Wait, don't!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Huh? What is it now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "You got this, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Uh... Okay, here goes... Anyway, so uh, Paimon forgot to tell you the really cool origin story of this dish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "Origin story? Dude, who cares where it came from — we all know where it's going! Am I right? Down the gullet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Uh, well, umm... Skipping the origin story is like... like going traveling without a tour guide! Trust Paimon, you'll get way more out of the experience after you hear it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "Paimon makes an astute observation. Much as every tea must be appreciated on its own terms, is it not a waste of the chef's goodwill to sample a dish without hearing its tale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "My compadre's goodwill, huh? Can't have that going to waste... Alright then, gimme the full story! I'm all ears!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "That's more like it! Let's start with the ingredients... Actually, no, let's start with the story of Wangshu Inn... which starts with the history of Dihua Marsh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#(Now's our chance, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Got it!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "While Itto is distracted, you and Shinobu begin to gobble down the dish...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "...Man, the tale of Dihua Marsh hits hard... People in the past had it pretty rough. Makes you appreciate what you got. \"Humbly enough\"... that's a good way to think about life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Darn, there's no segue to tofu from here... How'd we get so off topic? Ugh. Well, good news is there's only a little bit left!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(But we're already... beyond stuffed...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "Aaah! Compadre, Shinobu! Have you been eating this whole time!? Save me some dregs, why don't ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "That's it, I'm done waiting! It's my turn to eat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Wait! Boss, that's made of—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "One moment, Itto. I... have a small request, if you would be so kind as to consider it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "I left home in a hurry, and was unable to bring any of my family with me. They've all heard so much about you and are huge admirers of the Arataki Gang, so they will be devastated to learn that they missed out on this opportunity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "However... if you were willing to let me bring the remaining portion of Humbly Enough back to them, I'm sure it will help to lift their spirits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Ehh... Yeah, I dunno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Boss, you gotta do right by your friends. They're pretty big on that in Liyue... Besides, you did eat quite a lot of the grilled fish while we were waiting for the main course...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "...Including mine and Ayato's.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Huh? Those were for you guys!? Ah, dang it... I got too carried away telling that story, didn't I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "Ah, in that case... Pass my regards to your fam, bro! El Chefe, can we get the rest of this to go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "You know the drill...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Maybe let me dig in first?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
