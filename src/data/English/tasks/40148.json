			"dialogs": [
				{
					"id": 401480401,
					"content": "Gotta say, your friend's quite a character... Still, Humbly Enough isn't that hard to make, so I don't think we'll have any problems with this order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480402,
					"content": "Actually, why is it called \"Humbly Enough\" anyway? A hearty meat dish is a good start, but in Paimon's experience, one humble dish is never enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480403,
					"content": "Uh, I said it was hearty, but I never said it contained meat... Don't be fooled by the appearance — it's actually just tofu made to look and taste like meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480404,
					"content": "Tofu!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "Wait! Tofu is made of beans, isn't it... Bull-Chucker can't eat that! Guess we'll have to get them to pick something else instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480406,
					"content": "...What's the issue? I think I caught the word \"tofu\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480407,
					"content": "Wait, what are you doing? The kitchen is staff members only... *sigh* Never mind, I'll let it slide. Ma'am, could you possibly ask your Boss to order something else instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480408,
					"content": "...Haha! No one gets my bro Ayato like I do! I hereby declare that Humbly Enough will be an everlasting symbol of our friendship, or my name ain't Arataki Itto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480409,
					"content": "...Hey! Where's our food at? Hurry up, I'm almost done recounting the epic adventures of Crimson Staff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480410,
					"content": "...As you can see, changing the order may be a little difficult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480411,
					"content": "Oh brother, his whole ego is riding on this, huh... Even if we break the news to him, he'd probably rather eat the tofu than eat his words...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480412,
					"content": "We're locked in now... We gotta cook that dish...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "Sounds good. I'll make sure he fills up on those... We'll just have to play the rest by ear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480413,
					"content": "How about we throw some free appetizers in?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
