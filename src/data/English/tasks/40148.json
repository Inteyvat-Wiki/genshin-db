			},
			"dialogs": [
				{
					"id": 401480101,
					"content": "#Morning {NICKNAME}. Time to fire up the stove for another day of customers. Thanks again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480102,
					"content": "With days of experience now under your belt, the work is becoming second nature...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "Great work... You're looking more like a head chef every day! Hehe, whatever crazy characters come walking through that door, I know you'll be able to handle them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480104,
					"content": "Wait, no! Every time you say something like that, you jinx it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480105,
					"content": "Hey, that's not true! Anyway, I didn't mean it like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480106,
					"content": "Ahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480107,
					"content": "Dude! What up, bro!? I didn't know you were in Liyue too! Ah, it's always nice to run into a broad Inazuman fellow... Wait, did I say that right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480108,
					"content": "Almost. I think you meant \"fellow Inazuman abroad,\" Boss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480109,
					"content": "Yeah, yeah, that's the one! We gotta look out for each other when we're this far from home! Don't we, Ayato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480110,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480111,
					"content": "...Bull-Chucker! What are you doing here!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480112,
					"content": "Huh? Oh hey, Flying Lavender Melon... uh, of the \"Skycleaving White Iron\" variety! And my compadre, too! All my buddies in one place, today's my lucky day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480113,
					"content": "Didn't you say you were gonna knuckle down and earn some Mora when you got home? How come you're back in Liyue so soon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480114,
					"content": "Haha, that can wait. As soon as I announce that Arataki Itto is available for hire, they'll be throwing Mora at me... Right now, I got a more urgent situation to attend to: I'm in the mood for some good, spicy food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480115,
					"content": "...Oh, and while we're here, we were also gonna see if Grandmaster Hanakado's okay, and whatnot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480116,
					"content": "(The look on Shinobu's face seems to say... \"Don't ask.\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "So what about you, Ayato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "...Not too long ago, I heard a rumor that someone was hosting an Onikabuto-fighting contest in Liyue. Naturally, I came here as soon as I could... but alas, it was too late.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480119,
					"content": "What? You missed it? Aw man, what a bummer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480120,
					"content": "Quite the bummer indeed — though all is not lost. Since you're here, you'll be able to tell me all about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480121,
					"content": "Haha, sure thing my man! But let's catch up over some food... Where's the chef, anyway? Hey, get the chef out here — I got compadres to feed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480122,
					"content": "I'm the chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "Yeah, sure, me too... What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480124,
					"content": "Wow, Bull-Chucker set that one up for us really nicely. Gotta give him some credit for that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480125,
					"content": "...But the main chef is another guy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "Uh... Haha, good one compadre, you almost got me there. Alright, well get the chef out here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480127,
					"content": "You and Paimon go to the kitchen and fetch Smiley Yanxiao...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "So, uh... May I take your order? If you're entertaining guests, I can recommend The Palace Jewels, a Trembling Strings and Rushing Reeds, or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480129,
					"content": "...Boss, don't forget the budget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480130,
					"content": "Yeah, okay, um... Got anything a little more, uh... down to earth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480131,
					"content": "Down to earth...? Oh... Well, we do a mean \"Humbly Enough.\" Real hearty dish with a ton of flavor, and we don't skimp on the portion size either. That'd be the best value for your Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480132,
					"content": "Humbly Enough, huh? Sounds like my kind of grub! We'll take that — no need for anything fancy, we're all friends here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480133,
					"content": "Excellent choice, Itto — I'm no fan of culinary ostentation either. Heh... sometimes a bro just knows, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480134,
					"content": "A bro just knows... Yes, a bro just knows! Bros don't suppose, 'cause bros just knows!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480135,
					"content": "Is this for real? ...Whatever, Paimon's leaving you guys to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
