			},
			"dialogs": [
				{
					"id": 401489501,
					"content": "I never knew tofu allergy was even a thing... Okay, I'll handle the appetizers, you take care of the main event.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489502
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401489502,
					"content": "I can help, too. Don't worry, I'm qualified — I passed Liyue's senior culinary exam once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				}
			]
		},
		{
			"id": 4014896,
