			"dialogs": [
				{
					"id": 401480301,
					"content": "Looks like that's all sorted? Alright, take some time to collect yourself — the next big group is coming in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480302
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401480302,
					"content": "The rest of the day passes without incident...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
