					"Kamisato Ayato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401489601,
					"content": "...Seriously, if I'd blinked I would've missed it! Crimson Staff just launched itself at Bloom Pruner and sent it flying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489602
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401489602,
					"content": "I'd expect no less of the Bona-Fide Beetle Battle King himself. It sounds like a truly epoch-defining duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayato"
				}
			]
		},
		{
			"id": 4014897,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
