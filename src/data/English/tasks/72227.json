				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270201,
					"content": "I'm gonna grow up as quick as I can, and then I'll become an adventurer, just like you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
		{
			"id": 7222703,
			"completionStepIds": [
				7222705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7222705",
							"2"
						],
						"stepId": 7222705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "Looks like we're done here as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270302,
					"content": "Wow, so this is what a real adventurer can do, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270303,
					"content": "I mean, other people did come here before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270304,
					"content": "But none of them were as strong as you and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270305,
					"content": "Others!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270306,
					"content": "Yeah, they came to look for Maushiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270307,
					"content": "Huh, then Sumida must've...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "Paimon doesn't get it, though. What are these Maushiro? We've heard that they're traditional instruments that the people here use...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270310,
					"content": "Yup~ They make sounds and stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270311,
					"content": "It's hard for us to see in this fog, right? That's why we use the Maushiro to tell others where we are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270312,
					"content": "I mean, it sure beats yelling! That really hurts the throat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270313,
					"content": "It's true that you can't see anything around here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270314,
					"content": "Right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270315,
					"content": "Da... Grandpa Mata said that the Maushiro can help the souls of those lost in the fog to find their way back home, so they're very important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270316,
					"content": "So they're that important, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270317,
					"content": "No wonder you need them in the ceremony.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "That's right. I'm sure you'll both enjoy it very much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270319,
					"content": "You guys go first. I'd like to stay under the tree for while more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270320,
					"content": "Sure you'll be alright? There might be monsters out there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270321,
					"content": "I'll be fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270308,
					"content": "No wonder Katheryne had this pegged as a toughie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
