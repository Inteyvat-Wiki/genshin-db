			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Susukida"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3098.524,
							214.543,
							-4296.803
						],
						"pointId": 322100690
					},
					{
						"sceneId": 3,
						"position": [
							-3097.322,
							214.326,
							-4298.16
						],
						"pointId": 322100714
					}
				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "Y'know, I went out to sea earlier today, but was so distracted that I lost my net... Ah well, it's not a big deal though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "Yeah, I messed up today too... but hey, what's the big deal? A few bandits got away, it's not the end of the world, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "Hey, you two! Murasaki and Shion are sick, and it's all because of your bad dreams!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Whoa, someone's in a bad mood, huh? So funny, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "I know, right? Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "They're acting so weird! Paimon was pretty aggressive just now, but they don't seem offended at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "...Allow me. Gentlemen, do you still remember visiting Aisa Bathhouse last night for dream regulation therapy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "Did we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "I don't think so...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Huh... Do you recall having any bad dreams recently?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "No, why would I? What in this world could be so bad that it'd give me nightmares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Hmm... Nope, nothing comes to mind. Bad dreams must be highly irregular, surely? You don't have to look far to see that life is beautiful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "What is going on? It's like they've completely forgotten what they did last night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "Although, Paimon can believe what they're saying. They don't exactly seem troubled by nightmares... Does that mean Emura Ichigensai's counselling actually works?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#No, they're clearly not in their right minds... {NICKNAME}, Paimon, focus hard for a second. I'm gonna try something a little unorthodox...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "Wow, what did you do...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "Entered their subconscious minds. I noticed they've both become disassociated from their subconscious, meaning I can access it — similarly to how I enter people's dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "No, nooo! Those thugs, I won't let them get away with this! I won't!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Enraged Susukida"
				},
				{
					"id": 120460321,
					"content": "The sea's too rough today... I should stay on dry land till things calm down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Terrified Umihiko"
				},
				{
					"id": 120460322,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "As you can see, their troubles haven't gone anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Susukida seems to have a short fuse, which causes him to act out of line. I'm sure this has caused him a lot of grief in his line of work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "As for Umihiko... I believe he developed a fear of stormy waves after a near-death experience. Now, he's reluctant to sail out to sea at all, which is having a devastating impact on his livelihood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Their negative emotions have been isolated from their conscious minds and left to float around in their subconscious. That's why on the outside, the only emotion they appear to feel is happiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "But those suppressed emotions will only continue to fester in their subconscious, eventually turning into the nightmares that have been giving Murasaki and Shion indigestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "How did this happen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "...If it's Emura Ichigensai's doing, I guess he's not the straightforward conman we thought he was. Maybe he really does have ways of influencing human emotions. That would explain why no one has blown the whistle on him yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "Did you notice anything strange when you came here yesterday?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Not really. They were a lot more serious than today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "Actually, since you ask...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "You remember the strange dream from yesterday, and recount it to Mizuki.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "You sure kept that one quiet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "I didn't think much of it at the time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "Oh, no no no... Look, we have to find this Emura Ichigensai right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki... What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "#Something inhuman is at work in Emura Ichigensai. {NICKNAME}'s dream confirms that... He has victimized everyone who has received his so-called counselling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "If we don't find and stop him as soon as possible, his victims may well suffer irreversible damage to their psyches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "Yikes... Well, guess we'd better press these guys a little harder. Do you know when Emura Ichigensai will be here next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "What's with the urgency? Why does it matter when he shows up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "Yeah, he'll turn up when he's ready. No point trying to rush him, heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "Ugh, this is infuriating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "...You do remember what happened last night. Both of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "Only, you don't want to talk about it, because you can't reconcile the presence of a nightmare with the happiness you presently feel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Just thinking about it brings up an overwhelming sense of being torn apart. You can't quite put it into words, but you fear you're a hair's breadth away from a total breakdown... Is that about right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "...Please, stop. Everything will be fine as long as we don't think about it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "Emura Ichigensai's treatment has clearly left you wounded and vulnerable. But don't worry — I'm not here to snap you out of your denial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "...At least, as long as you answer our question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "Alright... But seriously, we really have no idea. We've asked already, and all we know is that he's not coming today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Yeah, uh... apparently yesterday's session kind of... tired him out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "Is he trying to hide from me again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "They really don't know anything? Darn. Looks like we've hit a dead end...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "I don't suppose you know where he lives, do you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "No. We did ask yesterday, but even his guard didn't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "In that case...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Have you found out what you came here for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Yes, I suppose... Now that I know what's causing their bad dreams, I can administer the correct treatment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "Then go do that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "...Honestly, you've already done your part by bringing me here. I can't keep troubling you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "Don't forget we wanna book our next therapy session! The sooner you stop having to worry about Emura Ichigensai, the sooner we get you all to ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "So, we're not gonna quit until all this is resolved, and the bathhouse is back to business as usual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "...Looks like I have no choice but to accept your help again. I have to make sure Murasaki and Shion get the treatment they need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Still, I'm gonna need your full cooperation. If you do find Emura Ichigensai, please do not approach him. Just send me a message and keep an eye on him until I arrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "The last thing I want is for you to put yourself in harm's way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "Ah, don't worry about that! You should see some of the other bad guys we've taken down in our time. This guy's small potatoes compared to them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "...Alright, sure. We'll keep our distance and send a message, heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Very good. Let's get going then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "...Pretty bold claim, saying you'll track this guy down. It's nice of you to give Mizuki one less thing to worry about and all, but... what the heck do we do now? What if we can't find him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "Cause in case you hadn't noticed, these guys are hopeless. They don't know anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Yep, they definitely have no idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Wait, you're right — she was the one who tipped us off about this place yesterday! She probably knows way more than she let on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "There's no time to lose! To the Grand Narukami Shrine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "But I suspect Miko knows something...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "I'll track down Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "Are you able to help Murasaki and Shion now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204604",
							"2"
						],
						"stepId": 1204604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2470.723,
							445.64,
							-4409.953
						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "She's usually somewhere around here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460402,
					"content": "Here for a fortune slip, little ones? Or visiting a friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460403,
					"content": "Whoa! Where did you come from...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "It's been a while, Lady Guuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "That was a little lukewarm. You're starting to sound a lot like her... But pleasantries aside, what's the matter? You look rather out of sorts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "We need to locate someone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "You may remember I dropped a not-so-subtle hint as to his whereabouts yesterday. You mean to tell me you still haven't found him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "Aha, so you did bring him up on purpose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "...Let's not lose focus here. You're here to ask for my help. So, would you mind explaining the situation to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "Yeah, fair enough... We went to the place you mentioned, but he slipped through our fingers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Next thing we heard was, he's not seeing patients there anymore — apparently, he loves his peace and solitude... So obviously, we've got no idea where to find him now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "*sigh* And after the lengths I went to to get you that location...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Dunno if this helps, but we did learn some other stuff about him yesterday. For example, a guy matching Emura Ichigensai's description came to Mizuki for therapy once — only his name was \"Emura Chuuya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "Wait, what? Emura Chuuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "You know him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "I once asked the Yae Publishing House to host an event for contributors to the readers' letters column. I had hoped it might be a fun chance to meet some like-minded people and chat... until he showed up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "Are you telling me that Emura the hell-raiser and Emura the healer are the same person?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Based on everything we've learned so far, it certainly looks that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Alright. Well, in that case... give this address a try.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Uh... Really? Who chooses to live in a place like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "This was the delivery address he gave to the Yae Publishing House once, when he placed an order for several dozen books in one go. He also requested to pay on receipt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "The warehouse took one look and assumed it must be some kind of prank, so they rejected the order... Earning them an honorable mention in his complaint letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "Of course, with the benefit of hindsight, it's rather obvious why he lives there. Someone as antisocial as him wouldn't be welcome anywhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "You've got a point... Well, we clearly made the right decision coming to talk to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "I'm just glad I could help my old friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "You mean Mizuki? So, you really do want to help her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "I can tell that she's invested an awful lot into the Aisa Bathhouse. It's only natural for me to show some concern when I see a friend's business in trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "Really? 'Cause yesterday, it looked more like you were looking for a fight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "I assume Mizuki has told you that we're competitors?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "She has always believed that, ever since we were classmates. And now that I'm the Guuji of the Grand Narukami Shrine, I'm sure she must feel the need to prove herself through her endeavors at the Aisa Bathhouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "The last thing she'd want is for me of all people to swoop in and save the day the moment the going gets tough... So if I want to help, I have to be mindful of her feelings and tread delicately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "It's rare to see you being so considerate...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "I'll take that as a compliment. Mizuki's always so considerate towards others — it would be nice for someone to reciprocate once in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Well, since you're in a difficult position...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "Well done, you took the hint. Now, while I'm sure you'd love to chat longer, you seemed to be in a great hurry when you arrived. Shouldn't you be on your way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "Oh, right! C'mon, let's send a message to Mizuki right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "...Maybe I can do the honors instead?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "Do you know where we can find Emura Ichigensai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
