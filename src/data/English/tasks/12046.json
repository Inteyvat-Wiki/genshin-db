			"dialogs": [
				{
					"id": 120460201,
					"content": "Mizuki, we're here to book our next therapy appointment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460202,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460203,
					"content": "Agh... It hurts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120460204,
					"content": "Oh no... What's wrong with them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460205,
					"content": "They've been like this ever since they woke up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460206,
					"content": "...It's an extreme case of indigestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460207,
					"content": "Huh? How come? Did they eat too many nightmares last night?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460208,
					"content": "I doubt it... We only had four customers yesterday, including you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460209,
					"content": "Paimon blames the other two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460210,
					"content": "You're right. Something's definitely wrong with their nightmares... Our ability to digest dreams isn't just a matter of quantity. It depends on the emotional intensity, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460211,
					"content": "Point being, no normal person should ever have a nightmare of this magnitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460212,
					"content": "*retching*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460213,
					"content": "The situation is dire. If I can't find a way to help them digest the dreams soon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460214,
					"content": "What can we do? Let us help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460215,
					"content": "We need to find those two customers from yesterday, and figure out the cause of their bad dreams. Without knowing that, I have no way of treating them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Paimon, I know you spoke to them both. Think you can track them down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460217,
					"content": "Let's see... Hmm, they did say they were gonna get counselling from Emura Ichigensai again. Chances are, that's where we'll find them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460218,
					"content": "Lead the way. I'm coming with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
