				"points": []
			},
			"dialogs": [
				{
					"id": 250260401,
					"content": "Let's go teach those Treasure Hoarders a lesson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "You're willing to come along? Thank you! And you'd be a big help, too — I can tell you're an experienced adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "I'll be sure to pay you as the Adventurers' Guild rules stipulate. Let's go then — we'll show those scoundrels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502605,
			"completionStepIds": [
				2502605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502605",
							"2"
						],
						"stepId": 2502605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1635.08,
							126.53,
							8876.872
						],
						"pointId": 350100057
					}
				]
			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "Hmph. Let's see them dare to hurt my little Yumkasaurus ever again, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "Feels like there's been some sort of misunderstanding...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Don't listen to their pretty words. Why, I saw them tie a rope to that poor Yumkasaurus's tail with my own eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Who knows what might have happened if I hadn't shown up when I had.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "Thanks for your aid, in any case. Here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "It's just a shame they fled so fast. If we'd caught them, we could put an end to their troublemaking once and for all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502606,
