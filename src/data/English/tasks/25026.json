						],
						"pointId": 350100056
					}
				]
			},
			"dialogs": [
				{
					"id": 250260601,
					"content": "...Shh. Look over there. He's waiting for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260602
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260602,
					"content": "...Woo? Mmwoo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260603
					],
					"speakerTitle": "Timid Little Yumkasaur"
				},
				{
					"id": 250260603,
					"content": "Come here, kiddo. We're not gonna hurt ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260604
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260604,
					"content": "Mwoo? Mmmmrawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260605
					],
					"speakerTitle": "Timid Little Yumkasaur"
				},
				{
					"id": 250260605,
					"content": "I'm Tlamot. Remember me? I'm the one who gave you those delicious treats before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260606,
						250260607
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260606,
					"content": "#And I'm {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260608
					]
				},
				{
					"id": 250260608,
					"content": "Roar... Rawrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260609
					],
					"speakerTitle": "Timid Little Yumkasaur"
				},
				{
					"id": 250260609,
					"content": "You play with the happy Yumkasaurus for a while. It seems he's in a much better mood...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250260610
					]
				},
				{
					"id": 250260610,
					"content": "Raar! Oroo, rrooh!",
