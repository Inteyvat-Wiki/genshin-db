				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Yeah, we made quite a big ruckus this time too. Amano and Mr. Andou will assist us in letting that thief learn about this in town.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "How much longer will this take?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Not long now. Once Sango is ready, we can close this case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "Here is your payment, Traveler. Thank you for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "This is the amount assigned by Sango herself, so I believe it should be commensurate. Please take them. We may yet have more work for you in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
