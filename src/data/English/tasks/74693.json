	"talks": [
		{
			"id": 7469301,
			"completionStepIds": [
				7469301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7469301",
							"2"
						],
						"stepId": 7469301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbeloth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Are you sure you can't make a copy of this card back for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930102,
					"content": "Absolutely certain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930103,
					"content": "Hmm... It's very impressive. Maybe we could come to some sort of arrangement...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930104,
					"content": "Absolutely not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930105,
					"content": "Mm, I see. Obtaining beautiful card backs and playing powerful cards both require a certain price. I think I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930106,
					"content": "I don't think you do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "Hey! You don't know why Cyno's here! Maybe he came here to—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930110,
					"content": "I sure did. That's my buddy, alright — we're on completely the same wavelength!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930111,
					"content": "Seriously!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930112,
					"content": "There's a small gathering of TCG players taking place here in Fontaine. I heard participants get event-exclusive cardholders for free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930113,
					"content": "There were no pressing matters at the Akademiya, so I came over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930114,
					"content": "Even if there were pressing matters, Paimon has a sneaking suspicion you would have found a way to make them... not-so-pressing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930115,
					"content": "You're right! I managed to finish almost all of my work after only two weeks of overtime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930116,
					"content": "Sethos helped out, too, so I promised to bring him a cardholder for his trouble. He's very good at paperwork.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930117,
					"content": "Well then, General Mahamatra, are you going to draw a card or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930118,
					"content": "Of course. You say this card will predict my future, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930119,
					"content": "Technically, not quite. But it's unlikely to cause much trouble if you choose to understand it that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930120,
					"content": "Hm, I see. Is this like that line in \"Duel Master\"... \"Stake your fate on the next card in the draw\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930121,
					"content": "And now it's my turn to draw...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930122,
					"content": "Cyno takes a deep breath, makes a stylish pose, and draws a card...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Ah, reversed Temperance. A fitting card for the \"General Mahamatra\" of the Sumeru Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930124,
					"content": "You already know who Cyno is?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Alice mentioned him a few times. She finds it funny that the stuffy old Akademiya has a General Mahamatra with such a \"well-developed\" sense of humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930126,
					"content": "Please thank her for the compliment. Now that I've drawn a card, what should I do next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930127,
					"content": "Since it's reversed Temperance, or rather, reversed \"Artistry,\" I suggest you maintain a state of doing nothing for the time being.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930128,
					"content": "You've been acting rashly and have nearly lost your footing on the narrow bridge of fate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930129,
					"content": "It's because I've been playing too much cards, isn't it? Sethos and Tighnari told me the same thing — I've already adjusted my schedule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930130,
					"content": "...I'm not talking about playing cards. I mean your working hours. Surely Genius Invokation TCG isn't the only thing that demands the General Mahamatra's full attention?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930131,
					"content": "My duties don't leave me much room to adjust them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930132,
					"content": "You're used to bearing the pressure of such a busy schedule alone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930133,
					"content": "There are other matras. We share the pressure among us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930134,
					"content": "But they all rely on you? Not just the matras, but the researchers and the people of Sumeru... So many people put their faith in you, General Mahamatra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930135,
					"content": "They never tell you, perhaps they don't even realize it themselves... Why would they, when they're all so captivated by your unstoppable wit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930136,
					"content": "But you can feel their gazes, looking to you night and day... Oh, and the shadow that walks beside you. He, too, is one of your burdens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930138,
					"content": "You're used to leading the way, carrying the burdens of others... I think, perhaps, this is the reason for your imbalance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930139,
					"content": "I have many friends. One of them just happens to be a \"genius\" who goes by the name of \"Invokation TCG\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930140,
					"content": "So, it seems you have no intention of resting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930141,
					"content": "There's no time to rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930142,
					"content": "Indeed. For someone such as yourself, if the inner battle is endless, then even death won't mark the end of duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930143,
					"content": "Take this Lunar Arcanum. Perhaps it will lead you to the reason that restores your balance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930144,
					"content": "When it does, the battle within you should also reach a decisive end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930145,
					"content": "Cyno won't lose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#Thank you, {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930148,
					"content": "And my thanks to you as well. And don't worry, I promise I won't start acting too crazy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930149,
					"content": "...Huh? Why would you... Wait, was that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930150,
					"content": "Oh no, not again!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "...What does this have to do with acting crazy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930154,
					"content": "Because now I have this card...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930155,
					"content": "...People might accuse me of being a bona-fide \"Lunar-tic\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930151,
					"content": "He's come up with another one.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "Barbeloth, don't ask—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "Cyno's the strongest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "I don't think I do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "You came all this way to play cards?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
		{
