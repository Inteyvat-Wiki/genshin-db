			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180102,
					"content": "Is it just Paimon, or do you smell something yummy too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180104,
					"content": "Columbina's having a feast for one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180106,
					"content": "Looks like someone's enjoying herself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Would you like to try some as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180108,
					"content": "No, no, you go ahead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "We don't usually see you eating here! Did you go out just to buy it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Lauma gave it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180111,
					"content": "Wow, she sure takes good care of you, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "On the condition that I don't leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180113,
					"content": "Wait, what!? Isn't that just a bribe so you'll accept house arrest? And a cheap one, at that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "She also brought me some interesting books and exquisitely made toys...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180115,
					"content": "Um, now it sounds more like a mother going out on a business trip and the kid she's leaving at home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Did Lauma explain her reasoning?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "She just told me not to go out for the time being, and to be especially sure to avoid the Frostmoon Scions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180118,
					"content": "I asked the animals who came to deliver my meals, but Lauma had instructed them to remain silent, and so they did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180119,
					"content": "Uh, that's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "If I had to guess, she is preparing something that has to do with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180121,
					"content": "Worry not. I have never considered staying here boring in the first place. The food is good, and much to my liking. Not going out is fine with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180122,
					"content": "And if the Scions are indeed preparing for something... Well, all the more reason not to interrupt them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180123,
					"content": "Want us to go ask around?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Yeah. Paimon's kinda curious now, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "You can... but you should be prepared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180126,
					"content": "She likely knows you'll come to see me, so she may not tell you anything at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
