							11196.91
						],
						"pointId": 360300084
					}
				]
			},
			"dialogs": [
				{
					"id": 761180401,
					"content": "Ah, you're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180402,
					"content": "Guess what, Columbina? You were right, Lauma didn't tell us a thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "She seems quite busy, though.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "So we'll be keeping you company over the next few days. You just sit tight and keep those expectations high!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "Expectations for... what exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180406,
					"content": "Ack...! Oh! Uh, nothing! We don't know a thing, honest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Hehe... Very well, then. I look forward to spending the next few days with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 761180409,
					"content": "Ooh, here comes our food... Wait a minute. Where's the grub?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 761180411,
					"content": "It says, \"The time has come.\" Do you know what that means?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180412,
					"content": "Ohhhhh, Paimon gets it now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180415,
					"content": "You usually wear a blindfold, don't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Yes. What of it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180417,
					"content": "But you can use kuuvahki to observe the outside world even so, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "That's right. If anything, I sense things more clearly this way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180419,
					"content": "Then, uh, could we ask you to deliberately not sense any changes outside for the time being?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "So that this can be a \"pleasant surprise\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180421,
					"content": "...Sounds like you've already guessed what this is about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Alright. I see. In that case, would you take my hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
