			},
			"dialogs": [
				{
					"id": 761180501,
					"content": "Here we are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180502,
					"content": "You can open your eyes now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180503
					]
				},
				{
					"id": 761180503,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180504
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180504,
					"content": "(She really did open her eyes!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(I just said that without thinking...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "It's beautiful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180507,
					"content": "This pair of wings makes it look all the more complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180508,
					"content": "This is a gift we Frostmoon Scions would like to give you, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "To celebrate our goddess who can now fly free, whose fingers can at last touch the place she calls \"home.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "...The me from before would only be reminded of the confusion I felt upon being born whenever I looked upon this statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180511,
					"content": "But now, what I feel is the warmth of a \"home.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180512,
					"content": "Perhaps, like this statue, I have chosen to stay here even though I now have wings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180513,
					"content": "...Thank you all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180514,
					"content": "We do have another gift prepared, but you'll have to walk with me a bit farther.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Huh? There's another surprise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "My fellow Scions and I have organized a simple welcome banquet in the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "From now on, this will be your home as well, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Whenever you grow homesick, please, feel free to remain here and enjoy our hospitality, meager though it may be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Sure. I will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761180520,
					"content": "Well, what do you know? The moon's up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Let's go, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "It is my hope that every night may be as wonderful as that Moon-Prayer Night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Welcome home, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		}
	]
