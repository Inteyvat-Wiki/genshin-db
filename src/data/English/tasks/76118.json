							1803.217,
							240.145,
							10366.37
						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "You wanna renovate the statue of Kuutar!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Precisely so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "No longer is she the wingless Kuu{RUBY#[S]Moon Maiden}tar who could only gaze at the moon beyond the skies in solitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "We witnessed her unfurling her wings, and know she has regained the freedom to live.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "As such, it is only right that the statue, too, be restored.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "That does sound like a good idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "Have you told the other Frostmoon Scions about this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "That I have. I spoke to them of the Moon Goddess's sacrifice, and her return...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "And of how we stood against the force that pollutes this world with the guidance of that gentle light.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Everyone was delighted to hear of her return, so I took the opportunity to convey Columbina's thoughts to them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "That she wants to see us as family, and would like us to do the same for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "And what did everyone say?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "The Lady Moon Goddess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "Would we... not be overstepping by regarding her as family?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "I believe that this is what Columbina genuinely wishes for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(I can't believe the Lady Moonchanter referred to our Moon Goddess by her first name!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Perhaps you may all yet recall the words I spoke not long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "\"The road shall be paved with truth, and we shall pave it ourselves.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "I will not ask all of you to make the same choice as I, but I do have words I would like to share with you this day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "\"If we wish to invite the moonlight in to stay, we must first open doors that once were tightly shut.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "...That is what happened. Considering the situation over the past few days, things seem to have gone better than I thought they might have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Lady Lauma. A new batch of stone has arrived at the warehouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Understood. I'll be right over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "Could you keep what I said, including what you've seen, a secret from Columbina — at least for now? I'd like this to be a surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
					"content": "Paimon knows you mean well, but seriously, you sure do love your surprises... You, and your Moon Goddess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180327,
					"content": "My lips are sealed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "Hey, Lauma, about Paimon's hush money... Er, Paimon meant to say, we don't happen to have any spare Feast of the Moon servings today, do we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180329,
					"content": "That we do. Come, let me prepare some for you. Oh, and one more thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
