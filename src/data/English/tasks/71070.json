				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702001,
					"content": "Oh, you're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702002
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702002,
					"content": "Something's been wrong with Zhiqiong lately. I suspect that it's that... tainted stuff that's affecting her mind and body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702003
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702003,
					"content": "Whatever it is, it's strikingly similar to the way in which locals here five hundred years ago described the dark calamity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702004
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702004,
					"content": "But today, the Yakshas are a distant memory, and Rex Lapis too has left us... I must admit that this is the most worried I've ever been for the safety of us mortals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702005
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702005,
					"content": "Sorry... I kept you back just to tell you all this pointless nonsense. Still...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702006
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702006,
					"content": "Never mind... You stay safe now, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107021,
			"completionStepIds": [
				7107006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
