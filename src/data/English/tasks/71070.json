					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710703001,
					"content": "#Oh? Why, hello there! I thought you'd left, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703002
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703002,
					"content": "The energy readings around here have stabilized a great deal, thanks to you. When I go back and write my thesis, I will mention you for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703003
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703003,
					"content": "However, as the nominal employer of the exploration team, I will still need to stay for a long time to observe this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703004
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703004,
					"content": "Well, I've got to go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710703005
					]
				},
				{
					"id": 710703005,
					"content": "Then I shan't keep you. Just know that you'll always be welcome with the exploration team!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		}
