					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702401,
					"content": "Back again, are we? Do you need something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702402,
					"content": "About Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702403
					]
				},
				{
					"id": 710702403,
					"content": "She went back up to fix some map errata. I'm not sure what the hurry's about... But it's good to see that she's in good spirits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702404
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702404,
					"content": "Whatever you, whatever the case... I don't know what methods you used to bring her back, but I'm just glad she is. We all are, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107025,
			"completionStepIds": [
				7107010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107010",
