			},
			"dialogs": [
				{
					"id": 710702301,
					"content": "Sorry for telling you all that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702302
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702302,
					"content": "I won't take up any more of your time... We've all got things to busy ourselves with, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
