					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702901,
					"content": "Ah, you're here! Welcome to the Chasm Exploration Team's demolitions team base and water point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702902,
					"content": "We — by which I mean I, Clitopho — salute you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702903,
					"content": "Come, come, have a drink! Consider it my treat — just a little something for all you've done for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702904,
					"content": "What's next for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Well, I'm an official member of the team now, so since they're staying, I'm staying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702907,
					"content": "Well, things would certainly be easier if Khedive and Jinwu could get me some extra help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702908,
					"content": "Though that said, I wouldn't be able to call myself the sole member *and* team leader if that were to happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702905,
					"content": "Will you be sticking around?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
			]
		},
