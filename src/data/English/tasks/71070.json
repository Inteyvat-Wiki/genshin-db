					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702201,
					"content": "Phew, the swelling in my leg's gone down... as has the pain. I should probably write an epic for Liyue's medicinal oils, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702202
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710702202,
					"content": "Ah, sorry, didn't see you there — I've just been resting over here all this while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702203
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710702203,
					"content": "If you're looking for Zhiqiong, I believe she said that she was looking for some kind of gate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702204
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710702204,
					"content": "She said that she'd share the story of her adventure with me, too. Just head over that way, you should find her easily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7107023,
