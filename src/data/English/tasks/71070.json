				"points": []
			},
			"dialogs": [
				{
					"id": 710701901,
					"content": "Sorry, I'm a little dizzy at the moment, but I can take it! Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701902,
						710701907
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701902,
					"content": "What is it you're doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "I consider myself a bard of the old school, so of course I'm here to get some inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701904,
					"content": "Well! You looked pretty alright just a moment ago, and now you look like you're about to drop any second!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710701905,
					"content": "I've never gone down into a mine before... And in my hurry during in getting here, I wound up... pulling a muscle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701906,
					"content": "Ow ow ow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701907,
					"content": "I won't disturb you, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "Agh... This medicinal oil really isn't doing it for me... Well, see you, and do come to me again when you have new stories to tell, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7107020,
			"completionStepIds": [
				7107005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107005",
							"2"
