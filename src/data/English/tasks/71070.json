			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702101,
					"content": "Zhiqiong left just a moment ago. She seemed pretty angry about something... Do you know what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702102,
					"content": "I mean, come on! She said that she wouldn't be mad at me anymore... and yet her temper hasn't changed for the better in the slightest since coming to this campsite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702103
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702103,
					"content": "That Khedive guy's telling everyone that Zhiqiong's lost it and has to leave The Chasm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702104,
					"content": "Heh. Sounds like he's the one who needs to get his head checked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
