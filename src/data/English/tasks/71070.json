					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702801,
					"content": "Haha, you're back. Well then, sit down and rest for a bit. Make yourself at home!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702802,
						710702803
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702802,
					"content": "I wouldn't call this place \"homely,\" per se.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "Hahahaha! Ow, your tongue's sharp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702805,
					"content": "Thanks to your help, the atmosphere at the camp has become way more relaxed. If I gave you the impression that I was the overly-serious sort before, I'm very sorry about that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702806,
					"content": "The important business has already been settled. Now, the long-term work that remains is... setting up a permanent lookout underground to watch for any changes in the situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702807,
					"content": "During this period, many mines can now be partially opened, but going this far underground is still forbidden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "We need to seal up this area and prevent any miners... No, prevent anyone from coming down here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702803,
					"content": "What am I now, a tunnel-dweller?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
			]
		},
		{
			"id": 7107029,
