			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702501,
					"content": "Hello there! If you're up for a chat, I'm all ears!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702502,
						710702504,
						710702507
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702502,
					"content": "Well, you sure look like a pair of idle hands.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702503
					]
				},
				{
					"id": 710702503,
					"content": "Oh, come on. Are you taking me for a slacker? I'll have you know that every time I'm needed, I barely have time for anything else!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702504,
					"content": "How's Zhiqiong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702505
					]
				},
				{
					"id": 710702505,
					"content": "Her? She seems to have calmed down a lot after coming back. Honestly, I wonder if it isn't just this eerie environment that's making everyone's fuses shorter and tempers hotter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702506
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702506,
					"content": "I was just scolded by Jinwu not long ago. Never seen her that angry in my life... Still gives me chills to think about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702507,
					"content": "See you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702508
					]
				},
				{
					"id": 710702508,
					"content": "See you, and take care!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
		{
			"id": 7107026,
			"completionStepIds": [
				7107011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107011",
							"2"
						],
						"stepId": 7107011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702601,
					"content": "Thanks for your help. Without your aid so far, I'm quite sure our expedition would have proved a failure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702602
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702602,
					"content": "I don't know what you did, but the readings of the Ley Line flows in this area have stabilized significantly... Heh, and the expansion of the contaminants is currently slowing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702603,
					"content": "As for why that is... Perhaps the answer may be found even deeper in the earth, but really, who knows?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702604,
					"content": "And as for Zhiqiong... Well, all I'll say is that she can still leave now. She values The Chasm over her life... not realizing that The Chasm seems set on taking it from her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7107027,
			"completionStepIds": [
				7107013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107013",
							"2"
						],
						"stepId": 7107013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702701,
					"content": "I'm very sorry... I know my stubbornness caused you a lot of trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702702
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702702,
					"content": "I'll continue to refine the maps I've made and help Jinwu place beacons to observe the behavior of that dark substance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702703,
					"content": "They... They say that this substance might be related to the dark calamity that occurred five hundred years ago. It's just unclear if it's an aftershock, or if it's just a sign of things still to come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702704,
					"content": "Whatever the case, thanks for showing me the limitations of a normal human being, and... for showing me how to pursue my dreams within those limits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702705,
					"content": "Huh. Look who's sounding like a philosopher now, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710702706,
					"content": "I never thought quite that deeply, I think.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "It's just that... you've helped me so much, and by comparison, I need your help just to do simple things like drawing maps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702708,
					"content": "And I always drag you down when we get into dangerous situations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702709,
					"content": "I'm just concerned for your safety.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "Yes... And I won't give up, either. I'll set out again once I've rested enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
