				{
					"id": 710640502,
					"content": "Tell me about the \"Flower of Farsight.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640501
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640501,
					"content": "It is said that the Flower of Farsight will only make itself known to those with such lofty desires that they might seem crazy to some, and thus is not something ordinary people can witness. Hmm, I wonder what sort of flower that would be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
