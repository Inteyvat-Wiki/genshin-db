					"nextDialogs": [
						710640402
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640402,
					"content": "That said, no one's found them all to this day, so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
