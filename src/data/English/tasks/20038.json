					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380302
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380302,
					"content": "Yep.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "Bless you, my dear! May Barbatos protect you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380304
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380304,
					"content": "Take these, they are my gift to you. I may call on your assistance again in future.",
