			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "*sigh* I wonder what state the Statues of The Seven must be in by now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380102,
					"content": "The Statues of The Seven? What's happened to them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Let me explain... In the past, I would go and pray to a Statue of The Seven every week, and while I was there I would wipe the dust off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380104,
					"content": "I have the archons to thank for all the blessings in my life — cleaning their statues was my way of giving something back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380105,
					"content": "But since having Lily, I rarely have the chance to go out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380106,
					"content": "The statues must be filthy with no one cleaning them in so long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380107,
					"content": "I know this must seem like I'm trying to avoid taking responsibility, but... Do you think you could go and wipe the dust off of the Statues of The Seven for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380109,
					"content": "Of course!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Thank you ever so much! May the Anemo Archon protect you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380115,
					"content": "One more thing. The Statues of The Seven are imbued with the power of the archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380116,
					"content": "The dust they collect cannot be simply wiped off in the usual manner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380117,
					"content": "But you have elemental abilities. It should be easy for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380118,
					"content": "Unlike me — it's a whole day's work for me to clean a single statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380110,
					"content": "Surely the wind would just blow it off?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Barbatos and the winds he commands have far too many other things to attend to day-to-day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380113,
					"content": "In any case, we mustn't rely on the archons to provide for everything while we laze around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380114,
					"content": "Let us work together to lighten our Lord Barbatos' load just a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				}
			]
		},
