			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jafar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230101001,
					"content": "That is very fresh meat indeed! Now, please wait here for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230101003
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230101002,
					"content": "Jafar has the ingredients ready and starts cooking...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230101003,
					"content": "These are the Shawarma Wraps made with the ingredients you brought. Please help yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230101004
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230101004,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230101005
					]
				},
				{
					"id": 230101005,
					"content": "My pleasure. Enjoy your meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230101006
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230101006,
					"content": "To me, eating means leaving all my exhausting work and research behind for a time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230101007
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230101007,
					"content": "I let my mind flow peacefully through that serene stream... this is how I relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230101008
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230101008,
					"content": "Well, enjoy your meal to the fullest. I hope that it can also put your mind at ease.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
		}
