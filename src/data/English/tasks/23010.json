				{
					"id": 230100301,
					"content": "That is an excellent sprig of Mint, indeed! Now, please wait here a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Jafar"
				},
				{
