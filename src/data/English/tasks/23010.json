					"Jafar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100801,
					"content": "You seem to be in a rush, my friend. What's bothering you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100802,
					"content": "Lots of things...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "Ah... Indeed, I can see that you are tired and pressed for time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100804,
					"content": "You must have something on your mind that needs to be resolved as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100809,
					"content": "Rather than rushing about, I'd like to invite you to have a delicious meal with me if you are willing to wait but a little while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100810,
					"content": "Haste is indeed a normal part of life, yes... but as we often put it, even a raging river must sometimes flow peacefully through a serene stream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100811,
					"content": "You must take a little break every now and then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100812,
					"content": "Hmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100813,
					"content": "How about we enjoy some Shawarma Wraps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100814,
					"content": "You don't have to pay me any Mora. Just help me find a piece of Raw Meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100815,
					"content": "It doesn't matter how you find the Raw Meat, by the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100816,
					"content": "Just remember that you are looking for a piece of Raw Meat. This is no troublesome matter, and you shouldn't see it as such.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100805,
					"content": "I'm alright, actually.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "Oh, that's good, that's good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100807,
					"content": "Still, your steps are hurried. You seek to fix some problem or another, perhaps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100808,
					"content": "Well, I don't know what problem it is that you seek to solve, but I have a suggestion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				}
			]
		},
