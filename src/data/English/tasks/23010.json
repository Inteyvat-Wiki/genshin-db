					"content": "Jafar has the ingredients ready and starts cooking...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "This is the Minty Bean Soup, made with the ingredients you brought. Please help yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Jafar"
				},
				{
