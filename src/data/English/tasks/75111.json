					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "Did you, now? Some idiot must have lost it along the way again. Let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
