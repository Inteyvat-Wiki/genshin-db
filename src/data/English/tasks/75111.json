				"points": []
			},
			"dialogs": [
				{
					"id": 751111401,
					"content": "Yeah, this one's mine. Someone from the Children of Echoes wanted to purchase paints, but couldn't tell me what colors he wanted to save his life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "That's why I sent him a package with several small bottles of paint in it — so he could get his preferences straight before he next shows up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "I'll get this resent — better that than him coming over here with his ridiculous reference requests...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Ah, right. This is for you. Thanks for getting this package back to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
		{
			"id": 7511115,
