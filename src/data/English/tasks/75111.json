				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110501,
					"content": "...This letter's from Tirda, if I'm not mistaken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Was she trying to get it sent to her tribe? But it's a mess now... We're going to have to return it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "I still need to sort out the packages in the store, so could you help get this back to Tirda in my stead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "She sings at the Golden Dusk. You'll find her in no time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
