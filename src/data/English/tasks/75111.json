						"stepId": 7511103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "This... looks like Chanca's handwriting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "If I had to guess, this must be another order invoice. The packaging here is broken — there's no way we can deliver it this way. This letter shall have to be returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "I still need to sort out the packages in the store, so could you help send this back to Chanca in my stead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "She's the owner of the Weary Inn near the Stadium of the Sacred Flame. You can't miss it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
