			},
			"dialogs": [
				{
					"id": 751111501,
					"content": "Huh? Yeah, this is my order. Didn't think it would meet with such bad luck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Oh well. I'll just have to write another later. This isn't super urgent, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
