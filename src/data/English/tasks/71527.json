			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "Yanfei's Onikabuto is so strong! What has Madame Ping been feeding that thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "See? Your savior's Onikabuto is a force to be reckoned with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716664103,
					"content": "But just like last time, when my generals threw you a few curveballs, the mightiest blade cannot slay its foe except in the hands of a skilled swordmaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716664104,
					"content": "W—W—Wise words, Grandmaster... Ooookay... Good thing my compadre kept it together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Wow, what a blast! I could get into this whole beetle-battling thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664106,
					"content": "This is so much fun! Thanks, everyone! I'm gonna stick around and play some more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Contestant with Super OP Gear"
				}
			]
		},
