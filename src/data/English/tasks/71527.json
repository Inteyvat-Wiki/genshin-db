					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Hey there! I'm back! So then, how's the Arataki Blazing Armor Beetle Battle Boot Camp coming along...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664002,
					"content": "Great timing, Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "My savior! Thanks for helping out with the permit! And for the sign with the epic artwork!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Wait, I know that look... Are you, uh, looking to flip some beetle too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Huh? Something wrong with that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664006,
					"content": "I have a big client who does a lot of cross-border commerce — anyway, she showered me with gifts once after I helped her win a huge lawsuit, and among them was a very special Onikabuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664007,
					"content": "I didn't know how to look after it at the time, so I got Granny to look after it for a while. It's looking pretty buff these days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664008,
					"content": "Mind if I join in? You're not worried I'll cramp your style, are you...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664009,
					"content": "We ought not dismiss your savior, Oni King. What she lacks in experience, she makes up for with one of the sturdiest-built and most awe-inspiring Onikabuto I have ever seen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716664010,
					"content": "You make me an offer I can't refuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "Alright, time to send in the Oni King's Right Hand with Crimson Staff. I know my compadre will stay cool under pressure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "You betcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#So it's me versus {NICKNAME}? Alright!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664015,
					"content": "I haven't quite got the hang of this game yet, so apologies in advance for any blunders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Contestant with Super OP Gear"
				},
				{
					"id": 716664013,
					"content": "Thanks for the vote of confidence!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
