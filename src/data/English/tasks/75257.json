			"dialogs": [
				{
					"id": 752570101,
					"content": "Everything here seems to be in working condition. Why isn't it open?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Ah, my apologies. Unfortunately, our set decorator got a little too tipsy last night and couldn't make it to work today. Would you mind dropping by tomorrow instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Oh dear, I'm too old to drag these aching bones all the way back here tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Not to mention, we've already got plans for tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "I'm so sorry. The whole idea of this Summer Photo Booth is to give each customer their own personalized photo background.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "But without our set decorator, we just can't make it happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Need a hand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Really? You two are willing to help? That would be amazing! It's not complicated at all — just set up the photo backgrounds based on our customers' requirements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525701",
							"2"
						],
						"stepId": 7525701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yiztli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "That sounds like fun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "Fantastic! Alright then, who wants to go first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570203,
					"content": "I have a suggestion — ladies first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570204,
					"content": "That's fine by me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570205,
					"content": "My my, such gentlemen! To tell the truth, I'd like to take a photo with such fine young people as yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570206,
					"content": "Huh? A—Alright, I suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570207,
					"content": "Ahem, that's fine by me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570208,
					"content": "Hmm... Wait, that's not enough. I'd like to add three more young men to the picture. You can manage that, can't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570209,
					"content": "Oh, and maybe some fireworks? I used to love that kind of thing when I was your age.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570210,
					"content": "You got it. Let's get started!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
