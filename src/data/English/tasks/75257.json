			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "Whew, that was the last one! You two really saved the day for me. If not for your help, I might've been inundated with complaints.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "Don't sweat it, hehe. We're the most helpful adventurers ever!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "Adventurers, huh? How about I take a photo of you two? Let's capture that helpful spirit of yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "C'mon, smile for the Kamera! An easy-breezy Natlan in an easy-breezy summer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Thank you both once again. And take these as thanks, please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
