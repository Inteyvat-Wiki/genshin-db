				]
			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "That last one turned out great! Next up is this strapping Fatuus. What kind of photo did you have in mind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Please make me look like a sharpshooter. Y'know, one glance and people will know I never miss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "That way, it won't matter so much when I rank near the bottom in company marksmanship contests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "You got it. Let's get started!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
