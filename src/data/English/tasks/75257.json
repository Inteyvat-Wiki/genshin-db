			"dialogs": [
				{
					"id": 752570801,
					"content": "That last one turned out great! Finally, we have this dashing young man. What kind of photo did you have in mind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Why, thank you for the compliment. My whole life, I've valued good bearing and grace above all else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Without good bearing, one lacks elegance — and without grace, one lacks refinement. I'm sure you understand my requirements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Hmm... Gimme a sec... Got it, let's get started!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
