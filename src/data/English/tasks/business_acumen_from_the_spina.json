				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890901,
					"content": "Well, this cycle of operations sure got us off to a good start. On to the next one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 4018910,
			"completionStepIds": [
