					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3734.254,
							442.806,
							3928.779
						],
						"pointId": 340200191
					},
					{
						"sceneId": 3,
						"position": [
							3735.056,
							442.806,
							3928.409
						],
						"pointId": 340200192
					},
					{
						"sceneId": 3,
						"position": [
							3735.223,
							442.806,
							3929.156
						],
						"pointId": 340200193
					}
				]
			},
			"dialogs": [
				{
					"id": 401891001,
					"content": "Well, the numbers might not look that impressive, but given that we're just getting the ball rolling, I'd say that wasn't a bad start!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Building on this momentum, we must consider rolling out more unique business strategies during the next cycle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "To draw in the crowds, I've invited one of Fontaine's very own celebrity chefs — my good friend Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "She'll be \"performing\" right here in the amusement park's restaurant. On that note, let's go catch up with her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "So is the restaurant part of our business strategy too? There are so many layers to this operation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4018911,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
