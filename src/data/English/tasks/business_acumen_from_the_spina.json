			"dialogs": [
				{
					"id": 401890801,
					"content": "Looks like this particular employee is really getting into their role...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Wishing them success on the job!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "Hahaha, you're both doing great. You sound more like bosses than I do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "In any case, with this, the Chevalmarin Film Fantasyland is now officially open!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Running a theme park is a long-term project. You won't make much if you try and rush it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "We're just about done with our current work setup, so let's take a short break and wait for this cycle's revenue report to come in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "I'll be monitoring their attendance closely!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
		{
			"id": 4018909,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
