							3937.976
						],
						"pointId": 340200196
					}
				]
			},
			"dialogs": [
				{
					"id": 401891101,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891102
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891102,
					"content": "The restaurant is up to standard, and the waterside location will make for a unique dining experience. The beautiful scenic reflections in the water create a stunning backdrop, lifting diners' spirits and allowing them to truly savor their meals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891103,
					"content": "Ingredients, check... Cooking utensils, check... Looks like we're ready to rumble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891104,
					"content": "Hey there, Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891105,
					"content": "Oh! My employers are here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891106,
					"content": "#The president of the Spina di Rosula, plus the famous {NICKNAME} and Paimon... I must say, you seem a bit overqualified to be running a film-themed amusement park.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891107,
					"content": "I'd say that if anyone here was overqualified, it would be the former head chef of the Hotel Debord... Wherever you walk, the aroma of fine cuisine follows in your wake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891108,
					"content": "Ahem... Let's get back to business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891109,
					"content": "#I'm guessing you want {NICKNAME} to help me decide the theme dish for each cycle. Right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891110,
					"content": "\"Theme dish\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "This is the business strategy I mentioned earlier — using Escoffier's top-tier dishes to attract more visitors to the park!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891112,
					"content": "But this isn't just about attracting visitors. Her culinary masterpieces will surely have other surprising effects!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891113,
					"content": "Just imagine, Paimon, if all you needed was a single ticket to enjoy all the attractions and taste all the legendary food... Wouldn't you be tempted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891114,
					"content": "Th—Th—Th... Then Paimon'd come every single day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891115,
					"content": "Do you do annual passes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "Now, here's the twist: To get the most out of this strategy, the menu can't be made public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891118,
					"content": "Based on research by a certain food branding consultant, many restaurants have started offering a special \"Chef's Surprise\" dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891119,
					"content": "So, give me some inspiration every few business cycles, and I'll decide on our next theme dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891120,
					"content": "Now then, give me your hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891121,
					"content": "My... hand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "Mm, a warm and energetic feel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891124,
					"content": "Your hands are callused from wielding your sword, but still quite delicate. When you grasp its hilt, it's like you're holding the bow of a violin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891125,
					"content": "A sword, then... The theme this time shall be \"strength.\"",
					"roleType": "TALK_ROLE_NPC",
