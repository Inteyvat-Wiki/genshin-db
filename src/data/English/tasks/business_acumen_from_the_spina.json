					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891126,
					"content": "Alright! Let's find out what \"strength\" looks like in gastronomical form...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891122,
					"content": "I had no idea inspiration could be physically transferred...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "I'd find a way to live here!",
					"roleType": "TALK_ROLE_PLAYER",
