			"dialogs": [
				{
					"id": 401891601,
					"content": "Whew... That should be everything. Looks like you've pretty much mastered how to run this park!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "Huh? Have we really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "Thinking about it... We have learned quite a lot, haven't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "Just goes to show how well Navia explained it all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Not at all. I wouldn't say I taught you much. Your intuition's been guiding the way, mostly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "I imagine \"long-term operations\" sounded like a scary prospect the first time I mentioned it, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "But don't let that scare you! Just break things down into smaller steps and tackle them one at a time. Even if you're not a genius or naturally gifted, you'll get it done in the end!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "Whoa, seeing her own progress has really got Paimon fired up! Actually, she's gonna jot your words of encouragement right down, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "From here on out, we'll be running the Chevalmarin Film Fantasyland together — let's make it a big success!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "Couldn't have done it without Navia's guidance!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
		}
