			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "Although the Masked Warrior can't fly about like the Peacemaker, all she has to do to win is time her charges right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Little Pinecone"
				},
				{
					"id": 755100102,
					"content": "You blithering idiot! You can't just think of how fast she can run in a straight line — if she can't turn or hit anything, it won't make any difference!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Flammabomb Wood Figure"
				},
				{
					"id": 755100103,
					"content": "That's enough, children. We can have a civilized discussion, can't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100104,
					"content": "We're being civilized...! It's just, well, when we talk about great warriors, we get pumped up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Flammabomb Wood Figure"
				},
				{
					"id": 755100105,
					"content": "Don'cha worry none, Miss Vigee! We might be at war, but we're gonna fight with reason and evidence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Little Pinecone"
				},
				{
					"id": 755100106,
					"content": "...Oho! I just thought of a new strategy. I challenge you again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Flammabomb Wood Figure"
				},
				{
					"id": 755100107,
					"content": "Rematch, rematch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Little Pinecone"
				},
				{
					"id": 755100108,
					"content": "...Sure is lively here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "A new customer! Hello there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100111,
					"content": "Judging by your attire, you're a traveler, aren't you? We've got that in common!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100112,
					"content": "Do you want to try out this interactive woven scroll I've created with the children?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100113,
					"content": "\"Interactive woven scroll\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "Simply put, it's a game that combines Liyue's paper theater, Inazuma's comics, and Fontaine's film technology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100116,
					"content": "It's inspired by our local heroes, and adds the concept of \"crossover challenges\" to create a novel story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100117,
					"content": "Give it a try! Who knows, it might be a new experience for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100118,
					"content": "With pleasure!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "Wonderful! Have a great time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100114,
					"content": "A scroll that moves on its own?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "What's going on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
