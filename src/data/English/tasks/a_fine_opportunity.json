				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "You've cleaned them out, I suppose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Yup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "You really are very strong. If only I could be as outstanding as you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "I, too, would like to leave behind dragon-slaying, world-saving legends, but in the end, I couldn't even beat a pack of hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Ugh... Anyway, I... This is embarrassing, but I have something to ask of you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "I actually came to the Thousand Winds Temple because I'm soon to take an Adventure Ranking test...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "I thought that the ranking would go much more smoothly if I could show my stuff at this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "I never thought that I'd not only have nothing to show for it, but almost lose my life in the process as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "C—Could I ask you not to tell Cyrus about this? I'd truly be in hot soup if this were to affect my ranking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Your secret's safe with me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Thank you so much! I promise I won't be so reckless in future!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "This isn't right...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "I know it isn't, and Cyrus always says that adventurers should be honest with themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "But... *sigh* Forget it. I just hope he wont be too mad at me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
