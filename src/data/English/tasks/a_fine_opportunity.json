			"dialogs": [
				{
					"id": 206010801,
					"content": "You're back, and so is Jack, I see, though he's limping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010802
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010802,
					"content": "What happened out there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010803,
						206010807
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010803,
					"content": "Jack fought bravely.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010804
					]
				},
				{
					"id": 206010804,
					"content": "Oh, you fought alongside him? So that's how he was injured.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010805
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010805,
					"content": "*sigh* Bravery is good... but I'd rather that he were more steady. One can only be an adventurer if one stays alive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010806
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010806,
					"content": "Your bravery was commendable as well, traveler. Take this as your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010807,
					"content": "Jack rushed in, and got hurt as a result...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010808
					]
				},
				{
					"id": 206010808,
					"content": "So it's as I thought. *sigh* He hasn't been listening to what I always tell him, has he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010809
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010809,
					"content": "I understand that he wants to prove himself, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010810
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010810,
					"content": "Forget it. I understand what happened. I'll talk to Jack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010811
					],
					"speakerTitle": "Cyrus"
				},
				{
