				"points": []
			},
			"dialogs": [
				{
					"id": 206010701,
					"content": "You're back, and Jack too. But he's limping...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010702,
					"content": "What happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010703,
					"content": "Jack rushed in, and got hurt as a result...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "So it's as I thought. *sigh* He hasn't been listening to what I always tell him, has he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010705,
					"content": "I understand that he wants to prove himself, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010706,
					"content": "Forget it. I understand what happened. I'll talk to Jack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010707,
					"content": "This is for you, consider it payment for your adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
