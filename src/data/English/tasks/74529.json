				"points": []
			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#Oh, good. You're here, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Long time no see, Citlali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Oh, please, I go out for walks once in a while, thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "And in any case, my divinations last night predicted that good things would come to me if I went out today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "If this doesn't count as fulfillment of said fortune, I don't know what does.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Then let us add one to the tally of positives.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Well, it's not that you can't... It's just... I stayed up all night two days ago to finish the latest light novel volume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "So... Look me over real quick. Do I look okay? The dark circles around my eyes should be gone now, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "You're right as rain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Really? No tricks now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Just so we're clear, I'm keeping all the ones that don't pass muster. You only get the best of the lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "You're as radiant as ever!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Let me take a picture of you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "What a surprise — you're not sleeping in today.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
}