					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080608,
					"content": "But, me and Lupical will hunt them down... no matter what.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080609,
					"content": "...Don't forget about us, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Yeah, if you ever need help, just say the word! We're here for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080611,
					"content": "I... appreciate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080612,
					"content": "Awoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Distant Howl"
				},
				{
					"id": 100080613,
