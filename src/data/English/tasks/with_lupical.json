					"content": "Right... We are Lupical forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080606,
					"content": "Aww.. and now, there won't be any more intruders in Wolvendom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080607,
					"content": "No... Dark wolf pack, rip open sky. They... could come again.",
