				{
					"id": 721540601,
					"content": "Ready when you are.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540602
					]
				},
				{
					"id": 721540602,
					"content": "Wonderful, bravo! In that case, let's begin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540603
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540603,
					"content": "I shall make a few adjustments to the Film Kamera and call the soldiers back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
