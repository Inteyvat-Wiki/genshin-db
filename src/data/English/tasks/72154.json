			"dialogs": [
				{
					"id": 721540701,
					"content": "I'm not quite ready yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540702
					]
				},
				{
					"id": 721540702,
					"content": "Well, don't worry. Take your time — just let me know when you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
