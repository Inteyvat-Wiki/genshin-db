	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Wait! Ah, Sir Soldier, the line you just read lacks the right emotional gravitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "\"Samurai, like the wind sweeping the earth.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "Do you still remember what I said about the play? It is supposed to feel liberating and give the audience a sense of the vicissitudes of life. I said liberating! Liberating, you understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "This line is key to the whole play. You must express your emotions completely, fully, and perfectly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "Moreover, don't swing your sword in such haste... Make sure you are in view, otherwise, the Film Kamera will not be able to capture your movements at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Pose, and then pause, okay? Stop for a moment, then slice downwards with great force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "But you can't swing your sword like that when you fight against people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "True, but you have to tailor your acting to the production's needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Well then. Please ready up, and we shall give this another go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#Oh, it's you! Ah, my dear {F#girl}{M#boy}, a fair wind must have blown you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "As you can see, I'm shooting a swashbuckler film with our good soldier here. I call it \"The Seventh Samurai.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "Oh, \"swashbuckler film\" is what I'm calling films of this genre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "This sort of film shall have sword-fighting scenes, and it shall take the viewers on an incredible journey across the battlefield... Well, that's the idea, at least!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "To think that Mr. Toranosuke would have time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "This activity has been approved by our superiors. According to them, it will help to increase the Shogunate's prestige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "That said, I haven't a clue how Mr. Xavier managed to convince them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "Honestly, Mr. Mikoshi Genjirou is such a... serious man. Fortunately, he is also most understanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "After I had a sincere talk with him, he accepted my request quite happily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "But... In exchange, I have to make a movie that has to do with the Shogunate, preferably with a samurai as the protagonist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "But I was always interested in this sort of subject matter anyway, so of course, I agreed to it, and Lord Mikoshi Genjirou was also very pleased.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "In addition to personally appointing our good soldier to go with me, he also assigned some skilled troops to me, and then he said...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "\"Use these scenes of steel clashing against steel to display the majesty of the samurai and the Shogunate.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "I have to say that Mr. Genjirou really is a man of vision, to have grasped the potential of using films as a marketing tool so very quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "And as for me, I will never refuse anything that will help me make my films.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "Is production going well?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "To be honest, it's not going that well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "While these soldiers are highly skilled in martial arts, they are not used to this kind of staged fighting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Not only are their sword movements too fast for the Film Kamera to record, they sometimes even run outside of its view.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "Traveler, if you have the time, do you mind following my script and acting the story out for the soldiers to see?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "I believe that with your strength and understanding, you will be able to perform brilliantly in front of the Kamera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "They should be able to better understand the story after watching it from the spectator's point of view.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Come, come! Just read the script and the lines first. This part is mainly about fighting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "\"The battle is lost.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Ah, these are lines from another scene... This one is mainly about fighting, so there aren't that many lines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "Alright, let me take a look at the script.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "Oh, by the way, you'll be playing the role of \"Juusaburou.\" Together with several companions, he is employed by the villagers to protect their village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "In this scene, one of your companions, \"Kyuuzou,\" has lines... I'll play his part, and the two of us will do a reading.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Now, you must embody the role, understand it! Just think of yourself as Juusaburou. Do you understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "I understand, Director.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "Wonderful! Splendid! Bravo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "Let me know when you are ready. I have to adjust the Film Kamera's position...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "I. Am. Juusaburou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "\"But even when imperiled, the samurai is still samurai.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "\"You are all certified scarecrows...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "\"...But our enemies are not sparrows.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "Mind if I play a part?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#Of course! Of course! You are, after all, forever a {F#heroine}{M#hero} in my heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "I'll always remember that \"Tatara Tales\" that we acted in together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Although these soldiers are highly skilled in martial arts, they are not used to this kind of staged fighting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Not only are their sword movements too fast for the Film Kamera to record, they sometimes even run outside of its view.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "How did you persuade him to help you out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Come now, our dear soldier understood me just fine. My main job, really, was to persuade Mr. Mikoshi Genjirou to allow me to make a film in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "\"Samurai, like the wind sweeping the earth.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "You said those words with too much passion. It should be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215404",
							"2"
						],
						"stepId": 7215404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "Oh dear me, this film doesn't seem to have come out right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540202,
					"content": "Please get ready again, and we shall give it another go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215403",
							"2"
						],
						"stepId": 7215403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "#Perfect! As expected of the {F#heroine}{M#hero} of my heart! A perfect demonstration! You truly are a star!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "A... what now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "A star! That is to say, the most important actor in a film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "Now then, Mr. Soldier. You saw that demonstration clearly, I trust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "On the whole, yes. When swinging my blade, I should focus not so much on the \"action,\" itself, but on the \"posture,\" yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "If you only require the \"posture\"... I have some ideas about that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "Oh? That's wonderful! Please discuss the matter with your fellow soldiers, and we'll do another take in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "You have my utmost gratitude for your help, Traveler. Here. These are for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "What's the theme of your next film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "The next film, hmm? Well... Actually, I'm quite torn on what its topic should be myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "Should we do one about the various traditions of the Grand Narukami Shrine? Or the tales of the kitsune and the tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "There are so many islands here in Inazuma, and so many stories to be told!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "But regardless, I have to finish producing \"The Seventh Samurai\" first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "If this satisfies those fellows upstairs, I do suspect that future film projects shall progress much more smoothly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "Maybe I'd like to change roles next time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "No problem at all! Once this film has been completed, we should start planning a whole new one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
