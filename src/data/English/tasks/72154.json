				"objectNames": [
					"Toranosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540401,
					"content": "A \"swashbuckler film,\" huh. Mr. Xavier sure does have interesting taste in names.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "What do you think of these films?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Our superiors believe that these films will help to increase the Shogunate's prestige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Perhaps I am simply a little slow on the uptake... but I do not see how this is the case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "This script is full of these... pessimistic lines. There is nothing of samurai dignity here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "Who knows what they were thinking, that they agreed to all this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "How's the situation at the Mikage Furnace?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Ever since Sir Hanbei's \"promotion,\" Yousuke has taken over as the person in charge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "He is a craftsman by birth and trade, and is very down-to-earth and steady. He gets things done, as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "With the Mikage Furnace under his management, I doubt there will be any further problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
