			"dialogs": [
				{
					"id": 745250401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250402,
					"content": "That's a serious face you're wearing there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "Ah, it's you. No, today's investigations are complete. Nothing unusual was found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250405,
					"content": "I was just thinking about why those passing Eremites seemed so... listless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250406,
					"content": "A tiring journey, perhaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "My guess is that they may be in a \"mite\" of financial trouble. That sort of thing tends to the \"might\" out of \"Eremight.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250409,
					"content": "How about something a \"might\" more cheerful?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Ah, I see. Still, if I were to just stand there, the resulting image might lack impact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250412,
					"content": "Don't worry, I'll use Electro. That should light-nings up a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250413,
					"content": "...Sounds like a plan. I'll make sure to catch you in action.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "Alright. It's in your hands. Don't miss out on the critical moment, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250410,
					"content": "Could I take a picture of you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Did they fail in their mission?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Are you on the hunt for a criminal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
