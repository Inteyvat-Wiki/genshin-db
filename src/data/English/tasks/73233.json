			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "These are the ones. Thank you so much, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "Sure you're not trying to open your own flower shop?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Uh, well, I... I just wanted to buy more at once to save myself some extra trips, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "Anyway, go rest over there for a while. I need to sow these seeds and put some fertilizer in and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef starts working on the flower pot...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "Alright, this should do it! All Nermin needs to do is water this plant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "Traveler, could I, ah, trouble you to help me bring this flower pot to her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "Why don't you go yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "I need to guard this path. If any foodstuffs or goods pass through, I'll need to get more people from the village to come take them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "And you know how it is around here. If we're too slow, the goods are going to spoil under the sun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "Just do me this favor, please. Nermin's not far from here. All you have to do is give this pot of flowers to her. I'll find a way to bring the rest to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "What do you need so much stuff for!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
