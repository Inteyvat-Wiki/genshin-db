						"stepId": 7323305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "Someone inside hears movement...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Hello. May I help you with anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330503,
					"content": "Well, I'm here to give you this flower pot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "Huh... Is this from Raef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330505,
					"content": "There are flowers in this pot? Really? Thank you for helping him send this to me. I like it very much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330506,
					"content": "But... Can I really raise these flowers properly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330507,
					"content": "Is it your first time growing flowers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Well, no. I'm just... not very good at taking care of plants. The previous ones all withered in my hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330509,
					"content": "I imagine that this pot of flowers must be even more delicate still. If I were to fail to care for it properly again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330510,
					"content": "Ugh, no, no, I can't just... Since the flowers are already in my hands, I must take good care of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330511,
					"content": "Perhaps Granny Kulsoom knows how to solve this problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 7323306,
