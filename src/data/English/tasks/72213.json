		{
			"id": 7221305,
			"completionStepIds": [
				7221305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221305",
							"2"
						],
						"stepId": 7221305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Wonderful! These will do, I think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "I'll go find a suitable place outside to set a furnace up, and then I'll start making my tools.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Just let the Lady Priestess know, would you? I'll be packing up over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
							"2"
						],
						"stepId": 7221304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Meow meow meow. Is something the matter? Not to worry, I will prepare an adequate \"celery.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "It's \"salary.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Uh, never mind. Basically, the stone human... Mr. Ooshima's tools are broken, but we gave him the materials he needs to repair 'em, so there shouldn't be any problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Mm? Problems, you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "That is good. I look forward to seeing that stone, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Hibiki said that once the stone in my likeness was made, some good thing might happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "Ah, I am filled with expectation! What sort of good thing might happen? Perhaps Hibiki may even return...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "No, there aren't any issues. Things are going well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "How much is it going to be?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
					]
				},
				{
					"id": 722130604,
					"content": "Mm? What does \"how much\" mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130605
					],
					"speakerTitle": "Neko"
				}
			]
		}
	]
}