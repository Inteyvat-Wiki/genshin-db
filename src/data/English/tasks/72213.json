			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "*sigh* How am I supposed to work without a hammer or chisel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130302,
					"content": "Encountering some trouble?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "Oh, it's you. Well... I was careless. I didn't check my tools properly when we came here, so just as I was getting engrossed in my work, I broke my hammer and chisel by mistake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130304,
					"content": "I'd like to return to Narukami Island to buy some more, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130305,
					"content": "How do I put this... I guess I'm just more used to finishing work like this in one go, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130306,
					"content": "My tools might be broken, but I can still do some measurements and figure out how I want to continue carving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130307,
					"content": "If I left now and went to Narukami Island to get some tools, I'd probably have to re-acquaint myself with the \"feel\" of this carving...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130308,
					"content": "Also, this stone's composition is very hard. If we were to use ordinary tools, they would break pretty quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130309,
					"content": "Hmm, you know what...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130310,
					"content": "Traveler, could you help me find 3 Iron Chunks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130311,
					"content": "I plan on making some tools personally, ones suited to the task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130312,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "Great! It's up to you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130314,
					"content": "You're going to forge them yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "Come on, I'm someone who worked at Tatarasuna. Of course I know a thing or three about forging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130316,
					"content": "However, I probably shouldn't start any sort of furnace at the shrine. I imagine that the Lady Priestess would be displeased. It is a cat, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130317,
					"content": "Either way, please help me find 3 Iron Chunks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
