			"dialogs": [
				{
					"id": 751750101,
					"content": "As you immerse yourself in the liquid Phlogiston, images flash through your mind like warm memories.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Beside the flaming pool, the silver-white and ash-covered shadows converse as such...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "\"...Phase Two experimental verification is complete. I name the thing that shall purify all and evolve all 'Huitzilopochtli,' or the 'Sweeping Skyfire'...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "\"Not that this matters. Names shall lose meaning in this place very soon, after all.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "\"The Astral Assemblages must be activated and actively attached to serve as countermeasures against corruption. Before they are completely warped by the Abyss, they will self-destruct and eliminate its influence...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750106,
					"content": "But how will you accurately identify targets as having been corrupted? A controllable specimen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750107,
					"content": "Self-experimentation? Has sanity deserted you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750108,
					"content": "\"Hah. This too, is well. If nothing else, this decrepit body may still serve in this manner.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "So, you shall be the least likely to survive once this system is activated, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750110,
					"content": "Has the Abyss at last rotted your mind? Or... do you simply wish for all your kin to be martyred upon your funeral pyre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750111,
					"content": "\"Such little faith you have in your people! All the lords have consented to this, save you.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "They merely follow your plan as though blind, never once considering the true meaning behind the scheme... This action does not have my consent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750113,
					"content": "\"...That matters little. Destruction... shall also be rebirth. I have made my mind up as such.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "\"Hah... I fear this is as much time as I can spend awake each day. In any case, I shall activate it once all is prepared.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "Is there no room for a different course? I am still searching for another way... Are you certain that you are not bathing the world in flame over some personal grudge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750116,
					"content": "\"Perhaps! I will do anything it takes to keep our shadow-foe beyond the circles of this world.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "\"Hah. Besides, 'another way,' you say... Will you really find what you seek from those 'humans' of yours? You are in too deep already. I see it...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "\"I once tried to make you understand... But just as it was with those of our line who sought wisdom through the pools of flame, knowledge and acceptance are two different things.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Immerse"
				},
				{
					"id": 751750120,
					"content": "\"If you believe that I simply wish for 'destruction,' whereas you have a world you wish to construct... Then stop me. Slay me. Prove yourself to me!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "\"But know this, Kukulkan, though it be not prophecy — simply advice from one who once walked this path. A day shall come...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "\"...When you shall tread the same road as I.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}