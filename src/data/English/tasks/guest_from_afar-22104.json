					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221040101,
					"content": "This is getting so stressful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "Oh, my apologies! When did you get here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040104,
					"content": "The monster presence in this area is steadily growing, and although my husband insists they wouldn't dare set foot in the inn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040105,
					"content": "He's the only one sufficiently prepared to fight back if they ever did. That concerns me a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040106,
					"content": "If you can spare the time, could you secure the surrounding area for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "You have my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040113,
					"content": "I am grateful for your help. You will be adequately compensated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040108,
					"content": "What is it about this inn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "Huh? There's nothing out-of-the-ordinary about the inn. It's just a little out of the way and sees a lot of traffic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040111,
					"content": "But it's worthwhile. Travelers braving the wilderness need somewhere to get a good night's sleep and eat a proper meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040112,
					"content": "That's what my husband and I think, anyway. It's the simple truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
