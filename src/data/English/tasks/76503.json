			"dialogs": [
				{
					"id": 765030701,
					"content": "#Why, if it isn't {NICKNAME} and Paimon? Hot on the trail of some lead, perhaps? Or might you happen to be lost?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030702,
						765030703
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030702,
					"content": "We're just looking around.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030704
					]
				},
				{
					"id": 765030704,
					"content": "I see. May this silent colossus provide you with the inspiration you seek, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030705
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030705,
					"content": "That said, I do not see your Kamera on you. Might you have misplaced it somewhere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030703,
