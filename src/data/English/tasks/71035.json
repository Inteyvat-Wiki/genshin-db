					"Chef Mao",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350101,
					"content": "What would you two like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350102,
					"content": "Three servings of Grilled Tiger Fish to go, please.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "You got it! Hang on for a moment, they'll be ready soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350104,
					"content": "Three servings? One for you, one for Paimon... Who's the last one for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "I was thinking we could go see Pervases.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "You mean gave-us-the-Seven-Star-Lamps-and-Censer Pervases?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Huh, that's right. He did say that he missed the taste of Grilled Tiger Fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "But isn't he gone now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Even so, we can still pay our respects.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Yeah, that makes sense. Let's go see him, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "The last time that we met Pervases there, the temple was in a pretty sad state, and there were Treasure Hoarders in the area, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Let's hope that his statue hasn't been defaced...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Your three servings of Grilled Tiger Fish. Hold on to them, now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350115,
					"content": "#Ooh, these smell so nice! C'mon, {NICKNAME}. Off to our next stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Pervases loves Grilled Tiger Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
