			"dialogs": [
				{
					"id": 710350901,
					"content": "*sigh* This place really is in a terrible state. The pillars are rotten, the planks are broken. At least the statue's still fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350902
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350902,
					"content": "Why hasn't anyone come to fix this place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		}
	]
