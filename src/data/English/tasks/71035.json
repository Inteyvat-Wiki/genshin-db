			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon",
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350301,
					"content": "Thank you, O mighty adeptus, thank you, mighty hero! ...Oh, what are the odds? We meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350302,
					"content": "You know us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350303,
					"content": "How could I forget you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350304,
					"content": "You're...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "I'm Wang Ping'an! Don't you remember me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350306,
					"content": "Ah, \"Starsnatcher\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "Huh!? What? What \"Starsnatcher\"? ...Please, l—let's not bring that up, not in front of the adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350310,
					"content": "I was just getting ready to make an offering at the temple of the Yaksha, Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350311,
					"content": "But not long after I entered the mountains, I was set upon by those Treasure Hoarders... Thank you for saving me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350312,
					"content": "Wait a moment. What were you going to do at Pervases' temple?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350313,
					"content": "Were you planning to do something bad to his statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350314,
					"content": "No, no! I wouldn't dream of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350315,
					"content": "Then what were you planning to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "I... I wanted to restore the temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350317,
					"content": "My plan today was to closely examine the temple's current condition and arrange for the purchase of the appropriate materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350318,
					"content": "I never expected to be targeted halfway by Treasure Hoarders and forced to flee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350319,
					"content": "But as I ran, I... lost my way. As for the rest, you know what happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350320,
					"content": "Let's speak further at the temple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "Right, this is hardly the place for conversation. Let's go to the temple first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350322,
					"content": "We'll speak there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350323,
					"content": "Go. I have other things to handle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350324,
					"content": "Eh? You're leaving already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350325,
					"content": "...And he's gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350308,
					"content": "Yeah, I remember you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "Ah, good, good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
