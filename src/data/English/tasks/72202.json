				"points": []
			},
			"dialogs": [
				{
					"id": 722020101,
					"content": "Has the Great Thunderbird... forsaken me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020102,
					"content": "Err, hello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "O mighty Thunderbird, please... Do not be angry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020105,
					"content": "I will do my best to read your decrees and your instructions... But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020106,
					"content": "But why do you reject me... Why... *sobs*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020107,
					"content": "Why can't I enter the fog you created...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020108,
					"content": "Read... What are you talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "The Stormstones you left behind... I will do something about them. But the silver boat is coming. My time is short...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020110,
					"content": "What are these Stormstones you're talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "The Stormstones of the Autake Plains... Only those who can wield the thunder can bring them back to life, and only those who can traverse the fog can find them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020112,
					"content": "To stand tall like the Thunderbird... to unfurl one's wings like the Thunderbird...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020113,
					"content": "Wait a moment. Hasn't the fog dispersed?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "Need any help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
