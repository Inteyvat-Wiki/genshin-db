					"nextDialogs": [
						718140303
					]
				},
				{
					"id": 718140303,
					"content": "Hmm... I suppose you can just keep that Mora. It isn't much, so I suppose you can keep it as compensation for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140304
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140304,
					"content": "This box, on the other hand, is unknown to me. You might want to pass it on to Baiwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140305
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140305,
					"content": "She's currently attending to some business at Yuehai Pavilion. Perhaps she might know what it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kun"
