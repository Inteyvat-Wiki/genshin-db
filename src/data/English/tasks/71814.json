					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140402,
					"content": "I picked this up from the sea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Hmm? Allow me to have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Yes, this does indeed come from the Jade Chamber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140405,
					"content": "Anything specific you could tell me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "Well, the contents consist of several documents and an announcement that has yet to undergo review. To think that they are still so well-preserved... How unexpected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140407,
					"content": "Still, your find should save us some work. Cleaning up after this mess really has proved an unending font of busywork.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140408,
					"content": "Still, thank you for bringing these to us. Do take this as a token of our appreciation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
