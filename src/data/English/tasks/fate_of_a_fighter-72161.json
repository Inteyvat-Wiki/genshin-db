					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610701,
					"content": "...And it seems that the rats nearby have begun scurrying about again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610702
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610702,
					"content": "Watch out for pirates if you wander around these parts, outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610703
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610703,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610704
					]
				},
				{
					"id": 721610704,
					"content": "You're welcome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610705,
					"content": "They shall be no match for me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "Haha, again with the big talk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "Only say that once you've finally gotten rid of them all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610708,
					"content": "You have a deal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "Yes, that we do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				}
			]
		},
