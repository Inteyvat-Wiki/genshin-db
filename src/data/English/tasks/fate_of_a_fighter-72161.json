	"talks": [
		{
			"id": 7216101,
			"completionStepIds": [
				7216102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216102",
							"2"
						],
						"stepId": 7216102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Hmph, how humiliating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610102,
					"content": "Hey! We saved your life! What do you mean we're \"humiliating\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "He's talking about himself, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "To think that I had to be rescued by outlanders, and was even reduced to being judged by them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610106,
					"content": "Oh... So, Mr. Samurai, are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610108,
					"content": "Well, he seems alright, at least.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "I am in your debt, outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610111,
					"content": "Also, you fought commendably.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610112,
					"content": "#I'm {NICKNAME}. Pleased to meet you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "Don't look down your nose at me, outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610114,
					"content": "...Inaba Tousaburou Kyuuzou. Just call me Kyuuzou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610115,
					"content": "So, who were those people?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "They're pirates. They have many strongholds around Nazuchi Beach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610118,
					"content": "Thugs, out-of-work miners and fishermen, fugitives running from the Vision Hunt Decree, deserters from both sides of the war... Sometimes, they gather into groups and degenerate into bandits and pirates. They try, in vain, to escape the control of Her Excellency.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610119,
					"content": "Whether you call them Vagrants or Kairagi, they are all lawless thugs... We had been suppressing them for a while until the rebels destroyed the ward on the island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610120,
					"content": "The refugees from Tatarasuna and the mine fled in quick succession, and some of those rats scurried off to this place, swelling the ranks of these pirate gangs and making them more reckless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610121,
					"content": "That group of pirates just now came from the camp in the south, and they had their eyes on the cargo onboard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610122,
					"content": "Unfortunately for them, I ruined their plans... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610123,
					"content": "So this isn't your ship, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "This thing? It belonged to the Sangonomiya rebels. I am not so sure myself... Either way, when I came, it was already deserted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610125,
					"content": "So I've stayed and lived in it like a hermit crab till now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610126,
					"content": "Hah, it's been a long time since I spoke so much. How exhausting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610127,
					"content": "If you do not mind, I will need your help with something. Once my wound has healed, I will surely return the favor I owe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610128,
					"content": "I need you to help me clear out the nearby pirate camp that I mentioned earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610129,
					"content": "That's the only way to stop them from coming back here and bothering me like a pack of stray dogs. It might even send the other pirate camps a message, so they don't get any ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610130,
					"content": "It'll also let me see what you can do. How about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610131,
					"content": "Piece of cake.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Hmph. It seems you are fond of talking big...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610134,
					"content": "By the way, outlander...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610135,
					"content": "Don't get too conceited. Miss a step, and you might break your leg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610132,
					"content": "Be right back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Why were you attacked?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Well, his pride is certainly hurt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "This is something unique to samurai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
		{
			"id": 7216102,
