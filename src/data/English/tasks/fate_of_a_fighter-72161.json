					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "It will take a long time to mash the herbs into a paste. You can go now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610506,
					"content": "No, don't get me wrong. I'm not driving you away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610507,
					"content": "Come back after a while. It's good to have someone to chat with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610508,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "Take care, outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610509,
					"content": "Take care of your wounds.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				}
			]
		},
		{
			"id": 7216106,
			"completionStepIds": [
				7216107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
