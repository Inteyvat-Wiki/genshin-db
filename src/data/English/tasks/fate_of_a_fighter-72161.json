						721611403
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611403,
					"content": "Just don't mess around with my things. There are just enough supplies on the ship for you. Leave as soon as you are satisfied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611404,
					"content": "Would you like some help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "No. Can't you see that I'm doing just fine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611406,
					"content": "But your wound...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "It's my wound, not yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611408,
					"content": "Hey, we asked out of kindness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Then I also answer you out of kindness: don't bother me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611410,
					"content": "I can help you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "How can you help me, hand me over to the shogunate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611412,
					"content": "Haha, I'd advise you against such misguided mercy... I will be treated as a deserter, and Lord Kujou has never shown mercy to deserters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611413,
					"content": "If you really want to help me, then give me some peace and quiet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611414,
					"content": "Wow, this guy is so grumpy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
