					"nextDialogs": [
						411410103
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411410103,
					"content": "Make sure you <color=#00E1FFFF>avoid monsters at all costs. If you get any weird elements on your person or take a hard knock, that food's toast</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410104
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411410104,
					"content": "Needless to say, if the food's ruined, the customer isn't taking it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410105
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411410105,
					"content": "Alright, then, run along. Don't keep the customer waiting, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				}
			]
