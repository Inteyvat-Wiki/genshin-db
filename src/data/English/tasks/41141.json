				{
					"id": 411410101,
					"content": "Well, I'm heading off.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411410102
					]
				},
				{
					"id": 411410102,
					"content": "Aye, best be about it.",
