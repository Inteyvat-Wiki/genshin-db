			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Hora doesn't seem to find it relaxing at all, and just stares back at you in confusion.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal takes over before things deteriorate any further. After another stint of careful grooming, he finally manages to finish trimming Hora's claws...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "It's okay, I misread Hora sometimes too. The important thing is, I'm sure he knows that you're a good friend of his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "Wroo, rrooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Hahaha! See, what did I tell you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Thanks so much for your help. Please, take these for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "Little Saurians really are hard nuts to crack. It took me a long time getting to know Hora before I could figure out most of what he was thinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "I'm just glad I managed to get that far. After all, the two of us will have to put up with one another for a while yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Huh? Where's Hora? Don't tell me he's run off again...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
					"content": "Hora! Horaaaaaaaa—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
