			"dialogs": [
				{
					"id": 730210701,
					"content": "(A huge leaf. Someone has written on it with messy handwriting...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210702
					],
					"speakerTitle": "Leaf With Careless Penmanship"
				},
				{
					"id": 730210702,
					"content": "\"...The 17th time frost covered the leaves. After some tests, I noticed that water from tributaries is filled with sand and mud. It has an earthen taste. Not acceptable.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210703
