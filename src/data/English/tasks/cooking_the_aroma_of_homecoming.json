			"dialogs": [
				{
					"id": 730210301,
					"content": "My soup... *sob* How could this happen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210302,
					"content": "(Leave quietly...)",
					"roleType": "TALK_ROLE_PLAYER",
