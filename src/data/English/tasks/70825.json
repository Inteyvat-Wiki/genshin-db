			"dialogs": [
				{
					"id": 708250601,
					"content": "How's your progress? Finished clearing the area yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250602,
					"content": "All done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Fantastic. You've been an enormous help, who knows how much longer those ugly things would've been stood there otherwise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250604,
					"content": "Honorary Knight, please accept these as an expression of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		}
