				"points": []
			},
			"dialogs": [
				{
					"id": 708250401,
					"content": "*sigh* If we just had a couple more people on hand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250402,
					"content": "What are the other knights doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Maintaining the city's defenses, helping with the rebuilding effort, and a whole host of other odd jobs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250404,
					"content": "Every last knight we have is up to their eyeballs in work right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250405,
					"content": "For once, guard duty at the main gate is the relatively easy job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250406,
					"content": "You could solicit help from the Adventurers' Guild.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "In fact, we're lucky to have had their assistance from the outset. At first, they were helping find and rescue victims in the city, more recently they've been keeping watch on monster activity further afield.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250408,
					"content": "When the monsters began gathering near to the city, it was thanks to the adventurers who carried out early reconnaissance and reported back to us that we were able to make specific and effective plans for the defense effort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250409,
					"content": "Even now, they are hard at work supporting all our efforts to get the city back on its feet. Honestly, without them, the Knights would be starting to crumble under the load.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250410,
					"content": "I must make time to thank Cyrus properly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 7082506,
