			"dialogs": [
				{
					"id": 761680101,
					"content": "Ugh... Nothing fuels me for patrol like a warm, delicious loaf of bread...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "I'm getting supplies needed for patrol, but it looks like we're out of stock on my favorite, the Mushroom Phantasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "It's a new bread Ms. Beryna came up with. Everyone loves it so much that there's never any left in stock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "*sigh* Just thinking about not getting any Mushroom Phantasm drains all my motivation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "I think I know how to make them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "Really? That's awesome, my friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "If that's the case, could you make some Mushroom Phantasm for me? Don't worry, I won't let you work for nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lantainen"
				}
