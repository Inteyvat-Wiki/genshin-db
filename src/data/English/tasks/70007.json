					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "You seem upset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "My apologies... That's because the library's been so loud recently that I can't study Hilichurlian in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "Ever since the Windblume Festival started, there's been a great number of people hanging out here. Initially, they were keeping quiet and reading books, but then they started... chatting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "There's more... They did a lot of terrifying things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "Turning book corners... Sticking strange objects between the pages... They even went as far as to put books back on the shelves upside down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "A library is not a place for romantic rendezvous! Unless one aims to disrupt all scholars actually studying inside as intended, that is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "Wyratt should be maintaining order in here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "What can he do? Throwing people out won't solve the root cause of the problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "That's why I need to ask for your assistance. Please tell them to get a hold of themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "I've got this covered.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "Thank you. Those three couples over there are making the most noise. If you can make them aware of how bothersome their babbling is, I'll be able to continue my research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "But be careful. They're quite difficult to handle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "I'll see what I can do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "You can bring it up with Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "But I've heard that she's currently out on patrol with the Acting Grand Master. If she were here, those couples would surely be on their best behavior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "You sound fiercer than usual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
			"id": 7000702,
			"completionStepIds": [
				7000702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000702",
							"2"
						],
						"stepId": 7000702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Young Man in Love",
					"Young Woman in Love"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "Such a thrilling story! It's a shame they didn't get to have their happy ending.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Young Man in Love"
				},
				{
					"id": 700070202,
					"content": "We definitely won't become like them, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Young Woman in Love"
				},
				{
					"id": 700070203,
					"content": "That goes without saying. Even if we were torn apart and placed in different corners of the world, I'd find a way to bring you back to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Young Man in Love"
				},
				{
					"id": 700070204,
					"content": "You should keep quiet in the library.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "Huh? I've been keeping my voice low all this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Young Woman in Love"
				},
				{
					"id": 700070207,
					"content": "*sigh* It's like in that book — an obstacle in the way of our love...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Young Man in Love"
				},
				{
					"id": 700070208,
					"content": "You should also put the books you've finished reading back where they belong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Look at all those books lying around in complete disarray. Somebody will have to put them back on the right shelves, and they're not gonna be happy about this mess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "Yeah, yeah, we got it. Could you leave us alone? You've interrupted us at a crucial moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Young Man in Love"
				},
				{
					"id": 700070211,
					"content": "Crucial moment...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "No matter what hardships befall us, do you promise to stay the same as you are now and never change?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Young Woman in Love"
				},
				{
					"id": 700070213,
					"content": "I do. I swear on my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Young Man in Love"
				},
				{
					"id": 700070214,
					"content": "That seems a bit excessive... The very thought of losing you tears my heart in two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Young Woman in Love"
				},
				{
					"id": 700070215,
					"content": "Ah, your gentle nature makes me fall for you even more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Young Man in Love"
				},
				{
					"id": 700070216,
					"content": "It's like talking to a brick wall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Someone complained that you're too loud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
		{
			"id": 7000703,
			"completionStepIds": [
				7000703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000703",
							"2"
						],
						"stepId": 7000703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Man Doing Magic Tricks",
					"Besotted Woman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "Excuse me? Did you want something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Besotted Woman"
				},
				{
					"id": 700070302,
					"content": "You should keep quiet in the library.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "My apologies, I'll be more mindful of that. I just can't help giving voice to my feelings sometimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Besotted Woman"
				},
				{
					"id": 700070305,
					"content": "While you weren't paying attention, I drew out a rose from between the pages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Man Doing Magic Tricks"
				},
				{
					"id": 700070306,
					"content": "This book-born rose is just like you — delicate and full of scholarly beauty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Man Doing Magic Tricks"
				},
				{
					"id": 700070307,
					"content": "Wha—!? That was amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Besotted Woman"
				},
				{
					"id": 700070308,
					"content": "You're being too noisy! And books aren't meant to be used as props for magic tricks! You'll tear them apart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "You might want to keep it down too, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Oh, sorry. Paimon didn't mean to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "So now you understand. Some things are beyond our control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Besotted Woman"
				},
				{
					"id": 700070312,
					"content": "Once again, I'm truly sorry. I'll keep my volume in check.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Besotted Woman"
				},
				{
					"id": 700070313,
					"content": "It doesn't seem like they took it to heart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070303,
					"content": "Someone complained that you're too loud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
		{
			"id": 7000704,
			"completionStepIds": [
				7000704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000704",
							"2"
						],
						"stepId": 7000704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Seemingly Rational Man",
					"Seemingly Rational Woman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "You claim that \"fluctuations of emotions may influence the accuracy of research and analysis\"? This assertion is founded on insufficient grounds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Seemingly Rational Woman"
				},
				{
					"id": 700070402,
					"content": "*sigh* I understand. I must be encountering some strange hindrance to my research...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Seemingly Rational Man"
				},
				{
					"id": 700070403,
					"content": "You've come at the right moment. I'm having a little trouble right now, and I'd like to have your opinion on it as an outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Seemingly Rational Man"
				},
				{
					"id": 700070404,
					"content": "If I want to prove the veracity of my logic, I must ensure that I keep my cool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Seemingly Rational Man"
				},
				{
					"id": 700070405,
					"content": "But I can never do this, and especially not when I'm debating with her — I just can't seem to keep my cool and think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Seemingly Rational Man"
				},
				{
					"id": 700070406,
					"content": "I find it strange, too. Did you not sleep well last night? Or are you hungover?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Seemingly Rational Woman"
				},
				{
					"id": 700070407,
					"content": "Either way, you probably shouldn't speak too loudly in the library.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "Either way, you should both pipe down a bit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Sorry, but I won't rest until I figure this out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Seemingly Rational Man"
				},
				{
					"id": 700070410,
					"content": "H—He didn't listen at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "Well, you shouldn't be disturbing others either way. Also, stop putting the books back on the shelves with spines facing inward!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Ugh... They're not paying us any mind at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
