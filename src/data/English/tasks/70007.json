					"Wyratt"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070801,
					"content": "So, about the racket in the library...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "I see... I guess we'll just have to use \"that method.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070803,
					"content": "Miss Lisa mentioned in the past that there will be consequences for breaking the library rules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070804,
					"content": "Do you mind going into the library to pass Miss Lisa's message along?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070805,
					"content": "Making dog-ears on pages, stuffing roses into books, putting them onto shelves the wrong way... These are definitely violations of the library rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070806,
					"content": "Well, let's go pass Lisa's message on to those people in the library who aren't reading the way they should.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000710,
			"completionStepIds": [
