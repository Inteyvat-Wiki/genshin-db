				{
					"id": 700070701,
					"content": "*sigh* Guess nobody's in the mood for advice, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070702,
					"content": "None of them have very good library etiquette. Best we go talk it over with Wyratt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000708,
