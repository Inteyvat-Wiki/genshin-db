					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700071001,
					"content": "Eh!? What? Lisa's coming back soon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071002,
					"content": "Oh no! She'll be real mad when she finds out that people have made a mess out of the books and even dog-eared the pages, won't she?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071003,
					"content": "That's right — oh no, how terrible! Who will save us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "Oh, what are we to do? Oh, oh! Maybe there might still be time if we start cleaning up now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071005,
					"content": "That was quite ingenious of you. Quite unexpected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071006,
					"content": "That was Wyratt's idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "Well, Lisa's reputation precedes her.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Still, Miss Lisa probably would have been mad if she had seen the state the library was in earlier. This is a library, after all — a place of learning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071009,
					"content": "Guess I can finally continue my research in peace. Here, take this as thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
