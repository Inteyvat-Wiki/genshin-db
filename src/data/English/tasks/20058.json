			},
			"dialogs": [
				{
					"id": 200580301,
					"content": "You flew there in {ChallengeCurrValue10} minute(s), that's amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580302
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580302,
					"content": "Do you wanna go again? I bet you could go even faster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580303
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580303,
					"content": "And I'll give you a prezzie if you do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
