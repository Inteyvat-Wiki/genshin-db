			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "Wah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "What do you want to do up there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "Aunty Grace says that if you want to tell someone a secret, you just need to tell it to a dandelion then throw it to the wind... The Anemo Archon will carry the dandelion seeds and the secret you told it to the person you want.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "And the higher you throw it into the wind from, the faster your message will get there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "This one time, Glory got an adventurer to climb up the statue and throw some dandelion seeds into the wind for her. Just a few days later, Godwin wrote her a letter back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "I have a secret to tell Daddy, and I already got a dandelion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "But Aunty Grace won't let me do it. She says that I can go back and live with Daddy when I've grown up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "I wish there was a way to grow up faster... I'm trying as hard as I can, but I'm still so short...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Oh yeah— I always see you gliding around in the city. Can you teach me? How do you do it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Sure, I'll show you how.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Hee-hee, yay! I'll just stand by and watch, I'm sure I'm allowed to do that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "You wanna glide with me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "No way! Aunty Grace would go mad if she saw me doing that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
		{
