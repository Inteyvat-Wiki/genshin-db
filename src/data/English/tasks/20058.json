			"dialogs": [
				{
					"id": 200580601,
					"content": "I'll do it again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580602
					]
				},
				{
					"id": 200580602,
					"content": "Yay! I'll be watching you the whole way.",
					"roleType": "TALK_ROLE_NPC",
