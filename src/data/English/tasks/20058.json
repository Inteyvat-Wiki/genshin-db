			]
		},
		{
			"id": 2005809,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2005801",
							"3"
						],
						"stepId": 2005801,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Oh, Nora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Are you her carer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Yes, for a number of reasons her mother is... away from home. In the meantime, I'm taking care of her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "I also care for several other children who need someone to look after them. It's part of my duty as a sister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "It's like I suddenly got a whole new family of children. They're good kids, and they get on well with Glory, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Timmie's the one I've looked after longest. He's even started calling me Mommy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Tell me about Nora's father.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Patton is her father. His incessant drinking caused huge problems in the home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "The Church and the Knights of Favonius both gave him a number of warnings, but he would not change his ways. In the end, it was Master Diluc who took action.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
					"content": "Believing that Patton was in no shape to look after Nora, Sister Victoria put her under the care of the Church while Patton takes some time out to reflect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580911,
					"content": "But when Nora grows up, the excuse we keep giving her that \"Daddy is busy with work and needs to be left alone...\" It's going to wear thin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580912,
