				"points": []
			},
			"dialogs": [
				{
					"id": 230381101,
					"content": "Hmm, I don't think there was anything wrong with that ingredient, and I'm sure my brewing method was correct. What happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "T—Traveler, what brings you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "Zakariya sent me here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "So you must've heard about the mess I've made. This is embarrassing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Anyway, drink the medicine first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "O—Okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf drinks the medicine...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Phew... I feel much better. Zakariya's indeed a great doctor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "Why did you modify the prescription?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Do you remember the medicine we brewed together last time? It didn't work very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "I thought I might've boiled it the wrong way or missed a few ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "So I... Um... made another bowl based on my experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "I tried it first as a reasonable precaution, and I believe you know the rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "I just sent someone to get some medicine for me from Dr. Zakariya, but you beat him to the punch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "Thank you, Traveler. I'm going to get some rest now. After that I'll have to start receiving patients again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "I've been absent for so long... Many villagers must be waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*sigh* But I'm running out of herbs again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
