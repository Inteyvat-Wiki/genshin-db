			"dialogs": [
				{
					"id": 220050101,
					"content": "Come on, where is it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "Wah! Where'd you come from!? How'd you sneak up so quietly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "Me? I'm... a researcher. I'm looking into the historical architecture and relics of the Guili Plains. Y—You can call me Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "I was so engrossed in my research that I've misplaced a package I carry round with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "It's got an extremely rare trea... Uh, an extremely rare historical relic inside. Could you help me look for it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Great! I think it was near here that I dropped it... or maybe a little further out. Anyway, please have a careful look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "What does the package look like?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Y'know, just... an everyday box. Four sides, a top, and a bottom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "Why put a relic in there? Because... Having it in a box is more convenient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "I padded the box with some clothes to protect it from damage. Please, help me find it as quickly as you can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "What kind of relic?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "It's, uh... It's just a very precious relic. Ugh, you wouldn't understand even if I tried to explain it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Only an expert like me can tell its true value. Please, help me find it as quickly as you can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
