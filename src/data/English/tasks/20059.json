			"dialogs": [
				{
					"id": 2005906001,
					"content": "This will make a handsome sum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906002
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005906002,
					"content": "Wait till I've sold this and I'll be sure to compensate you fairly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005906003,
					"content": "Look at that! Someone's taking an interest...",
