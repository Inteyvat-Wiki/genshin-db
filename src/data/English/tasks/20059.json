					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005902001,
					"content": "Hmm, I haven't given you the slightest idea of what sells well, have I? I bet you don't know what to look for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902002,
					"content": "Why don't you get me some <color=#00E1FFFF>loot from the hilichurls</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902003,
					"content": "I have a feeling that adventurers looking to prove their worth would be interested in that sort of thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
