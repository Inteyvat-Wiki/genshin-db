					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005910201,
					"content": "Actually it's just ordinary hilichurl garbage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005910202
					]
				},
				{
					"id": 2005910202,
					"content": "Really? What would I want to buy that for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910203,
					"content": "Whew... I almost handed over the cash too! In future, spare me the hard sell and just give me the facts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910204
					],
					"speakerTitle": "Jack"
				},
