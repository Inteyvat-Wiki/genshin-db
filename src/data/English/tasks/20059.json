			},
			"dialogs": [
				{
					"id": 2005910101,
					"content": "Every last word.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005910102
					]
				},
				{
					"id": 2005910102,
					"content": "Well, I guess that decides it then. I'll take it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910103
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910103,
					"content": "Excellent choice sir, if I do say so myself! Here, I've wrapped it up for you. Have a wonderful day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
		{
			"id": 20059102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
