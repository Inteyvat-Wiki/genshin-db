			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "This is bad... Very bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "Traveler! Just the person I needed to see. Did you know this is my souvenir shop?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590104,
					"content": "My dad used to wait till the adventurers came back and buy their spoils of war from them to sell in the shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590105,
					"content": "But since things started dying down at the Adventurers' Guild, my opportunities to stock up have been few and far between.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590106,
					"content": "Not only that, but recently the items we get in are hardly worth anything. Nobody wants to buy them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590107,
					"content": "Traveler, your adventures take you all over the place, don't they? Could I trouble you to bring me back some treasures that I can sell next time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590108,
					"content": "I'll keep my eyes peeled.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "Thank you! Whatever you bring me, I will make sure to get a good price for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590110,
					"content": "Actually, Paimon is worth a pretty penny.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "I'm sorry, but nobody wants to buy that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590112,
					"content": "My customers tend to prefer objects of the more inanimate variety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
		{
			"id": 2005902,
