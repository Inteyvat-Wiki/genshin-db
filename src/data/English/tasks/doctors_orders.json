						230181902
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181902,
					"content": "I told him that he could just eat a steak or two...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181903
					]
				},
				{
					"id": 230181903,
					"content": "Oh? It didn't occur to me you could put it like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181904
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181904,
					"content": "Well, as long as Aftab is treating his body right, everything should be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181905
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181905,
					"content": "I can't thank you enough. Please take this as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				}
			]
