			},
			"dialogs": [
				{
					"id": 230181801,
					"content": "What is this? No... The scent is just too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181802
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181802,
					"content": "So here's what happened...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181803
					]
				},
				{
					"id": 230181803,
					"content": "Really? A light diet doesn't mean a full ban on meat? Even the Akademiya researchers don't do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "S—So that's it! I was afraid of making the Dendro Archon angry by eating meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "If even the researchers do eat meat... I won't worry about eating meat anymore. Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aftab"
				}
			]
		},
