				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "The medicine delivery this time is for Gurgen, who is at the medicine farm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "He strained his arm from doing too much work a few days before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Please give him this medicine. By the way, tell him to also stay at home and pray silently to the Dendro Archon. Farm work can wait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Please come back once the delivery is done. I will have the payment ready for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "Pray silently to the Dendro Archon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "He won't listen to a word I say if I don't say that. Just do as I instructed, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301803",
							"2"
						],
						"stepId": 2301803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180301,
					"content": "Huh? This is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180302
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180302,
					"content": "Here's your medicine, remember to pray quietly to the Dendro Archon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180303
					]
				},
				{
					"id": 230180303,
					"content": "Ah, thanks. Pray quietly to the Dendro Archon... Yes, I must do that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180304,
					"content": "But there are so many <color=#00E1FFFF>weeds in the field</color>... If I keep doing nothing, it's going to affect the yield.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180305
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180305,
					"content": "Um... I'll just <color=#00E1FFFF>deal with the weeds</color> first, then do my silent prayers when I finish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				}
			]
		},
