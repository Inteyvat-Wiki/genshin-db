			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "Are you awake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710202,
					"content": "Ugh... It's morning again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "What's up? Has something happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "It might sound hard to believe, but no. Nothing's happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710205,
					"content": "You're awake? Then let's bring you up to speed: We've searched everywhere, and found nothing unusual at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710206,
					"content": "Based on the previous two mirages, we should have been able to find something that acts as an entrance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710207,
					"content": "That's weird.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "Is it possible that the time has not come yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710209,
					"content": "You mean, we should wait a little longer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710210,
					"content": "Yes. Plus, Fischl is still nowhere to be found, and I highly suspect that she's even more eager to find the entrance than we are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710211,
					"content": "So let's wait. Let's give the mirage... no, give Fischl some more time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710212,
					"content": "Everyone agrees with Mona and takes a break. Then, they continue the search in two groups.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "After numerous round trips with little success, something finally appears on the beach.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "There's something on the beach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710215,
					"content": "A book? And next to it is... hmm... a raven statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710216,
					"content": "This statue looks a lot like Oz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710217,
					"content": "Why did these two items appear together? Did the raven bring the book here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710218,
					"content": "What's the book about? Is it a diary?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710219,
					"content": "Let's see... \"Hymn of the Holy Land\"? I've never heard of a book by that title.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710220,
					"content": "From the cover, it looks like... it was written by Fischl herself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710221,
					"content": "That would certainly fit her personality. \"Hymn of the Holy Land\"... interesting, I like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710222,
					"content": "As a title, it has a sacred ring to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710223,
					"content": "So what should we do? Should we touch it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710224,
					"content": "...Fischl's still not back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710225,
					"content": "Never mind, let's head inside first. Once Fischl finds the book, I'm sure she'll be able to catch up with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710226,
					"content": "Paimon agrees! It's like we're peeping into her diary, so Paimon's sure she'll wanna come in and stop us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
