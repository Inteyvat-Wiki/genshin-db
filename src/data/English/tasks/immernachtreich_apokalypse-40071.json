						],
						"stepId": 4007103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narrator",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "\"Though this truth has long faded from popular memory, scholars have long known that Prinzessin Fischl von Luftschloss Narfidort first descended upon the world during the Time of Chaos, roughly six hundred years before the Era of the Saints.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Narrator"
				},
				{
					"id": 400710302,
					"content": "What? A narrator?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "We really are inside a book, huh. There's even a narrator telling us the story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "Oh no, the path has been cut off. We can't go across.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "There's a device over there that appears to be waiting for us to approach it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "Is it just Paimon, or does everything in this place seem just a little bit over-deliberate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "Well, it is the Holy Land, what did you expect...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Yeah, everything's so blatant... it's clearly begging to be noticed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "That's our Fischl for ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007110",
							"2"
						],
						"stepId": 4007110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "Someone, please, help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711002,
					"content": "Uh, isn't this a statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711003,
					"content": "Please don't refer to me like that! My name is Leon, and I am a knight of the Immernachtreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711004,
					"content": "A knight? But you don't look like one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711005,
					"content": "You can't tell? Anyway, please don't speak ill of Sire Ozvaldo. He personally designed and distributed the armor for Die Nachtraben Ritter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711006,
					"content": "\"Sire Ozvaldo\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}, you must have heard that one before, surely? Oz's full name, \"Ozvaldo Hrafnavins.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711008,
					"content": "I remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Oh... So \"Megistus\" was the easy pronunciation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711011,
					"content": "I agree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711012,
					"content": "Haha, or so it seems...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711013,
					"content": "Dear friends, I apologize for interrupting your lovely conversation, but I believe you haven't been informed that the gate ahead has been locked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711014,
					"content": "Yup, that's news to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711015,
					"content": "I'm hoping you'll be kind enough to save me, and in exchange, I'll gladly teach you how to unlock the gate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711016,
					"content": "Well, I guess we'll have to save you then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711009,
					"content": "Well, now I know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
		{
			"id": 4007112,
			"completionStepIds": [
				4007112
			],
