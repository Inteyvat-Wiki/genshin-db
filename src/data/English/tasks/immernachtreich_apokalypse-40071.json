			"dialogs": [
				{
					"id": 400711201,
					"content": "Valiant heroes... No words can express how grateful I feel right now. Thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711202
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711202,
					"content": "Remember, this is the password that unlocks the gate. \"May my people be freed from the shackles of ancient decrees.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		},
		{
			"id": 4007113,
			"completionStepIds": [
				4007113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007113",
							"2"
						],
						"stepId": 4007113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Looks like it's a dead end ahead. There's only a book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "Do you think what we just heard is the story from the book?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "So the \"Holy Land\" in the book's title refers to the Immernachtreich. This book sings the praises of the Prinzessin from the perspective of the people in her kingdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "I guess this is kind of an autobiography...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "We're on the last page of the book, but the story doesn't seem to have ended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "What happens next? Paimon wants to know what happens next!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "I guess we'll have to keep exploring. As for this book... wait, I have an idea... Now that we've finished it, let's close it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4007114,
			"completionStepIds": [
				4007114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007114",
							"2"
						],
						"stepId": 4007114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Fischl",
					"Fischl's Mother",
					"Fischl's Father",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "Huh? We've been transported again, but we're not back on the beach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711402,
					"content": "We are somewhere in... Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711403,
					"content": "Greetings, Honorable Kaiserin der Verurteilung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711404,
					"content": "Amy, dear, I've made Steak and Fisherman's Toast. Come on, eat up before they go cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "Fischl's Mother"
				},
				{
					"id": 400711405,
					"content": "Ahem! Mother...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711406,
					"content": "Oh, look at me, being so forgetful. Ahem! Dost thou knowest, Prinzessin der Verurteilung, that the hour of luncheon encroaches?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "Fischl's Mother"
				},
				{
					"id": 400711407,
					"content": "Of course, Mother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711408,
					"content": "Ah, behold the view from the window, a delight to the senses! Prinzessin, Kaiserin, would you care to join the Kaiser der Verurteilung for a grand royal picnic? We shall enjoy the scenic view and partake of the delicacies granted to us by the heavens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "Fischl's Father"
				},
				{
					"id": 400711409,
					"content": "Yes, I shall gladly join you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711411,
					"content": "...Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711412,
					"content": "Uh... does anyone wanna say anything about that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "Okay, I'll bite. So \"Amy\"... that's Fischl's real name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711415,
					"content": "Seems like it. The other two voices were probably her mom and dad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711416,
					"content": "...Why are all of you giving me that look!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711417,
					"content": "Forgive me if this comes across as rude, but... is your surname truly Megistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711418,
					"content": "Hmph, you think I was bluffing? My full title is and always has been \"Mona Megistus, the Astrologist.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711419,
					"content": "...My apologies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711420,
					"content": "Don't you think that's a bit long?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711421,
					"content": "Well, it's a special case. Only geniuses get titles like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711422,
					"content": "Well, that makes no sense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711423,
					"content": "What are your thoughts on the scenes we just witnessed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711424,
					"content": "Well, it seems that \"closing the book\" is one way of affecting change in this mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711425,
					"content": "Well, I think it's sweet that Fischl's parents are willing to play along with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711426,
					"content": "They probably didn't indulge her forever. Based on the voice, this was surely a memory from her childhood? It's a different story now she's grown up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711427,
					"content": "You know a lot about Fischl, Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711428,
					"content": "After all, we've been friends for quite a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711429,
					"content": "Speaking of...I wonder where Fischl is now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711430,
					"content": "That voice mentioned that she was heading out. We may as well go outside, and see if we can find anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4007115,
			"completionStepIds": [
				4007115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007115",
							"2"
						],
						"stepId": 4007115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha",
					"Arnold"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "Oh, we're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Wait, why are we back? We haven't finished the story yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "This feels as awful as purchasing a counterfeit astrology tutorial, or realizing you've forgotten your wallet in the middle of dinner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "ARGH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "Argh! This is torture!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "I think they're a little bit upset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "To be honest, I also don't like to read books that end on an unexpected cliffhanger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Haha, no one likes that. Alright, let's enter the mirage again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "Good idea! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "We're still here, it's not working",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "That's odd. We were able to enter earlier, but now, we can't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "Why!? Why are we being denied the opportunity to finish the book!? This is pure sadism!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Hmm... Maybe it's because we've already reached the end of this book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "Before leaving the mirage, we saw that the book had been flipped to the final page. I believe \"Hymn of the Holy Land\" is divided into multiple volumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "It's like one of those sneaky light novel marketing schemes... \"If you want to know what happens next, please buy the next volume.\" Yuck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "Hmph! I have to see the ending.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Oh, oh, yes, the ending. Everyone wants to see how the books ends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "Huh? Who's there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Oh, oh, heavens above, she saw me. Stand up straight, stand up straight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "You're...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "I'm \"Ask-Me-For-Directions Arnold\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "That name's a little on the nose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "So, Arnold, let me ask you something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "It's \"Ask-Me-For-Directions Arnold\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "...So, Ask-Me-For-Directions Arnold, let me ask you something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "Yes, Ma'am!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "Are there other volumes of \"Hymn of the Holy Land\"? Where can I find them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "Oh, oh, you're asking the right person. \"Hymn of the Holy Land\" is the sacred scripture of the Immernachtreich. There are three volumes in total, with the other two stored in two high locations in the castle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "If you wish to find the second volume, you must climb to the very top floor of the tower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "Tower? You mean, that tower over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "That is, indeed, the tower where the sacred scripture is stored. If you look closely to the cave right over there, you'll find a secret passage that will swiftly take you to the tower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "Okay, thank you, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "It's \"Ask-Me-For-Directions Arnold\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "Do you have any other questions for me, fair maiden? Concerning, perhaps, my relationship status, or monthly income...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "No! Goodbye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "Let's ignore that raven and proceed! There's a secret passage in the cave ahead that leads directly to the top of the tower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "Oh, oh, but Ma'am! Are you sure you're not interested in me? I only shared with you the secrets of the Immernachtreich because of your great beauty! Ma'am! Wait...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}