					"Canotila"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "I see: The flames on the throne have been extinguished, and the burnt ashes have once again turned into trees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Flowers bloom with your every step, bringing change to an otherwise inevitable decay in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Huh? It's {M#Mr.}{F#Ms.} {NICKNAME}! What brings you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Um, right! The golden butterfly has returned. I need to go and see it! Goodbye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7419202,
			"completionStepIds": [
				7419202
