				"objectNames": [
					"Canotila"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920301,
					"content": "Since memories can be made into a book, if we reverse that logic, the contents of the book can also be written directly into memories...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Ah, it's you, the strange {M#Mr.}{F#Ms.} {NICKNAME}. What is it? Do you need something from me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "What were you talking about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Hmm. No matter how I think about this, converting memories into a book is quite an incredible deed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "The creator of this book must've only been able to do this because they viewed the emotions in their memo{RUBY#[D]delusions}ries as the most precious thing in the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "That doesn't change how difficult it is to read, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "...And I'm not sure what kind of impact it will have on its readers. This is quite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7419204,
