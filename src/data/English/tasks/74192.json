			},
			"dialogs": [
				{
					"id": 741920401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920402,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "Huh? You're finally back! Don't disappear like that, don't you know how worrying it is? Just imagine what would happen if you never returned...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920404,
					"content": "Do you have any idea how long you were inside? It felt like the waiting would never end... Even the other Melusines had no idea how to help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920405,
					"content": "(It seems like I've been here for quite a while, then.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Well, I've got to go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#What? {NICKNAME}, where are you going...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920408,
					"content": "Don't worry. I'll come back once I find you, Canotila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Just wait for me a little longer, okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "I know that saying this to you won't change much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "But still, trust me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920412,
					"content": "Don't worry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				}
			]
		}
