						"pointId": 7387
					}
				]
			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "*sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920202,
					"content": "Canotila...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#Huh? {M#Mr.}{F#Ms.} {NICKNAME}... Who are you? I thought no one could get in here besides me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920204,
					"content": "Wait, how do you know my name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920205,
					"content": "We know each other.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "Liar! You must be just like those monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920207,
					"content": "(Lie) Serene sent me to find you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "Oh... Always making her worry like this, I'm such a bad child...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920209,
					"content": "#I'm {NICKNAME}. Do you still remember me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#Right, {M#Mr.}{F#Ms.} {NICKNAME}... I remember now... Even though you're a giant monster who could swallow the world in one gulp, you are very kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920211,
					"content": "Heh, how rude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "I'm sorry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920214,
					"content": "What's happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "I saw a few people, but then they slowly melted and turned into monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920216,
					"content": "Uh... That's kinda scary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920213,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
			"id": 7419203,
			"completionStepIds": [
				7419203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
