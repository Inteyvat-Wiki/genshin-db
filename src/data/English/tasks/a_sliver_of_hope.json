				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120901,
					"content": "I'm sorry that we weren't much help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120902
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120902,
					"content": "One day, though, that child is going to have to face up to his feelings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120903,
					"content": "This is one life lesson that he can't learn from his parents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Kaori"
				}
			]
