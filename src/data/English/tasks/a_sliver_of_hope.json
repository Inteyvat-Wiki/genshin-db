				"points": []
			},
			"dialogs": [
				{
					"id": 120120801,
					"content": "The Naganohara Fireworks Show must be coming up soon, right? My daughter left quite a while ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120802,
					"content": "Heh, she couldn't get out the house quickly enough. She's clearly very taken with this boy in the city, it was written all over her face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120803,
					"content": "*sigh* But, at least she's happy, I suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Satoru"
				}
			]
		},
		{
			"id": 1201209,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201206",
