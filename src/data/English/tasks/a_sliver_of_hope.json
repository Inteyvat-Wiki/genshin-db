	"talks": [
		{
			"id": 1201201,
			"completionStepIds": [
				1201201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201201",
							"2"
						],
						"stepId": 1201201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Well! If it isn't Yoimiya! Come on in, dear, come and take a seat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "Are these two your friends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "Yes, they're travelers from afar. Outsiders have a very difficult time getting into Inazuma nowadays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "Indeed, these are unprecedented times. But seeing as they came all this way, we locals should give them a warm welcome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Mm-hmm. Oh, before I forget — I brought the fireworks that you ordered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Oh, thank you, dear. Your family is so good to us, every year. First your father, and now you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "I wonder if I'll still be alive to see the next heir of Naganohara Fireworks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Of course you will, you're both in great health! Don't say things like that, it's bad luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "*sigh* We aren't as young as we once were, though. The body knows it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "It used to be that I could spend all day working the land, carrying water back and forth, but now, even a moment of light work leaves me with all sorts of aches and pains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "I wanted to do some weeding yesterday, but as soon as I bent down to get started, I suddenly felt that if I went any further, I wouldn't be able to get back up again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "No worries, say no more — we'll handle it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "No, no, no, we can't be putting you to work when you're a guest in our home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "I'll just go fetch the tea and some snacks, and then we'll continue our conversation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "It's fine, it's not like it's the first time I've helped you with chores. I just haven't had much time recently with the fireworks show coming up — but once that's outta the way, I'll be sure to come by more often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "It's no trouble, really. We don't mind helping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "*sigh* You're such good kids... As for mine, he's all grown up now, hasn't found anyone yet, and he doesn't visit very often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "If you're quite sure it's no trouble, then... I have some pickled radish here, would you mind delivering it to Satoru on the other side of the village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Sure, it won't take us a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "The old folks aren't very mobile, so c'mon, let's help them out. We'll <color=#00E1FFFF>get rid of the weeds</color> first and then <color=#00E1FFFF>deliver the pickled radish</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Hey, Satoru, how have you been? Keeping well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Same as usual, not much has changed. You're looking full of life, as always.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "All thanks to the support of our loyal customers. The family business just keeps getting better and better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "We sold some fireworks to Liyue a while back, and word is they were a real hit. So it looks like we'll be getting more business from over there in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "That must mean a lot more work for you though? Are you sure you and Mr. Ryuunosuke can manage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "If it gets too much, don't forget you can always ask me for help. Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "We should be fine. I think we can cope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Oh yeah, um, this is some Pickled Radish from Mrs. Imatani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Wow, thank you so much! I never used to be a fan of Pickled Radish, would you believe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "But then I tried some of Mrs. Imatani's homemade stuff, and I couldn't get enough of it. It's a family staple now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Speaking of your family, how is everyone doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "They're doing well. We have the occasional heated argument, but... I guess that's every family ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Being close to family is better than never getting to see them, even if it does mean putting up with some conflict.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "Now, Mr. and Mrs. Imatani seem to have a great relationship — but still, they must get lonely with their child never visiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Huh, they didn't seem that way to me. I think they're just used to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "You make a good point though. I should drop by more often in the future. That way, they won't get so bored.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "I'm sure they'd love that — as would all of us in Konda Village. You're always welcome here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Hee-hee, thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "That was quick! Ah, young people are so handy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Younger people have bundles of energy, and older people have a wealth of wisdom. Each have their strengths.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Speaking of youth... Do you know what? It's been 50 years this year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Oh, so it has! Goodness, how the time flies... You barely notice as the years go by, but then suddenly, 50 years have passed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "50 years since what? Some important day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Haha, well, if you must know, it was 50 years ago, back in the days when this young lady was still trying to win me over, that—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "Oh, stop trying to impress them. We both know you were the one who was hopelessly smitten and desperately trying to win my affection...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Well, maybe you're right. 50 years ago, I proposed to my wife at the Naganohara Fireworks Show. We've been together ever since.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Congratulations to you both.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "To tell the truth, I was still a little uncertain. I wasn't sure what I was doing when I walked into the Naganoharas' shop and ordered my firework.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Even as it was rising up into the sky... I still had no clue what I was going to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "But then it exploded... the sky lit up... I looked back at her and saw her eyes, twinkling in the light of the fireworks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "...Before I knew what was happening, apparently, I'd already said it, and well, she'd said yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "50 years... In some ways, it's a long time, in others, it's no time at all. Really, it's just a number.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "But 50 years of being together... now that is something worth commemorating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "I had no idea it was your 50th anniversary. If I'd known, I would've made some extra-fancy fireworks, just for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Oh, no, it's quite alright. We always set off the same firework every year. It wouldn't be the same without it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Seeing that firework go off takes us right back to those days. Even at this age, we still look back with not a single regret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Aw, what a great relationship they have...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Enough about us, though. Yoimiya, aren't you busy with the fireworks show coming up? Was there something you needed to discuss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Yeah, um... it's a difficult thing to talk about, but here goes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Hmm... Sakujirou... so, he came back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Huh? You know him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "He was our boy's best friend when they were young.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*sigh* They were inseparable. They grew up together, shared everything with each other, and went everywhere together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "But one day, they had a terrible argument...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Sakujirou seemed to feel that Inazuma was too peaceful, and wanted to see what the outside world was like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "But our Keisuke took after his father and mother. He felt that there was nothing wrong at all with being peaceful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "You know what children are like, they get terribly worked up about these sorts of things. In the end, Sakujirou stormed off, and that was that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "I see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Keisuke said nothing to me or my wife about the fight. We could sense that he was very hurt by it, but he didn't want to talk with us about how he was really feeling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Eventually, whether out of pent-up anger or for some other reason, he joined the Tenryou Commission. He rarely comes home anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "If it was anything else, I could talk to Keisuke, and I'm sure he'd be willing to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "But since it's Sakujirou... I don't feel there's any way we can get involved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "What a strange coincidence. Who'd have thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "I understand now. When I asked Sakujirou why he came back, he just said \"because of past mistakes\" and wasn't willing to elaborate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Now, I finally understand why he can't decide what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Two best buddies in childhood... one grows up to join the Tenryou Commission, the other grows up to join the Tenryou Commission's most wanted list...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "I guess this is fate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Well, no worries, if that's the case then never mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "We can find some other way to help Sakujirou, there's no need to make things difficult for you. This sounds like something for Sakujirou and Keisuke to resolve between themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Yes, it'd be so nice if they could go back to the way things were.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "I think after all these years, they ought to let go of their grudges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "I never would have imagined it either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "You should be very proud of what you have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201206",
							"2"
						],
						"stepId": 1201206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Yoimiya, something bad's happened! Some people from the Tenryou Commission came by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120602,
					"content": "Huh? Why? ...Do they know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120603,
					"content": "Pops, are you alright? They didn't do anything to you, did they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120604,
					"content": "I told them the show was starting soon and the place was filled with fireworks, so they shouldn't go in because it's a fire hazard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120605,
					"content": "But they didn't listen. It seemed like they knew Sakujirou was inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120606,
					"content": "Luckily, Sakujirou heard them coming in time and managed to escape through the window. The Tenryou Commission wasn't able to capture him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120607,
					"content": "This is bad news. I don't think Sakujirou had enough time to make his mind up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120608,
					"content": "Pops, did you see where he went?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120609,
					"content": "The Tenryou Commission will definitely be chasing after him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120610,
					"content": "Did you catch any of their names?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "Good point! Names, we need names! Suddenly showing up like this, surely it must be Keisuke's doing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120612,
					"content": "The Commission wouldn't normally cause this big of a fuss over a stowaway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120613,
					"content": "Sorry, my ears are no good, and I didn't get a good look at them either. If you're wondering which way they went, they left the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120614,
					"content": "I wish I caught their names... *sigh* But I didn't hear a thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120615,
					"content": "As it happens, I did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120616,
					"content": "I was getting some ore from my friend's place and happened to bump into them on the way over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120617,
					"content": "I think their leader's name was Keisuke, just like you said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120618,
					"content": "Just as I thought! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120619,
					"content": "If Sakujirou still hasn't made up his mind, those two running into each other won't solve anything — and even worse, there'll be no coming back from it for Sakujirou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120620,
					"content": "#We can't let that happen. Come with me, {NICKNAME}, let's track them down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
