				"points": []
			},
			"dialogs": [
				{
					"id": 200120301,
					"content": "Th—Thanks so much, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120302,
					"content": "But please, don't tell anybody I got myself into trouble. My husband will give me an earful if he finds out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120303,
					"content": "Don't look at me like that... Wait till you're married, you'll see. A solitary stroll is a huge luxury when you're living with someone, you've got to make the most of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120304,
					"content": "Here, take this. I picked some while I was out. Much cheaper to cook for yourself than eat at Good Hunter! You have to scrimp and save if you want to get by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panicked Myrana"
				}
			]
		}
