			"dialogs": [
				{
					"id": 200120201,
					"content": "Th—Thank you, Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120202,
					"content": "*sigh* First monsters, now this roadblock... It's hectic enough already back home, there was me thinking this would be a chance to get away from it all for a while!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120203,
					"content": "I'm sorry, but is there any chance you could sort out this roadblock situation for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120204,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Thank you! I hope my two young ones grow up to be kind like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panicked Myrana"
				},
				{
					"id": 200120205,
					"content": "I have other things to do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Come on, please... I promise it won't take you too long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panicked Myrana"
				}
			]
		},
