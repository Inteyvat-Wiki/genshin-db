			"dialogs": [
				{
					"id": 101130201,
					"content": "You know, I'm glad I actually had the chance to come down here today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130202,
					"content": "The tavern isn't overcrowded, and I couldn't be in a better mood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130211,
					"content": "Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130212,
					"content": "So many years after the fact, it's not even his friend himself that holds him back anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130213,
					"content": "But I for one am confident that the people of Mondstadt will not forget his friend's story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011303",
							"2"
						],
						"stepId": 1011303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Tell me, Stanley... Tell me what should I do...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130302,
					"content": "Huh? Why does he keep repeating his own name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130303,
					"content": "He's hiding something.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Could there be another person called Stanley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130307,
					"content": "*sobs* Oh, Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130308,
					"content": "It should have been me! I should have been the one to die in the Mare Jivari that day... Why won't your spirit come and stop me from using your name? Why, Stanley, why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130309,
					"content": "If only you hadn't had to save a rookie like me, you would have never died in that windless corner of the world...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130310,
					"content": "You were a renowned adventurer, destined to become a legend one day... But now... that'll never happen, because your life was cut short— and all because of a worthless tag-along...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130311,
					"content": "Uhh... Does anyone get what's going on here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130312,
					"content": "...I think our friend really did make it to the Mare Jivari. And I think the tragedy he encountered there was real, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130313,
					"content": "But the real adventurer, the real Stanley — that was his partner. Not him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130314,
					"content": "The real Stanley is the one who died to save our \"Stanley.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130315,
					"content": "Wait... So the only reason our Stanley is called Stanley in the first place is because he stole the other Stanley's name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130316,
					"content": "I fear that may be the case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130317,
					"content": "Stanley, for so many years I've lived in fear... fear that Mondstadt will forget all about you... So I tell your adventure stories at every opportunity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130318,
					"content": "Mondstadt must remember: Stanley reached the center of the Mare Jivari... He's the greatest adventurer there ever was, and he lives on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130319,
					"content": "Stanley will never die, because... I am Stanley! I... am Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130320,
					"content": "I'm sorry, Stanley... I'm getting too old... now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130321,
					"content": "*sigh* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130322,
					"content": "Are you guys planning on eavesdropping much longer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130323,
					"content": "Yikes! We're busted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130305,
					"content": "There's another Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "Surely not. Even I've never heard tell of a second Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "*sigh* Go away. Save your questions, just... leave me in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130402,
					"content": "But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130403,
					"content": "Leave, now! Don't make me tell you again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130404,
					"content": "Honorary Knight! Venti! And Paimon! I'm so glad you guys are here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130405,
					"content": "I've been looking for you everywhere! I wanted to thank you again for helping me find the sword and shield. My parents are finally supporting me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130406,
					"content": "Oh... Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130407,
					"content": "Yeah, really! They even said they're gonna pay for someone to fix up the Sword of Brilliant Valor and Shield of Magnificent Honor for me, so I can take them out on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130408,
					"content": "That's wonderful! So, Jack, is this the part where you bid farewell to Mondstadt and set off on your intrepid trip traversing Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130409,
					"content": "No, not yet. I still don't have what it takes to go too far from home just yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130410,
					"content": "Besides, I'm sure Stanley still has a few stories left to tell. Hehe... They're what inspired me to become an adventurer in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130411,
					"content": "Stanley, I— Oh, you're drunk again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130412,
					"content": "See you tomorrow, then. After your hangover wears off, maybe you can tell me some more of your stories?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130413,
					"content": "Stanley's really fond of that kid, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130414,
					"content": "*hic* Jack? Jack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130415,
					"content": "Jack left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130416,
					"content": "Oh, I see... Well, thank you for not telling him about my secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130417,
					"content": "Eh? All of a sudden you're facing the facts? That isn't like you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130418,
					"content": "Just now... I couldn't bear to look at him. His adventurer's spirit is so pure... unblemished...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130419,
					"content": "I'm just a weary old feckless fraud, but that kid is a brand-new shining star, full of potential... I cannot allow his dreams to be crushed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130420,
					"content": "You're not a total fraud... Stanley's adventure stories and experiences — they're all true, aren't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130421,
					"content": "Stories... Experiences... What's the point of them anymore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130422,
					"content": "To be honest, my memories of adventuring, and of Stanley... they're hazy these days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130423,
					"content": "That's my biggest secret of all. And my biggest fear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130424,
					"content": "All these years, I've been livin' to tell his story. But his personality, and the details of his life, I don't remember them clearly anymore. Ah-ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130426,
					"content": "His whole life, he's been drowning in guilt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "All that remains is this imaginary friend...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "But the one thing I can never forget... is that he died in a windless land, where his spirit can never be recovered!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130428,
					"content": "Exactly... Even in his memory, the real Stanley isn't the living, breathing friend he knew at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130429,
					"content": "Instead, he's become fixed on the image of him as that battle-scarred warrior... and that image has held him captive his entire life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130430,
					"content": "I'm too old... I never let go, but still so much has slipped away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130431,
					"content": "I'm completely and utterly worthless!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130432,
					"content": "No adventurer should have to go that way... No adventurer ever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130433,
					"content": "I... I can't believe it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130434,
					"content": "Thank you all! And thank you, Lord Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130435,
					"content": "I'm sorry, it's gonna take me some time to calm back down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130436,
					"content": "But, I think that... I'm gonna be okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130437,
					"content": "Ah, wonderful! Stanley reconnected with his true self, and Jack can finally go his own way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130438,
					"content": "This calls for a celebration! And by celebration, I do of course mean libation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130439,
					"content": "And by libation, you mean you're not leaving this tavern till you're too drunk to walk, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130440,
					"content": "Haha... no. The wine here's too expensive. Jack still owes me some wine though — he promised me a rare vintage in exchange for helping him out, remember?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130441,
					"content": "I'll head off to fetch the wine. See you shortly! Let's meet at the <color=#00E1FFFF>usual place</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130443,
					"content": "It's anybody's guess.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "I think I know where... possibly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Okay, see you there!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "Huh? Where's that supposed to be? Why has Paimon never heard of it? Hey, Tone-Deaf Bard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130446,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "You made it... finally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130502,
					"content": "Just tell us where you mean next time, okay!? We looked everywhere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130503,
					"content": "Hmph... So. Did you at least manage to find your wine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130504,
					"content": "Yep! Well, sort of... Jack made it out to be a rare, collectors' edition vintage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130505,
					"content": "...when actually, it's just a half bottle of regular cider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130506,
					"content": "Ah, this takes me back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130507,
					"content": "The first time I saw this view, I hadn't even taken on this form yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130508,
					"content": "...What?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "It was about twenty-six hundred years ago, before the world had come under the rule of The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130510,
					"content": "At that time, Old Mondstadt was ruled by a tyrant, who sealed off the city's perimeter with a ferocious hurricane. Even the birds couldn't get in or out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130511,
					"content": "Old Mondstadt? Oh, Paimon remembers — nowadays it's known as Stormterror's Lair, right? You mentioned it before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130512,
					"content": "That's right. The tyrant of the winds who once ruled from that tower was Decarabian, God of Storms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130513,
					"content": "Back then, I was but a wisp among the thousand winds. I wasn't a god of anything — I didn't even have a human form...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130514,
					"content": "I was just a tiny elemental being who lived in the wind, a gentle breeze bringing subtle changes for the better, or tiny seeds of hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130515,
					"content": "A tiny elemental being? Without a human form? Venti... do you mean you used to look different than you do now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130516,
					"content": "Yep. My current form is not so different from the situation with fake Stanley... I took the form of a friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130517,
					"content": "So then what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130518,
					"content": "What happened to your friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130519,
					"content": "(Same situation as with Stanley's friend...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "Say, Paimon, do you wish to hear the next part of the story?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130521,
					"content": "Yes, of course! The suspense is killing Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130522,
					"content": "Paimon, go pick us a couple of apples.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "Now's the time you suddenly get a craving for apples? Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130526,
					"content": "Hahaha, getting a little... peckish or something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130527,
					"content": "Oh, so peckish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "Huh! Paimon's had it up to here with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130529,
					"content": "Ah... You know, you're so smart it almost makes me uncomfortable sometimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130530,
					"content": "But then, maybe it's right that true friends can tell what the other is thinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130531,
					"content": "A refreshing drink, a gentle breeze... *sigh* Moments like this always take me back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130532,
					"content": "Back to a song that I first heard from him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130533,
					"content": "I'm listening.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "Paimon, could you fetch us some meat or fish?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "But Venti's telling his story! What makes you suddenly wanna have a meat feast!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}