				]
			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#Hello there, {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Miss Guillotin mentioned you've been running an aquarium. Naturally, I accepted her invitation to come serve as a marine consultant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Happy to have you on board!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Great! With Head Nurse Sigewinne around, we won't have to worry about the little fishies getting sick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Hehe, since you asked me to look after the animals at the Chevalmarin Film Fantasyland, I've picked up a few tricks of the trade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "It turns out looking after animals isn't all that different from caring for patients. Well, the well-behaved ones, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "But that's the thing — not all fish are well-behaved. So, on top of looking after the ones you already have, I have a few ideas for inpatient therapy that I'd like to discuss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Please, go ahead. I'm all ears.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "The word from Officer Ceasth is that certain wild fish have been getting unusually aggressive lately. Apparently, they're attacking other creatures, as well as divers and even small boats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "I was wondering if we could invite them to the aquarium for some rest and relaxation? At the very least, it'll keep them from causing any more trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Once they're here, I can look for a way to cure their sudden bad temper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "That way, we can help the fish and the waters return to normal, and you can add some unique guest performers to your aquarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "What a wonderful idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "You've got my full support!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Alright, I'll give you all the intel I have on where to find those aggressive fish. The rest is up to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "We're so glad for the extra help!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}