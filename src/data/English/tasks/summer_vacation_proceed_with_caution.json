						400110521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110521,
					"content": "Something has appeared. Everyone, we can take a closer look, but please be on guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
