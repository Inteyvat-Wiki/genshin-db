						400110407
					]
				},
				{
					"id": 400110407,
					"content": "Dodo-King must have placed those things in the ocean! He's a bad guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110408
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110408,
					"content": "But I will bravely face him and do my best for Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110409,
					"content": "#{F#Miss}{M#Mr.} Honorary Knight, thank you for helping me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110402,
					"content": "About summer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110403
					]
				},
				{
					"id": 400110403,
					"content": "I like summer! But not just summer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110404
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110404,
					"content": "I also like fall. Oh yes, and I also like spring and winter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110405
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110405,
