					"nextDialogs": [
						400110607
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110607,
					"content": "Ugh! What is this kid saying!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110608,
					"content": "She obviously doesn't understand what that word means...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110609
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110609,
					"content": "Hey, Dodo-King! Why are you ignoring me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110610
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110610,
					"content": "Is it because I took too long and made you angry? Then... I'm sorry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110611
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110611,
					"content": "Huh, and now she's apologizing? I didn't see that coming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110612
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110612,
					"content": "Hello! Dodo-King!",
