					"nextDialogs": [
						400110621
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110621,
					"content": "An abandoned machine... Weird! Did someone bring it here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110622,
					"content": "Oh no! Dodo-King isn't moving anymore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110623,
					"content": "Klee, maybe Dodo-King is tired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110624,
					"content": "Right, right, Dodo-King is probably asleep. He was waiting so patiently for you and then *yawn* — nap time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110625,
					"content": "Let's go with Klee to play elsewhere and come back once Dodo-King wakes up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110626,
					"content": "Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110627,
					"content": "Of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110628,
					"content": "Hm... No, I get it now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110629,
					"content": "This isn't Dodo-King. The real Dodo-King is somewhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110630,
					"content": "Huh? I—Is that right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110631,
					"content": "I won't give up. Dodo-King, just wait! We'll find you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110632,
					"content": "And there she goes again... Whew, she's got a lot of spirit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110633,
					"content": "Klee, wait for us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
