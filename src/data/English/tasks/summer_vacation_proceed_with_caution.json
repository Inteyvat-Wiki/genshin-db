			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110901,
					"content": "Have you finished your preparations?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110902,
						400110904
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110902,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110903
					]
				},
				{
					"id": 400110903,
					"content": "There is no need to rush. Take your time organizing your things. I will wait for you all here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110904,
					"content": "I'm ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110905
					]
				},
				{
					"id": 400110905,
					"content": "Great, then let's head to the <color=#00E1FFFF>boat</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
	]
}