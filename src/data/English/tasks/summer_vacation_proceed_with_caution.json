				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Jean",
					"Barbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Ahh... The weather's so nice. Still feels like Paimon's dreaming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "Good morning! Wh—Wha, what's with everyone's clothes!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "Hehe! So, how do we look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110104,
					"content": "We changed into summer clothes! Although we didn't come here to have fun, we don't want to miss out on a beautiful summer day by the sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110105,
					"content": "Th—This doesn't look weird, does it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "Such light and summery clothing definitely doesn't suit me... Ah, hehe... pardon me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "No, not at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "Really...? Thank you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "It's surprising that Master Jean would specially pack summer clothes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "Oh no, my big sister would never pack these herself. Lisa and I picked them out for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110112,
					"content": "Blurting out \"big sister\" and not even realizing it... Barbara's drunk on summer already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "There's quite a story behind these summer clothes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "I thought Lisa's pouch was to be used for an emergency. I didn't expect it to contain a set of summer clothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "All these accessories, too... Definitely Lisa's handiwork.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "Everyone in the Knights of Favonius is always trying to have me take leave. I suppose I do push myself too much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "Everyone, come over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "That's Klee's voice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "I saw something weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "Huh? What's going on? What do you mean by something weird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "Look at the ocean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "See? There's something weird floating on the water!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "That narrow device... It seems to be a buoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "But we didn't see anything when we arrived here yesterday...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110125,
					"content": "Dodo-King must have put them there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "Strange devices that just appear overnight... Something doesn't add up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "Well, since he hasn't revealed himself to us, does that mean he's changed his mind? Or maybe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "Maybe these buoys are a clue and he's waiting for me to find him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "So could that be why these buoys have suddenly appeared?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110130,
					"content": "Let's take a closer look and find out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Right, we won't solve anything by guessing on-shore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "Is it okay to go out there though?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110133,
					"content": "Perhaps, but we must investigate the buoys regardless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
					"content": "It's hard to say what will be waiting for us at sea. Just in case, prepare yourselves for combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110135,
					"content": "Once you are ready, please assemble here, and we'll head over on the boat together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110136,
					"content": "That's our Master Jean!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "N—Not at all. This is... just my duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110139,
					"content": "Now then, I'll entrust the preparation efforts to all of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110137,
					"content": "She's reliable even in summer wear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "You look marvelous!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
