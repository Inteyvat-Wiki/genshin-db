			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "What could those buoys possibly mean...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110202,
					"content": "About this archipelago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "These islands are isolated from the outside world, like a secret Domain crafted by nature itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110204,
					"content": "We were guided here by the letter and with the assistance of Venti and Dvalin... Everything seems a bit too serendipitous. I'm a little concerned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110205,
					"content": "But I'm here to protect you all, so please don't worry. Come what may, I will face it head-on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110206,
					"content": "About your summer clothes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "Ah... Su—Summer clothes, they're, uh... They were a surprise that Lisa prepared for me. My guess is that it was originally Barbara's suggestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110208,
					"content": "Barbara said that it's so rare for us to get a chance to come to an island, we should change into summer clothing to set the atmosphere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110209,
					"content": "However, I'm not used to this style of clothing. *sigh* I hope wearing this doesn't look too odd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
