					"nextDialogs": [
						400110616
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110616,
					"content": "No, I can only guess. It looks completely out of place on this island... Look at its clothes. It appears like it came from Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110617,
					"content": "Inazuma? But isn't that really far away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110618,
					"content": "So this machine isn't from around here?",
