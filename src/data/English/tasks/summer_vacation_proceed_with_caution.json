					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110501,
					"content": "Ah, what's going on here? This part of the ocean is way too mysterious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110502,
					"content": "This whole stretch of land just rose out of the water!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110503
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110503,
					"content": "Dodo-King, Dodo-King, I'm gonna catch you! Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110504,
					"content": "Looks like Klee's as energetic as ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110505,
					"content": "Before the ground started shaking, I heard the sound of machinery. I believe there may be an immense mechanical structure under this region of the ocean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110506
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110506,
					"content": "With the entire archipelago situated on a mechanical framework, it could be activated to raise each island from beneath the water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110507
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110507,
					"content": "Something like that would be nothing short of a miracle... Could it be the power of the Anemo Archon, Barbatos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110508
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110508,
					"content": "Hmm, probably not. Paimon feels like this is more likely a deliberate set-up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110509,
					"content": "It's incredible, no matter how you think of it. Using a letter to draw us here and these challenges involving various mechanisms... This so-called Dodo-King is no amateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110510,
					"content": "I agree with Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "Aw, there goes the holiday mood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110513
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110513,
					"content": "Well, either way, I will do my best to remain vigilant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110514,
					"content": "Wow! Master Jean's so cool when she's determined!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110515,
					"content": "Paimon and I will also exercise increased caution.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110516
					]
				},
				{
					"id": 400110516,
					"content": "Thank you for your understanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110517
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110517,
					"content": "I found him! It's Dodo-King!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110518,
					"content": "He's over on that island! Hee-hee, gotcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110519
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110519,
					"content": "You wanted Klee to come find you, so here Klee comes! Jumpy Dumpties, get ready~! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110520
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110520,
					"content": "Is that... <color=#00E1FFFF>a platform in the middle of the ocean</color>?",
