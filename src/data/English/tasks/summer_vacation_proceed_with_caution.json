					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110302,
						400110306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110302,
					"content": "About this archipelago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110303
					]
				},
				{
					"id": 400110303,
					"content": "I just want to say that the ocean here is beautiful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110304
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110304,
					"content": "Sea and sun — a summer dream come true!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110305
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110305,
					"content": "I really want to have a seaside performance! It would be amazing, I just know it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110306,
					"content": "About your summer clothes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110307
					]
				},
				{
					"id": 400110307,
					"content": "How do I look? Not bad, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110308
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110308,
					"content": "I wanted to surprise everyone, so I specifically chose an outfit complementing an island atmosphere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110309
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110309,
					"content": "Oh, but please don't worry! Even if I'm wearing summer clothes, I'm still just as reliable in battle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
