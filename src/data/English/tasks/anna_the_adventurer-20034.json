	"talks": [
		{
			"id": 2003401,
			"completionStepIds": [
				2003401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
