				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "Hey! Buddy! I've got some real nice stuff here, great prices too! Wanna take a look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Huh? Aren't these Koholasaur dolls? Paimon's seen them at the Easybreeze Market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "That's right! But mine're cheaper, only half the price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "How come they're so cheap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Hehe, don't worry about it, buddy. I've got my ways.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "They're cheap all right, but these colors look a bit off... These aren't knock-offs, are they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Knock-offs!? What do you know, little know-it-all? Get lost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Shoo, shoo! I'm not selling to you anymore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
