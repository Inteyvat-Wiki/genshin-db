			"dialogs": [
				{
					"id": 752650301,
					"content": "Hey! Buddy! I've got some real nice stuff here— hold on... You two again!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650302,
					"content": "I told you, I'm not selling to you! Now scram! Get out of the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650303,
					"content": "Hey! This is your last chance to apologize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650304,
					"content": "What's your problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650305,
					"content": "You're selling counterfeits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "Yeah? So what? Mind your own business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
