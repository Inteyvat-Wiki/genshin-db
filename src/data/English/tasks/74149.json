						],
						"stepId": 7414905,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7414906",
							"3"
						],
						"stepId": 7414906,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "You're done?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490502,
					"content": "That's right, Mr. Leroy. Also...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "Hmm? What is it? Want some candy? Or would you like your pocket money now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490504,
					"content": "B—Both, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Haha, what a greedy little child. Still, that's fine — that's exactly what little children should be like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490507,
					"content": "Especially little ladies as cute as you, Paimon. Macarons, pretty dresses, and lovely homes — that's what you deserve to have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490508,
					"content": "#Hehe, Paimon reckons so too! Hey, {NICKNAME}, could we get...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "Nope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "Boo! Boo! You're so stingy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "We're adventurers, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Paimon doesn't see how any of that stuff conflicts with having macarons, skirts, or big beautiful houses, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "Heh, what's with the sudden argument? Tsk, kids. But a little banter now and then is good. That just shows that you're still children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490515,
					"content": "Actually, about that, I'm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Treasure your childhood. It won't last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490518,
					"content": "...Anyway, here — candies and coins both. Now then, do behave, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490519,
					"content": "Yay, snacks! Thank you, Mr. Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Just call me Benoit, child. Leroy is my surname.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490521,
					"content": "I am the last Leroy in the entire Court of Fontaine — mentions of my family name make this poor old soul quite lonely indeed, so please, just use my name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490522,
					"content": "Mr. Le... Er, Benoit, so... Your daughter doesn't share your surname?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia isn't my daughter by blood. I took her in half a year ago. That said, she may as well be my own trueborn daughter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490524,
					"content": "If you don't mind, you can come again tomorrow — she and Athos should be back by then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490525,
					"content": "I'm sure she won't mind having two lovely children like you over for snacks, especially since you're helping us with some of the chores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490526,
					"content": "Some other children come by occasionally, so feel free to play with them, too. I love children — the more of them are around, the merrier the house is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490527,
					"content": "If you don't see me when you come over again, just knock and ask for me — Athos will open the door for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490528,
					"content": "Alrighty! We'll be back tomorrow, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "Good, good, I should be going back inside, at any rate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490530,
					"content": "See you tomorrow.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "See you then, children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490516,
					"content": "That's how you know we get along.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Don't lose sight of why we're traveling, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
