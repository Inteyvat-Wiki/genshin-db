			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200201",
							"2"
						],
						"stepId": 2200201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, how come I'm the captain again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220020102,
					"content": "Because it's way more fun when you're the captain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020103,
					"content": "Well, as long as Lulu's happy... then I'm fine with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220020104,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "We're playing a game!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng is the captain, Fei is first mate and I'm a rich merchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020107,
					"content": "All we're missing is the pirate. The pirate's supposed to come and rob us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020108,
					"content": "You can be the pirate if you wanna play with us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020109,
					"content": "...Ahoy, me hearties!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020113,
					"content": "Okay, come and let us know when you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020111,
					"content": "I wanna be one of the good guys...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "It's just a game! Don't worry, I know you're a good person in real life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Little Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200202",
							"2"
						],
						"stepId": 2200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "I'm ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Woohoo! We're starting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020203,
					"content": "You have to start.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020204,
					"content": "Avast ye! I be here to rob yer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Hah! In broad daylight? Good luck, the Millelith men are right there watching!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, come quickly! We must escape...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220020207,
					"content": "Hello Mr. Pirate. What are you here to rob?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020208,
					"content": "Er... Mora? ...Ar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "But I don't have much Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020213,
					"content": "Daddy says that on a boat, the most valuable thing is the merchants' goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020214,
					"content": "How about this. Why don't you go and find some valuable things to use in the game?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020215,
					"content": "Then we'll have goods for you to try and steal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020216,
					"content": "Hmm... Lotus Heads will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020217,
					"content": "We three all love eating Lotus Heads. If you're being a naughty pirate, the naughtiest thing you could do is steal our favorite food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020209,
					"content": "You, me pretty little lassie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Erm, even though we know it's just a game, we still need to be careful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020211,
					"content": "See? The Millelith men are all looking at us now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Little Lulu"
				}
			]
		},
		{
