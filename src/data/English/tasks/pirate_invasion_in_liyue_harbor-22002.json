			"dialogs": [
				{
					"id": 220020501,
					"content": "Found the Lotus Heads?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020502
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020502,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020503
					]
				},
				{
					"id": 220020503,
					"content": "Okay, just keep looking. Take your time... but hopefully not too much time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020504
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020504,
					"content": "We've been playing for ages, I'm getting hungry now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				}
			]
