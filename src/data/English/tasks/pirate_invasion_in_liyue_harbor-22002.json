			"dialogs": [
				{
					"id": 220020301,
					"content": "Have you found the Lotus Heads yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020302,
					"content": "Got them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng! Fei! Come and eat these Lotus Heads with me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020305,
					"content": "Hey! Paimon thought we were supposed to be robbing you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh, yeah... Well here you are, take this Mora and stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020307,
					"content": "You're really great at playing a pirate. Not everyone has what it takes to steal all this stuff from a little kid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220020308,
					"content": "Paimon has a feeling that this kid is subtly mocking us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Thanks for your help and it was fun playing with you. Please play with us again soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				}
			]
		},
