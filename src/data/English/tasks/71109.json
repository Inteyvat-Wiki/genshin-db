				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Huh? This sword seems to have something written on it. Let Paimon see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"...Caressing the blade, singing I go, to cleave dragons and drink their blood. The divine light, like flowing lightning, like a frigid wave, threatens to smash the mountains...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Ancient Swordsman's Inscriptions"
				},
				{
					"id": 711090603,
					"content": "\"...Beneath Mt. Tianheng, I slay tigers, the scaled beast I skewer amidst the Sea of Clouds... When I return crowned in success, we shall live at ease...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Ancient Swordsman's Inscriptions"
				},
				{
					"id": 711090604,
					"content": "There's also a stone tablet next to it... Eh? The handwriting below seems to be different...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"...I originally wanted to leave behind some delicacies here. But the food would inevitably spoil over time, so I left the recipes here for you to cook instead. I assure you, they shall be delicious indeed.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Ancient Engraving"
				},
				{
					"id": 711090606,
					"content": "\"...Apart from these, nothing else remains. Only this sword and the beautiful scenery.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Ancient Engraving"
				},
				{
					"id": 711090607,
					"content": "\"...When faced with a dead end, what should we do? You already know the answer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Ancient Engraving"
				},
				{
					"id": 711090608,
					"content": "\"...Do not take... treasure, leaving solely one... henceforth...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Crooked Engraving"
				},
				{
					"id": 711090609,
					"content": "May my final stand... be a monument...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Crooked Engraving"
				},
				{
					"id": 711090610,
					"content": "Whoa... These lines here are so illegible that Paimon can't understand it one bit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "They roughly mean that he didn't take anything with him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "*sob* After all this, we didn't find a single valuable treasure. All that hope for nothing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "You're telling me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Paimon never imagined that we'd be able to still see such scenery in a tight spot like this, though... It's something at least, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "It's okay. I'll make you something to eat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Huh? For real!? Then it's settled, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "I don't get them either...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
			"id": 7110925,
