							"7110722",
							"3"
						],
						"stepId": 7110722,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wen the Fourth",
					"Huang the Third"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "Sigh... To think that after a thousand years of heritage, the Guhua Clan's head doorkeeper must cheat others to survive... What shall we do, what can be done...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Wen the Fourth"
				},
				{
					"id": 711092502,
					"content": "Ugh... Alright, come on now. Am I not sparing my junior from starving to death while guarding our gates...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092503,
					"content": "#And don't look at me like that. You're always depressed... But you were pleased to see {NICKNAME}'s performance just now, weren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092504,
					"content": "That fool from before? They get to take a look around for making you some rice with bacon? And I would be pleased about that? I would slap you to death if I were a few years younger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Wen the Fourth"
				},
				{
					"id": 711092505,
					"content": "Heh! Your technique was inferior to mine just a few years ago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092506,
					"content": "...Anyway, listen... Only a few of us geezers are left. What do you plan to do after we stop testing those who may be destined to join us? Take those books with us to our graves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Wen the Fourth"
				},
				{
					"id": 711092508,
					"content": "Hah... Just forget it. What's the point of saying such depressing things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Huang the Third"
				},
				{
					"id": 711092509,
					"content": "Oh, why don't you try the food those kids made me? Hehe! I think it's better than Wanmin Restaurant's fare! Here, take a bite! Just a bite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang the Third"
				}
			]
		}
	]
}