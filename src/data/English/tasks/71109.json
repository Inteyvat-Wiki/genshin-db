			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "Whoa, who knew that such a big secret could have been hidden in this run-down Hall...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Honestly, I didn't see it coming either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Also, Paimon doesn't think Huang the Third knew about this place either... Hold on, could this be the actual \"Guhua Treasure Chamber\" recorded in the legends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#Also, {NICKNAME}, look over there! Paimon spies something glowing on that platform!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "It must be treasure!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Anyway, let's go check it out right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Could it be a... mechanism?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Maybe that's why they say you shouldn't judge a book by its cover...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "\"...The heavens are unfaithful, and those who seek its blessing and gain audience are rare. Fate is capricious, and those whose prosperity endures are few... They who are favored often find their paths barred, and worse awaits those who are not...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Engraved Inscription"
				},
				{
					"id": 711090502,
					"content": "\"...This monument was left to ask this of future generations. When you have reached a dead end, what shall you do?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Engraved Inscription"
				},
				{
					"id": 711090503,
					"content": "(Touch the stone tablet.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Leave.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
