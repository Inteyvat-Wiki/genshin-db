			"dialogs": [
				{
					"id": 733350701,
					"content": "Not bad, Sorush! You really made the area regain its vitality real quick, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350702,
					"content": "Pari powers are quite fascinating, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350703
					]
				},
				{
					"id": 733350703,
					"content": "You startle pointlessly! My powers are more than enough to easily rescue the Sunyata Flower!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350704
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350704,
					"content": "The dark corrosion expands yet, and these Sunyata Flowers are but one amongst its many victims...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350705
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350705,
					"content": "The other flower ponds have not been spared. Sefana must be in quite the fluster at this moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350706
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350706,
					"content": "This Sefana you mentioned seems like a nice Pari who works hard to take care of the flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350707,
					"content": "#Let's go help her, shall we, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350708,
					"content": "Well now, I suppose it may serve as a suitable diversion upon my great work. In that case, my Yasnapati, I bid you have a care for Sunyata Flowers of this kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350709,
					"content": "I'll tell you when I see them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350710
					]
				},
				{
					"id": 733350710,
					"content": "Yup! Let's save these pretty flowers together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
