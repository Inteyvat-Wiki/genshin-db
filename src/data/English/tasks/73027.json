			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270401,
					"content": "Phew, it's finally over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270402,
					"content": "Well, it was a long journey, wasn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270403,
					"content": "Let's tell this story to Jazari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Oh right, if he knows about the core, he can help us apply for some funding and all that stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270405,
					"content": "#But Paimon's not gonna enroll in the Akademiya or anything. You aren't planning to either, right, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270409,
					"content": "Anyway, we don't know what Marana's Avatar has to do with the Abyss Order yet, but it's a good thing that we cured the forest's illness all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270410,
					"content": "*sob* Thank you for helping Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270411,
					"content": "You're welcome, Ararycan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "So, what do you plan to do next, Ararycan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270413,
					"content": "Ararycan will celebrate Festival Utsava. But Ararycan worries about the forest's illness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270414,
					"content": "There's a chance that the bad things that made the forest sick will come back. Ararycan needs to guard the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270415,
					"content": "So Ararycan will come back here after Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270416,
					"content": "Wow, Aranara really do have tough jobs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "If you ever need any help, Ararycan, be sure to come to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270418,
					"content": "Okay, Ararycan will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270419,
					"content": "Hehe! Take care of yourself. We'll see each other soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270406,
					"content": "Let's tell this story to grandpa Royinjan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Oh yeah, and grandpa Royinjan will say, \"What an interesting story!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270408,
					"content": "Who'd know that we actually saved the forest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}