					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		},
		{
			"id": 7302702,
			"completionStepIds": [
				7302702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
