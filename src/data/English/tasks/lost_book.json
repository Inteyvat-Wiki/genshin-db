					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101011201,
					"content": "How did you find this place!? It's... so well hidden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011202
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011202,
					"content": "I have no interest in finding out where you little rascals hide yourselves away. But I do want my book back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011203,
					"content": "Tell me, how is it that you have the time to conceal your stronghold and apply a magic seal — but not to sign out a library book in the proper manner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011204,
					"content": "You have no respect whatsoever for other people's work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011205,
					"content": "...You— You just want... <color=#00E1FFFF>the book</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011206
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011206,
					"content": "I was unaware that anyone in Mondstadt was concerned with unearthing the secret hidden inside this book...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011207,
					"content": "Who... Who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011208
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011208,
					"content": "The librarian. Although, I believe that should be quite clear already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011209,
					"content": "Return the book. This is an ultimatum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011210,
					"content": "Hmph. Since you insist on concealing your identity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011211
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011211,
					"content": "I have all the less reason to give you that book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011212,
					"content": "After all, it contains... the secret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011213,
					"content": "Huh!? Wh—What are you doing!? Such concentrated elemental power! P—Please don't—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011214,
					"content": "*shrieking*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 101011215,
					"content": "Lisa is so strong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "Hmph. Naughty boys who don't do what they're told need a little punishment to keep them in line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011218,
					"content": "You didn't let him finish speaking...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "*sigh* This is why I call it troublesome work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011221,
					"content": "We'll just need to find the book ourselves. It should be around here somewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011219,
					"content": "A LITTLE punishment!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011216,
					"content": "Lisa is so terrifying...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				}
			]
		},
