			"dialogs": [
				{
					"id": 150180301,
					"content": "Hello there! Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "Oh, are you lost? Need some help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "Not lost... exactly. We're on our way to the Collective of Plenty. Is this the right direction?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Yep! That's my home tribe, actually. I can take you the rest of the way, if you want.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "Score! Another local guide! We really lucked out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "And, here, I thought that was your job...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "A guide, huh... Yeah, sure! Why not? Hehe, from now on, I'll be your guide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "There's a lot of cool scenery around here, actually. I can point it out along the way. It always leaves people in awe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Oh, that's so nice! But, um... We're not keeping you from anything, are we? You really don't have to go out of your way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Oh no, not at all! I was just doing some training, but I'm all done for the day. So, I'm heading in that direction, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "Plus, I can teach you all about the tribe. Besides, learning new things is always fun, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "As long as you're happy, I'm happy. That's how Uncle Acatl teaches us to treat our guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "A—Alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "She seems super friendly and welcoming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Yeah, we lucked out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Definitely! Paimon really likes her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "All good over there? Then, let's head out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Oh, wait! We still don't know your name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Ah, right! The name's Varesa. Nice to meet you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
