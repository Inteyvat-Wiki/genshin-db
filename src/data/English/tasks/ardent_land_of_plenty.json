			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "Ah, home sweet home! We made it! Welcome to the Collective of Plenty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Whoa, this place is so cool! That platform shaped like the head of a bull is awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Hehe, that's the Resonating Arena! It's where we hold all our competitions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Thanks for bringing us here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Don't mention it! It was no trouble at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "I wish I could show you around, but I need to get home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Oh, did you remember something important? You really hit the ground running when we ran into those hilichurls back there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Hope we didn't hold you up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Oh no, not at all! We made it in time! There's just something important I have to do... The most important thing after training — the post-workout meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Otherwise, I'll be a lethargic, dizzy, hunger-addled mess. The perils of an empty stomach... It's terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Anyway, I'm sorry, but I've gotta get some food in me... like yesterday! You should grab something, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "We can meet back up at the arena! See you soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "And, she's off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Wow, talk about whiplash... One second she's chill and laid-back, and the next she's charging head-first into danger... literally!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "It's the spirit of youth.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "The spirit of youth? Sure, whatever you say, old-timer... Paimon thinks we're still young!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Anyway, why don't we take a look around in the meantime? We can head to the arena in a little bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "The view must be amazing from up there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
