			"dialogs": [
				{
					"id": 150180201,
					"content": "Oh, we know that name! So, that's you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Well, this is {NICKNAME}, and Paimon's Paimon, {M#his}{F#her} awesome travel companion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#{NICKNAME} and Paimon... Now, that has a nice ring to it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Alright! Let's get going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
