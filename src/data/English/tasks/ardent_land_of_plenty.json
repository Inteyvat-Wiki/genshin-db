			"dialogs": [
				{
					"id": 150180401,
					"content": "Hello there! Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180403,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Wait, you're... {NICKNAME} and Paimon! I've been waiting for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "Whoa! You know us? Huh, we've really made a name for ourselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Wait, but... Did we even tell anyone we were coming to the Collective of Plenty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Oh, you didn't know? Coach Iansan said she invited you to our tribe, so I came out here to wait for you while I did some training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "And now, you're actually here... Hehe, I can't believe it! This is great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "S—Surely we're not THAT big of a deal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "You're the heroes who defeated the Abyss! You're a huge deal to everyone in Natlan! I've heard the story of \"Tum{RUBY#[S]Hope}aini!\" so many times, I can practically recite it by heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "I've been so excited to meet you ever since Coach Iansan told me you might be coming. Oh, my name's Varesa, by the way. Not sure if Coach mentioned me before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Oh yeah, the name sounds familiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "During the Abyss invasion, we asked Iansan if the Collective of Plenty needed any help, but she said that Varesa had it all under control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Which means, you must be an impressive warrior yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Not really. It was all Uncle Acatl! All I did was clear out a few monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Just thinking about the invasion gives me chills even now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "But, that's in the past. The Collective of Plenty fared pretty well, all things considered. We finished our repairs, so now it's just a matter of helping out the other tribes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Hehe, c'mon! I'll take you to our camp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Great! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "And a hero in your own right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
