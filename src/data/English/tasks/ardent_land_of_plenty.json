			"dialogs": [
				{
					"id": 150180101,
					"content": "Huh... What's this wooden plank doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180107,
					"content": "Oh, it's a piece of training equipment! I use it all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180108,
					"content": "Training equipment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180109,
					"content": "Yeah! It's kinda hard to explain... Lemme show you instead. Here goes nothin'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180103,
					"content": "And she sticks the landing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180104,
					"content": "Whoa, you jumped over that huge gap just like that? Incredible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180105,
					"content": "Oh, no, no! Anyone can do it with a bit of practice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180110,
					"content": "You made it across without any training at all. That's a lot more incredible than anything I can do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180112,
					"content": "Oh, well, Paimon can fly, but... You've got a point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1501802,
