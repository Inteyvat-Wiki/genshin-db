							2138.688,
							108.819,
							11210.57
						],
						"pointId": 13020
					}
				]
			},
			"dialogs": [
				{
					"id": 60080201,
					"content": "Oh... She doesn't look so good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "S—Sorry for disturbing you, but are you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080204,
					"content": "Has your condition worsened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "...Dizzy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080206,
					"content": "...It's like... I'm returning to the moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080207,
					"content": "Wait, it's not that bad, is it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Hmm? I... sense the moon's power... within you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080209,
					"content": "We got the Moon Marrow back from the Fatui. Can it help you in any way?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Mmm... And what do you require this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080211,
					"content": "C'mon, don't even think about that. Right now, you gotta focus on getting better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080213,
					"content": "(Has this just become habitual for her, after living in relationships of mutual benefit for so long...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "I might need your assistance in the future.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "...Oh. Very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080216,
					"content": "Give me your hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080217,
					"content": "*exhale* ...Back to earth. My thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080218,
					"content": "Uhh, your feet never left the ground... But anyway, feeling any better?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Significantly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080220,
					"content": "What did you do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "The moon within your body... it is as silent as a reflection in the water... Fascinating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080223,
					"content": "I merely drew forth a ray of its light from the water. Enough to keep me tethered to the ground for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080224,
					"content": "I think I sensed some other changes as well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "That is the \"Moon Goddess's Favor.\" All things I come into contact with will bear this mark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080226,
					"content": "It is harmless, and will fade over time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080227,
					"content": "Speaking of which, do you wanna be the Moon Marrow's custodian, now that you've got your power back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "It's supposed to be something that belongs to a \"god\" in any case, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "It is the remains of Aria, Goddess of the Eternal Moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080230,
					"content": "So it does have to do with... Wait, what!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Did you not know this already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080232,
					"content": "Lauma just said it was different from the other fragments, and that she could sense divine power within it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "And she is correct. When I drew that ray of moonlight from the Marrow, I also drew some memories from within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080234,
					"content": "That is how I know that it belongs to the Goddess of the Eternal Moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080235,
					"content": "But Lauma also saw the past by using the Moon Marrow. Why didn't she see that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma mentioned that she could only catch brief, blurry snippets... Perhaps this is something that only a Moon Goddess could sense...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "There were once three moons in the sky, each belonging to a goddess who ruled over it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080238,
					"content": "But after the war of funerary flame, all three lay slain, and two of the three moons were shattered during the conflict.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080239,
					"content": "After Aria's death, her power coalesced into this Moon Marrow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080240,
					"content": "The Iridescent Moon's remains have never been found, and while the Frost Moon's goddess died herself, her moon was never broken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080241,
					"content": "As the prophecy stated, this moon would birth a new deity sooner or later — the entity the Frostmoon Scions call the \"Kuu{RUBY#[S]Moon Maiden}tar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080242,
					"content": "I can sense that my power belongs to the Frost Moon. But it lies beyond the false sky, too distant from me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080243,
					"content": "Forget \"controlling\" it... \"Sensing\" it alone requires immense effort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080244,
					"content": "W—Wait, l—let Paimon count this up... We have the Eternal Moon's Marrow with us, no one can find the Iridescent Moon's... Does that mean you have the Frost Moon's Marrow inside you, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "No. It can only form after the moon goddess is dead. Consider it a form of energy core.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080246,
					"content": "You may as well ask if there are rocks on the moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080247,
					"content": "Oh, so you're saying that you represent the Frost Moon's power, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "Yes. Now, a god with a Gnosis is named an Archon... Since you bear the Moon Marrow, does that make you a \"Moon Goddess\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080249,
					"content": "I doubt that's the same thing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "You do not wish to become one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080251,
					"content": "That's not really the problem here! Also, why are you so eager to pass that title on to someone else!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "Anyway, never mind this \"becoming a Moon Goddess\" stuff for now. We're asking if we should return this Moon Marrow to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "I do not desire it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080254,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Nor does it desire to come to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080256,
					"content": "And... What does that mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "When I came into contact with its power, I sensed a kind of... \"rejection.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080258,
					"content": "I can only guess that this is because I, too, am a Moon Goddess. Two moons will not rise at the same time, let alone consume one another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080259,
					"content": "Guess it's stuck with me for now, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "You sure that's gonna be okay? Lauma did say that you've hidden its power well, but The Damselette sensed it just fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "And it's the Wild Hunt we're dealing with here, not some run-of-the-mill enemy. If it detects the Marrow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "The Wild Hunt? You speak of that phenomenon as if you were describing a person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080263,
					"content": "Well, it sure looks like there's a person behind it all — someone with a super clear goal, too. They've been after the Moon Marrow non-stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "That seems to ring a bell...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080265,
					"content": "Huh? Does it really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "My colleagues used to mention someone, back when I was still with the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080267,
					"content": "He hailed from Khaenri'ah, gaining Abyssal power during the Cataclysm... and he had a consuming fixation on the moons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah? Well, we don't know if the phantom we saw has anything to do with that, but the details kinda match... What was his name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "I only know what others called him — the \"Rächer of Solnari.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080270,
					"content": "One of the Five Sinners!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah... There was that title too, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080272,
					"content": "Eh!? Wait a second... Dain mentioned him, didn't he? D—Does that mean that our enemy is Rerir, one of the Five!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "If that was the case, surely he'd be stronger than this, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "I have heard that he disappeared not long after the Cataclysm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080275,
					"content": "But when I asked my colleagues where he went, they replied, \"Do you really not know?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080276,
					"content": "Why would they say that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "The tale of his final fate has it that he fell into the \"moon's reflection,\" from which there can be no return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080278,
					"content": "Wait, hold up, pause... There's just... too much information!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "I felt the same. They seemed to think that I should be the one who would know everything about the moons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080280,
					"content": "But as I said... My \"prologue\" lies beyond the false skies. I do not even remember my name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080281,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "Either way, following his departure, the Wild Hunt situation worsened drastically — and it has since become a byword for Abyssal disaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080283,
					"content": "The present phenomenon may have inherited the same title, but it far surpasses its past incarnation in both scale and lethality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080284,
					"content": "Ugh. To think that we're up against one of the infamous Five Sinners...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "That's way too much for us to handle! That incident on Starsand Shoal must've been luck, then... or maybe he wasn't giving it his all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "And even then... He still defeated Marionette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "...Or maybe, what did I do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Damselette"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Oh? What did you just say? Would you mind... repeating that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080402,
					"content": "Err... That's your... ex-colleague? So... we were on Starsand Shoal together, and she was beaten by the Wild Hunt too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080404,
					"content": "Did you just... laugh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "...No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080406,
					"content": "(She totally did!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Are you two on bad terms, or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "No... I simply imagined the put-out expression she must have worn in that moment, and found it... interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080409,
					"content": "She seemed quite shaken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Oh, she'll adjust soon enough. She's very good at that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080411,
					"content": "#Okay, anyway... We've gotten off topic. Now that we know how dangerous the guy targeting the Moon Marrow is... You sure you wanna carry it around with you, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "If Fatui intelligence is to be believed, Rerir would prevail even if all of Nod-Krai were to stand against him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080413,
					"content": "Perhaps something restricts him... if only for the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Before I decide, there's a favor I'd like to ask you, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "What do you need?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080417,
					"content": "#Do you think you'd be able to show me what happened when my {M#sister}{F#brother} and I arrived in Nod-Krai? I mean, when our spaceship first landed?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080419,
					"content": "That was quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "As I said — this, to me, is but a single ray of moonlight. Nothing to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080421,
					"content": "Give me your hand, and ready yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(This is what we saw before, only clearer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(It seems we landed safely, at least...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(A lot of time appears to have passed...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(We're still inside the spaceship. To think we were in there for so long... When did {M#Lumine}{F#Aether} get out, I wonder?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Wait. Is that... {M#Lumine}{F#Aether}!?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(But, how can that be? No one left the ship from the moment we landed... The door hasn't even been opened yet!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Where... is this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Aether}{F#Lumine}! Come on! We have to leave this place!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "What?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "H—Hey! Are you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Our spaceship... A long, long time passed after we landed...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#No one left the ship during that time, but {M#Lumine}{F#Aether}... found me from outside of it, somehow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Huh!? How would that even be possible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "I don't know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "The secrets within memories are like cookie crumbs. Take a bite, and they go everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080439,
					"content": "(There's... something seriously strange going on here. I have to get to the bottom of this.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(But as Nefer said, there'll be nothing to investigate if Nod-Krai is destroyed first...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Alright. I'll keep the Moon Marrow with me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "Uhh... Well, if you say so, Paimon can't stop you, but still... oooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Will you need my help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080445,
					"content": "Help with...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "I could help you conceal the Marrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080447,
					"content": "You could? That'd be great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "Detecting it within you is already no easy task, but I can teach you to further conceal its presence using kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080449,
					"content": "Like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080450,
					"content": "Ooh! Looks like a shield!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(This... feels so soft and gentle... just like the moonlight...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Can you sense it? Now, try to maintain it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "You learn quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080455,
					"content": "Huh. Looks pretty sturdy. Could probably be used in self-defense in a pinch, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Thanks for teaching me that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Are you always here, Columbina? It's kinda dangerous out there, sure, but have you, like, taken a walk outside or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "...I ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080459,
					"content": "...Dislike strangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080460,
					"content": "And where do we rate on that scale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Slightly better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080462,
					"content": "Once this whole business with the Wild Hunt is over...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Yeah! The Frostmoon Scions have changed since you last saw them. Who knows, you might actually like 'em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080466,
					"content": "I will consider it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080467,
					"content": "She seems kinda tired...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Probably hasn't spoken this much in a while...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "Either way, thanks for agreeing to help us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "...It wasn't much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080471,
					"content": "The flowers here... They like guests like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60080463,
					"content": "Let's go out for a walk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}