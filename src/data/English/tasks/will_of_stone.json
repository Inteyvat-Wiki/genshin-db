			"trigger": {
				"objectNames": [
					"Granny Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150601,
					"content": "That Jiayi, too. How could he just cancel on his daughter like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150602,
					"content": "She doesn't see him any more than a few times a year. Is this how a father should behave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150603,
					"content": "He's doing this for Liyue Harbor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "That's what he says every year. I've lost count of the number of times he's said that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150605,
					"content": "He's just doing his job...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Well, it's also his job to take care of his daughter. Little Liu is growing up day by day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150607,
					"content": "If he's not careful, she'll be the one going out to work by the time he returns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150608,
					"content": "This father and his daughter just can't get together, can they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				}
			]
		},
		{
			"id": 7081507,
			"completionStepIds": [
				7081505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
