			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "Are you here to catch me and take me back to Qingce Village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150702,
					"content": "Granny Ruoxin is worried sick about you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Hmph. So you are here to catch me. Well, I'm not going back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150706,
					"content": "Go back and tell the villagers that I'm going to Liyue Harbor to look for Daddy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150707,
					"content": "They don't have to worry. Once I find him, I'll just talk to him for a while, then I'll come back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150704,
					"content": "I have something for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "I don't need anything from you. You're just trying to bribe me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Little Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "What are you following me for, anyway? I said, I'm going to Liyue Harbor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150802,
					"content": "I'll get around these monsters myself. They won't find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150803,
					"content": "Don't treat me like a kid! I'm a grown-up now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150804,
					"content": "This is from your father...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "From Daddy? Did he ask you to send it over...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150806,
					"content": "I'm sure it's more things for children to play with... if it's not kites, it's dolls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150807,
					"content": "You don't like them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "...I do. It's something Daddy gave me. How could I not like it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150809,
					"content": "But if I always like these things, doesn't that mean that I'll always be a kid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150810,
					"content": "If I keep playing with them, when will I become an adventurer, or get my own Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150811,
					"content": "What did you want a Vision for, again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "If I had a Vision, I'd be able to do so many things, whether it be making money or something else...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150813,
					"content": "Then, Daddy wouldn't have to work in Liyue Harbor all the time. He could come back and spend time with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150814,
					"content": "Right now, I can't even go to Liyue Harbor myself without a Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150815,
					"content": "But since Daddy has already sent you here with his presents, I might just be giving him more trouble by going to look for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>I had presents ready for him too</color>. I wanted to give him a surprise... But I can't take them to him now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>If only someone could help me do that</color>... It's alright. I'm going back. There's no need to follow me, I know the way home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Liu"
				}
			]
		},
		{
