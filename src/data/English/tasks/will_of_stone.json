				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "*sigh* I was counting down the days before I'd be able to go back. Just two or three days more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "With all the leave I've saved up until this point, I could have spent over a week together with Little Liu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "But with but one order, all our leaves were canceled. Even the people on leave were recalled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "In my experience, this means at least another month without any hope of returning to Qingce Village. What terrible luck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081502",
							"2"
						],
						"stepId": 7081502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Granny Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Oh, where has that child run off to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Can I ask about Little Liu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Are you looking for her? *sigh* What perfectly terrible timing. I don't know where's she's gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150504,
					"content": "She received a letter that her father asked someone to send over from Liyue Harbor that stated that he'd be back soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150505,
					"content": "Little Liu was so happy. She said she wanted to prepare a gift for her father, and roped some other children into picking fruits and flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150506,
					"content": "But a few days afterward, he sent word, saying that he had a last-minute assignment and wouldn't be able to return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150507,
					"content": "She threw a tantrum, and nothing we said could dissuade her from insisting that she would go to Liyue Harbor herself, since her father wasn't coming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150508,
					"content": "We thought it a joke for a while. But this morning, she was gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150509,
					"content": "*sigh* We've already sent people out to look for her, but if you're willing, you can join in as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150510,
					"content": "I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "I apologize for the trouble. *sigh* This child...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Where do you think she's headed?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "I doubt she could go far. She's probably still close by, but the wilds are a dangerous place... Please, find her quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				}
			]
		},
		{
			"id": 7081506,
