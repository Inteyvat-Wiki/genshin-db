			"dialogs": [
				{
					"id": 747070101,
					"content": "...Alright, that was great! Let's just do one more take.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Good. Aaaand... cut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Oh, plus Columbina and Chiori too! You're still here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Mmhmm! We just wrapped up filming our B-roll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Ohh! You mean the fishie acting stuff you were doing? How did it all go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Thanks to your help, we found a suitable actor for the role. The shoot went very smoothly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "You two have a real talent for this whole aquarium thing. Furina was just telling us how you've even inspired her to shoot an underwater documentary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "You're too kind!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "I like it too. I can sense how content the little fish are, swimming around. You've done a great job taking care of their needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 747070111,
					"content": "I just wish this aquarium could stay here forever. That way, I'd be able to come and visit whenever I wanted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "If you're going to miss it so much, why not add a few more scenic shots to the film?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "You're right. We should totally shoot some more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Some more fish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 747070115,
					"content": "Some more shots! Come on now, lights, kamera... Where's my script supervisor? Everyone, take your positions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Paimon's ready! But calling out takes for fish actors is... definitely a new experience, that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "We're so happy you like it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}