			"dialogs": [
				{
					"id": 225001001,
					"content": "Mint Essential Oil, you got it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001002,
						225001006
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001002,
					"content": "How do I make it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001003
					]
				},
				{
					"id": 225001003,
					"content": "We did it together not long ago, you don't remember? Huh, so you're just as quick to forget as you are to get involved in the first place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001004
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001004,
					"content": "Let me give you a recap then. Go fetch three leaves of Mint, then extract the essential oil at a Crafting Bench.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001005
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001005,
					"content": "Bring the essential oil to me, and I will take it from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001006,
					"content": "What uses does Mint Essential Oil have?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001007
					]
				},
				{
					"id": 225001007,
					"content": "How to put this... it neutralizes some of the more stimulating elements in the concoction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001008
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001008,
					"content": "But more importantly, the scent is a good match for a child like Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001009
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001009,
					"content": "A girl's scent is far more than a purely nasal affair...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001010
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001010,
					"content": "This perfume must capture Lulu's youthful lust for life, her wide-eyed innocence... *giggle*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
