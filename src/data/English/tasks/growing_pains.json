			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "Well hello again. Missing me already, huh? What are you here for this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "To pick something up for Little Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Little Lulu? ...Oh yes, that's right. She asked me to make some perfume for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "But I'm afraid this isn't the best time... For some reason, since you were last here, my sweet-smelling side services have been in exceptionally high demand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "I've had an enormous number of orders. It's far too many for me to handle alone, especially since I also have the shop to attend to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "On top of that, Lulu's just a child. It would be a little inappropriate to give her the same type of perfume worn by adult women.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "So I was racking my brains trying to think of a way to make my perfume more child-friendly. I've now decided on a suitable formula, but I haven't got around to making it yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "If it absolutely can't wait, expediting it would not be impossible, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
			"id": 2250003,
			"completionStepIds": [
				2250002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
