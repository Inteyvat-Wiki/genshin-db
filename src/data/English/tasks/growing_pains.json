					"Little Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "When will it be ready?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000102,
					"content": "No playtime today?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "Oh, hello! No, playtime doesn't seem to come at all these days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000104,
					"content": "Little Meng's in a bad mood and prefers to sulk by himself, and Little Fei keeps disappearing all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000105,
					"content": "I asked Little Meng what's wrong, but he wouldn't tell me. They're both acting so strange these days, I honestly don't know what's gotten into them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000106,
					"content": "Welcome to the grown-up world, kiddo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Wait, so when you grow up you stop being happy? Then why do Little Meng and Little Fei want to grow up so bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000108,
					"content": "I guess I'll just not grow up, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000109,
					"content": "Anyway, we're getting sidetracked. I actually need your help with something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000112,
					"content": "Can you fetch something from Ying'er's place for me? We already talked about it, so she should have it ready by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000113,
					"content": "My pleasure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "Yay! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000115,
					"content": "Ying'er's place, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "I don't know what you're thinking about, but it's not that. I just asked Ying'er to make something for me. And she said she would.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000117,
					"content": "And now I'm asking you very nicely to help collect it for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000110,
					"content": "Are you unhappy, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Me? No, I'm okay. But... I do need your help with something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Little Lulu"
				}
			]
		},
		{
