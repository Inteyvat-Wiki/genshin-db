			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "How does 3,000 Mora sound?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Wow, someone's desperate... Alright then, I will prioritize Lulu's perfume for the sake of our friendship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "I have to watch the shop during the day, though. My personal affairs are best dealt with at night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Swing by tonight and I'll have everything ready for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
			"id": 2250004,
			"completionStepIds": [
				2250002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000401,
					"content": "I can help out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Not a bad idea. You do have some experience in these matters, after all. Well, you certainly impressed me last time you were here. *giggle*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000403,
					"content": "As it happens, I have some of the necessary ingredients on hand. I'll go set up in Chef Mao's kitchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Go pick three leaves of Mint, then extract the essential oil at a Crafting Bench. I'm sure you're still intimately acquainted with the technique?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000405,
					"content": "Bring the Mint Essential Oil to me, I'll handle the rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
