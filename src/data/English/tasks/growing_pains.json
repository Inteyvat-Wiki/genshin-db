					"Little Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000601,
					"content": "Hi, did you get my perfume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000602,
					"content": "I did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "Thank you! Ying'er makes the best perfume ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000604,
					"content": "I wonder what Little Meng and Little Fei will do when they smell it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000605,
					"content": "I think that however they react, it will be a lot of fun to watch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000606,
					"content": "They're going to love it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "Hope so. That would be the best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000610,
					"content": "Thanks for helping me. I'll go home soon and have a go of my new perfume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000611,
					"content": "If it's good, then I can keep using it again and again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000608,
