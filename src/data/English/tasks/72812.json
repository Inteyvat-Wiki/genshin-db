			"dialogs": [
				{
					"id": 728120201,
					"content": "Alright, that's a wrap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "I've... never been this tired. Was this story always that complicated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "That's what you get when you don't decide on things early. Without narrative devices to restrain you, the various elements just clash wildly against each other.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "When that happens, you'll end up losing control over the plot altogether. You'd exhaust yourself no matter what you were writing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "*sigh* Alright, alright... I've got no strength left to argue with you. Traveler, thanks for your... judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "I think I've gained a lot from this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Take this as a token of my thanks. I'll get to writing again shortly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Hmm, narrative devices or narrative... Which is more important?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		}
	]
