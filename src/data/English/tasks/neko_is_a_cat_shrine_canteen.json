			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "This is... quite incredible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140102,
					"content": "Is the stone carving done?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "When we began, that stone did not look a thing like me. But with each passing glance, it becomes more and more so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140104,
					"content": "You humans really are incredible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140105,
					"content": "It is very noisy, yes, but I am the provisional head priestess. Such trivial matters are not worth complaining about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140106,
					"content": "Bring these fish to that tall human.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140107,
					"content": "They are good things, and may be considered his... \"celery.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140108,
					"content": "Just fish?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Meow, I did get Konbumaru to lead those children to try to catch some finches, but it did not turn out very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140110,
					"content": "For them, catching fish is still simpler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140111,
					"content": "It's \"salary.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Meow meow meow, how bothersome of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140113,
					"content": "Just give them to him — they are good things, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "Well, this certainly looks the part now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140202,
					"content": "Haha, it's you. Do you think it looks a bit more like the Lady Priestess now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140203,
					"content": "It sure does.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "Right? Ah, I spent a few days burning the midnight oil on this, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140207,
					"content": "Ah, I'm pretty hungry, I think... Time to go look for something to eat again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140208,
					"content": "Neko sends you some fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "Hmm, well, the Lady Priestess has my thanks, but uh... I think I'll look for food on my own...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140210,
					"content": "I've eaten fish for several straight days now. I don't think I could eat any more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140211,
					"content": "I've been heading out to forage for food. When I'm lucky, I can grab a finch or a pigeon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140212,
					"content": "*sigh* But what I'd like to have is some meat, you know? Some firm, juicy meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140213,
					"content": "So, uh, Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140214,
					"content": "If you don't mind, could you get me three servings of Raw Meat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140215,
					"content": "I'm no good at hunting, so I haven't been able to get any meat these past few days... So please, give me a hand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140216,
					"content": "Alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "Please help me out. Just three servings will do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140217,
					"content": "Did you think of going back to Narukami Island to have a meal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "Well, it's really far away, for one thing. And for another... I was just getting the hang of this carving. If I'd left at this point, the journey might have deprived me of that \"feeling,\" see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140219,
					"content": "I'd prefer to eat a quick meal here before continuing to carve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140205,
					"content": "It's a lot larger, that's for sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "Well, of course. The Lady Priestess is quite a bit larger than your average cat, but if you want a more majestic statue, then it's got to be even larger still. This is a shrine statue, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
