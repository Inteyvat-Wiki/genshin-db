			"dialogs": [
				{
					"id": 722140301,
					"content": "How did it go? Were you able to get the Raw Meat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221404,
			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Ooh... the marbling... Thank you both so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "I'll whip up a few good dishes in just a moment. With any luck, I might even finish my carving faster after eating, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "What do the two have in common, again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Eating some good meat gives you the strength to keep going! It just wasn't the same with those fish. I couldn't help but feel like my hands were too weak for the work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Honestly, I was starting to get worried that I might take longer than expected to finish the whole statue. Well, that's not a problem now, thanks to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "I mean, I am being employed by a... cat, sure, but one should always avoid asking for extensions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "Whatever the case, I'll get this one done as soon as I can... Come to think of it, the Lady Priestess said that once the statue is completed, something good will happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "I'm not sure what that means exactly, but well... I'm quite looking forward to it, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Come back in a while and have a look at the final product.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
}