					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690102,
					"content": "I am in charge of the trial of \"insight.\" Go forth and solve all the puzzles to return the Flames of the High Gate to their respective places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "The battlefield is ever-changing. Only by keeping your eyes and ears wide open at all times may you grasp the situation and master all these variables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				}
			]
		},
