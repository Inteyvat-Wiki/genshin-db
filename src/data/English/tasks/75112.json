					"nextDialogs": [
						751120905
					],
					"speakerTitle": "Avuia",
					"speakerSubtitle": "Master Trainer, \"People of the Springs\""
				},
				{
					"id": 751120905,
					"content": "What about you? Wanna try joining in?",
