			"dialogs": [
				{
					"id": 3081101,
					"content": "Hey cutie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081102,
					"content": "You're going to help me out too? How kind of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081103,
					"content": "Don't hesitate to come to me if you need anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081104,
					"content": "What kind of things does a librarian do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "Good question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081106,
					"content": "Basically, things other than that which require brawn... or brains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081107,
					"content": "So... what does that leave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081111,
					"content": "So you should as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081108,
					"content": "Why would a librarian be at the ruins...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "Hmm... Good question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081110,
					"content": "Well, because Jean trusts me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
