						"rawParams": [
							"30802",
							"2"
						],
						"stepId": 30802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "Even standing out here, the disturbance of the elemental flow inside is making me uncomfortable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Let's get this temple back to its normal state, so I can be a little less... tense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 30814,
			"completionStepIds": [
				30814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
