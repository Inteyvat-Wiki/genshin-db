			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "Dragon of the East, Lion of the South, Wolf of the North, Falcon of the West...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081402,
					"content": "They are the Four Winds of Mondstadt, affiliated with Barbatos, the God of Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081403,
					"content": "The Dragon of the East, Stormterror — its real name, is Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081404,
					"content": "Though most in Mondstadt seem to have forgotten that in all this \"Stormterror\" business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081405,
					"content": "So now you know why Dvalin is only able to channel three of the Four Winds' power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081406,
					"content": "Because it has been consuming itself from the beginning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081407,
					"content": "Why?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "Because of hatred, I presume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081410,
					"content": "Hatred...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081411,
					"content": "Hatred for Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081412,
					"content": "Hatred drove it to become something more powerful than the wind itself — to become Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081413,
					"content": "But why would one of The Four Winds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081414,
					"content": "Hate the city it was supposed to protect?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081416,
					"content": "As a child of Mondstadt, it's something that's really hard to say aloud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081417,
					"content": "Here, take this. It's a very old story from more than a century ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081408,
					"content": "Why would it go to such lengths?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
}