			"dialogs": [
				{
					"id": 761060101,
					"content": "Hmm? You look kind of unfamiliar. You're new around here, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "...Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "I'm saying this for your own good — don't go poking around the Design Bureau, especially not the second floor! Too much kuuvahki exposure can cause anything from headaches to full-on nausea. Don't say I didn't warn you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Of course! Everyone who works in there gets an extra serving of Apple Cider. Think about it — if it weren't bad for your health, why would they bribe people with something that good?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "Besides, I saw it with my own eyes in the Frostmoon Scions' territory! Their priestesses grew horns — on their heads! You seriously think that's normal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "I see... Thanks for the warning.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "That's awful! W—Will we turn into monsters too...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "*sigh* They always send the newbies in to do the risky stuff... Just be careful, and don't stay in there too long, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "Is this all the mighty Fatui are capable of?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "Tsk, is \"way too sassy\" part of our recruitment profile nowadays...? Wait a sec — you're not one of the new recruits we just brought in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "Thought you could infiltrate, did you? Too bad, I've seen right through you! Seize them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610605,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
