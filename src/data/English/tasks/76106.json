				"points": []
			},
			"dialogs": [
				{
					"id": 761060601,
					"content": "I told you not to stay in there for too long! Why are you still running around like that? Aren't you even a little worried about the side effects from all that kuuvahki exposure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
