			"dialogs": [
				{
					"id": 761060701,
					"content": "Not at all. I'm not as weak as you are.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060702
					]
				},
				{
					"id": 761060702,
					"content": "Huh!? Is \"way too sassy\" part of our recruitment profile nowadays...? W—Wait a sec — you're not one of the new batch of newbies! Y—You must be a spy! Everyone, seize them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
