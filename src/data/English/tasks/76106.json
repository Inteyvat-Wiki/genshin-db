					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060501,
					"content": "I'm your long-time nemesis! Pleased to make your acquaintance!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060502
					]
				},
				{
					"id": 761060502,
					"content": "Agh, it's an enemy assault... All units — attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
