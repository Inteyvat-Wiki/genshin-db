			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "Hello there, Traveler. How have things been?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210102,
					"content": "Has something strange happened again, Katheryne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210103,
					"content": "Compared to previous major incidents, this one is not the most peculiar. However, it is still quite serious, as it risks having a great impact on Mondstadt's economy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210104,
					"content": "What's the matter, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "Recently, the bodies of water near the winery have turned bitter without any warning. If this persists, Mondstadt's wine industry may be wiped out in just a few years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210107,
					"content": "For more details, please speak with Connor at the winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210105,
					"content": "Mondstadt's economy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "Are you the people sent by the Adventurers' Guild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210202,
					"content": "That's us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210203,
					"content": "Well, that's a relief. Now, as for the matter at hand — rather than listening to me explain it, you may as well experience it for yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210204,
					"content": "This is a bottle of water that we drew just recently. It is hygienic, don't worry — we've put it through its purification paces. Have a taste and see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210205,
					"content": "Oh, oh, Paimon wants some too, Paimon wants a try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210206,
					"content": "(Let's take a sip...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "Ugh! Blergh! It's so bitter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210208,
					"content": "This bitterness cannot be removed via conventional purification processes, so it's not an issue of the water's composition. I suspect it must be some mysterious elemental phenomenon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210209,
					"content": "As such, this water can't be used to make wine at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210210,
					"content": "That must've been tough for the nearby fish as well, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210211,
					"content": "We tried cooking some of the fish killed by the bitter water. All the food we made turned out bitter, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210212,
					"content": "Paimon... hadn't quite thought that far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210213,
					"content": "Anyway, that's the situation. If you're looking for somewhere to start, my gut tells me you should investigate northward. Additionally, I wonder if Liyue's Bishui River or the waters of Qingce Village have been affected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142105",
