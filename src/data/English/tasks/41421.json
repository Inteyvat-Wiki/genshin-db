			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "Water here... sweet. Endora finds... same species.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210602,
					"content": "Endora and... same species, make the water sweet. Bitterness... Rhodeia's doing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210603,
					"content": "Same species? Oh, that's right, doesn't Springvale have a legend of a spring fairy or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210604,
					"content": "But first things first, let's get rid of the bitter water from our bottle and refill it from the spring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
