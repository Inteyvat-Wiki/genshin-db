			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "Look, there was something inside it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210502,
					"content": "Endora... no water... dying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210503,
					"content": "Endora... Is that your name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210504,
					"content": "Bitterness... an enemy. It will kill... Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210505,
					"content": "Well, um, so what can we do to save you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210506,
					"content": "Need... sweet water. Must go to... spring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210507,
					"content": "Endora... need water to move. No water. Nowhere to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210508,
					"content": "How are we going to get this thing to a spring?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210509,
					"content": "Well, we've got a bottle right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "But it's bitter too, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210511,
					"content": "Endora... can endure. But... not for long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210512,
					"content": "Guess we can't afford to hang around, then. Let's get to a fresh spring, and quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210513,
					"content": "Still, it's kinda interesting how Endora was able to make it this far off the back of a Hydro Slime. Kinda like our relationship, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
