							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Old Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "...Who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210702,
					"content": "Whoa, hang on a moment, Endora, you can't just run out by yourself like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210703,
					"content": "I am Endora. I am a Lochfolk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210704,
					"content": "Wait, that's right! This guy is supposed to be one of the real believers in the spring fairy's existence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210705,
					"content": "...Mm-hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210706,
					"content": "You're the spitting image of her. Just a fair bit smaller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210707,
					"content": "Endora... still small! Endora... still learning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210708,
					"content": "Well, your appearance proves to me that she was real. It wasn't just a dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210709,
					"content": "She is still here. Name... unknown. She will not answer Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210710,
					"content": "Endora... wants to talk to her. Can take a message. What do you want to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210711,
					"content": "You're saying she's been here all this time? And you can give her a message for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210712,
					"content": "Yes. Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210713,
					"content": "...Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210714,
					"content": "I'm so old now, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210715,
					"content": "...Tell her I said hello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Old Finch"
				}
			]
		},
