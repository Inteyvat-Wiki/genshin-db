			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210801,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210802,
					"content": "She said some... strange things. Endora does not understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210803,
					"content": "The stream... hmm... I did not understand. Asked, received no reply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210804,
					"content": "Perhaps your vocabulary could use a little more breadth.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "Guess the spring fairy must have her reasons for not wanting to meet us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210806,
					"content": "I do not... understand. Lochfolk like to join together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210807,
					"content": "She is... one mind. All alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210808,
					"content": "Maybe it's because other creatures can't fit in with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210809,
					"content": "Oh? Why not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "Well, we'd drown for starters!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "You are lonely... We love all... We love all people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "Eh? What's going on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Rhodeia's gaze... near the Stone Gate! Small water animals. Her scouts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "Water animals? We saw some Oceanid Creatures 'round here once, didn't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Yes, I think so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Powerful water... changes shape into animals. Very dangerous. But joining with them... we learn new things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Take me there. Rhodeia is uneasy. Rhodeia... makes water bitter. Endora will learn to speak. Explain to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "So you're saying that you can help us, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Yes. Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#Well, {NICKNAME}, it's worth a shot. We don't have any other clues, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "Really? I don't remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
