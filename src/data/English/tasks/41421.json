			},
			"dialogs": [
				{
					"id": 414211001,
					"content": "I have found something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211002
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211002,
					"content": "Whoa, you're speaking fluently all of a sudden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414211003,
					"content": "My grasp of language has expanded from merging with those Oceanid Creatures. I can now comprehend the message from Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211004,
					"content": "\"The stream of life flows on.\" It's a little melancholic. A short but enigmatic poem. I don't understand it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211005,
					"content": "Maybe you'll figure it out in the future.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "Endora still has much to learn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211007,
					"content": "Rhodeia has been going wild lately. I must face her, and perhaps we can solve the problem that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
			]
		},
