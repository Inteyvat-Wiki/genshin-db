			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270101,
					"content": "Hello there, warrior from a foreign land!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270102,
						727270104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270102,
					"content": "We meet again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270103
					]
				},
				{
					"id": 727270103,
					"content": "Indeed we meet again! You cut as dazzling a figure as ever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270106,
					"content": "...Ahem, point is, it would seem that some people have been secretly organizing another Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270107,
						727270112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270107,
					"content": "What is this Hyakunin Ikki again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270108
					]
				},
				{
					"id": 727270108,
					"content": "Hyakunin Ikki was originally a festival organized by the Tengu-kin to celebrate memorable events or make peace with loss through a good old-fashioned brawl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270109,
					"content": "During the festival, be it warriors or monsters, everyone can cast aside their preconceived notions with no questions asked about their origins in a pure, hot-blooded free-for-all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270110,
					"content": "They say that warriors who emerge from the festival victorious can also win all kinds of treasures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270111,
					"content": "...That said, since the crack-down on the Tengu-kin, I'm not too sure who's organizing the festival this time or where the rewards will come from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270115,
					"content": "Anyway, it's too crowded here to be discussing this sort of thing. As always, please come with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270116,
					"content": "Kayabuki Ikkei takes you to a small island outside Inazuma City...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727270112,
					"content": "...There's another one?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270113
					]
				},
				{
					"id": 727270113,
					"content": "That's right. Perhaps your valor in battle has attracted even more people. To be honest, the audience got so fired up that they looked like they wanted to get in the ring themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270114
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270114,
					"content": "To be honest, I never thought the next Hyakunin Ikki would be so soon either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270104,
					"content": "You are...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270105
					]
				},
				{
					"id": 727270105,
					"content": "Huh? You don't remember me? Ah, sorry, perhaps I was so busy recording your heroics in battle during the last Hyakunin Ikki that I didn't cheer loudly enough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7272702,
			"completionStepIds": [
				7272702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7272702",
							"2"
						],
						"stepId": 7272702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270201,
					"content": "Here we are. This is the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270202,
					"content": "Same rules as always: Once you enter this rather suspicious-seeming door, you'll be in the tournament venue for this round of Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270203,
						727270204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270203,
					"content": "...It's looking as suspicious as always.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270207
					]
				},
				{
					"id": 727270207,
					"content": "Anyway, I'll be recording your heroics and cheering for you at the top of my lungs this time, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270208,
						727270209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270208,
					"content": "Great. I'm getting fired up already.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270210,
					"content": "Well, I hope I'll get to see your flashy swordplay this time as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270209,
					"content": "This is always such a pain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270204,
					"content": "What are the rules of Hyakunin Ikki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270205
					]
				},
				{
					"id": 727270205,
					"content": "The rules probably have not changed much. Monsters, adventurers, and warriors from across Teyvat, who share a common yearning for battle, will quench their thirst on this festival stage through passionate combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270206,
					"content": "And of course, just like last time, feel free to bring your friends and companions! After all, the \"Hyakunin\" in \"Hyakunin Ikki\" means that the more people you bring, the merrier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270207
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		}
	]
}