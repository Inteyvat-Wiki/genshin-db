			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "Perfect, it looks like I'm all set...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460102,
					"content": "Put your back into it, Jala! You'll round 'em all up in a few days!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460103,
					"content": "R—Round up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "Eek! A poacher in Fontaine... Does animal trafficking make so much money nowadays?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460106,
					"content": "Not on Paimon's watch! You're coming to the Maison Gardiennage with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460107,
					"content": "...Huh. It's you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460108,
					"content": "Well, sure. I just came from the Maison, in fact. Need me to show you the way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460110,
					"content": "Good. I like straightforward people!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "Wait, something's not right... You're not scared by the thought of being arrested at all. You must be a regular offender... Or maybe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460114,
					"content": "I could be standing on the right side of the law, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460115,
					"content": "More accurately, the Maison has hired me as a special environmental protection consultant — an \"Unchained Hunter.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460116,
					"content": "Specifically, I'm hunting invasive species of fish that have made their way into Fontaine's waters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460117,
					"content": "Invasive... species?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460118,
					"content": "That sounds familiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "Right! Paimon thinks we heard about something like that back in Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460122,
					"content": "Well, let's not dwell on the past. What matters is the here and now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460123,
					"content": "These invasive species were let loose by some merchants who hold strange beliefs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460124,
					"content": "Some of the fish are extremely aggressive, others reproduce incredibly fast, and others were raised on special feed. All told, they're a huge problem for all the local aquatic life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460125,
					"content": "If these fish occupy the habitats of local creatures and mess up the ecosystem, Fontaine's water quality might be affected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460126,
					"content": "The impact on Fontainians' health might be something we'd only feel in the future. But the flavor of a drink like Fonta could change instantly, and that'll spell untold trouble for the economy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460127,
					"content": "Fonta shall not fall! Not today!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "All this understatement makes the problem sound worse! We can't just sit back and do nothing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460130,
					"content": "Now, we're old hands at catching fish, so why don't we help you out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460131,
					"content": "Yes! I've been waiting for you to say that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460132,
					"content": "I've already set up a capture zone into which we can lure all those invasive fish using bait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460133,
					"content": "So it's time to strut your stuff, Honorary Knight and Helper in White! As for me, I'll support you from the rear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460134,
					"content": "Is it just Paimon, or does she... understand us really well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460128,
					"content": "I don't really drink Fonta, but I understand its importance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "What's that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "Paimon's memory is fuzzy, but we heard about something like that in Mondstadt ages ago, she's sure of it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460112,
					"content": "Maybe... there's been a misunderstanding?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "True. She's not scared by the thought of being arrested at all. She must be a regular offender... Or maybe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460104,
					"content": "A p—poacher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}