	"talks": [
		{
			"id": 48101,
			"completionStepIds": [
				48101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48101",
							"2"
						],
						"stepId": 48101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Pretty good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "I keep getting carried away and gliding too high.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#Hey {NICKNAME}! I've been looking for you everywhere! How's that wind glider I gave you last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Seems like it's really growing on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "But then again, you don't have a gliding license, do you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "A gliding license? Hmm... What's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Isn't it obvious? You gotta have a gliding license to legally glide in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Oh... but {NICKNAME} and Paimon have been gliding for ages now. This is the first we've heard about it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Yeah, you've been gliding all over the place... Everyone's noticed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "Eh-he.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "Sooo... You came looking for us because you wanna give us a gliding license?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "No way! The Knights of Favonius have strict rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "You need to pass an exam, and only then will the Knights issue your license.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#Today I'm here as an examiner, to oversee {NICKNAME}'s official gliding exam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "I gave you your wind glider, so this is my responsibility — at least, that's what Acting Grand Master Jean would say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "...Maybe you can cut me some slack?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "It's fine. I can do this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "An exam! What a pain in the butt. Then again, since Amber is the examiner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "No with a capital N-O! Do not challenge the authority of examiner Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#I'm sure {NICKNAME} will glide through it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "I mean... The whole city saw how well you flew the day that Stormterror attacked, so I'm sure you'll have no problems!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "But we do need to respect the rules and glide properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "Here. Take this gliding manual. No need to memorize it, just be familiar with everything in there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "For example: only one person per wind glider, no carrying anything over the set weight limit, no taking off using an Anemo Slime, and so on and so forth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Anyway, be sure to read it, okay? I had to read a load of big, thick books too when Lisa was teaching me magic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Wow, that's a big old book... Paimon thinks we best get started!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Great. Come find me when you're done, I'll be at Windrise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "*sigh* The Knights of Favonius gliding manual does NOT sound like a fun read...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Well, guess I'd better get started.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "It reads like a fairytale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "People in Mondstadt really understand the romance in learning to glide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Hmm... That's a cool story... But is the Knights' gliding manual really written in that style?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Huh. Anyway, let's go find Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}