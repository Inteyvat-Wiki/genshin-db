			"dialogs": [
				{
					"id": 140340101,
					"content": "Finally, you arrive at the chu{RUBY#[D]Basement}rch Florian described.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Played by Clorinde"
				},
				{
					"id": 140340102,
					"content": "As you approach, an ominous aura surrounds you. You get the sense that your enemy is close at hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Played by Clorinde"
				},
				{
					"id": 140340103,
					"content": "(How strange... This uneasy feeling seems so real. How did they manage that?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Now... it is time for the final battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Played by Clorinde"
				},
				{
					"id": 140340105,
					"content": "Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Marechaussee Hunter"
				},
				{
					"id": 140340106,
					"content": "Florian, wait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "I think you should wait outside. You've already been corrupted by the Devorator once. It could easily re-enter your mind and take control of your body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "I don't think it's a good idea for you to be this close. If it corrupts you again, it's possible you might take on a new form entirely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "That's exactly why I have to go... why I should be at the very front.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "...! You mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Yes, I intend to lure it into my body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "That's too risky. If things get out of hand, I might have to kill you. Do you understand how dangerous this is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "I understand. But if I do this, you'll have a clear and visible target.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "The Devorator will have a hard time passing up the chance to enter a body it knows how to control. You won't have to worry about any of your friends being taken over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "You're not like me, Miss Clorinde. You're a just and powerful Marechaussee Hunter. This monster broke free due to my error. It's only right that I shoulder the responsibility for its destruction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "This is... something that I have to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Consider it a duel to restore my honor. My only request is that you give it your all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "...I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Then, as a Champion Duelist, I hereby accept your request for a duel, and extend to you my most sincere regards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "...Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "The battle is now upon us. Let the Devorator once again tremble under the blade of the Marechaussee Hunters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
