				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4652001,
					"content": "Now that I have the information I need, I must prepare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4652002
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4652002,
					"content": "I would be grateful if you could keep me updated on how the Knights of Favonius respond to this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4652003
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4652003,
					"content": "Yes, Master Diluc sir! Anything you say, Master Diluc sir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4652004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4652004,
					"content": "...Why are you acting so strange all of a sudden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4652005
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4652005,
					"content": "In... in light of what just went down here a moment ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4652006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4652006,
					"content": "Master Diluc has officially reached No. 1 on Paimon's \"people not to tick off under any circumstances\" list...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4652007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4652007,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		}
	]
}