			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650501,
					"content": "If we do not make contact with the Darknight Hero soon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "What are we to do about the Abyss Order's challenge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "Ah, it's you two. I must admit, this issue of the Darknight Hero is proving to be something of a headache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "We've just held a meeting to decide on an appropriate course of action. Can you guess what it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "Bury our heads firmly in the sand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "Haha... Good one. But no, the Knights cannot afford to simply stand by and watch while there is even the slightest inkling of a threat facing Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "If that were the case, more and more people would start to rely on the Darknight Hero instead of the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Oh. Well, what's the plan then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Find out the Darknight Hero's true identity, and offer him our protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "\"Protection\"? He seems to be doing just fine without your protection so far, y'know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "Pff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "Well, since you've aided the Knights in the past, I might as well just tell you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "The offer of protection is just a ruse, in order for the Knights of Favonius to take over full — and exclusive — responsibility for this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "You aren't gonna let the Darknight Hero be all heroic and stuff? Why not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "Firstly, to show the might of the Knights of Favonius — to prove to the people that without the Darknight Hero, they can still rely on the Knights to maintain peace and harmony.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "Secondly, the Abyss Order have no mercy in their hearts. If anything happened to the Darknight Hero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "It would only serve to further their nefarious ambitions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "Gosh... Paimon never knew the life of a knight involved so much untold anguish before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "But none of this will work if we don't establish the Darknight Hero's true identity in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "There's no need to despair, Huffman. Just follow my plan and everything will be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Ah, Captain Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Lately, Master Diluc has been working the bar at the Angel's Share every night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "All I need you to do is keep him in your sight. Think you can manage that for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "Yes, Captain Kaeya! ...But, does that mean that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "Master Diluc is the Darknight Hero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650529,
					"content": "Who knows...? It's just a hunch. I've been known to be wrong on occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650508,
					"content": "Join forces with the Darknight Hero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650509
					]
				},
				{
					"id": 4650509,
					"content": "No. That would send a signal that the Knights are in favor of the Darknight Hero's continued presence in our city... which we are not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650510
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650510,
					"content": "Encouraging this kind of individual heroism undermines the Knights' authority.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 46520,
