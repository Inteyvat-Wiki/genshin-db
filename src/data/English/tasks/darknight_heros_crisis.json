					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650301,
					"content": "This is the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650302
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650302,
					"content": "Abandoned ruins like these are precisely the kind of place the Abyss Order likes to camp out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650303
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650303,
					"content": "Come on. There's no time to lose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 46504,
			"completionStepIds": [
				46510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46510",
							"2"
						],
						"stepId": 46510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Interrogate"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "How did you find me here!? Favonian scum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650402,
					"content": "I am no Knight of Favonius. Now, start talking! Your plan, what is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "I see you received our letter... But if you think I'm going to let you in on our secrets, I'm afraid you're quite mistaken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650404,
					"content": "Hmph. You appear to have misunderstood the situation you are in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "Burn him with <color=#00E1FFFF>Searing Hand</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "D—Did you just use a Pyro Vision to shoot f—fire from your hands!? ...Aah! It burns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650601,
					"content": "Let's see how long it takes for you to crack...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Burn him with <color=#00E1FFFF>Searing Hand</color> again!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Stop! Stop! P—Please, the pain— I beg you... make it stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650406,
					"content": "Burn him with <color=#00E1FFFF>Searing Hand</color> again!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4651403,
					"content": "Playing dead won't help you — that fire was nowhere near strong enough to— Oh... He seems to have <color=#00E1FFFF>passed out</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "Hey! You sleep when I say you can sleep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Aah! It burns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650901,
					"content": "I'll talk, I'll talk! Ow ow ow... P—Please, stop! I'll tell you <color=#00E1FFFF>everything</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650902,
					"content": "Th—The Abyss Order, we've amassed a force bound by a shared hatred for the Darknight Hero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650903,
					"content": "They... They will march on the Mondstadt <color=#00E1FFFF>city gates</color> at 10 PM tomorrow night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650904,
					"content": "That's everything I know... Please... Don't make me suffer those flames again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Interrogate"
				},
				{
					"id": 4650905,
					"content": "That's it? Well, I doubt you'd be foolish enough to keep anything else hidden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "<color=#00E1FFFF>Interrogate him</color> about their plan of attack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
		{
			"id": 46505,
			"completionStepIds": [
				46513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
