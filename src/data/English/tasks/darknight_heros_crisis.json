			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "Huffman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650102,
					"content": "Oh, it's you two. Thank you for coming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650103,
					"content": "So — the Darknight Hero. Do you have anything else you're able to share with me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650104,
					"content": "Could I first ask what's going on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Ah yes, of course I should fill you in first... apologies for my appalling lapse of etiquette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650108,
					"content": "The situation is... here. Take a look at this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650109,
					"content": "Geez... what horrible handwriting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650110,
					"content": "Hmm, let me take a closer look... Huh, some parts of this seem to be complete gibberish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650111,
					"content": "Indeed. Although this is written in the common tongue, it appears that a cipher has been used in many places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650112,
					"content": "Nevertheless, one can grasp the general message from the non-ciphered portions alone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650119,
					"content": "This is a war declaration from the Abyss Order to the Darknight Hero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650113,
					"content": "Does that mean... the bad guys want the Darknight Hero to go away forever and ever?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650114,
					"content": "Something like that. Thus, we are hoping to contact him as soon as possible so that we can attempt to coordinate a response.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650115,
					"content": "After all, this matter no longer concerns merely the Darknight Hero himself. It impacts the entire city of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650116,
					"content": "Thank you for the information.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "If you find out anything at all, come and find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650117,
					"content": "I will keep it in mind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "Sorry, we've got nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "Is that so... That is a pity indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 46502,
			"completionStepIds": [
				46505
