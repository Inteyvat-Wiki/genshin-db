			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Dear, come have a word with Ms. Bai... Her father is such a skilled craftsman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "They sell their Tofu in Liyue Harbor, it's top-quality!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Right! Ms. Bai, I forgot to ask what brought you here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "We brought you a Xiao Lantern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Xiao Lantern... Ah... So considerate. You bring me those each year, Ms. Bai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Do you remember, Dear? I used to make great Xiao Lanterns back in the day. Our neighbors liked them so much that they asked me to make some for them too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Xiao Lanterns are so beautiful, they really light up each Lantern Rite... Wait, I'll hang it for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Let me hang it up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Alright, just be careful. Don't hurt yourself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
		{
			"id": 7181804,
