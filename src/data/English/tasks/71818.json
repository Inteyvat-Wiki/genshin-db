			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "Did you hang the Xiao Lantern? Truly breathtaking. The upcoming year is bound to be another great one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180402,
					"content": "It sure will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Grandpa Jiangcheng, it's time for us to leave now. We still have a few errands to run. I'll visit you again soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180405,
					"content": "I see... Young people like you always have something to do... Can't get a moment's respite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180406,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Ah, sure. Dear... don't forget to look after our land...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180403,
					"content": "Certainly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
			"id": 7181805,
			"completionStepIds": [
				7181807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181806",
							"3"
						],
						"stepId": 7181806,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181807",
							"2"
						],
						"stepId": 7181807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ms. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "I'm really grateful for your help. If I'd gone there on my own, it would've taken me hours to get everything done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180502,
					"content": "I didn't want to leave Grandpa Jiangcheng on his own right before the festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180503,
					"content": "What about you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "Me... I'm going back to the mill. There's still much work to be done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180505,
					"content": "I inherited the mill when my father passed away. I left my job at Liyue Harbor to continue the family tradition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180506,
					"content": "I don't know if it makes sense, but doing the same things he used to do, being in the same environment, it makes me very nostalgic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180507,
					"content": "I often recall the many things that my father used to tell me, especially during this time of the year...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180508,
					"content": "Oh, I almost forgot. With Grandpa Jiangcheng on my mind, I didn't make a Xiao Lantern for myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180509,
