			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ms. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "How do you do, Traveler? Thanks for your help last time. Qingce Village hasn't been this lively in a while now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180102,
					"content": "You're most welcome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "In previous years, only Zhi and I were around, so we could only make the children a few Xiao Lanterns, talk to the old folks about some domestic business, and whip up a few good dishes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180104,
					"content": "But with your help, we were able to have a lively Lantern Rite this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180105,
					"content": "But I guess we should look to return to normal now... I should see to the elderly folk in the village. I'm meant to go see Jiangcheng today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180106,
					"content": "If you don't mind, could you come along with me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 718180107,
					"content": "Lead the way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "Alright. Then let us go to his place first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Bai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181801",
