			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270101,
					"content": "\"If you are reading this message, I hope that you are the one I am expecting.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270102,
					"content": "\"I've lost count of which letter this is. How far will it drift, and on what shore will it wash up?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270103,
					"content": "\"If we ever should meet again, do tell me once more of the mountain city of stone and the snowstorms of the north. Or perhaps, tell me about dandelions and wine instead. What say you?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270104,
					"content": "\"I will wait for your reply, as I always have.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drifting Bottle"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "\"If you are reading this message, I hope that you are the one I am expecting.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270202,
					"content": "\"We once believed that war was something that only happened in fairy tales and legends. But now, each and every one of us trembles under Her Excellency's thundering wrath.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270203,
					"content": "\"The beach that we used to go to has been sealed, but I found a way to get this letter out nonetheless.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270204,
					"content": "\"Do not worry, or blame yourself for this. This deed is but trivial for one who once ventured alongside you such as I.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701270205,
					"content": "\"I will wait for your reply, even if you write but a single word.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drifting Bottle"
				}
			]
		}
	]
}