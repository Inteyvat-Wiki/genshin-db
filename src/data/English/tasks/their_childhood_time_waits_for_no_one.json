			"dialogs": [
				{
					"id": 240040301,
					"content": "Agh, you found me so quickly! I was just planning on switching locations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040302,
					"content": "Now I'll have to go back to the meeting point...",
					"roleType": "TALK_ROLE_NPC",
