			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Brother, let's hide over there. I bet it'll be better than the location she picked!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Hey, Verut, stay close to me! If you get lost, I won't be able to find you right away, you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040103,
					"content": "What are you two doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "Hey, it's you! Are you free by any chance? C'mon, hide with us! Lovi's probably hidden herself already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Tell me about Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "There's no time, c'mon! She knows this place really well... We need to find a better hiding spot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut leaves in a hurry...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*sigh* Verut... When will he listen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040110,
					"content": "Sorry, but I'll have to trouble you to go another round with us. Verut's really excited, for... whatever reason...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040111,
					"content": "Maybe it's because he's found a new friend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "My thoughts exactly. Still, so long as he's happy, it's all good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040113,
					"content": "Let's hope he doesn't get too excited and follow Lovi to hide in some strange spot or another...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040118,
					"content": "My apologies, but please, do play hide-and-seek with us again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040119,
					"content": "I guess I should find a place to hide myself, or Verut will be upset... and if he cries right in the middle of the street, I'll be all out of options...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040120,
					"content": "Aurele leaves...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Tell me about Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "A girl we just met. She saw us playing hide-and-seek, and she insisted on joining in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040116,
					"content": "Her personality's quite like Verut's, so they get along like a house on fire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040117,
					"content": "In any case, her father doesn't seem to have much time to play with her either, so I guess we're all in the same boat there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040104,
					"content": "Still playing hide-and-seek, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
			"completionStepIds": [
				2400402
