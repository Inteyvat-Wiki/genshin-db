					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040201,
					"content": "...I think I've read this page before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040202,
					"content": "You're reading?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Huh. You sure arrived quickly. I had only just started reading.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040205,
					"content": "Lovi's father got her to pass this book to me. He even said that I could ask him about anything I didn't understand in it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040206,
					"content": "But in truth... Heh. What is there in this book that I *do* understand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040207,
					"content": "Anyway, leaving that aside, I'll head back to our meeting point. You did find me, after all, and the rules are the rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040203,
					"content": "You're quite an avid learner, aren't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
			"id": 2400403,
