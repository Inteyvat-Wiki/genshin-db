			"dialogs": [
				{
					"id": 240040501,
					"content": "Why are you looking at me like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040502,
					"content": "You were secretly reading a book again, weren't you? You weren't playing seriously at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "That's right. Come on! Be serious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Well, the two of you took the good spots, and I'm not very good at this... so I just went to read to pass the time, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040505,
					"content": "Bleh! You're a lying liar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Hmph! Bookworm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Seriously? Spare me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040508,
					"content": "Alright, let him be.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Hehe, Lovi's really good at hide-and-seek. She knows all sorts of interesting hiding spots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Hehehe, this place is pretty awesome when Lovi's around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut climbs walls super fast, and he's really strong. He gave me a hand quite a few times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "As long as we go together, I bet no one but you would be able to find us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Alright, I think we're more or less done for the day. Let's send you home first, Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040514,
					"content": "And then... you're gonna ask my dad questions again, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040515
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040515,
					"content": "W—Well, there are some things that I'll need to consult him about, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040516
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040516,
					"content": "Well, sure, my dad's definitely going to be home right now, so let's head back. My mom said that the two of you should stay for dinner, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040509,
					"content": "Weren't you two having fun anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				}
			]
		},
