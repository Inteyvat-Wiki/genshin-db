			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "I won, I won!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111102,
					"content": "Congratulations, Timmie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "Thanks. I can't wait to tell my mom... this'll make her really happy, won't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111104,
					"content": "Mom was the one who kept telling me I should join the tournament, so I'm gonna give the prizes to her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111105,
					"content": "I really wish my dad could see me now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111106,
					"content": "Bye, Timmie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "Bye! Ah, Genius Invokation is sooo much fun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mika",
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "Wait, why's everyone leaving? ...Did I miss it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111202,
					"content": "Ah Mika, too bad you weren't here to see it. I'm afraid that... Captain Kaeya lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111203,
					"content": "What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111204,
					"content": "Tell me everything! What happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111205,
					"content": "Well, I don't know much about Genius Invokation myself, but I did try to follow along by listening in to what everyone was saying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111206,
					"content": "Captain Kaeya took out one of Timmie's character cards right at the start, giving him an early advantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111207,
					"content": "But I guess that was all part of his opponent's strategy...? In any case, Timmie spent the first few rounds stocking up cards in his hand, and then swung the game with a brutal offensive right at the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111208,
					"content": "Hmm, but y'know, maybe the match was already over from the moment they flipped the coin and determined that Kaeya would go second...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111209,
					"content": "*sigh* I need a drink...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111210,
					"content": "Calm down, bro. Now's not the time to start drinking your sorrows away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111211,
					"content": "Knowing Captain Kaeya, he wouldn't want to see you upset over his loss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111212,
					"content": "Hey, why don't we learn how to play, too? Maybe then, we'll get to play against Captain Kaeya some day! Hehe... Though, I'm sure we'd lose pretty badly to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111213,
					"content": "Hah, yeah, you're right, Mika. Not a bad plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
