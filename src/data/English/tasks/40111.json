				"objectNames": [
					"Charlotte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "\"City on the Lake Teems With Talent in TCG Tournament as Young Prodigy Bests Favonian Cavalry Captain\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Hmm, this title saves face for the Knights, but lacks a little \"oomph\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "\"Top Strategic Mind of the Knights of Favonius Outsmarted by Bridge Boy in Five-Round Failure\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "\"Captain's Championship Hopes Crushed in Dazzling Dark Horse Defeat\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Hmm... Maybe I should stick with my first draft...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
		{
