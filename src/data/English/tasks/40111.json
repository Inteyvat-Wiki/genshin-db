			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Hey there. Something else you wanted to discuss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "About Genius Invokation TCG...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "The game's really caught on lately. It's a part of everyday life now — everywhere you go, you see people playing it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "In fact, some people have even given up drinking in order to keep a clear head during the game.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Hehe, I'm sure Diona will be happy to hear that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "How are the Knights of Favonius holding up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Don't worry, everyone's just fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "I actually managed to convince Jean to join me for a game, but we only got part of the way through before she was called away. I ended up having to finish the match for the two of us. *sigh* What can you do? Everyone has to put their work first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "But seeing how successful the tournament has turned out and how much fun everyone's had, I'm hoping that she at least has one less thing to worry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Let's catch up another time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Sure. We should have a game of Genius Invokation TCG when you get the chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
