			"dialogs": [
				{
					"id": 401111401,
					"content": "What an amazing tournament. That Timmie, huh... He really has a gift for this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "Yeah, who saw that coming... But at least I can feel a little better about losing to him now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lennard"
				}
			]
		},
		{
			"id": 4011115,
