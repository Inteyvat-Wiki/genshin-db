			"dialogs": [
				{
					"id": 401113301,
					"content": "Hi there, my name's Charlotte. I'm a reporter for The Steambird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Could I borrow a moment of your time for a brief interview?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*sigh* Sure, go ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 401113304,
					"content": "You made a promising start in this competition, leaving many contenders in the dust on your way to the finals, before narrowly missing out on a championship win when you lost to Director Hu Tao of the Wangsheng Funeral Parlor. It must be difficult for you, knowing how close you came to victory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "With this in mind, would you like to share your thoughts on how the final match played out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Uhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 401113307,
					"content": "Sorry, do you want an answer for the media, or do you want my actual thoughts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 401113308,
					"content": "I'd like to hear your actual thoughts, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 401113310,
					"content": "Well, I've always said that playing cards is seventy percent skill and thirty percent luck... But when your opponent rolls six dice of the same element at once, there's no coming back from that, not even with adeptus-level skills... so there was no hope for a mere adventurer like me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
