			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "I've heard that even the unofficial Genius Invokation tournament is enjoying a huge turnout. Many serious TCG players have registered for both the official and unofficial ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "As for me... I don't mind trying my hand at the trending games from time to time, though I still prefer chess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "But when it comes down to it, whatever differences there may be between the various games around, they all share one important thing in common: They bring friends together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4011133,
