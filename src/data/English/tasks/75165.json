					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "You did pretty well, but honestly... Not to brag, my best record is still better than yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650802,
					"content": "I mean, everyone's got one or two things they're really good at.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650803,
					"content": "See? Even someone with my build can be agile. So, make sure to eat properly and don't go on any crazy diets!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
