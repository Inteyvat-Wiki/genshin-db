			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "Hey, valiant passerby over there — yes, you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "Sigh, you're so skinny... Have you been eating properly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "But... all the food got eaten by my guide, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "No matter what your reasons or struggles might be, the first rule is: you must eat well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "Since you've made it to Teteocan, you've probably already seen the warriors from Collective of Plenty, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Out of the goodness of my heart, let me give you a piece of advice: never trust those guys who are obsessed with preaching about muscles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "The fat that the Archon blessed us with is a precious gift. Giving up all the delicious food and losing your fat just to chase after some flashy muscles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "That's the dumbest thing ever. Even the forest boars would pity you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "And honestly, if we're talking about what looks good, this whole muscle-worship thing only became popular in the last few decades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "My grandpa told me that back in his day, people actually preferred a slightly fuller figure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "So, don't let anyone mislead you into going down the wrong path to lose weight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "But, if one day you end up like my relatives from Collective of Plenty and decide to lose weight in the name of strength...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Here's something else to remember: when it comes to agility, warriors with a slightly chubby build can also be as nimble as fish. But when it comes to strength, those skinny guys are no match for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "If you need proof, just look at the jars on this training ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "With my build, I can easily <color=#00E1FFFF>sprint through without breaking a single jar</color>. I bet even the skinny ones couldn't pull that off with this level of agility, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Oh, I can see it — you're trying not to laugh, huh? Fine... I know you don't believe me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Come on, give it a try! Run through this training ground as fast as you can, but be sure <color=#00E1FFFF>not to break any of the jars</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Let's see how well you do — and whether you can beat my record.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Huh? Are you offering to treat me to a meal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "Well, that's not what I meant... But if you're really starving, I do have some grilled meat in my bag. Anyway, let's set that aside for now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
