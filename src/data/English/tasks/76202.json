			"dialogs": [
				{
					"id": 762020601,
					"content": "Whoa! Why did it just suddenly slide down like that? And is that a... giant Mandragora statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "Clunk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Examine Door"
				},
				{
					"id": 762020603,
					"content": "Hold on a moment. Sorry, just a minor technical difficulty. Let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "Click... Clack...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Examine Door"
				},
				{
					"id": 762020605,
					"content": "It's moving! Hey! Is this thing attacking us!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Aha, much better...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "What do you mean, much better!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
					"content": "#Mm? Come on, it's barely attacking you. You can handle a little spirited tickling, can't you? Besides, this is the perfect opportunity for {NICKNAME} to show off some skills.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
