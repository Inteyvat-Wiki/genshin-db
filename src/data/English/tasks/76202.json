					}
				]
			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "A gust of wind suddenly brushes across your face.\\nHow strange... It carries the aroma of Fruit Tandem Turnovers, Midsommar Torte, Crispy Roast, and Berry Herbal Candy.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Ugh! A gust of super sweet wind just blew right down Paimon's throat! *cough*... Hey! Where are we? That teapot and those cups look really, really big...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Wait a second... Did we shrink!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "This feels like Nicole's magic at work.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Apologies, I was hoping to invite animal actors, but alas... I'm used to dealing with thespians of a more... \"stony-faced\" persuasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Huh? Nicole, you've shrunk, too? Paimon thought you were gonna be huge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Nicole, the Magnificent Massive Mage, propping up the heavens while crouching down to talk? No, thank you! I'm quite happy with my current size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Aaaanyway... Welcome to the Great Mage's Tea Party! Now, pour yourselves some tea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
