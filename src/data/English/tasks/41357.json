				{
					"id": 413570301,
					"content": "How is the treasure hunt going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570302,
					"content": "I've found every last chest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "All of them? You've got a knack for finding treasure, then. Plenty of people can't even get the lanterns to rotate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570304,
					"content": "Since you found all the treasure... Please take these as your prize. Happy Lantern Rite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
