			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brother Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "Try the Illumiscreen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570102,
					"content": "...Illumi-what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "Illumiscreen. What do you say? Come on, it's really simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570104,
					"content": "See those screens there? And these three lanterns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570105,
					"content": "I had these lanterns made to order. When you turn them on, they cast all kinds of images.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570106,
					"content": "And if you rotate all three lanterns in the right way, the three images will combine to give you the full picture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570107,
					"content": "Hmm, maybe I'm not explaining it clearly... Okay, how about this — have a go of rotating the lanterns first, and once you're comfortable with how it works, I'll tell you how the whole game works in more detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brother Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Wow, you picked that up quickly. Okay, now that you've got the basic idea, time to give it a proper go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570202,
					"content": "Is it difficult?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "No. Didn't you already figure out how to rotate the lanterns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570204,
					"content": "When you're playing for real, all you need to do is rotate the three lanterns so that the images they cast onto the screen align to give the full picture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570212,
					"content": "I can tell you the image combinations in advance, but it's up to you to figure out how to rotate the lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570205,
					"content": "What happens when they overlap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "You may or may not have noticed that those screens have a map of Liyue painted on them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570207,
					"content": "When you align the images and shine them onto the map, you'll find treasure specially prepared by the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570208,
					"content": "The Guild had a lot of people working at full tilt to set up all the treasure sites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570213,
					"content": "The chests, though... They're just like these chests here. Once you know the locations, you should be able to find them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570209,
					"content": "Today's image is ready. It's a <color=#00E1FFFF>Glaze Lily</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570210,
					"content": "One other thing — the images on the Illumiscreen only show up clearly at night. You'd best come back at night to have a try.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413570211,
					"content": "Also, the Adventurers' Guild commissioned an expert to make these lanterns. They're really quite beautiful, so please take a good close look at them or it'll all have been a bit of a waste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
