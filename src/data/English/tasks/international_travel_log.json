					"nextDialogs": [
						728011402
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011402,
					"content": "I wrote a few paragraphs before. Please take these paragraphs to Midori first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011403
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011403,
					"content": "When I am finished with the whole story, I'll ask someone to bring her the completed travelogue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011404
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011404,
					"content": "Travelogue... Humph. That's what he says. How would I know if he has any other agendas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011405
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011405,
					"content": "What are you talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011406
					]
				},
				{
					"id": 728011406,
					"content": "I said this guy has ulterior motives for writing these travelogues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011407
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011407,
					"content": "Who would think about such random nonsense? Traveling around Teyvat in a hot-air balloon without using a Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011408
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011408,
					"content": "Humph, there must be some sort of agenda behind it... he just hasn't exposed himself yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Heihachi"
