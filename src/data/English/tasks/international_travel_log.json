			"dialogs": [
				{
					"id": 728011301,
					"content": "Standing on the top of the mountain, you can almost see the entire Narukami Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011302,
					"content": "The wind at the mountain top is quite strong, and the height is perfect for take-off. There are no obstacles here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011303,
					"content": "And it's a long way from Inazuma City, I won't be disturbed by Doushin... or by unwanted people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011304,
					"content": "It really is a good location.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "In conclusion, it's a good location to take off from... And it's a nice place to write about in the travelogue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011306,
					"content": "That guy... he's still following us. He just won't let us go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011307,
					"content": "I'll get rid of him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "It's fine. Don't worry about him. He wouldn't dare do anything rash with you around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011309,
					"content": "When dealing with this kind of person... If you approach him, he would keep pestering you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011310
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011310,
					"content": "Anyway, let's call it a day. Let's go back to the Komore Teahouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
