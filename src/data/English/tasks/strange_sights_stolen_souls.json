					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "Hi Katheryne, it's us! Any new commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200102,
					"content": "As a matter of fact, there's one that looks perfect for you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200103,
					"content": "Uncle Dai is one of the foremen at Huishan Hall over in Liyue Harbor. He's hoping the Adventurers' Guild can spare some manpower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200104,
					"content": "What is it we have to do exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200105,
					"content": "I believe you'll be looking for workers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200106,
					"content": "Ooh, looking for people? Awesome, we're good at that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200107,
					"content": "I have no reason to doubt your abilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200108,
					"content": "I'm sure the details can be worked out face to face. If you're willing to accept this commission, head over to the dock and talk to Uncle Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112002",
							"2"
						],
						"stepId": 1112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "Hey! Are you Uncle Dai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200202,
					"content": "I am indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200203,
					"content": "Ahh, now then, you must be the adventurers assigned by the Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200204,
					"content": "Huh? How could you tell!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200205,
					"content": "By the clothes on your back and the look on your face. Experienced adventurers at that, I'll wager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200206,
					"content": "Right again! You're pretty perceptive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200207,
					"content": "Hahaha. In this trade, you need a sharp eye for people, not just rocks. Uncle Dai can see what you're made of from a long way off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200208,
					"content": "Alright, my assistant should be arriving soon so let's just wait here a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200209,
					"content": "Whoa whoa, that's why we're here! Now there's someone else taking a cut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200210,
					"content": "Well, to tell you the truth, this is a very difficult matter. Too much for adventurers alone to handle, I fear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200211,
					"content": "Hmph! So there is someone else!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200212,
					"content": "Do you think we're not up to the job?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200213,
					"content": "Steady, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "It just occurred to me that you don't have all the facts. The incident in question happened in a mine, and it's a little out of the ordinary, to say the least. Mines are dangerous places, as I'm sure you're aware. As such, I've enlisted an industry expert to cover all contingencies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200216,
					"content": "Last time I checked, adventurers weren't experts in ore appraisal or geological analysis. With a professional by your side, everything should run smoothly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200217,
					"content": "Besides, this guy is the best in his field. No matter the rock, he'll tell you its value to the nearest Mora at a glance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200218,
					"content": "I'd go as far to say that there's not a soul in Teyvat that knows rocks better than him. I'd be a fool to not enlist an expert of his caliber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200219,
					"content": "You're a fool if you think you found Teyvat's number one rock expert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200220,
					"content": "Oh? And why might that be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200221,
					"content": "Because Teyvat's number one rock expert happens to be a friend of ours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200222,
					"content": "You must be talking about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(Perfect, I was planning to ask him a few questions.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "Haha~ Didn't expect that, did you! Wait here, we'll go fetch him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200214,
					"content": "Paimon, you're getting competitive again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
		{
			"id": 1112003,
