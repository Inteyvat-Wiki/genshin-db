			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "In our last tale, Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 111200302,
					"content": "Zhongli! There you are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200303,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200304,
					"content": "Here for a few tales? I didn't know you two were connoisseurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200305,
					"content": "Oh, no no! We're here for you! Um... do you have time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200306,
					"content": "Ah... something I'm rarely short of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200307,
					"content": "We've accepted a commission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "We need someone who understands geology and ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200310,
					"content": "Hmm... someone who understands geology and ore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200311,
					"content": "Ugh... Take a look around! Is there anyone in Teyvat more qualified?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200312,
					"content": "The requester claims to have enlisted Teyvat's number one rock expert, but Paimon doesn't believe a word of it. Nobody understands rocks better than you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200313,
					"content": "You appear to have taken his claim quite personally on my behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200314,
					"content": "Oh, no no... it's just... Uncle Dai doesn't know what he's talking about!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200315,
					"content": "Paimon just wants to... enlighten him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200316,
					"content": "Hahaha, I see. Well then, it will be my pleasure to accompany you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200317,
					"content": "Really!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200318,
					"content": "But I should inform you that despite my expertise... I cannot necessarily claim to be a leading authority.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200319,
					"content": "We are at all times adrift in a sea of learning — new knowledge should be welcomed with open arms. Still, I imagine I will be of help to you in this endeavor. If we do encounter an expert, I look forward to broadening my own understandings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200320,
					"content": "Ugh... stop being so modest, Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200321,
					"content": "Well, we got him! Let's head back to Uncle Dai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200308,
					"content": "We have a special task...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "Uncle Dai! We're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200402,
					"content": "Oh! And this must be the friend you spoke of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200403,
					"content": "Yup! Paimon doesn't know who your rock expert is, but he's got nothing on our guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200404,
					"content": "Haha, let's not get ahead of ourselves. Still, I do have a claim to some experience in this field.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200405,
					"content": "Uh-huh, so you say. Wait till my guy gets here, then we'll see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200406,
					"content": "It's no use me singing his praises. You'll have to see for yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200407,
					"content": "Uh... is this the place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200408,
					"content": "Aha! Speak of the devil! Allow me to introduce my assistant, Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200409,
					"content": "Young Kun, these are two adventurers assigned to us. And as for this gentleman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200410,
					"content": "Hm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200412,
					"content": "This is Zhongli, a consultant from the funeral parlor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "Wangsheng Funeral Parlor's consultant... Mr. Zhongli! I've heard about you. They say you're a man of great knowledge and many talents. I had no idea I'd be meeting you in person today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200414,
					"content": "I... I'm sure I recognize you... Have we met at the parlor? Wait, I've never been to the parlor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200415,
					"content": "Uncle Dai, aren't you going to test them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200416,
					"content": "So that's what you were planning.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "Huh? I... I wouldn't know where to start...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200418,
					"content": "Then they can figure out a way to test each other! If Zhongli wins, he's the assistant. If Zhongli loses, uh... N—Never mind, Zhongli won't lose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200419,
					"content": "A contest? Why, it would be my pleasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200420,
					"content": "I admire your enthusiasm, good sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200421,
					"content": "Haha! I must say, you certainly have the look of an industry expert about you. It'll be interesting to see which one of us wins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200422,
					"content": "Stop talking the talk and start walking the walk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200423,
					"content": "I'm just saying it like I see it, haha... Which is incidentally the only skill I have worth talking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200424,
					"content": "So you're an appraiser, Mr. Kun Jun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200425,
					"content": "Well, no... actually I've already forgotten what I'm in Liyue Harbor for... I was standing by the side of the road one day when Uncle Dai called me over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200426,
					"content": "He saw me holding a rock and asked me a few questions. He seemed incredibly excited, even followed me for a while. We arranged to meet here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200427,
					"content": "Huh? How could you forget something like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200428,
					"content": "I saw him on my way over to Liyue Harbor, poring over rocks and muttering to himself. He looked to be very familiar with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200429,
					"content": "I asked him a few questions out of curiosity. To my surprise, he knew more than me, an old mining foreman! In any case, he didn't have any pressing matters, and agreed to help me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200430,
					"content": "So... do you have a poor memory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200431,
					"content": "Not exactly... Anyway, if it's rocks you need help with, I can most certainly lend a hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200432,
					"content": "Mr. Zhongli, what do you make of this rock?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200433,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200434,
					"content": "A glossy exterior, with a fissure that could only have been left in the wake of a volcanic eruption. If I'm not mistaken, this is a rough gem from another nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200435,
					"content": "Ah... a keen eye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200436,
					"content": "It's no ordinary rough gem. Fragile surface layer, black veining... My intuition tells me that there's high-quality crystal ore inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200437,
					"content": "Remarkable. This rock does indeed hail from the vicinity of a volcano. I came across it in a market and snapped it straight up. The seller thought it was some leftover industrial remnant. They had no inkling of the treasure that lay within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200438,
					"content": "Isn't Crystal Ore found everywhere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "Purity and geological rarity alone aren't enough to make a treasure. Some of the most precious crystals contain deposits of water or sand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200441,
					"content": "In the moment of its formation, the crystal hidden within this stone shell captured a pocket of water. For water to be hidden in its depths, like a moon concealed within a mountain, reflecting shafts of daylight that make it through... Now that's a rare treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200442,
					"content": "Such a detailed description, almost like he saw it with his own two eyes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200443,
					"content": "Say... you're not trying to hoodwink us are you? After all, we haven't even seen what's inside yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200444,
					"content": "Everything he said is true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200445,
					"content": "Most crystals are born in high-temperature environments. Heat and water aren't natural bedfellows of course, which is why crystals with water deposits are so sought-after. Moreover, this particular crystal contains mountain lake water. A rare find indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200446,
					"content": "Well if Zhongli says so, it must be true...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200447,
					"content": "I've yet to encounter anyone with a judgment as shrewd as yours, Mr. Zhongli. How did you know exactly what lay within?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200448,
					"content": "I've seen many such stones in my time, I recognized it immediately. I hope you didn't mind me flaunting my experience, Mr. Kun Jun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200449,
					"content": "Of course not! I feel I've met a kindred spirit here today. I hope you will accept my friendship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200450,
					"content": "Uncle Dai, it would be a mistake for Mr. Zhongli not to join us! Trust me when I say that his level of expertise is unrivaled in the trade. You won't come across another of his caliber in your lifetime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200451,
					"content": "Very well, there is strength in numbers after all! Everyone, follow me to The Chasm. There are men counting on you to find them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111200439,
					"content": "What makes this one so special?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
