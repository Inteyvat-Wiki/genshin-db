					"nextDialogs": [
						400831906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831906,
					"content": "Save your breath. If you think I'm wrong, start by defeating me. Then you can show me why exactly you think your opinion is correct.",
