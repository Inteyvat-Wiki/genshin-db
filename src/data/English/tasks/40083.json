						],
						"stepId": 4008307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831401,
					"content": "This all looks like regular Floral Jelly. It's right out in the open for everyone to see, and they've even put the recipe on the table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831402,
						400831403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831402,
					"content": "But even if they added some \"special ingredients\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				},
				{
					"id": 400831404,
					"content": "Hmm... Well, it's not like we can just take them away and go investigate them. That'd be stealing, right? We'd probably be disqualified, and might even end up getting arrested by the Corps of Thirty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831405,
					"content": "Oh, but... we do have a Kamera! How about we take some pictures of the Floral Jelly and its recipe? At least then, we'll have a record of all the important information.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831403,
					"content": "...most contestants wouldn't suspect a thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				}
			]
		},
		{
			"id": 4008315,
			"completionStepIds": [
				4008302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008302",
							"2"
						],
						"stepId": 4008302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831501,
					"content": "Traveler, Paimon. This day has come earlier than I had expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831502
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831502,
					"content": "My apologies, but my writing career is at stake here, and my reputation in Lady Yae's eyes... I can't allow you to beat me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831503
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831503,
					"content": "Bring it on!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831504
					]
				},
				{
					"id": 400831504,
					"content": "Don't get too cocky, Souka! We won't go easy on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008316,
			"completionStepIds": [
				4008310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008310",
