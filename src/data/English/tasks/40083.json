			"dialogs": [
				{
					"id": 400831901,
					"content": "You locate the Floral Jelly and recipe, and take photo evidence...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400831902
					]
				},
				{
					"id": 400831902,
					"content": "Done! We should ask an expert to analyze these photos... But we're kinda running out of time. Let's go buy Layla's stuff first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831903
