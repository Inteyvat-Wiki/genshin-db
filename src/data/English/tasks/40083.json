				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baron Bigfoot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831601,
					"content": "I can see you're serious about this. Good. Time to put my years of rigorous training to full use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831602
					],
					"speakerTitle": "Baron Bigfoot"
				},
				{
					"id": 400831602,
					"content": "Now, prepare to witness the power of my all-Cryo Fungi team!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baron Bigfoot"
				}
			]
		},
		{
			"id": 4008317,
			"completionStepIds": [
				4008316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008316",
							"2"
						],
						"stepId": 4008316,
						"stateName": "QUEST_STATE_UNFINISHED"
