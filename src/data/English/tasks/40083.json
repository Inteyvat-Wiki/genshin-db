				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "Miko, we're sorry! It was all Bongo-Head! We didn't know it would take Souka out so quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830502,
					"content": "Paimon... I'm the beast tamer here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "Oh? Did she look crestfallen and say something melodramatic like \"beyond the reach of mere mortals\"? Then curl up on the ground and start wailing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830505,
					"content": "Uh yes... to all of those, actually. You know her really well, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830506,
					"content": "It's better this way. Souka will turn this experience into valuable writing material. She'll be able to portray the protagonist's journey with all the setbacks they face along the way much more compellingly. It will resonate all the more with readers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830507,
					"content": "As for how to flesh out the villain — dominating, ruthless, but brilliant, and ultimately victorious — the inspiration will have to come from you. So don't go getting yourselves knocked out of the competition by some second-rate wannabe, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830508,
					"content": "Oh no, I'm the villain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "That's a conversation for another time! Miko, please ask Souka to go easy on us when she writes us into the novel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}, Paimon, and Miss Yae... *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830512,
					"content": "Layla, take it easy, don't go fainting on us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830513,
					"content": "I'm alright... So I wrote to the Amurta students, and they were really keen. I got a reply with the information I needed within just a few hours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830514,
					"content": "I've tried making a few different snacks for Twirly-Whirly based on the information they gave me, but it didn't seem to like any of them... Maybe I used some of the wrong ingredients, or something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830515,
					"content": "So then I made a new, improved list, and also included ingredients that might suit Bongo-Head's taste. I didn't go to bed until way past midnight, so I'm a little out of breath today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830516,
					"content": "How'd you get the results so soon? That was super quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830517,
					"content": "(Lack of sleep explains the tiredness, but not the breathlessness...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "How's it going, my Little Layla? Have you been teaching your opponents a lesson?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830519,
					"content": "Yep! Thanks for taking us training, Miss Yae. Twirly-Whirly is way more obedient now, and it reacts so quickly, I'm actually kinda envious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830520,
					"content": "But the opponents have gotten stronger too, so the pressure is on. I gotta train with Twirly-Whirly some more if I wanna have a shot at getting into the quarterfinals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830521,
					"content": "The problem is... I'm also planning to visit the Almighty Merchant at seven in the morning tomorrow to buy all the ingredients I need...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830522,
					"content": "Oh, that's no problem. I'll join you with your training session, and we can leave the little ones to buy the ingredients. They're quite the experts in running errands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830523,
					"content": "Sounds like you two help out Miss Yae quite often, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830524,
					"content": "We sure do! We love helping Guuji Yae...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "Ahh! Right, yeah! Please don't turn us into scary, evil bad guys!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830527,
					"content": "Don't worry, Little Layla. They're just apologizing to me for defeating Souka. Go buy yourself a nice drink, take a break, and catch your breath.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830528,
					"content": "Thanks so much! Ahh, you guys are the best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830529,
					"content": "This is the address where I arranged to meet up with the Almighty Merchant. And here's the list of ingredients. Thanks again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830530,
					"content": "Hey, it's our pleasure! You helped us look into Bongo-Head's preferences, remember? Glad we can return the favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830531,
					"content": "As for the potential liabilities we didn't have time to discuss earlier... One good place to start might be the Fungi power-up materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830532,
					"content": "Floral Jelly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "Why, this is the most exciting sub-plot of the novel: the secret investigation. I'm sure you must be curious about where the magical powers of the Wisdom Orb and Floral Jelly really come from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830535,
					"content": "Besides, if we fail to uncover what's really going on in this tournament, we simply leave Haniyyah to her own devices... who knows what chaos might ensue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830536,
					"content": "Uhh... This is suddenly sounding super complicated... Paimon isn't really following...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830537,
					"content": "I suggest that you act just before sunrise, while most people are tired and resting. You may find some important leads.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830538,
					"content": "Should we really take Miko's suggestion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830539,
					"content": "Well, it's literally what we signed up for.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "Yeah, you're right. Okay, let's wait until early tomorrow morning and go check out the Fungi power-up place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830542,
					"content": "Don't worry, Bongo-Head, you're not under suspicion or anything. We just wanna make sure everyone stays safe in this competition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830540,
					"content": "For the sake of harmonious coexistence with our shroom buddies.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "You know something about it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "...Because if we didn't...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "But Paimon freeloads off the villain, so she's the bigger villain!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "I should be the one who's responsible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
