			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831701,
					"content": "I can't believe it... I lost, that's it... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831702
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831702,
					"content": "It seems that the \"Guests of Tenshukaku\" have powers beyond the reach of mere mortals like me.",
