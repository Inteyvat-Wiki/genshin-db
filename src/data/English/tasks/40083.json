			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}, Paimon, I saw you guys made it to the next round. Congrats!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831302,
					"content": "Hey, Layla! You're looking well today, and Twirly-Whirly looks really happy! Guess you won your last round, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831303,
					"content": "It was a close call, I only won by a hair... I'm so glad I trained with Miss Yae beforehand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831304,
					"content": "Also, the Almighty Merchant just sent someone to deliver the stuff I ordered. Thank you so much! I'm gonna go catch up on some rest with Twirly-Whirly now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831305,
					"content": "*whine*... My stamina's running low... Let's keep the volume down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831306,
					"content": "Speaking of Miss Yae... where'd Miko go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831307,
					"content": "She left in a hurry with Souka. I guess they must have had something urgent to do. Also, I think they were escorted by a mercenary from the Corps of Thirty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831308,
					"content": "When I returned to the arena, they were already quite a distance away. It didn't feel right to run after them and ask what they were up to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831309,
					"content": "Maybe she has work to do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "Could be. Miko has been putting a lot of time into the tournament lately, so Paimon wouldn't be surprised if she had a lot of Chief Editor work to catch up on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831312,
					"content": "She also said that she wanted to look for inspiration while enjoying her vacation. The mercenary was probably just their tour guide. We shouldn't worry about it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831313,
					"content": "The quarterfinals are coming up. To me, this is the most important round... I'm a little nervous, but let's all do our best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831314,
					"content": "Yeah! We've all done really well to come this far in the tournament. Keep it up, Layla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831315,
					"content": "We mustn't let our guards down, either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "Right, we have to stay vigilant! Okay, let's take some photos of the items we got from Dori to add to the ones we took this morning. We'll show them all to Miko when we see her next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831316,
					"content": "We need to strike a balance between competing and investigating.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "It gets busy at Yae Publishing House, after all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
		{
			"id": 4008314,
			"completionStepIds": [
				4008307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008307",
