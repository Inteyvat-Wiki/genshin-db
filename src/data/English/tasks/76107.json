			"dialogs": [
				{
					"id": 761071901,
					"content": "Actually, I do — I was hoping for a little sparring match.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071902
					]
				},
				{
					"id": 761071902,
					"content": "Sparring? But you said you were an external researcher... Hmph, now that I think about it, I don't recall the Lady ever hiring any researchers... Wait. You're a spy, aren't you? Then, prepare to die!",
