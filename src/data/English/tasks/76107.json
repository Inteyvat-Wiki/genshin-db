			"dialogs": [
				{
					"id": 761071701,
					"content": "Hmph, I'm not playing by Fatui rules.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "Then if you won't follow the rules... Disappear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
