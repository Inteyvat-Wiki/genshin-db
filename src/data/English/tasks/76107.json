			},
			"dialogs": [
				{
					"id": 761071001,
					"content": "Who are you? What are you doing here? The cargo crew's supposed to be down by the port.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610711,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "I am your Harbinger, Marionette!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Eh? W—Wait, is that what we're going with...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Hmph. I'll give you points for boldness, but if you think such a blatant lie will work, you clearly underestimate us Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "I'm a... specially appointed researcher under Marionette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "A \"specially appointed researcher\"? Lady Marionette has already reached the pinnacle of both mechanical and kuuvahki research. Why would she need to hire some external researchers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Scientific progress is built on collaboration, I'll have you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Hmm... fair point. I've helped collect quite a few research papers from the Fontaine Research Institute for her myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "Since you're an expert in this field, I assume fixing this Landcruiser's malfunction would be quite easy for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Umm... I fear my research focus is more theoretical...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Ah, I see! Kuuvahki theory is a most profound areas of study — truly impressive! By comparison, repairing a Landcruiser is much more application-oriented. And it is as you say — they are completely different disciplines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "That said, Lady Marionette isn't here right now. You could check with Commander Azalea — she might know about any further arrangements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Of course, leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "You give the Landcruiser a few good whacks. *clang, clang, clang*... rendering it completely immobile.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "It's... totally broken... What do we do now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "Hmph, I knew something was off about you from the start. A real researcher would never make such outlandish claims. You're clearly an impostor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "You could say I'm practically her mentor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "Oh! Speaking of which, I've helped collect quite a few research papers from the Fontaine Research Institute for her myself. She spoke very highly of Dr. Mosso's research findings. Wait... could you possibly be...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*cough* *cough*... Mm-hmm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "Y—Yeah! Never thought your reputation would reach all the way out here, Dr. Mosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Hmph. And as far as I know, you should be thirty years dead. Well, better late than never!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610717,
			"completionStepIds": [
				7610701
