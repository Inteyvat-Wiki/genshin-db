			"dialogs": [
				{
					"id": 730280101,
					"content": "There's a big robot component here, too. Paimon reckons that Jazari'll take his Kamera out again if he sees it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280102,
					"content": "Ararycan claims to have moved the big components back there. But that can't be true, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Of course it is true. Ararycan doesn't deceive Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280104,
					"content": "Aha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Ararycan was the Aranara who played with the kids at the secret base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280107,
					"content": "But Ararycan remembers nothing about this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280108,
					"content": "Maybe it has something to do with the dried flower in the journal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Yeah. The Aranara at the Mawtiyima Forest forgot everything after giving us a flower as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280111,
					"content": "Maybe the three of them had the same adventures we did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280112,
					"content": "Ararycan doesn't know what you're talking about and Ararycan can't remember. But it's fun hanging around with little Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280113,
					"content": "Paimon hopes you remain happy wherever you may go, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280109,
					"content": "We've encountered something like this before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
					"content": "If I'm not mistaken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				}
			]
		},
