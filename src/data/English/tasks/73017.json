				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171001,
					"content": "Humid dream, dry dream... Ding dong, tick tock, rustle... It's Vana's tune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171002,
					"content": "#Nara {NICKNAME}? The \"leaves\" are in the dream, and the \"branch\" is here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				}
			]
		},
		{
			"id": 7301712,
			"completionStepIds": [
				7301712
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301712",
							"2"
						],
						"stepId": 7301712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "We're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Arakunti heard you. The whimpers have turned into a gentle tune, but to merge it into the great flow of sound, we still need...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "We still need your help, Arakunti! Hehe, Paimon'll be counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Arakunti knows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Oh! Then there shouldn't be any problems now, right? Paimon hopes we can heal the Varuna Contraption soon, or Apam Woods will be full of spores... Just thinking about it makes Paimon... Achoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Paimon can't believe that you Aranara have no reaction to spores... How are you not affected at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Aranara are not unaffected. Aranara just cook mushrooms. But spores are too small and too many to catch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "When the Varuna Contraption wasn't broken, Vana didn't have so many mushrooms, so healing the Varuna Contraption could make everything better. Except Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Things will surely get better.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "Yeah, we'll help too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "We will find a way to deal with Marana too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Is Nara {NICKNAME} Nara Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Huh? Why are you asking that all of a sudden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "#Arapandu said that Nara Varuna was a golden, brave Nara. Together with Aranara, {F#he}{M#she} healed the Varuna Contraption, drove away the black rain and mud, and brought back the sun and moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} has also helped Aranara to heal the Varuna Contraption, and you're a golden and brave Nara, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "But isn't Nara Varuna someone from a long time ago...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Did Nara Varuna not return to Vana? Is Nara {NICKNAME} a completely different Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Can different Nara have similar melodies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Perhaps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "#Arakunti has not met Nara Varuna, but Arapandu has talked a lot about {F#him}{M#her}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#{F#His}{M#Her} melody must be the same as Nara {NICKNAME}'s. Listening to it will surely bring happiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#Yeah, Paimon's always happy when she's with {NICKNAME}! If {NICKNAME} leaves Paimon one day, like Nara Varuna left the forest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu must be waiting for us at the \"rest stop.\" Return with Arakunti, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Let's go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Right, let's head back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "But I have something else to do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "It's okay, Arakunti can go back alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "I don't know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				}
			]
		}
	]
}