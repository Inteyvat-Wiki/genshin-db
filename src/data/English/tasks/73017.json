			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Oh! We finally found you! You're Arakunti, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "One might not be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "Huh? What do you mean by that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Because one might be a tree, or rain, or a dream of Vana, or the strings of a musical instrument.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Paimon didn't understand a word of what he just said! Did you, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Me neither.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Paimon feels like she knows the meaning of each individual word, but they stop making sense once you string them together into a sentence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "Why are the Golden Nara and the small flying thing here to find Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Paimon's not some small flying thing! Wait, Paimon actually is a flying... Argh! Anyway, Paimon's... Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#Your \"Golden Nara\" also has a name, and that's {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "Arapandu told us that you're in the Grove of Dreams and he sent us to check up on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "You can tell Arapandu that Arakunti is fine, the Grove of Dreams is fine, and the humid dreams are also fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#Okay... {NICKNAME}, let's head back and talk to Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "...Or maybe not! We came here to heal the Varuna Contraption! That was close. Paimon was almost led by the nose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "You can tell Arapandu that Arakunti doesn't want to lead Paimon by the nose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Arapandu probably doesn't want to know that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "Paimon doesn't want to either! What on earth is going on with this Aranara!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "I recall Arapandu saying...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "He said, \"Arakunti's more distant from Nara.\" Does that mean Arakunti doesn't know how to communicate with people?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "Actually, we're the ones who don't know how to communicate with Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Oh! That's right... We're the ones who should try to follow the local customs and learn how to communicate with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "But now that you mention it, how do Aranara communicate, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "What do you think, small flying thing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "If the Golden Nara doesn't know, what would the small flying thing know? Why don't we just ask the amazing Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Can you tell us exactly how Aranara communicate with each other? We really wanna learn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Why do you want to learn? Nara is Nara, Paimon is Paimon, and Aranara is Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "Ah, Arakunti sees. Paimon also wants to turn into a seed and be buried in the soil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "No! Not at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "Does the Golden Nara want to become a seed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "No, thanks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Too bad. Seeds are nice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "We've almost forgotten what we came here for. It's for Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "We need to heal the Varuna Contraption for Festival Utsava so that the weather will return to normal and there will be no more of those nasty spores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Paimon is right. It's for the sake of Festival Utsava, and for the sake of the center of the blue earth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "A humid Grove of Dreams is good, but the \"spores\" are bad. The mushrooms that can run are bad too. There is also too much rain, so the mushrooms have become difficult to cook.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Hey, see? You can be clear after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#We are going to heal the Varuna Contraption. Come with Arakunti, Nara {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "If it's possible. Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Don't talk nonsense, he'll think it's for real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Well, how about we start from using metaphors?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "Let Paimon try! The Golden Nara is just like... like... um... like a Teyvat Fried Egg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "...Actually, let's just ask Arakunti directly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "I can probably guess.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Amazing! So what did his words mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "He said that he can transform into many other things.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Really? Don't you pull Paimon's leg, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301704",
							"2"
						],
						"stepId": 7301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "The roots of a big tree. Excellent. A wet breathing can be heard, a drowsy tune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Huh... Paimon still can't understand what you're saying, Arakunti, but whatever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Speaking of which, Paimon didn't think this place would be so large on the inside. Guess this is what they mean when they say \"more than meets the eye,\" huh? Also, is it just Paimon, or does this place feel very different from other places?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Are we going to look for the \"leaves\" that feed energy to the Varuna Contraption in a place like this...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "It's here, but it's not here. One can hear its voice, smell its breath, see its veins... But Paimon can't find it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Huh? What was that about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "If Paimon can't find it, then what about me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "The Golden Nara can see the melody, like the cool breeze of night, the sudden fall of a raindrop, the thousand dream-fragments of a lake's broken surface.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Well, that sure sounds impressive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#As expected of {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Hehe... Wait! You're stealing Paimon's line, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} turning into Paimon... is even scarier than dancing with mushrooms within Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Can't imagine that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "That's why this kind of thing won't happen! Best that it never does...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "And Arakunti, can't you be more clear? Where in the world are we going to find the \"leaves\" of the Varuna Contraption?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "In dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Wait... Then why didn't you say so in the first place!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Because you didn't ask \"where\" in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Huh... Paimon thinks that the Aranara way of communicating has hit her all of a sudden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, can you tell us where each of the three \"leaves\" we're looking for is located?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Wow, so you really only answer questions that are asked directly, huh... Okay, so where are these three locations?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Over here, over there, and on the other side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Uh-huh... Wait, you're not describing anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Aaaand Paimon is defeated.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "Hey! Paimon's defeat is your defeat! They're the same thing! Arakunti's words can't be counted on... So how are we supposed to find those three locations?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "The Varuna Contraption was made by the most remarkable Aranara, so the links between the \"branch\" and the \"leaves\" are invisible yet visible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} can see Aranara, and if you can see the traces of Aranara, you can find your way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "P—Paimon can't believe she understood that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "We'll find it if we follow the trails of Aranara, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Oh, come on, at least give Paimon the chance to answer this time, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
