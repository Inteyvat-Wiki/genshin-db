				"points": []
			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#Thank you, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "I just wanted to tend to the grape vines, and then... this happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "*sigh* Please don't say a word about this to my son. He's one of the Knights of Favonius, so I'm sure he has enough to worry about as it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "There's no need to bother him over a silly old man getting himself into a bit of a pickle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Recently, though, we do seem to be having a bit of a slime problem around the winery area. I worry constantly that they'll demolish my grape vines. It's keeping me up at night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "I don't know if you have the time to spare for an old man like me... but if so, could you chase off the slimes in the area for me, to stop them from getting at my grapes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Sure thing, old man.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Bless you, child! I will rest better for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "No way, old man.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "*sigh* I would happily do it myself, but at my age my strength is not what it used to be... For a youngster like you, this should be no problem. Come on, make an old man's day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
	]
