			"dialogs": [
				{
					"id": 751350201,
					"content": "Wow, Bona, that was super quick! We almost couldn't keep up back there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Haha, sorry, sorry. I just couldn't help myself after seeing the Altar of Primal Flame just up ahead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "So all we gotta do is use this Altar, and we can go to the Tonatiuh, right? But even if a huge wind current were to lift us off the ground, who knows how long we'd have to fly before we get up there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Ugh, just thinking about it is getting Paimon all worried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "Don't be scared, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "Alright, if you say so. But don't stray too far from Paimon, you hear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Anyway, so what we've gotta do now is put the Pyrophosphorite on the Altar, right? But, ah, we've got two on our hands, so... Let's put them both up there, just to be safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "How exciting!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Right? I'm getting super excited too. No real adventurers would wanna miss out on a challenge like this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
