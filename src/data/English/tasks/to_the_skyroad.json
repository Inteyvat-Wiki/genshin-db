			"dialogs": [
				{
					"id": 751350101,
					"content": "Is that the Altar? That's gonna be hard to reach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350102,
					"content": "#We can fly just fine, but how about {REALNAME[ID(2)|SHOWHOST(true)]} and Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350103,
					"content": "Did you forget that I'm an adventurer of the Flower-Feather Clan? I have plenty of flight experience myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350104,
					"content": "#I can get over there, easy, even with {REALNAME[ID(2)|SHOWHOST(true)]} in tow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350105,
					"content": "I have a flying license, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "That'll do. I'll lead the way, so just follow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350107,
					"content": "Is this going to be a race?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Wow, hey, you sure this is the time to get competitive? Relax! I'll lead the way, so just follow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350109,
					"content": "#Hmm... This feels like it could get super dangerous, and we can't know what might happen, so hold on tight, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350110,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
