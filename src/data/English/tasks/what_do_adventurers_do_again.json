			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140401,
					"content": "Do all adventurers do these dangerous things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140402,
					"content": "But what if they get injured...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081405,
			"completionStepIds": [
				7081403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
