				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140701,
					"content": "Have you finished the commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140702,
					"content": "You bet I have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "Wow... So this is the strength of an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140704,
					"content": "Well, um, if you don't mind, could you answer some of my questions about adventurers and commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140705,
					"content": "Other than defeating monsters, what other commissions do adventurers take?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140706,
					"content": "We also help people fix carts and houses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Whoa, doesn't that just mean that you adventurers do everything? I never knew.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140710,
					"content": "Thank you! I'll make note of it for sure... Ah yes, right. This is your repayment, please take it. It's as generous as can be, you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140711,
					"content": "Next time you're here to take commissions from me, I'll make sure to give you the best ones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140707,
					"content": "We help people pick flowers and catch fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140708,
					"content": "We send takeout and play with children.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				}
			]
		}
	]
}