			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Eh? You're back already? Have you completed the commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Done, and done!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "That's... really impressive. I went back to the Guild to reorganize our commissions based on the one I gave you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "There was a whole mountain of commissions related to defeating monsters. So adventurers are supposed to do this sort of thing all the time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "But other than monsters, there've been reports that say that Treasure Hoarders have been seen along the roads.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Is this really also something the Adventurers' Guild should do? It feels like it falls under the job scope of the Millelith...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "We can do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Huh. Adventurers can really do anything, it seems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "Well then, I will prepare adequate compensation for you — so please take this commission, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "What, another one already? We haven't gotten our...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "There'll be further compensation! I've already discussed this with Lan. So as long as you complete the next commission, you'll receive further payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Well, that sounds more like it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "I'll be counting on you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "Well, that's two commissions down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "The secret method Lan taught me to \"get adventurers to take commissions gladly\" really works...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "If the money's good...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Adventurers really are impressive... It seems like you can do almost anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
