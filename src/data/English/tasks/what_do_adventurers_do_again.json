			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "Was there anything else?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "Have you found that sword of yours?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "...Huh, to think you still remember that. Unfortunately, no. I still don't have the foggiest idea where it might be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "It seems I'm still at square one, waiting for things to happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "If anything related to that matter crops up, I might come looking for you — When that happens, I'll be counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081401",
							"2"
						],
						"stepId": 7081401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "A—Are you an adventurer? Are you here to accept commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "Uh, please... wait a moment, let me see what I have here... \"Speed Glider,\" \"Outdoor Survival Experience Guide,\" \"Free Climbing Instructor Wanted...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "That doesn't sound like the Adventurers' Guild...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "I know, and Lan says so too! But all the adventures I've read about in books were something like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "If I don't give out these commissions, what should I give out, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "Something like \"beat up monsters,\" perhaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "I—Isn't that dangerous? I mean, there are a lot of them around Lisha, and they are a threat to passers-by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "But normal people don't stand a chance against them. They might even get hurt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Well then, leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Can you really? Well.. Alright then, I'll leave it in your hands. I'll go back and discuss appropriate payment for your services with Lan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "Adventurers are anything but ordinary.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Is that so... W—Well then, I'll let you handle it. I'll discuss your payment with Lan later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081404,
			"completionStepIds": [],
