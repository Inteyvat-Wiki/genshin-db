			},
			"dialogs": [
				{
					"id": 705170101,
					"content": "This place sure looks pretty normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170102,
					"content": "Guess there won't be anything to eat here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170103,
					"content": "Don't give yourself away too soon, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "*cough* W—Well, y'know, looking for secrets is hungry work! Everyone knows that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170106,
					"content": "And anyway, we've recently been eating barbecue a lot to save time. Aren't you sick of that already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170107,
					"content": "If we can find some shells or conches, we can stew them with some fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170108,
					"content": "They'll be fresh and sweet and springy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170109,
					"content": "That sounds pretty terrible. Not my cup of tea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "Come on, give it go! It might open a whole new culinary world to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170113,
					"content": "#Wait a moment! Look over there, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170114,
					"content": "That's weird, that device just appeared all of a sudden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170115,
					"content": "And there's some luggage nearby, too. Is that Fatui gear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170116,
					"content": "Huh. Right on the Mora, Paimon. Good work.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "Right? Paimon was right on the Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170118,
					"content": "Waaait a moment. There's nothing good about this discovery!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170119,
					"content": "If this is Fatui business, then there's gotta be some scheme afoot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170120,
					"content": "If we leave this thing be, things might eventually get out of control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170121,
					"content": "Whatever the case, let's see what we can do about that device first. If you think we should, let's have a look through that Fatui gear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170122,
					"content": "#Let's do this like we always do, {NICKNAME}, and then we can kick back and start looking for something to eat instead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170111,
					"content": "Sounds like how you'd taste, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "Hey! Paimon isn't some aquacultural product!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170104,
					"content": "Well, that's your enthusiasm explained...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}