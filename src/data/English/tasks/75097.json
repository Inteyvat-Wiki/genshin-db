			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Huh? Is it just Paimon, or are the Statues of The Seven in Natlan a bit weird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "Shouldn't it be more... intense the first time you touch it? Like, there's a \"schwing\"-y sound, that kinda feeling?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Eh, seems normal enough to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "But it really is kinda strange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Hmm, how should Paimon put it... Well, she always felt that before, there'd be a stronger connection established when you touched Statues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "This time, it feels more like hitting a switch, like all that happened when you touched the Statue was that it lit up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "Right, right! Before, when you touched the Statues, you could feel the elemental power. But this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Does it have that Pyro feel, all lively and intense?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(You carefully search within yourself...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Huh... Nothing at all...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "That seems kinda weird no matter how you look at it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(There's none of the scorching sensation you expected...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "Actually, the \"schwing\" before was me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Oh! So you just forgot to \"schwing\" this time, then? Well, next time, try to pay more attention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "AS IF! You better add your own sound effects every time you touch a Statue of The Seven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
