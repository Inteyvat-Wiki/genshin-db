			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "Hehe, that's the way it should be! That's the kind of stable connection with the Statue of The Seven we're looking for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970302,
					"content": "So that issue we were having before was due to that baddie in the Night Kingdom, huh? The Statue of The Seven sure must've been having a hard time back then... Great job, Statue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970303,
					"content": "Though, it's not like you could've granted the power to resonate with Pyro even if you wanted to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970304,
					"content": "Yeah, that happened while I was fighting alongside the Pyro Archon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "Yeah, Paimon was super scared then... But as it turned out, you were too strong for that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970306,
					"content": "Either way, it's great that we managed to get rid of all those Abyss monsters and restore the Statues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}