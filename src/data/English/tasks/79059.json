			"dialogs": [
				{
					"id": 790590101,
					"content": "This is a cut scene from the show \"Journey to the East\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790590102,
					"content": "The original idea revolved around a tale of a traveler and their journey eastwards from Fontaine to Sumeru City to search for unassuming wisdom in the House of Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790590103,
					"content": "This scene concerned how the traveler saved the \"Master of Earthly Transformations\" from being crushed by a massive boulder, and their adventures on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790590104,
					"content": "Unfortunately, the Hydro Eidolons acting the part of both the traveler as well as the Master of Earthly Transformations have disappeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790590105,
					"content": "If only someone could <color=#00E1FFFF>bring them both back</color>, and capture the rehearsal by the huge boulder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Scene Notes"
				}
			]
		},
