					"Qiaoxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "I can't cope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Hmm? Who goes there? All who wish to cross this bridge are subject to interrogation, those are the rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "That said... Just look at what you're wearing! You're definitely not someone I need to worry about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Why? Think about it — criminals would want to dress as discreetly as possible, no? You, on the other hand, are dressed most ostentatiously indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "I am the Millelith responsible for this zone. This is a major thoroughfare to Dihua Marsh. Merchants and tourists all pass this way, so I'm stationed here to stand guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Just the other day, I discovered a group of monsters nearby... It appears they've set up a camp, and although they haven't made a move yet it's definitely a safety risk. I need to keep an eye on them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "I'd happily go and clear them out... except, I worry that if I left my post here, some other monsters would seize the chance to ambush passers-by. I feel so helpless, stuck here all day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "I dealt with the monsters.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Seriously? All of them? That's... fantastic!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "This was a huge help. I am sorry I had to ask you — it should have been my job, but you ended up doing it all for me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "Ugh, I don't know what the higher-ups are thinking, they really should have sent some more people by now. This zone is far too big for only one person...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "They will be getting a full report on this situation as soon as I have the opportunity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "You have my thanks. Please take these for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
