			"dialogs": [
				{
					"id": 210039901,
					"content": "How is it coming along?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039902
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039902,
					"content": "I have dealt with the monsters.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210039903
					]
				},
				{
					"id": 210039903,
					"content": "Thank you, it's a huge help. I am sorry I had to ask you — it should have been my job, but you ended up doing it all for me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039904
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039904,
					"content": "...There's no point you trying to play it down, you're covered in dust, which I'm sure is from a tooth-and-nail battle with the monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039905
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039905,
					"content": "Ugh, I don't know what the higher-ups are thinking, they really should have sent some more people by now. This zone is far too big for only one person...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039906
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039906,
					"content": "It may be just a couple of bridges, but so much human traffic comes through here every day. If anything were to happen here, it would be catastrophic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039907
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039907,
					"content": "The higher-ups will be getting a full report on this situation as soon as I have the opportunity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039908
					],
					"speakerTitle": "Qiaoxi"
				},
				{
