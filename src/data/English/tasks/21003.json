			"dialogs": [
				{
					"id": 210030111,
					"content": "*sigh* If only we had more men, there'd be no issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "I'd happily go and clear them out — except, I worry that if I left my post here, some other monsters would seize the chance to ambush passers-by. I feel so helpless, stuck here all day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Can you go and sort out the monsters over there for me? It would free me up to concentrate on other matters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
		{
			"id": 2100311,
			"completionStepIds": [],
