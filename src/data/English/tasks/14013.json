			},
			"dialogs": [
				{
					"id": 140130301,
					"content": "I'm just finishing packing up. As soon as I'm done, I've got an interview with the Steambird to get to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140130302
					],
					"speakerTitle": "Pauleau"
				},
				{
					"id": 140130302,
					"content": "Thanks to all your help, the show was more perfect than we ever could have hoped for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140130303
					],
					"speakerTitle": "Pauleau"
				},
				{
					"id": 140130303,
					"content": "But most of all... I want to thank you for giving me the chance to finally say farewell to Aurelie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pauleau"
				}
			]
		},
		{
			"id": 1401304,
