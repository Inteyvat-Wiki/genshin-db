				"points": []
			},
			"dialogs": [
				{
					"id": 140130401,
					"content": "It's ironic to think that in my whole time as a \"god,\" I could only ever dream of receiving this kind of power...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140130402
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140130402,
					"content": "And now that the gods have given me their blessing... It actually feels more like I'm finally able to take my fate in my own hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140130403
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140130403,
					"content": "Is... is that how humans feel about it as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
