	"talks": [
		{
			"id": 2302801,
			"completionStepIds": [
				2302801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
