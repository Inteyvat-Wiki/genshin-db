				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "Traveler! Thank goodness you're here. I was just in need of someone's help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280102,
					"content": "Is there anything wrong with the Divine Tree's roots?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "Oh, the Divine Tree is perfectly fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280104,
					"content": "And my job here is to keep it that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280105,
					"content": "To be specific, I am sprinkling these potions around the tree's roots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280106,
					"content": "Unfortunately, I can't move all these potions on my own, while Ladep and Pharez are busily engaged in their own work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280107,
					"content": "As such, I could really use your help in moving these potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280108,
					"content": "Ladep and Pharez? Who are they, again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Oh, they are students, just like me. But Ladep is from Spantamad, and Pharez is from Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280110,
					"content": "We are researching on a shared topic, thus the cooperation despite our different ideologies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280111,
					"content": "These potions, for example, are the fruits of our teamwork.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280113,
					"content": "Okay, I will carry this one, and I'll be counting on you for the rest. Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280114,
					"content": "Careful now. Ladep said the potions were intentionally made with a foul odor so that no one would drink them by accident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280115,
					"content": "Try not to get any on your clothes... The smell won't wash off easily at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280112,
					"content": "Well, let's go then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302804",
							"2"
						],
						"stepId": 2302804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awan",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmin? What are you doing here? Ugh... Are you here to sprinkle your potion again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280402,
					"content": "Those roots look perfectly fine. No more potions are needed here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280403,
					"content": "Even so, we should take good care of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280404,
					"content": "Crossing the bridge only when we get to it is like getting a Fish Roll ready, only to realize that the fish is undercooked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280405,
					"content": "At that point, your options are either to start all over again or to open up the already rolled pastry, both of which are a pain in the neck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280406,
					"content": "Okay, okay, I can't beat you in an argument... But I have talked to you about the smell of that potion, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280407,
					"content": "I live nearby, and I don't want to sleep with that funky smell in my nostrils, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280408,
					"content": "Don't worry, I already had Ladep adjust the formula. The odor shouldn't be too offensive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280409,
					"content": "Fine then, I'm leaving. Don't come sprinkling that potion of yours near my yard. I can't take it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280410,
					"content": "Alright, I get it. Traveler, could you pass me the potions in that case?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280411,
					"content": "You administer the potions with Yasmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "The potions really do smell terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "But it seems that you're not bothered by it at all, Yasmin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "If you mean the smell... My nose has whiffed many things far worse than that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280415,
					"content": "Alright, that should be all we need. I have also gathered some data. I'm sure Pharez will be thrilled...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280416,
					"content": "Here is your payment, Traveler. Thank you for your help so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280417,
					"content": "I wonder how Ladep and Pharez are doing with their work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
		{
			"id": 2302805,
			"completionStepIds": [
				2302806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
