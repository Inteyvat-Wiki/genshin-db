				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "That should do it... I hope these materials will actually be useful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Are you still organizing files?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "Oho! Pleasure to see you, Honorary Senior Researcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "That's correct! I am continuing to organize the documents and files according to Mr. Raimondo's instructions... Wait, haven't I said this before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "But this place is huge! It's way too much work for one person. Why didn't he assign anyone to help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "The Research Institute has many pressing matters to deal with. It's normal that there's no one available to help me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "And you're a Director too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "You mean my title as Fontaine Research Institute Materials Retrieval Project Director? *sigh* Please don't mock me so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "In what way am I actually a Director? From the very beginning, I have been no more than an ordinary staffer responsible for organizing files.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "After Mr. Raimondo assigned me here to organize the files, I was suddenly informed of my new title.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Someone said this was Mr. Choiseul's idea. Apparently he thinks that since our work is so onerous, giving us such titles will make providing additional compensation easier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ah! Don't tell anyone else, how could I... how could I just say it out loud like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "I'm the silent type, relax.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "That sounds not bad at all! And after all, it's only fair that those who do all the work should receive a bit more compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "But why use such a roundabout method? Can't they just give everyone more Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "This seems par for the course here at the Research Institute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "*sigh* I can never understand just what the two of them are thinking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "But I have to keep working, no matter what! There's too much to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "Honorary Senior Researcher, if you are willing, could you please give me a hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "It is my duty.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "In that case, please help me clear out some of the filth around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Be sure to do your best <color=#00E1FFFF>not to touch the nearby books and files</color> while you're cleaning. It would be absolutely awful if they were damaged by the cleaning...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "I'll leave that to you then! As for me, I'll keep organizing the files here. *sigh* I never noticed there were so many files in the Institute before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "Don't forget to make the \"honorary\" in my title even more honorable!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Hahaha, not a problem! I will testify to your kindness and contributions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "As long as you actually receive the extra Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
