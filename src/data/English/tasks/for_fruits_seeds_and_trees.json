			"dialogs": [
				{
					"id": 730350301,
					"content": "How did this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350302
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350302,
					"content": "Why would The Withering be in the Ashvattha Tree's dream?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350303,
