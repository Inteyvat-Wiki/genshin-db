			"dialogs": [
				{
					"id": 730350501,
					"content": "#Are you ready to enter the Ashvattha Tree's dream, Nara {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350502,
						730350507
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350502,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350503
					]
				},
				{
					"id": 730350503,
					"content": "#Paimon believes it won't be a problem for {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350504,
						730350505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350504,
					"content": "(Reach out to the Ashvattha Tree...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350505,
					"content": "Maybe some more time to ready myself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350506
					]
				},
				{
					"id": 730350506,
					"content": "Sure. Let me know when you're ready. I'll go with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350507,
					"content": "Give me some time to get ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350508
					]
				},
				{
					"id": 730350508,
