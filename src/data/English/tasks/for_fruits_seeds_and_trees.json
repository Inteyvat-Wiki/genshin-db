			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350101,
					"content": "Arama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350102,
					"content": "#Nara {NICKNAME}, Paimon, you seem fresh, like fresh Zaytun Peaches. But Paimon looks unhappy. Did you have a nightmare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350103,
					"content": "Paimon was afraid you'd abandoned us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350104,
					"content": "Why would you think that? I've been here the whole time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350105,
						730350114
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350105,
					"content": "What's wrong, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350106
					]
				},
				{
					"id": 730350106,
					"content": "B—Because Vanarana is in a dream, and the fun we had at Festival Utsava was like a dream... Paimon was afraid that everything would all go away once we woke up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350107,
					"content": "We'd be all that's left, just like when we first started the journey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350108,
					"content": "But the things that happen in dreams are real. I have observed Nara before and found that nightmares would make them timid, and that nice dreams would make them happy, just like things that happen outside their dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350109
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350109,
					"content": "So when Paimon dreamed of meeting us and also dreamed of meeting Vanarana, Paimon, it was as real as doing both in reality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350110,
						730350112
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350110,
					"content": "And Arama is here too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350111
					]
				},
				{
					"id": 730350111,
					"content": "That's right! I'm here waiting for you to go to the Fane of Ashvattha together, to get the Bija, and to make Narana feel better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350116,
					"content": "#...That's true. Bah, {NICKNAME}, you must have put weird mushrooms in the feast to make Paimon think about such stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350117,
					"content": "Let's go, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350112,
					"content": "And we still have to help Rana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350113
					]
				},
				{
					"id": 730350113,
					"content": "Yes, we have to go to the Fane of Ashvattha to get the Bija, and to make Narana feel better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350114,
					"content": "Don't get in your own head, Paimon. Let's go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350115
					]
				},
				{
					"id": 730350115,
					"content": "That's right. We've got to go to the Fane of Ashvattha to get the Bija so Narana can get better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				}
			]
		},
		{
			"id": 7303502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303509",
							"2"
						],
						"stepId": 7303509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"302821",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#Wonderful, this place isn't corroded by Marana like Arayama and the others were! Nara {NICKNAME}, Paimon, this is the Ashvattha Tree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350202,
					"content": "Whoa, what a weird-looking tree...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350203,
					"content": "That's rude, Paimon! You'll make the Ashvattha Tree mad! This is a very, very mighty tree — the oldest Vasara Tree there is. Even older than any Aranara and their stories...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350204,
					"content": "Queen Aranyani sang here — thousands of moons ago, or perhaps even more. She had just left Valuka at the time, and the woods weren't as lush as now, so there was still lots of sand on the ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350205
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350205,
					"content": "Her Ararakalari was more powerful than any Aranara's, since her song was the closest to the Sourcesong. So Ashvattha responded to her call and sprouted from Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350206,
					"content": "Queen Aranyani told Ashvattha that there were many smart, beautiful, yet lonely Nara in the woods and that the children of the forest must increase so that they might become friends with the Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350207
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350207,
					"content": "Therefore, Ashvattha produced a beautiful and full pomegranate with many seeds inside, the first of which to sprout was Aramuhukunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350208,
					"content": "That made Aramuhukunda the very first Aranara. Later, all the seeds grew and Aranara spread like leaves on a tree. We and Nara were both people of the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350209,
					"content": "That's why the Ashvattha Tree is very powerful and very important! Just like Nara bear Nara children, all Aranara are progeny of Ashvattha and Queen Aranyani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350210
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350210,
					"content": "So that's how it is... Sorry, Arama. The Ashvattha Tree is super impressive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350211,
					"content": "How rude of you, Paimon, calling someone's mother weird like that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350212,
					"content": "Paimon didn't mean to! Anyway, what do we need to do now to get the Bija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350214,
					"content": "Right. Just like trees need earth and rain to flourish, dreams and memories are what a Vasara Tree needs. As I mentioned a moment ago, the Ashvattha Tree is the oldest of the Vasara Trees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350215,
					"content": "That's why we've brought three Vasoma Fruits from Araji, Arayama, and Aramaha as offerings for the Ashvattha Tree to bear great fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350216,
					"content": "Araji, Arayama, and Aramaha's Vasoma Fruits? Don't you mean the fruits of the Vasara Trees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350217,
					"content": "That's what they are, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350218,
					"content": "#Stand closer to the Ashvattha Tree, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350219,
					"content": "Whoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350220,
					"content": "That's amazing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "Yes, all Aranara are descendants of this tree. You're now connected to all Aranara, and you bear their blessings, and so the Ashvattha Tree shall bless you too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350223,
					"content": "For as long as you wear this garland, the Ashvattha Tree will recognize you as a child of the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350224,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350225,
					"content": "Something's wrong with the Ashvattha Tree. It feels a bit weak... This must be because of the Marana that's been showing up everywhere lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350226,
					"content": "Regardless, we're going into the Ashvattha Tree's dream next, and we'll offer the Vasoma Fruits to the Tree of Dreams. That should rejuvenate it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350227,
					"content": "#So we're doing this like we did back in Ashvattha's Concourses, right? {NICKNAME} will reach out and \"Woosh,\" we'll be in the dream!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350228,
					"content": "#Yes. Very smart, Paimon. So if you're ready, Nara {NICKNAME}, reach your hand out and let's enter the Ashvattha Tree's dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350229,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350230,
					"content": "#Arama just mentioned Marana... Paimon wonders what we'll see in this dream! Oh well, it's fine! We've got {NICKNAME} around, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350231,
					"content": "(Reach out to the Ashvattha Tree...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "Give me some time to ready myself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "Sure. Let me know when you're ready. I'll go with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350234,
					"content": "Give me some time to get ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350235,
					"content": "Sure. Let me know when you're ready. I'll go with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
