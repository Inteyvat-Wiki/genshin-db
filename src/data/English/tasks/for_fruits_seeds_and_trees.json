			"dialogs": [
				{
					"id": 730350401,
					"content": "The heart of the Ashvattha Tree is glowing... Is that the Bija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350402,
					"content": "It hasn't been easy, but Rana can finally be healed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350404,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350405,
					"content": "Arama...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350408,
					"content": "The Ashvattha Tree has been corroded by Marana and cannot bear any Bija. I have to plant a new Ashvattha Tree in order to help you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350409,
					"content": "But won't it require a long time to grow from a seed to a tree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350410,
					"content": "Don't worry, the speed of a Vasara Tree's growth has to do with its seed. The Ashvattha Tree has given me all its power, and with the Vasoma Fruits and our shared memory, it will be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350411,
					"content": "Thank you, the first Ashvattha Tree. Thank you, Araji, Arayama, and Aramaha. I will utilize your memories to rebuild the path between the new Ashvattha Tree and the dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350412,
					"content": "Do you get the feeling that Arama's different now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350413,
					"content": "Am I? I learned a lot of new things, figured out lots of new words, and obtained a lot of memories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350414,
					"content": "But rest assured, I'm still me, your friend. I will help you for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350415,
					"content": "Then the Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "Old Vanarana is sealed deep within the Fane of Ashvattha. That's where we'll find Marana's Avatar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350420,
					"content": "It will imbue the land and Sarva with viper venom until everything green turns brown, every flower has withered, every brook is putrid, and every creature is dead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350421,
					"content": "We must destroy it. Only then can a tree strong enough to produce the Bija grow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350416,
					"content": "I believe you. What do we do now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#So long as you understand, Nara {NICKNAME}, it's all good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350406,
					"content": "What's going on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
		},
