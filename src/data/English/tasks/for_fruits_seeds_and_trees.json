			},
			"dialogs": [
				{
					"id": 730350901,
					"content": "Finally we are here. Huh... Paimon remembers that we could see this mysterious tree in other Vasara Trees' dreams as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350902,
					"content": "#I'm sorry, Nara {NICKNAME} and Paimon. It escaped me that Marana has also corroded the Ashvattha Tree's dream...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350903,
					"content": "Countless black pests are corroding the roots of the Tree of Dreams in Sarva. I can feel Marana's hands, shaking the dream to its core.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350904,
					"content": "Sorry... I should have known this would've been the case when we saw Marana in Ashvattha's Concourses before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350905,
					"content": "#It's okay! We fixed this easily with {NICKNAME} around, didn't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350906,
					"content": "Then the Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#The Vasoma Fruits should at least restore some of his power. I'm counting on you, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350914,
					"content": "Yes, I understand. I didn't think it would be so soon, but I'm aware that I'll know what to do when the time comes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350915,
					"content": "Just like the clouds know that they must release rain, and the rain knows that it must fall to the ground, seeds know that they must grow into big trees and bear lots of plump fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350916,
					"content": "Something's weird about Arama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350917,
					"content": "Oh, I was just speaking to the Tree of Dreams. Huh, so you couldn't hear it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350918,
					"content": "Paimon's seen Aranakin talking to mushrooms before... But people can't normally communicate with plants, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350919,
					"content": "I see! I just learned something new. Thank you, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350920,
					"content": "#Don't worry about the Bija, Nara {NICKNAME} and Paimon. Let's just leave the dream for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350907,
					"content": "Piece of cake.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "But... Will what happened here affect the Bija in any way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350909,
					"content": "Well, it wasn't as easy as Paimon made it sound...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350910
					]
				},
				{
					"id": 730350910,
					"content": "Well, you did it regardless, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350911,
					"content": "But... Will what happened here affect the Bija in any way?",
					"roleType": "TALK_ROLE_NPC",
