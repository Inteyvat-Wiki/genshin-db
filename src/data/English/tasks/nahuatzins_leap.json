			"dialogs": [
				{
					"id": 751480201,
					"content": "Huh? Was that... a Qucusaur? So, Qucusaurs really do bring the stolen statues here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Wait. Did it just grab that statue and jump... straight into the crater!?",
