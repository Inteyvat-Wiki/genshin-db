			"dialogs": [
				{
					"id": 751480101,
					"content": "Chosen of Dragons, O Chosen of Dragons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480102,
					"content": "Ascend to the circlet's highest pinnacle — then hurl yourself into the Sacred Mountain's fire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480103,
					"content": "Go forth and reveal it — break the golden seal, unveil the radiance of remnant flames unnumbered!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480104,
					"content": "Rrroar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "What's wrong? Did you see a bunch of strange words again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480106,
					"content": "The words feel... clearer now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "Oh, you mean it's because we're getting closer to the volcano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480109,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "...It's almost as if the person who's been talking to you all this time is in that mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480111,
					"content": "Anyway, since those things are showing up as we're getting closer to the volcano, that's gotta mean we're on the right track.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480112,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "It feels like... we're getting closer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
