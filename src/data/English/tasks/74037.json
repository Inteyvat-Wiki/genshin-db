					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "The pipes here need to be changed... and the valves... there's also the matter of cleaning the thing... *sigh* Problems on top of problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Huh? Do you need something? From the look of you... You're not Estelle's repair crew...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "About Remaudiere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Oh, him? Heh, his magic is really something. It rusted a valve in the fountain's bottommost piping and also completely broke the nozzle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Hahaha, I jest. Actually, it was the deformed valve getting stuck that jammed the entire water system. For safety reasons, we temporarily shut down the entire fountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "But why did the nozzle break? I really don't know... It's so weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudiere keeps saying if the fountain doesn't get fixed soon, he's going to get chewed out... But there was only so much I could do previously...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "I finally had some time to order a new valve and nozzle from Estelle today, and I'm about to go to the city to get it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "You can come with me if you want. I have quite a lot of things to collect, so I'm a little worried that I won't be able to manage on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
