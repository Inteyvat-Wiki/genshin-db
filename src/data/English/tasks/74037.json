			},
			"dialogs": [
				{
					"id": 740370701,
					"content": "These should be enough! Hang on, it'll only take me a second.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle begins working in a frenzy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Alright, done! We've got the valve and nozzle, as well as all the general components we'll need. It's all ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "Edel, Traveler, let's head to Erinnyes. As long as I'm there, the fountain should be fixed in no time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "Thank you... I'll take these things, Traveler. Let's get going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
		{
