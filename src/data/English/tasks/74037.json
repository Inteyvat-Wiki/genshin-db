					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "I'm here for the valve and nozzle. If the fountain isn't fixed soon, we'll drive that kid Remaudiere up the wall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "Th—The valve, you say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "Uh, why are you stuttering? Estelle... You didn't forget to make it, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "No! I did make one. But... a previous client had to do urgent repairs on something else...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "S—So I, uh, gave her some general parts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "Don't worry! I'm in the midst of making a new one right now! It'll be ready shortly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Miss Estelle, I put that order in long ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "I know! But that client of mine was in a hurry. She claimed that she needed to repair a sewage valve, and her pleading got the better of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "It's alright! Once... once the Iron Chunk I purchased arrives, I'll be able to make that valve! It should be here soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "When did you put that order in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "Th—This morning...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Leave the matter of the Iron Chunks to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "Really? Excellent, then, excellent! We'll be counting on you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "Sorry! I'm really sorry! Just three Iron Chunks will be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "Well, we'll be counting on you, Traveler. Don't worry about remuneration. I won't have you working for free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "I'll go get you those Iron Chunks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
