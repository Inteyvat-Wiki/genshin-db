						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Long time no see! How's the world outside of Yashiori Island?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "It's a lot wealthier than my hometown. They have a lot of good food and fun things to do. But... I can't say that I really like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Oh? Why's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "The people here all seem to be missing something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "When we used to live in Yashiori Island, Her Excellency was a distant yet calming presence to us... We didn't care where she was, but we believed that she was right there, watching us, protecting us, deciding how we should live our lives and what kind of people we should become...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "But here, Her Excellency covers everything and oppresses everything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "*sigh* I'm not really sure how to put it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "We're still trying.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "By the way, have you found anything concerning my mother?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
