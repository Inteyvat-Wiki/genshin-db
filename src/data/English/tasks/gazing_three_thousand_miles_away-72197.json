					]
				},
				{
					"id": 721401921,
					"content": "Do you understand the risks you're taking?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "...",
