					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401922,
					"content": "If no one went on adventures because they didn't know all the risks... Well, there wouldn't be any adventurers in the world, would there?",
					"roleType": "TALK_ROLE_NPC",
