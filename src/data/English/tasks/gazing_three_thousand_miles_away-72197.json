			},
			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME}, you're back. Did you bring any crystals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721971802,
					"content": "Yes, I did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "I'm on my way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "Take your time. You can take a rest here too if you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
		{
			"id": 7219719,
			"completionStepIds": [
				7219721
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7219721",
							"2"
						],
						"stepId": 7219721,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chouji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "This should be enough Crystal Marrow. Now it's time to start my adventure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401903,
					"content": "Take care of yourself now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "Keep in touch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "Paimon's still worried about this kid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401905,
					"content": "Yeah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401906,
					"content": "Hey, Chouji, you'd better stop running your mouth! You should feel lucky that you met us... otherwise, you'd get beaten up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401907,
					"content": "Also, in case any bad guys want to fish for any information from you, be sure not to tell them the truth! Make up a story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401909,
					"content": "Paimon's turning into a naggy old granny.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "And also...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401911,
					"content": "I have faith in him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "Anyone would be worried if a little kid like him went out on an adventure all by himself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401912,
					"content": "...Hmph, sure you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401913,
					"content": "Hahahaha! Thank you, thank you both!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401914,
					"content": "I hope we'll meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401915,
					"content": "Promise Paimon that you'll stay safe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401916,
					"content": "I'll be fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401917,
					"content": "Next, I'll head to Tatarasuna, where Mom used to work. Maybe someone can tell me if she's been there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401918,
					"content": "And then... I'll try to go to Narukami Island and travel to Snezhnaya via merchant ship. After that, I'll just see how things go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401920,
					"content": "Do you know what you're talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
