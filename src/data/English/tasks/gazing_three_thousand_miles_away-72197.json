				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#Hello, {NICKNAME}! How've you been?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401703,
					"content": "You stole my line!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "Paimon's been great, and you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401705,
					"content": "Paimon, gunning for an extra meal, are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "Haha, that's 'cause you're too slow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401707,
					"content": "You misunderstand. I mean you're the extra meal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "Of course. Paimon could always go for an extra meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401708,
					"content": "Hey now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401709,
					"content": "Pfft... Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401710,
					"content": "All right, all right, you guys, please stop fighting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401712,
					"content": "Sure, shoot. What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "I'll see what I can do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "I'm doing fine. But I'd like to ask you for another favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401714,
					"content": "#Well, it's nothing special. I just need you to help me get some more crystals, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401716,
					"content": "I trust you, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "Believe me, I'll reward you for your help... As long as you trust me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401718,
					"content": "Why?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "You promised to give me an explanation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "But...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401720,
					"content": "Right. We still don't know why you need so much Crystal Marrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401722,
					"content": "But the Shogunate has monopolized the crystal market.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "You know that these crystals aren't easy to sell, don't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "Well... I need money to travel so that I can find my mother, so I need to trade the crystals for money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401725,
					"content": "You're playing a dangerous game here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "I'm worried about your safety.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "I know, but I'll find my own way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401727,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401728,
					"content": "We're friends, aren't we, Chouji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401729,
					"content": "Maybe we can help you again, just like last time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401731,
					"content": "What a mercenary philosophy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "Besides, you promised that you'd reward us. So we have the right to know about things that might endanger your and thus affect our reward, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401732,
					"content": "Pfft... Paimon's right, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401733,
					"content": "I don't collect crystal entirely for money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401734,
					"content": "I've been thinking... What if Mom and Dad get the disease caused by the Tatarigami, just like everyone else?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401735,
					"content": "Maybe these crystals can be used to make medicine. They grew from the bones of the giant serpent, after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401736,
					"content": "And Mr. Yasumoto also mentioned that these crystals may be useful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401737,
					"content": "But you can't be sure if that's correct, can you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401738,
					"content": "Maybe not, but we don't have anything else to go on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401739,
					"content": "When I find Mom... or maybe even Dad, I'll take them to Sumeru. People say that they've got cure for this strange disease there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401740,
					"content": "Before that, I can't give up any hope of finding a treatment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401742,
					"content": "Do you even need to ask?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "I hope you can make good use of the crystals.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "Well, I've said enough. Still want to help me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401744,
					"content": "Thank you! I won't forget this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
		{
