						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Emilie"
				],
				"points": [
					{
						"sceneId": 51206,
						"position": [
							2192.554,
							230.089,
							-777.292
						],
						"pointId": 1
					},
					{
						"sceneId": 51206,
						"position": [
							2195.024,
							230.219,
							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "Care to give this a try, Miss Emilie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "Your artistry is truly a pleasure to watch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510203,
					"content": "Hmm... This tastes like a local variant of a Lumidouce Twilight. Am I right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510204,
					"content": "You're spot on.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "The gentle and elegant taste, with its distinct layers, combined with a hint of Mondstadt's characteristic scent, offers quite a welcoming flavor, all the while avoiding potentially discordant aromas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510207,
					"content": "Though in reality, there's no need for you to be so conservative. I have quite a high tolerance for flavors that stray outside the boundaries of conventional wisdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510208,
					"content": "So this one's probably a bit too traditional, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "Your drink was nice, but it would be perfect if you could make one with a little more... depth. A cocktail that shows off your unique understanding and enhances my impression of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510211,
					"content": "If you need time to mull things over, perhaps you might find inspiration in a little light conversation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510212,
					"content": "Did you buy these flowers just now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "They're part of my reward from the flower shop owner — important ingredients for making perfumes. Thanks to these, I was able to complete my commission for The Cat's Tail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510214,
					"content": "I studied Mondstadt's Cecilia flowers many years ago. In fact, the fragrance of Cecilia, in certain fields, has become synonymous with Mondstadt itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510215,
					"content": "However, this is a special case. Some cats are quite averse to the scent of Cecilia, and we need to be particularly mindful of their preferences...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510216,
					"content": "So what did you use for your aroma this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "Windwheel Aster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510219,
					"content": "The various parts of the Windwheel Aster plant can be ground into a powder to extract their essences. I then blended the scents from its petals and leaves. The result carries the intoxicating sweetness of mead, while still emphasizing the fresh notes contained within the flower's stems and leaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510220,
					"content": "I just took it for a little trial run at The Cat's Tail, and the cats seemed to really like it, while the clients themselves found it comforting and invigorating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510221,
					"content": "Extracting exquisite fragrances from ordinary, overlooked ingredients... that's what truly brings me joy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510222,
					"content": "The weather's nice today...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(So this is what it feels like to start a conversation with a classic ice-breaker...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "It really is! A while earlier, I watched a whole run of fair-weather clouds float by, fluffy as pillows... It's not overly humid either, and the wind is gentle, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510225,
					"content": "In such conditions, one's sense of smell is heightened, but not to an excessive degree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510226,
					"content": "When scents are blended well, they naturally combine with the ambient context, leaving particularly powerful impressions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510227,
					"content": "I never realized scents were so affected by the weather...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "It seems something similar is true for mixology. As long as you choose a base of appropriate strength, the various flavors will blend seamlessly together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510230,
					"content": "When mixed properly, all the ingredients work as one to create a most wonderful symphony for your taste buds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510231,
					"content": "I see, so the combination of flavors is key...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "Yes... That's it! Now I think about it, layering distinct flavors doesn't really suit my personal preferences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510234,
					"content": "What do you usually drink?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "Usually, hmm... After work, my friends from the Maison Gardiennage sometimes treat me to a few drinks. I usually stick to fruit tea — that way, I can get straight back to work after our gatherings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510236,
					"content": "If it's before a holiday and my friends are in high spirits, I sometimes order a small glass of sparkling fruit wine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510237,
					"content": "There was an officer named Turenna who used to treat me to aged Corte wine. But since she was transferred to the Special Security and Surveillance Patrol, we haven't had the chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510238,
					"content": "Oh, so you do drink alcohol sometimes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "In the world of science, high-proof alcohol is a widely used solvent. I've grown well-accustomed to the smell of it by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510241,
					"content": "Besides, when I'm slightly tipsy, my state of mind changes, which in turn alters my approach to perfumes... It doesn't matter if the result is good or bad — it's all about trying something new.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510242,
					"content": "So I don't mind drinks with just a little bit of alcohol, but I don't like anything too strong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510243,
					"content": "How's everything been with your perfumery lately?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "Oh, thank you for asking. It's been going well, though this trip to Mondstadt has presented some... unexpected challenges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510245,
					"content": "When I first got here, I was relying on a copy of \"An Overview of Aromatic Substances and the Human Senses\" to identify promising local ingredients from the Mondstadt region.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510246,
					"content": "To my surprise, my trial fragrance — which used Valberry as the primary note — proved far too sweet in the context of a tavern, \"relaxing\" people so much that they ended up feeling drowsy... The bartender with the beautiful ears, for instance, fell asleep right at the bar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510247,
					"content": "I never knew Valberries could have that effect...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "Let's just say that sweetness isn't always a case of \"the more the merrier.\" Maintaining an appropriate balance is beneficial for both body and mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510250,
					"content": "Even in daily life, I rarely eat sweet food, and I try to avoid fruits like berries that have a high sugar content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510251,
					"content": "In the end, I completely eliminated Valberry as an ingredient and turned instead to Windwheel Aster — with some success, I might add.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
