					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#Good afternoon, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510102,
					"content": "...I didn't expect the honor of witnessing your \"harmonizing\" talents here in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510103,
					"content": "Here on vacation?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "Both, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510106,
					"content": "A lady calling herself a mage asked me to come manage her flower shop. At about the same time, The Cat's Tail commissioned me to create a new fragrance for their establishment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510107,
					"content": "Ending today's busy schedule with a drink crafted by you in person is truly a wonderful reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510108,
					"content": "Then I'll make sure to pull out all the stops!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "I have faith in your choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510111,
					"content": "(Emilie is more sensitive to aromas than most people. If I create an unbalanced blend of scents, it might make her uncomfortable...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(In any case, I should use ingredients with complementary scents, and try to add a dash of Fontainian flavor too.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(Let's start with a Mondstadt take on a \"Lumidouce Twilight.\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "I'll mix you a special surprise!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "Here on business?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
