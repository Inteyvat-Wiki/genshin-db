					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680404
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680404,
					"content": "Could you repeat that method of yours to me again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Eh, allow me. Basically, you need to search for something nearby known as a Thunder Sakura Bough and touch it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "After that, something known as an Electrogranum will attach itself to you, and that will allow you to pass through the barrier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
