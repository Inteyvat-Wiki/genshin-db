			"dialogs": [
				{
					"id": 718202101,
					"content": "Hey, have you found Mr. Bohuan yet? Is he on board with my plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202102,
					"content": "He promised to go with you, but he'll need a moment to get here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "Great, I ran into Qingzhou earlier, and he seemed quite perturbed. He went out for a walk, saying that he needed to look for some inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202104,
					"content": "I'm beyond grateful. I'll wait for Mr. Bohuan here and fill him in on the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202105,
					"content": "Then, I need to stay the course with all the unfinished matters in Liyue Harbor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202106,
					"content": "Looks like my back-and-forth trips between Wangshu Inn and Liyue Harbor will continue for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202107,
					"content": "We'll head to Qingce Village as soon as I'm done with all the outstanding tasks. Should you wish to join us, you can meet us there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202108,
					"content": "Eh, if only I could handle my workload faster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				}
			]
		},
