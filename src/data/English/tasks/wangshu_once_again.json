			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Each Lantern Rite is the same old story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200202,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "We're in a bit of a pickle. A lot of our staff have gone back home to spend the Lantern Rite with their families. It's difficult to run the inn like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200204,
					"content": "Greeting the guests, decorating the inn, and making preparations for the celebration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200205,
					"content": "All on top of our regular responsibilities, of course... There's no way Smiley Yanxiao can keep up with this workload...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200206,
					"content": "If you don't mind, Traveler, could you lend him a hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200207,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "I'm sure he'll appreciate it. You'll find him in the kitchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200209,
					"content": "I still have some things to finish up here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Smiley Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "Who's that!? The kitchen is staff only... Oh, it's you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718200302,
					"content": "Do you need something? If you're looking to order food, it could take a while... It's incredibly busy at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718200303,
					"content": "I'm here to help out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "You came to help? Oh... I can't complain about that! Not when I'm completely swamped...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718200306,
					"content": "Could you go downstairs and get the cooking ingredients that just came in for me? I need them very urgently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718200307,
					"content": "While you're at it, you can also take these Xiao Lanterns and hang them on the two trees by the entrance to the inn... The innkeeper's been nagging me about it for way too long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718200304,
					"content": "Do you want help with anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Smiley Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "How did it go? Is everything taken care of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718201502,
					"content": "Yep, all done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Thanks, I owe you big time. Now, I need to get these dishes out, pronto, or else the customers will start complaining...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "Oh, you're back. Is Yanxiao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "He should be able to manage now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "That's good. Thanks for your help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Nothing here either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201605,
					"content": "Huh? Wang'ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "Traveler? What a coincidence! I didn't expect you to be here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201608,
					"content": "One could say I'm delivering Xiao Lanterns... Have you heard about Qingce Village? It's pretty far off from the city. Most of the villagers are either children or the elderly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201609,
					"content": "So each year around the Lantern Rite, the Ministry of Civil Affairs delegates a representative to bring them some essentials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201610,
					"content": "The first batch has already been delivered, but I'd like to go a step further and make sure that the festive atmosphere makes its way to the village as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201611,
					"content": "That's why I asked poet Qingzhou to prepare some lantern riddles and go to Qingce Village to entertain local children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201612,
					"content": "Qingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "A poet of his reputation should be up to the task. I also wanted to involve Mr. Bohuan. He's a pretty good calligrapher. It would be amazing if he could help the elderly write their wishes on Xiao Lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201615,
					"content": "However, despite my best efforts to find him, Mr. Bohuan is nowhere to be found. Someone told me that he'd gone gathering materials in Dihua Marsh, so I came here looking for him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201616,
					"content": "Wouldn't harm to ask the boss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Mr. Bohuan? Let me think... He came to the inn not too long ago. He mentioned he'd be gathering things nearby...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "I wouldn't be surprised if he's since left the area. There are a lot of monsters lurking in the wild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "I see... But I already told Qingzhou to meet me at Wangshu Inn. He'll be coming here shortly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201621,
					"content": "Could you find Mr. Bohuan for me, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201622,
					"content": "Consider it done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "My gratitude knows no bounds. I'll wait for Qingzhou here. We still have some matters to discuss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201624,
					"content": "Ugh... My schedule is already bursting at the seams...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201617,
					"content": "Do you know what happened to Mr. Bohuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Huh? Didn't he have that agreement with Vermeer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Did you come here bringing Xiao Lanterns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182019",
							"2"
						],
						"stepId": 7182019,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mr. Bohuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Thank you! Thank you! *sigh* I'm so careless...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201902,
					"content": "What were you up to here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "I came here looking for materials. I thought it'd be nice to make some decorative writings and give them to my friends as Lantern Rite gifts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201904,
					"content": "But I need a few bottles of special ink for those. It was supposed to be just a pleasant, little walk in search of the required ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201905,
					"content": "I would've never expected to come across all those monsters, never...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201906,
					"content": "About Wang'ya's request...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Go to Qingce Village and do some calligraphy for the villagers... No problem at all. You can count on me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201908,
					"content": "Qingce Village... Oh, it's the one with a huge population of elderly people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201909,
					"content": "Here's an idea. Why don't you help me find a Cor Lapis and a Qingxin? I need those to make some ink.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201910,
					"content": "You make ink... out of those?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Hahaha, there's a gap in your knowledge, I see. Powdered Cor Lapis dissolved in ink makes the characters shine with the most radiant shade of gold. Truly auspicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201912,
					"content": "Qingxin juice, on the other hand, adds a delicate, flowery fragrance to the natural scent of ink. If the ink itself is good enough, those two aromas will compliment each other beautifully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201913,
					"content": "Wh—What attention to detail...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Ah, that's nothing compared to the lengths some connoisseurs are willing to go to produce their inks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201916,
					"content": "Let's keep it simple this time. Just gather the materials and give them to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201917,
					"content": "Whew... I need a moment to catch my breath. Those monsters scared the life out of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mr. Bohuan"
				},
				{
					"id": 718201914,
					"content": "Sounds like a lot of work...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
