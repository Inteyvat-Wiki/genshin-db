						210340604
					]
				},
				{
					"id": 210340604,
					"content": "Just some ordinary monsters. It didn't take too much out of me. Shame that I didn't find anything of value. It's just scrap here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340605
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340605,
					"content": "How'd it go on your end? Did you find anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340606
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340606,
					"content": "I found this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Huh... That looks like a piece of a sword... Thanks. I'll bring it back with me and examine it more closely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340608
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340608,
					"content": "Thanks, Traveler. Here's your payment. Please accept it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340609,
