			"dialogs": [
				{
					"id": 210340501,
					"content": "Traveler, have you already wiped out the monsters in that camp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340502,
					"content": "All done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Just some ordinary monsters. It didn't take too much out of me. I also got lucky and found a valuable piece from a longsword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340505,
					"content": "I haven't found anything on my side...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Don't worry about it. You helped me rule out a misidentified location, so thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340507,
					"content": "Here, you've earned this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340508,
					"content": "If we find all the shards...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "My desire is a simple one... I just want to reforge the Unseen Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340511,
					"content": "Though the blueprints detailing how the Unseen Razor was made and what materials were used have been lost... I'll find a way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340512,
					"content": "If I can reforge the Unseen Razor, then my brother will also... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340509,
					"content": "What will you do with them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "How's it going on your end?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
