			"dialogs": [
				{
					"id": 790750201,
					"content": "I... I must tidy up this place, and find a good place for Chauvigne to soak up some sun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "I leave the matter of persuading Chauvigne in your hands, dear guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "If I were to see him, he would surely think me clingy, and become even more tempestuous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
		{
