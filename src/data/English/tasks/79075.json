			},
			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! Y—You've come. Please, listen to me, I've never been mad at you, and never wanted to leave you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "I was only worried that you didn't want to be friends with me... I know that some venturers change, and I was worried you had too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "I prayed to the goddess, but... But I couldn't find a good enough gift to offer, so she naturally ignored me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "No! Panuelle, such a thing could never happen. I will always, always be your friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "I must apologize to you! I was so focused on my own thoughts that I failed to listen to what you were saying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "I assumed... I assumed you never wanted to see me again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Seems we've cleared up this misunderstanding.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Yeah! Paimon thought you two had some crazy sticking point, and were so super mad you didn't even want to try and understand each other!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "It definitely was a sticky matter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "Thank you both, my dear guests. Without you, I'd definitely still be holed up in there, refusing to come out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "But now, I can finally share what's in my heart with Panuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "I am always willing to listen to whatever you have to say, Chauvigne. Whether you wish to speak of venturing, or of flower pots... It's all fine by me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "Right, dear guests. Please, take these. I gathered them specially for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "May the goddess bless you, that you may never argue with your friends, and that someone will always be willing to listen to your innermost thoughts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "But at least it's come unstuck now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				}
			]
		}
	]
