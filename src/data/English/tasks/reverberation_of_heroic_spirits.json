			"dialogs": [
				{
					"id": 761420401,
					"content": "Don't be afraid. Patoli and I will get you out of here. Stand tall — hold that blade like a proper Lightkeeper!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420402,
					"content": "I... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420403,
					"content": "What plan? What plan could there possibly be, Patoli? If this is the end, then I'll fight to the last right here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420404,
					"content": "You're the finest squad I've ever had. Whatever happens next... it has been my honor to fight alongside you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "???"
				},
				{
