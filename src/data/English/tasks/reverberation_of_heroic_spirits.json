			"dialogs": [
				{
					"id": 761420301,
					"content": "Hey, Chernov, you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Still lifting that blade... Captain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chernov"
				},
				{
					"id": 761420303,
					"content": "Shonokovych, Filaev... are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ugh... pretty sure my leg's busted, but hey, I'm still breathing. You keeping count? How many did I take down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Shonokovych"
				},
				{
					"id": 761420305,
					"content": "H—How many monsters are there? Are we... are we gonna die out here, Captain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420306,
					"content": "What nonsense are you talking about, kid? We'll definitely make it out safely! Don't worry, the scout must have already returned to the city to inform the old man, our reinforcements are on their way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "...Here they come again, these Wild Hunt just won't give us a break!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "Alright! Weapons up, lanterns steady. We've got another wave coming!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
