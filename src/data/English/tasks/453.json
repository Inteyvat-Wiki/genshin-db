				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530701,
					"content": "These claw marks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530702,
					"content": "From them, we can tell the number and size of the wolves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530703,
					"content": "This time there were at least two wolves, and they must be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530704,
					"content": "Be what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "Yes, yes! They must be at least... two meters high!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530706,
					"content": "...Paimon, you do know what a wolf is, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "Hey! Wolves are mysterious creatures, it's not like you see them every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45308,
			"completionStepIds": [
				45308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45308",
							"2"
						],
						"stepId": 45308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530801,
					"content": "This is a wolf's tooth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530802,
					"content": "He must have smashed into the door when he pounced.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530803,
					"content": "Perhaps it's calcium deficient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530804
					]
				},
				{
					"id": 4530804,
					"content": "Anyway, seems pretty lucky how no one in the village got seriously injured.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}