				{
					"id": 721740701,
					"content": "The child who picks shells by the shore, come, board the boat! The brother you knew has left his forebears' souls to seek a life on the far shore. Forget him now, forget the pain of parting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Boatman\""
