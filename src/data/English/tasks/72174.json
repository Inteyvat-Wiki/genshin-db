			"trigger": {
				"objectNames": [
					"\"Boatman\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "The near side of the river, hey! The cypress painted silver, hoi! The silver wormwood on the ground, the silver stones lie all around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740102,
					"content": "Excuse me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "Oho, who have we here? Guests? Here to board the boat, perhaps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740105,
					"content": "Ai yai yai, but let's see, now let's see... Oh, you seem like outsiders. That won't do, no, that won't do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740106,
					"content": "\"That won't do\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "The shining silver skiff sails soft to yonder moon, but it was not prepared for you, oh no! Step not aboard, soil not the decks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740109,
					"content": "Ai yai yai... The fog is long scattered, and long scattered is the fog! Yet who has not boarded? The lady of the golden hall shall be angry. Most angry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740110,
					"content": "Boat...? Where's the boat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Aha, a-hey... The silver skiff, scion of sun and slope, hey! All must come home, all must return, to the moon-mansion that golden burns...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740112,
					"content": "But for shame, for shame! Some children have lost their way, and still they have not boarded! The lady she shall be angry. Oh, most, most angry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740113,
					"content": "Do you need any help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Come, come, board the boat, the boat it is for boarding! Wander not, be lost no more, for life no longer mourning...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740114,
					"content": "Are you listening to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "What are you talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Who are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
		{
