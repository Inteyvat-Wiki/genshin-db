			"dialogs": [
				{
					"id": 721741001,
					"content": "They have all come, ya-ho, ya-hey, we have our merry cast...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741002
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721741002,
					"content": "Thank you, fair outlander, ho! We set off now at last...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721741003,
					"content": "The far side of the river, hey! The golden oak is yonder, hoi! The golden wormwood on the ground, the golden stones lie all around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721741004,
					"content": "The sights are lovely as can be, much further than the eye can see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Boatman\""
				}
			]
