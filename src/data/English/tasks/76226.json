			"dialogs": [
				{
					"id": 762260101,
					"content": "Maalaus, look! We found all your paintings and brought them back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260103,
					"content": "Hehe, no need to thank us. We had a hand in these paintings too, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260104,
					"content": "Since when can you understand what Maalaus is saying, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "Come on, we've been to the Silvermoon Hall together so many times already. It's not that surprising I'd start getting what Maalaus means, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260106,
					"content": "So what did Maalaus say happened to the paintings?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Uh... well... let Paimon try to interpret... Maalaus says...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260108,
					"content": "Maybe other kuuhenki stole them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260109,
					"content": "Mm... or maybe those fancy transport things on the moon took them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260110,
					"content": "Or... maybe Columbina stole them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260111,
					"content": "Hey! That's definitely not true!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "Huh? Oh... did I get it wrong after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260113,
					"content": "So it was just wild guessing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Hmph. Learning a foreign language isn't that easy, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260115,
					"content": "All Paimon needs is a good teacher! When the time comes, Paimon's gonna get Columbina to teach her properly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
