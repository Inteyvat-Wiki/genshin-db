			"dialogs": [
				{
					"id": 762260201,
					"content": "Huh? Maalaus? You're here too? We didn't expect to run into you on the moon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260202,
					"content": "So Columbina brought you here, right? She did say she'd take you to the moon for your exhibition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260203,
					"content": "Right, speaking of the exhibition... where are your paintings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260204,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260205,
					"content": "What's wrong? Don't tell me... they're lost?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260206,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260207,
					"content": "How could that happen? We're on the moon! They couldn't have been stolen, right...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260208,
					"content": "Anyway, let's help Maalaus look for them first. Maybe they just got left somewhere nearby.",
