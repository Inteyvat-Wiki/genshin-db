			"dialogs": [
				{
					"id": 200260201,
					"content": "I come bearing ingredients.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260202
					]
				},
				{
					"id": 200260202,
					"content": "That'll do it. One moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260203,
					"content": "It's ready! Now, get these <color=#00E1FFFF>Fried Radish Balls</color> to Ernest, pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260204,
					"content": "...Don't give me that look, I know you're famished.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260205,
					"content": "There'll be a special Good Hunter surprise waiting for you when you get back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
