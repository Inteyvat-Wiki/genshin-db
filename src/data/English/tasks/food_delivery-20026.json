			"dialogs": [
				{
					"id": 200260301,
					"content": "Your meal, sir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "Aha! My <color=#00E1FFFF>Fried Radish Balls</color>... and prepared just as I requested!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260303,
					"content": "Mmm... Yes, the addition of eggs does indeed do wonders for the texture and aroma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260304,
					"content": "Oh yeah! I know what I'm doing when it comes to food. *mwah!*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260305,
					"content": "Oh, and this is for you. Many thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ernest"
				}
			]
		},
