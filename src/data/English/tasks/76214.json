				]
			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Meow... It's already time for the tea party, meow. I wonder if they're lost, meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Mr. Gray Cat"
				},
				{
					"id": 762140102,
					"content": "#Oh, it's you, {M#Mr.}{F#Miss} Golden Traveler. You must be the chosen hero, meow! Would you help me look for my friends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Mr. Gray Cat"
				},
				{
					"id": 762140103,
					"content": "And who might your friends be...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Oh, and of the two ladies who aren't here yet, one is a kitty that can talk just like me. But unlike me, she's an orange tabby, meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Mr. Gray Cat"
				},
				{
					"id": 762140107,
					"content": "My other friend is a very polite lady poodle. A canine, true, but a most genteel one nevertheless, meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Mr. Gray Cat"
				},
				{
					"id": 762140108,
					"content": "Even though one of them's a cat and the other, a dog, whenever we sit down for tea together, we always have a wonderful time, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Mr. Gray Cat"
				},
				{
					"id": 762140109,
					"content": "Please, for the peace of Meouranopolis, lend me a paw, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mr. Gray Cat"
				},
				{
					"id": 762140104,
					"content": "Wow, it's really easy to be a \"hero\" these days, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Oh, let's not quibble too much over the details, meow. If you already have the holy sword of legend, a hero is a hero, whether you find the Pure Grail they speak of or not, meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Mr. Gray Cat"
				}
			]
		},
		{
