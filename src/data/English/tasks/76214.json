			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Woof? What is it, {M#Mr.}{F#Miss} Golden Traveler? Is there something I can help you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Miss Lady Poodle"
				},
				{
					"id": 762140302,
					"content": "On behalf of Mr. Gray Cat, you extend an invitation to his tea party to Miss Lady Poodle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Oh? Is it time already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Miss Lady Poodle"
				},
				{
					"id": 762140304,
					"content": "Thank you, woof! If I weren't so busy, I'd have gone to invite Miss Tabby myself... If I'd done that, perhaps Mr. Gray Cat might have...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Miss Lady Poodle"
				},
				{
					"id": 762140305,
					"content": "Cat or dog, we are all capable of getting along in peace... Yes, we can. Anyway, I should head to the tea party now. Thank you for the reminder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miss Lady Poodle"
				}
			]
		},
