						],
						"pointId": 244
					}
				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "...Meow. Your swordsmanship... leaves quite the impression.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Miss Tabby"
				},
				{
					"id": 762140209,
					"content": "My thanks to you, esteemed knight from lands afar. Those arrogant brutes won't be troubling my people's homes ever again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Miss Tabby"
				},
				{
					"id": 762140210,
					"content": "Now then... what brings you to my court?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Miss Tabby"
				},
				{
					"id": 762140202,
					"content": "\"Court\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Um... Since this is a fairy tale, this must also be part of that fairy tale world, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "On behalf of Mr. Gray Cat, you extend an invitation to his tea party to the lady tabby...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Miss Tabby"
				},
				{
					"id": 762140208,
					"content": "...I understand, and you have my thanks, esteemed knight from lands afar. I shall heed your wise counsel and set forth at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miss Tabby"
				},
				{
					"id": 762140204,
					"content": "Your Majesty, allow me to report a matter to you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Ahem, someone sure came around fast! Guess you just mind the local ways when \"abroad\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
