						"rawParams": [
							"801101",
							"2"
						],
						"stepId": 801101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "That's... that's not Caribert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110102,
					"content": "No, it's not.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "Right. Caribert's scarf was a gift I once gave to his mother. I use it now as a marker of sorts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110105,
					"content": "M—My eyes must be going... how could I not recognize my own son? Ugh, this decrepit body of mine... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110106,
					"content": "Still, this hilichurl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "Yes... It doesn't seem interested in us in the least. It seems intent on walking in that direction... Where could it be going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110109,
					"content": "No idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "Yes... The more we know about hilichurls, the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110110,
					"content": "Let's go have a look.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "There's something strange about it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "There's no silk scarf around his arm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801104",
							"2"
						],
						"stepId": 801104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "What a ghastly place... Has it always existed? I swear I've never noticed it before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Look...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Huh. It looks like they're... worshiping. Sometimes walking, sometimes kneeling in worship... And it appears to be in earnest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "I've never seen anything like this in all my life. What in the world does this place conceal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Oh, there's only one way to find out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(The air here, and this creepy scene... it's eerily familiar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "What are those hilichurls doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
		{
			"id": 801103,
			"completionStepIds": [
				801106,
				801118,
				801119
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801106",
							"2"
						],
						"stepId": 801106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Halt, humans. Fate has not granted you the right to enter this place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Fortune Lector"
				},
				{
					"id": 80110302,
					"content": "(An Abyss Herald? No, he doesn't look like someone from the Abyss Order...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Hmm, do you insist on an audience?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Fortune Lector"
				},
				{
					"id": 80110304,
					"content": "...Very well, then I grant you the trial of destiny.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fortune Lector"
				}
			]
		},
		{
			"id": 801104,
			"completionStepIds": [
				801108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801108",
							"2"
						],
						"stepId": 801108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "Who was that? He was... he was...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "Terrifying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "...He was a perfect being. I'm in awe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "...Huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "He had the most wondrous aura, a perilous yet beautiful power... Truly mesmerizing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "And yet you were able to defeat him. Your strength is greater than I had imagined. Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "You have unconventional tastes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Let's continue on. I find myself growing more curious by the second... and more excited.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "I just have lots of combat experience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "I've seen similar characters before.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
		{
			"id": 801105,
			"completionStepIds": [
				801110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801110",
							"2"
						],
						"stepId": 801110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110501,
					"content": "I think... we've made it to the end...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "What is that thing!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Wrapped in chains, hanging in midair, emanating a sinister aura... There's no mistaking it. It's just like the Defiled Statue!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(So it does have something to do with the Abyss Order. And these worshiping hilichurls remind me a little too much of the Grand Thief...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, this place is bad news. We've got to go!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "...O dear creature, why do you bow down? For fear of the unknown? Or for a power that you covet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110509,
					"content": "(Whose voice is that? It must be coming from right inside my head... Can't Eide hear it?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "...O dear creature, why do you bow down? For I am no god... I am but a \"Sinner.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110511,
					"content": "(A \"Sinner\"...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "You are like a flower born in sin yet pure, spotless... I know your fate well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110513,
					"content": "You need no longer hold back your resentment, nor accept the countless lies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110514,
					"content": "Go forth, become a transcendent one, rise beyond the fate bestowed upon you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110515,
					"content": "And I shall shed a tear at the end of time... as I gaze back upon your life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110516,
					"content": "(...Who in the world are you? What do these words mean?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Craft"
				},
				{
					"id": 80110518,
					"content": "(The voice... it's gone...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "...Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*pant* *pant* ...What just happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "When I saw that thing, my heart was instantly at peace... I—I was overcome by a sense of awe... or joy, perhaps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "Are you alright now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "I am... I feel good, in fact... I—I feel better than I did before I came in here. How peculiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Something's not right about this place. We need to get out of here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Oh, i—is that so? Alright, as you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "You leave the ominous cave and return to Eide's house.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert! Oh, thank goodness. He's still okay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "Don't we still need to go to the Statue of The Seven?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "I... I have a strange feeling that what just happened was meant to be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "For this to happen right at the moment when I was dreading worshiping at a Statue of The Seven... it's as if fate was calling to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "You say that I bowed before that thing, so perhaps... it might be just as effective?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "That sounds like a ridiculous idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "I have to try. No matter what. ...You said it yourself: I have to exhaust all options.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Another dose of medicine is administered to the hilichurl...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "...P—Papa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "*gasp* ...Caribert! Oh, my goodness, it worked! It's a miracle!!! Oh, Caribert, my dear son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "I can't believe it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "You see!? It worked! Caribert can speak again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "Where's... Mama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "Mama is... Caribert, look at me. Do you know who I am?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Of course... You're Papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Hahahaha... Yes! Haha... Salvation, sweet salvation... Yes, this is what this feeling is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "How do you feel, Caribert? Are you fully awake now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Yes... it feels like I just woke up from a long, long sleep. I dreamed that I was hiding in a little room. I didn't dare go out the whole time, and I didn't want to either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Wait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "My body! What happened to me? Is this... is this me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Papa... What's happened to me!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "...Don't panic, son. It's just... while you were sleeping, we went into a fairytale world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "There's no more Khaenri'ah here, no more home — but do you know what that means? No more red sky... no more end of the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "In this world, you have to be a little monster... but you get to stay with Papa forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Am I... dead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "No, no, of course not! Look, Caribert... you still have Mama's scarf on your arm. That means she's watching over you, protecting you. So how could you be dead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Really...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Yes, really! You've only just woken up, and this must all be very confusing for you. Just rest here for now... Things will get better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Oh, and um... you have to promise me something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Never take off your mask.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Understand? Whatever happens, you mustn't take it off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "Okay, Papa... I won't, I promise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Father and son talk for a long while. Eide seems like a changed man after his religious experience...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "Not since that day have I been so glad as I am now... I can't believe this is really happening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Yeah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Hmph, I knew that placing my hope in The Seven was a waste of time... I even worshiped at one of their statues like a common fool. Never before have I humiliated myself like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Once a murderer, always a murderer... I was naive to think that the gods who conspired against us would ever offer redemption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "But the god we saw in that cave... Now that was a truly mighty god! Nothing like one of The Seven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "That wondrous power... It was truly enchanting... Surely, that must have been the reason I bowed down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Hmm, now then... after one beseeches a god, and the god responds by answering their prayers, should they, um... do something to show their devotion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "Piety is hardly my area of expertise... but surely I should honor the god that has honored my wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "But Eide... that was not a god.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "A \"Sinner\"? Don't be absurd. You don't know a single thing about him... how dare you utter such blasphemy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "You and I have both witnessed his divine power. When have The Seven worked a miracle like this before? Never... He is a god mightier than they! And yet you would call him a \"Sinner\"? Preposterous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "No matter... Believe what you will. You cannot shake my faith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "I am going to pay my respects — with or without you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "You...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "(Eide's experience has deeply affected him... Not that he was particularly stable to begin with, but this... religious fervor is something else...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "(I guess I'd better catch up with him anyway. There are monsters everywhere... I can't stand by and let him fall into their hands.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110656,
					"content": "Fine, go ahead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110650,
					"content": "That was... a \"Sinner.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110642,
					"content": "It's unbelievable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110616,
					"content": "I'm stunned.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110608,
					"content": "But if you insist...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110603,
					"content": "Why are we back here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				}
			]
		},
