						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "I can't believe those two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "You still don't seem to trust him, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "You mean Kamei Munehisa? Of course not... we've only met him a few times, how could I trust him so quickly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "...But while I don't trust Kamei Munehisa, I do trust Xudong's judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "You're from the Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Sort of. I was originally doing field research for the Akademiya when I met Xudong in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "He was planning to travel around and study recipes, and the topic I was studying happened to be related to food. After we talked a few times, we decided to travel together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "We first went to Mondstadt where we were surrounded by a bunch of monsters. That's when Julie came, and she helped us chase them away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "When she heard that we were traveling around looking for different cuisine, she joined us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "She said she was planning to go adventuring, but I have the feeling that she just wanted to have some good food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "We'll be going to Sumeru next. I'm almost done with my research, so it's time for me to go back to Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "When we get to Sumeru, I'll make sure they get a taste of our local specialties...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "Okay, goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "What is the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160802,
					"content": "Why did you agree to join Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Like Xudong said, if I want to have enough to eat... working for him is my best option at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160804,
					"content": "Besides, Julie and Xudong are both of high moral character, and it will be an honor to travel with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160805,
					"content": "Parvaneh... is a thoughtful person. It is understandable she would be wary of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160806,
					"content": "Besides, she is merely a little suspicious of me as opposed to rejecting me outright, and that... that is enough for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160807,
					"content": "Have you really been just wandering around?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Indeed. I would never lie. Since I left the Shogunate, I've been just wandering around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160809,
					"content": "I usually fill my stomach with wild fruits and, when I'm lucky, fresh game.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160810,
					"content": "Occasionally, I also help people to fight off monsters or Kairagi, which gets me at least some payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160811,
					"content": "Hehe... For someone like me who has no skills other than wielding a sword, job opportunities are a bit scarce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160812,
					"content": "Not to mention my background of leaving the Shogunate. People always associate me with the Kairagi, and that makes it even harder to find work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160813,
					"content": "I have no home or family to go to in Inazuma. Since I had nowhere to go, I just wandered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160814,
					"content": "Why did you leave the Shogunate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "I just... couldn't agree with what the Shogunate was doing in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160816,
					"content": "I'm just a martial artist. I don't know what's good for the country or not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160817,
					"content": "I only knew that it went against what was in my heart, so I chose to leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160818,
					"content": "Hehe. Perhaps I was just too old-fashioned... Please try not to laugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160819,
					"content": "See you later.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "Farewell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		}
	]
}