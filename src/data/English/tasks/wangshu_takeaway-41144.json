					"nextDialogs": [
						411440303
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411440303,
					"content": "Well, you're just in time. Someone named Ling'guan ordered a Matsutake Meat Roll from me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411440304,
					"content": "She wanted me to send it to some spot northwest of Dihua Marsh. The Mora's already been paid out, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411440305,
					"content": "Well, if you've got time, how about helping me deliver it? You'll be compensated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				}
			]
		},
