			"dialogs": [
				{
					"id": 230001401,
					"content": "Ahem, today's tale took place in a faraway land. Please enjoy \"The Song of Anemo and the Dragon\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001402
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001402,
					"content": "...Back when the dragon came, none knew its name. Who could save Mondstadt from peril? Who would keep its creatures safe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001403
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001403,
					"content": "...The hero came forth on the wind, as the bard played his lyre and sang softly: \"Why has a thousand-year vigil been ended in a single day? The toxic blood of the Abyss has clouded the dragon's perception.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001404
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001404,
					"content": "...The demonic wind cleared, and the toxic blood was cleansed. Please, all you who come after, carve that name into your memory. For who is this song dedicated to? The Dragon of the East, Dvalin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001405
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001405,
					"content": "Hey! There we go! Now that's an interesting story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001406
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001406,
					"content": "The antagonist turned out to be forced into that position... That's always a moving development.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001407
					],
					"speakerTitle": "Izem"
				},
