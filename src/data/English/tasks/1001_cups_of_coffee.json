			},
			"dialogs": [
				{
					"id": 230001601,
					"content": "Well then, the story for today took place in a faraway country. Please enjoy \"An Outland Blade in Inazuma\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001602
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001602,
					"content": "#...The thunder can be heard beyond distant seas — the destined Traveler is about to arrive. {M#He}{F#She} roamed the islands like lightning, {M#his}{F#her} great deeds sung of by all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001603
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001603,
					"content": "...The Harbinger fell before the throne — her arrogance her undoing. The Traveler's friends came to the rescue, blocking the thunderous strike of a god unmoving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001604
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001604,
					"content": "...Countless stars whirled over the empty realm — each one the wish of a mortal's heart. Thus did those who lived in the land move the divine will of a god!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001605
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001605,
					"content": "Hey! There we go! Now that's an interesting story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001606
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001606,
					"content": "Hmm... Facing difficulties together with one's friends. That's what heroic tales should be about!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001607
					],
					"speakerTitle": "Izem"
				},
				{
					"id": 230001607,
					"content": "Today's story ends here. Please do come again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
		},
