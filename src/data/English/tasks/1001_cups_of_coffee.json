			"dialogs": [
				{
					"id": 230001701,
					"content": "Ah, so you came, Traveler! What do you think of the story today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001702,
						230001703
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001702,
					"content": "It was an interesting tale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				},
				{
					"id": 230001704,
					"content": "Haha, so you concur with the other listeners, then? In a new era, we shall have new heroes and tales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001705
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001705,
					"content": "Thanks to them, people like me always have a living to earn... Oh, and thanks to you, I can finally afford a nice coffee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001706
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001706,
					"content": "Thanks for the stories you shared with me. Please, take this as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001707
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001707,
					"content": "Don't forget to share new stories with me when you come across them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001703,
					"content": "It was a story well told.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				}
			]
		}
