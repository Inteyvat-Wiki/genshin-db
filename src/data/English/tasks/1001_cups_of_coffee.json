	"talks": [
		{
			"id": 2300003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300001",
							"2"
						],
						"stepId": 2300001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000301,
					"content": "Ugh, is everyone leaving already? I hadn't even started my story yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000302
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000302,
					"content": "My word. At this rate, I won't even be able to afford my coffee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000303
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000303,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000304
					]
				},
				{
					"id": 230000304,
					"content": "Um, are you... the Traveler? *sigh* As you can see, I exchange stories for coffee expenses here in this coffee shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000305
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000305,
					"content": "But I'm drawing smaller and smaller audiences recently... At this rate, I doubt that I'll be able to afford even coffee foam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000306,
						230000307
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000306,
					"content": "So you're like a bard from Mondstadt...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				},
				{
					"id": 230000308,
					"content": "Well... I haven't met one, but I suppose we might be quite similar, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000309
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000309,
					"content": "You know, the ancient heroic legends are intriguing, but no tale stays attractive if you tell it day after day... I have to find some new material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000310
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000310,
					"content": "*sigh* Stories from outside Sumeru are the best. They are new and interesting, and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000311
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000311,
					"content": "I'm at liberty to make adaptations. No one would notice, since no one actually knows what really happened... *cough*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000312
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000312,
					"content": "However, I must first understand the stories that I mean to tell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000313
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000313,
					"content": "I have collected tales from all over the world, such as the story of Dvalin, the Rite of Parting, and so on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000314
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000314,
					"content": "But I got these stories from others, and I'm sure they must have already come to me embellished. I don't quite trust those stories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000315
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000315,
					"content": "Traveler, I have heard from the Adventurers' Guild that you have been traveling the world. Is that true?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000316
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000316,
					"content": "Could you please tell me about your experiences around the world, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000317
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000317,
					"content": "That would allow me to get my stories straight and make them sound somewhat more believable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000318
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000318,
					"content": "Of course, we'll split my earnings from the stories I tell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000319,
						230000321
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000319,
					"content": "I can help you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000320
					]
				},
				{
					"id": 230000320,
					"content": "Thank you! So, where do we start?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000325
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000325,
					"content": "You can hear stories from everywhere. You know that, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000326
					]
				},
				{
					"id": 230000326,
					"content": "Well, I have collected tales from all over the world, such as the story of Dvalin, the Rite of Parting, and so on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000327
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000327,
					"content": "But these stories have been told over and over before they reached my ears, so I'm sure they must have already come embellished. I don't quite trust those stories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000328
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000328,
					"content": "Stories from a traveler like you are well-needed in such cases. With your help, I could fix my stories and make them sound more believable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000321
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000321,
					"content": "How embellished is embellished?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000322
					]
				},
				{
					"id": 230000322,
					"content": "Well, ah, I mean that they sounded like total nonsense even to the casual ear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000323
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000323,
					"content": "Hahaha... a knight with wings on their back, and a swordsman defeating a god alone, just to name a few in brief first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000324
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000324,
					"content": "Alright, let's get to it. What story would you like to share?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000307,
					"content": "So you're like a storyteller from Liyue...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				}
			]
		},
		{
			"id": 2300004,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10003",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000400,
					"content": "There was that time in Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000401
					]
				},
				{
					"id": 230000401,
					"content": "Huh? Mondstadt, the beloved land of the Anemo Archon...? According to the caravan, a gale-summoning dragon emerged there. That should make for a good story, I'm sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000402
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000402,
					"content": "But you get nothing more than broken legends from the caravans, which can often sound rather fake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000403
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000403,
					"content": "Something like... \"A winged Traveler came from the skies, pursuing the dragon tens of thousands of meters in the air!\" or something like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000404,
						230000405
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000404,
					"content": "Actually, there was an aerial chase...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				},
				{
					"id": 230000406,
					"content": "#Hmm, and something like... \"{M#He}{F#She} infiltrated the Cathedral alone, stealing a powerful weapon bestowed with the Anemo Archon's might!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000407,
						230000408
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000407,
					"content": "I did actually sneak into the Cathedral...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000409,
					"content": "#Really? What about this, then? \"In the end, {M#he}{F#she} spotted the dragon's weakness and attacked its old scar. Bathed in dragon blood, {M#he}{F#she} became immortal!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000410,
						230000411
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000410,
					"content": "I did target a specific spot...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000411,
					"content": "I was just purifying the toxin that had a hold over the dragon's mind...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000408,
					"content": "The Holy Lyre der Himmel isn't a weapon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000405,
					"content": "The aerial chase occurred thanks to a wind glider...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				}
			]
		},
		{
			"id": 2300005,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10006",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000500,
					"content": "There was that time in Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000501
					]
				},
				{
					"id": 230000501,
					"content": "Huh? Liyue... According to the caravans, the various factions struggled and schemed against each other when their Archon fell. That should make for a great story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000502
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000502,
					"content": "But you get nothing more than broken legends from the caravans, which can often sound rather fake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000503
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000503,
					"content": "Something like... \"the Traveler who organized the Rite of Parting became a figure much-sought-after by all sides.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000504,
						230000505
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000504,
					"content": "I did take part in the Rite of Parting...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				},
				{
					"id": 230000506,
					"content": "#Well, or something like... \"{M#He}{F#She} confronted the Overlord of the Vortex above the seas, sweeping even the Jade Chamber into the waves with the power of {M#his}{F#her} blade!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000507,
						230000508
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000507,
					"content": "I did face the Overlord...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000509,
					"content": "#Really? What about this one, then? \"In the end, {M#he}{F#she} settled the conflicts all alone, establishing a new era in Liyue Harbor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000510,
						230000511
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000510,
					"content": "The conflicts were indeed settled...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000511,
					"content": "It was a joint effort by everyone from Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000508,
					"content": "The Jade Chamber was the key to defeating the Overlord.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000505,
					"content": "I was actually running errands with someone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				}
			]
		},
		{
			"id": 2300006,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10014",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000600,
					"content": "So we did have this adventure in Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000601
					]
				},
				{
					"id": 230000601,
					"content": "Huh? Inazuma, the blessed land of the Electro Archon...? The caravans bring word that some defied the Archon's Vision Hunt Decree. That should make for an excellent tale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000602
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000602,
					"content": "But the caravans only bring scattered tales that never quite sound reliable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000603
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000603,
					"content": "#You know, things like \"An Outlander initiated a duel against a Fatui Harbinger, turning {M#his}{F#her} opponent to ash with one strike!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000604,
						230000605
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000604,
					"content": "I did win the duel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				},
				{
					"id": 230000606,
					"content": "#Well, or something like, \"{M#He}{F#She} stood against the formidable Shogun, escaping her Musou no Hitotachi without a single scratch!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000607,
						230000608
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000607,
					"content": "I did escape...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000609,
					"content": "#Really? What about this one? \"In the end, {M#he}{F#she} was empowered by the Statue of the Omnipresent God, and even changed the will of an Archon...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000610,
						230000611
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000610,
					"content": "I did change the Shogun's mind...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000611,
					"content": "The real key was everyone's \"wishes.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000608,
					"content": "Someone else blocked the strike.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000605,
					"content": "The Shogun was the one levying the punishment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
