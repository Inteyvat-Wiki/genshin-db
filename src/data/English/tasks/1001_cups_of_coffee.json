				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230001001,
					"content": "Ahem, today's tale took place in a faraway land. Please enjoy \"The Song of Anemo and the Dragon\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001002
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001002,
					"content": "...Back when the dragon came, none knew its name. Who could save Mondstadt from peril? Who would keep its creatures safe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001003
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001003,
					"content": "...The destined warrior spread their wings, the Holy Lyre der Himmel in hand, yes, the very tool of the Anemo Archon. Its strings brought forth the thousand winds, showing forth its mountain-moving might!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001004
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001004,
					"content": "...The warrior roared, their blade blazing like a falling star! The dragon lay defeated in the ruins, its slayer stronger than ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001005
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001005,
					"content": "The story... It's pretty new, and yet, the events don't flow logically at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001006
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001006,
					"content": "The protagonist just started the fight without a word and defeated the dragon way too quickly... It just seems somewhat weird...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001007
					],
					"speakerTitle": "Izem"
				},
				{
					"id": 230001007,
					"content": "Um... Well... Today's story ends here! Please do come again! Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
		},
