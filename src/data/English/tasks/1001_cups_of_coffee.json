			"dialogs": [
				{
					"id": 230001301,
					"content": "*sigh* You're here, Traveler. What do you think of the story I told today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001302
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001302,
					"content": "It was pretty crazy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001303
					]
				},
				{
					"id": 230001303,
					"content": "Well... That's about the same as what the other listeners said. I might have focused too much on drama, neglecting \"truthfulness\" in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001304
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001304,
					"content": "*sigh* More changes are needed for these stories to work, I guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001305
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001305,
					"content": "Thanks for the stories, by the way. Please, take this as payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001306
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001306,
					"content": "Don't forget to share new stories with me when you come across them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
		},
