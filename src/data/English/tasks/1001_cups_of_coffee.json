					"nextDialogs": [
						230000702
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000702,
					"content": "It really felt like I was talking to a true witness! Well, these legends make far more sense now, indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000703
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000703,
					"content": "Thank you, Traveler. Now that I've figured all this out, please, do stop by to hear my stories tomorrow night!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
