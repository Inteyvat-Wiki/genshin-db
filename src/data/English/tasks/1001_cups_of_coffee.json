			"dialogs": [
				{
					"id": 230001501,
					"content": "So! The story today took place in a faraway country. Please enjoy \"The Tale of the Golden-Haired Hero\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001502
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001502,
					"content": "...When the Exuvia plummeted from the skies, the ancient stone harbor was plunged into chaos, and the Sea of Clouds churned in the shadows. So did the Traveler arrive, and so was pulled into the vortex.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001503
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001503,
					"content": "...Despite the many conflicts along the way, all was put aside to defend a shared home. Osial of the Vortex emerged from the seas, and moonlight shone upon the Jade Chamber in the skies. Its delicate construction sank 'midst the flow, but at great expense, they delivered the final blow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001504
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001504,
					"content": "...Liyue has been open to all peoples throughout the Geo Archon's reign — to embrace an era without their archon is no impossible thing! Nestlings must now fly on their own — the ancient Stone Harbor shines anew!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001505
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001505,
					"content": "Hey! There we go! Now that's an interesting story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001506
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001506,
					"content": "Opposing sides establishing trust in cooperation... Now that's what I call, reliable plot development!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001507
					],
					"speakerTitle": "Izem"
				},
				{
					"id": 230001507,
					"content": "Today's story ends here. Please do come again!",
