			},
			"dialogs": [
				{
					"id": 751320501,
					"content": "Tread lightly where our pitch-black enemy roams. Beware the all-corroding foe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320502,
					"content": "Is there anything you wish to know, O outlander hero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320503,
					"content": "Tell me about the murals with the heroes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "Find them in the east, within a cavern where glowing trees sway and flutter. There, just as storytellers holding their woven scrolls say, lies also a terror hidden in stories from the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320505,
					"content": "Perhaps that shadow seeks to escape its imprisonment through those very stories...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320506,
					"content": "Tell me what lies atop the sea of mystery...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "To the west, an island lies obscured by fog. Once, it was a sacred ritual sanctuary, populated by those who made a pact with the Iktomisaurs long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320508,
					"content": "But oozing filth emerged therein, and the holy site became a dark cesspit, sealed away and forgotten... Ah, but our cunning foe would never give up quite so easily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320509,
					"content": "Tell me of the pale fog...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "That defiled fog was first created when the ancient city, Ochkanatlan, was destroyed. It should have been sealed away... But time and memory are against us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320511,
					"content": "If only... Alas... If only someone could dispel the pale fog once more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320512,
					"content": "No, I don't need to know anything at the moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Ah... Remember, remember... Be wary, be vigilant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will of the Mysterious Graffiti"
				}
			]
		},
