				]
			},
			"dialogs": [
				{
					"id": 751320601,
					"content": "I can sense it, O outlander hero... I can sense all that you have done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320602,
					"content": "A mighty feat indeed, O hero. The corroded power is now returned to the realm of Night, and I can hear the Nightsouls rejoice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320603,
					"content": "...Take these as your recompense, hero, for those who achieve greatness should not lack reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will of the Mysterious Graffiti"
				}
			]
		}
	]
