				]
			},
			"dialogs": [
				{
					"id": 751320101,
					"content": "...Ah... Hero from a distant land...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320102,
					"content": "Please, heed my words. I am the guiding night-raven, both a memory of our Lord of the Night's poetic musings... and merely one of a billion notions amidst the moonlight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320103,
					"content": "Incline your ear unto me, for the spirit river beneath the earth has been shattered, and I can only speak to you via this image, to urge you — beware the pitch-black foe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320104,
					"content": "That broken mirror once beamed forth reflections bright. But now, dark smoke has gradually spread into three areas. Remember them well:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320105,
					"content": "First, the east, where shadows have emerged from where they once hid, within the murals of legendary heroes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320106,
					"content": "The west is second, where, upon a sea of mystery, darkness manifests, affecting a galling parody of the lord of deepest night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320107,
					"content": "Third lies beneath the cliffs, where a pale fog that should have dissipated now spreads as Cinder City stirs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Will of the Mysterious Graffiti"
				},
				{
					"id": 751320108,
					"content": "O outlander hero, be wary... Tread lightly where our pitch-black enemy roams. Beware the all-corroding foe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will of the Mysterious Graffiti"
				}
			]
		},
		{
			"id": 7513205,
			"completionStepIds": [],
