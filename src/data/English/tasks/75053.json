			"dialogs": [
				{
					"id": 750530101,
					"content": "Hey, outlander. You've a good pair of eyes... Wanna test them by setting your \"Eyes on the Feathered Prize\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530102,
					"content": "Hone your vision, and be rewarded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530103,
					"content": "Well, that's a concise explanation. Maybe too concise. Barely feels like you said anything at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530104,
					"content": "Detailed rules for later, if you want to try.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530105,
					"content": "Let's hear the rules, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "Three Qucusaurs will fly off. Keep your eye on the middle one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530107,
					"content": "When they all fly back, <color=#00E1FFFF>recognize... the one originally in the middle</color>. That's it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530108,
					"content": "Err, so they'll switch positions mid-flight, and we gotta figure out which one was originally in the center?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530109,
					"content": "Correct indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530110,
					"content": "Huh... No wonder you call this eyesight training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530111,
					"content": "Start simple to test the waters?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530112,
					"content": "And if there's no trouble, we play for real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530113,
					"content": "Rewards are yours if you succeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530114,
					"content": "I've got something else on, so I'll be back later.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "Fine. I will be here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530116,
					"content": "Alright, I'll give it a try.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "When ready, hit the target and start!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		},
