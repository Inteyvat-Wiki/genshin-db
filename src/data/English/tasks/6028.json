			"dialogs": [
				{
					"id": 60280201,
					"content": "This is... this is where the people of Hyperborea used to communicate with the moons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280202,
					"content": "Eternal Moon, Frost Moon, Iridescent Moon... When the power of all three converge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "The gate to the moons shall open.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280204,
					"content": "Mmhmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "The Moon Marrows are in position. Only the final step remains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280206,
					"content": "...I'm sure Nasha Town is livelier than ever at this moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280207,
					"content": "Yeah... It's a shame you couldn't be there for it. But it's now or never, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "It's fine. I'm more than happy with this... my last piece of luggage — my only piece of luggage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280210,
					"content": "I can already feel the moon calling to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280212,
					"content": "This ray of light will lead you home, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 60280213,
					"content": "From now on, we will at last have a reason to pray to the true moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Yes. I'm listening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280216,
					"content": "Be sure to come back and see us when you get the chance!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Hah... Of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280218,
					"content": "But if that chance doesn't come... Then remember that you have friends on this planet — people who will miss \"Columbina.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Yes, I will. Thank you for everything you've done for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280220,
					"content": "And remember... Come night or day, the moonlight shall always connect us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 60280221,
					"content": "... Well then... Farewell, my friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
