			"dialogs": [
				{
					"id": 715551101,
					"content": "My notes... thank goodness, my notes are still intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551102,
					"content": "Huh? You haven't found it yet? The treasure is buried beneath the <color=#00E1FFFF>giant golden tree</color> in the middle of Lingju Pass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
