			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450401,
					"content": "How did it go? Did you get the pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450402,
					"content": "Wasn't that hard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "Let me see... Ooh! This angle... This pose... Pretty good! Pretty good indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450404,
					"content": "Well, aren't you excited...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "Oh, they'll more than do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450407,
					"content": "Thank you so much, Traveler. Please take these. I'll start practicing in just a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450408,
					"content": "Oh ho ho, this is pretty good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450405,
					"content": "Will these do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				}
			]
		},
