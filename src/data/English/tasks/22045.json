	"talks": [
		{
			"id": 2204501,
			"completionStepIds": [
				2204501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2204501",
							"2"
						],
						"stepId": 2204501,
