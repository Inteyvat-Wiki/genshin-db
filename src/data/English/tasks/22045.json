			"dialogs": [
				{
					"id": 220450301,
					"content": "Mm? What are you doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Taking pictures.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "...And what are those? You truly are strange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Eh, it matters not. Continue as you were — just refrain from messing the shrine up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2204504,
			"completionStepIds": [
				2204504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
