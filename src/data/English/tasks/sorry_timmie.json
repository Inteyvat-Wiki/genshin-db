				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "...Eat, eat. Eat and go, quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680302,
					"content": "What's up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "You again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680308,
					"content": "What are you planning? Are you trying to hurt the ducks and the pigeons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680309,
					"content": "This hash brown is for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "A hash brown? Huh. How did you know how to make this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680312,
					"content": "I know, you must have asked Mommy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680313,
					"content": "Hmph. Are you trying to bribe me, just like that? I know what you've done to the birds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680314,
					"content": "...Still, since Mommy's sent you over with the hash brown, I guess that's her way of telling me to stop making trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680315,
					"content": "She still needs to take care of Nora and Glory. It would be immature of me to make things harder for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680316,
					"content": "But let's be clear, I haven't forgiven you! I just don't wanna make trouble for Mommy. Got it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680317,
					"content": "Still... Hmph. I bet that because I'm a kid, you're just going to forget your promise whenever you feel like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680318,
					"content": "Once Daddy is back, I'm telling him all about you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680310,
					"content": "Please take this hash brown!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "Hey, Timmie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "You again? Leave me alone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680304,
					"content": "Has something happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "How can you even ask me that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 2006804,
			"completionStepIds": [
				2006804
