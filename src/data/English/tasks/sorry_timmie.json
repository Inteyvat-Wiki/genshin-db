			},
			"dialogs": [
				{
					"id": 200680601,
					"content": "...Why isn't he back yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680602
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680602,
					"content": "Hey, Timmie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680603
					]
				},
				{
					"id": 200680603,
					"content": "Why are you back again!? Go away! The pigeons and the ducks... You're scaring them off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		}
