		},
		{
			"id": 2006803,
			"completionStepIds": [
				2006803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006803",
							"2"
						],
						"stepId": 2006803,
						"stateName": "QUEST_STATE_UNFINISHED"
