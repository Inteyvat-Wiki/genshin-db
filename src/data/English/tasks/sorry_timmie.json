					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680501,
					"content": "Please give that hash brown to Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680502,
					"content": "This \"Mommy\" Timmie talks about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "It's me. I've been taking care of the children who need care for a while now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680504,
					"content": "Timmie's the one I've looked after longest. He's even come to call me Mommy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680505,
					"content": "But in truth, I'm not his real family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680506,
					"content": "Why's Timmie so mad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "How can you even ask such a thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680508,
					"content": "That child hasn't got many friends or people he's close to in this city. So other than Nora and Glory, he only has the small animals to keep him company.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680509,
					"content": "In fact, those pigeons even...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680510,
					"content": "...No, never mind. Please give the hash brown to Timmie as soon as you can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
