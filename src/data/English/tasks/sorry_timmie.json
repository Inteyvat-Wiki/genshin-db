	"talks": [
		{
			"id": 2006801,
			"completionStepIds": [
				2006801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006801",
							"2"
						],
						"stepId": 2006801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Ah, whatever shall I do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Um, what happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "Oh, it's you. You've come at just the right moment. Timmie's told me what you did to the ducks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "You... you... How should I say this? It's not as if I haven't heard of your deeds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "But did you really have to use your courage and strength in that way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "I was too hungry...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "If you really were hungry, you could have done some honest work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "With your capabilities, you'd definitely have a place at the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Ah, it's all water under the bridge at this point. But Timmie's been quite down because of this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "I... Timmie's father once taught me how to make a certain dish. Mondstadt Hash Brown with Philanemo Mushrooms is Timmie's favorite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Why don't you help me find three Philanemo Mushrooms, so we can make some for Timmie? That should perk him up a bit, and also serve by way of apology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Well then, off you go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "As for the Philanemo Mushrooms... I remember that you can find some under the eaves of the houses in the southern part of the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Please come back soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "It shall be done!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Just three is enough! What are you planning to do with this many mushrooms? Are you going to bribe Timmie with a meal every time you annoy him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "It was an accident, really!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "You accidentally hit those ducks and pigeons? Did you accidentally defeat the tough enemies you've encountered on your adventures too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "Strength comes from daily practice such as this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "You... I... Forget it. Looks like your \"strength\" really is all-rounded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
