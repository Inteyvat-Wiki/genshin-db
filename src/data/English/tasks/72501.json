			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "Why does Miss Moriko always give me these weird commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010202,
					"content": "Are you still drawing illustrations?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "You ran out of inspiration again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "Ah, Traveler, what brings you here? It's been a while, and I thought you'd traveled to other nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010205,
					"content": "*sigh* How I wish I was in a better condition. Then I could travel as freely as you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010206,
					"content": "And Miss Moriko wouldn't be able to come and nag me on work progress every day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010207,
					"content": "My illustrations last time were well received. Many novelists have since been requesting my works.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010230,
					"content": "Although Miss Moriko has rejected many jobs for me, the remaining commissions are still overwhelming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010208,
					"content": "On top of that, Yae Publishing House's novelists are getting... more and more creative with their themes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010209,
					"content": "At first, I thought outside of Inazuma, Liyue and Mondstadt would be the furthest stages for their stories to unfold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010210,
					"content": "Yet they now have protagonists adventuring in Sumeru, and Fontaine even.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010216,
					"content": "Well, enough of my complaints. Traveler, is your Kamera still functional?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010217,
					"content": "It's working alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "Do you want me to take more pictures?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "Well, my payment last time was quite decent, wasn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010220,
					"content": "So, Traveler, please take more pictures throughout the world for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010221,
					"content": "*sigh* Fine, leave it to me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "You know you can just put up a request at the Adventurers' Guild, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "I'll be counting on you then! Hehe, I've got my notebook ready!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010223,
					"content": "If you hadn't shown up, I'd ask Miss Moriko to look for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010225,
					"content": "Whoa! That won't do! Please, please, please help me! I've put up commissions but just couldn't find someone savvy enough to handle the Kamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010226,
					"content": "Just help me this time, will you? If I so much as missed another deadline, Miss Moriko'd definitely knock on my door, threatening to move in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010227,
					"content": "My stomach is already telling me that it doesn't want the Sakura Chazuke she'll make! Traveler, you have to help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010228,
					"content": "Okay, okay, I got it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "Phew... What a relief. Wait a bit. Let me look for my notebook...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				}
			]
		}
	]
}