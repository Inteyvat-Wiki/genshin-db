					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240402,
					"content": "Thanks to you, it is the best growing rose I've ever seen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240403
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240403,
					"content": "Thank you so much. Please accept these as a token of my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240404
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240404,
					"content": "Congratulations!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "Hehe, we're really happy that the rose bloomed, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Phew... We can finally deliver the roses to Bimarstan on time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "I do hope that the roses will be of help to them...",
					"roleType": "TALK_ROLE_NPC",
