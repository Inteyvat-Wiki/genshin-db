					"nextDialogs": [
						230240703
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240703,
					"content": "The doctors at Bimarstan will be amazed, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240704
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240704,
					"content": "No time better than now. Let me move this flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Wait, what was that sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "Something is stirring in the field...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "Whoa! A Whopperflower! Why is it even here!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "Oh no! The field! It's ruining the field!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "I'll take care of it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Eh? The Whopperflower fled...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "How... How could this be!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "One of our roses, the most important of our herbs, turned into a monster and ran away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "It didn't \"turn into\" a monster...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "You mean that the Whopperflower was responsible for the rose's slow growth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "Is that so? Then the fertilizer used on it was a waste. And it consumed double the amount of water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240718
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240718,
					"content": "Have we just been taking care of this Whopperflower all this time!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240719
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240719,
					"content": "Darn! How did it even disguise itself amongst the flowers? We never even noticed it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240720
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240720,
					"content": "Well, everyone gets played sometimes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240721
					]
				},
				{
					"id": 230240721,
					"content": "We're in serious trouble now. Our field is totally destroyed as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240722
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240722,
					"content": "We'll have to explain this to Bimarstan and plant new roses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240715,
					"content": "It was likely there from the beginning...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240710,
					"content": "Get behind me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				}
			]
		},
