						230240203
					]
				},
				{
					"id": 230240203,
					"content": "Nothing's happening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240204,
						230240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240204,
					"content": "I don't see anything...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "Oh well... Maybe it was just feeling shy in front of you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "But no worries. According to what we know of the rose's life cycle, you should see it blooming by tomorrow at the latest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "Well then, please visit again tomorrow, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240205,
					"content": "I can barely feel my legs anymore...",
					"roleType": "TALK_ROLE_PLAYER",
