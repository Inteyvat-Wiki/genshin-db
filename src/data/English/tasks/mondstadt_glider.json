			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "I am Otto of the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "Wh—What's going on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "Please show me your gliding license.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "Ahh... my um, gliding license is, uh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "It is against the law to glide without a license! I am arresting you under Section 7, Article 12 of the Mondstadt Penal Code.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "You have the right to remain silent. Anything you say will forever carry on the wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "Wait... I'm an instructor. This is a gliding exam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "Oh... I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Well, you picked a bad time to hold your gliding exam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "Really, why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "The Knights of Favonius received a report from a Sister at the Cathedral claiming she saw Raptor gliding around these parts. I thought your student here must have been his partner in crime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "Raptor? Who's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "A known criminal in Mondstadt. He always uses a wind glider to commit his crimes, so people started calling him Raptor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "Wow. He flies fast, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "So far we haven't managed to catch him... Our plan this time was to draw him into the Cathedral with a precious artifact, and ambush him inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "...But he escaped with the artifact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Fortunately, one of the Sisters put some secret markings on the artifact using elemental magic!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "...But he was too fast, and we couldn't even keep up with the trail the markings left behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Well, if you need help chasing down a gliding criminal, I'm the one for the job! So tell me, which way did he go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "As far as I know, he was last seen near Springvale, but that was some time ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#Leave it to me! With me and {NICKNAME} chasing him down together, he doesn't stand a chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Once we've got this Raptor guy, we'll pick up where we left off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "But no need to worry... I'll be sure to have a word with Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "So... I passed?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "It got eaten by Baron Bunny...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
