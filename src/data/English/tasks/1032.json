					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293202,
					"content": "Are you alright? You've suddenly gone quiet. It's not like you at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293203,
					"content": "Shh, we'll talk later. I'm just processing all the existing clues we have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293204,
					"content": "Maybe the key to our escape is hidden in some detail I've overlooked... I have to go over everything again...",
