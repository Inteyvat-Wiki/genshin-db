					"nextDialogs": [
						10293205
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293205,
					"content": "Alright, well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293206,
					"content": "Oh, don't worry. I won't write down anything that you told us about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293207,
					"content": "No, I meant, if you're going to analyze the facts, count me in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
