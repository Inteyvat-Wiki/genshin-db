			"dialogs": [
				{
					"id": 10293301,
					"content": "Hey, Ushi, looks like our little Lavender Melon has fallen asleep, huh? Do ya think she's dreaming?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Moo? Moo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Man, she looks wiped out. It's kinda hard to see her like this, I mean, most of the time she never shuts up... Ah, poor thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "And that little dude looks done in, too. Ah, I'm kinda worried about 'em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Moo, moo, moo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "I sleep like this when I'm in jail? Hah! Good one. I do slumber like a king.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
