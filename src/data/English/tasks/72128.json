			"dialogs": [
				{
					"id": 721280102,
					"content": "Whoa there, wait a second. You can't just open these chests as you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280103,
					"content": "Are these your chests?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "Of course. I placed them here specially.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280106,
					"content": "They're filled with all kinds of treasures, carefully gathered by me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280107,
					"content": "If you want to open them, that can be arranged... However, first, you have to give me something in exchange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280108,
					"content": "You want Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "Hahaha, actually, I don't want any Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280111,
					"content": "What I want is a kind of conch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280112,
					"content": "You should be able to find plenty of them around the beach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280113,
					"content": "If you want to open the treasure chests and get your hands on what's inside, bring me some of those conches in exchange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280114,
					"content": "But... I'm not going to tell you what's inside. What treasures you end up with will come down to how lucky you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280115,
					"content": "What do you think? If you want to open these treasure chests, just hand me some conches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280110,
					"content": "What would you like, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "What's inside?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
