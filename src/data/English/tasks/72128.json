					"speakerTitle": "Takashi"
				},
				{
					"id": 721280402,
					"content": "...Only one chest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Sorry, these chests are one at a time, I'm afraid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280405,
					"content": "Okay, go ahead and take your pick. Best of luck, hehe.",
