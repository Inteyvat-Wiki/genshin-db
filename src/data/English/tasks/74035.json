				"points": []
			},
			"dialogs": [
				{
					"id": 740350301,
					"content": "A keycap for a typewriter... Hey, Semaine, can you even expense things like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "I am unclear. But if typewriters can be expensed... then it follows that the keycaps for the keys can be reimbursed as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
		{
			"id": 7403504,
			"completionStepIds": [
				7403505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
