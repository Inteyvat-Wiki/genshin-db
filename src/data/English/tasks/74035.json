			"dialogs": [
				{
					"id": 740350401,
					"content": "Hello, Mr. Iaune. May I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "And hello to you too, Miss Cornelia. Do we have any spare keycaps for a typewriter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Excuse me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "My typewriter is missing a keycap, so I would like to apply for a replacement. If there isn't one in stock... It would also work if you could reimburse the purchase of a new one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Expensing a keycap... That shouldn't be a problem, in principle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Sign your name here, please. Just write \"Requesting reimbursement for replacement keycap due to typewriter malfunction,\" and then sign your name and office.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Very well. I can get the keycap today, right? I really need to get back to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Mr. Iaune, have you ever applied for reimbursement for the purchase of public property before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "Being reimbursed for work expenses is not at all like you imagine... you don't simply buy something and reimburse it. We need to compile all the reimbursement receipts and documents on a monthly basis, create summary reports, and then submit everything to the Maison Cardinalice for approval at the end of the month.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "This approval process is related to the approval and payment of salaries for the entire Maison Gestion. If the amount expensed is too large, then the Maison Cardinalice will even need to submit it to Monsieur Neuvillette himself for approval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "Payments can only be officially sent after the review is complete and everything is signed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "If he has any questions about a certain expense report, the staff member in question must submit a written report... We are just preparing to submit our first batch of reports, which we shall do sometime in the next few days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "You mean, if I'm unfortunate enough, then I might require Monsieur Neuvillette himself to sign off on that keycap reimbursement?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Such are the rules, Mr. Iaune. And since the total expenses for this month are large indeed, he may very well be required to audit the reports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "Monsieur Neuvillette... Wait, isn't that your Chief Justice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "But it's just a keycap... and we're making him sign for it... it just doesn't feel right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Isn't there some other way?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "I think so too. After all, it's only a keycap, and we don't trouble him with it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "That is true, there are other ways. Yes... You could go buy a keycap yourself first, then I can provide you an official acknowledgment of debt in the public accounts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "After all the reimbursements have been processed and the payment process completed, the amount owed will be paid to you directly from the public purse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "Excellent! Then let's do that! After all, a keycap doesn't cost much, I can pay for it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Then please sign here, and you should still write \"Requesting reimbursement for replacement keycap due to typewriter malfunction\"... are you going to purchase a replacement from Miss Estelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Yes, indeed. Is anything wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Then I will take the IOU to Mr. Roialte for him to sign, and then take it to Miss Estelle to verify the purchase amount.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "But you don't need to worry about that. Just hurry and buy your keycap, I'll take care of the rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "Thank you so much! You really are the best, Miss Cornelia. I'll go and buy it right now... Come on, Traveler, it's time to leave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Let's try something else!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
