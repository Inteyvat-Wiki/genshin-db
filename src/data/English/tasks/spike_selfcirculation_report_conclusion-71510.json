			"dialogs": [
				{
					"id": 715100101,
					"content": "How did it go? Did you manage to operate the Spike successfully?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100102,
					"content": "Yes. It went well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "Good, good. Though the Pursina's Spike cannot seal the opening in one go, as long as it is successful once, continued operation should not be an issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100105,
					"content": "This means that it's really just a matter of time before the opening closes completely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100106,
					"content": "Our problem is, therefore, solved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100107,
					"content": "I must record this... For all I know, I may yet become a figure of some influence in the Akademiya once the full research report on the Pursina's Spikes is submitted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100108,
					"content": "#I might even write it into my future memoirs. I can see it now: \"My Experiments With the Preternaturally Skilled {NICKNAME} at The Chasm...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100109,
					"content": "I'll be waiting eagerly for that day to come.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "Haha! Well, I fear I'm not hardly as good at writing stories as I am at reports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100111,
					"content": "I can only hope that you'll forgive any flaws in my work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100103,
					"content": "Most of the dark mud is gone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				}
			]
		}
	]
