					"Michelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430601,
					"content": "Have you spoken to Quinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Yes. He says you should get some rest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "There's nothing to do at Quinn's today anyway, go home and rest up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Really... *sigh* Looks like I should find something else to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "What? You're not going to take a sick day!? Take the chance while it's there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Stop and feel what is happening all around you. That's Lord Barbatos' winds, still hard at work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "We are blessed by Barbatos. It is not a privilege we should take lightly — we all need to do our part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "As for your part... What have you been doing? Why are you sweating so much?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "It seems that you are very busy yourself. But this is not a bad thing, for the more we toil, the more we sweat, and the more keenly we feel the winds of Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Here, have this bottle of milk. Drink up and get back to it, for there is no shortage of work to be done in this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
