					"Michelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430101,
					"content": "Ow, my back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430102,
					"content": "Are you okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "I was just getting ready for work, but then all of a sudden my back started hurting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430104,
					"content": "I promised Quinn I would go and help out at his fruit stand today, but I think it's best if I rest here for a while first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430105,
					"content": "But I can't just stay here and hold everything up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430106,
					"content": "Could you go and ask Quinn what he needs me to do? That will help me get prepared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "Thank you. I should be fine after a short rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430109,
					"content": "It's not far, surely you can make it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "Come on, is this really so much to ask? Help me out here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2004302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
