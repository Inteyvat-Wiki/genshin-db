			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quinn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430501,
					"content": "Have you found me some sunsettias yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430502,
					"content": "Got them right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "Great. That should be enough for Miss Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430504,
					"content": "*sigh* But it looks like most of my customers have gone now. This isn't a one-person job, it seems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430505,
					"content": "Oh— I should give you something for your trouble. Hang on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430506,
					"content": "There is no need for gifts. But we do have a request for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430507,
					"content": "It's about Michelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "Michelle? You've seen her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430509,
					"content": "I should give her a less taxing job?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430510,
					"content": "All I ever asked is that she watch the fruit stand for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430511,
					"content": "Oh. Is that true?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430512,
					"content": "But with no more customers, it looks like I won't even need her to do that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430513,
					"content": "Please tell her to go home and rest for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430514,
					"content": "I'll go and chase up that delivery in a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
