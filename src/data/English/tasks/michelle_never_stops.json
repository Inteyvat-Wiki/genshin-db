			},
			"dialogs": [
				{
					"id": 200430401,
					"content": "Did you find me some <color=#00E1FFFF>sunsettias</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "There should be plenty of <color=#00E1FFFF>sunsettias</color> just outside the city. Please, I need to stay here — can you run and grab some quickly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
			"id": 2004305,
			"completionStepIds": [
				2004304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
