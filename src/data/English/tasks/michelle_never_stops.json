			"dialogs": [
				{
					"id": 200430201,
					"content": "My back hurts so much... I hope I'll recover after a short rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
