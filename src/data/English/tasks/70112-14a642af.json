			"dialogs": [
				{
					"id": 701120101,
					"content": "Well then, Dexter. Times have changed. I suppose it's time for you to leave your childhood behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120102,
					"content": "You, too, must submit to the baptism that we call a coming of age, learn of matters only grown-ups know. Watch closely, now. I shall only demonstrate this once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120103,
					"content": "Why did that sound like someone giving their final words?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120104,
					"content": "Your final lesson is as such. Read along with me — \"The classification of the elements.\" Now, you try it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Josephus"
				}
			]
		},
