			"dialogs": [
				{
					"id": 701120201,
					"content": "Well done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120202
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120202,
					"content": "Hold on. Who exactly were you praising there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120203,
					"content": "Now then, the next step is to consider how things influence one another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120204,
					"content": "Observe the elemental reactions, the long-range forces, and the short-range forces. And remember to avoid unnecessary disturbances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120205,
					"content": "Uh, what language are you speaking right now!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
