			"dialogs": [
				{
					"id": 760020101,
					"content": "Hey, you, blondie! Perfect timing — this punk's cruisin' for a bruisin'. Lend a hand, and I'll make sure you get your cut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#What are you playing at? Calling in backup cause you know you can't win? Fine, two can play at that game! Listen here, {M#mate}{F#lass}, help me take this guy down, and I'll split the Mora with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "W—Wait, we're just passing by...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
