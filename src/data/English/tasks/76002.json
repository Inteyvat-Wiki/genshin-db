			"dialogs": [
				{
					"id": 760020501,
					"content": "Ha! That's the end of that — foreign nutjob spouting nonsense, rambling on about liquidating my crew. Not doing much liquidating now he's frozen solid, 'ey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Phew... Now we've saved Nasha Town from being flooded with contraband! Oh, and hey, don't forget our reward!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hmph, don't get ahead of yourselves — I gotta check the goods first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Wait, check... the g—goods?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Of course! If something's wrong with the goods then we don't get nothin' — and your cut of nothin', is nothin'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Tch... Look at these scratches. Rust, too! The Fleuve Cendre's getting real sloppy these days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Huh? Isn't that a Fontainian clockwork meka? Wow, Fontaine tech really is something else. Imagine still working after being transported all this way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Still working? Give it a rest! The power system in this thing should've been ripped out ages ago. There's no way it's—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
					"content": "WARNING. Startup mode <color=#FF5E41FF>ANOMALOUS</color>. Energy module <color=#FF5E41FF>ABx5F02&#5E38NORMAL</color>. Verification failed.",
					"roleType": "TALK_ROLE_NPC",
