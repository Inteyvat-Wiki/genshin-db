			"dialogs": [
				{
					"id": 760020301,
					"content": "Huh... Let 'em bounce. Them water snakes don't know their place, tryna slither up on our turf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Thanks for the help. Once my boys drop this \"Mademoiselle Belleville\" off in Nasha Town, you'll get your cut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Oh, right, the payment— Wait... Mademoiselle? Are you human traffickers?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Don't get the wrong idea, lil' girl. We don't touch kidnappings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "\"Mademoiselle Belleville\" is the name of this hunk of metal. Shipped all the way from the Fleuve Cendre, it wasn't easy getting it here. If it got snatched, we'd be ruined.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Ooh, a Fontainian clockwork meka? Wow, Fontaine tech really is something else. Imagine still working after being transported all this way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Are you taking the Fonta? This thing's power system was ripped out ages ago. There's no way it's—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "WARNING. Startup mode <color=#FF5E41FF>ANOMALOUS</color>. Energy module <color=#FF5E41FF>ABx5F02&#5E38NORMAL</color>. Verification failed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020309,
					"content": "Verification failed. <color=#FF5E41FF>Verification failed</color>. <color=#FF5E41FF>Verification failed</color>. <color=#FF5E41FF>Exterminate</color>. <color=#FF5E41FF>Exterminate</color>. <color=#FF5E41FF>Exterminate</color>. <color=#FF5E41FF>Exterminate Exterminate Exterminate</color>—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
