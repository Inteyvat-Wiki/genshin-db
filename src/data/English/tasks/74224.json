			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "The scenery here truly is rather excellent. We order many an instrument from this town every year, but this is my first time visiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240802,
					"content": "Tell me about the music score...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "I've got no questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "I'm counting on you, then. I'll wait for you in town in the meantime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
