			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "Hmm, this is... Yes, this is indeed \"The Flying Outlander.\" To think that you actually found it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "It can't have been easy, but I was right to put my trust in you, excellent adventurers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Hehe, thanks! Still, what are you gonna do with the score? Are you gonna perform it at the Opera Epiclese, maybe make a pile of Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Hmm... Making money is important, but I have no intention of keeping this for my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "This ancient art is part of the common wealth of humanity. As such, I will release \"The Flying Outlander\" into the public domain once my research is complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "After all, is not recovering this lost play and filling in a page of history heretofore missing the greater deed to do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "I'll be rooting for you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Well then, I suppose I should hurry back. Research and study await!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Ah yes, here's your payment. If chance should allow it, let us meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Don't forget the part I played.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "Of course. Your name will be on the title page for sure!",
					"roleType": "TALK_ROLE_NPC",
