	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
