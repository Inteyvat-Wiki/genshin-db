					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "Blood droplets!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541102,
					"content": "Not human blood, wolf blood. Lupical blood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541103,
					"content": "Loopy what now? Are you gonna tell us what it means yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541104,
					"content": "Lupical is family fate gave me. When wolf accepts human as its own. Or human accepts wolf. That is Lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541105,
					"content": "Sounds like gibberish to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541106,
					"content": "That's strange, where does the word come from? Surely it wasn't made up by the wolves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541107,
					"content": "It's just the name he gave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541108,
					"content": "...Who's \"he\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541109,
					"content": "Guardian of this land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541110,
					"content": "Wouldn't that be Barbatos though? He is the ruler of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541111,
					"content": "Enough. Another clue. Follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541112,
					"content": "Hey, wait! This is your chance to prove your innocence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541113,
					"content": "He's already gone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45413,
			"completionStepIds": [
				45413
			],
