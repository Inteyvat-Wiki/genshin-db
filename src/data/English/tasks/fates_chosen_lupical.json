			"dialogs": [
				{
					"id": 4540101,
					"content": "Who's there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540102,
					"content": "Chill out Razor, it's only us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540103,
					"content": "You... are also knight?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540104,
					"content": "...So you don't know each other after all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540105,
					"content": "\"The red one, burny girl...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "No. This girl also red, but not so burny like other girl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540108,
					"content": "This is starting to make sense. Is this the wolf boy you were talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540109,
					"content": "Correct! His name is Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540110,
					"content": "Help me out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540111,
					"content": "With what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540112,
					"content": "No time. I sent Lupical away. People coming, bad people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540113,
					"content": "Those guys from earlier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540114,
					"content": "I understand. But first, I have a few questions—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540115,
					"content": "*sniff* I smell blood. Quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540116,
					"content": "Blood? I hope the wolves didn't attack those idiots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540106,
					"content": "That wasn't Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
