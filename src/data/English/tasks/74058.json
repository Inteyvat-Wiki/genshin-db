			"dialogs": [
				{
					"id": 740580201,
					"content": "Whoa, you found so much... This is an enormous help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "I already sent the ore to the workshop, but I still haven't received my sample product yet. It could be because the artisans aren't familiar with working a gem of this kind and ran into some trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "But worry not! I trust my judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "I'm planning to turn them into accessories that'll no doubt become the newest craze all across Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "You'll see what the final product looks like the next time you visit! I'll give you some samples as a gift when the time comes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Or perhaps... you might see the most fashionable of the nobility wearing them before you even arrive, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "Alright then, you're always welcome to come back another time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
			]
		},
