			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, we're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#{NICKNAME} and Paimon! Are you here to play with me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Um, not really! You told us that we could ask you anything related to ore veins and gemstones, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Yep! I've collected all the pretty stones around the area. What exactly do you wanna ask about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "It's about that stone we found last time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "You tell Puca about how you sold the strange ore to the gemstone merchant...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Huh? People outside really thought that it was a precious gemstone? But I've even shown it to my sister before... Humans really are hard to understand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "But I know a lot of places with stones like this! If you want, I'll show you where they are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca marks the locations of the strange ore on your map.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "That'll be great. Thanks, Puca! Oh, right, here's the Mora that Chesil paid us as an advance fee. We could give you half, y'know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Oh, it's alright. We don't really need anything like that in the village, anyway... not to mention how you've helped me so much, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
