					},
					{
						"sceneId": 3,
						"position": [
							4399.945,
							484.95,
							4138.557
						],
						"pointId": 6047
					}
				]
			},
			"dialogs": [
				{
					"id": 741270301,
					"content": "Is this the Academic Assembly Hall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "I admit, the structure does look like a hall, but what's academic about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "The academic part is in the researchers' heads.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "All right, good thing I didn't come for anything academic today. Anyway, the building seems relatively... intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Intact is all it has left.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Ahem! Come on, let's look around. I think this place is perfect for a group photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "I should go find a good vantage point so I won't be at a complete loss if Mr. Roialte grills me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#Please take a few pictures for me too, {NICKNAME}. I heard you're a good photographer, certainly better than me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "I got this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "The rocks aren't academic, that's for sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
		{
			"id": 7412704,
			"completionStepIds": [
				7412704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7412704",
							"2"
						],
						"stepId": 7412704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4323.244,
							486.661,
							4142.65
						],
						"pointId": 6048
					},
					{
						"sceneId": 3,
						"position": [
							4349.325,
							487.27,
							4172.132
						],
						"pointId": 6049
					}
				]
			},
			"dialogs": [
				{
					"id": 741270401,
					"content": "Oh my... Too high, far too high!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "Are you describing the Institute's academic level?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "No, I'm marveling at the height of this place! Though the Institute's academics were certainly up there too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "But now... *sigh* Who could've foreseen so many hardships for the Institute? And who knows how smooth the reconstruction will be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "The last stop is... The Fontaine Research Institute Qualifications Review Representative Office.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "All in one breath, impressive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Thank you. But where is it? I didn't notice any such office in the Institute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "Is Desnos in charge of the office?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "Yes! That's right! You know even this place? I shouldn't be surprised that the Honorary Senior Researcher knows everything about the Institute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "Oh, Paimon remembers now! Is it that office in the ruins? If you can count that as an office...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Maybe Mr. Desnos shortened the name to make it easy for you to understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "Please lead the way. I have to get some files from Mr. Desnos too. Once I have them, I can return to the Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "It's been such an uneventful day today. I should be able to go back and relax soon. The Fontaine Research Institute sure does things differently from... Ahem, I didn't say a thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 7412705,
			"completionStepIds": [
				7412705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7412705",
							"2"
						],
						"stepId": 7412705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Desnos"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4222.473,
							466.37,
							4553.077
						],
						"pointId": 6051
					},
					{
						"sceneId": 3,
						"position": [
							4221.068,
							466.386,
							4552.242
						],
						"pointId": 6052
					},
					{
						"sceneId": 3,
						"position": [
							4221.525,
							466.37,
							4554.115
						],
						"pointId": 6053
					}
				]
			},
			"dialogs": [
				{
					"id": 741270501,
					"content": "O Archons save me, may no more meka cause trouble... What are you doing here, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "Mr. Roialte has sent me here to conduct an inspection, so I thought I'd drop by and bring you some coffee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "But I have to say that your working environment is indeed... quite difficult. I thought this \"office\" would at least have an actual room.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Thank you for the coffee, my dear Iaune. As for the work environment... I'm content with what I have. Look around, at least I'm working under an intact ceiling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270505
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270505,
					"content": "Are you still in charge of the qualifications review?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#{NICKNAME}! No... I should call you Honorary Senior Researcher! Glad to see you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "And what's with that sad look, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "*sigh*... It's like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "With a long face, Iaune recounts all that has happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "Hmm... Is the correspondence some sort of classified document?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "It can't be. Replies like this are typically in the vein of \"Got it,\" \"I have no questions,\" \"I don't know,\" or something similar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "At most, it's copied to different departments to let them know it's something they should care about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Oh, no wonder I got a copy of the letter too... Have a look, is this it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "What!? But Mr. Choiseul clearly said he hadn't mailed it yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "...Oh, he must've meant that the external letters haven't been sent out yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Once more, he failed to tell the whole story.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "People from the Institute are really good at getting under your skin, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "Judging from your reaction, this must be the document you wanted. I've read it several times already, myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "This is identical to the document you wanted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#Very astute, {NICKNAME}. I'm sure all the letters that Choiseul sent out are the same, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "Why don't you just take my copy back with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "Wait, what? If Iaune takes it, then won't you have lost yours?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Hahahaha, look at me! Nobody will care if someone in my position accidentally loses a nonessential letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Not a bad idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "See, Iaune, I'm not just mooching coffee off you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "No, Monsieur, I cannot do that. It's against regulations. I'll go back and wait for the official letter to be delivered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "My dear Iaune, think outside the box, don't be a fool! Why must you insist on making it hard for yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "Who knows when that letter will get to you! The sooner you get it, the sooner you can start working and settle all that mess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "No, Monsieur. Thank you, but I will not violate regulations. My duty as a civil servant demands it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#{NICKNAME}, Mr. Desnos, and Paimon, I must leave now. Mr. Roialte is still waiting for me to report back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune walks away with solemn, heavy steps...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "*sigh* Iaune can be such a fool. His brains have gone all rotten, haven't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Everyone else tries to make things easier for themselves, yet he insists on going through the motions, even for small things like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "That's just his character.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Admirable, yet scary at the same time. No wonder he has few friends in the Maison Gestion other than Roialte and Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "I'm his friend too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "So is Paimon, so is Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
