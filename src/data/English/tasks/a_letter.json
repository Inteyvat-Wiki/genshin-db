				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4471.245,
							541.043,
							3850.033
						],
						"pointId": 6039
					},
					{
						"sceneId": 3,
						"position": [
							4471.684,
							541.04,
							3851.864
						],
						"pointId": 6040
					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Uh, is this the Mary-Ann Memorial Park? I can't tell it's a park at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Mr. Roialte will be disappointed. He was hoping to have someone make a speech here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Looking around, a speech is out of the question. There's not even an iconic landmark here, and it's not good for group photos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "You can take some meka back with you as a memento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "You're funny, but there's no room in the Maison Gestion for such things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "And even if I could, I'd still have to have the meka appraised, reported, categorized, then stored...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "Hey! We're only joking. No need to get so focused on work all of a sudden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Speaking of reports... I still can't get that document. Mr. Roialte will be disappointed again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Is Choiseul making it difficult for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Not exactly. My request was not quite by-the-book, so it's no surprise that he rejected it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "As you may know, the Institute is making plans to rebuild, right? Certain resources and personnel arrangements have to be made through the Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "The Maison Gestion takes this matter very seriously, so it had Mr. Roialte select a team to conduct field studies in and around the vicinity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Therefore, Mr. Roialte stayed behind at the Maison Gestion to do the head count, while I am to visit the Institute to coordinate the reception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "It happens that the Institute has a letter for the Maison Gestion, so I thought since I'm here already, I might as well bring it back with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "But Mr. Choiseul insisted it was a violation of proper procedure and simply would not give it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Violation of procedure? What procedure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "There are proper procedures for picking up a document?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "Uh, don't tell Paimon there's gonna be running around for approvals, signatures, and listening to bureaucrats babble on endlessly as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "Simply put, most official correspondence within the Maison Gestion must be mailed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "What? Then... What if the departments mailing the letter are on the same street, or even right across from each other?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "Yes, you still have to mail it. That's for the purpose of being \"traceable.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "Gestionnaires sure aren't afraid of work.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "I suppose everyone is just used to it all by now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Never mind, let's just go to the next spot. Let me check the memo Mr. Roialte left for me... Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "This place is called... the Institute's Academic Assembly Hall. Strange... I didn't see any buildings with such a sign when I came.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "I know where it is, just follow me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "I knew I could depend on you! What would I do without you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Let's hurry, then. There might be more out-of-control meka around here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "What were you and Choiseul discussing back there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
		{
			"id": 7412703,
			"completionStepIds": [
				7412703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
