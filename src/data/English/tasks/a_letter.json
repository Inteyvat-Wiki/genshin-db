				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4400.085,
							484.95,
							4137.42
						],
