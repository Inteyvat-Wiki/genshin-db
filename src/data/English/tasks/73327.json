	"talks": [
		{
			"id": 7332701,
			"completionStepIds": [
				7332701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332701",
							"2"
						],
						"stepId": 7332701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}!? I—Is that you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270102,
					"content": "And Paimon too! I didn't expect to run into you two here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270103,
					"content": "Jeht, it really is you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "Haha, keep it down! You're gonna scare my fish away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270105,
					"content": "Beep beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Uh... You're fishing? But why aren't you using a fishing rod?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "Beep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#Benben, that's not true! Anyway... Why don't we talk about something else, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270109,
					"content": "So, about that fishing rod of yours...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "You...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270111,
					"content": "It... broke — totally its own fault, though... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270112,
					"content": "*sigh* I never thought fishing would be this different from hunting. Seriously, why is it so difficult? I hadn't the patience to sit here for hours waiting for them to bite my bait. So I thought, \"why don't I just jump into the river and catch them myself\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270113,
					"content": "But you didn't catch any in the end, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "Hmph, of course I did. I got a really big one, and it's longer than you by... Um, the length of half a Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270115,
					"content": "Beep! Beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "I grilled it and ate it, so there's none left for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270117,
					"content": "Beep...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "Yup, Benben also had its share. You're the only one who got left out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270119,
					"content": "Like Paimon's gonna believe that fib!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "Hahaha! Your loss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270125,
					"content": "How have you been?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "Huh? Good, don't you worry about me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270127,
					"content": "It's not the first time that I've traveled alone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270128,
					"content": "Beep! Beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "Hahaha, there there, I know I have you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270130,
					"content": "After my fallout with the Tanit, the various desert tribes stopped providing me with food and shelter... I'm no longer under any tribe's protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270131,
					"content": "Later... Rukh Shah from the Corps of Thirty offered me a place in the city, but... I didn't feel comfortable there. It reminded me too much of my mother...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270132,
					"content": "So I left Sumeru City. Thought I'd travel to another nation and check out some beautiful places I'd never seen before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270133,
					"content": "So I boarded a merchant ship and somehow ended up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270134,
					"content": "And after that... Well, there's nothing new to share after that, haha! You know how bodyguards are always needed in every corner of the world, right? Well, that's especially so in big cities like this where merchant caravans come and go every day. So yeah, I'm living alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270135,
					"content": "Hehe, and well, this is fine. I quite enjoy the life I have now, adrift and unattached.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270136,
					"content": "Me and Benben are just like you and Paimon, aren't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270137,
					"content": "Hmph, Benben is no match for Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "Beep-beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#Hahaha, no fighting, you two... Well, I won't keep you any longer, {NICKNAME}. I had planned to treat you to a big meal, but us guards-for-hire have rules we need to follow... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270140,
					"content": "Ahem! So much for complaining! Let me give you a thousand hugs and wish you a pleasant journey ahead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270141,
					"content": "#{M#Our paths will converge one day! Don't you forget that, eh?}{F#...Don't forget what I said to you back at the Tanit tribe. If you ever feel tired or want to take a breather... Perhaps our paths might converge then.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270121,
					"content": "I didn't expect to see you here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Yeah... I wasn't expecting to see you either. What a neat surprise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270123,
					"content": "Hehe, hope we didn't interrupt your fishin— Uh, fish-catching, did we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "Knock it off, little Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				}
			]
		},
		{
