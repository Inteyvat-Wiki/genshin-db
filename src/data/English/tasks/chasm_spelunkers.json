			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710371101,
					"content": "This is all thanks to you. Please, take this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371102,
					"content": "Thanks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "Ah, come on, there's no need to be so polite. I mean, Khedive's the one forking out the Mora! Oh, wait, shh... Best we be quiet, lest that stingy scholar from Sumeru hears us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371104,
					"content": "*cough* Ahem. Shall we go and look for Jinwu? We can probably probe her experienced mind concerning some of the questions we had on the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371105,
					"content": "You know something? Jinwu doesn't like talking about this, but just like how you're famous for your exploits on Dragonspine, she was also quite the famous figure down at the mines... *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371106,
					"content": "I heard that she helped to guide the Millelith search parties, and that they saved a lot of people together. Still, those things are in the past now. I shan't mention them too much, lest she gets mad again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371107,
					"content": "Alright, I won't keep you any longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
}