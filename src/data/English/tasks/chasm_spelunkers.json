			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370901,
					"content": "I believe that Zhiqiong should more or less be done with the map by the time you return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370902,
					"content": "However, I still need to wait for the transport team above ground to shift our tools down here, so you're free to explore for the time being.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
