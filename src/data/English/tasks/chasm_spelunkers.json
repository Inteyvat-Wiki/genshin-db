	"talks": [
		{
			"id": 7103701,
			"completionStepIds": [
				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Phew, this air sure is familiar! It's been a long time since I came down into these mines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Don't get careless, Qiong. I for one smell something unfamiliar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "I mean, we couldn't jump straight down. Maybe we were just distracted by the swaying of the crane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "You... You've spent too much time above ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Paimon didn't smell anything at all... Do all of you miners have such keen noses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha! A lack of a good nose could forfeit you your life down here! That said, we should still be fine. The finches are still quite lively.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Look, the Lumenspar has grown all the way down here too. That wasn't the case the last time we came down here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Wow, that really did happen! Let's go have a look!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Y'know... it feels like someone just stole Paimon's thunder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "To think that Lumenspar would appear so close to the surface. I was always of the opinion that these things could not appear in more structurally vulnerable locations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "They are fragments of that \"thing\" underground, traveling up the veins of the rock before finally arriving here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Hey! Stop spouting nonsense. They were originally rocks from the local area, which is why they became like this. They just underwent some kind of transformation process and formed crystals, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "The analyses that the Qixing commissioned us to conduct reveal that they are by and large made of ore from the local area. They've just been affected by some outside force, thus creating these strange crystals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Huh, look over there! That crystal looks just like the Adjuvant you have with you, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#Why don't you take the Lumenstone Adjuvant and have a look, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "That's right. The Adjuvant is made of the same material as these crystals. These formations will thus naturally react to one another on account of that similarity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "How very strange...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Hey, is that all you have to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "Um, don't fight, you two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "We're not fighting...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "Yeah, we're not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "What I mean to say is that it doesn't matter whether you're fighting or not. Zhiqiong and I need to set up a temporary camp up ahead, so don't run off while we're doing that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "The crystals we discovered will be very useful for our subsequent exploration. If you find anything after this, please make sure to contact me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "My skills haven't rusted away just yet, so I can help you process some of the raw ore. I believe that it'll prove quite useful to you in your adventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "And, um, also... don't fight, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Got it, got it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Understood.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "That's a good pair of kiddos. I'll get you some candy later. Anyway, if you find anything strange nearby, please report it in a timely fashion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Actually, do you remember what Jinwu said the last time about Uncle He...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#I haven't forgotten. And since you're here, {NICKNAME}, could you help me out once again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "Uncle He is our senior here in the mines. Several years ago, he was one of those who went missing when we Chasm miners were dispersed. He's hard of hearing, and may not have heard the alerts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "The pensions from Huishan Hall and Shenglu Hall are quite generous, and his family has already long arranged for his funeral... But although I'm not much of a believer in the supernatural, I can't help but feel that he's still alive down here somewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "He really was an old hand. Whether it be avoiding disasters in the mine, how to escape, how to wait for rescue... He knew it all. Taught me a lot of it, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "That's why I believe that he must be alive in here somewhere, even now... I won't give up searching for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "I'll point you to a few places where he was sighted before we dispersed... Who knows? You might still be able to find some clues there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "As for me, I'll be exploring the deeper parts of the mining caverns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Oh yes, don't forget your candy, now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "You're not coming with us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "She still needs to help us draw some maps. The pathways of The Chasm's underground mines are intricate and complex, and we won't get very far at all without those maps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Stay safe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "I'll be fine. It's not like I'm an amateur or anything. Don't you worry about me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "That's pretty amazing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103709",
							"2"
						],
						"stepId": 7103709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "Oh, you're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "Uncle He left this behind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Huh? He did, did he? Go on then, tell me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "You tell Jinwu about what you found earlier.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Umm... Black Magma... Lumenstone... and mushrooms?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Huh. That's weird, and a familiar sort of weird, too. Let's head back to the encampment. It would be best not to linger here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Here we are. Strange... where'd Zhiqiong run off to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Hey! Zhiqiong! Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "*sigh* I'll wager she's gone running off to some other corner of this place to draw her maps again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "What's up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "She drew this just after you left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "She's probably gone deeper in to explore. Please tell her for me that she should quit leaving everyone else behind to go running off by herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "If anything bad happens, we're all gonna get dragged down with her. Jinwu's fist will know no mercy, I tell you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "That sounds... scary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Pretty scary indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Alright, then. Less idle talk, more action. You can either help me set up here, or you can go scout ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Sorry if I'm not the most courteous character. I just want the things I do to be of use to everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Ah yes, by the way, if you see some raw Lumenstone ore along the way, bring some to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "I will find some way to turn them into more effective Adjuvants. As far as my experience can tell me, these things will be very useful down in the mines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Is Zhiqiong in danger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Not yet, no. But if she keeps running off without informing me, she will be quite soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103705,
			"completionStepIds": [
				7103713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103713",
							"2"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7014112",
							"3"
						],
						"stepId": 7014112,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, it's you, {NICKNAME}! You're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu has some words for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "It's that whole spiel about safety again, isn't it? I'm sick of hearing it already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "I grew up in the mines too. What wouldn't I know about the hazards down here, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "As for any unknown dangers... Eh, our seniors always used to use their experience to judge whether things were dangerous or not. And in the end, they'd use the results to rationalize their experiences instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "I've had it up to here with their arrogance. I'm sure you feel similarly as a senior adventurer, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "If Iris was able to scare you off climbing Dragonspine just by giving you the standard safety talk, you would've missed out on so much adventure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Alright, stop trying to persuade me. I don't want to argue with you over something this dumb. Can we just, you know, change the topic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "I mean, look over here. I'm currently studying the terrain over here, all the better to draw our maps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "It's just that... I found that the way ahead is blocked by some... strange stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "If you could take some samples or pictures of it, I'm sure that both the Ministry of Civil Affairs and the Adventurers' Guild would be quite pleased.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "I would have done it, but... I dropped my Kamera while descending into the mines, so I can only rely on you now, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Also, there are a few other spots... Yup. Here, and here. I found the tracks of Treasure Hoarders in these areas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Sorry, which place is where now? Paimon didn't understand you at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "You just drew a bunch of Xs and lines...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Hahaha, sorry... Just a force of habit. I always forget that not everyone is born with a natural instinct for cartography.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "But it's alright, I will follow you and show the way ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "We can approach any of these few locations first, so pick whichever you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "In that case, let's go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Be careful while we're on the move.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Thanks for your concern! I'll keep that in mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370510,
					"content": "What are you doing here again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Well, didn't I just say so? I'm studying the terrain and drawing a map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
