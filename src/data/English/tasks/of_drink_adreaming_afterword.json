			"dialogs": [
				{
					"id": 705100401,
					"content": "Wow... Business certainly has been picking up in the tavern recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100402,
					"content": "Some customers came for the drinks, but most came for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100403,
					"content": "Hmm... Why is that still hard to believe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100404,
					"content": "I've never seen a more successful Bartender Academy Week. We earned both money and reputation this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100405,
					"content": "Anyway, well done my friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100406,
					"content": "Huh, it's only been a few days and now we're buddies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100407,
					"content": "In some sense...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "I've been meaning to ask, would you consider staying and working here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100410,
					"content": "#No can do. Though unlimited refills is enticing, Paimon made a promise to keep traveling with {F#her}{M#him}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100411,
					"content": "Okay then, I won't twist your arm. In fact, Charles had mentioned that to me, as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100412,
					"content": "Well, feel free to come back and visit the Angel's Share whenever you like. And, remember to bring your friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100413,
					"content": "Sure thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "Good luck on your journey, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100408,
					"content": "He's not entirely wrong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
}