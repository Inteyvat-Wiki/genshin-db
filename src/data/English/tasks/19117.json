			"dialogs": [
				{
					"id": 191170106,
					"content": "Woof! Woof! *growl*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170107,
					"content": "You're a vicious little thing, aren't you? You almost bit me again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170108,
					"content": "Look at you, wasting away... you must wanna eat a little something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170109,
					"content": "You don't have to come back with us, but c'mon — a dog's gotta eat, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170110,
					"content": "You're not worried it's poisoned, are you? Here, I'll take the first bite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170121,
					"content": "See? Delicious and poison-free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170111,
					"content": "Thoma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Come on, just have a bite. A little tiny bite, and then I'll leave you alone, how's that sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170114,
					"content": "Woof! Woof, woof!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170115,
					"content": "Looks like it has zero intention of eating the food we brought... Is it just me, or does it look kind of on edge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170116,
					"content": "Maybe it's something in the sea... Or something nearby that's got him on alert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170117,
					"content": "Those monsters, perhaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "You think he was attacked by monsters... Hmm, it's possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170119,
					"content": "People do tend to lose their appetite in dangerous situations. Maybe it's the same for dogs, too. Let's clear out the area on behalf of our canine companion here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170120,
					"content": "#Thanks for helping out. This place should be a little more tranquil now, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170112,
					"content": "You're really putting yourself out there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
