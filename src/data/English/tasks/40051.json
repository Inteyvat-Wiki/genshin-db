			"dialogs": [
				{
					"id": 400511901,
					"content": "After a careful headcount, it seems like the baby vishaps aren't here anymore. Guess they got rescued...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511902
					],
