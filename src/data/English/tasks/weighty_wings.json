					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280205,
					"content": "We can't take care of it forever, can we...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280206
					]
				},
				{
					"id": 750280206,
					"content": "But there's gotta be something we can do to make it feel better, even if it's only for a short time...",
