			"dialogs": [
				{
					"id": 750280101,
					"content": "Ugh, you're... tougher than you look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Mouse"
				},
				{
					"id": 750280102,
					"content": "Gah. Who did we offend... Who'd send someone on this day, of all days, to come whack us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Night Owl"
				},
				{
					"id": 750280103,
					"content": "#Please, {M#Big Bro}{F#Big Sis}. How have we offended you? Just... let us know. We won't do it again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Night Owl"
				},
				{
					"id": 750280104,
					"content": "Hey, you little rascal! You're really gonna grovel before this piece of work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Mouse"
				},
				{
					"id": 750280105,
					"content": "You think talking tough's going to make us a living? I can see it now, I tell you. We're just living like thieves and crooks. There's nothing special about trafficking Saurians, is there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Night Owl"
				},
				{
					"id": 750280106,
					"content": "If the only alternative's being robbed by a stronger crook, why shouldn't I go with them instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Night Owl"
				},
				{
					"id": 750280107,
					"content": "#And not to brag, {M#Big Bro}{F#Big Sis}, but I'm sure I'd be way more useful to you than these two. Just call me if you need anything. I'll settle it, nice and clean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Night Owl"
				},
				{
					"id": 750280108,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Well, I do happen to be shopping about for a sidekick.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Are you serious!? No way! Paimon vetoes this motion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "Also, you're a bunch of bad eggs anyway! No way good guys like us would team up with Saurian traffickers like you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Yup, there's no one good-er than me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Ahem! Anyway, whatever designs you have on the Saurians, better stop now, or we'll... Well, {NICKNAME} will show you what's what.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "The two traffickers leave amidst a cloud of resentment...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Paimon wonders how that Qucusaurus is doing. Shall we go see to it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Well, there's always room for accommodation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Hey, you're gonna be a bad influence on {REALNAME[ID(2)|SHOWHOST(true)]}! Don't worry, little guy, there's no way we're teaming up with this lot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Rrrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Thanks for your consideration, but no need.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
