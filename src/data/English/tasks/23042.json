			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "This is definitely gonna be a surprise for Raef... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "What surprise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "Whoa! Don't scare me like that, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "It's not like I sneaked up on you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "I was thinking about something, so I didn't notice you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "Traveler, have you heard of something called \"perfume\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "Granny Jawahir told me that she used to make perfume when she was young...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "Not only can they cover up the smell of sweat on people's bodies, certain types of perfume have invigorating properties...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "Raef has to guard the village all the time. He's always really sweaty from the heat and often complains about the sunlight making him dizzy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "So I wanna make a bottle of Mint perfume for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "Granny Jawahir wrote down the recipe for making perfume and helped me buy the ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "But making perfume is so much trickier than I expected... Just getting the ingredients ready took me a really long time. I made lots of mistakes along the way, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "If things go on like this, Raef's gonna find out I'm making perfume for him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "Traveler, could you help me prepare some ingredients? Be careful not to let Raef discover anything, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Why not?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "I've been preparing this surprise for a long time. I'm not gonna let him know and ruin it all now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "It's not a lot of work. Go find Mr. Azalai and pick up the goods I ordered, then fetch a small bucket of water. That's all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "Remember to keep it on the down low. Don't let Raef know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "...Leave it to me then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Thanks once again. Don't worry, I'll be sure to make it worth your while!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
