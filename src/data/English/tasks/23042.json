				"objectNames": [
					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "Welcome! What do you need today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "About Nermin's order...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Oh, Nermin's order... I have it prepared right here. These are all high-quality ingredients, and they're inexpensive, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "I'm guessing Nermin wants to make some perfume with these ingredients, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "*sigh* It's a good thing to be enthusiastic, but Nermin needs to take better care of herself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
