			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "Whoa! Did this guy get even bigger than before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141702,
					"content": "Hehe, of course. After eating all those Lakkaberries that I worked hard to find, His Majesty the Tsar is now even plumper and chubbier than you are, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141703,
					"content": "Hey! Cut it out with the weird comparisons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141704,
					"content": "#Whoa! It seems to have gotten energized all of a sudden... Or should I say, excited, when it saw you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141705,
					"content": "Looks like it wants to challenge you... Hah, is it feeling sore that you beat it black and blue the last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141706,
					"content": "Bring it on!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "Be careful. It's much stronger than it was last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141708,
					"content": "Huh? Right now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "There's no need to indulge its whims, really. You can accept its challenge whenever you feel like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141710,
					"content": "It's under my protection now, so it will listen to what I say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141711,
					"content": "Hey now, be good. Sit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141712,
					"content": "You say this like it's your pet dog or something... Wait, aren't crabs sitting down all the time to begin with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
