			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Biram"
				],
				"points": [
					{
						"sceneId": 1200,
						"position": [
							409.031,
							104.539,
							380.959
						],
						"pointId": 3
					},
					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Take a look at this — it's a woven scroll made by one of our ancestors. This is the kind of thing we're trying to make.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250702,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "The person depicted is the legendary shaman, Huitzilin. She lived two hundred years ago, and was once appointed by the Iktomisaur Elder like yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250704,
					"content": "She was especially skilled in the art of color manipulation, and of course completed her task with flying colors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250705,
					"content": "This scroll is a record of her deeds, and was most likely the work of her own hand. The quality is simply breathtaking, even compared to other scrolls of this variety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250706,
					"content": "Sadly, since she passed away, all of our Iktomisaur Elder's subsequent appointees have had to rely on the \"gift from the spirits\" to complete their work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250707,
					"content": "But now, you're about to revive an older tradition.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "That's a good way of putting it. My only quibble with your phrasing would be, it's not just me, but \"us.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250709,
					"content": "Ooh! Now Paimon's getting excited.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Bring out the samples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250711,
					"content": "An assistant presents the samples for test-dyeing.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "Now, as I mentioned, the dyeing process is a little complicated, but I am confident you will manage. Just make sure to follow my instructions carefully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250713,
					"content": "Will do. Let's get started.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "The pattern has already been sketched out on the sample, so you just need to dye each block with the correct color. But you'll need to wait for the dye to fully soak in between each step to make sure the colors don't run.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250715,
					"content": "(Dye the fabric as instructed.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Good. The dye has taken to the fabric, and the pattern is crisp and clear. Next, apply all the remaining dye and we should see that elusive signature color emerge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250717,
					"content": "Okay, final step!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "(Apply the remaining dye.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Um... Did it work? Paimon doesn't see it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "That color isn't showing up... The dyeing has failed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250721,
					"content": "Did I mess up somehow?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "No, your technique was flawless. You did everything exactly as instructed. It would have made no difference if I'd done it myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250723,
					"content": "Then what went wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "It could be the weaving technique, or maybe the dye has to be applied in a different way... Whatever the case, it looks like I have failed to get to the bottom of this mystery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250725,
					"content": "Sorry... Paimon wishes we could do more to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "I am the one who should be apologizing. I made you do so much work, and it was for nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250727,
					"content": "I will of course honor my commitment to compensate you for your trouble, but I do hope you won't give up on this task. I plan to keep investigating, and will be sure to keep you updated with any progress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250728,
					"content": "Don't worry, we're not quitters!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250729,
					"content": "Paimon does have a question though... Um, this whole process of recording history on woven scrolls seems so complicated. Why don't you just write it down instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250730,
					"content": "You said yourself, you're all about change and reform. Well, this seems like a pretty good place to start, don't you think? Writing things down would be easier for everyone, and your records would be more detailed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250731,
					"content": "...I think you've perhaps misunderstood my philosophy, but that's okay. I can answer your question, but there's somewhere I need to show you first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chief, Masters of the Night-Wind"
				},
				{
					"id": 150250732,
					"content": "Oh... sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
