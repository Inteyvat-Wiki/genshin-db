					"speakerTitle": "Paimon"
				},
				{
					"id": 150251202,
					"content": "They probably used the same stuff for their paint as we're using for the dye, right? Maybe we'll create a masterpiece of our own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251203
					],
					"speakerTitle": "Paimon"
				},
				{
