			"dialogs": [
				{
					"id": 150251801,
					"content": "These guys' ancestors made some real works of art here. But based on what we've seen so far, it seems like there should be more to the story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251802,
					"content": "Do you think maybe there's more artwork further inside? Seems kinda strange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251803,
						150251805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251803,
					"content": "We can go take a look if you want?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Oh, no need — Paimon was just thinking aloud. Toltec's waiting for us, and we have a job to do, so maybe it's best if we head out now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
