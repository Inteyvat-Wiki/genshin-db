			"dialogs": [
				{
					"id": 150250101,
					"content": "I take it you're the ones appointed by Elder Tlapo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Yup! And you are?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Call me Toltec. The chief asked me to be your guide for the day. His messengers already filled me in on the situation. So just follow me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "Haven't we been in here before, though?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "Yeah, but don't forget we're the chosen ones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "The strange thing is, our ancestors never removed the seal even after they finished the graffiti art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Since it was sealed off, the only person who's been inside is the great shaman, Huitzilin. And that was two hundred years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "According to her, the artwork tells the story of a hero by the name of Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "...But I digress. Sorry, I'm a big fan of graffiti artwork, once I get talking I can go on for hours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "So you're sure you don't wanna come with us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "I'll pass. I tried to get in once, but the seal blocked my way. I tried getting my Iktomisaurus to clear it with its powers, but even that didn't work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "I guess it's supposed to be a test left there by our ancestors. If you don't pass the test, you're not worthy of viewing their works of art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Aw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Don't worry about me though. I wouldn't be joining you this time, even if I was able to get in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Unlike our chief, I don't have the guts to challenge our traditions. This task is specifically appointed to someone by the Iktomisaur Elder. Who knows what bad things might happen if I got involved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Fair enough. Alright, we'll try not to take too long!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
