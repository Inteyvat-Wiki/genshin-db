	"talks": [
		{
			"id": 2003701,
			"completionStepIds": [
				2003702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003702",
							"2"
						],
						"stepId": 2003702,
