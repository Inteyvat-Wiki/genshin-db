			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "Hello. I know that voice... Traveler! It's you, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370302,
					"content": "What brings you here today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370303,
					"content": "Someone told me to bring you this letter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "A letter... for me? Who would do that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370305,
					"content": "...Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370306,
					"content": "Have you seen him? I guess that must mean he's okay— Did he say when he'll be back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370307,
					"content": "Sorry, forget all that. I'm sure he must be far too busy to answer all these questions, I don't want to put any more pressure on him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370308,
					"content": "But could you read the letter to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370309,
					"content": "Quietly... No one needs to hear this but the two of us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370310,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "Wow, you read it so nicely... Is this something you do a lot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370312,
					"content": "That's the end of the letter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Liyue Harbor... Wow, Godwin really is seeing the world after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370314,
					"content": "Thank you, I will treasure this letter. Next time you see <color=#00E1FFFF>Godwin</color>, do tell him I'm thinking of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Glory"
				}
			]
		},
