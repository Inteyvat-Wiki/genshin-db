			"dialogs": [
				{
					"id": 200370201,
					"content": "Thank you for delivering my letter. *sigh* All I want to do is go back and see Glory... If only...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
