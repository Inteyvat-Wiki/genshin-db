			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002801",
							"2"
						],
						"stepId": 7002801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "Thanks to the trial data you gathered, the final calibrations to our Pursina's Spikes have been completed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280102,
					"content": "Now, I can call myself reasonably confident that they will perform as expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280103,
					"content": "As long as we place the Spikes in locations that our anomalous model frequents, we should be able to control its power supply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280104,
					"content": "As long as we can activate the Spikes fully, that machine should be unable to initiate its self-repair protocols.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280105,
					"content": "Thank you for your help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "No, no, don't thank me, thank those who came before us and the wisdom that they left behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280109,
					"content": "If we did not have that knowledge as our guide, we wouldn't have been able to come up with a way to take that anomalous Ruin Grader down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280110,
					"content": "All we have done up till now relies on such guiding knowledge, and it is knowledge that is the most valuable resource in the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280111,
					"content": "Seems complicated.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "It's normal to not comprehend this. After all, you have not yet been edified by the supreme wisdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280113,
					"content": "...Hah, look how far I've gone on this tangent. Guess I was too excited at having been able to repair these Pursina's Spikes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280114,
					"content": "Well, now comes the final phase of our preparations. And by that, I mean that we must place these Spikes on Tsurumi Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280115,
					"content": "...I'm afraid that I shan't be able to help you with that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280116,
					"content": "According to Inazuma's local laws, people who lack Residence Permits like myself cannot move about freely. As such, this task is up to you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280117,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "Thank you. I'd suggest that you not act immediately after placing the Spikes. Instead, quickly check to see if everything is functioning normally, and then check back in with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280119,
					"content": "I think we can afford to be a bit more careful for your safety's sake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280107,
					"content": "All hail technology!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "Well, not exactly, I think. I would much prefer hailing the knowledge that our predecessors left behind for us to use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002803",
							"2"
						],
						"stepId": 7002803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "How did it go? Did the Spikes function as expected?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280302,
					"content": "Exactly as planned.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "Good, good, that's good. I only hope that it won't break down later, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280304,
					"content": "Well then. All we need is for the anomalous Ruin Grader to near the Spikes when we activate them, and it should become cut off from its power supply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280305,
					"content": "This time, you should be able to defeat it for good, so have at it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280306,
					"content": "I have faith in your abilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}