					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200100701,
					"content": "What do you think? My Hilichurlian is not bad, huh? Now that we can communicate, all that's needed to understand each other is time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100702
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100702,
					"content": "That's what I hope for anyway. My dream, is to become friends with the hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100703,
					"content": "Oh, right! Before I forget — take this. It's a present from that hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100704,
					"content": "A present from a hilichurl. Bet you never thought you'd see the day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100705,
					"content": "Well I better get going, I have so many new discoveries to note down. Perhaps we'll have a chance to meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
