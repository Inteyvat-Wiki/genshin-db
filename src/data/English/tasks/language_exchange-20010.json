			"dialogs": [
				{
					"id": 200100401,
					"content": "Good thing you were here, otherwise I would have no idea what would have happened to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100402
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100402,
					"content": "I don't think I said anything wrong... Maybe my pronunciation was off...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100403
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100403,
					"content": "Guess I better hit the books again and do some more research before trying again...",
