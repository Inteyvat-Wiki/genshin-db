		{
			"id": 100914,
			"completionStepIds": [
				100914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100914",
							"2"
						],
						"stepId": 100914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "One is most impressed. The path that leads through this abode defies those of ordinary abilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091402,
					"content": "The one before you is the adeptus, Cloud Retainer. Now, speak of the matter which brings you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091403,
					"content": "Did you build this whole place?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "You surmise correctly. This place did oneself build, as did one design the mechanisms within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091407,
					"content": "In fact, even Guizhong and Rex Lapis themselves found one's technological accomplishments to be worthy of commendation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091408,
					"content": "This place is huge! And there are so many mechanisms... Do you really have this whole place to yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "What's it even for? Did you build it as your private mechanism workshop or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "It's just like the stories say. The adepti leave the human world, find somewhere to go be a hermit, and then they research and invent all these amazing things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "One is simply not partial to the tedium of social interaction, and wished to find some peace and quiet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091412,
					"content": "Find it one did... Shortly after which, you arrived bearing your Sigil of Permission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091413,
					"content": "But enough! State the matter which brings you here, at once! You have disturbed the tranquility of this place for long enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091414,
					"content": "Rex Lapis... Assassinated!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091415,
					"content": "How can this be!? Such a heinous crime... Who would dare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091416,
					"content": "The notion is so preposterous as to be unbelievable... one shall have to verify the truth of the matter independently...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091417,
					"content": "...Perhaps one shall quash Liyue first, then convene with the other adepti—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091418,
					"content": "...Excuse me!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Wait, what!? Did you just say \"squash Liyue Harbor\"? Are you seriously gonna wipe out the whole city?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "Only a response of sufficient magnitude can negate the possibility of further incidents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091421,
					"content": "But the adepti are sworn to protect the city...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "It is as you say. We have protected Liyue Harbor under the leadership of Rex Lapis for 37 centuries. But in the face of this coup by nefarious actors... exceptional measures must be taken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091425,
					"content": "It is precisely because one does not wish to see further suffering that exceptional measures are deemed necessary at this exceptional time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091426,
					"content": "Yikes! Quick, you gotta think of something! She wants to squash Liyue flat, and it doesn't seem like she's bluffing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "You accepted our offering, that makes this a contract.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Exactly what Paimon was gonna say! We made all that delicious food, and gave every last bit of it to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "We were hoping you might help Liyue out... not wipe Liyue out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "...Or at least let's... y'know, discuss it first? Can't hurt for you to get a second opinion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "\"Contract...\" A cruel irony that you should appeal to the notion after the merciless murder of the God of Contracts himself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091432,
					"content": "The people of Liyue seem quite content to dispense with their contracts. They are quite adept at taking that which is composed of black and white, and turning it gray...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091433,
					"content": "Nevertheless... Since you come here in the name of contracts, far be it from one to abandon one's own contractual obligations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091434,
					"content": "Least of all when you come bearing a Sigil of Permission... *sigh* Rex Lapis infused these sigils with adeptal power when he first cast them. That power once aided humans in battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091435,
					"content": "Most of the sigil's power has long since worn off... It is but a keepsake now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091436,
					"content": "This keepsake cannot be taken as proof of your trustworthiness. One must investigate the claims that you make independently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091437,
					"content": "This, no doubt, is Moon Carver's very reason for summoning us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091438,
					"content": "Your audience with the adeptus before you is now concluded. Leave at once, and disturb me no further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091423,
					"content": "Aren't you supposed to protect the people there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "It is as you say. But if Rex Lapis has indeed been murdered, then Liyue is in great peril. To delay in quashing the threat is to invite further disaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091405,
					"content": "Did you design all those mechanisms?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "You surmise correctly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
