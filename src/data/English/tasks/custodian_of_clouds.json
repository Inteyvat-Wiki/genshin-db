			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Whoa... The ground is covered in flour. Tsk... What a messy chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "Hmm, seems there's meat in this pot, but Paimon can't tell which kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Do you think whoever cooked this made it as an offering to the adepti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Hmm... Paimon can't quite imagine an offering made of flour and meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Huh? Our messy chef dropped a piece of paper on the floor... Ew, and there's a huge footprint on it too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "But footprint aside, maybe it has something to do with this mystery dish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
							"2"
						],
						"stepId": 100904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "It's very clean here. Whoever cooked here last obviously likes to keep things neat and tidy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090402,
					"content": "Paimon bets they were making an offering to the adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090403,
					"content": "Looks like we got us some Matsutake and some Raw Meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090404,
					"content": "And what do you know, the recipe is right here. This chef was a super organized person...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
