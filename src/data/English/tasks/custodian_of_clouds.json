				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Hey, who put this table here? They've even set it ready for dinner, there's a wine jug and everything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Ooh, they even have the guests' names carved into the seats! \"Here sits Retainer...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "\"Here sits Guizhong...\" \"Here sits Rex...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "Maybe \"Rex\" is short for \"Rex Lapis\"? But Paimon has no idea about \"Guizhong.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "As for \"Retainer,\" hmm... That's it! When Moon Carver was going through the names of his adepti buddies, he said there was one called \"Cloud Retainer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "So, this must be where Cloud Retainer and the other adepti have their dinner parties!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Hehe, how about we cook up some extra-special dishes for the adepti? We're sure to get Cloud Retainer's attention that way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "But... What do adepti even eat, anyway? Paimon has no idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Hmm, people must make offerings here all the time. Guess all we can do is look around the area for any leftovers, maybe that'll give us some ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "Um, do you think maybe it's at all possible that the adepti might like to try some... Sticky Honey Roast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
