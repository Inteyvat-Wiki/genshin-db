			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Have you placed all the supplies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "They're all where they need to be.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "That's wonderful. I can rest easy now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Still, I hope that those who go up the mountain will come sufficiently prepared and that they shan't have to use these emergency foodstuffs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Come to think of it, your clothes seem a little thin, too. Is this the latest fashion in Mondstadt or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "Whatever the case, please take these as a token of my thanks, and go put on some extra layers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
