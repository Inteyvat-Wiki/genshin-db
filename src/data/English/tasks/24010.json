					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100501,
					"content": "Thank you! These paints should last me for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100502,
					"content": "Don't spill them all into the water.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "Into the water? Hahaha. I suppose my painting technique is just as you describe.",
