				"points": []
			},
			"dialogs": [
				{
					"id": 240100301,
					"content": "We cannot be too restricted by concrete forms... We must draw the beauty out and use symbolic methods too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100302,
					"content": "No, no... Still no. This composition is too deliberate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
