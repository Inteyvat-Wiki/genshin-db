				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "This is a good idea... but can it really be done this way...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "How's the drawing going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ah it's you! Thanks for your help previously with the photos! The sights they featured were truly inspiring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "I already have an approximate idea, and I've drawn up some drafts, but... Well, they're not up to snuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Don't misunderstand — this is not to say that I've painted some trash with no aesthetic value at all, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "I feel that they're missing something special, something that can help them transcend the ordinary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "There's something too concrete about the things I have in mind... If I directly translated them into my painting, the beauty I wish to transmit will be damaged for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "*sigh* I fear this is a problem that every artist must face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Perhaps you could try drawing something else?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Thanks for the suggestion, but I fear that this problem will not be solved by a mere change of topics.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Whether it be mountains and rivers, birds and beasts, or the world of humanity... None of them can escape this issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "It is precisely in their search for a solution that some of my colleagues have broken down and transmuted the sights they've seen using their inner feelings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Such art emphasizes one's inner emotions most of all, and the result on the canvas is... How can I explain it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Well, whether it be characters, scenery... Even light carries a sense of strangeness that no traditional sense of aesthetics can capture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "A simplistic glance would lead most to believe these paintings to be the brainchildren of the illiterate in art, or the mad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "But if you calm your spirit and get in tune with the artwork before you, you will hear it roar on the artist's behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "That roar comes from the artist's heart and soul, speaking their feelings aloud... and those feelings are, more often than not, rather intense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Yet their voices cannot be perceived by the ear, but with the heart instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "As for me... I do not yet wish to give in on the concrete, and so I've come up with another way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "I have decided to focus on color, and so I need to find stronger shades and simple yet powerful strokes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "At the same time, I need to weaken the lighting and traditional scene compositions... These things will affect my expression, and so I must ask them to temporarily leave the scene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "But the issue is that the strong, intense colors dictate the use of a lot of paint, and that I need to squeeze the paint directly onto the canvas to achieve the necessary effect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "So, I've... uh, run out of paint. However, I cannot simply move my easel away at the moment. That would surely affect my creative work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "Traveler, could I trouble you to visit Boucicaut? I've ordered a batch of good paints from him, and they should be ready at this point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Or perhaps... Could you help me get some Whopperflower Nectar? That way, I could make a batch of paints on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "You can use nectar to make paint?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Hahaha, of course you can. Some of my fellow artists even use Bird Eggs for that task!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "I hear that paints of this kind have delicate colors but rich layers, perfect for use in depicting resplendent sceneries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "You're a good soul, aren't you? Would you refuse an artist's plaintive plea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Alright, alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Alright, thank you so much! I'll wait here. Just bring them straight back to me once you get them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "You're hopeless... Just leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "You can make paints yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Hahaha, of course! That's the first thing you should learn as a painter — that's how you retain control over the image you create.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Why don't you try a different painting style?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "That's right. Some of my colleagues thought so too, and they are presently attempting to use some \"figurative\" methods of painting to produce something more abstract.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "The most radical amongst them even wish to give up on depicting concrete objects altogether and simply use splotches of paint to express themselves... They call themselves \"Neodescriptionists.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "But I must say that even I cannot quite grasp their work. At most, I can only sense the rhythmic beauty contained within the colored splotches and line work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "As for what any given painting really expresses... I can only ask that painter to explain it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
