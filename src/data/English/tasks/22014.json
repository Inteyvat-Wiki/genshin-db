				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "These bamboo shoots look pretty good. I'll dig some up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Huh? It's you. What brings you here? Want me to whip something tasty up again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "Well, I've got something I need your help with.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "Oh. Handling ingredients from Inazuma using techniques from Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "Hehe. You've come to the right chef! I've heard of an Inazuman technique where you wrap ingredients in flour and fry them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "It's called tempura and it's served with a special dipping sauce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "I was particularly interested in the dipping sauce when I tried making tempura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "I've tried so many ingredients: Whopperflower Nectar, Flaming Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "Is it made with Slime Condensate, by any chance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "No, no. Slime Condensate isn't appropriate for this dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Still, I prefer adding the powder from Electro Cicin wings to give it a more layered texture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Just in case you forget, I'll write it down. Then you can show it to Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "*sigh* I wish I could go to Inazuma. There must be so many ingredients I haven't used yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "You reacted just like Chef Mao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "Oh, you went to the restaurant? Hmm. But now that I've had another look, you don't look like you're here for a meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "Are you having some culinary problems, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Xiangling"
				}
			]
