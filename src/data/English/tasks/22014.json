					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "That should be enough. Hold on a moment. I'll see what I can do with these ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140402,
					"content": "Done. Still, I feel like it's not all that different from the dishes I usually make...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140403,
					"content": "Take this dish back to Xudong. Hopefully, it'll solve his problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
