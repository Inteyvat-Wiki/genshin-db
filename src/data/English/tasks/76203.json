				]
			},
			"dialogs": [
				{
					"id": 762030401,
					"content": "Hey, this is Simulanka! Uhm... but why are there light novels from Yae Publishing House all over the floor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Well, on the subject of my literary enlightenment, my greatest inspiration of all... is none other than Lady Anya herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "She was the last to join the Hexenzirkel, and yet the first to leave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "I loved all of her stories. Whether it was just an idea or a fully fleshed-out manuscript, Anya was always so skilled at making her readers gasp with joy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Hexenzirkel discussions rarely stray far from magic, and it's my belief that Anya possessed a unique magic of her own. She could weave love and compassion into words and stories that would touch the hearts of others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "I asked her for tips on how to write compelling tales. She taught me a lot of tricks and techniques, but in the end, my biggest enemy has always been myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Too lazy to put pen to paper?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Haha! That's one way of putting it. Communicating through thought is so much more convenient. I guess even angels can succumb to laziness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "However, recently I've resolved to make an effort, even if it's just to spare myself reproaches from a certain old Seelie friend of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Ooh! Does that mean we're finally gonna get to read something you've written?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Who said anything about writing? I'm talking about buying popular works from the last few centuries to flip through in my spare time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Haha! That's one way of putting it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Communicating through thought is so much more convenient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "I guess even angels can succumb to laziness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
