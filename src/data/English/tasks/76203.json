					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030502,
					"content": "Alright, go ahead and claim our reward. What? Don't look at me like that! Of course, this reward is \"ours.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030503,
					"content": "You're not going to leave this chest unopened, are you? I can't let you leave if you do. Besides, after telling you so many stories, don't I deserve a reward of my own?",
