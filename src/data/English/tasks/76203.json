						"stepId": 7620302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "What the—!? Paimon almost had a heart attack, being sucked in by a painting like that! ...Wait a sec, this place looks familiar... Oh, it's the table where the mages hold their tea parties!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "It all started the first time Alice invited me for tea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "On that day, I didn't attend in person — mostly because, back then, I still hadn't decided whether I really wanted to join the Hexenzirkel or not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Alice was the only one there who knew my true identity. She warned me not to say a word, or let anyone else discover who I was. I was only supposed to observe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "...And then what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Well... Then, I concluded that she was punishing me for my hesitation to join.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Everyone was talking about such interesting things. How could I not chime in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "And of course, when you're in the middle of a conversation, and someone throws out a question you know the answer to, how are you supposed to keep your mouth shut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Which brings us to the bet between Barbeloth and Alice, Rhinedottir's forbidden creations, Ivanovna's political machinations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "It was like a series of exquisitely acted plays, distilled within the confines of a teacup. Their words alone were enough to ignite my instinct to lay the truth bare before them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "So, you piped up inside their heads?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Of course not! Even though I felt like my head was going to explode, I still made sure to hold it all in. I'm a responsible angel, after all — and I'm well aware of the difference between \"what I want to say\" and \"what I'm allowed to say.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "So I had a private little word with Alice inside her head — just me and her — and I agreed to join the Hexenzirkel, right there and then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "She was quite happy about my decision, but as for the talking inside her head... Well, she claims that over the next few days, she had such a headache that she had to visit a doctor in Liyue to get some relief. But she can hardly blame me for that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620303,
