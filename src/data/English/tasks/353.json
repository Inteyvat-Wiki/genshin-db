			},
			"dialogs": [
				{
					"id": 3532801,
					"content": "Ooh! Did you just feel the elements of the world?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532802,
					"content": "Seems all you had to do was just touch the statue and you got the power of Anemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532803,
					"content": "As much as they may want it, people in this world can never get a hold of powers as easily as you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532804,
					"content": "I think I know why, it's because...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "Ah-ha, it's because you're not from this world to begin with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532809,
					"content": "If we keep heading west from here, we'll eventually reach Mondstadt, the City of Freedom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532817,
					"content": "Mondstadt is the city of wind, because they worship the God of Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532810,
					"content": "So perhaps, because you got power from the God of Anemo, you can find some clues there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532811,
					"content": "#There are also lots of bards there, so perhaps one of them has heard news of your {M#sister}{F#brother}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532812,
					"content": "Let's move then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532813,
					"content": "The elements in this world responded to your prayers and Paimon thinks that's a lovely sign.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532807,
					"content": "This can't be good...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "It's a bit rude to say that about the power the gods just gave you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
