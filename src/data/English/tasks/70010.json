	"talks": [
		{
			"id": 7001001,
			"completionStepIds": [
				7001003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001003",
							"2"
						],
						"stepId": 7001003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "So, about your commission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "Saw my commission and came running, did you? Well, I do have something that I need your help with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "Specifically, I'd like you to take pictures of two places on Dragonspine. I'll mark the exact locations for you on your map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "As for compensation, I'll make sure you're paid as per the Adventurers' Guild's rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "How about it? Will you take the commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "Why do you need to take pictures in these two spots?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Well... this has to do with Cyrus, ultimately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "He asked me previously to get him some of Dragonspine's specialties. Said he wanted to use them as part of a recruitment drive during the Windblume Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "Well, now's the festival period, but he hasn't contacted me at all. Must be busy, I suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Now that I mention it, he is at that age, isn't he? He should be busy with the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "I think he might be way too old for that by now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Really? I don't really get that feeling. In fact... Hmm, never mind. Let's not get into that right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "So far, I've collected some ores and put together some topographical charts and monster reports. I'd like some photos of scenic spots in Dragonspine to go with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "So, Traveler, would you mind helping me go up Dragonspine to take pictures of those two spots?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "You can count on me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Great, I'll leave it in your hands, then. I've marked the two places out on your map. Just head there and come back once you're done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "Not going to the city to see how things are going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "It's all a little too much for me. I personally prefer how things are here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "I've got quite a lot on my plate to boot, so I doubt I can go at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "I've marked the most scenic spots on your map. Just head there and come back once you're done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
							"2"
						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "So, about your commission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "Oh, you're done already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Sure am.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Thanks for your hard work. I've got the package I intended to send to that boy ready as well. Would you mind delivering it to him? I'll have your payment ready once you're done, so do remember to come back here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "I'm not sure if this will be enough for him to use, but if he's recruiting, monster records and ores should pack the biggest punch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "*sigh* This recruitment drive doesn't look like it'll be any good at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Special delivery from Iris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Oh, she sent me something? Right, that's right. I did ask her before, but I wound up forgetting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "What happened to enjoying the Windblume Festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "The Windblume Festival? No, I haven't any time for that. Our previous recruitment program is obsolete, I'm busy coming up with a new one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Let me see what Iris sent me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "Ores... No, that's no use... Young people these days couldn't be bothered with this stuff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Maps? *sigh* Oh, it'll be useful to the Guild members, alright, but I don't think that it's any good for recruitment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Notes concerning monsters? Well, we should make some extra copies for our adventurers, but forget using it to attract new people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "Oho, what's this? These two photos are pretty good. Beautiful scenery — and it looks safe, too. Ah, this'll catch someone's eye, that's for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "Why're you picking this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Looks like he's thrown out the ones actually related to adventuring...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Ah, you don't understand the state the Guild's in. Nowadays, young people aren't interested in things like monsters, ores and topographical maps anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "If you want to get the modern youngster's attention, you need to give them something they can use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "It's the Windblume Festival now, see, and these young folks are definitely spoiling for all sorts of unique — but not necessarily dangerous — ways of displaying their charm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "Adventuring in Dragonspine is one such thing they can do. If the photos interest them, they might come to the Guild to ask about them, and then, they might join the Guild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "And... even if they don't join, well... some extra commissions would be nice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "What's more, if you look at these two drawings, they are both positioned next to the main road. As long as you're careful, you shouldn't be in any danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "We're really scraping the bottom of the barrel, aren't we...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Well, this is how things are. I wouldn't do this if we had any other ideas we could use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "If you don't believe me, why don't you take these two photos and show them to some people?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "First, tell them that we're recruiting, and then show these two photos as \"recruitment material.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100324,
					"content": "You'll see why I had to come up with this idea in no time at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7001004,
			"completionStepIds": [
				7001011
			],
