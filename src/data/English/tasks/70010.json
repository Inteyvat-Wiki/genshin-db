			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#Hey there, {M#amigo}{F#amiga}! Would you like to hear my latest composition?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100402,
					"content": "About the Adventurers' Guild recruitment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "Adventurers' Guild recruitment? Lo siento, I'm not interested in such things. Running around like a headless chicken is of no use to a bard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100404,
					"content": "Besides, in the city of Mondstadt, surely the Knights of Favonius constitute better source material for composing an epic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100405,
					"content": "Lo siento, I'm not interested in the Adventurers' Guild recruitment. Rescuing cats... isn't great song-writing material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100406,
					"content": "Here's the recruitment material.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "Is this... Dragonspine? Qué vista magnífica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100408,
					"content": "Perhaps a spot of sight-seeing would give me new flourishes of inspiration. And it doesn't look too dangerous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100409,
					"content": "Hmm... I'll pass by the Guild later and have a word. Even if I don't sign up, I'm sure I could hire an adventurer to escort me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "Six-Fingered José"
				},
				{
					"id": 700100410,
					"content": "A tour of Dragonspine... I can hardly wait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Six-Fingered José"
				}
			]
		},
		{
			"id": 7001005,
			"completionStepIds": [
				7001012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001012",
							"2"
						],
						"stepId": 7001012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Helen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "Oh! Can I help you? I was just about to start a tune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100502,
					"content": "About the Adventurers' Guild recruitment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Oh, that... I did see a notice, but it doesn't interest me. I can protect Mondstadt with my song, I don't need to become an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100504,
					"content": "I heard that the majority of commissions are odd jobs. I don't see how it would benefit me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100505,
					"content": "Sorry, I will politely decline, but thank you for thinking of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100506,
					"content": "Here's the recruitment material.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "Huh? That looks like Dragonspine. A Statue of The Seven surrounded by snow... such a striking image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100508,
					"content": "So this must be at quite an altitude? People say that you can see for miles around up there... I bet my voice could carry over much further distances...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100509,
					"content": "I'll go and ask at the Guild a little later. I'm sure I saw something about adventurers for hire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100510,
					"content": "I had no idea that adventurers went to such places... fascinating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Helen"
				}
			]
		},
		{
			"id": 7001006,
			"completionStepIds": [
				7001015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001015",
							"2"
						],
						"stepId": 7001015,
						"stateName": "QUEST_STATE_UNFINISHED"
