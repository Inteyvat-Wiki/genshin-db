				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "How did it go? Did you manage to gauge how everyone feels?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100602,
					"content": "I did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Then you see what I mean... That's the way things are. I've gotten used to it by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100604,
					"content": "*sigh* I don't care how we do it... But so long as we find a method that brings results, I'll thank the Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100605,
					"content": "I guess you'll be heading back to Dragonspine soon to report in with Iris?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100606,
					"content": "Do me a favor and deliver this letter to her. She'll definitely want to know about the situation of late here at the Guild. Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100607,
					"content": "*sigh* I hope we get some new recruits this time... But will the type of person who responds to this kind of marketing tactic be reliable adventurer material...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7001007,
