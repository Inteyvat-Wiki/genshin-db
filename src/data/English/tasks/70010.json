			},
			"dialogs": [
				{
					"id": 700100701,
					"content": "About the commission...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100702
					]
				},
				{
					"id": 700100702,
					"content": "You're back! What took you so long? I bet Cyrus got you to run some extra errands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100703,
					"content": "I helped him make a few inquiries...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "Just what is that boy up to now... Oh? A letter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100705,
					"content": "This letter talks about the recent state of the Guild.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Huh, doesn't feel like a short read. Seems like he has been busy after all, even during the Windblume Festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100707,
					"content": "Still, if he is working so hard, it's about time the Mondstadt Adventurers' Guild recruited some new members.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100708,
					"content": "Once we have enough recruits, he should be able to delegate the smaller matters to others and come adventuring with me again... *sigh* That would be nice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100709,
					"content": "I'll give this a good read. But seeing as Cyrus added to your workload, it's only fair that I factor in some extra payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100710,
					"content": "Here you go. Thanks for your hard work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
