			"dialogs": [
				{
					"id": 50220801,
					"content": "#Morning, {NICKNAME}! Did you have a nightmare last night?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "Paimon could hear you tossing and turning in your sleep. Maybe you're just nervous for the final battle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(So, it was a dream? I can barely remember it.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Everything that happened seems so hazy. Trying to remember is giving me a headache...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "#Just shake it off, {NICKNAME}! We're supposed to meet with Mavuika today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
