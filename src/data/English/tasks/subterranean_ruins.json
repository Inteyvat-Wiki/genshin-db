					}
				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(When I passed through the wall of light, it felt like my whole body was frozen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(I guess the Lord of the Night's protection can't reach this place. The cold and darkness are suffocating, and all I hear are cries of exhaustion and pain.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(How long have these souls existed in torment? How much longer before it ends...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Huh? There's someone here...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Though our homeland has become a distant memory, the flames of war continue to rage. We have long shed the last of our blood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 50220706,
					"content": "Stay strong, my soldiers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 50220707,
					"content": "(What is The Captain doing here? And what is he saying...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "One day, I will deliver you to the place I promised.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Captain\""
				}
			]
		},
