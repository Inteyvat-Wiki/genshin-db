			"dialogs": [
				{
					"id": 50220401,
					"content": "(Where am I? Is this... the Night Kingdom?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "(How did I get here? I was just... Argh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(I feel dizzy, like I can't think straight. Let me try to take a look around...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
