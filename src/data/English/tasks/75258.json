			"dialogs": [
				{
					"id": 752580101,
					"content": "Huh? Why's there someone passed out here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "Heeey! Can you hear Paimon? Are you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "You help the man up, and he slowly regains consciousness...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ow, ow, ow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580105,
					"content": "Hello. Have you had too much to drink?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Head hurts... How'd I... Lemme think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580108,
					"content": "Ah! I remember! I think I got knocked out by someone... but I didn't see who. Wait... It wasn't you, was it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580109,
					"content": "Hey! We're the ones who helped you up! You should be thanking us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Oh, sorry... Uhm, I work at the Me & Dew bar. I was originally going to deliver some goods to the port in the north... A merchants' association from Nod-Krai bought some Aphimead from us, you see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580111,
					"content": "Oh! No! The Aphimead! It's gone! Did they steal it? Wait, YOU didn't steal it, did you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580112,
					"content": "Why do you keep accusing us!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Oh, right. Sorry, sorry... I guess it must be the dizziness. Thanks, you two. I need to head back to the bar and tell them what happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580114,
					"content": "If there really are bandits on the loose, you should probably stay away from the northern port. It could be dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Unconscious Employee"
				},
				{
					"id": 752580106,
					"content": "Do you need me to take you home?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
