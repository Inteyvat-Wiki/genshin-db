			"dialogs": [
				{
					"id": 761920201,
					"content": "That was a great shot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920202,
					"content": "Feeling satisfied now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "Mhm! Whether the legend's true or not, I hope that, wherever you go, Helka, luck will see you through any danger and bring you back to Speranza, safe and sound.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920204,
					"content": "...Thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "Hehe, shall we head back then? Thanks so much, Linnea! See you at Speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920206,
					"content": "Mm-hmm! See you there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
