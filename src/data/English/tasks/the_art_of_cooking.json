			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "What should I cook next...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670102,
					"content": "Oh, are you travelers from around here as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670103,
					"content": "No, we just happen to be passing by. *sniff* *sniff* What are you cooking? Smells good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670104,
					"content": "I see. Welcome, travelers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670105,
					"content": "I'm Lynn, the survival expert of the Adventurers' Guild. As you can see, I'm experimenting with some new recipes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670106,
					"content": "\"Eat before you go\" — The first rule in the \"Wilderness Survival Guide.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670107,
					"content": "A picnic! Oh, Paimon just loves picnics!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670108,
					"content": "My travel partner here is good at cooking as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670801,
					"content": "I can only cook a few simple dishes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "That's okay. Let's see what you can do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670803,
					"content": "You won't get a lot of chances like this to learn from a survival expert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671001,
					"content": "There are some Mushrooms and meat in the barrel over there. Try making a <color=#00E1FFFF>Chicken-Mushroom Skewer</color> for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670901,
					"content": "That's right, I love cooking too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "Oh, there's a cooking pot right here. Show me what you got!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670903,
					"content": "It's good to have someone to practice with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				}
			]
		},
