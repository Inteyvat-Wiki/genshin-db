						200160502
					]
				},
				{
					"id": 200160502,
					"content": "Um... is it Calla Lily Seafood Soup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160503
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200160503,
					"content": "Yay, it is mine then. But I'm not sure what took you so long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160504
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200160504,
					"content": "Any later and Draff would have dragged me out on a hunt by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160505
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200160505,
					"content": "Ugh, whatever. Here's your money. Now get outta here, let me eat my food in peace.",
