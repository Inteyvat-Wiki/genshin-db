			"dialogs": [
				{
					"id": 200160701,
					"content": "Excuse me, did you order some takeout?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160702
					]
				},
				{
					"id": 200160702,
					"content": "Yes, a long time ago! Took you long enough! There'll be no treasure left if I wait much longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160703
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 200160703,
					"content": "Mmm, this does smell delicious though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160704
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 200160704,
					"content": "Well, I guess good food is also a treasure worth waiting for. I'm sure I've got time to eat before treasure hunting.",
					"roleType": "TALK_ROLE_NPC",
