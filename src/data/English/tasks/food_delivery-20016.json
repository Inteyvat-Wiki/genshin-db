					"nextDialogs": [
						200160204
					]
				},
				{
					"id": 200160204,
					"content": "Let me check... Perfect! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160205,
					"content": "Here, this <color=#00E1FFFF>Crab, Ham & Veggie Bake</color> is for you. It's fresh out of the oven, eat it while it's hot.",
					"roleType": "TALK_ROLE_NPC",
