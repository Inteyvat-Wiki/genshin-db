			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "All things must change...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140102,
					"content": "How do you do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "Mm? Youngster, are you here to admire the flowers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140104,
					"content": "But it's a shame. These Glaze Lilies have almost all wilted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140107,
					"content": "What happened to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "Back in my day, people said that Glaze Lilies can read human hearts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140109,
					"content": "If they heard beautiful sounds like laughter and singing, they would also bloom joyfully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140110,
					"content": "But if they heard too much wild gossip or slander, they would quickly wither away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140111,
					"content": "...So that means these flowers feel what's happening in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "Yes, the rumors of Rex Lapis' death are no small matter. They are everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140113,
					"content": "Some say it was a Fatui plot. Others say that the Qixing made it all up, and still others think that That Which Lies in the Deep is breaking free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140114,
					"content": "This harbor is like a mountain of dry tinder. One spark and the fire will consume us all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140115,
					"content": "...Well, I shall say no more. This old woman's grown too old and naggy... Did you have something to say, youngster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140116,
					"content": "We'd like to borrow the Cleansing Bell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ah, that old trinket... I remember it being here with me, but I've grown old. I can't quite recall where it is exactly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140118,
					"content": "An old friend of mine used to wear it on his person, back when I was young...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140119,
					"content": "He saw me gazing at it often and gave it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140120,
					"content": "But he told me then that if someone should come to borrow that bell, I should not be loath to part with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140127,
					"content": "It has been many years, and who knows how many times someone has come to borrow this bell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140128,
					"content": "Still, though I can't recall when it started, it's been a long time since anyone has come to borrow it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140129,
					"content": "Ah, these old bones are so slow to look for things. I doubt you can wait that long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140130,
					"content": "We can look for it ourselves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "That's right granny. We'll follow you back home, and search for it ourselves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "And... Um, we can help with chores if you have any too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "Alright, children, there is no need to worry. I didn't place the bell very far away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140136,
					"content": "Eh? Do you live near here, granny? Whoa, but this is Yujing Terrace. It's gotta be expensive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Haha, an old lady like me can't afford to buy a place in this city. See this ceramic teapot? My entire household is in here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140138,
					"content": "...How does that work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "It contains your house keys?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Hohoho, youngsters. I simply mean that the bell is somewhere inside this teapot, and you are quite welcome to borrow it — if you can find it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140140,
					"content": "The bell is all you own?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Hey, that's rude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "...And even if it was like that, it must be a very expensive bell, right granny?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "In you go, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "What!? There's no way Paimon would fit in there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "And why do you need Paimon to go in, anyway? Can't you just lift the lid and look inside?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "I'm a Knights of Favonius-certified lost property finder!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "What a weird thing to be proud of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "We'd like to borrow something from you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "Borrow something? ...Oh, you've come to borrow the Cleansing Bell, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140123,
					"content": "Apart from that, I don't have anything of value that you youngsters might want.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140124,
					"content": "But it was not originally mine, either. That trinket used to belong to a friend of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140125,
					"content": "I was a vain beauty when I was young, and I would pester him for that bell all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140126,
					"content": "He could not dissuade me, and so he gave it to me. But he said that if someone should come to borrow it, I must not be loath to give it away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140105,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "It's nothing, it's nothing. I just thought it a great shame that so many of these Glaze Lilies have wilted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "Aren't you youngsters in a hurry to find that bell? Hop to it, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140202,
					"content": "But be careful, I haven't cleaned this place up in a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140203,
					"content": "If you were to get dirt on your beautiful clothes, it would take some work to clean up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Ho-ho, in and out in no time... You youngsters really are quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140302,
					"content": "Are you an adeptus, ma'am?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "An adeptus... I haven't heard anyone say those words in earnest for a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140304,
					"content": "As to whether I am one or not, child, surely you already understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140312,
					"content": "Ugh... Paimon kinda knows what you mean, but is also kinda confused. Are you really giving us the bell just like that Granny?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "Don't you think it's weird? Something's just happened to Rex Lapis, and then we come running up asking for it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "Oh, don't be silly. Liyue Harbor has been through a great deal in its history. In that time, it has seen the departure of countless adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140315,
					"content": "But no matter what, we have always performed the Rite of Parting first before any other matters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140316,
					"content": "To cry \"catch the murderer!\" at the top of one's lungs, but ignore the Rite of Parting... That, to me, is what is wrong-headed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140317,
					"content": "Now that you have come to borrow the bell, I guess that perhaps an old friend of mine has finally decided to take matters into their own hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140318,
					"content": "So, why would I be unwilling to lend you the bell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140319,
					"content": "What if your friend doesn't return it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Oh? Well, if it came to that... Haha, they would find a certain old lady knocking at their door.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140321,
					"content": "We haven't met in a while anyway, it would be nice to share a drink and chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140326,
					"content": "Well, you must have things to do. Since you have the bell, you should return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140327,
					"content": "Oh, and, do tell the person who sent you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140328,
					"content": "...that if they have time, they can come over for tea. I don't have much to offer, but you can always count on an old lady for a pot of tea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140329,
					"content": "We will! Thanks, granny!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Can I keep it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "Hey! It belongs to granny! We're supposed to return what we borrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "Let you keep it? Haha, you really are a frank child. If you want it, you can keep it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140325,
					"content": "But this bell gets homesick sometimes. Who knows, it might find its way back into these old hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140305,
					"content": "Are you one of the Liyue Qixing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "The Qixing... Those children stopped letting my friends and I into their counsel long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140307,
					"content": "Still, they've done well recently. We old folks are content to be idle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140308,
					"content": "Are you with the Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "The Fatui? Hah! Child, what goes on in that mind of yours, I wonder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140310,
					"content": "I'm far too old to be quibbling with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140311,
					"content": "But if they overreach themselves, I will do what I must.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
