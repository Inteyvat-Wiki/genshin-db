			"dialogs": [
				{
					"id": 733280201,
					"content": "Well, here's your a thousand hugs! Until next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280202,
					"content": "Where will we meet again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "Who knows? Maybe in Celestia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280204,
					"content": "Hahahaha! I was joking! But if you want to see me there, I will definitely be there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280205,
					"content": "Don't ask me why. I just know it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280208,
					"content": "Anyway, until next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280206,
					"content": "A thousand hugs to you too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "Haha, thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				}
			]
		}
	]
