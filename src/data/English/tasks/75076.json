				"points": [
					{
						"sceneId": 3,
						"position": [
							-2604.717,
							-668.697,
							8534.391
						],
						"pointId": 9971
					},
					{
						"sceneId": 3,
						"position": [
							-2606.36,
							-668.697,
							8537.296
						],
						"pointId": 9972
					},
					{
						"sceneId": 3,
						"position": [
							-2604.116,
							-668.697,
							8534.72
						],
						"pointId": 9973
					}
				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "Ah, at last... Were it not for your aid, outlander hero, we might have long been overwhelmed by our pitch-black foe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Weakened Wayob Manifestation"
				},
				{
					"id": 750761202,
					"content": "...Long ago, the tribespeople here were ensorcelled, enchanted by our enemy, and many Nightsouls became entangled by the Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Weakened Wayob Manifestation"
				},
				{
					"id": 750761203,
					"content": "At the seal's location, even the power of Night's manifestation is slowly being chipped away... This seal severs all links with the outside world, yes, but with the source of the tribe's faith also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Weakened Wayob Manifestation"
				},
				{
					"id": 750761204,
					"content": "It must be undone for there to be any fighting chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Weakened Wayob Manifestation"
				},
				{
					"id": 750761205,
					"content": "Thank you, outlander hero... The Nightsouls can find their way back to their dream-home, avoiding the blight that grips the Lord of the Night's realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Weakened Wayob Manifestation"
				},
				{
					"id": 750761206,
					"content": "Ah, at last, to be able to return to the quietude of Night...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Weakened Wayob Manifestation"
				}
			]
		}
	]
}