			},
			"dialogs": [
				{
					"id": 705140501,
					"content": "#Well, {F#Ms.}{M#Mr.} Honorary Knight, I leave the matter of these components to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
