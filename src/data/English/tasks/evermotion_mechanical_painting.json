	"talks": [
		{
			"id": 7051401,
			"completionStepIds": [
				7051401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051401",
							"2"
						],
						"stepId": 7051401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "The passion of Mondstadt is well-founded, I say. More so than I imagined, in fact... even their hilichurls are so very lively.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "Regardless, Mr. Yogue, we ask that you not go out by yourself again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140103,
					"content": "What? Then what about my machine? I'm still missing... um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "1, 2, 3... 18... 19 components!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "We've got adventurers working on finding them. Just wait here in the city where it's safe, please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140106,
					"content": "But without that device, my... It's a matter of inspiration, you understand? What shall I do when inspiration strikes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "Ah, it comes and it goes... Like a belch after a good drink, or a candle in the wind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Hmm, actually, that's not a bad analogy. I should write it down. I'm sure Xavier would love it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "You...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140110,
					"content": "Huh? Honorary Knight? Ah, wonderful! Just the person I wanted to see! Please, over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140111,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Well, allow me to introduce you. This man here is from the Court of Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140114,
					"content": "No man am I, but a daydreamer! That is how we name ourselves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "...So, Mr. Yogue, this is our Honorary Knight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140116,
					"content": "Yogue! Félix Yogue. Salutations to you, Honorary Knight! Long have I heard of your many exploits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "You know of me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "Of course, of course! Who wouldn't?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "Your battle against Dvalin in Mondstadt made headlines in The Steambird for three whole weeks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "Hahaha, if those reporters knew that I was speaking to you right now, why, they would be beside themselves with envy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "What's The Steambird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "Ah, you don't know? It's a... Ah, let's say it's a rather popular newspaper in the Court of Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "You once got their sales up to record numbers, I'll have you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "Headlines, you say?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "Indeed! And you got their sales up to record numbers, to boot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Front-page, full-length, expert interviews up the wazoo, and the best hand-drawn illustrations Mora could buy! You made a lot of people mad Mora there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "Well then... Traveler, Mr. Yogue, I shall leave you guys alone... I've got some other things to handle at the moment, if you'll excuse me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140129,
					"content": "Swan leaves in a hurry...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Ah, it is as I was told. The Knights of Favonius have a never-ending backlog of work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "So, why are you here in Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Me? Well, I'm actually planning to tour Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "As for the purpose of my trip, why, it is to promote these Kinesis Cores that I have made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "Simply put, a Kinesis Core is a form of clockwork device. As long as its mainspring is wound from time to time, these cores can provide motive force for a long period of time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "I even created a sort of perpetual-motion toy powered by the Kinesis Core to show off its capabilities. I call it the Evermotion Mechanical Painting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "Unfortunately, while I'd love to show the device to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "Its allure was all too much for even monsters to resist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "At the moment, they must have divvied my device up into many pieces in a manner most unfriendly, playing around with each component...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "I have, of course, asked for the help of the Adventurers' Guild, but I have received no news from any adventurer so far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "Honorary Knight, could you help me out as well, if you have a mind to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "Believe me, neither my device nor the payment due will disappoint you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "Wonderful. You are indeed a mighty adventurer, and a mighty sympathetic one, too. Just as the papers said!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "Ah, it's a shame that we're in Mondstadt. Were we in the Court of Fontaine, I would bring a few reporters from The Steambird for an exclusive interview with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "I'm sure that your charisma would bowl them over to the point where you'd be guaranteed another three weeks' worth of headlines — not to mention the requisite royalties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Front-page, full-length, expert interviews up the wazoo, and the best hand-drawn illustrations Mora could buy! You made a lot of people mad Mora there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "Did something happen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7051403"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "You've returned, Honorary Knight. What news of the components?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140302,
					"content": "You mean these?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051404",
							"2"
						],
						"stepId": 7051404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "Yes, indeed! Ah, this is wonderful! Heavens, yes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140402,
					"content": "Well now, since all the components have been returned to us, all that's left is to combine them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140403,
					"content": "Well then... Honorary Knight, if you want, you can attempt to put all the pieces together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140404,
					"content": "It will be an interesting experience, trust me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				}
			]
		},
		{
			"id": 7051405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
