			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "Hmm, this bottle feels heavy. Seems like there's something inside it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280102,
					"content": "\"An old friend of ours came over yesterday bearing ill tidings...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280103,
					"content": "\"I have not received a reply from you in a long while. Perhaps he is right, and I should accept reality.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280104,
					"content": "\"But nonetheless, if you are still wandering the land, should you receive this missive, I hope that you can send me a reply.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280105,
					"content": "\"Attach your insignia to your letter, that I may recognize you by its presence when the time comes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280106,
					"content": "\"Do you remember Uyuu Restaurant? We shall meet there. You will find money for wine attached herein.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280107,
					"content": "\"But if you are not the one I was expecting to receive this letter...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Drifting Bottle"
				},
				{
					"id": 701280108,
					"content": "\"Then please, take this keepsake all the same. Perhaps you might be able to find its original owner for me — do also take the Mora in here as thanks.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drifting Bottle"
				}
			]
		}
	]
}