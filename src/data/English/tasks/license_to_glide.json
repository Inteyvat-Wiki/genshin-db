			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "I mean, I read it but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "I can't say I really grasped the rules...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Great, you're here! Did you have a good read-through of the gliding manual? Got all the rules down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Sounds like it was a real drag. I would know, I've been there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "The gliding manual is super dry... I couldn't get into it at all. Don't tell Jean though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Really? Hmm... Paimon thought there were some pretty cool stories in the gliding manual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Cool stories? Oh, you must mean the example cases in the Appendix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Some of them I like. My favorite one is about the illegal Anemo Slime take-off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Apparently, if you pop an Anemo Slime and take off in the burst of wind, it shoots you up really, really high... I really wanna try it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "No, not that story. Paimon meant the one with the little bird who wanted to learn to fly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Ah... What...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Lemme take a look... Shoot, this is the storybook I used to read as a kid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Oops, sorry! I put both books in the same pile and must have grabbed the wrong one when I was leaving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "How in the heck do you confuse a bedtime story with an instruction manual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ahh... This is so embarrassing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "It's because... Maybe deep down inside, that fairytale is the thing that truly taught me how to glide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "\"What you lacked was not wind. It's courage that's allowed you to become the first flying birds of this world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Reading that gave me the courage to glide, to become an Outrider, and to become the Gliding Champion of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "...But anyway, let's get back to the exam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "Don't be nervous, just glide like you're used to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "I'm ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Okay then. You just need to follow the <color=#00E1FFFF>marked route</color> to the finish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
