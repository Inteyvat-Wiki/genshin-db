				"objectNames": [
					"Little Fei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "Meng, today I get to be the captain — right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, I've been the captain loads of times in a row now, we should let Fei have a turn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010103,
					"content": "But Meng, you're the bestest captain ever! I want you to keep being it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010104,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "We're trying to play a game. They promised me I could be the captain this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010106,
					"content": "But Lulu keeps saying it's way more fun when Meng is the captain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010107,
					"content": "*sigh* Lulu always does this... But, if it's what she wants... I guess it's fine by me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010108,
					"content": "Hey, do you have time to join in? You can be the pirate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010109,
					"content": "Okay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "*sigh* Once again, as always, I'm just the first mate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010113,
					"content": "Just like last time, come and join us when you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010111,
					"content": "But I wanna be one of the good guys.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "*sigh* Ah, I really wanna be the captain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Little Fei"
				}
			]
		},
