				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "Here we are! Here's the captain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010302,
					"content": "What are you doing, bringing the pirates here!? You should've led them on a wild goose chase so that me and Lulu would have time to escape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010303,
					"content": "Why do you and Lulu get to escape while I have to stay here and hold the pirates up!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010304,
					"content": "I got a better idea: I give you over to the pirates while I escape with Lulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010305,
					"content": "But... Beidou says you should never abandon your friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010306,
					"content": "Oh? And does Beidou also say that the captain should run away with their favorite person at the first sign of trouble!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010307,
					"content": "Why you little... I'm never sharing my Lotus Heads with you EVER again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010308,
					"content": "FINE! It's only you who cares so much about stupid Lotus Heads anyway!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010309,
					"content": "They are blowing this way out of proportion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Don't worry, I know a way we can sort this out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010311,
					"content": "Lotus Heads are their favorite thing in the world... Giving them their favorite treat will definitely calm them down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010312,
					"content": "Can you find some Lotus Heads for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010313,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Thank you! You need to be quick though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010315,
					"content": "It's not Lotus Heads they're fighting over...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Oh... Really? Well what is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010317,
					"content": "...Anyway, just get some Lotus Heads. We can't have them arguing like this all day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				}
			]
		},
