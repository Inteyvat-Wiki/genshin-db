			"dialogs": [
				{
					"id": 220010601,
					"content": "Ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010602
					]
				},
				{
					"id": 220010602,
					"content": "Alright then. I guess we can start.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010603
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010603,
					"content": "I hate being the first mate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010604,
					"content": "Lulu and Meng only care about themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010605,
					"content": "Ar! Do I spy me some pieces of eight? Hand 'em over!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "Oh, hi pirate. Sorry, I'm just a poor first mate with nothing for you to steal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010607,
					"content": "If you're here to rob the boat, you need to find someone with enough money... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010608,
					"content": "I know! The captain is really rich — you should go and steal from him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010609
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010609,
					"content": "Wh—What!? Don't you work on this boat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010610,
					"content": "Yeah! That means I know how to find the captain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010611
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010611,
					"content": "He's just a captain anyway... What's so special about that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010612
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010612,
					"content": "Come with me! I'll take you to the captain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Fei"
				}
			]
		},
		{
