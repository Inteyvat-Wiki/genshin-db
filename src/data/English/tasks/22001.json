			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Fei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010401,
					"content": "Did you find some Lotus Heads yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010402
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010402,
					"content": "Yup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "You're the meanie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010404,
					"content": "No, you're the meanie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010405,
					"content": "Stop fighting. You're only going to wear yourselves out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010406,
					"content": "It's just a game, there's no need to get so mad. We're all friends, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010407,
					"content": "And look what I've got... Freshly picked Lotus Heads! Go on, help yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010408,
					"content": "Once you've eaten, we're gonna straighten all this out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010409,
					"content": "We'll decide who gets to be the captain and the first mate, and in what order. Sound good?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010410,
					"content": "Fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010411,
					"content": "Okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010412,
					"content": "Wow, it actually worked! Peace and quiet at last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Told you so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010414,
					"content": "How did you know that would work?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "We've been playing together a long time. I know these things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010416,
					"content": "Little Lulu is a miracle worker...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Heeh-hee, thanks. But Beidou is the real miracle worker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010418,
					"content": "I hope I can be like her when I grow up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				}
			]
		},
		{
