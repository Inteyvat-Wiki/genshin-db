				"points": []
			},
			"dialogs": [
				{
					"id": 200230301,
					"content": "Hello? Can I help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230302,
					"content": "Tell me about Nimrod.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "He's been here drinking for hours. Look, here's his tab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "If he keeps this up, we'll have to call in Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "You want to borrow it? I suppose there's no harm in that — but what do you need it for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 2002304,
			"completionStepIds": [
				2002305
