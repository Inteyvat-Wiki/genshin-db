			},
			"dialogs": [
				{
					"id": 200230901,
					"content": "Have you checked up on him yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230902
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230902,
					"content": "Nimrod is sober as a judge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "...Really? He's sober?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Unfortunately there's no evidence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "That's okay. So long as you found no evidence of him drinking, I am content to believe he is a changed man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Until I am given evidence to the contrary, I am always willing to believe in a person's innocence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "But when there's mountains of evidence telling of all kinds of misdemeanors... It really is funny.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Please take this to pay you back for your trouble. I hope I don't see the day that you have anything to repent for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		}
