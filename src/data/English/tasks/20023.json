				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "Hahaha, this is the one I look forward to every day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "I thought you quit drinking?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "Argh! Oh, you gave me a fright... I thought it was my wife.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "The odd one now and then doesn't hurt anybody! I did have a tough day's work today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "Alright, I get it! I'll finish off this one and head back. Eury will probably have finished shopping by now anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 2002303,
			"completionStepIds": [
				2002304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
