			"dialogs": [
				{
					"id": 207020101,
					"content": "How do you do, Honorary Knight? Have you been reading the Knights of Favonius Handbook carefully?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020102
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 207020102,
					"content": "Like the last time, I have a few questions here for you. These questions cover some content from the handbook, as well as some common-sense questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 207020103,
					"content": "Depending on how you answer, I'll also be giving you a small gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Swan"
				}
			]
		},
