			"trigger": {
				"objectNames": [
					"Uzayr",
					"Waiz",
					"Tanisha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "Mr. Kaveh looked really angry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Who cares about him? Maybe he's just worried that we'll take all of his commissions once we finally graduate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "B—But that can't be it, right? Mr. Kaveh is super famous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Who knows? My dad told me that the more famous someone is, the more arrogant and stubborn they become. Approachable people like Mr. Alkami are the rare ones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
