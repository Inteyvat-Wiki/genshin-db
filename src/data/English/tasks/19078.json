			"dialogs": [
				{
					"id": 190785201,
					"content": "A matra investigation has indicated that Alkami, the owner of this training center, coerced the families of his students to take on usurious loans with the intent of making huge profits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785202
					],
					"speakerTitle": "Noticeboard"
				},
				{
