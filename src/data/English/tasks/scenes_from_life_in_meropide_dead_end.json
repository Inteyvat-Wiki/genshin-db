				"objectNames": [
					"Galvaryet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "Hello, what is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300102,
					"content": "Please help us, good sorceress!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "Why are you talking like Lanoire? Just get to the point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300104,
					"content": "We need lots of Coupons. Are there any jobs we can take?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300107,
					"content": "You didn't join Estienne's game, did you? You should know when to stop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300108,
					"content": "...Nonetheless, there is something that I need your help with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300109,
					"content": "Clynes should be repairing his device or whatever it is by the Rift of Erosion. Go help him out, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300110,
					"content": "Just ask him for compensation. He won't object.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300111,
					"content": "We'll take care of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300105,
					"content": "Is there anything we can help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "It would be better if there's compensation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
