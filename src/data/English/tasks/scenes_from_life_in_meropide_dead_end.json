			"dialogs": [
				{
					"id": 740300301,
					"content": "Is there something you don't understand? Just pull the lever along with me — very simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				}
			]
		},
