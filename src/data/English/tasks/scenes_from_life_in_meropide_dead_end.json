				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clynes"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4373.38,
							184.186,
							4785.289
						],
						"pointId": 4603
					},
					{
						"sceneId": 3,
						"position": [
							4373.582,
							184.163,
							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Just in time. Come help me out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "You can read minds? That's scary!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Galvaryet sent us to help you... But how did you know that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "...Because you're the only ones here to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "...Well, that makes sense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "Anyway, the task is nothing difficult. The Research Terminal here requires two people to operate it simultaneously, and I've already entered the commands. Just walk over and pull the lever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "I almost forgot... The charging device should be nearby. Please install the charging device first before starting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "And... Just to double-check, you're not machine killers, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "It depends on how you define machine killers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Why do you ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "I asked Galvana for help last time, and even though I only looked away for a moment, when I looked back, the terminal was already destroyed. I asked her what happened, but she couldn't tell me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "I found out from her sister later that no machines can survive under her for more than half a day. Even Alain Guillotin would have given up on her, I suspect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Even the repair fee was deducted from my compensation. If you're just like her, then all my hard work will be in vain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "What a story. We're definitely not like her. Don't worry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "I'm counting on you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "If the research terminal attacks me, then I guess I am.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "We won't do this for free, though.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "I'll ask Galvaryet to apply for your payment later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Huh? She said we can get compensation from you directly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Did she? Alright, then. Applying for funds here is even harder than from the Fontaine Research Institute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
			"id": 7403003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
