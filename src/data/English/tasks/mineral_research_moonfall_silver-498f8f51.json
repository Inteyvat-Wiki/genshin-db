			"dialogs": [
				{
					"id": 761960301,
					"content": "Whew... we didn't miss any, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Hmm... nope, everything's just right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "I saw you making those fun patterns on the ground with Moonfall Silver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Yeah! It took quite a bit of effort, but I think it really helped to spark everyone's love for the Moonfall Silver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Speaking of which, I heard that there's a folk tale from Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "It's about a girl who originally lived among the stars. When she fell to the earth, she left huge drawings on the ground in her effort to return to the sky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "In the end, her father, the sun up in the heavens, saw her request and brought her back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Maybe he'd see the patterns you made and become a fan of Moonfall Silver too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Haha, if that's the case, then I'd be the ultimate Moonfall Silver ambassador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "But compared to that, I'm still more worried about getting noticed by birds from above. You know, crows and all, they really like shiny things too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "True. And besides crows, we've also got to watch out for Sniffer Moles and Weasel Thieves on the ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "And Lumi too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, right! And Lumi too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Anyway, thanks for helping out earlier. Even though this is just a small portion of my collection... here, take them! Consider it a gift for Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "Hehe, today's a really lucky day, isn't it, Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960317,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lumi"
				}
			]
		},
