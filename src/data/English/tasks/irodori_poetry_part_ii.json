			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lenne",
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920501,
					"content": "Friend, since both you and Ootomo love this phrase so, then let us use it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920502,
					"content": "Lenne's poem and the pictures complement each other a lot. Honestly, the poem just gets more and more moving as you read it and look at the images.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920503,
					"content": "To be honest, I have also been writing a poem for which I might need your aid tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920504,
					"content": "Do you need me to take some pictures, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Heh, let's talk about it in more detail tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
