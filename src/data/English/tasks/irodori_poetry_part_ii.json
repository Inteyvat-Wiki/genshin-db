			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920601,
					"content": "I've heard that flying as free as the wind is the dream of all people from Mondstadt. Honestly, I'd say that this phrase suits Lenne very well indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920602
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920602,
					"content": "It's just a shame that I didn't enjoy going out as a child. If I had a companion like you then, I might actually have a gliding license now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
