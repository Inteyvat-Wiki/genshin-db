				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920401,
					"content": "I've heard that crossing rivers and seas takes a great deal of time. But if I had a friend with me, I'm sure it would be a glad time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269205,
			"completionStepIds": [
				7269205
			],
