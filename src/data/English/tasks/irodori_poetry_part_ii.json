				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920301,
					"content": "Hehe, if Lenne and I had met when we were younger, we might have gone on romps outdoors just like those crabs and lizards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
