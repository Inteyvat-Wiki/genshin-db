						726920902
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920902,
					"content": "Not yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920903
					]
				},
				{
					"id": 726920903,
					"content": "No worries. We just need <color=#00E1FFFF>4 pictures of Inazuman animals</color> today. Thanks a lot!",
