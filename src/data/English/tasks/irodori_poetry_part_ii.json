			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "#{F#Miss}{M#Mister}, wonderful timing! Lenne and I were just working on a new poem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "Need my help in getting some inspiration again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Haha, that's right. Under Ootomo's instruction, I've been composing another poem with an Inazuman style, although admittedly I'm still quite the amateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "The theme of this poem is \"friendship,\" and indeed both of us can only lament that we did not meet sooner. One of the lines I would like to write depicts animals wandering the landscape in companionship with one another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Since this is an Inazuman poem, we must reference <color=#00E1FFFF>creatures unique to these lands</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "We do see animals unique to Inazuma pretty often — whether it be ones that walk or fly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#But since they all appear out in the wild, let's head out and search for them, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "I am in your debt! Please help me take <color=#00E1FFFF>4</color> photos of different animals from Inazuma, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269204",
							"2"
						],
						"stepId": 7269204,
						"stateName": "QUEST_STATE_UNFINISHED"
